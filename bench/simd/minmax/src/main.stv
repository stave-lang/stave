// minmax: the least and the greatest of N f32 elements, REPS times; before each pass one
// element grows by 0.25. No NaN and no -0.0 occur, so the order of comparisons does not matter.
// Prints the FNV-1a hash of every pass's result bits. Same steps as main.c.
import lanes;
import std.io;
import std.mem;
import std.vec;

const N: usize = 32768;
const REPS: usize = 40000;

fn next(s: &mut u64) -> u64 {
    *s = *s *% 6364136223846793005 +% 1442695040888963407;
    return *s;
}

// Uniform in [-0.5, 0.5), multiples of 2^-24: every step is exact.
fn unit(s: &mut u64) -> f32 {
    let x = (next(s) >> 40) as% u32;
    return (x as~ f32) * (1.0 / 16777216.0) - 0.5;
}

fn mix(h: u64, x: u64) -> u64 {
    return (h ^ x) *% 1099511628211;
}

fn main() -> i32 {
    let mut s: u64 = 3;
    let mut v = vec.Vec::<f32>.with_capacity(N);
    for i in 0..N {
        v.push(unit(&mut s));
    }
    let xs = v.as_mut_slice();
    let mut h: u64 = 14695981039346656037;
    for r in 0..REPS {
        xs[r % N] = xs[r % N] + 0.25;
        let (lo, hi) = lanes.minmax(xs);
        h = mix(mix(h, mem.f32_bits(lo) as u64), mem.f32_bits(hi) as u64);
    }
    io.print(f"{h}\n");
    return 0;
}

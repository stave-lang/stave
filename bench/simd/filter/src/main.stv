// filter: the elements of N f32 greater than a threshold that changes every pass, copied in
// order to the front of a second slice, REPS times. Prints the FNV-1a hash of every pass's count
// and last kept element. Same steps as main.c.
import lanes;
import std.io;
import std.mem;
import std.vec;

const N: usize = 32768;
const REPS: usize = 20000;

fn next(s: &mut u64) -> u64 {
    *s = *s *% 6364136223846793005 +% 1442695040888963407;
    return *s;
}

// Uniform in [-0.5, 0.5), multiples of 2^-24: every step is exact.
fn unit(s: &mut u64) -> f32 {
    let x = (next(s) >> 40) as% u32;
    return (x as~ f32) * (1.0 / 16777216.0) - 0.5;
}

fn mix(h: u64, x: u64) -> u64 {
    return (h ^ x) *% 1099511628211;
}

fn main() -> i32 {
    let mut s: u64 = 4;
    let mut v = vec.Vec::<f32>.with_capacity(N);
    let mut w = vec.Vec::<f32>.with_capacity(N);
    for i in 0..N {
        v.push(unit(&mut s));
        w.push(0.0);
    }
    let xs = v.as_slice();
    let out = w.as_mut_slice();
    let mut h: u64 = 14695981039346656037;
    for r in 0..REPS {
        let k = ((r % 64) as% u32 as~ f32) * (1.0 / 64.0) - 0.5;
        let n = lanes.filter(xs, k, out);
        h = mix(h, n as u64);
        if n > 0 { h = mix(h, mem.f32_bits(out[n - 1]) as u64); }
    }
    io.print(f"{h}\n");
    return 0;
}

// matmul4: N / 4 points, each replaced by M p in place, REPS times. M = (I + P) / 2 with P the
// cyclic shift, so the points neither overflow nor vanish. Every result lane is
// ((m0 x0 + m1 x1) + m2 x2) + m3 x3, each product rounded. Prints the FNV-1a hash of one element
// per pass. Same steps as main.c.
import lanes;
import std.io;
import std.mem;
import std.vec;

const N: usize = 32768;
const REPS: usize = 10000;

fn next(s: &mut u64) -> u64 {
    *s = *s *% 6364136223846793005 +% 1442695040888963407;
    return *s;
}

// Uniform in [-0.5, 0.5), multiples of 2^-24: every step is exact.
fn unit(s: &mut u64) -> f32 {
    let x = (next(s) >> 40) as% u32;
    return (x as~ f32) * (1.0 / 16777216.0) - 0.5;
}

fn mix(h: u64, x: u64) -> u64 {
    return (h ^ x) *% 1099511628211;
}

fn main() -> i32 {
    let mut s: u64 = 8;
    let mut v = vec.Vec::<f32>.with_capacity(N);
    for i in 0..N {
        v.push(unit(&mut s));
    }
    let xs = v.as_mut_slice();
    let mut m: [f32; 16] = [0.0; 16];
    for k in 0usize..4 {
        m[4 * k + k] = 0.5;
        m[4 * k + (k + 1) % 4] = 0.5;
    }
    let mut h: u64 = 14695981039346656037;
    for r in 0..REPS {
        lanes.transform(xs, &m);
        h = mix(h, mem.f32_bits(xs[(r * 31) % N]) as u64);
    }
    io.print(f"{h}\n");
    return 0;
}

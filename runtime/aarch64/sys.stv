// runtime_aarch64.sys: raw Linux system calls on AArch64.
// Package `runtime_aarch64` (runtime/aarch64/stave.toml), selected for every AArch64 target by
// runtime/stave.toml (`[target.aarch64-linux.dependencies] arch`). Imported only by runtime.os
// (`import arch.sys;`). Intrinsic lowering: contracts/intrinsics.md (`svc #0`: x8 = nr, x0..x5).
//
// Call ids are arch-neutral: id i is line i + 1 of runtime/syscalls.list. NR[id] is this
// arch's number. A test checks that the NR_* values equal syscalls.list and the kernel ABI.

extern "stave-intrinsic" {
    fn syscall0(nr: usize) -> isize;
    fn syscall1(nr: usize, a1: usize) -> isize;
    fn syscall2(nr: usize, a1: usize, a2: usize) -> isize;
    fn syscall3(nr: usize, a1: usize, a2: usize, a3: usize) -> isize;
    fn syscall4(nr: usize, a1: usize, a2: usize, a3: usize, a4: usize) -> isize;
    fn syscall5(nr: usize, a1: usize, a2: usize, a3: usize, a4: usize, a5: usize) -> isize;
    fn syscall6(nr: usize, a1: usize, a2: usize, a3: usize, a4: usize, a5: usize, a6: usize) -> isize;
    // A thread-creating system call `nr` with a1..a5 (contracts/intrinsics.md): the child, on
    // its new stack, calls `__stave_thread_start(arg)` (runtime.thread.entry), then the `exit`
    // system call (NR_EXIT) with its result; the parent gets the call's result.
    fn thread_clone(nr: usize, a1: usize, a2: usize, a3: usize, a4: usize, a5: usize, arg: usize) -> isize;
    // TPIDR_EL0 := p (contracts/intrinsics.md "Thread pointer").
    fn set_thread_block(p: usize);
}

pub const NR_READ: usize = 63;
pub const NR_WRITE: usize = 64;
pub const NR_PREAD64: usize = 67;
pub const NR_PWRITE64: usize = 68;
pub const NR_OPENAT: usize = 56;
pub const NR_CLOSE: usize = 57;
pub const NR_FSTAT: usize = 80;
pub const NR_LSEEK: usize = 62;
pub const NR_FSYNC: usize = 82;
pub const NR_FDATASYNC: usize = 83;
pub const NR_FTRUNCATE: usize = 46;
pub const NR_FCNTL: usize = 25;
pub const NR_FLOCK: usize = 32;
pub const NR_MMAP: usize = 222;
pub const NR_MUNMAP: usize = 215;
pub const NR_MREMAP: usize = 216;
pub const NR_MPROTECT: usize = 226;
pub const NR_MADVISE: usize = 233;
pub const NR_CLONE3: usize = 435;
pub const NR_FUTEX: usize = 98;
pub const NR_EXIT_GROUP: usize = 94;
pub const NR_GETRANDOM: usize = 278;
pub const NR_CLOCK_GETTIME: usize = 113;
pub const NR_RT_SIGACTION: usize = 134;
pub const NR_RT_SIGPROCMASK: usize = 135;
pub const NR_SIGALTSTACK: usize = 132;
pub const NR_SCHED_GETAFFINITY: usize = 123;
pub const NR_SCHED_YIELD: usize = 124;
pub const NR_GETDENTS64: usize = 61;
pub const NR_UNLINKAT: usize = 35;
pub const NR_MKDIRAT: usize = 34;
pub const NR_RENAMEAT2: usize = 276;
pub const NR_KILL: usize = 129;
pub const NR_GETPID: usize = 172;
pub const NR_CLONE: usize = 220;
pub const NR_EXIT: usize = 93;

pub const NCALLS: usize = 36;

// Indexed by call id (syscalls.list order).
pub const NR: [usize; 36] = [
    NR_READ,
    NR_WRITE,
    NR_PREAD64,
    NR_PWRITE64,
    NR_OPENAT,
    NR_CLOSE,
    NR_FSTAT,
    NR_LSEEK,
    NR_FSYNC,
    NR_FDATASYNC,
    NR_FTRUNCATE,
    NR_FCNTL,
    NR_FLOCK,
    NR_MMAP,
    NR_MUNMAP,
    NR_MREMAP,
    NR_MPROTECT,
    NR_MADVISE,
    NR_CLONE3,
    NR_FUTEX,
    NR_EXIT_GROUP,
    NR_GETRANDOM,
    NR_CLOCK_GETTIME,
    NR_RT_SIGACTION,
    NR_RT_SIGPROCMASK,
    NR_SIGALTSTACK,
    NR_SCHED_GETAFFINITY,
    NR_SCHED_YIELD,
    NR_GETDENTS64,
    NR_UNLINKAT,
    NR_MKDIRAT,
    NR_RENAMEAT2,
    NR_KILL,
    NR_GETPID,
    NR_CLONE,
    NR_EXIT,
];

// Offset of the interrupted PC inside the kernel's `ucontext_t` passed to an SA_SIGINFO handler
// (uc_mcontext at 176 (16-aligned after the 128-byte sigmask area), then fault_address, regs[31], sp, pc: 176 + 8 + 248 + 8).
pub const UCONTEXT_PC: usize = 440;

// The system calls sc0..sc6 are safe fns that trust their arguments: any address among them must be
// valid for the call `id` names. runtime.os is the only caller and states that memory per wrapper.
pub fn sc0(id: usize) -> isize {
    return unsafe("id is a syscalls.list index; the addresses in a1.. are valid for that call because only runtime.os calls sc0..sc6, and each wrapper there states the memory the call touches") syscall0(NR[id]);
}

// exit_group and sched_yield name their number directly, so no trapping operation (the NR
// lookup) is on runtime.panic.begin's path, where a trap would start the report again.
pub fn exit_group(code: usize) -> isize {
    return unsafe("exit_group takes no memory") syscall1(NR_EXIT_GROUP, code);
}

pub fn sched_yield() -> isize {
    return unsafe("sched_yield takes no memory") syscall0(NR_SCHED_YIELD);
}

pub fn sc1(id: usize, a1: usize) -> isize {
    return unsafe("id is a syscalls.list index; the addresses in a1.. are valid for that call because only runtime.os calls sc0..sc6, and each wrapper there states the memory the call touches") syscall1(NR[id], a1);
}

pub fn sc2(id: usize, a1: usize, a2: usize) -> isize {
    return unsafe("id is a syscalls.list index; the addresses in a1.. are valid for that call because only runtime.os calls sc0..sc6, and each wrapper there states the memory the call touches") syscall2(NR[id], a1, a2);
}

pub fn sc3(id: usize, a1: usize, a2: usize, a3: usize) -> isize {
    return unsafe("id is a syscalls.list index; the addresses in a1.. are valid for that call because only runtime.os calls sc0..sc6, and each wrapper there states the memory the call touches") syscall3(NR[id], a1, a2, a3);
}

pub fn sc4(id: usize, a1: usize, a2: usize, a3: usize, a4: usize) -> isize {
    return unsafe("id is a syscalls.list index; the addresses in a1.. are valid for that call because only runtime.os calls sc0..sc6, and each wrapper there states the memory the call touches") syscall4(NR[id], a1, a2, a3, a4);
}

pub fn sc5(id: usize, a1: usize, a2: usize, a3: usize, a4: usize, a5: usize) -> isize {
    return unsafe("id is a syscalls.list index; the addresses in a1.. are valid for that call because only runtime.os calls sc0..sc6, and each wrapper there states the memory the call touches") syscall5(NR[id], a1, a2, a3, a4, a5);
}

pub fn sc6(id: usize, a1: usize, a2: usize, a3: usize, a4: usize, a5: usize, a6: usize) -> isize {
    return unsafe("id is a syscalls.list index; the addresses in a1.. are valid for that call because only runtime.os calls sc0..sc6, and each wrapper there states the memory the call touches") syscall6(NR[id], a1, a2, a3, a4, a5, a6);
}

// PC of the interrupted instruction, read from a signal handler's ucontext. A safe fn that trusts
// its argument: `uctx` must be the ucontext_t the kernel passed to the running handler.
pub fn ucontext_pc(uctx: usize) -> usize {
    return unsafe("uctx is the ucontext_t the kernel passed to the running SA_SIGINFO handler") *((uctx + UCONTEXT_PC) as *const usize);
}

// A new thread with clone3 (`args` = `struct clone_args`, `size` bytes); its entry is
// runtime.thread.entry(arg).
pub unsafe("args is a struct clone_args of size bytes whose stack is valid; arg is what runtime.thread.entry expects")
fn clone3_thread(args: usize, size: usize, arg: usize) -> isize {
    return unsafe("args is the struct clone_args of size bytes whose stack is valid (this fn's obligation); the child starts runtime.thread.entry(arg) on that stack and returns into the exit system call") thread_clone(NR_CLONE3, args, size, 0, 0, 0, arg);
}

// A new thread with the older `clone` (clone(flags, newsp, parent_tid, tls, child_tid) on AArch64), for kernels and emulators without clone3.
pub unsafe("sp is the 16-byte aligned top of a fresh stack; ptid and ctid are valid u32 words; tls is the thread's block; arg is what runtime.thread.entry expects")
fn clone_thread(flags: usize, sp: usize, ptid: usize, ctid: usize, tls: usize, arg: usize) -> isize {
    return unsafe("sp is the 16-byte aligned top of the fresh stack, ptid and ctid are valid u32 words and tls the thread's block (this fn's obligation); the child starts runtime.thread.entry(arg) on that stack") thread_clone(NR_CLONE, flags, sp, ptid, tls, ctid, arg);
}

// The calling thread's thread pointer (TPIDR_EL0) := p; no system call.
pub unsafe("p is a runtime.state Block of this thread that outlives it")
fn set_thread_pointer(p: usize) -> isize {
    unsafe("p is a runtime.state Block of this thread that outlives it (this fn's obligation); the intrinsic only writes TPIDR_EL0") { set_thread_block(p); }
    return 0;
}

// runtime.state: the process-wide runtime state block.
//
// One `static mut`: zero-initialized program data (.bss), so it exists before
// runtime.start.entry runs and needs no mapping. Every runtime module reaches it through `get()`,
// the only place that names STATE; each use of the raw pointer is an `unsafe` operation whose
// obligation is the field rules below.
//
// Threads (runtime.thread) share this block. Fields written after start-up are guarded:
// the allocator fields by `alloc_lock`, the thread registry by `reg_lock` (runtime.atomic
// futex locks); `next_thread`, `ncpu`, and `panicking` change only through atomics.
// `main_block` is main's thread block (below), written only by main.
//
// Thread blocks: each thread has one `Block`, reached through the thread pointer (`block()`, the
// `thread_block` intrinsic): main's is `STATE.main_block`, set by runtime.start.entry; another
// thread's lies in its record page (runtime.thread) and is set by the clone (CLONE_SETTLS). Only
// its own thread reads or writes a block, so its fields need no lock. The first word is the
// block's own address: x86-64 reads the thread pointer as `fs:[0]`.

// Number of allocator size classes (runtime.alloc CLASS).
pub const NCLASS: usize = 23;

// Thread registry (runtime.thread): MAX_THREADS live entries of REG_WORDS words each:
// [lo, hi) address range of a stack mapping (its guard region at the bottom: [lo, guard_hi)),
// guard_hi, thread id. lo == 0: a free entry.
pub const MAX_THREADS: usize = 1024;
pub const REG_WORDS: usize = 4;
pub const REG_LEN: usize = 4096; // MAX_THREADS * REG_WORDS

// Entries of a thread's error-trace ring (runtime.errtrace).
pub const NRING: usize = 32;

// A site-table row that names no site (runtime.panic SITE_NONE).
pub const NO_SITE: u32 = 0xFFFF_FFFF;

// 160 bytes, the same on every target.
pub struct Block {
    // this block's address
    pub this: usize,
    // 0 for main, then creation order (runtime.thread)
    pub thread_id: u64,
    // the last user site this thread stored (runtime.panic set_user_site)
    pub user_site: u32,
    pub requires_site: u32,
    // the error trace (runtime.errtrace): restarting site (NO_SITE: none), via sites pushed since
    // (wrapping), and the last NRING of them at index count % NRING
    pub origin: u32,
    pub count: u32,
    pub ring: [u32; NRING],
}

extern "stave-intrinsic" {
    // The calling thread's thread pointer (contracts/intrinsics.md "Thread pointer").
    fn thread_block() -> usize;
}

pub struct State {
    // process start (runtime.start)
    pub argc: usize,
    pub argv: usize,
    pub envp: usize,
    pub auxv: usize,
    pub page_size: usize,
    pub hwcap: u64,
    pub hwcap2: u64,
    pub at_random: usize,
    // main stack: [stack_lo, stack_hi) usable, [guard_lo, guard_hi) PROT_NONE below it
    pub stack_lo: usize,
    pub stack_hi: usize,
    pub guard_lo: usize,
    pub guard_hi: usize,
    pub altstack: usize,
    pub altstack_size: usize,
    // panics (runtime.panic): the reporting thread's id + 1, 0 while none reports
    pub panicking: u32,
    pub main_block: Block,
    // allocator (runtime.alloc): free-list heads (0 = empty) and the current arena chunk
    pub free: [usize; NCLASS],
    pub arena_cur: usize,
    pub arena_end: usize,
    pub small_mapped: usize,
    pub large_mapped: usize,
    // threads (runtime.thread, runtime.atomic locks)
    pub alloc_lock: u32,
    pub reg_lock: u32,
    pub next_thread: u64,
    pub ncpu: u64,
    pub reg: [usize; REG_LEN],
}

static mut STATE: State = State.{
    argc: 0,
    argv: 0,
    envp: 0,
    auxv: 0,
    page_size: 0,
    hwcap: 0,
    hwcap2: 0,
    at_random: 0,
    stack_lo: 0,
    stack_hi: 0,
    guard_lo: 0,
    guard_hi: 0,
    altstack: 0,
    altstack_size: 0,
    panicking: 0,
    main_block: Block.{
        this: 0,
        thread_id: 0,
        user_site: 0,
        requires_site: 0,
        origin: 0,
        count: 0,
        ring: [0; NRING],
    },
    free: [0; NCLASS],
    arena_cur: 0,
    arena_end: 0,
    small_mapped: 0,
    large_mapped: 0,
    alloc_lock: 0,
    reg_lock: 0,
    next_thread: 0,
    ncpu: 0,
    reg: [0; REG_LEN],
};

pub fn get() -> *mut State {
    return unsafe("only the address is taken; callers dereference it inside their own unsafe(..) under the field rules of the header") &mut STATE as *mut State;
}

// The calling thread's block. Never null once runtime.start.entry has set main's thread pointer,
// which it does before anything else runs.
pub fn block() -> *mut Block {
    return unsafe("reads the thread pointer register; no memory is touched") thread_block() as *mut Block;
}

// Page size from AT_PAGESZ (4096 until runtime.start has read the auxiliary vector).
pub fn page_size() -> usize {
    let st = get();
    let p = unsafe("st is runtime.state.STATE; page_size is written only at start-up, before any other thread") (*st).page_size;
    return if p == 0 then 4096 else p;
}

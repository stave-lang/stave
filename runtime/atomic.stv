// runtime.atomic: CPU atomics and a futex lock.
//
// The atomics are compiler intrinsics (contracts/intrinsics.md "CPU atomics"): sequentially
// consistent on every target (x86-64: `mov` / `xchg` / `lock xadd` / `lock cmpxchg`; AArch64:
// `ldar`, `ldaxr`/`stlxr` loops). The address is passed as `usize`; it must be naturally
// aligned. Each wrapper here states that obligation once.
//
// `lock`/`unlock`: a three-state futex mutex on one u32 word (0 unlocked, 1 locked, 2 locked
// with waiters; Drepper, "Futexes Are Tricky", mutex 3). Used by runtime.alloc, the thread
// registry (runtime.thread), and std.sync.Mutex. The runtime does not depend on std.

import runtime.os;

extern "stave-intrinsic" {
    fn atomic_load_u32(p: usize) -> u32;
    fn atomic_load_u64(p: usize) -> u64;
    fn atomic_xchg_u32(p: usize, v: u32) -> u32;
    fn atomic_xchg_u64(p: usize, v: u64) -> u64;
    fn atomic_add_u32(p: usize, v: u32) -> u32;
    fn atomic_add_u64(p: usize, v: u64) -> u64;
    fn atomic_cas_u32(p: usize, expected: u32, new: u32) -> u32;
    fn atomic_cas_u64(p: usize, expected: u64, new: u64) -> u64;
}

pub unsafe("p is a 4-byte aligned u32 that stays mapped during the call")
fn load_u32(p: *const u32) -> u32 {
    return unsafe("p is the caller's 4-byte aligned u32, mapped for the call, which the intrinsic accesses atomically") atomic_load_u32(p as usize);
}

pub unsafe("p is an 8-byte aligned u64 that stays mapped during the call")
fn load_u64(p: *const u64) -> u64 {
    return unsafe("p is the caller's 8-byte aligned u64, mapped for the call, which the intrinsic accesses atomically") atomic_load_u64(p as usize);
}

// Stores v; returns the previous value.
pub unsafe("p is a 4-byte aligned u32 that stays mapped during the call")
fn swap_u32(p: *mut u32, v: u32) -> u32 {
    return unsafe("p is the caller's 4-byte aligned u32, mapped for the call, which the intrinsic accesses atomically") atomic_xchg_u32(p as usize, v);
}

pub unsafe("p is an 8-byte aligned u64 that stays mapped during the call")
fn swap_u64(p: *mut u64, v: u64) -> u64 {
    return unsafe("p is the caller's 8-byte aligned u64, mapped for the call, which the intrinsic accesses atomically") atomic_xchg_u64(p as usize, v);
}

// Adds v (wrapping); returns the previous value.
pub unsafe("p is a 4-byte aligned u32 that stays mapped during the call")
fn fetch_add_u32(p: *mut u32, v: u32) -> u32 {
    return unsafe("p is the caller's 4-byte aligned u32, mapped for the call, which the intrinsic accesses atomically") atomic_add_u32(p as usize, v);
}

pub unsafe("p is an 8-byte aligned u64 that stays mapped during the call")
fn fetch_add_u64(p: *mut u64, v: u64) -> u64 {
    return unsafe("p is the caller's 8-byte aligned u64, mapped for the call, which the intrinsic accesses atomically") atomic_add_u64(p as usize, v);
}

// Stores new if the value is expected; returns the previous value (== expected on success).
pub unsafe("p is a 4-byte aligned u32 that stays mapped during the call")
fn cas_u32(p: *mut u32, expected: u32, new: u32) -> u32 {
    return unsafe("p is the caller's 4-byte aligned u32, mapped for the call, which the intrinsic accesses atomically") atomic_cas_u32(p as usize, expected, new);
}

pub unsafe("p is an 8-byte aligned u64 that stays mapped during the call")
fn cas_u64(p: *mut u64, expected: u64, new: u64) -> u64 {
    return unsafe("p is the caller's 8-byte aligned u64, mapped for the call, which the intrinsic accesses atomically") atomic_cas_u64(p as usize, expected, new);
}

// ---- futex lock ----

pub unsafe("w is a 4-byte aligned lock word (initially 0) that outlives every holder and waiter")
fn lock(w: *mut u32) {
    let mut c = unsafe("w is the aligned lock word of this fn's obligation, mapped until every holder and waiter is done") cas_u32(w, 0, 1);
    if c == 0 { return; }
    if c != 2 {
        c = unsafe("w is the aligned lock word of this fn's obligation, mapped until every holder and waiter is done") swap_u32(w, 2);
    }
    while c != 0 {
        let r = unsafe("w is the lock word of this fn's obligation: a valid futex word that outlives every waiter") os.futex(w, os.FUTEX_WAIT | os.FUTEX_PRIVATE, 2, 0, 0, 0);
        c = unsafe("w is the aligned lock word of this fn's obligation, mapped until every holder and waiter is done") swap_u32(w, 2);
    }
}

// Returns true if the lock was taken.
pub unsafe("w is a 4-byte aligned lock word that outlives every holder and waiter")
fn try_lock(w: *mut u32) -> bool {
    return unsafe("w is the aligned lock word of this fn's obligation, mapped until every holder and waiter is done") cas_u32(w, 0, 1) == 0;
}

pub unsafe("w is a lock word held by this thread")
fn unlock(w: *mut u32) {
    let prev = unsafe("w is the aligned lock word this thread holds (this fn's obligation), so the swap releases it") swap_u32(w, 0);
    if prev == 2 {
        let r = unsafe("w is the lock word this thread held (this fn's obligation): a valid futex word that outlives every waiter") os.futex(w, os.FUTEX_WAKE | os.FUTEX_PRIVATE, 1, 0, 0, 0);
    }
}

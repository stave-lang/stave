// runtime.os: the one arch-neutral OS-call module std imports.
// It alone imports the syscall layer `arch.sys`: `arch` is the per-target dependency of
// runtime/stave.toml (`runtime_x86_64` for x86-64 targets, `runtime_aarch64` for AArch64), so
// exactly one arch's module is part of a build and every call here is static.
//
// Results are the raw kernel result: >= 0 on success, -errno on failure. Integer arguments are
// passed as `usize`; a negative C `int` (AT_FDCWD) is sign-extended with `as%`.
// The runtime package does not depend on std, so it uses no Option, Result, or std traits.

import arch.sys;

// ---- call ids: line number - 1 in runtime/syscalls.list ----
pub const SYS_READ: usize = 0;
pub const SYS_WRITE: usize = 1;
pub const SYS_PREAD64: usize = 2;
pub const SYS_PWRITE64: usize = 3;
pub const SYS_OPENAT: usize = 4;
pub const SYS_CLOSE: usize = 5;
pub const SYS_FSTAT: usize = 6;
pub const SYS_LSEEK: usize = 7;
pub const SYS_FSYNC: usize = 8;
pub const SYS_FDATASYNC: usize = 9;
pub const SYS_FTRUNCATE: usize = 10;
pub const SYS_FCNTL: usize = 11;
pub const SYS_FLOCK: usize = 12;
pub const SYS_MMAP: usize = 13;
pub const SYS_MUNMAP: usize = 14;
pub const SYS_MREMAP: usize = 15;
pub const SYS_MPROTECT: usize = 16;
pub const SYS_MADVISE: usize = 17;
pub const SYS_CLONE3: usize = 18;
pub const SYS_FUTEX: usize = 19;
pub const SYS_EXIT_GROUP: usize = 20;
pub const SYS_GETRANDOM: usize = 21;
pub const SYS_CLOCK_GETTIME: usize = 22;
pub const SYS_RT_SIGACTION: usize = 23;
pub const SYS_RT_SIGPROCMASK: usize = 24;
pub const SYS_SIGALTSTACK: usize = 25;
pub const SYS_SCHED_GETAFFINITY: usize = 26;
pub const SYS_SCHED_YIELD: usize = 27;
pub const SYS_GETDENTS64: usize = 28;
pub const SYS_UNLINKAT: usize = 29;
pub const SYS_MKDIRAT: usize = 30;
pub const SYS_RENAMEAT2: usize = 31;
pub const SYS_KILL: usize = 32;
pub const SYS_GETPID: usize = 33;
pub const SYS_CLONE: usize = 34;
// `exit` (one thread) is issued only by the thread_clone intrinsic's child path.
pub const SYS_EXIT: usize = 35;

// ---- Linux ABI constants (identical on x86-64 and AArch64) ----
pub const ENOENT: isize = 2;
pub const EINTR: isize = 4;
pub const EACCES: isize = 13;
pub const ENOMEM: isize = 12;
pub const EEXIST: isize = 17;
pub const EISDIR: isize = 21;
pub const EINVAL: isize = 22;
pub const ENOSYS: isize = 38;
pub const EAGAIN: isize = 11;

pub const STDIN: i32 = 0;
pub const STDOUT: i32 = 1;
pub const STDERR: i32 = 2;
pub const AT_FDCWD: i32 = -100;
pub const O_RDONLY: u32 = 0;
pub const O_WRONLY: u32 = 1;
pub const O_RDWR: u32 = 2;
pub const O_CREAT: u32 = 64;
pub const O_TRUNC: u32 = 512;
pub const O_CLOEXEC: u32 = 524288;
// opens the path itself (fstat only, no read or write); follows symlinks, never blocks on a FIFO
pub const O_PATH: u32 = 2097152;
pub const AT_REMOVEDIR: u32 = 512;
// an open that never waits (a FIFO opened for reading has no writer yet)
pub const O_NONBLOCK: u32 = 2048;

// `struct stat` (fstat): the u32 `st_mode` at this arch's offset; its S_IFMT bits give the kind.
pub const STAT_SIZE: usize = 144;
pub const STAT_MODE_OFF: usize = sys.STAT_MODE_OFF;
pub const S_IFMT: u32 = 61440;
pub const S_IFDIR: u32 = 16384;
pub const S_IFREG: u32 = 32768;

// linux_dirent64 (getdents64): d_reclen u16 at 16, d_type u8 at 18, NUL-terminated d_name at 19.
pub const DIRENT_RECLEN_OFF: usize = 16;
pub const DIRENT_TYPE_OFF: usize = 18;
pub const DIRENT_NAME_OFF: usize = 19;
pub const DT_UNKNOWN: u8 = 0;
pub const DT_DIR: u8 = 4;
pub const DT_REG: u8 = 8;
pub const DT_LNK: u8 = 10;

pub const PROT_NONE: u32 = 0;
pub const PROT_READ: u32 = 1;
pub const PROT_WRITE: u32 = 2;
pub const MAP_PRIVATE: u32 = 2;
pub const MAP_FIXED: u32 = 16;
pub const MAP_ANONYMOUS: u32 = 32;
pub const MAP_NORESERVE: u32 = 16384;
pub const MAP_STACK: u32 = 131072;
pub const MAP_FIXED_NOREPLACE: u32 = 1048576;
pub const MREMAP_MAYMOVE: u32 = 1;

pub const SIGBUS: i32 = 7;
pub const SIGSEGV: i32 = 11;
pub const SIG_DFL: usize = 0;
pub const SIG_BLOCK: i32 = 0;
pub const SIG_UNBLOCK: i32 = 1;
// the sigset word holding only SIGPIPE (13)
pub const SIGPIPE_SET: u64 = 1u64 << 12;
// the sigset word holding SIGSEGV (11) and SIGBUS (7)
pub const FAULT_SET: u64 = (1u64 << 10) | (1u64 << 6);
pub const SA_SIGINFO: u64 = 4;
pub const SA_ONSTACK: u64 = 0x0800_0000;
pub const SA_NODEFER: u64 = 0x4000_0000;
pub const SA_RESTORER: u64 = 0x0400_0000;

// clone flags of a thread (glibc's set: shared VM, files, signal handlers, thread group, its own
// thread pointer: CLONE_SETTLS), plus the tid word written for the parent and cleared +
// futex-woken at the thread's exit.
pub const CLONE_THREAD_FLAGS: u64 = 0x003D_0F00;
pub const CLONE_ARGS_SIZE: usize = 64;
pub const FUTEX_WAIT: i32 = 0;
pub const FUTEX_WAKE: i32 = 1;
pub const FUTEX_PRIVATE: i32 = 128;

pub const CLOCK_REALTIME: i32 = 0;
pub const CLOCK_MONOTONIC: i32 = 1;

// Auxiliary vector keys read by runtime.start.
pub const AT_NULL: usize = 0;
pub const AT_PAGESZ: usize = 6;
pub const AT_HWCAP: usize = 16;
pub const AT_RANDOM: usize = 25;
pub const AT_HWCAP2: usize = 26;

// Interrupted PC from the `ucontext_t` of an SA_SIGINFO handler.
pub unsafe("uctx is the ucontext pointer the kernel passed to the running signal handler")
fn signal_pc(uctx: usize) -> usize {
    return unsafe("uctx is the ucontext pointer the kernel passed to the running signal handler (this fn's obligation)") sys.ucontext_pc(uctx);
}

fn fd_arg(fd: i32) -> usize {
    return fd as% usize;
}

fn ptr_arg(p: *const u8) -> usize {
    return p as usize;
}

fn mut_arg(p: *mut u8) -> usize {
    return p as usize;
}

// ---- files ----
pub unsafe("buf..buf+len is writable for the duration of the call")
fn read(fd: i32, buf: *mut u8, len: usize) -> isize {
    return unsafe("read writes at most len bytes at buf, writable for the call (this fn's obligation)") sys.sc3(SYS_READ, fd_arg(fd), mut_arg(buf), len);
}

pub unsafe("buf..buf+len is readable for the duration of the call")
fn write(fd: i32, buf: *const u8, len: usize) -> isize {
    return unsafe("write reads len bytes at buf, readable for the call (this fn's obligation)") sys.sc3(SYS_WRITE, fd_arg(fd), ptr_arg(buf), len);
}

pub unsafe("buf..buf+len is writable for the duration of the call")
fn pread64(fd: i32, buf: *mut u8, len: usize, off: u64) -> isize {
    return unsafe("pread64 writes at most len bytes at buf, writable for the call (this fn's obligation)") sys.sc4(SYS_PREAD64, fd_arg(fd), mut_arg(buf), len, off as usize);
}

pub unsafe("buf..buf+len is readable for the duration of the call")
fn pwrite64(fd: i32, buf: *const u8, len: usize, off: u64) -> isize {
    return unsafe("pwrite64 reads len bytes at buf, readable for the call (this fn's obligation)") sys.sc4(SYS_PWRITE64, fd_arg(fd), ptr_arg(buf), len, off as usize);
}

pub unsafe("path points to a NUL-terminated byte string")
fn openat(dirfd: i32, path: *const u8, flags: u32, mode: u32) -> isize {
    return unsafe("openat reads the NUL-terminated string at path (this fn's obligation) and no other memory") sys.sc4(SYS_OPENAT, fd_arg(dirfd), ptr_arg(path), flags as usize, mode as usize);
}

pub fn close(fd: i32) -> isize {
    return unsafe("close takes no memory") sys.sc1(SYS_CLOSE, fd_arg(fd));
}

// `st` must hold the arch's `struct stat` (144 bytes on x86-64, 128 on AArch64).
pub unsafe("st points to a writable buffer of at least 144 bytes")
fn fstat(fd: i32, st: *mut u8) -> isize {
    return unsafe("fstat writes the arch's struct stat (at most 144 bytes) at st, writable (this fn's obligation)") sys.sc2(SYS_FSTAT, fd_arg(fd), mut_arg(st));
}

pub fn lseek(fd: i32, off: i64, whence: i32) -> isize {
    return unsafe("lseek takes no memory") sys.sc3(SYS_LSEEK, fd_arg(fd), off as% usize, whence as% usize);
}

pub fn fsync(fd: i32) -> isize {
    return unsafe("fsync takes no memory") sys.sc1(SYS_FSYNC, fd_arg(fd));
}

pub fn fdatasync(fd: i32) -> isize {
    return unsafe("fdatasync takes no memory") sys.sc1(SYS_FDATASYNC, fd_arg(fd));
}

pub fn ftruncate(fd: i32, len: u64) -> isize {
    return unsafe("ftruncate takes no memory") sys.sc2(SYS_FTRUNCATE, fd_arg(fd), len as usize);
}

pub unsafe("arg is valid for cmd (a pointer argument points to the kernel's expected struct)")
fn fcntl(fd: i32, cmd: i32, arg: usize) -> isize {
    return unsafe("arg is valid for cmd (this fn's obligation)") sys.sc3(SYS_FCNTL, fd_arg(fd), cmd as% usize, arg);
}

pub fn flock(fd: i32, op: i32) -> isize {
    return unsafe("flock takes no memory") sys.sc2(SYS_FLOCK, fd_arg(fd), op as% usize);
}

pub unsafe("buf..buf+len is writable for the duration of the call")
fn getdents64(fd: i32, buf: *mut u8, len: usize) -> isize {
    return unsafe("getdents64 writes at most len bytes at buf, writable for the call (this fn's obligation)") sys.sc3(SYS_GETDENTS64, fd_arg(fd), mut_arg(buf), len);
}

pub unsafe("path points to a NUL-terminated byte string")
fn unlinkat(dirfd: i32, path: *const u8, flags: u32) -> isize {
    return unsafe("unlinkat reads the NUL-terminated string at path (this fn's obligation) and no other memory") sys.sc3(SYS_UNLINKAT, fd_arg(dirfd), ptr_arg(path), flags as usize);
}

pub unsafe("path points to a NUL-terminated byte string")
fn mkdirat(dirfd: i32, path: *const u8, mode: u32) -> isize {
    return unsafe("mkdirat reads the NUL-terminated string at path (this fn's obligation) and no other memory") sys.sc3(SYS_MKDIRAT, fd_arg(dirfd), ptr_arg(path), mode as usize);
}

pub unsafe("old and new point to NUL-terminated byte strings")
fn renameat2(olddir: i32, old: *const u8, newdir: i32, new: *const u8, flags: u32) -> isize {
    return unsafe("renameat2 reads the NUL-terminated strings at old and new (this fn's obligation) and no other memory") sys.sc5(SYS_RENAMEAT2, fd_arg(olddir), ptr_arg(old), fd_arg(newdir), ptr_arg(new), flags as usize);
}

// ---- memory ----
// Returns the address (as isize) or -errno. Without MAP_FIXED it touches no existing mapping.
pub unsafe("with MAP_FIXED, addr..addr+len holds no live Stave object and no code or stack in use; fd is -1: the pages are anonymous")
fn mmap(addr: usize, len: usize, prot: u32, flags: u32, fd: i32, off: u64) -> isize {
    return unsafe("mmap reads no memory; without MAP_FIXED it replaces no mapping, a MAP_FIXED range holds nothing in use, and fd is -1, so no file backs the new pages (this fn's obligation)") sys.sc6(SYS_MMAP, addr, len, prot as usize, flags as usize, fd_arg(fd), off as usize);
}

pub unsafe("addr..addr+len holds no live Stave object and no code or stack in use")
fn munmap(addr: usize, len: usize) -> isize {
    return unsafe("munmap removes only addr..addr+len, which holds no live Stave object and no code or stack in use (this fn's obligation)") sys.sc2(SYS_MUNMAP, addr, len);
}

pub unsafe("old_addr..old_addr+old_len is a mapping owned by the caller that nothing else points into; flags has neither MREMAP_FIXED nor MREMAP_DONTUNMAP")
fn mremap(old_addr: usize, old_len: usize, new_len: usize, flags: u32) -> isize {
    return unsafe("old_addr..old_addr+old_len is the caller's mapping that nothing else points into, and without MREMAP_FIXED the kernel ignores the new address word 0 and moves it only to fresh pages (this fn's obligation)") sys.sc5(SYS_MREMAP, old_addr, old_len, new_len, flags as usize, 0);
}

pub unsafe("no live Stave object, code, or stack in use in addr..addr+len needs an access that prot removes")
fn mprotect(addr: usize, len: usize, prot: u32) -> isize {
    return unsafe("mprotect changes only addr..addr+len, where nothing in use needs an access that prot removes (this fn's obligation)") sys.sc3(SYS_MPROTECT, addr, len, prot as usize);
}

pub unsafe("the advice discards no memory holding live Stave objects, code, or a stack in use")
fn madvise(addr: usize, len: usize, advice: i32) -> isize {
    return unsafe("madvise touches only addr..addr+len, and the advice discards nothing in use there (this fn's obligation)") sys.sc3(SYS_MADVISE, addr, len, advice as% usize);
}

// ---- threads ----
pub unsafe("uaddr (and uaddr2, timeout when the op uses them) are valid for the op")
fn futex(uaddr: *mut u32, op: i32, val: u32, timeout: usize, uaddr2: usize, val3: u32) -> isize {
    return unsafe("uaddr, and uaddr2 and timeout where op uses them, are valid for op (this fn's obligation)") sys.sc6(SYS_FUTEX, uaddr as usize, op as% usize, val as usize, timeout, uaddr2, val3 as usize);
}

pub unsafe("mask..mask+len is writable")
fn sched_getaffinity(pid: i32, len: usize, mask: *mut u8) -> isize {
    return unsafe("sched_getaffinity writes at most len bytes at mask, writable (this fn's obligation)") sys.sc3(SYS_SCHED_GETAFFINITY, pid as% usize, len, mut_arg(mask));
}

// A thread running runtime.thread.entry(arg) on the stack [stack, stack + size): clone3, or
// `clone` where clone3 is missing (ENOSYS: older kernels, qemu-user). `tid` receives the
// thread's id and is cleared (with a futex wake) when it exits; `tls` is its thread pointer (a
// runtime.state Block). Returns the id or -errno.
pub unsafe("stack..stack+size is a fresh 16-byte aligned stack used by nothing else; tid is a u32 word and tls a runtime.state Block that outlive the thread; arg is what runtime.thread.entry expects")
fn spawn_thread(stack: usize, size: usize, tid: *mut u32, tls: usize, arg: usize) -> isize {
    let t = tid as usize;
    let args: [u64; 8] = [CLONE_THREAD_FLAGS, 0, t as u64, t as u64, 0, stack as u64, size as u64, tls as u64];
    let ap = &args as *const [u64; 8] as usize;
    let r = unsafe("args is the local clone_args (VER0, 64 bytes) that lives through the call, naming the fresh stack [stack, stack + size) of this fn's obligation; arg is the record entry expects") sys.clone3_thread(ap, CLONE_ARGS_SIZE, arg);
    if r != -ENOSYS { return r; }
    return unsafe("stack + size is the 16-byte aligned top of the fresh stack, t the tid word for ptid and ctid, tls the block, all of this fn's obligation") sys.clone_thread(CLONE_THREAD_FLAGS as usize, stack + size, t, t, tls, arg);
}

// Points the calling thread's thread pointer at p (runtime.state Block): x86-64 `arch_prctl`,
// AArch64 `msr tpidr_el0`. Returns 0 or -errno.
pub unsafe("p is a runtime.state Block of this thread that outlives it")
fn set_thread_pointer(p: usize) -> isize {
    return unsafe("p is a runtime.state Block of this thread that outlives it (this fn's obligation), which is what the thread pointer must address") sys.set_thread_pointer(p);
}

pub fn sched_yield() -> isize {
    return sys.sched_yield();
}

// ---- process ----
// Never returns (the kernel ends the process; the `loop` only gives the body type `never`).
pub fn exit_group(code: i32) -> never {
    let r = sys.exit_group(code as% usize);
    loop {}
}

pub fn getpid() -> i32 {
    let r = unsafe("getpid takes no memory") sys.sc0(SYS_GETPID);
    return r as% i32;
}

pub fn kill(pid: i32, sig: i32) -> isize {
    return unsafe("kill takes no memory and changes none") sys.sc2(SYS_KILL, pid as% usize, sig as% usize);
}

pub unsafe("buf..buf+len is writable")
fn getrandom(buf: *mut u8, len: usize, flags: u32) -> isize {
    return unsafe("getrandom writes at most len bytes at buf, writable (this fn's obligation)") sys.sc3(SYS_GETRANDOM, mut_arg(buf), len, flags as usize);
}

// `struct timespec` is two 64-bit words on both arches: ts[0] = seconds, ts[1] = nanoseconds.
pub fn clock_gettime(clock: i32, ts: &mut [i64; 2]) -> isize {
    let p = ts as *mut [i64; 2];
    return unsafe("p is ts: two writable i64 words, the kernel's struct timespec") sys.sc2(SYS_CLOCK_GETTIME, clock as% usize, p as usize);
}

// ---- signals ----
// Kernel `struct sigaction` (x86-64 and AArch64): handler, flags, restorer, mask: four words.
pub unsafe("act and old are null or point to four readable/writable u64 words; act's handler is SIG_DFL, SIG_IGN, or code that follows the SA_SIGINFO handler ABI, and its restorer is never returned into or is restorer code")
fn rt_sigaction(sig: i32, act: *const u64, old: *mut u64) -> isize {
    return unsafe("act and old are null or four-word struct sigactions, and the handler act installs is valid code for every signal it gets (this fn's obligation); 8 is the size of the kernel sigset") sys.sc4(SYS_RT_SIGACTION, sig as% usize, act as usize, old as usize, 8);
}

pub unsafe("set and old are null or point to one u64 (the kernel sigset)")
fn rt_sigprocmask(how: i32, set: *const u64, old: *mut u64) -> isize {
    return unsafe("set and old are null or one sigset word (this fn's obligation); 8 is its size; masking changes no memory") sys.sc4(SYS_RT_SIGPROCMASK, how as% usize, set as usize, old as usize, 8);
}

// `stack_t`: ss_sp (word 0), ss_flags (low 32 bits of word 1), ss_size (word 2).
pub unsafe("ss and old are null or point to three words; ss_sp..ss_sp+ss_size is used for nothing else, stays mapped while the thread runs, and holds the kernel's signal frame and the handler's stack use")
fn sigaltstack(ss: *const u64, old: *mut u64) -> isize {
    return unsafe("ss and old are null or three-word stack_t records, and the stack ss names is the thread's own, large enough and used for nothing else (this fn's obligation)") sys.sc2(SYS_SIGALTSTACK, ss as usize, old as usize);
}

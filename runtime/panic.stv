// runtime.panic: the panic report and the stack-overflow handler.
//
// Report: one line on fd 2, then exit_group(101):
//     panic: <Kind> at <file>:<line>:<col> in <fn> (thread <n>)
// `trap_msg` adds one more line holding the message (std.debug.assert); a failed contract
// clause adds its source text the same way. `trap_err` (std's `Result.unwrap` of an `Err`) adds
// the thread's error trace (runtime.errtrace), oldest first:
//       from <file>:<line>:<col> in <fn>            the `Result.Err(..)` that restarted it, if any
//       (<k> earlier via sites not kept)            when more than state.NRING were pushed
//       via <file>:<line>:<col> in <fn>             one per kept `?`
//
// Compiler interface (runtime/README.md has the full contract):
// - every trapping operation calls `trap(kind, site) -> never`: `kind` one of the KIND_* consts,
//   `site` an index into the compiler-emitted site table (`site_table()` intrinsic, layout below);
// - before a call from user code into a std fn that may allocate or panic at its caller
//   (the `user_site` rule), the compiler calls `set_user_site(site)` (or stores
//   the word directly); std passes `user_site()` as the site of OutOfMemory, Assert, Unwrap,
//   and Bounds panics raised for its caller;
// - a false `requires` clause calls `requires_failed(clause)`, located at the user site, which
//   user code stores before every call that can reach one; a false `ensures` clause calls
//   `ensures_failed(site, clause)`, located at the return;
// - the compiler's C-ABI stub `__stave_signal(sig, info, uctx)` calls `on_signal`;
// - `trap`, `trap_msg`, `trap_err`, `requires_failed`, `ensures_failed` and `abort` run on the
//   thread's alternate signal stack: the compiler's entry of each moves there first unless it is
//   there already (the block's `alt_top`/`alt_size`, contracts/intrinsics.md "Alternate stack"),
//   so a report needs no stack where it was raised, and one raised during a report or in the
//   signal handler stays below it.
//
// Site table (read-only data, address from `site_table()`; contracts/intrinsics.md is the source
// of truth for both layouts), all little-endian:
//     u64 count; then count rows of 32 bytes:
//     +0 file: u64 address of UTF-8 bytes   +8  file_len: u32   +12 line: u32 (1-based)
//     +16 fn: u64 address of UTF-8 bytes    +24 fn_len: u32     +28 col: u32 (1-based, bytes)
// PC table (address from `pc_table()`): u64 count; then count rows of 16 bytes sorted by pc_lo:
//     +0 pc_lo: u64 (first instruction of a fn)   +8 site: u32 (the fn's name token)   +12 pad
//
// The runtime does not depend on std: no Option, Result, traits, or std.mem helpers here.

import runtime.os;
import runtime.state;
import runtime.config;
import runtime.atomic;
import runtime.errtrace;

extern "stave-intrinsic" {
    // contracts/intrinsics.md "Runtime start and traps": addresses of compiler-emitted data and
    // of the `__stave_signal` C-ABI stub.
    fn site_table() -> usize;
    fn pc_table() -> usize;
    fn signal_handler_addr() -> usize;
}

pub const KIND_BOUNDS: u32 = 0;
pub const KIND_OVERFLOW: u32 = 1;
pub const KIND_DIV_BY_ZERO: u32 = 2;
pub const KIND_ASSERT: u32 = 3;
pub const KIND_OUT_OF_MEMORY: u32 = 4;
pub const KIND_STACK_OVERFLOW: u32 = 5;
pub const KIND_UNWRAP: u32 = 6;
pub const KIND_UNSUPPORTED_CPU: u32 = 7;
pub const KIND_DEADLOCK: u32 = 8;
pub const KIND_CONTRACT: u32 = 9;
pub const NKIND: u32 = 10;

// A site the table does not hold (runtime start-up failures): printed as `<unknown>:0:0`.
pub const SITE_NONE: u32 = 0xFFFF_FFFF;

pub const EXIT_PANIC: i32 = 101;

const SITE_ROW: usize = 32;
const PC_ROW: usize = 16;
const LINE_CAP: usize = 1024;

// ---- user site word ----
// Per thread (runtime.state Block): a report names the last user site of its own thread.
pub fn set_user_site(site: u32) {
    let b = state.block();
    unsafe("b is this thread's block; only this thread uses it") { (*b).user_site = site; }
}

pub fn user_site() -> u32 {
    let b = state.block();
    return unsafe("b is this thread's block; only this thread uses it") (*b).user_site;
}

// CPU thread id: 0 for the thread running main, then creation order (the thread's block).
// No trapping operation: runtime.panic.begin calls it before it marks the process as
// panicking, where a trap would start the report again without end.
pub fn thread_id() -> u64 {
    let b = state.block();
    return unsafe("b is this thread's block; only this thread uses it") (*b).thread_id;
}

// Word i of the registry.
unsafe("i < REG_LEN") fn reg_word(i: usize) -> usize {
    let st = state.get();
    let base = unsafe("st is runtime.state.STATE; only the field address is taken") &(*st).reg as *const [usize; state.REG_LEN] as usize;
    return unsafe("i < REG_LEN (caller): an 8-byte aligned word of the registry, stored atomically by runtime.thread") atomic.load_u64((base +% i *% 8) as *const u64) as usize;
}

// The registry entry whose [lo, hi) holds address a; MAX_THREADS if none. Reads without the
// registry lock, by atomic loads: an entry is complete before it is published (lo is stored
// last) and is removed only after its thread has exited.
fn find_entry(a: usize) -> usize {
    for e in 0..state.MAX_THREADS {
        let k = e *% state.REG_WORDS;
        let lo = unsafe("e < MAX_THREADS, so k + 1 < REG_LEN") reg_word(k);
        let hi = unsafe("e < MAX_THREADS, so k + 1 < REG_LEN") reg_word(k +% 1);
        if lo != 0 && a >= lo && a < hi { return e; }
    }
    return state.MAX_THREADS;
}

// ---- report line buffer ----
struct Line {
    b: [u8; LINE_CAP],
    n: usize,
}

impl Line {
    fn new() -> Line {
        return Line.{ b: [0u8; LINE_CAP], n: 0 };
    }

    fn flush(&mut self) {
        self.flush_to(os.STDERR);
    }

    fn flush_to(&mut self, fd: i32) {
        let p = &self.b as *const [u8; LINE_CAP] as *const u8;
        let mut done: usize = 0;
        while done < self.n {
            let q = ((p as usize) + done) as *const u8;
            let r = unsafe("q..q+(n-done) lies inside self.b") os.write(fd, q, self.n - done);
            if r == -os.EINTR { continue; }
            if r <= 0 { break; }
            done = done + (r as% usize);
        }
        self.n = 0;
    }

    fn byte(&mut self, c: u8) {
        if self.n == LINE_CAP { self.flush(); }
        self.b[self.n] = c;
        self.n = self.n + 1;
    }

    fn bytes(&mut self, s: &[u8]) {
        for i in 0..s.len() { self.byte(s[i]); }
    }

    fn lit(&mut self, s: &str) {
        self.bytes(str_bytes(s));
    }

    // Copies len bytes from address a (site-table strings).
    unsafe("a..a+len is readable") fn raw(&mut self, a: usize, len: usize) {
        for i in 0..len {
            let c = unsafe("a..a+len is readable (caller)") *((a + i) as *const u8);
            self.byte(c);
        }
    }

    fn dec(&mut self, v: u64) {
        let mut t: [u8; 20] = [0u8; 20];
        let mut n: usize = 0;
        let mut x = v;
        loop {
            t[n] = 48 + ((x % 10) as% u8);
            x = x / 10;
            n = n + 1;
            if x == 0 { break; }
        }
        while n > 0 {
            n = n - 1;
            self.byte(t[n]);
        }
    }
}

// &str -> its UTF-8 bytes. ASSUMPTION (runtime/README.md): `&str` and `&[u8]` share the
// (data, len) representation. std.mem.str_bytes is the std copy of this helper.
fn str_bytes(s: &str) -> &[u8] from s {
    return unsafe("&str and &[u8] are both (data pointer, byte length); str holds UTF-8 bytes") *(&s as *const &str as *const &[u8]);
}

unsafe("a is 4-byte aligned and readable") fn ld32(a: usize) -> u32 {
    return unsafe("a is 4-byte aligned and readable (caller)") *(a as *const u32);
}

unsafe("a is 8-byte aligned and readable") fn ld64(a: usize) -> u64 {
    return unsafe("a is 8-byte aligned and readable (caller)") *(a as *const u64);
}

fn put_kind(l: &mut Line, kind: u32) {
    if kind == KIND_BOUNDS { l.lit("Bounds"); }
    else if kind == KIND_OVERFLOW { l.lit("Overflow"); }
    else if kind == KIND_DIV_BY_ZERO { l.lit("DivByZero"); }
    else if kind == KIND_ASSERT { l.lit("Assert"); }
    else if kind == KIND_OUT_OF_MEMORY { l.lit("OutOfMemory"); }
    else if kind == KIND_STACK_OVERFLOW { l.lit("StackOverflow"); }
    else if kind == KIND_UNWRAP { l.lit("Unwrap"); }
    else if kind == KIND_UNSUPPORTED_CPU { l.lit("UnsupportedCpu"); }
    else if kind == KIND_DEADLOCK { l.lit("Deadlock"); }
    else if kind == KIND_CONTRACT { l.lit("Contract"); }
    else { l.lit("Unknown"); }
}

// "<file>:<line>:<col> in <fn>"
fn put_site(l: &mut Line, site: u32) {
    let row = site_row(site);
    if row == 0 {
        l.lit("<unknown>:0:0 in <unknown>");
        return;
    }
    unsafe("row is inside the site table; its string addresses point to read-only UTF-8 bytes") {
        let file = ld64(row) as usize;
        let file_len = ld32(row + 8) as usize;
        let line = ld32(row + 12);
        let func = ld64(row + 16) as usize;
        let func_len = ld32(row + 24) as usize;
        let col = ld32(row + 28);
        l.raw(file, file_len);
        l.byte(58);
        l.dec(line as u64);
        l.byte(58);
        l.dec(col as u64);
        l.lit(" in ");
        l.raw(func, func_len);
    }
}

// The address of row `site` of the site table (layout in the header; std.debug reads its
// fields); 0 for SITE_NONE or a row the table does not hold.
pub fn site_row(site: u32) -> usize {
    let t = unsafe("intrinsic: address of the compiler-emitted site table") site_table();
    let count = unsafe("the site table is compiler-emitted read-only data, 8-byte aligned") ld64(t);
    if site == SITE_NONE || (site as u64) >= count {
        return 0;
    }
    return t + 8 + (site as usize) * SITE_ROW;
}

// Marks the process as panicking. A panic while this thread reports one (or in its signal
// handler) exits 101 at once, without a second report; a panic in another thread meanwhile
// waits for the first report's exit_group. Nothing begin calls traps (the compiler's stack bound
// checks it), so a trap during a report ends here, one frame chain deep.
fn begin() {
    let st = state.get();
    let me = (thread_id() +% 1) as% u32;
    let w = unsafe("st is runtime.state.STATE; only the field address is taken") &mut (*st).panicking as *mut u32;
    let prev = unsafe("w is the panicking word of the state block") atomic.cas_u32(w, 0, me);
    if prev == 0 { return; }
    if prev == me { os.exit_group(EXIT_PANIC); }
    loop {
        let r = os.sched_yield();
    }
}

// The first line of every report, after begin.
fn head(l: &mut Line, kind: u32, site: u32) {
    // a write to a pipe without a reader then fails with EPIPE instead of ending the process by
    // SIGPIPE: the exit status stays the panic's
    let set: [u64; 1] = [os.SIGPIPE_SET];
    let none = 0usize as *mut u64;
    let r = unsafe("set is one sigset word; blocking SIGPIPE changes no memory") os.rt_sigprocmask(os.SIG_BLOCK, &set as *const [u64; 1] as *const u64, none);
    l.lit("panic: ");
    put_kind(l, kind);
    l.lit(" at ");
    put_site(l, site);
    l.lit(" (thread ");
    l.dec(thread_id());
    l.lit(")\n");
}

// The trap entry the compiler calls for every failing check.
pub fn trap(kind: u32, site: u32) -> never {
    begin();
    let mut l = Line.new();
    head(&mut l, kind, site);
    l.flush();
    os.exit_group(EXIT_PANIC);
}

// As `trap`, then `msg` and a newline on the next stderr line (std.debug.assert).
pub fn trap_msg(kind: u32, site: u32, msg: &[u8]) -> never {
    begin();
    let mut l = Line.new();
    head(&mut l, kind, site);
    l.bytes(msg);
    l.byte(10);
    l.flush();
    os.exit_group(EXIT_PANIC);
}

// As `trap`, then the calling thread's error trace (header).
pub fn trap_err(kind: u32, site: u32) -> never {
    begin();
    let mut l = Line.new();
    head(&mut l, kind, site);
    put_trace(&mut l);
    l.flush();
    os.exit_group(EXIT_PANIC);
}

fn put_trace(l: &mut Line) {
    let t = errtrace.save();
    if t.origin != SITE_NONE {
        l.lit("  from ");
        put_site(l, t.origin);
        l.byte(10);
    }
    let cap = state.NRING as% u32;
    let kept = if t.count > cap then cap else t.count;
    if t.count > cap {
        l.lit("  (");
        l.dec((t.count -% cap) as u64);
        l.lit(" earlier via sites not kept)\n");
    }
    let mut k = t.count -% kept;
    while k != t.count {
        l.lit("  via ");
        put_site(l, t.ring[(k as usize) % state.NRING]);
        l.byte(10);
        k = k +% 1;
    }
}

// A false `requires` clause: kind Contract at the user site (the caller's call), then the
// clause's source text.
pub fn requires_failed(clause: &str) -> never {
    trap_msg(KIND_CONTRACT, user_site(), str_bytes(clause));
}

// A false `ensures` clause: kind Contract at `site` (the return), then the clause's source text.
pub fn ensures_failed(site: u32, clause: &str) -> never {
    trap_msg(KIND_CONTRACT, site, str_bytes(clause));
}

// The stdout markers of a `test fn` with parameters: one line as each input starts, one more
// when a `requires` clause skips it. `stave test` counts them to name a failing input and the
// skipped ones, and never shows them.
pub fn test_input() {
    marker("\u{1}stave-test input\n");
}

pub fn test_skip() {
    marker("\u{1}stave-test skip\n");
}

fn marker(s: &str) {
    let mut l = Line.new();
    l.lit(s);
    l.flush_to(os.STDOUT);
}

// An explicit std abort: kind Assert at the user site.
pub fn abort(msg: &[u8]) -> never {
    trap_msg(KIND_ASSERT, user_site(), msg);
}

// Site of the fn containing pc (its name token), from the PC table; SITE_NONE if pc precedes
// every fn.
pub fn site_for_pc(pc: usize) -> u32 {
    let t = unsafe("intrinsic: address of the compiler-emitted PC table") pc_table();
    let count = unsafe("the PC table is compiler-emitted read-only data, 8-byte aligned") ld64(t) as usize;
    let mut lo: usize = 0;
    let mut hi: usize = count;
    // invariant: rows [0, lo) have pc_lo <= pc, rows [hi, count) have pc_lo > pc
    while lo < hi {
        let mid = lo + (hi - lo) / 2;
        let start = unsafe("mid < count: inside the PC table") ld64(t + 8 + mid * PC_ROW) as usize;
        if start <= pc { lo = mid + 1; } else { hi = mid; }
    }
    if lo == 0 { return SITE_NONE; }
    return unsafe("lo - 1 < count: inside the PC table") ld32(t + 8 + (lo - 1) * PC_ROW + 8);
}

// ---- signals ----
// A thread's alternate stacks: alt_len(page) bytes, bottom to top
//     [guard page][report: config.REPORT_STACK][guard page][signal: config.ALTSTACK]
// (sizes rounded up to the page). A report or a signal handler that runs too deep faults in a
// guard instead of writing past its stack; on_signal ends the process then.
pub fn alt_len(page: usize) -> usize {
    return page + round_up(config.REPORT_STACK, page) + page + round_up(config.ALTSTACK, page);
}

// The top of the report stack of the region at base.
pub fn report_top(base: usize, page: usize) -> usize {
    return base + page + round_up(config.REPORT_STACK, page);
}

// The bottom of the signal stack of the region at base.
pub fn signal_base(base: usize, page: usize) -> usize {
    return report_top(base, page) + page;
}

// Makes the two guard pages of the region at base PROT_NONE. Returns false if a call failed.
pub unsafe("base..base+alt_len(page) is a fresh read-write mapping no object and no thread uses yet")
fn alt_guards(base: usize, page: usize) -> bool {
    let a = unsafe("the bottom page of the region holds no object (this fn's obligation)") os.mprotect(base, page, os.PROT_NONE);
    let b = unsafe("the page below the signal stack holds no object (this fn's obligation)") os.mprotect(report_top(base, page), page, os.PROT_NONE);
    return a >= 0 && b >= 0;
}

// Installs main's alternate stacks and the process-wide SIGSEGV/SIGBUS handler. Called by
// runtime.start.entry before main. Returns false if a call failed.
pub unsafe("called before main, while no thread other than the start thread exists")
fn install() -> bool {
    let st = state.get();
    let page = state.page_size();
    let len = alt_len(page);
    let prot = os.PROT_READ | os.PROT_WRITE;
    let flags = os.MAP_PRIVATE | os.MAP_ANONYMOUS;
    let p = unsafe("no MAP_FIXED and fd -1: fresh anonymous pages the kernel picks") os.mmap(0, len, prot, flags, -1, 0);
    if p < 0 { return false; }
    let base = p as% usize;
    if !unsafe("base..base+len is the fresh mapping above") alt_guards(base, page) { return false; }
    let sig = signal_base(base, page);
    let size = round_up(config.ALTSTACK, page);
    unsafe("st is runtime.state.STATE; no other thread exists yet (this fn's obligation)") {
        (*st).altstack = sig;
        (*st).altstack_size = size;
    }
    if !unsafe("sig..sig+size is the signal stack of the fresh region above, used for nothing else and never unmapped, with a guard page below it; size is config.ALTSTACK rounded up") set_altstack(sig, size) { return false; }
    unsafe("st is runtime.state.STATE; main_block is the calling thread's, main's, and no other thread exists yet") {
        (*st).main_block.alt_top = report_top(base, page);
        (*st).main_block.alt_size = round_up(config.REPORT_STACK, page);
    }
    let none = 0usize as *mut u64;
    let h = unsafe("intrinsic: address of the compiler-emitted __stave_signal stub") signal_handler_addr() as u64;
    // The restorer is never used: the handler either exits or re-raises with the default
    // action. x86-64 still requires SA_RESTORER and a non-zero address. SA_NODEFER: a fault in
    // the report the handler starts reaches the handler again (which ends the process) instead
    // of a blocked SIGSEGV killing it.
    let act: [u64; 4] = [h, os.SA_SIGINFO | os.SA_ONSTACK | os.SA_RESTORER | os.SA_NODEFER, h, 0];
    let ap = &act as *const [u64; 4] as *const u64;
    let r1 = unsafe("act is the kernel's four-word struct sigaction; handler and restorer are the compiler's __stave_signal stub, an SA_SIGINFO handler that never returns") os.rt_sigaction(os.SIGSEGV, ap, none);
    let r2 = unsafe("act is the kernel's four-word struct sigaction; handler and restorer are the compiler's __stave_signal stub, an SA_SIGINFO handler that never returns") os.rt_sigaction(os.SIGBUS, ap, none);
    return r1 == 0 && r2 == 0;
}

// The calling thread's alternate signal stack (per thread; runtime.thread calls it for each
// new thread). Returns false if the call failed.
pub unsafe("base..base+size is used only as the calling thread's signal stack, stays mapped while it runs, and has a guard page below it; size holds the kernel's signal frame and on_signal's stack use before it moves to the report's stack")
fn set_altstack(base: usize, size: usize) -> bool {
    let ss: [u64; 3] = [base as u64, 0, size as u64];
    let none = 0usize as *mut u64;
    let r = unsafe("ss is three words naming base..base+size: the thread's own signal stack, mapped while it runs, used for nothing else, and large enough (this fn's obligation)") os.sigaltstack(&ss as *const [u64; 3] as *const u64, none);
    return r >= 0;
}

// Whether addr is in a guard region: main's (state), or the bottom [lo, guard_hi) of a
// registered thread stack.
fn in_guard(addr: usize) -> bool {
    let st = state.get();
    let lo = unsafe("st is runtime.state.STATE; main's guard is written before main runs") (*st).guard_lo;
    let hi = unsafe("st is runtime.state.STATE; main's guard is written before main runs") (*st).guard_hi;
    if lo != 0 && addr >= lo && addr < hi { return true; }
    let e = find_entry(addr);
    if e == state.MAX_THREADS { return false; }
    let k = e *% state.REG_WORDS;
    let glo = unsafe("e < MAX_THREADS, so k < REG_LEN") reg_word(k);
    let ghi = unsafe("e < MAX_THREADS, so k + 2 < REG_LEN") reg_word(k +% 2);
    return addr >= glo && addr < ghi;
}

fn round_up(x: usize, page: usize) -> usize {
    return (x + page - 1) / page * page;
}

// Called by the compiler's `__stave_signal(sig, info, uctx)` stub on the alternate stack.
// A fault inside a guard region is a StackOverflow panic located at the faulting fn's name
// token (PC table). Any other fault is not a panic: the default action runs.
pub unsafe("sig, info, uctx are the arguments the kernel passed to an SA_SIGINFO handler")
fn on_signal(sig: usize, info: usize, uctx: usize) -> never {
    // Entered again on this thread (SA_NODEFER): a fault in the handler itself or in the report
    // it started. Running it again would fault again (a handler past its stack restarts at the
    // top and overruns at the same depth: no end), so the process ends here, before anything
    // else uses the stack.
    let b = state.block();
    let again = unsafe("b is this thread's block; only this thread uses it") (*b).in_signal;
    if again != 0 { os.exit_group(EXIT_PANIC); }
    unsafe("b is this thread's block; only this thread uses it") { (*b).in_signal = 1; }
    // A fault while this thread reports (its report overran the report stack into the guard,
    // or any other): the report cannot finish, and a second one would start over.
    let st = state.get();
    let w = unsafe("st is runtime.state.STATE; only the field address is taken") &(*st).panicking as *const u32;
    let p = unsafe("w is the panicking word of the state block") atomic.load_u32(w);
    if p == (thread_id() +% 1) as% u32 { os.exit_group(EXIT_PANIC); }
    // siginfo_t.si_addr is at offset 16 on x86-64 and AArch64
    let addr = unsafe("info is the kernel's siginfo_t") ld64(info + 16) as usize;
    if sig == (os.SIGSEGV as% usize) && in_guard(addr) {
        let pc = unsafe("uctx is the kernel's ucontext_t for this handler") os.signal_pc(uctx);
        trap(KIND_STACK_OVERFLOW, site_for_pc(pc));
    }
    // Default action: restore SIG_DFL for both signals, unblock them, raise the signal again.
    // kill is process-directed: another thread may take it while this one runs on, so this
    // thread then faults itself (address 0 is never mapped): a fault is delivered to the
    // faulting thread before its next instruction, so the process ends by a signal, never by
    // the exit below.
    let none = 0usize as *mut u64;
    let dfl: [u64; 4] = [0, 0, 0, 0];
    let sig32 = sig as% i32;
    let r = unsafe("dfl is the kernel's four-word struct sigaction for SIG_DFL") os.rt_sigaction(sig32, &dfl as *const [u64; 4] as *const u64, none);
    let r1 = unsafe("dfl is the kernel's four-word struct sigaction for SIG_DFL") os.rt_sigaction(os.SIGSEGV, &dfl as *const [u64; 4] as *const u64, none);
    let set: [u64; 1] = [os.FAULT_SET];
    let r2 = unsafe("set is one sigset word") os.rt_sigprocmask(os.SIG_UNBLOCK, &set as *const [u64; 1] as *const u64, none);
    let r3 = os.kill(os.getpid(), sig32);
    let z = unsafe("address 0 is never mapped: the read faults, with SIGSEGV's default action") atomic.load_u64(0usize as *const u64);
    os.exit_group(128 + sig32);
}

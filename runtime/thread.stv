// runtime.thread: CPU threads.
//
// A thread runs one fn value `fn()` (a closure: code + environment, contracts/checked-ir.md
// "Closures") on its own mapping, laid out bottom to top as
//     [guard: config.GUARD, PROT_NONE][stack][alternate stacks: panic.alt_len][record]
// where the stack has config.thread_stack(code of the fn value) bytes: the compiler's bytes for
// threads started with that fn, else `[run] stack`.
// The record (one page) holds the futex word `tid`, the fn value, the mapping, and the thread's
// block (runtime.state Block: its thread pointer, set by the clone). The thread
// is created with clone3 (or `clone` where clone3 is ENOSYS: qemu-user), sharing the address
// space, files, and signal handlers (runtime.os.spawn_thread); the kernel writes its tid into
// `tid` and, when it exits, clears `tid` and wakes the futex: that is the join. The child starts
// in `entry` (through the compiler's `__stave_thread_start` stub and the `thread_clone`
// intrinsic), installs its alternate signal stack, runs the fn value, and returns; the intrinsic
// then makes the `exit` system call.
//
// Thread ids: main is 0; each created thread takes the next number, process-wide
// (`state.next_thread`, atomic), kept in the thread's block for the panic report. The mapping is
// entered in the registry (`state.reg`), so the signal handler finds its guard from an address.
//
// Entry points fixed by the compiler (contracts/intrinsics.md "Paths fixed by the compiler"):
// `entry` (thread start), `scope_spawn` and `scope_join` (the lowering of `scope { spawn { } }`:
// the scope holds a `usize` list head, 0 = empty; each `spawn` body is a closure added to it by
// `scope_spawn`; `scope_join` runs at every exit of the scope block). std.thread uses `start` /
// `join` / `scope_spawn` / `scope_join`.
//
// If a thread cannot be created (no memory for the mapping, the guard pages cannot be
// protected, clone failing: EAGAIN) the program panics with "cannot create thread". Exception:
// the IR interpreter has one thread and makes clone fail with ENOSYS, and its image has no stack
// table (`config.has_stack_table`; a native image always has one, so a native ENOSYS is the
// failure above); there `start` keeps the record with the fn value queued (`queued` = 1) and the
// fn value runs on the joining thread when `join` gets the handle (`scope_join`, std.thread's
// `join` and `par_for`), oldest spawn first. So the body waits for nothing the joiner holds at the join,
// which the join rule (E1406) checks. It runs as a task of its own there too: its error trace
// starts empty and the caller's is restored after it (runtime.errtrace). A handle never joined
// never runs its fn value on such a target: `start`'s obligation joins every handle, and a panic
// ends the process before it.

import runtime.os;
import runtime.state;
import runtime.atomic;
import runtime.panic;
import runtime.config;
import runtime.errtrace;

struct Thread {
    // kernel tid while the thread runs; 0 once it has exited (futex word, CLONE_CHILD_CLEARTID)
    tid: u32,
    // 1: no thread was created; `join` runs the fn value (code, env) on the joining thread
    queued: u32,
    // the fn value to run: (code, environment)
    code: usize,
    env: usize,
    map: usize,
    map_len: usize,
    alt: usize,
    alt_len: usize,
    // registry entry (state.MAX_THREADS: none)
    entry: usize,
    // next record of a scope's list (0: end)
    next: usize,
    blk: state.Block,
}

fn round_up(x: usize, a: usize) -> usize {
    return (x + a - 1) / a * a;
}

// A fn value's two words (ASSUMPTION A5, runtime/README.md: a fn value is (code, environment)).
fn fn_words(f: fn()) -> [usize; 2] {
    return unsafe("a fn value is two words, code then environment") *(&f as *const fn() as *const [usize; 2]);
}

// Starts a thread running f (or queues f for `join` where no thread can be created); returns
// its handle for `join`.
pub unsafe("f and everything it captures stay valid until join(handle) returns")
fn start(f: fn()) -> usize {
    let page = state.page_size();
    let w = fn_words(f);
    let guard = round_up(config.GUARD, page);
    let size = round_up(config.thread_stack(w[0]), page);
    let alt = panic.alt_len(page);
    let len = guard + size + alt + page;
    let prot = os.PROT_READ | os.PROT_WRITE;
    let flags = os.MAP_PRIVATE | os.MAP_ANONYMOUS | os.MAP_NORESERVE | os.MAP_STACK;
    let m = unsafe("no MAP_FIXED and fd -1: fresh anonymous pages the kernel picks") os.mmap(0, len, prot, flags, -1, 0);
    if m < 0 {
        cannot_create();
    }
    let base = m as% usize;
    let g = unsafe("the guard pages are part of the fresh mapping and hold no objects") os.mprotect(base, guard, os.PROT_NONE);
    let ag = unsafe("[base + guard + size, + alt) is part of the fresh mapping; no object and no thread uses it") panic.alt_guards(base + guard + size, page);
    if g < 0 || !ag {
        // a thread is never run without its guard
        let u = unsafe("the mapping is fresh: no object and no thread uses it") os.munmap(base, len);
        cannot_create();
    }
    let th = (base + guard + size + alt) as *mut Thread;
    let st = state.get();
    let idp = unsafe("st is runtime.state.STATE; only the field address is taken") &mut (*st).next_thread as *mut u64;
    let id = unsafe("idp is the thread counter of the state block") atomic.fetch_add_u64(idp, 1) + 1;
    let e = register(base, base + len, base + guard, id);
    // until the thread stores its own, a report names the creating thread's user site: the
    // user call that started the thread
    let site = panic.user_site();
    unsafe("th is the record page of the fresh mapping; no thread uses it yet") {
        th.write(Thread.{
            tid: 0,
            queued: 0,
            code: w[0],
            env: w[1],
            map: base,
            map_len: len,
            alt: panic.signal_base(base + guard + size, page),
            alt_len: round_up(config.ALTSTACK, page),
            entry: e,
            next: 0,
            blk: state.Block.{
                this: 0,
                thread_id: id,
                user_site: site,
                requires_site: 0,
                origin: state.NO_SITE,
                count: 0,
                ring: [0u32; state.NRING],
                alt_top: panic.report_top(base + guard + size, page),
                alt_size: round_up(config.REPORT_STACK, page),
                in_signal: 0,
            },
        });
    }
    let bp = unsafe("th is the record (above)") &mut (*th).blk as *mut state.Block;
    unsafe("bp is the block of the record above; no thread uses it yet") { (*bp).this = bp as usize; }
    let tidp = unsafe("th is the record (above)") &mut (*th).tid as *mut u32;
    let r = unsafe("[base + guard, + size) is the fresh stack; tid and the block live in the record until join unmaps it; entry reads th") os.spawn_thread(base + guard, size, tidp, bp as usize, th as usize);
    if r < 0 {
        if r != -os.ENOSYS || config.has_stack_table() {
            unsafe("the thread was not created: nothing else uses the mapping") { release(th); }
            cannot_create();
        }
        // the IR interpreter (one thread, no stack table): f runs at the join
        unsafe("th is the record above; no thread uses it") { (*th).queued = 1; }
    }
    return th as usize;
}

// Runs the fn value queued in record th on this thread, as a task of its own.
unsafe("th is a live record whose fn value's captures are valid (start's obligation)") fn run_queued(th: *mut Thread) {
    let w: [usize; 2] = unsafe("th is the live record start filled: code and env are the two words of its fn value") [(*th).code, (*th).env];
    let f = unsafe("w holds the two words of the fn value start was given") *(&w as *const [usize; 2] as *const fn());
    let saved = errtrace.save();
    errtrace.clear();
    f();
    errtrace.restore(&saved);
}

// The panic of a thread whose signal stack the kernel refused (kind Assert at the user site that
// started it, message on the next line).
fn cannot_install() -> never {
    let msg = "cannot install the thread's signal stack";
    panic.abort(unsafe("&str and &[u8] are both (data pointer, byte length)") *(&msg as *const &str as *const &[u8]));
}

// The panic of a failed thread creation (kind Assert at the user site, message on the next line).
fn cannot_create() -> never {
    let msg = "cannot create thread";
    panic.abort(unsafe("&str and &[u8] are both (data pointer, byte length)") *(&msg as *const &str as *const &[u8]));
}

// Waits until the thread of handle h has exited (or runs its queued fn value here), then frees
// its mapping (h = 0: nothing).
pub unsafe("h came from start and is joined once")
fn join(h: usize) {
    if h == 0 { return; }
    let th = h as *mut Thread;
    if unsafe("th is a live record (caller)") (*th).queued == 1 {
        unsafe("th is live; start's obligation keeps the captures valid until this join") { run_queued(th); }
    }
    let tidp = unsafe("th is a live record (caller)") &mut (*th).tid as *mut u32;
    loop {
        let t = unsafe("tidp is the record's futex word") atomic.load_u32(tidp as *const u32);
        if t == 0 { break; }
        // not FUTEX_PRIVATE: the kernel's exit-time wake of CLONE_CHILD_CLEARTID is a shared one
        let r = unsafe("tidp is a valid futex word") os.futex(tidp, os.FUTEX_WAIT, t, 0, 0, 0);
    }
    unsafe("the thread has exited: nothing else uses the record or its mapping") { release(th); }
}

unsafe("th is the record of a mapping no thread uses any more") fn release(th: *mut Thread) {
    let e = unsafe("th is the record in the mapping, which stays mapped until the munmap below and which no thread writes any more") (*th).entry;
    let base = unsafe("th is the record in the mapping, which stays mapped until the munmap below and which no thread writes any more") (*th).map;
    let len = unsafe("th is the record in the mapping, which stays mapped until the munmap below and which no thread writes any more") (*th).map_len;
    unregister(e);
    let r = unsafe("base, len are the mapping start() created, read from its record: no live object lies in it and no thread uses it") os.munmap(base, len);
}

// ---- `scope { spawn { } }` (compiler-emitted calls) ----

// Starts f on a new thread (queued where none can be created) and adds it to the scope list
// `list`.
pub unsafe("f's captures stay valid until scope_join(list) returns (the lowering calls it at every exit of the scope)")
fn scope_spawn(list: &mut usize, f: fn()) {
    let h = unsafe("f's captures stay valid until scope_join(list) returns: the handle goes on the list that call joins") start(f);
    let th = h as *mut Thread;
    unsafe("th is the live record start returned; only the spawning thread links it") { (*th).next = *list; }
    *list = h;
}

// Joins every thread of the scope list, oldest first (the order queued fn values run in), and
// empties it.
pub unsafe("*list is 0 or the head of a chain built only by scope_spawn, whose records no other join frees")
fn scope_join(list: &mut usize) {
    // the list is newest first: reverse it
    let mut old: usize = 0;
    let mut h = *list;
    while h != 0 {
        let th = h as *mut Thread;
        let next = unsafe("h is the head of the chain scope_spawn built in *list (this fn's obligation), so a record start() created that no join has freed") (*th).next;
        unsafe("only the spawning thread links the list") { (*th).next = old; }
        old = h;
        h = next;
    }
    h = old;
    while h != 0 {
        let th = h as *mut Thread;
        let next = unsafe("h is a record of the reversed chain: start() created it and no join has freed it") (*th).next;
        unsafe("h came from start through scope_spawn and is in the list once, so this is its only join") { join(h); }
        h = next;
    }
    *list = 0;
}

// ---- thread start (called by `__stave_thread_start`) ----

// The thread body.
pub unsafe("arg is the record start passed to os.spawn_thread, mapped until its join and holding the fn value start stored; called once, as the body of the thread spawn_thread created for it; the fn value's captures stay valid while it runs (start's obligation)")
fn entry(arg: usize) -> usize {
    let th = arg as *const Thread;
    let alt = unsafe("arg is the record start passed to spawn_thread, mapped until join (this fn's obligation)") (*th).alt;
    let alt_len = unsafe("arg is the record start passed to spawn_thread, mapped until join (this fn's obligation)") (*th).alt_len;
    let ok = unsafe("[alt, alt + alt_len) is this thread's signal stack, config.ALTSTACK rounded up, with a guard page below it, in the mapping start made; used for nothing else, since entry runs once for its record (this fn's obligation); mapped while the thread runs, since join unmaps only after the kernel's exit-time CLEARTID wake") panic.set_altstack(alt, alt_len);
    if !ok {
        // a stack overflow would end the thread by a raw SIGSEGV: fail before the body runs
        cannot_install();
    }
    let code = unsafe("arg is the record start passed to spawn_thread, mapped until join (this fn's obligation)") (*th).code;
    let env = unsafe("arg is the record start passed to spawn_thread, mapped until join (this fn's obligation)") (*th).env;
    let w: [usize; 2] = [code, env];
    let f = unsafe("w holds (code, environment) of the fn value start was given: a fn value is two words, code then environment") *(&w as *const [usize; 2] as *const fn());
    f();
    return 0;
}

// ---- CPUs ----

// The number of CPUs in this process's sched_getaffinity mask (at least 1), cached.
pub fn cpu_count() -> usize {
    let st = state.get();
    let np = unsafe("st is runtime.state.STATE; only the field address is taken") &mut (*st).ncpu as *mut u64;
    let c = unsafe("np is the CPU count word of the state block") atomic.load_u64(np as *const u64);
    if c != 0 { return c as usize; }
    let mut mask: [u64; 16] = [0u64; 16];
    let r = unsafe("mask is 128 writable bytes") os.sched_getaffinity(0, 128, &mut mask as *mut [u64; 16] as *mut u8);
    let mut n: u64 = 0;
    if r > 0 {
        let words = ((r as% usize) + 7) / 8;
        for i in 0..words {
            if i < 16 { n = n + (mask[i].popcount() as u64); }
        }
    }
    if n == 0 { n = 1; }
    let old = unsafe("np is the CPU count word of the state block") atomic.swap_u64(np, n);
    return n as usize;
}

// ---- registry (state.reg) ----

fn reg_lock() -> *mut u32 {
    let st = state.get();
    return unsafe("st is runtime.state.STATE; only the field address is taken") &mut (*st).reg_lock as *mut u32;
}

// Enters [lo, hi) (guard [lo, guard_hi)) with thread id `id`; returns the entry or MAX_THREADS
// when the registry is full (the thread then reports id 0 and its overflows are plain faults).
fn register(lo: usize, hi: usize, guard_hi: usize, id: u64) -> usize {
    let st = state.get();
    let w = reg_lock();
    let mut found = state.MAX_THREADS;
    unsafe("w is the registry lock word in the state block") { atomic.lock(w); }
    for e in 0..state.MAX_THREADS {
        let k = e * state.REG_WORDS;
        let used = unsafe("the registry lock is held") (*st).reg[k];
        if used == 0 {
            // The signal handler reads lo, hi, and guard_hi without the lock (runtime.panic
            // find_entry), so they are stored atomically, lo last: readers skip lo == 0.
            unsafe("the registry lock is held; k + 3 < REG_LEN: 8-byte aligned words of the registry") {
                let _ = atomic.swap_u64(reg_word_ptr(k + 1), hi as u64);
                let _ = atomic.swap_u64(reg_word_ptr(k + 2), guard_hi as u64);
                (*st).reg[k + 3] = id as usize;
                let _ = atomic.swap_u64(reg_word_ptr(k), lo as u64);
            }
            found = e;
            break;
        }
    }
    unsafe("this thread holds the registry lock") { atomic.unlock(w); }
    return found;
}

fn unregister(e: usize) {
    if e >= state.MAX_THREADS { return; }
    let st = state.get();
    let w = reg_lock();
    unsafe("w is the registry lock word in the state block") { atomic.lock(w); }
    unsafe("the registry lock is held; e < MAX_THREADS: an 8-byte aligned word of the registry") {
        let _ = atomic.swap_u64(reg_word_ptr(e * state.REG_WORDS), 0);
    }
    unsafe("this thread holds the registry lock") { atomic.unlock(w); }
}

// The address of registry word i (i < REG_LEN).
fn reg_word_ptr(i: usize) -> *mut u64 {
    let st = state.get();
    let base = unsafe("st is runtime.state.STATE; only the field address is taken") &mut (*st).reg as *mut [usize; state.REG_LEN] as usize;
    return (base + i * 8) as *mut u64;
}

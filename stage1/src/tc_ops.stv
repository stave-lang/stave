// User operators of the body checker (types/check, see `typeck`), as stage0's `user_op`: an
// operator on a type no built-in rule covers (a struct, enum, generic param, reference, tuple,
// `char`, ..) goes through its operator trait (`traits.OPS`). Its value is the operand type when
// that type implements the trait and is Copy where the operator is used, both goals of the one
// solver in the body's environment (a generic param: its bounds); else the error type, as
// stage0's: E0206 without an impl, E0422 when the operand is not Copy (a generic param without
// the operator's bound is stage0's E0901, not reported here). A goal not answered yet leaves the
// operator unknown for this round (`tc_traits`). An operator through its trait has a target
// (`tc_facts.T_OP`): the trait and the operand type.
import generated.terminals;
import sigs;
import tc_facts;
import tc_rows;
import tc_traits;
import ir.types;
import std.vec;

const NONE: u32 = tc_rows.NONE;
const UNK: u32 = tc_rows.UNK;
const ERR: u32 = types.ERR;

// The positions of `Neg` and `Not` in `traits.OPS`.
pub const OP_NEG: usize = 17;
pub const OP_NOT: usize = 18;

// Whether an operator on type ty goes through its trait: no built-in rule covers ty.
pub fn user_ty(tab: &types.Table, ty: u32) -> bool {
    if ty == NONE || ty == types.ERR { return false; }
    let tag = tab.tag_of(ty);
    return tag != types.TK_INT && tag != types.TK_FLOAT && tag != types.TK_BOOL && tag != types.TK_MASK && tag != types.TK_VECTOR && tag != types.TK_NEVER;
}

// The position in `traits.OPS` of the trait of binary operator token op, or NONE.
pub fn binop_trait(op: u8) -> usize {
    if op == terminals.T_PLUS { return 0; }
    if op == terminals.T_PLUS_PERCENT { return 1; }
    if op == terminals.T_PLUS_PIPE { return 2; }
    if op == terminals.T_MINUS { return 3; }
    if op == terminals.T_MINUS_PERCENT { return 4; }
    if op == terminals.T_MINUS_PIPE { return 5; }
    if op == terminals.T_STAR { return 6; }
    if op == terminals.T_STAR_PERCENT { return 7; }
    if op == terminals.T_STAR_PIPE { return 8; }
    if op == terminals.T_SLASH { return 9; }
    if op == terminals.T_PERCENT { return 10; }
    if op == terminals.T_LT_LT { return 11; }
    if op == terminals.T_LT_LT_PERCENT { return 12; }
    if op == terminals.T_GT_GT { return 13; }
    if op == terminals.T_AMP { return 14; }
    if op == terminals.T_PIPE { return 15; }
    if op == terminals.T_CARET { return 16; }
    return NONE as usize;
}

impl tc_rows.Typeck {
    // An operator (token tok) of trait k (a position in `traits.OPS`, NONE: none) on operands of
    // type t.
    pub fn user_op(&mut self, sg: &mut sigs.Sigs, k: usize, t: u32, tok: u32) -> u32 {
        let tab = &sg.cx.tab;
        let param = tab.tag_of(t) == types.TK_PARAM;
        if k == NONE as usize || self.tq.tr.lang.ops.as_slice()[k] == NONE {
            // no operator trait: E0206
            let r = tab.tag_of(t) == types.TK_REF;
            self.report_span(206, if r then tc_rows.C_REF_OPERAND else 0u8, tok, tok, NONE, t, NONE, NONE);
            return ERR;
        }
        let tr = self.tq.tr.lang.ops.as_slice()[k];
        let cp = self.tq.tr.lang.copy_tr;
        if cp == NONE { return UNK; }
        let e = self.tq.env_of(sg, self.sc);
        let a = self.tq.holds(sg, e, t, tr);
        let c = self.tq.holds(sg, e, t, cp);
        // stage0's E0206 (E0901 for a generic param, not reported here) / E0422: the operator's
        // value is the error type, the rest of the body is typed as without it
        if a == tc_traits.A_NO {
            if param { return ERR; }
            let r = sg.cx.tab.tag_of(t) == types.TK_REF;
            self.report_span(206, if r then tc_rows.C_REF_OPERAND else 0u8, tok, tok, NONE, t, NONE, NONE);
            return ERR;
        }
        if a == tc_traits.A_WAIT || c == tc_traits.A_WAIT { return UNK; }
        if c == tc_traits.A_NO { return self.e0422_operand(sg, e, k, tr, t, tok); }
        let x = self.fact(tok, tc_facts.T_OP, tr, k as% u32, 0, 0, NONE, t);
        self.fx.set_val(x, t);
        return t;
    }

    // E0422 at operator token tok of trait k (decl tr) whose operand type t implements tr but
    // is not Copy where it is used: a generic param names its declaration (case `operand`, x the
    // param's row of `Gens`); any other type the impl the operator goes through (x), case
    // `operand-args` when t names params, else `operand-type`.
    fn e0422_operand(&mut self, sg: &mut sigs.Sigs, e: u32, k: usize, tr: u32, t: u32, tok: u32) -> u32 {
        let mut case = tc_rows.C_OPERAND;
        let mut x = NONE;
        if sg.cx.tab.tag_of(t) == types.TK_PARAM {
            x = self.sc.row(sg.cx.tab.a_of(t));
        } else {
            case = if sigs.has_params(&sg.cx.tab, t) then tc_rows.C_OPERAND_ARGS else tc_rows.C_OPERAND_TYPE;
            let mut cands = vec.Vec::<u32>.new();
            let pos = self.tq.tr.im.trait_pos(tr);
            if pos != NONE { self.tq.tr.candidates_at(&sg.cx.tab, pos, t, &mut cands); }
            for j in 0..cands.len() {
                let i = cands.as_slice()[j];
                let ap = self.tq.applies(sg, e, i, t);
                if ap == tc_traits.A_WAIT { return UNK; }
                if ap == tc_traits.A_YES {
                    x = i;
                    break;
                }
            }
        }
        self.report_span(422, case, tok, tok, NONE, t, k as% u32, NONE);
        let r = self.dg.x.len() - 1;
        self.dg.x.as_mut_slice()[r] = x;
        return ERR;
    }
}

// `stage1 ir check|fmt FILE`: loads IR text (contracts/checked-ir.md "Loading": lines, structure,
// verification) and, for `fmt`, prints the canonical module's text on stdout. A fault prints
// `FILE:LINE:COL: error: MSG` or `FILE:LINE: verify: MSG` on stderr (at most 100) and exits 1;
// an unreadable FILE or a bad command line exits 2.
//
// `stage1 ir opt [--passes=base|full] [--dump=inline] [--dump-phase=inline|clean|base]
// [--verify-phases] [--limit NAME=N]... FILE` (contracts/cli-stage1.md): on a `release checked`
// FILE, canonicalized before the first round, the rounds of rule P1, each `canon(C*(X(D(M'))))`,
// then the base passes and `canon`: the module at level `opt`, or the decision tables of every
// round, or the canonical module after X, after C*, or after B. With `--passes=base` the rounds
// are left out (rule P3). The stage1 verifier checks the module printed and, with
// `--verify-phases`, the canonical module after every phase of every round (a fault: exit 3).
import ir.canon;
import ir.load;
import ir.model;
import ir.print;
import opt.base;
import opt.clean;
import opt.decide;
import opt.expand;
import opt.facts;
import text;
import std.env;
import std.io;
import std.mem;
import std.num;
import std.string;
import std.vec;

pub fn run() -> i32 {
    let n = env.count();
    let mut args = vec.Vec::<string.String>.with_capacity(n);
    for i in 0..n {
        match env.arg(i) {
            Option.Some(s) => { args.push(s); }
            Option.None => { args.push(string.String.new()); }
        }
    }
    let a = args.as_slice();
    if n > 2 && text.eq_str(a[2].as_bytes(), "opt") { return opt_run(a); }
    if n != 4 {
        io.eprint("stage1: usage: stage1 ir check|fmt FILE, stage1 ir opt [--passes=base|full] [--dump=inline|--dump-phase=inline|clean|base] [--verify-phases] [--limit NAME=N]... FILE\n");
        return 2;
    }
    let verb = a[2].as_bytes();
    let fmt = text.eq_str(verb, "fmt");
    if !fmt && !text.eq_str(verb, "check") {
        let v = &a[2];
        io.eprint(f"stage1: unknown ir verb `{v}` (stage1 runs ir check, ir fmt, and ir opt)\n");
        return 2;
    }
    let file = &a[3];
    let mut src = vec.Vec::<u8>.new();
    if !read_into(file, &mut src) { return 2; }
    let mut ld = load.load(src.as_slice());
    if !ld.ok() {
        let out = ld.errs.render(file.as_bytes());
        let _ = io.write_all(2, out.as_slice());
        return 1;
    }
    if fmt {
        canon.canon(&mut ld.m);
        let out = print.print(&ld.m);
        let _ = io.write_all(1, out.as_slice());
    }
    return 0;
}

fn read_into(file: &string.String, src: &mut vec.Vec<u8>) -> bool {
    match io.read_file(file.as_str()) {
        Result.Ok(b) => { *src = b; }
        Result.Err(e) => {
            io.eprint(f"stage1: cannot read {file}: {e}\n");
            return false;
        }
    }
    return true;
}

// What `ir opt` prints: the `inline` dump, the module after X or after C* of the last round, or
// the output (after the base passes).
const SHOW_DUMP: u8 = 0;
const SHOW_INLINE: u8 = 1;
const SHOW_CLEAN: u8 = 2;
const SHOW_OUTPUT: u8 = 3;

fn opt_run(a: &[string.String]) -> i32 {
    let mut lim = decide.Limits.table();
    let mut show = SHOW_OUTPUT;
    let mut dump = false;
    let mut only_base = false;
    let mut passed = false;
    let mut verify = false;
    let mut phased = false;
    let mut k: usize = 3;
    while k + 1 < a.len() {
        let f = a[k].as_bytes();
        if text.eq_str(f, "--dump=inline") {
            dump = true;
        } else if text.eq_str(f, "--dump-phase=inline") && !phased {
            show = SHOW_INLINE;
            phased = true;
        } else if text.eq_str(f, "--dump-phase=clean") && !phased {
            show = SHOW_CLEAN;
            phased = true;
        } else if text.eq_str(f, "--dump-phase=base") && !phased {
            phased = true;
        } else if (text.eq_str(f, "--passes=base") || text.eq_str(f, "--passes=full")) && !passed {
            only_base = text.eq_str(f, "--passes=base");
            passed = true;
        } else if text.eq_str(f, "--verify-phases") {
            verify = true;
        } else if text.eq_str(f, "--limit") && k + 2 < a.len() {
            k = k + 1;
            if !set_limit(&mut lim, a[k].as_bytes()) {
                let s = &a[k];
                io.eprint(f"stage1: ir opt: bad --limit `{s}` (NAME=N, NAME one of threshold cap call_saved slot_callee slot_caller rounds, within opt-passes.md K3)\n");
                return 2;
            }
        } else {
            let s = &a[k];
            io.eprint(f"stage1: ir opt: unknown or repeated flag `{s}`\n");
            return 2;
        }
        k = k + 1;
    }
    if k + 1 != a.len() || text.starts_with(a[k].as_bytes(), mem.str_bytes("--")) {
        io.eprint("stage1: usage: stage1 ir opt [--passes=base|full] [--dump=inline|--dump-phase=inline|clean|base] [--verify-phases] [--limit NAME=N]... FILE\n");
        return 2;
    }
    if dump && phased {
        io.eprint("stage1: ir opt: --dump and --dump-phase exclude each other\n");
        return 2;
    }
    if only_base && (dump || show == SHOW_INLINE || show == SHOW_CLEAN) {
        io.eprint("stage1: ir opt: --passes=base runs no decision, expansion, or clean-up: --dump=inline and --dump-phase=inline|clean need --passes=full\n");
        return 2;
    }
    if dump { show = SHOW_DUMP; }
    let file = &a[k];
    let mut src = vec.Vec::<u8>.new();
    if !read_into(file, &mut src) { return 2; }
    let mut ld = load.load(src.as_slice());
    if !ld.ok() {
        let out = ld.errs.render(file.as_bytes());
        let _ = io.write_all(2, out.as_slice());
        return 1;
    }
    if ld.m.mode != model.MODE_RELEASE || ld.m.level != model.LEVEL_CHECKED {
        io.eprint(f"{file}: error: ir opt reads a `release checked` module\n");
        return 1;
    }
    let m = &mut ld.m;
    canon.canon(m);
    let mut out = vec.Vec::<u8>.new();
    let mut txt = vec.Vec::<u8>.new();
    let n = if only_base then 0 else lim.rounds;
    let mut r: u64 = 1;
    while r <= n {
        let last = r == n;
        let fx = facts.build(&*m);
        let d = decide.decide(&*m, &fx, &lim);
        if show == SHOW_DUMP {
            decide.dump(&*m, &fx, &d, r as% u32, &mut out);
            if last { break; }
        }
        expand.run(m, &fx, &d);
        canon.canon(m);
        if (verify || (last && show == SHOW_INLINE)) && !phase_text(file, "inline", &*m, &mut txt) { return 3; }
        if last && show == SHOW_INLINE { break; }
        let _ = clean.run(m);
        canon.canon(m);
        if (verify || (last && show == SHOW_CLEAN)) && !phase_text(file, "clean", &*m, &mut txt) { return 3; }
        r = r + 1;
    }
    if show == SHOW_OUTPUT {
        base.run(m);
        canon.canon(m);
        m.level = model.LEVEL_OPT;
        if !phase_text(file, "base", &*m, &mut txt) { return 3; }
    }
    let _ = io.write_all(1, if show == SHOW_DUMP then out.as_slice() else txt.as_slice());
    return 0;
}

// The text of m after phase `ph` into out, checked by the stage1 verifier on its reload (false: a
// fault, reported). A printed module is always checked (P4).
fn phase_text(file: &string.String, ph: &str, m: &model.Module, out: &mut vec.Vec<u8>) -> bool {
    *out = print.print(m);
    return phase_verified(file, ph, out.as_slice());
}

// The stage1 verifier on t, the printed module after phase `ph`: each fault prints
// `FILE: internal error: PH: @<inst>: MSG` on stderr, `<inst>` the fn whose lines hold it.
fn phase_verified(file: &string.String, ph: &str, t: &[u8]) -> bool {
    let ld = load.load(t);
    if ld.ok() { return true; }
    let mut e = vec.Vec::<u8>.new();
    for j in 0..ld.errs.len() {
        e.extend_from_slice(file.as_bytes());
        e.extend_from_slice(mem.str_bytes(": internal error: "));
        e.extend_from_slice(mem.str_bytes(ph));
        e.extend_from_slice(mem.str_bytes(": "));
        let line = ld.errs.line.as_slice()[j];
        let mut at = ld.fn_line.len();
        for f in 0..ld.fn_line.len() {
            if ld.fn_line.as_slice()[f] <= line { at = f; }
        }
        if at < ld.m.fn_inst.rows() {
            e.push(64);
            print.push_inst(&mut e, ld.m.fn_inst.row(at));
            e.extend_from_slice(mem.str_bytes(": "));
        }
        e.extend_from_slice(ld.errs.msg.row(j));
        e.push(10);
    }
    let _ = io.write_all(2, e.as_slice());
    return false;
}

// `NAME=N` into lim.
fn set_limit(lim: &mut decide.Limits, b: &[u8]) -> bool {
    for i in 0..b.len() {
        if b[i] != 61 { continue; }
        let v = text.string_of(&b[i + 1..b.len()]);
        return match num.parse_u64(v.as_str()) {
            Option.Some(x) => lim.set(&b[0..i], x),
            Option.None => false,
        };
    }
    return false;
}

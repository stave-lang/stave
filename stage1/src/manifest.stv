// `stave.toml`: the TOML subset of stage0's manifest reader, with the byte span of every key and
// value, and the keys package discovery needs (`name`, `kind`, `[dependencies]`,
// `[target.<t>.dependencies]`).
//
// The parse is stage0's line by line: comments `#`, bare, quoted, and dotted keys, `[a.b]`
// headers (parents created implicitly), one-line inline tables, basic and literal strings,
// integers, floats, booleans, arrays (over lines). A syntax error or a redefined key stops the
// parse and is returned with its offset (`TErr`); every line before it stays, so the keys read
// back are the ones stage0 reads. `manifest_check` validates the result.
//
// Tables are flat: ids (0 = the root) with a kind and a span, and entry rows naming their table,
// in insertion order. The span of a table is the span of its `{ .. }` (inline), of the last key
// of its header, or of the key that first named it (implicit).
import text;
import std.mem;
import std.string;
import std.vec;

const TK_HEADER: u8 = 1;
const TK_IMPLICIT: u8 = 2;
const TK_INLINE: u8 = 3;

pub const V_STR: u8 = 0;
pub const V_OTHER: u8 = 1;
pub const V_TABLE: u8 = 2;

// "No span" in the spans of `Manifest` and `Dep`.
pub const NO_SPAN: u32 = 0xffff_ffff;

// Nesting bound of arrays and inline tables.
const MAX_DEPTH: usize = 64;

// A syntax error at `offset`, or (`dup`) a key or table defined a second time, at that key.
pub struct TErr {
    pub offset: u32,
    pub dup: bool,
}

fn syntax_at(o: u32) -> TErr {
    return TErr.{ offset: o, dup: false };
}

fn dup_at(o: u32) -> TErr {
    return TErr.{ offset: o, dup: true };
}

// A dotted key: its parts and their spans (a quoted part's span holds the quotes).
struct KeyPath {
    names: vec.Vec<vec.Vec<u8>>,
    lo: vec.Vec<u32>,
    hi: vec.Vec<u32>,
}

pub struct Doc {
    pub table_kind: vec.Vec<u8>,
    pub table_lo: vec.Vec<u32>,
    pub table_hi: vec.Vec<u32>,
    pub e_table: vec.Vec<u32>,
    pub e_key: vec.Vec<vec.Vec<u8>>,
    pub e_klo: vec.Vec<u32>,
    pub e_khi: vec.Vec<u32>,
    pub e_kind: vec.Vec<u8>,
    pub e_str: vec.Vec<vec.Vec<u8>>,
    pub e_sub: vec.Vec<u32>,
    pub e_vlo: vec.Vec<u32>,
    pub e_vhi: vec.Vec<u32>,
}

// A parsed value: a string's bytes, a table id, or another value (array, number, boolean), and
// its span.
struct Val {
    kind: u8,
    s: vec.Vec<u8>,
    sub: u32,
    lo: u32,
    hi: u32,
}

impl Doc {
    fn new() -> Doc {
        let mut k = vec.Vec::<u8>.new();
        k.push(0);
        let mut lo = vec.Vec::<u32>.new();
        lo.push(0);
        let mut hi = vec.Vec::<u32>.new();
        hi.push(0);
        return Doc.{
            table_kind: k,
            table_lo: lo,
            table_hi: hi,
            e_table: vec.Vec::<u32>.new(),
            e_key: vec.Vec::<vec.Vec<u8>>.new(),
            e_klo: vec.Vec::<u32>.new(),
            e_khi: vec.Vec::<u32>.new(),
            e_kind: vec.Vec::<u8>.new(),
            e_str: vec.Vec::<vec.Vec<u8>>.new(),
            e_sub: vec.Vec::<u32>.new(),
            e_vlo: vec.Vec::<u32>.new(),
            e_vhi: vec.Vec::<u32>.new(),
        };
    }

    fn new_table(&mut self, kind: u8, lo: u32, hi: u32) -> u32 {
        self.table_kind.push(kind);
        self.table_lo.push(lo);
        self.table_hi.push(hi);
        return (self.table_kind.len() - 1) as% u32;
    }

    // The entry of table t named key.
    pub fn find(&self, t: u32, key: &[u8]) -> Option<usize> {
        for i in 0..self.e_table.len() {
            if self.e_table.as_slice()[i] == t && text.eq(self.e_key.get_ref(i).as_slice(), key) {
                return Option.Some(i);
            }
        }
        return Option.None;
    }

    fn push(&mut self, t: u32, key: &[u8], klo: u32, khi: u32, v: Val) {
        let mut k = vec.Vec::<u8>.new();
        k.extend_from_slice(key);
        let Val.{ kind, s, sub, lo, hi } = v;
        self.e_table.push(t);
        self.e_key.push(k);
        self.e_klo.push(klo);
        self.e_khi.push(khi);
        self.e_kind.push(kind);
        self.e_str.push(s);
        self.e_sub.push(sub);
        self.e_vlo.push(lo);
        self.e_vhi.push(hi);
    }

    // The table an entry holds, if it holds one.
    pub fn sub_table(&self, e: usize) -> Option<u32> {
        if self.e_kind.as_slice()[e] != V_TABLE { return Option.None; }
        return Option.Some(self.e_sub.as_slice()[e]);
    }

    fn kind_of(&self, t: u32) -> u8 {
        return self.table_kind.as_slice()[t as usize];
    }

    // The span of an entry's value; of a table, the table's span.
    pub fn value_span(&self, e: usize) -> (u32, u32) {
        if self.e_kind.as_slice()[e] == V_TABLE {
            let t = self.e_sub.as_slice()[e] as usize;
            return (self.table_lo.as_slice()[t], self.table_hi.as_slice()[t]);
        }
        return (self.e_vlo.as_slice()[e], self.e_vhi.as_slice()[e]);
    }

    // The entries of table t, in insertion order.
    pub fn entries(&self, t: u32) -> vec.Vec<usize> {
        let mut out = vec.Vec::<usize>.new();
        for e in 0..self.e_table.len() {
            if self.e_table.as_slice()[e] == t { out.push(e); }
        }
        return out;
    }

    // Inserts v under the dotted key below table t; Err (at the part that clashes) on a
    // redefinition or a step through a non-table (parents made on the way stay).
    fn insert_dotted(&mut self, t: u32, key: &KeyPath, v: Val) -> Result<(), TErr> {
        let n = key.names.len();
        let mut cur = t;
        for k in 0..n {
            let name = key.names.get_ref(k).as_slice();
            let lo = key.lo.as_slice()[k];
            let hi = key.hi.as_slice()[k];
            if k + 1 == n {
                if self.find(cur, name).is_some() { return Result.Err(dup_at(lo)); }
                self.push(cur, name, lo, hi, v);
                return Result.Ok(());
            }
            let mut pos: usize = 0;
            match self.find(cur, name) {
                Option.Some(p) => { pos = p; }
                Option.None => {
                    let id = self.new_table(TK_IMPLICIT, lo, hi);
                    self.push(cur, name, lo, hi, table_val(id));
                    pos = self.e_kind.len() - 1;
                }
            }
            match self.sub_table(pos) {
                Option.Some(tt) => {
                    if self.kind_of(tt) == TK_INLINE { return Result.Err(dup_at(lo)); }
                    cur = tt;
                }
                Option.None => { return Result.Err(dup_at(lo)); }
            }
        }
        return Result.Ok(());
    }

    // The table at a header path, made as needed; Err (at the part that clashes) if a step is no
    // table or the table was already made by a header.
    fn header_table(&mut self, path: &KeyPath) -> Result<u32, TErr> {
        let n = path.names.len();
        let mut cur: u32 = 0;
        for k in 0..n {
            let last = k + 1 == n;
            let name = path.names.get_ref(k).as_slice();
            let lo = path.lo.as_slice()[k];
            let hi = path.hi.as_slice()[k];
            let mut pos: usize = 0;
            match self.find(cur, name) {
                Option.Some(p) => {
                    pos = p;
                    match self.sub_table(p) {
                        Option.Some(tt) => {
                            let tk = self.kind_of(tt);
                            if tk == TK_IMPLICIT && last {
                                *self.table_kind.get_mut(tt as usize) = TK_HEADER;
                                *self.table_lo.get_mut(tt as usize) = lo;
                                *self.table_hi.get_mut(tt as usize) = hi;
                            } else if tk == TK_INLINE || last {
                                return Result.Err(dup_at(lo));
                            }
                        }
                        Option.None => { return Result.Err(dup_at(lo)); }
                    }
                }
                Option.None => {
                    let id = self.new_table(if last then TK_HEADER else TK_IMPLICIT, lo, hi);
                    self.push(cur, name, lo, hi, table_val(id));
                    pos = self.e_kind.len() - 1;
                }
            }
            cur = self.e_sub.as_slice()[pos];
        }
        return Result.Ok(cur);
    }

    // The table at an existing header path.
    fn existing(&self, path: &vec.Vec<vec.Vec<u8>>) -> Option<u32> {
        let mut cur: u32 = 0;
        for k in 0..path.len() {
            match self.find(cur, path.get_ref(k).as_slice()) {
                Option.Some(p) => {
                    match self.sub_table(p) {
                        Option.Some(t) => { cur = t; }
                        Option.None => { return Option.None; }
                    }
                }
                Option.None => { return Option.None; }
            }
        }
        return Option.Some(cur);
    }
}
fn table_val(id: u32) -> Val {
    return Val.{ kind: V_TABLE, s: vec.Vec::<u8>.new(), sub: id, lo: 0, hi: 0 };
}

fn other_val(lo: u32, hi: u32) -> Val {
    return Val.{ kind: V_OTHER, s: vec.Vec::<u8>.new(), sub: 0, lo: lo, hi: hi };
}

// Parser state: the input and the offset.
view struct P {
    s: &[u8],
    i: usize,
}

impl P {
    fn peek(&self) -> u8 {
        return if self.i < self.s.len() then self.s[self.i] else 0;
    }

    fn peek_at(&self, k: usize) -> u8 {
        let j = self.i + k;
        return if j < self.s.len() then self.s[j] else 0;
    }

    fn at_end(&self) -> bool {
        return self.i >= self.s.len();
    }

    fn pos(&self) -> u32 {
        return self.i as% u32;
    }

    // A syntax error at the current offset.
    fn err(&self) -> TErr {
        return syntax_at(self.pos());
    }

    // Spaces and tabs.
    fn ws(&mut self) {
        while self.peek() == 32 || self.peek() == 9 { self.i = self.i + 1; }
    }

    fn comment(&mut self) {
        if self.peek() == 35 {
            while !self.at_end() && self.peek() != 10 { self.i = self.i + 1; }
        }
    }

    // Whitespace, newlines, and comments (inside arrays).
    fn ws_nl(&mut self) {
        loop {
            self.ws();
            self.comment();
            if self.peek() == 10 {
                self.i = self.i + 1;
            } else if self.peek() == 13 && self.peek_at(1) == 10 {
                self.i = self.i + 2;
            } else {
                return;
            }
        }
    }

    // Optional whitespace and comment, then a newline or the end.
    fn eol(&mut self) -> Result<(), TErr> {
        self.ws();
        self.comment();
        if self.peek() == 10 {
            self.i = self.i + 1;
            return Result.Ok(());
        }
        if self.peek() == 13 && self.peek_at(1) == 10 {
            self.i = self.i + 2;
            return Result.Ok(());
        }
        if self.at_end() { return Result.Ok(()); }
        return Result.Err(self.err());
    }

    fn simple_key(&mut self) -> Result<vec.Vec<u8>, TErr> {
        let c = self.peek();
        if c == 34 { return self.basic_string(); }
        if c == 39 { return self.literal_string(); }
        let lo = self.i;
        while is_bare(self.peek()) { self.i = self.i + 1; }
        if self.i == lo { return Result.Err(self.err()); }
        let mut k = vec.Vec::<u8>.new();
        k.extend_from_slice(&self.s[lo..self.i]);
        return Result.Ok(k);
    }

    fn key(&mut self) -> Result<KeyPath, TErr> {
        let mut kp = KeyPath.{ names: vec.Vec::<vec.Vec<u8>>.new(), lo: vec.Vec::<u32>.new(), hi: vec.Vec::<u32>.new() };
        kp.lo.push(self.pos());
        kp.names.push(self.simple_key()?);
        kp.hi.push(self.pos());
        loop {
            let save = self.i;
            self.ws();
            if self.peek() == 46 {
                self.i = self.i + 1;
                self.ws();
                kp.lo.push(self.pos());
                kp.names.push(self.simple_key()?);
                kp.hi.push(self.pos());
            } else {
                self.i = save;
                return Result.Ok(kp);
            }
        }
    }

    fn hex_char(&mut self, digits: usize, out: &mut vec.Vec<u8>) -> Result<(), TErr> {
        let mut v: u32 = 0;
        for k in 0..digits {
            let c = self.peek();
            let d: u32 = if c >= 48 && c <= 57 then (c - 48) as u32 else if c >= 97 && c <= 102 then (c - 87) as u32 else if c >= 65 && c <= 70 then (c - 55) as u32 else 16;
            if d == 16 { return Result.Err(self.err()); }
            v = v * 16 + d;
            self.i = self.i + 1;
        }
        if v > 0x10_ffff || (v >= 0xd800 && v <= 0xdfff) { return Result.Err(self.err()); }
        push_utf8(out, v);
        return Result.Ok(());
    }

    fn basic_string(&mut self) -> Result<vec.Vec<u8>, TErr> {
        self.i = self.i + 1;
        // multi-line strings are not supported
        if self.peek() == 34 && self.peek_at(1) == 34 { return Result.Err(self.err()); }
        let mut out = vec.Vec::<u8>.new();
        loop {
            let c = self.peek();
            if c == 34 {
                self.i = self.i + 1;
                break;
            }
            if c == 92 {
                self.i = self.i + 1;
                let e = self.peek();
                self.i = self.i + 1;
                if e == 34 || e == 92 {
                    out.push(e);
                } else if e == 110 {
                    out.push(10);
                } else if e == 116 {
                    out.push(9);
                } else if e == 114 {
                    out.push(13);
                } else if e == 98 {
                    out.push(8);
                } else if e == 102 {
                    out.push(12);
                } else if e == 101 {
                    out.push(27);
                } else if e == 117 {
                    self.hex_char(4, &mut out)?;
                } else if e == 85 {
                    self.hex_char(8, &mut out)?;
                } else {
                    self.i = self.i - 1;
                    return Result.Err(self.err());
                }
                continue;
            }
            if c == 10 || c == 13 || self.at_end() { return Result.Err(self.err()); }
            out.push(c);
            self.i = self.i + 1;
        }
        let (ok, bad) = text.utf8_valid_up_to(out.as_slice());
        if ok != out.len() { return Result.Err(self.err()); }
        return Result.Ok(out);
    }

    fn literal_string(&mut self) -> Result<vec.Vec<u8>, TErr> {
        self.i = self.i + 1;
        let lo = self.i;
        loop {
            let c = self.peek();
            if c == 39 { break; }
            if c == 10 || c == 13 || self.at_end() { return Result.Err(self.err()); }
            self.i = self.i + 1;
        }
        let mut out = vec.Vec::<u8>.new();
        out.extend_from_slice(&self.s[lo..self.i]);
        self.i = self.i + 1;
        let (ok, bad) = text.utf8_valid_up_to(out.as_slice());
        if ok != out.len() { return Result.Err(self.err()); }
        return Result.Ok(out);
    }

    fn number(&mut self) -> Result<Val, TErr> {
        let lo = self.i;
        while is_number_byte(self.peek()) { self.i = self.i + 1; }
        let t = &self.s[lo..self.i];
        if is_int(t) || is_float(t) { return Result.Ok(other_val(lo as% u32, self.pos())); }
        self.i = lo;
        return Result.Err(self.err());
    }

    rec fn value(&mut self, d: &mut Doc, depth: usize) -> Result<Val, TErr> {
        if depth > MAX_DEPTH { return Result.Err(self.err()); }
        let c = self.peek();
        let lo = self.pos();
        if c == 34 {
            let s = self.basic_string()?;
            return Result.Ok(Val.{ kind: V_STR, s: s, sub: 0, lo: lo, hi: self.pos() });
        }
        if c == 39 {
            let s = self.literal_string()?;
            return Result.Ok(Val.{ kind: V_STR, s: s, sub: 0, lo: lo, hi: self.pos() });
        }
        if c == 91 {
            self.i = self.i + 1;
            loop {
                self.ws_nl();
                if self.peek() == 93 {
                    self.i = self.i + 1;
                    break;
                }
                let item = self.value(d, depth + 1)?;
                self.ws_nl();
                let b = self.peek();
                if b == 44 {
                    self.i = self.i + 1;
                } else if b == 93 {
                    self.i = self.i + 1;
                    break;
                } else {
                    return Result.Err(self.err());
                }
            }
            return Result.Ok(other_val(lo, self.pos()));
        }
        if c == 123 {
            self.i = self.i + 1;
            let t = d.new_table(TK_INLINE, lo, lo);
            loop {
                self.ws();
                if self.peek() == 125 {
                    self.i = self.i + 1;
                    break;
                }
                let key = self.key()?;
                self.ws();
                if self.peek() != 61 { return Result.Err(self.err()); }
                self.i = self.i + 1;
                self.ws();
                let v = self.value(d, depth + 1)?;
                d.insert_dotted(t, &key, v)?;
                self.ws();
                let b = self.peek();
                if b == 44 {
                    self.i = self.i + 1;
                } else if b == 125 {
                    self.i = self.i + 1;
                    break;
                } else {
                    return Result.Err(self.err());
                }
            }
            *d.table_hi.get_mut(t as usize) = self.pos();
            return Result.Ok(table_val(t));
        }
        if c == 116 && text.starts_with(&self.s[self.i..self.s.len()], mem.str_bytes("true")) {
            self.i = self.i + 4;
            return Result.Ok(other_val(lo, self.pos()));
        }
        if c == 102 && text.starts_with(&self.s[self.i..self.s.len()], mem.str_bytes("false")) {
            self.i = self.i + 5;
            return Result.Ok(other_val(lo, self.pos()));
        }
        if (c >= 48 && c <= 57) || c == 43 || c == 45 || c == 105 || c == 110 { return self.number(); }
        return Result.Err(self.err());
    }

    // One header or key/value line.
    fn line(&mut self, d: &mut Doc, current: &mut vec.Vec<vec.Vec<u8>>) -> Result<(), TErr> {
        if self.peek() == 91 {
            self.i = self.i + 1;
            // arrays of tables are not supported
            if self.peek() == 91 { return Result.Err(self.err()); }
            self.ws();
            let path = self.key()?;
            self.ws();
            if self.peek() != 93 { return Result.Err(self.err()); }
            self.i = self.i + 1;
            self.eol()?;
            let t = d.header_table(&path)?;
            let KeyPath.{ names, lo, hi } = path;
            *current = names;
            return Result.Ok(());
        }
        let key = self.key()?;
        self.ws();
        if self.peek() != 61 { return Result.Err(self.err()); }
        self.i = self.i + 1;
        self.ws();
        let v = self.value(d, 0)?;
        self.eol()?;
        let t = if current.len() == 0 then Option.Some(0u32) else d.existing(&*current);
        return match t {
            Option.Some(t) => d.insert_dotted(t, &key, v),
            Option.None => Result.Err(syntax_at(key.lo.as_slice()[0])),
        };
    }
}

fn is_bare(c: u8) -> bool {
    return (c >= 65 && c <= 90) || (c >= 97 && c <= 122) || (c >= 48 && c <= 57) || c == 95 || c == 45;
}

fn is_number_byte(c: u8) -> bool {
    return is_bare(c) || c == 43 || c == 46;
}

fn is_dec(c: u8) -> bool {
    return c >= 48 && c <= 57;
}

fn digit_value(c: u8) -> u32 {
    return if is_dec(c) then (c - 48) as u32 else if c >= 97 && c <= 122 then (c - 87) as u32 else if c >= 65 && c <= 90 then (c - 55) as u32 else 99;
}

// stage0's integer rule: optional sign, `0x`/`0o`/`0b` (unsigned only) or decimal without a
// leading zero, `_` only between digits, value within i64.
fn is_int(t: &[u8]) -> bool {
    if t.len() == 0 { return false; }
    let signed = t[0] == 45 || t[0] == 43;
    let body = if signed then &t[1..t.len()] else t;
    let mut radix: u32 = 10;
    let mut digits = body;
    if body.len() >= 2 && body[0] == 48 && (body[1] == 120 || body[1] == 111 || body[1] == 98) {
        radix = if body[1] == 120 then 16 else if body[1] == 111 then 8 else 2;
        digits = &body[2..body.len()];
        if signed { return false; }
    } else if body.len() > 1 && body[0] == 48 {
        return false;
    }
    let n = digits.len();
    if n == 0 || digits[0] == 95 || digits[n - 1] == 95 { return false; }
    for k in 1..n {
        if digits[k] == 95 && digits[k - 1] == 95 { return false; }
    }
    // the digits without `_`, read as from_str_radix does (an optional sign of its own)
    let mut v: u64 = 0;
    let mut inner_neg = false;
    let mut seen = false;
    let mut first = true;
    for k in 0..n {
        let c = digits[k];
        if c == 95 { continue; }
        if first && (c == 43 || c == 45) {
            first = false;
            inner_neg = c == 45;
            continue;
        }
        first = false;
        let dv = digit_value(c) as u64;
        if dv >= (radix as u64) { return false; }
        seen = true;
        let limit: u64 = if inner_neg then 0x8000_0000_0000_0000 else 0x7fff_ffff_ffff_ffff;
        if v > (limit - dv) / (radix as u64) { return false; }
        v = v * (radix as u64) + dv;
    }
    return seen;
}

// stage0's float rule: `inf` / `nan` after an optional sign, or (without `_`) a decimal starting
// with a digit and holding `.`, `e`, or `E` that Rust's f64 parser accepts:
// `D+ ('.' D*)? ([eE] [+-]? D+)?`.
fn is_float(t: &[u8]) -> bool {
    let body = if t.len() > 0 && (t[0] == 43 || t[0] == 45) then &t[1..t.len()] else t;
    if text.eq_str(body, "inf") || text.eq_str(body, "nan") { return true; }
    let mut c = vec.Vec::<u8>.new();
    for k in 0..body.len() {
        if body[k] != 95 { c.push(body[k]); }
    }
    let s = c.as_slice();
    let n = s.len();
    if n == 0 || !is_dec(s[0]) { return false; }
    let mut marked = false;
    for k in 0..n {
        if s[k] == 46 || s[k] == 101 || s[k] == 69 { marked = true; }
    }
    if !marked { return false; }
    let mut i: usize = 0;
    while i < n && is_dec(s[i]) { i = i + 1; }
    if i < n && s[i] == 46 {
        i = i + 1;
        while i < n && is_dec(s[i]) { i = i + 1; }
    }
    if i < n && (s[i] == 101 || s[i] == 69) {
        i = i + 1;
        if i < n && (s[i] == 43 || s[i] == 45) { i = i + 1; }
        let d0 = i;
        while i < n && is_dec(s[i]) { i = i + 1; }
        if i == d0 { return false; }
    }
    return i == n;
}

fn push_utf8(out: &mut vec.Vec<u8>, v: u32) {
    if v < 0x80 {
        out.push(v as% u8);
    } else if v < 0x800 {
        out.push((0xc0 | (v >> 6)) as% u8);
        out.push((0x80 | (v & 0x3f)) as% u8);
    } else if v < 0x10000 {
        out.push((0xe0 | (v >> 12)) as% u8);
        out.push((0x80 | ((v >> 6) & 0x3f)) as% u8);
        out.push((0x80 | (v & 0x3f)) as% u8);
    } else {
        out.push((0xf0 | (v >> 18)) as% u8);
        out.push((0x80 | ((v >> 12) & 0x3f)) as% u8);
        out.push((0x80 | ((v >> 6) & 0x3f)) as% u8);
        out.push((0x80 | (v & 0x3f)) as% u8);
    }
}

// One dependency entry: its name, the path of a `{ path = "…" }` table, and the spans of the
// entry's key and of the `path` value (`NO_SPAN` when absent).
pub struct Dep {
    pub name: string.String,
    pub path: Option<string.String>,
    pub key_lo: u32,
    pub key_hi: u32,
    pub path_lo: u32,
    pub path_hi: u32,
}

// What discovery reads from a manifest: `name` and `kind` (strings) with their value spans
// (`NO_SPAN` when the key is absent; a `kind` that is no string has none), and the dependency
// tables in manifest order, each with the target it applies to ("" for `[dependencies]`).
pub struct Manifest {
    pub name: Option<string.String>,
    pub name_lo: u32,
    pub name_hi: u32,
    pub kind: Option<string.String>,
    pub kind_lo: u32,
    pub kind_hi: u32,
    pub dep_target: vec.Vec<string.String>,
    pub deps: vec.Vec<Dep>,
}

// The names a `[target.<t>]` table may use.
pub fn known_target(t: &[u8]) -> bool {
    return text.eq_str(t, "x86_64-linux") || text.eq_str(t, "x86_64-linux-v2") || text.eq_str(t, "x86_64-linux-v3") || text.eq_str(t, "x86_64-linux-v4") || text.eq_str(t, "aarch64-linux") || text.eq_str(t, "aarch64-linux+sve") || text.eq_str(t, "aarch64-linux+sve2") || text.eq_str(t, "gpu-sm86");
}

// The tables and entries of src, and the error that stopped the parse, if any.
pub fn read(src: &[u8]) -> (Doc, Option<TErr>) {
    let mut d = Doc.new();
    let mut p = P.{ s: src, i: 0 };
    let mut current = vec.Vec::<vec.Vec<u8>>.new();
    loop {
        p.ws_nl();
        if p.at_end() { break; }
        match p.line(&mut d, &mut current) {
            Result.Ok(_) => {}
            Result.Err(e) => { return (d, Option.Some(e)); }
        }
    }
    return (d, Option.None);
}

pub fn parse(src: &[u8]) -> Manifest {
    let (d, err) = read(src);
    return read_back(&d);
}

fn entry_string(d: &Doc, e: usize) -> Option<string.String> {
    if d.e_kind.as_slice()[e] != V_STR { return Option.None; }
    return Option.Some(text.string_of(d.e_str.get_ref(e).as_slice()));
}

fn read_deps(d: &Doc, t: u32, target: &[u8], m: &mut Manifest) {
    for e in 0..d.e_table.len() {
        if d.e_table.as_slice()[e] != t { continue; }
        let mut path: Option<string.String> = Option.None;
        let mut path_lo = NO_SPAN;
        let mut path_hi = NO_SPAN;
        match d.sub_table(e) {
            Option.Some(dt) => {
                for k in 0..d.e_table.len() {
                    if d.e_table.as_slice()[k] == dt && text.eq_str(d.e_key.get_ref(k).as_slice(), "path") {
                        path = entry_string(d, k);
                        let (lo, hi) = d.value_span(k);
                        path_lo = lo;
                        path_hi = hi;
                    }
                }
            }
            Option.None => {}
        }
        m.dep_target.push(text.string_of(target));
        m.deps.push(Dep.{ name: text.string_of(d.e_key.get_ref(e).as_slice()), path: path, key_lo: d.e_klo.as_slice()[e], key_hi: d.e_khi.as_slice()[e], path_lo: path_lo, path_hi: path_hi });
    }
}

// The manifest as discovery reads it: the keys of the tables that parsed.
pub fn read_back(d: &Doc) -> Manifest {
    let mut m = Manifest.{ name: Option.None, name_lo: NO_SPAN, name_hi: NO_SPAN, kind: Option.None, kind_lo: NO_SPAN, kind_hi: NO_SPAN, dep_target: vec.Vec::<string.String>.new(), deps: vec.Vec::<Dep>.new() };
    for e in 0..d.e_table.len() {
        if d.e_table.as_slice()[e] != 0 { continue; }
        let key = d.e_key.get_ref(e).as_slice();
        if text.eq_str(key, "name") {
            m.name = entry_string(d, e);
            let (lo, hi) = d.value_span(e);
            m.name_lo = lo;
            m.name_hi = hi;
        } else if text.eq_str(key, "kind") {
            m.kind = entry_string(d, e);
            if m.kind.is_some() {
                let (lo, hi) = d.value_span(e);
                m.kind_lo = lo;
                m.kind_hi = hi;
            }
        } else if text.eq_str(key, "dependencies") {
            match d.sub_table(e) {
                Option.Some(t) => { read_deps(d, t, mem.str_bytes(""), &mut m); }
                Option.None => {}
            }
        } else if text.eq_str(key, "target") {
            match d.sub_table(e) {
                Option.Some(t) => {
                    for te in 0..d.e_table.len() {
                        if d.e_table.as_slice()[te] != t { continue; }
                        let tkey = d.e_key.get_ref(te).as_slice();
                        if !known_target(tkey) { continue; }
                        match d.sub_table(te) {
                            Option.Some(tt) => {
                                for de in 0..d.e_table.len() {
                                    if d.e_table.as_slice()[de] == tt && text.eq_str(d.e_key.get_ref(de).as_slice(), "dependencies") {
                                        match d.sub_table(de) {
                                            Option.Some(dt) => { read_deps(d, dt, tkey, &mut m); }
                                            Option.None => {}
                                        }
                                    }
                                }
                            }
                            Option.None => {}
                        }
                    }
                }
                Option.None => {}
            }
        }
    }
    return m;
}

// The dependencies in effect for target `name` of arch table `alias` ("" for none): the base
// table, then the arch table, then the target's own table; a later entry replaces an earlier
// one of the same name in place.
pub fn effective_deps(m: &Manifest, name: &str, alias: &str) -> vec.Vec<Dep> {
    let mut out = vec.Vec::<Dep>.new();
    apply(m, mem.str_bytes(""), &mut out);
    if mem.str_bytes(alias).len() > 0 { apply(m, mem.str_bytes(alias), &mut out); }
    if !text.eq_str(mem.str_bytes(name), alias) { apply(m, mem.str_bytes(name), &mut out); }
    return out;
}

fn copy_dep(d: &Dep) -> Dep {
    let path = match &d.path {
        Option.Some(p) => Option.Some(string.String.from_str(p.as_str())),
        Option.None => Option.None,
    };
    return Dep.{ name: string.String.from_str(d.name.as_str()), path: path, key_lo: d.key_lo, key_hi: d.key_hi, path_lo: d.path_lo, path_hi: d.path_hi };
}

fn apply(m: &Manifest, target: &[u8], out: &mut vec.Vec<Dep>) {
    for k in 0..m.deps.len() {
        if !text.eq(m.dep_target.get_ref(k).as_bytes(), target) { continue; }
        let d = m.deps.get_ref(k);
        let mut hit = out.len();
        for j in 0..out.len() {
            if text.eq(out.get_ref(j).name.as_bytes(), d.name.as_bytes()) { hit = j; }
        }
        if hit < out.len() {
            *out.get_mut(hit) = copy_dep(d);
        } else {
            out.push(copy_dep(d));
        }
    }
}

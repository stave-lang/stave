// The body checker's state (types/check, see `typeck`): the node rows every module of the
// checker reads and writes, the literal groups of the body being checked, and the operations on
// them the other modules call.
//
// Node rows (per global node row): `nty` (the node's value: a type, `NONE` no value, `UNK` not
// decided, `ERR` the error type, `LIT | g` a pending literal group), `hint` (the context type its
// parent gave it), `acc` (a parent's running value), `loc` (a binding's type); per `Postfix` row
// `chain`, `pos`, `pend` (owned by `tc_chain`). Literal groups: union-find by index
// (`lg_parent`), the type each root is fixed to (`lg_fixed`: `NONE` pending, `UNK` unknown, `ERR`
// the error type), int or float.
//
// Entry points: `resolve`, `force`, `poison`, `fix`, `unite` (literal groups); `coerce` (a
// coercion site), `coerce_arg` (an argument's), `coercible`, `unify` (stage0's
// `unify_operands`); `set_hint`; `known` (a type from the signatures); `err` (a type error whose
// value is not modeled: `UNK`); `resolve_e`,
// `force_e`, `fix_err` (the error type, see `typeck`); `report`, `report_span`,
// `mismatch` (a type error stage0 reports: a row of `dg`); `cast_ok` (the cast table);
// `poison_kids`, `unknown` (a
// form not checked yet); `expr_kid`; `tok_text`, `is_lit`; the calls of the built-ins of
// `tc_builtins` (`bi_call`, `bi_hint`, `bi_targs`); the methods of impls with no struct or enum
// head (`headless_impls`, looked up by `tc_method.headless_method`).
import ast;
import consteval;
import decls;
import generated.terminals;
import items;
import lex;
import sigs;
import source;
import tc_builtins;
import tc_facts;
import tc_traits;
import tc_useful;
import ir.types;
import prims.sort;
import std.idx;
import std.vec;

pub const NONE: u32 = idx.NONE;
const ERR: u32 = types.ERR;
// A node, hint, or binding not decided by this stage.
pub const UNK: u32 = tc_builtins.UNK;
// `LIT | g`: the value of literal group g.
pub const LIT: u32 = 0x8000_0000;
// The `Self` of a call of a trait method named through its trait or a generic param (`Tr.m(..)`,
// `T.m(..)`): a binding of the call after the method's generics, and every argument is passed.
pub const SELF_VAR: u32 = 0xffff_fefe;
// The nesting a body may have: expression nodes, blocks, and patterns nested deeper than this
// are E0005 case `expr`, an error.
pub const MAX_DEPTH: u32 = 20000;

pub struct Typeck {
    // per node row: its type, `NONE` (no value), `UNK`, or `LIT | g` while its body is checked
    pub nty: vec.Vec<u32>,
    // per node row: the context type its parent gave it (`NONE`: none, `UNK`: not known)
    pub hint: vec.Vec<u32>,
    // per node row: a parent's running value (an operator chain's left operand, a `let` type)
    pub acc: vec.Vec<u32>,
    // per binding node row (`Param`, `SelfParam`, `Pattern`): its type (`UNK` until bound)
    pub loc: vec.Vec<u32>,
    // literal groups of the body being checked: parent, fixed type (`NONE` pending, `UNK`
    // unknown), float or int
    pub lg_parent: vec.Vec<u32>,
    pub lg_fixed: vec.Vec<u32>,
    pub lg_float: vec.Vec<bool>,
    // the return types of the enclosing fn, spawn bodies, and closures
    pub rets: vec.Vec<u32>,
    // per entry of `rets`: the node row of the return type written (`NONE`: none)
    pub ret_why: vec.Vec<u32>,
    // per `Postfix` row: the chain's state (`S_*`, its value or decl in `acc`), the next token of
    // the chain, the step waiting for the child being checked (`P_*`); per `Args` row: the callee
    // in `acc` (NONE: not checked yet), the type whose generic arguments instantiate it in `pos`
    pub chain: vec.Vec<u8>,
    pub pos: vec.Vec<u32>,
    pub pend: vec.Vec<u8>,
    // the walk: node rows and the next child of each; the nesting levels on it (`depth`, counted
    // as `MAX_DEPTH` counts them)
    pub st_row: vec.Vec<u32>,
    pub st_kid: vec.Vec<u32>,
    pub depth: u32,
    // the body being checked: item, its first node row, module, scope, `self` binding row, error
    // found
    pub it: u32,
    pub base: usize,
    pub module: u32,
    pub sc: consteval.Scope,
    pub self_row: u32,
    pub lw: sigs.Lw,
    // `std.soa.Soa` (NONE without one), its module
    pub soa: u32,
    pub soa_mod: u32,
    // the name `old` (NONE: not in the program); the contract clause being checked (`CL_*`), the
    // `old(..)` calls open in it
    pub old_s: u32,
    // the name `fmt` (NONE: not in the program)
    pub fmt_s: u32,
    pub clause: u8,
    pub old_depth: u32,
    pub args: vec.Vec<u32>,
    // the names of the methods of impls with no struct or enum head, sorted
    pub headless: vec.Vec<u32>,
    // the same methods: their names, sorted, and their decls (`headless_impls`)
    pub hl_name: vec.Vec<u32>,
    pub hl_m: vec.Vec<u32>,
    // the pattern walk of `tc_pat`: pattern rows, the type each matches, the binding mode
    pub pat_row: vec.Vec<u32>,
    pub pat_ty: vec.Vec<u32>,
    pub pat_mode: vec.Vec<u8>,
    // per value `match` row: the type of its arms so far (NONE before the first)
    pub arm: vec.Vec<u32>,
    // the pattern walk's rows to lower into (`NONE`: discarded) and nesting levels; whether the
    // pattern being lowered holds a rejected one, an undecided one (`tc_pat`)
    pub pat_slot: vec.Vec<u32>,
    pub pat_lvl: vec.Vec<u32>,
    pub pat_err: bool,
    pub pat_unk: bool,
    // the lowered patterns of the open `let`, `for`, and `match` constructs, and the usefulness
    // search (`tc_useful`)
    pub pats: tc_useful.Pats,
    pub srch: tc_useful.Search,
    // the bindings the pattern being lowered typed (node, type, mode), and the first
    // alternative's of an or-pattern
    pub ob_node: vec.Vec<u32>,
    pub ob_ty: vec.Vec<u32>,
    pub ob_mode: vec.Vec<u8>,
    pub of_node: vec.Vec<u32>,
    pub of_ty: vec.Vec<u32>,
    pub of_mode: vec.Vec<u8>,
    // the alternatives of the arms of the open matches: lowered pattern (`NONE`: undecided),
    // pattern node row, arm row, flags; per open match its first alternative and the pattern
    // pool's length before it
    pub mr_pat: vec.Vec<u32>,
    pub mr_node: vec.Vec<u32>,
    pub mr_arm: vec.Vec<u32>,
    pub mr_fl: vec.Vec<u8>,
    pub ms_row: vec.Vec<u32>,
    pub ms_pool: vec.Vec<u32>,
    // per field of the record pattern being checked: the token naming it first (`NONE`: not
    // named), whether that is a shorthand binding
    pub fs_tok: vec.Vec<u32>,
    pub fs_bind: vec.Vec<bool>,
    // the fields E0208 `pattern-missing-field` rows name: a count, then the field decls
    pub miss: vec.Vec<u32>,
    // generic calls (`tc_chain`): the bindings of every call of the body, per `Args` row the start
    // of its call's (NONE: no generics), per argument or `Args` row whether it waits (an
    // argument for the second pass; a call: its inference met an unknown type); the scratch
    // stacks of type matching
    pub binds: vec.Vec<u32>,
    pub blo: vec.Vec<u32>,
    // the arguments of the const bindings of the body (`CB`), three words each, each once
    pub cargs: vec.Vec<u32>,
    pub waits: vec.Vec<bool>,
    pub mt_p: vec.Vec<u32>,
    pub mt_x: vec.Vec<u32>,
    pub mt_new: vec.Vec<u32>,
    pub mt_h: vec.Vec<u32>,
    pub mt_k: vec.Vec<u32>,
    // the built-in methods and type-relative built-ins
    pub bt: tc_builtins.Builtins,
    // the divisors of the body's `div_const` calls (argument row, its lane type), evaluated when
    // the body's check ends
    pub dc_row: vec.Vec<u32>,
    pub dc_ty: vec.Vec<u32>,
    // the trait questions, asked in rounds (`tc_traits`)
    pub tq: tc_traits.Tq,
    // `std.core.Option`, `std.core.Result` (NONE: none in this program)
    pub opt: u32,
    pub res: u32,
    pub t_bool: u32,
    pub t_char: u32,
    pub t_unit: u32,
    pub t_never: u32,
    pub t_ref_str: u32,
    // `std.string.String` (NONE: none in this program)
    pub string: u32,
    // the features every value made in the body may assume: its fn's and the target's baseline
    // (`base_feats`)
    pub proven: u64,
    pub base_feats: u64,
    // per node row: it made a fn item a value (`tc_closure`)
    pub fn_item: vec.Vec<bool>,
    // the coercions `coerce` leaves to `tc_closure.node_coercions` (they depend on the node's
    // form): node, wanted type
    pub fc_node: vec.Vec<u32>,
    pub fc_want: vec.Vec<u32>,
    pub fc_why: vec.Vec<u32>,
    // the type errors found (`report`), one row each: code, case (`C_*` of the code), the decl
    // whose body found it and the check of that body (`pass`: a body checked again in a later
    // round keeps only its last check's rows), the primary span (first and last global token),
    // two types by code (`LIT_INT`, `LIT_FLOAT`: a literal group of that kind), the operand's
    // node row, what requires the expected type (`why`: a node row, `WHY_DECL | d` the name of
    // decl d, `NONE`), a third value by code (`x`: E0201 `fn-arms` the common fn type), and the
    // scope naming generic params (4 words: par_lo, par_hi, own_lo,
    // own_hi)
    pub dg: Rows,
    // the body being checked: its decl and its check's number; per decl its last check's number
    pub cur_d: u32,
    pub pass: u32,
    pub last_pass: vec.Vec<u32>,
    // the facts kept for the passes after the checker (`tc_facts`)
    pub fx: tc_facts.Facts,
    // the auto-deref level of the method the last `recv_method` found; the field the last
    // `field_sym` found (NONE: none) and whether it is a column
    pub lv: u32,
    pub fdecl: u32,
    pub fcol: bool,
    // the coercion sites of a fn type, their coercions decided when the body's check ends
    // (`tc_closure.fn_coercions`): node, wanted type
    pub fq_node: vec.Vec<u32>,
    pub fq_want: vec.Vec<u32>,
}

pub const LIT_INT: u32 = 0xffff_fff0;
// A method lookup's callee when stage0's lookup finds no method or two (its E0208, E0901, or
// E0908, not reported here): the call is of the error type.
pub const NOT_FOUND: u32 = 0xffff_fefa;
pub const LIT_FLOAT: u32 = 0xffff_fff1;
pub const WHY_DECL: u32 = 0x8000_0000;

// E0201 cases: the fix the diagnostic names (stage0's `mismatch_fix`).
pub const C_CAST: u8 = 0;
pub const C_AS_PERCENT: u8 = 1;
pub const C_AS_PIPE: u8 = 2;
pub const C_AS_TILDE: u8 = 3;
pub const C_SOME: u8 = 4;
pub const C_OK: u8 = 5;
pub const C_UNWRAP_OPTION: u8 = 6;
pub const C_UNWRAP_RESULT: u8 = 7;
pub const C_BORROW: u8 = 8;
pub const C_BORROW_MUT: u8 = 9;
pub const C_DEREF: u8 = 10;
pub const C_NO_CAST: u8 = 11;
// E0201 case `not-in-loop`: a `break` or `continue` outside of a loop (no types).
pub const C_NOT_IN_LOOP: u8 = 12;
// E0201 cases `fn-arms` (a, b the arms' fn types, x their common type) and `fn-arms-wanted` (a
// the wanted fn type, b the arm's).
pub const C_FN_ARMS: u8 = 13;
pub const C_FN_ARMS_WANTED: u8 = 14;
// E0206 cases: `ref-operand` (an operator on a reference), `pattern`, `pattern-str` (a pattern
// that tests `==` on a type without it, a string's).
pub const C_REF_OPERAND: u8 = 1;
pub const C_PATTERN: u8 = 2;
pub const C_PATTERN_STR: u8 = 3;
// E0206 base case for indexing (`[]`) a value that is no array or slice.
pub const C_INDEX: u8 = 4;
// E0206 cases `deref`, `deref-read`, `deref-write`, `deref-accessors`: unary `*` on operand row n
// of type a that is no reference or pointer; b the type's read accessor, x its write accessor
// (NONE: none).
pub const C_DEREF_OP: u8 = 5;
// E0202 cases: an int literal (0), a float literal, a generic value whose arguments no context
// gives (`infer`).
pub const C_FLOAT: u8 = 1;
pub const C_INFER: u8 = 2;
// E0203 case `malformed` (an int literal no int reads); case `float` (a float literal its float
// type a holds no finite value of).
pub const C_MALFORMED: u8 = 1;
pub const C_FLOAT_RANGE: u8 = 2;
// E0201 case `arity`: a = the arguments taken, b = given, x = the call's first token.
pub const C_ARITY: u8 = 15;
// E0201 case `type-args`: a = the generic arguments taken, b = given; the span is the list.
pub const C_TYPE_ARGS: u8 = 16;
// E0201 case `not-value`: the chain at node row n names no value.
pub const C_NOT_VALUE: u8 = 17;
// E0422 cases (an operator on an operand type a that is not Copy where it is used; b the
// operator trait's position in `traits.OPS`): `operand` (a generic param, x its row of `Gens`),
// `operand-args` (a type that names params), `operand-type` (any other); of the last two, x is
// the impl the operator goes through (NONE: none).
pub const C_OPERAND: u8 = 1;
pub const C_OPERAND_ARGS: u8 = 2;
pub const C_OPERAND_TYPE: u8 = 3;
// E0201 case `arity` of a pattern: a = the fields taken, b = given; the operand is the pattern.
pub const C_ARITY_PAT: u8 = 18;
// E0300 cases (a = the type): `let` (a `let` or `for` pattern), `limit`, `limit-split`; E0301
// case `alternative` (why: the covering pattern row, NONE none); E0302: a = the name's token, why
// = the first alternative. E0105 case `pattern-field` (C_PATTERN): b = the struct or variant, x =
// the first naming token; E0106 case `pattern`: a = the struct, b = its first private field;
// E0208 case `pattern-missing-field` (C_PATTERN): a = the type, x = the list in `miss`; E0208
// (case 0) at a pattern's field name: a = the type.
pub const C_LET: u8 = 1;
pub const C_LIMIT: u8 = 2;
pub const C_LIMIT_SPLIT: u8 = 3;
pub const C_ALTERNATIVE: u8 = 1;
// An E0201 whose fix is decided at the body's end (`tc_diag.fixes`).
pub const C_PENDING: u8 = 255;

pub struct Rows {
    pub code: vec.Vec<u16>,
    pub case: vec.Vec<u8>,
    pub d: vec.Vec<u32>,
    pub pass: vec.Vec<u32>,
    pub lo: vec.Vec<u32>,
    pub hi: vec.Vec<u32>,
    pub a: vec.Vec<u32>,
    pub b: vec.Vec<u32>,
    pub n: vec.Vec<u32>,
    pub why: vec.Vec<u32>,
    pub x: vec.Vec<u32>,
    pub sc: vec.Vec<u32>,
}

pub fn rows() -> Rows {
    return Rows.{ code: vec.Vec::<u16>.new(), case: vec.Vec::<u8>.new(), d: vec.Vec::<u32>.new(), pass: vec.Vec::<u32>.new(), lo: vec.Vec::<u32>.new(), hi: vec.Vec::<u32>.new(), a: vec.Vec::<u32>.new(), b: vec.Vec::<u32>.new(), n: vec.Vec::<u32>.new(), why: vec.Vec::<u32>.new(), x: vec.Vec::<u32>.new(), sc: vec.Vec::<u32>.new() };
}

impl Rows {
    pub fn len(&self) -> usize {
        return self.code.len();
    }
}

// The contract clause being checked: none, a `requires`, an `ensures`.
pub const CL_NONE: u8 = 0;
pub const CL_REQUIRES: u8 = 1;
pub const CL_ENSURES: u8 = 2;

// A binding of a const generic param in `binds`: `CB | k`, its argument the three words from
// `cargs[3 * k]` (a value, a const param of the body, or a value unknown after an error). A type
// id never has bit 30 set, every other mark has bit 31: the two never meet.
pub const CB: u32 = 0x4000_0000;

// Whether binding v is a const binding.
pub fn is_cb(v: u32) -> bool {
    return v & 0xc000_0000 == CB;
}

// Whether value v is a literal group's.
pub fn is_lit(v: u32) -> bool {
    return v != NONE && v != ERR && v != UNK && v & LIT != 0;
}

impl Typeck {
    // The const binding of argument (k, x, y), one per distinct argument of the body, so two
    // bindings are equal exactly when their arguments are.
    pub fn cbind(&mut self, k: u32, x: u32, y: u32) -> u32 {
        let n = self.cargs.len() / 3;
        for i in 0..n {
            let c = &self.cargs.as_slice()[3 * i..3 * i + 3];
            if c[0] == k && c[1] == x && c[2] == y { return CB | i as% u32; }
        }
        self.cargs.push(k);
        self.cargs.push(x);
        self.cargs.push(y);
        return CB | n as% u32;
    }

    // Binding v (a type or a const binding) as a generic argument's three words, pushed to `args`.
    pub fn push_bind(&mut self, v: u32) {
        if is_cb(v) {
            let i = 3 * (v & ~CB) as usize;
            for j in 0..3usize {
                let w = self.cargs.as_slice()[i + j];
                self.args.push(w);
            }
        } else {
            self.args.push(types.GA_TYPE);
            self.args.push(v);
            self.args.push(0);
        }
    }

    // Generic argument (k, x, y) of a type key as a binding: a type, or a const binding.
    pub fn bind_of(&mut self, k: u32, x: u32, y: u32) -> u32 {
        return if k == types.GA_TYPE then x else self.cbind(k, x, y);
    }

    pub fn new_lit(&mut self, float: bool) -> u32 {
        let g = self.lg_parent.len() as% u32;
        self.lg_parent.push(g);
        self.lg_fixed.push(NONE);
        self.lg_float.push(float);
        return LIT | g;
    }

    fn find(&mut self, g: u32) -> u32 {
        let mut r = g;
        loop {
            let p = self.lg_parent.as_slice()[r as usize];
            if p == r { break; }
            r = p;
        }
        let mut x = g;
        loop {
            let p = self.lg_parent.as_slice()[x as usize];
            if p == x { break; }
            self.lg_parent.as_mut_slice()[x as usize] = r;
            x = p;
        }
        return r;
    }

    // A value with its group's fixed type: a type, `UNK`, or `LIT | root` (pending). The error
    // type is `UNK` here: a form that has no rule of its own for an operand of the error type
    // takes it as unknown.
    pub fn resolve(&mut self, v: u32) -> u32 {
        let x = self.resolve_e(v);
        return if x == ERR then UNK else x;
    }

    // `resolve` that keeps the error type (`ERR`: a node or a group stage0 gives the error type),
    // for the forms with stage0's rule for it.
    pub fn resolve_e(&mut self, v: u32) -> u32 {
        if !is_lit(v) { return v; }
        let r = self.find(v & (LIT - 1));
        let f = self.lg_fixed.as_slice()[r as usize];
        return if f == NONE then LIT | r else f;
    }

    // Fixes a pending group of value v to the error type (stage0 `fix(g, ERROR)`).
    pub fn fix_err(&mut self, v: u32) {
        if !is_lit(v) { return; }
        let r = self.find(v & (LIT - 1));
        if self.lg_fixed.as_slice()[r as usize] == NONE { self.lg_fixed.as_mut_slice()[r as usize] = ERR; }
    }

    // Makes a pending group of value v unknown.
    pub fn poison(&mut self, v: u32) {
        if !is_lit(v) { return; }
        let r = self.find(v & (LIT - 1));
        if self.lg_fixed.as_slice()[r as usize] == NONE { self.lg_fixed.as_mut_slice()[r as usize] = UNK; }
    }

    // Fixes pending group value v to type ty: false (an error) if ty is not of the literal's kind.
    pub fn fix(&mut self, tab: &types.Table, v: u32, ty: u32) -> bool {
        let r = self.find(v & (LIT - 1));
        let f = self.lg_fixed.as_slice()[r as usize];
        if f != NONE { return f == ty || f == UNK || f == ERR; }
        let tag = tab.tag_of(ty);
        let ok = if self.lg_float.as_slice()[r as usize] then tag == types.TK_FLOAT else tag == types.TK_INT;
        if !ok {
            // as stage0: a group fixed to a type of another kind is the error type from then on
            self.lg_fixed.as_mut_slice()[r as usize] = ERR;
            return false;
        }
        self.lg_fixed.as_mut_slice()[r as usize] = ty;
        return true;
    }

    // Unites two pending groups: false (an error) for an int and a float group.
    pub fn unite(&mut self, a: u32, b: u32) -> bool {
        let ra = self.find(a & (LIT - 1));
        let rb = self.find(b & (LIT - 1));
        if ra == rb { return true; }
        if self.lg_float.as_slice()[ra as usize] != self.lg_float.as_slice()[rb as usize] { return false; }
        let lo = if ra < rb then ra else rb;
        let hi = if ra < rb then rb else ra;
        self.lg_parent.as_mut_slice()[hi as usize] = lo;
        return true;
    }

    // A value that must be a type here (stage0 `force`): a pending group is an error (E0202).
    pub fn force(&mut self, v: u32) -> u32 {
        let x = self.force_e(v);
        return if x == ERR then UNK else x;
    }

    // `force` that keeps the error type (a pending group is of it after its E0202).
    pub fn force_e(&mut self, v: u32) -> u32 {
        let r = self.resolve_e(v);
        if is_lit(r) {
            self.e0202(r);
            return ERR;
        }
        return r;
    }

    // E0202 for pending group v, once (the group is then of the error type); its literal is found
    // when the body's walk is done (`tc_diag.lit_sites`).
    pub fn e0202(&mut self, v: u32) {
        let r = self.find(v & (LIT - 1));
        if self.lg_fixed.as_slice()[r as usize] != NONE { return; }
        self.lg_fixed.as_mut_slice()[r as usize] = ERR;
        let float = self.lg_float.as_slice()[r as usize];
        self.report(202, if float then C_FLOAT else 0u8, NONE, r, NONE, NONE);
    }

    pub fn resolve_at(&mut self, r: usize) -> u32 {
        let v = self.nty.as_slice()[r];
        return self.resolve(v);
    }

    pub fn force_at(&mut self, r: usize) -> u32 {
        let v = self.nty.as_slice()[r];
        return self.force(v);
    }

    pub fn resolve_e_at(&mut self, r: usize) -> u32 {
        let v = self.nty.as_slice()[r];
        return self.resolve_e(v);
    }

    pub fn force_e_at(&mut self, r: usize) -> u32 {
        let v = self.nty.as_slice()[r];
        return self.force_e(v);
    }

    pub fn poison_at(&mut self, r: usize) {
        let v = self.nty.as_slice()[r];
        self.poison(v);
    }

    pub fn resolve_acc(&mut self, r: usize) -> u32 {
        let v = self.acc.as_slice()[r];
        return self.resolve(v);
    }

    pub fn set_hint_bool(&mut self, c: usize) {
        let b = self.t_bool;
        self.set_hint(c, b);
    }

    pub fn set_hint_acc(&mut self, c: usize, r: usize) {
        let v = self.acc.as_slice()[r];
        self.set_hint(c, v);
    }

    pub fn coerce_bool(&mut self, tab: &types.Table, e: usize) {
        let b = self.t_bool;
        self.coerce(tab, e, b, NONE);
    }

    pub fn coerce_acc(&mut self, tab: &types.Table, e: usize, r: usize, why: u32) {
        let v = self.acc.as_slice()[r];
        self.coerce(tab, e, v, why);
    }

    // A type error (`code`, its case) at node row n's span, with types a and b and `why` by code.
    pub fn report(&mut self, code: u16, case: u8, n: u32, a: u32, b: u32, why: u32) {
        self.report_span(code, case, NONE, NONE, n, a, b, why);
    }

    // A type error whose primary span is global tokens lo..=hi (`NONE`: node row n's span).
    pub fn report_span(&mut self, code: u16, case: u8, lo: u32, hi: u32, n: u32, a: u32, b: u32, why: u32) {
        let g = &mut self.dg;
        g.code.push(code);
        g.case.push(case);
        g.d.push(self.cur_d);
        g.pass.push(self.pass);
        g.lo.push(lo);
        g.hi.push(hi);
        g.a.push(a);
        g.b.push(b);
        g.n.push(n);
        g.why.push(why);
        g.x.push(NONE);
        g.sc.push(self.sc.par_lo);
        g.sc.push(self.sc.par_hi);
        g.sc.push(self.sc.own_lo);
        g.sc.push(self.sc.own_hi);
    }

    // The root of literal group value v.
    pub fn lit_root(&mut self, v: u32) -> u32 {
        return self.find(v & (LIT - 1));
    }

    // `LIT_INT` or `LIT_FLOAT`: the kind of pending group v.
    pub fn lit_kind(&mut self, v: u32) -> u32 {
        let r = self.find(v & (LIT - 1));
        return if self.lg_float.as_slice()[r as usize] then LIT_FLOAT else LIT_INT;
    }

    // E0201 at node row e: value v (a type or a literal group) where want is required; its fix
    // is decided at the body's end.
    pub fn mismatch(&mut self, e: usize, v: u32, want: u32, why: u32) {
        let found = if is_lit(v) then self.lit_kind(v) else v;
        self.report(201, C_PENDING, e as% u32, want, found, why);
    }

    // A type read from the signatures: the error type is not modeled after an error.
    pub fn known(&mut self, ty: u32) -> u32 {
        if ty == ERR || ty == NONE {
            return UNK;
        }
        return ty;
    }

    pub fn set_hint(&mut self, c: usize, h: u32) {
        self.hint.as_mut_slice()[c] = h;
    }

    pub fn expr_kid(&self, tree: &ast.Ast, r: usize) -> u32 {
        let ks = tree.kids.row(r);
        for j in 0..ks.len() {
            let c = self.base + ks[j] as usize;
            if is_expr(kind(tree, c)) { return c as% u32; }
        }
        return NONE;
    }

    // Makes the literal groups of row r's children unknown: r is a form not checked yet.
    pub fn poison_kids(&mut self, tree: &ast.Ast, r: usize) {
        let ks = tree.kids.row(r);
        for j in 0..ks.len() {
            let c = self.base + ks[j] as usize;
            let v = self.nty.as_slice()[c];
            self.poison(v);
        }
    }

    // An unknown node: its children's pending groups become unknown.
    pub fn unknown(&mut self, tree: &ast.Ast, r: usize) -> u32 {
        self.poison_kids(tree, r);
        return UNK;
    }

    // Checks node e's value against type want at a coercion site (annotation, parameter, return,
    // assignment): a pending group takes want.
    pub fn coerce(&mut self, tab: &types.Table, e: usize, want: u32, why: u32) {
        let v = self.resolve_at(e);
        if want == UNK {
            self.poison(v);
            return;
        }
        // the error type wanted: a pending group takes it, any value is no mismatch
        if want == ERR {
            self.fix_err(v);
            return;
        }
        if want != NONE { self.fx.cw.as_mut_slice()[e] = want; }
        if v == UNK { return; }
        if is_lit(v) {
            if !self.fix(tab, v, want) { self.mismatch(e, v, want, why); }
            return;
        }
        let fns = tab.tag_of(v) == types.TK_FN && tab.tag_of(want) == types.TK_FN;
        if fns {
            self.fq_node.push(e as% u32);
            self.fq_want.push(want);
        }
        if v == want { return; }
        if v == self.t_never {
            self.fx.set_co(e, tc_facts.C_NEVER);
            return;
        }
        if self.coercible(tab, v, want) {
            if !fns { self.fx.set_co(e, tc_facts.coercion(tab, v, want, self.string)); }
            return;
        }
        let fstr = want == self.t_ref_str && self.string != NONE && tab.tag_of(v) == types.TK_ADT && tab.a_of(v) == self.string;
        if fns || fstr {
            // fn types: decided from the node's arms and how its value was made; `String` to
            // `&str`: an f-string's
            self.fc_node.push(e as% u32);
            self.fc_want.push(want);
            self.fc_why.push(why);
            return;
        }
        // a node without a value (a module, type, or fn path) is no mismatch
        if v == NONE { return; }
        self.mismatch(e, v, want, why);
    }

    // `coerce` of argument node a against its parameter type want: a `&mut` one is reborrowed
    // (stage0's `note_reborrow`).
    pub fn coerce_arg(&mut self, tab: &types.Table, a: usize, want: u32, why: u32) {
        self.coerce(tab, a, want, why);
        if is_mut_ref(tab, want) { self.fx.reborrow(a); }
    }

    // stage0's implicit coercions: `&mut T` to `&T`, `&[T; N]` and `&[T align A]` to `&[T]`
    // (shared or mut), `&String` to `&str`, a fn type to one with the same params and return
    // that needs no feature beyond its own and `proven` and denies no more effects.
    pub fn coercible(&self, tab: &types.Table, v: u32, want: u32) -> bool {
        if v == NONE || v == ERR { return false; }
        if tab.tag_of(v) == types.TK_FN && tab.tag_of(want) == types.TK_FN {
            let (shape, widened) = fn_conv(tab, v, want, self.proven);
            return shape && widened == 0;
        }
        if tab.tag_of(v) != types.TK_REF || tab.tag_of(want) != types.TK_REF { return false; }
        return self.ref_coercible(tab, tab.a_of(v) == 1, tab.b_of(v), want);
    }

    // `coercible` of the reference `&vi` (`&mut vi` if vm) to reference type want.
    pub fn ref_coercible(&self, tab: &types.Table, vm: bool, vi: u32, want: u32) -> bool {
        let wm = tab.a_of(want) == 1;
        if wm && !vm { return false; }
        let wi = tab.b_of(want);
        if !wm && vm && vi == wi { return true; }
        if !wm && tab.tag_of(wi) == types.TK_STR && self.string != NONE && tab.tag_of(vi) == types.TK_ADT && tab.a_of(vi) == self.string { return true; }
        if tab.tag_of(wi) != types.TK_SLICE || tab.b_of(wi) != 0 { return false; }
        let vt = tab.tag_of(vi);
        if vt == types.TK_ARRAY { return tab.a_of(vi) == tab.a_of(wi); }
        return vt == types.TK_SLICE && tab.b_of(vi) != 0 && tab.a_of(vi) == tab.a_of(wi);
    }

    // stage0's `unify_operands` on values resolved by `resolve_e`; a mismatch is E0201 at node
    // row rn (the right operand, the later arm or element). `ERR` where stage0's value is the
    // error type: an operand of it (a pending group of the other operand takes it), a mismatch,
    // vectors with E0602 / E0603, a literal against a vector.
    pub fn unify(&mut self, tab: &types.Table, lt: u32, rt: u32, rn: u32) -> u32 {
        if lt == ERR || rt == ERR {
            self.fix_err(lt);
            self.fix_err(rt);
            return ERR;
        }
        if lt == UNK || rt == UNK {
            self.poison(lt);
            self.poison(rt);
            return UNK;
        }
        let ll = is_lit(lt);
        let rl = is_lit(rt);
        if !ll && !rl {
            if lt == rt || rt == self.t_never { return lt; }
            if lt == self.t_never { return rt; }
            if lt == NONE || rt == NONE { return UNK; }
            if tab.tag_of(lt) == types.TK_VECTOR || tab.tag_of(rt) == types.TK_VECTOR { return ERR; }
            self.mismatch(rn as usize, rt, lt, NONE);
            return ERR;
        }
        if lt == NONE || rt == NONE { return UNK; }
        if ll && rl {
            if self.unite(lt, rt) { return self.resolve(lt); }
            let a = self.lit_kind(lt);
            let b = self.lit_kind(rt);
            self.fix_err(lt);
            self.fix_err(rt);
            self.report(201, C_NO_CAST, rn, a, b, NONE);
            return ERR;
        }
        let g = if ll then lt else rt;
        let ty = if ll then rt else lt;
        if ty == self.t_never { return g; }
        if tab.tag_of(ty) == types.TK_VECTOR {
            // E0602: the literal is the error type
            self.fix_err(g);
            return ERR;
        }
        if !self.fix(tab, g, ty) {
            // a pending left operand against a typed right one: the expected type is the error
            // type, no diagnostic
            if !ll { self.mismatch(rn as usize, rt, lt, NONE); }
            return ERR;
        }
        return ty;
    }

    pub fn err(&mut self) -> u32 {
        return UNK;
    }
}

// Whether v is a `&mut` reference type.
fn is_mut_ref(tab: &types.Table, v: u32) -> bool {
    return v != NONE && v != UNK && v != ERR && !is_lit(v) && tab.tag_of(v) == types.TK_REF && tab.a_of(v) == 1;
}

// Whether fn types v and want have the same params and return.
pub fn fn_same(tab: &types.Table, v: u32, want: u32) -> bool {
    let n = tab.a_of(v) as usize;
    return tab.a_of(want) as usize == n && tab.x(v)[0..n + 1].eq(&tab.x(want)[0..n + 1]);
}

// Fn type v against fn type want: (same params and return, and v needs no feature beyond want's
// and proven; the effects want denies beyond v's).
pub fn fn_conv(tab: &types.Table, v: u32, want: u32, proven: u64) -> (bool, u32) {
    if !fn_same(tab, v, want) { return (false, 0); }
    let n = tab.a_of(v) as usize;
    let vx = tab.x(v);
    let wx = tab.x(want);
    let vf = (vx[n + 1] as u64) << 32 | vx[n + 2] as u64;
    let wf = (wx[n + 1] as u64) << 32 | wx[n + 2] as u64;
    return (vf & ~(wf | proven) == 0, wx[n + 3] & ~vx[n + 3]);
}

impl Typeck {
    // A call of built-in callee on c (the receiver, or the type of a type-relative call) with the
    // arguments of `Args` row args (NONE: none), each checked by its kind; its value.
    pub fn bi_call(&mut self, tab: &mut types.Table, tree: &ast.Ast, callee: u32, c: u32, args: u32) -> u32 {
        let np = self.bt.params(callee, c);
        if np == UNK {
            if args != NONE { self.poison_kids(tree, args as usize); }
            return UNK;
        }
        let nb = if args == NONE then 0usize else tree.kids.row(args as usize).len();
        if nb != np as usize { return self.err(); }
        let mut x = NONE;
        let mut y = NONE;
        for j in 0..nb {
            let a = self.base + tree.kids.row(args as usize)[j] as usize;
            let kd = self.bt.arg_kind(tab, callee, c, j);
            if kd == tc_builtins.A_SEL || kd == tc_builtins.A_FREE {
                let v = if kd == tc_builtins.A_SEL then self.resolve_at(a) else self.force_at(a);
                if j == 0 { x = v; } else { y = v; }
                continue;
            }
            let want = self.bt.param(tab, callee, c, j);
            if kd == tc_builtins.A_ALIGNED {
                // E0606 or a mismatch (later stages'): the call's value is its return type; a
                // `&mut` one is reborrowed
                let v = self.force_at(a);
                if is_mut_ref(tab, v) { self.fx.reborrow(a); }
                continue;
            }
            if kd == tc_builtins.A_INDEX {
                let v = self.force_at(a);
                if v == UNK || index_ok(tab, v, want) { continue; }
            }
            // a mask of another shape where a mask is wanted: E0605
            let v = self.resolve_at(a);
            if tab.tag_of(want) == types.TK_MASK && v != want && v != UNK && v != NONE && !is_lit(v) && tab.tag_of(v) == types.TK_MASK {
                continue;
            }
            self.coerce_arg(tab, a, want, NONE);
            if tc_builtins.is_div_const(callee) {
                self.dc_row.push(a as% u32);
                self.dc_ty.push(want);
            }
        }
        if nb == 2 && self.bt.arg_kind(tab, callee, c, 0) == tc_builtins.A_SEL { return self.unify(tab, x, y, self.base as% u32 + tree.kids.row(args as usize)[1]); }
        if nb == 2 && self.bt.arg_kind(tab, callee, c, 0) == tc_builtins.A_FREE {
            if x == UNK || y == UNK { return UNK; }
            let r = self.bt.select_ret(tab, c, x, y);
            return if r == NONE then self.err() else r;
        }
        return self.bt.ret(tab, callee, c);
    }

    // The context of argument j of the call of a built-in at `Args` row r (its callee in `acc`,
    // the type it is called on in `pos`, the call's context in `hint`).
    pub fn bi_hint(&mut self, tab: &mut types.Table, tree: &ast.Ast, r: usize, j: usize) -> u32 {
        let callee = self.acc.as_slice()[r];
        let c = self.pos.as_slice()[r];
        let kd = self.bt.arg_kind(tab, callee, c, j);
        if kd == tc_builtins.A_FREE || kd == tc_builtins.A_ALIGNED { return NONE; }
        if kd == tc_builtins.A_SEL {
            // the first operand takes the call's context, the second the first's type
            let h = self.hint.as_slice()[r];
            if j == 0 { return h; }
            let v = self.resolve_at(self.base + tree.kids.row(r)[0] as usize);
            if v == UNK { return UNK; }
            if v == NONE || v == self.t_never || is_lit(v) { return h; }
            return v;
        }
        return self.bt.param(tab, callee, c, j);
    }

    // A built-in method m on c called with generic arguments (`GenericArgs` row ga) and the `()`
    // right after them: its value; NONE when m is no built-in or the call is not that form (then
    // an error if m is one).
    pub fn bi_targs(&mut self, tab: &mut types.Table, t: &lex.Tokens, set: &source.SourceSet, cut: &items.Items, tree: &ast.Ast, m: u32, c: u32, ga: u32, seg: u32, xs: &[u32]) -> u32 {
        if !tc_builtins.is_builtin(m) { return NONE; }
        let lo = tree.tok.as_slice()[ga as usize];
        let hi = tree.tok_end.as_slice()[ga as usize] - 1;
        if !self.bt.takes_targs(m) {
            // E0201 case `type-args` at the turbofish, the operand the built-in's name
            self.report_span(201, C_TYPE_ARGS, lo, hi, NONE, 0, tree.kids.row(ga as usize).len() as% u32, NONE);
            let k = self.dg.x.len() - 1;
            self.dg.x.as_mut_slice()[k] = seg;
            return NONE;
        }
        let q = hi + 1;
        if consteval.tk(t, q) != terminals.T_L_PAREN || consteval.tk(t, q + 1) != terminals.T_R_PAREN {
            return NONE;
        }
        if self.bt.shaped_targs(m) {
            let v = self.bt.targs_ret(tab, m, c, xs);
            return v;
        }
        // `permute::<[i0, ..]>`: one index per lane, each a plain int literal below the lanes
        let n = tab.b_of(c);
        if n == types.LANES_N { return self.bt.ret(tab, m, c); }
        let ks = tree.kids.row(ga as usize);
        if ks.len() != 1 { return self.err(); }
        let a = tree.tok.as_slice()[self.base + ks[0] as usize];
        if consteval.tk(t, a) != terminals.T_L_BRACKET { return self.err(); }
        let close = cut.mate.as_slice()[a as usize];
        if close == NONE { return self.err(); }
        let mut count: u32 = 0;
        for tok in a + 1..close {
            let k = consteval.tk(t, tok);
            if k == terminals.T_COMMA { continue; }
            if k != terminals.T_INT_LIT { return self.err(); }
            let (v, big, suf) = consteval.parse_int(tok_text(t, set, cut, self.it, tok, false));
            if big || suf != 0 || v >= n as u64 { return self.err(); }
            count = count + 1;
        }
        if count != n { return self.err(); }
        return self.bt.ret(tab, m, c);
    }
}

// The methods of impls with no struct or enum head: their names, sorted (methods of one name in
// declaration order), and the method decl of each.
pub fn headless_impls(ds: &decls.Decls) -> (vec.Vec<u32>, vec.Vec<u32>) {
    let mut xs = vec.Vec::<u32>.new();
    let mut ps = vec.Vec::<u32>.new();
    for m in 0..ds.decls() {
        if ds.kind.as_slice()[m] != decls.DK_METHOD { continue; }
        let p = ds.parent.as_slice()[m];
        if p == NONE || ds.kind.as_slice()[p as usize] != decls.DK_IMPL || ds.impl_head.as_slice()[p as usize] != NONE { continue; }
        xs.push(ds.name.as_slice()[m]);
        ps.push(m as% u32);
    }
    let perm = sort.sort_perm(xs.as_slice());
    let mut names = vec.Vec::<u32>.with_capacity(xs.len());
    let mut imps = vec.Vec::<u32>.with_capacity(xs.len());
    for k in 0..perm.len() {
        let i = perm.as_slice()[k] as usize;
        names.push(xs.as_slice()[i]);
        imps.push(ps.as_slice()[i]);
    }
    return (names, imps);
}

// Whether v (decided) is a gather / scatter index for want as it is: a vector of unsigned lanes
// with want's fixed lane count.
fn index_ok(tab: &types.Table, v: u32, want: u32) -> bool {
    if v == NONE || tab.tag_of(v) != types.TK_VECTOR || tab.b_of(want) == types.LANES_N || tab.b_of(v) != tab.b_of(want) { return false; }
    let l = tab.a_of(v);
    return tab.tag_of(l) == types.TK_INT && !tab.is_signed(l);
}

// The source bytes of global token tok of item it, up to the end of its word (letters, digits,
// `_`; with `float`, also `.` and an exponent sign).
pub fn tok_text(t: &lex.Tokens, set: &source.SourceSet, cut: &items.Items, it: u32, tok: u32, float: bool) -> &[u8] from set {
    let f = cut.file.as_slice()[it as usize] as usize;
    let src = set.file(f);
    let s = t.start.as_slice()[tok as usize] as usize;
    let mut e = s;
    while e < src.len() {
        let c = src[e];
        let word = (c >= 48 && c <= 57) || (c >= 65 && c <= 90) || (c >= 97 && c <= 122) || c == 95;
        let dot = float && c == 46;
        let sign = float && (c == 43 || c == 45) && e > s && (src[e - 1] == 101 || src[e - 1] == 69);
        if !word && !dot && !sign { break; }
        e = e + 1;
    }
    return &src[s..e];
}

fn kind(tree: &ast.Ast, g: usize) -> u8 {
    return tree.kind.as_slice()[g];
}

fn is_expr(k: u8) -> bool {
    return consteval.is_expr_kind(k);
}

// The significand bits of a float type (format a).
fn sig_bits(f: u32) -> u32 {
    return if f == 0 then 11u32 else if f == 3 then 8u32 else if f == 1 then 24u32 else 53u32;
}

fn is_64(tab: &types.Table, ty: u32) -> bool {
    return tab.tag_of(ty) == types.TK_INT && tab.b_of(ty) >= types.W_64;
}

// stage0's cast table for `as`, `as%`, `as|`, `as~`, `as?`: whether `src op dst` is allowed; the
// result type is `dst` (`Option<dst>` for `as?`).
pub fn cast_ok(tab: &types.Table, op: u8, src: u32, dst: u32) -> bool {
    let fk = tab.tag_of(src);
    let tk2 = tab.tag_of(dst);
    let plain = op == terminals.T_KW_AS;
    let identity = src == dst && (fk == types.TK_INT || fk == types.TK_FLOAT || fk == types.TK_BOOL || fk == types.TK_CHAR || fk == types.TK_VECTOR || fk == types.TK_MASK || fk == types.TK_REF || fk == types.TK_PTR);
    if identity { return true; }
    if fk == types.TK_VECTOR && tk2 == types.TK_VECTOR {
        if tab.b_of(src) != tab.b_of(dst) { return false; }
        return scalar_ok(tab, op, tab.a_of(src), tab.a_of(dst));
    }
    if fk == types.TK_REF {
        if tk2 == types.TK_PTR && plain && tab.b_of(dst) == tab.b_of(src) && (tab.a_of(src) == 1 || tab.a_of(dst) == 0) { return true; }
        return false;
    }
    return scalar_ok(tab, op, src, dst);
}

fn scalar_ok(tab: &types.Table, op: u8, src: u32, dst: u32) -> bool {
    let fk = tab.tag_of(src);
    let tk2 = tab.tag_of(dst);
    let fint = fk == types.TK_INT;
    let tint = tk2 == types.TK_INT;
    let ffloat = fk == types.TK_FLOAT;
    let tfloat = tk2 == types.TK_FLOAT;
    if op == terminals.T_KW_AS {
        if fint && tint {
            let fs = tab.a_of(src) == 1;
            let ts = tab.a_of(dst) == 1;
            let fb = tab.int_bits(src);
            let tb = tab.int_bits(dst);
            return (fs == ts && tb >= fb) || (!fs && ts && tb > fb);
        }
        if fk == types.TK_BOOL && tint { return true; }
        if fk == types.TK_CHAR {
            if !tint { return false; }
            let w = tab.b_of(dst);
            if tab.a_of(dst) == 0 { return w == types.W_32 || w == types.W_64 || w == types.W_SIZE; }
            return w == types.W_64 || w == types.W_SIZE;
        }
        if fint && tab.a_of(src) == 0 && tab.b_of(src) == types.W_8 && tk2 == types.TK_CHAR { return true; }
        if fint && tfloat {
            let fb = tab.int_bits(src);
            let need = if tab.a_of(src) == 1 then fb - 1 else fb;
            return need <= sig_bits(tab.a_of(dst));
        }
        if ffloat && tfloat {
            let f = tab.a_of(src);
            let g = tab.a_of(dst);
            return ((f == 0 || f == 3) && (g == 1 || g == 2)) || (f == 1 && g == 2);
        }
        if fk == types.TK_PTR && tk2 == types.TK_PTR { return true; }
        return (fk == types.TK_PTR && is_64(tab, dst)) || (is_64(tab, src) && tk2 == types.TK_PTR);
    }
    if op == terminals.T_AS_PERCENT { return tint && (fint || fk == types.TK_BOOL || fk == types.TK_CHAR || fk == types.TK_PTR); }
    if op == terminals.T_AS_PIPE { return tint && (fint || ffloat || fk == types.TK_CHAR); }
    if op == terminals.T_AS_TILDE { return tfloat && (fint || ffloat); }
    if op == terminals.T_AS_QUESTION {
        if tint { return fint || ffloat || fk == types.TK_CHAR; }
        if tk2 == types.TK_CHAR || tfloat { return fint || (ffloat && tfloat); }
    }
    return false;
}

// The bytes of a string or char literal token (quotes included): from its start to the closing
// quote on its line.
pub fn quoted_text(t: &lex.Tokens, set: &source.SourceSet, cut: &items.Items, it: u32, tok: u32) -> &[u8] from set {
    let f = cut.file.as_slice()[it as usize] as usize;
    let src = set.file(f);
    let s = t.start.as_slice()[tok as usize] as usize;
    let q = src[s];
    let mut e = s + 1;
    while e < src.len() && src[e] != q && src[e] != 10 {
        if src[e] == 92 { e = e + 1; }
        e = e + 1;
    }
    if e >= src.len() { return &src[s..src.len()]; }
    return &src[s..e + 1];
}

fn hex(c: u8) -> u32 {
    if c >= 48 && c <= 57 { return (c - 48) as u32; }
    if c >= 97 && c <= 102 { return (c - 87) as u32; }
    if c >= 65 && c <= 70 { return (c - 55) as u32; }
    return NONE;
}

// What a literal body unescapes to: its number of chars (UTF-8 lead bytes and escapes), or NONE
// for an escape stage0 rejects or a `\x` above 0x7F (not one char); and its last char.
pub fn unescape(b: &[u8]) -> (u32, u32) {
    let mut n: u32 = 0;
    let mut cp: u32 = 0;
    let mut i: usize = 0;
    while i < b.len() {
        let c = b[i];
        if c != 92 {
            if c & 0xc0 != 0x80 {
                n = n + 1;
                cp = if c < 0x80 then c as u32 else if c >= 0xf0 then (c & 0x07) as u32 else if c >= 0xe0 then (c & 0x0f) as u32 else (c & 0x1f) as u32;
            } else {
                cp = (cp << 6) | (c & 0x3f) as u32;
            }
            i = i + 1;
            continue;
        }
        if i + 1 >= b.len() { return (NONE, 0); }
        let e = b[i + 1];
        i = i + 2;
        n = n + 1;
        if e == 110 || e == 116 || e == 114 || e == 48 || e == 92 || e == 39 || e == 34 || e == 123 || e == 125 {
            // `\n` `\t` `\r` `\0`; any other stands for itself
            cp = if e == 110 then 10u32 else if e == 116 then 9u32 else if e == 114 then 13u32 else if e == 48 then 0u32 else e as u32;
        } else if e == 120 {
            if i + 2 > b.len() { return (NONE, 0); }
            let h = hex(b[i]);
            let l = hex(b[i + 1]);
            if h == NONE || l == NONE || h > 7 { return (NONE, 0); }
            cp = h * 16 + l;
            i = i + 2;
        } else if e == 117 {
            if i >= b.len() || b[i] != 123 { return (NONE, 0); }
            let mut j = i + 1;
            let mut u: u32 = 0;
            while j < b.len() && b[j] != 125 {
                let d = hex(b[j]);
                if d == NONE || u > 0x10_ffff { return (NONE, 0); }
                u = u * 16 + d;
                j = j + 1;
            }
            if j >= b.len() || j == i + 1 || u > 0x10_ffff || (u >= 0xd800 && u <= 0xdfff) { return (NONE, 0); }
            cp = u;
            i = j + 1;
        } else {
            return (NONE, 0);
        }
    }
    return (n, cp);
}

// Whether an int literal of magnitude mag (big: above u64) negated when neg fits int type x.
pub fn int_fits(tab: &types.Table, x: u32, mag: u64, big: bool, neg: bool) -> bool {
    let bits = tab.int_bits(x);
    let lim: u64 = if tab.a_of(x) == 1 then (if neg then 1u64 << (bits - 1) as u64 else (1u64 << (bits - 1) as u64) - 1) else if neg then 0u64 else if bits == 64 then 0xffff_ffff_ffff_ffff else (1u64 << bits as u64) - 1;
    return !big && mag <= lim;
}

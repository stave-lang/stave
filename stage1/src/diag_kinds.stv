// The impl checks over the impl table, as stage0's `check_impls` raises them: per impl decl in
// D order, E0421 (a param its self type does not bind), E0420 (an impl in neither the package of
// its trait nor that of its self type's head), E1408 (an impl of `Flat` or `Frozen`), E0810 (an
// unsafe trait implemented without `unsafe("..")`), E0907 (`pub` on a trait impl method), E0906
// (a trait method missing, or a method the trait lacks), E0905 (a method whose signature differs
// from the trait method's), E0419 (`Drop` for a type of another
// package), E0416 (a `Drop` impl whose head unifies with a `Copy` impl's), E0414 case `drop` (a
// `Drop` impl that does not cover the view params of its ADT), and E0903 (two impls of one trait
// whose heads and trait arguments unify, or an operator impl beside a built-in one). An impl that
// fails E0421, E0420, E1408, or E0419 takes part in no later check, and only the impls that pass
// every check are met by the overlap check of later ones.
//
// Then over the impls that reach E0907 (`copy_checks`): E0415 (a Copy impl of a struct or enum
// with a field that is not Copy) and E0422 (an operator trait implemented for a type that is not
// Copy), Copy judged under the impl's own bounds by one round of trait questions.
import ast;
import consteval;
import decls;
import diag;
import diag_sigs;
import diag_tc;
import files;
import generated.node_kinds;
import generated.terminals;
import intern;
import items;
import kinds;
import lex;
import modules;
import source;
import sigs;
import tc_traits;
import text;
import traits;
import ir.types;
import prims.col;
import prims.search;
import prims.sort;
import std.idx;
import std.mem;
import std.vec;

const NONE: u32 = idx.NONE;
const ERR: u32 = types.ERR;

fn tk(t: &lex.Tokens, tok: u32) -> u8 {
    return t.kind.as_slice()[tok as usize] as% u8;
}

fn pkg_of(ds: &decls.Decls, md: &modules.Modules, d: u32) -> u32 {
    if d == NONE || d as usize >= ds.decls() { return NONE; }
    let m = ds.module.as_slice()[d as usize];
    if m == NONE { return NONE; }
    return md.mod_pkg.as_slice()[m as usize];
}

// The dotted path of decl d (`main.Area`, `std.core.Copy`, `main.S.impl`).
fn decl_path(out: &mut vec.Vec<u8>, ds: &decls.Decls, md: &modules.Modules, nm: &intern.Interned, d: u32) {
    let mut chain = vec.Vec::<u32>.new();
    let mut x = d;
    while x != NONE {
        chain.push(x);
        if ds.kind.as_slice()[x as usize] == decls.DK_MODULE { break; }
        x = ds.parent.as_slice()[x as usize];
    }
    let top = chain.as_slice()[chain.len() - 1];
    let m = ds.module.as_slice()[top as usize];
    let start = out.len();
    if m != NONE { out.extend_from_slice(md.text(m as usize)); }
    let mut j = chain.len();
    while j > 0 {
        j = j - 1;
        let e = chain.as_slice()[j];
        if ds.kind.as_slice()[e as usize] == decls.DK_MODULE { continue; }
        if out.len() > start { out.push(46); }
        if ds.kind.as_slice()[e as usize] == decls.DK_IMPL {
            out.extend_from_slice(mem.str_bytes("impl"));
        } else {
            out.extend_from_slice(nm.tab.text(ds.name.as_slice()[e as usize] as usize));
        }
    }
}

// The members of every decl sorted by (parent, D): keys and decls.
fn by_parent(ds: &decls.Decls) -> (vec.Vec<u64>, vec.Vec<u32>) {
    let mut keys = vec.Vec::<u64>.new();
    for e in 0..ds.decls() {
        let p = ds.parent.as_slice()[e];
        if p == NONE { continue; }
        keys.push(search.pair(p, e as% u32));
    }
    let perm = sort.sort_perm(keys.as_slice());
    let mut sk = vec.Vec::<u64>.new();
    let mut si = vec.Vec::<u32>.new();
    for j in 0..perm.len() {
        let k = keys.as_slice()[perm.as_slice()[j] as usize];
        sk.push(k);
        si.push((k & 0xffff_ffff) as% u32);
    }
    return (sk, si);
}

fn members_of(keys: &[u64], ids: &[u32], p: u32, kind: u8, ds: &decls.Decls, out: &mut vec.Vec<u32>) {
    out.clear();
    let lo = search.lower_bound(keys, search.pair(p, 0));
    let hi = search.lower_bound(keys, search.pair(p + 1, 0));
    for j in lo..hi {
        if ds.kind.as_slice()[ids[j] as usize] == kind { out.push(ids[j]); }
    }
}

// The generic params of impl d (rows lo..hi) that its self type does not name.
fn unbound_params(tab: &types.Table, st: u32, n: usize, out: &mut vec.Vec<u32>) {
    out.clear();
    if st == ERR { return; }
    let mut used = col.filled(n, false);
    let mut stack = vec.Vec::<u32>.new();
    let mut kids = vec.Vec::<u32>.new();
    stack.push(st);
    while stack.len() > 0 {
        let x = stack.as_slice()[stack.len() - 1];
        stack.truncate(stack.len() - 1);
        let tag = tab.tag_of(x);
        let xs = tab.x(x);
        if (tag == types.TK_PARAM || tag == types.TK_CONSTPARAM) && (tab.a_of(x) as usize) < n { used.as_mut_slice()[tab.a_of(x) as usize] = true; }
        if tag == types.TK_ARRAY && xs[0] == types.GA_PARAM && (xs[1] as usize) < n { used.as_mut_slice()[xs[1] as usize] = true; }
        if tag == types.TK_ADT {
            let mut k: usize = 0;
            while k + 2 < xs.len() {
                if xs[k] == types.GA_PARAM && (xs[k + 1] as usize) < n { used.as_mut_slice()[xs[k + 1] as usize] = true; }
                k = k + 3;
            }
        }
        tab.kids(x, &mut kids);
        stack.extend_from_slice(kids.as_slice());
    }
    for i in 0..n {
        if !used.as_slice()[i] { out.push(i as% u32); }
    }
}

// Syntactic unification of two impl heads: impl a's params are the variables 0..na, impl b's
// na..na + nb (b's types shifted). A variable is bound once (3 words: kind NONE while unbound),
// with an occurs check.
struct Unifier {
    binds: vec.Vec<u32>,
    nv: u32,
}

impl Unifier {
    fn resolve(&self, tab: &types.Table, t: u32) -> u32 {
        let mut x = t;
        loop {
            if tab.tag_of(x) != types.TK_PARAM { return x; }
            let i = tab.a_of(x);
            if i >= self.nv || self.binds.as_slice()[3 * i as usize] != types.GA_TYPE { return x; }
            x = self.binds.as_slice()[3 * i as usize + 1];
        }
    }

    fn resolve_const(&self, k: u32, x: u32, y: u32) -> (u32, u32, u32) {
        let mut c = (k, x, y);
        loop {
            let (ck, cx, _) = c;
            if ck != types.GA_PARAM || cx >= self.nv { return c; }
            let b = 3 * cx as usize;
            let bk = self.binds.as_slice()[b];
            if bk == NONE || bk == types.GA_TYPE { return c; }
            c = (bk, self.binds.as_slice()[b + 1], self.binds.as_slice()[b + 2]);
        }
    }

    fn occurs(&self, tab: &types.Table, v: u32, t: u32) -> bool {
        let mut stack = vec.Vec::<u32>.new();
        let mut kids = vec.Vec::<u32>.new();
        stack.push(t);
        let mut steps: usize = 0;
        while stack.len() > 0 && steps < 1000000 {
            steps = steps + 1;
            let x0 = stack.as_slice()[stack.len() - 1];
            stack.truncate(stack.len() - 1);
            let x = self.resolve(tab, x0);
            if tab.tag_of(x) == types.TK_PARAM {
                if tab.a_of(x) == v { return true; }
                continue;
            }
            tab.kids(x, &mut kids);
            stack.extend_from_slice(kids.as_slice());
        }
        return false;
    }

    fn bind(&mut self, tab: &types.Table, v: u32, t: u32) -> bool {
        if self.binds.as_slice()[3 * v as usize] != NONE { return false; }
        if self.occurs(tab, v, t) { return false; }
        self.binds.as_mut_slice()[3 * v as usize] = types.GA_TYPE;
        self.binds.as_mut_slice()[3 * v as usize + 1] = t;
        return true;
    }

    fn unify_const(&mut self, pk: u32, px: u32, py: u32, xk: u32, xx: u32, xy: u32) -> bool {
        let (ak, ax, ay) = self.resolve_const(pk, px, py);
        let (bk, bx, by) = self.resolve_const(xk, xx, xy);
        if (ak == bk && ax == bx && ay == by) || ak == types.GA_ERROR || bk == types.GA_ERROR { return true; }
        if ak == types.GA_PARAM && ax < self.nv && self.binds.as_slice()[3 * ax as usize] == NONE {
            self.set_const(ax, bk, bx, by);
            return true;
        }
        if bk == types.GA_PARAM && bx < self.nv && self.binds.as_slice()[3 * bx as usize] == NONE {
            self.set_const(bx, ak, ax, ay);
            return true;
        }
        return false;
    }

    fn set_const(&mut self, v: u32, k: u32, x: u32, y: u32) {
        let b = 3 * v as usize;
        self.binds.as_mut_slice()[b] = k;
        self.binds.as_mut_slice()[b + 1] = x;
        self.binds.as_mut_slice()[b + 2] = y;
    }

    // Whether a and b have a common instance.
    fn unify(&mut self, tab: &types.Table, a: u32, b: u32) -> bool {
        let mut stack = vec.Vec::<u32>.new();
        stack.push(a);
        stack.push(b);
        while stack.len() > 0 {
            let n = stack.len();
            let x = self.resolve(tab, stack.as_slice()[n - 1]);
            let p = self.resolve(tab, stack.as_slice()[n - 2]);
            stack.truncate(n - 2);
            if p == x || p == ERR || x == ERR { continue; }
            let tp = tab.tag_of(p);
            let tx = tab.tag_of(x);
            if tp == types.TK_PARAM && tab.a_of(p) < self.nv {
                if !self.bind(tab, tab.a_of(p), x) { return false; }
                continue;
            }
            if tx == types.TK_PARAM && tab.a_of(x) < self.nv {
                if !self.bind(tab, tab.a_of(x), p) { return false; }
                continue;
            }
            if tp != tx { return false; }
            let pa = tab.a_of(p);
            let xa = tab.a_of(x);
            let pb = tab.b_of(p);
            let xb = tab.b_of(x);
            if tp == types.TK_REF || tp == types.TK_PTR {
                if pa != xa { return false; }
                stack.push(pb);
                stack.push(xb);
            } else if tp == types.TK_ARRAY {
                let px = tab.x(p);
                let xx = tab.x(x);
                if !self.unify_const(px[0], px[1], px[2], xx[0], xx[1], xx[2]) { return false; }
                stack.push(pa);
                stack.push(xa);
            } else if tp == types.TK_SLICE || tp == types.TK_RANGE || tp == types.TK_VECTOR {
                if pb != xb { return false; }
                stack.push(pa);
                stack.push(xa);
            } else if tp == types.TK_TUPLE {
                let px = tab.x(p);
                let xx = tab.x(x);
                if px.len() != xx.len() { return false; }
                for k in 0..px.len() {
                    stack.push(px[k]);
                    stack.push(xx[k]);
                }
            } else if tp == types.TK_ADT {
                let px = tab.x(p);
                let xx = tab.x(x);
                if pa != xa || px.len() != xx.len() { return false; }
                let mut k: usize = 0;
                while k + 2 < px.len() {
                    let pt = px[k] == types.GA_TYPE;
                    let xt = xx[k] == types.GA_TYPE;
                    if pt && xt {
                        stack.push(px[k + 1]);
                        stack.push(xx[k + 1]);
                    } else if pt || xt {
                        return false;
                    } else if !self.unify_const(px[k], px[k + 1], px[k + 2], xx[k], xx[k + 1], xx[k + 2]) {
                        return false;
                    }
                    k = k + 3;
                }
            } else if tp == types.TK_FN {
                let px = tab.x(p);
                let xx = tab.x(x);
                if pa != xa { return false; }
                let np = pa as usize;
                for k in np + 1..np + 4 {
                    if px[k] != xx[k] { return false; }
                }
                for k in 0..np + 1 {
                    stack.push(px[k]);
                    stack.push(xx[k]);
                }
            } else {
                return false;
            }
        }
        return true;
    }
}

// Whether the heads of impls a and b (and their trait arguments, when `args`) unify.
fn heads_unify(tab: &mut types.Table, sg: &sigs.Sigs, a: u32, b: u32, args: bool) -> bool {
    let gl = &sg.cx.gens.lo;
    let na = gl.as_slice()[a as usize + 1] - gl.as_slice()[a as usize];
    let blo = gl.as_slice()[b as usize];
    let nb = gl.as_slice()[b as usize + 1] - blo;
    let mut shift = vec.Vec::<u32>.new();
    for i in 0..nb {
        if sg.cx.gens.is_const.as_slice()[(blo + i) as usize] {
            shift.push(types.GA_PARAM);
            shift.push(na + i);
            shift.push(0);
        } else {
            shift.push(types.GA_TYPE);
            shift.push(tab.key(types.TK_PARAM, na + i, 0));
            shift.push(0);
        }
    }
    let mut u = Unifier.{ binds: col.filled(3 * (na + nb) as usize, NONE), nv: na + nb };
    let bt = tab.subst(sg.cx.ty.as_slice()[b as usize], shift.as_slice());
    if !u.unify(tab, sg.cx.ty.as_slice()[a as usize], bt) { return false; }
    if !args { return true; }
    let ra = sg.trait_ref.as_slice()[a as usize];
    let rb = sg.trait_ref.as_slice()[b as usize];
    if ra == NONE || rb == NONE { return false; }
    let mut xa = vec.Vec::<u32>.new();
    xa.extend_from_slice(sg.b_args.row(ra as usize));
    let mut xb = vec.Vec::<u32>.new();
    let rbx = sg.b_args.row(rb as usize);
    let mut k: usize = 0;
    while k + 2 < rbx.len() {
        if rbx[k] == types.GA_TYPE {
            xb.push(types.GA_TYPE);
            xb.push(tab.subst(rbx[k + 1], shift.as_slice()));
            xb.push(0);
        } else if rbx[k] == types.GA_PARAM && 3 * (rbx[k + 1] as usize) + 2 < shift.len() && shift.as_slice()[3 * rbx[k + 1] as usize] != types.GA_TYPE {
            let s = 3 * rbx[k + 1] as usize;
            xb.push(shift.as_slice()[s]);
            xb.push(shift.as_slice()[s + 1]);
            xb.push(shift.as_slice()[s + 2]);
        } else {
            xb.push(rbx[k]);
            xb.push(rbx[k + 1]);
            xb.push(rbx[k + 2]);
        }
        k = k + 3;
    }
    if xa.len() != xb.len() { return false; }
    let mut j: usize = 0;
    while j + 2 < xa.len() {
        let pa = xa.as_slice()[j];
        let pb = xb.as_slice()[j];
        let ok = if pa == types.GA_TYPE && pb == types.GA_TYPE then u.unify(tab, xa.as_slice()[j + 1], xb.as_slice()[j + 1]) else if pa != types.GA_TYPE && pb != types.GA_TYPE then u.unify_const(pa, xa.as_slice()[j + 1], xa.as_slice()[j + 2], pb, xb.as_slice()[j + 1], xb.as_slice()[j + 2]) else false;
        if !ok { return false; }
        j = j + 3;
    }
    return true;
}

// E0905's comparison (stage0's `sig_matches`): method m of impl i against trait method tm, with
// `Self` the impl's self type, the trait's params its trait arguments (the error type for one not
// given), and tm's own generics renumbered after the impl's. They match when they have as many
// own generics, the same params (a type holding the error type matches any) and `self` form,
// return type, `from` entries, features, and `unsafe`, and per own generic param the same kind,
// `view`, a const param's type, and the same set of bounds (complete trait refs; a set holding an
// erroneous argument matches any).
fn sig_matches(tab: &mut types.Table, sg: &sigs.Sigs, i: u32, tm: u32, m: u32) -> bool {
    let gl = sg.cx.gens.lo.as_slice();
    let own_t = (gl[tm as usize + 1] - gl[tm as usize]) as usize;
    let own_m = (gl[m as usize + 1] - gl[m as usize]) as usize;
    if own_t != own_m { return false; }
    let tr_row = sg.trait_ref.as_slice()[i as usize];
    let tr = sg.b_trait.as_slice()[tr_row as usize];
    let nt = (gl[tr as usize + 1] - gl[tr as usize]) as usize;
    let ni = (gl[i as usize + 1] - gl[i as usize]) as usize;
    let st = sg.cx.ty.as_slice()[i as usize];
    let mut args = vec.Vec::<u32>.new();
    let ta = sg.b_args.row(tr_row as usize);
    for k in 0..nt {
        if 3 * k + 2 < ta.len() {
            args.extend_from_slice(&ta[3 * k..3 * k + 3]);
        } else {
            args.push(types.GA_TYPE);
            args.push(ERR);
            args.push(0);
        }
    }
    let to = gl[tm as usize] as usize;
    let mo = gl[m as usize] as usize;
    for j in 0..own_t {
        let idx = (ni + j) as% u32;
        if sg.cx.gens.is_const.as_slice()[to + j] {
            args.push(types.GA_PARAM);
            args.push(idx);
            args.push(0);
        } else {
            args.push(types.GA_TYPE);
            args.push(tab.key(types.TK_PARAM, idx, 0));
            args.push(0);
        }
    }
    let tp = sg.params.row(tm as usize);
    let mp = sg.params.row(m as usize);
    let tf = sg.sflags.as_slice()[tm as usize];
    let mf = sg.sflags.as_slice()[m as usize];
    if tp.len() != mp.len() || tf & sigs.SF_SELF_MASK != mf & sigs.SF_SELF_MASK { return false; }
    for k in 0..tp.len() {
        if !same_or_err(tab, tp[k], mp[k], args.as_slice(), st) { return false; }
    }
    if !same_or_err(tab, sg.cx.ty.as_slice()[tm as usize], sg.cx.ty.as_slice()[m as usize], args.as_slice(), st) { return false; }
    if !sg.rfrom.row(tm as usize).eq(sg.rfrom.row(m as usize)) || !sg.pfrom.row(tm as usize).eq(sg.pfrom.row(m as usize)) { return false; }
    if sg.feats.as_slice()[tm as usize] != sg.feats.as_slice()[m as usize] || tf & sigs.SF_UNSAFE != mf & sigs.SF_UNSAFE { return false; }
    let gs = &sg.cx.gens;
    for j in 0..own_t {
        let a = to + j;
        let b = mo + j;
        if gs.is_const.as_slice()[a] != gs.is_const.as_slice()[b] || gs.is_view.as_slice()[a] != gs.is_view.as_slice()[b] { return false; }
        if gs.is_const.as_slice()[a] && !same_or_err(tab, gs.cty.as_slice()[a], gs.cty.as_slice()[b], args.as_slice(), st) { return false; }
        if !same_bounds(tab, sg, a, b, args.as_slice(), st) { return false; }
    }
    return true;
}

// Trait-side type a after `sig_matches`'s substitution against impl-side type b: equal, or either
// holds the error type.
fn same_or_err(tab: &mut types.Table, a: u32, b: u32, args: &[u32], st: u32) -> bool {
    let a2 = sub_sig(tab, a, args, st);
    return a2 == b || a2 == ERR || b == ERR || a2 == NONE || b == NONE;
}

// Type t with the generic arguments args, then `Self` replaced by st.
fn sub_sig(tab: &mut types.Table, t: u32, args: &[u32], st: u32) -> u32 {
    if t == ERR || t == NONE { return t; }
    let x = tab.subst(t, args);
    return tc_traits.subst_self(tab, x, st);
}

// Whether trait-side generic param row a's bounds, substituted, are the set of impl-side param
// row b's (each a trait and its arguments), or an argument of either is erroneous.
fn same_bounds(tab: &mut types.Table, sg: &sigs.Sigs, a: usize, b: usize, args: &[u32], st: u32) -> bool {
    let mut ta = vec.Vec::<u32>.new();
    let mut tb = vec.Vec::<u32>.new();
    let mut bad = false;
    let ra = sg.gp_bounds.row(a);
    for k in 0..ra.len() {
        let r = ra[k] as usize;
        let xs = sg.b_args.row(r);
        ta.push(sg.b_trait.as_slice()[r]);
        ta.push((xs.len() / 3) as% u32);
        for q in 0..xs.len() / 3 {
            let kd = xs[3 * q];
            if kd == types.GA_TYPE {
                let v = sub_sig(tab, xs[3 * q + 1], args, st);
                if v == ERR || v == NONE { bad = true; }
                ta.push(kd);
                ta.push(v);
                ta.push(0);
            } else if kd == types.GA_PARAM && 3 * (xs[3 * q + 1] as usize) + 2 < args.len() && args[3 * xs[3 * q + 1] as usize] != types.GA_TYPE {
                let p = 3 * xs[3 * q + 1] as usize;
                ta.extend_from_slice(&args[p..p + 3]);
            } else {
                if kd == types.GA_ERROR { bad = true; }
                ta.extend_from_slice(&xs[3 * q..3 * q + 3]);
            }
        }
    }
    let rb = sg.gp_bounds.row(b);
    for k in 0..rb.len() {
        let r = rb[k] as usize;
        let xs = sg.b_args.row(r);
        tb.push(sg.b_trait.as_slice()[r]);
        tb.push((xs.len() / 3) as% u32);
        for q in 0..xs.len() / 3 {
            let kd = xs[3 * q];
            if (kd == types.GA_TYPE && (xs[3 * q + 1] == ERR || xs[3 * q + 1] == NONE)) || kd == types.GA_ERROR { bad = true; }
            tb.extend_from_slice(&xs[3 * q..3 * q + 3]);
        }
    }
    if bad { return true; }
    return refs_in(ta.as_slice(), tb.as_slice()) && refs_in(tb.as_slice(), ta.as_slice());
}

// Whether every trait ref of list xs (trait, argument count, the arguments' 3 words each) is in
// list ys.
fn refs_in(xs: &[u32], ys: &[u32]) -> bool {
    let mut i: usize = 0;
    while i < xs.len() {
        let n = 2 + 3 * xs[i + 1] as usize;
        let mut j: usize = 0;
        let mut found = false;
        while j < ys.len() && !found {
            let m = 2 + 3 * ys[j + 1] as usize;
            if m == n && xs[i..i + n].eq(&ys[j..j + m]) { found = true; }
            j = j + m;
        }
        if !found { return false; }
        i = i + n;
    }
    return true;
}

// The source text of trait method tm's signature: from its first token to the one before its `;`.
fn trait_sig_text(tree: &ast.Ast, lx: &lex.Lexer, set: &source.SourceSet, t: &lex.Tokens, ds: &decls.Decls, tm: u32) -> &[u8] from set {
    let it = ds.item.as_slice()[tm as usize];
    let a = tree.tok.as_slice()[tree.item_node.as_slice()[it as usize] as usize + ds.node.as_slice()[tm as usize] as usize];
    let mut e = a;
    while tk(t, e) != terminals.T_SEMI && tk(t, e) != terminals.T_EOF {
        e = e + 1;
    }
    let (f, s, _) = modules.tok_span(lx, set, t, a);
    let (_, s2, z2) = modules.tok_span(lx, set, t, if e > a then e - 1 else a);
    return &set.file(f as usize)[s as usize..(s2 + z2) as usize];
}

// The `pub` token before method m's `fn` (or its `unsafe("..")`), or NONE.
fn pub_token(tree: &ast.Ast, t: &lex.Tokens, ds: &decls.Decls, m: u32) -> u32 {
    let it = ds.item.as_slice()[m as usize];
    let n = ds.node.as_slice()[m as usize];
    if it == NONE || n == NONE { return NONE; }
    let a = tree.tok.as_slice()[tree.item_node.as_slice()[it as usize] as usize + n as usize];
    for back in 1..6u32 {
        if back > a { return NONE; }
        let x = a - back;
        let k = tk(t, x);
        if k == terminals.T_KW_PUB { return x; }
        if k != terminals.T_KW_UNSAFE && k != terminals.T_L_PAREN && k != terminals.T_R_PAREN && k != terminals.T_STR_LIT { return NONE; }
    }
    return NONE;
}

fn span_of(ds: &decls.Decls, md: &modules.Modules, lx: &lex.Lexer, set: &source.SourceSet, t: &lex.Tokens, d: u32) -> (u32, u32, u32) {
    return decls.span(ds, md, lx, set, t, d);
}

// The name of decl d as written.
fn name_of(nm: &intern.Interned, ds: &decls.Decls, d: u32) -> &[u8] from nm {
    return nm.tab.text(ds.name.as_slice()[d as usize] as usize);
}

// E0420: the impl is in neither the package of its trait nor that of its self type's head (a
// struct or enum belongs to its package, any other head to `std`, a generic param to none).
fn incoherent(tab: &types.Table, sg: &sigs.Sigs, ds: &decls.Decls, md: &modules.Modules, lang: &traits.Lang, d: u32, tr: u32) -> bool {
    let st = sg.cx.ty.as_slice()[d as usize];
    if st == ERR { return false; }
    let pkg = pkg_of(ds, md, d);
    let std_pkg = if lang.copy_tr == NONE then NONE else pkg_of(ds, md, lang.copy_tr);
    let tag = tab.tag_of(st);
    let local = if tag == types.TK_ADT then pkg_of(ds, md, tab.a_of(st)) == pkg else if tag == types.TK_PARAM || tag == types.TK_CONSTPARAM || tag == types.TK_SELF then false else pkg != NONE && std_pkg == pkg;
    if tr == NONE { return !local; }
    return !local && pkg_of(ds, md, tr) != pkg;
}

// The impl checks as diagnostics. The type table grows (shifted impl heads) and is put back.
pub fn impl_diags(d: &mut diag.Diags, sg: &mut sigs.Sigs, ds: &decls.Decls, md: &modules.Modules, nm: &intern.Interned, fl: &files.FileList, lx: &lex.Lexer, set: &source.SourceSet, t: &lex.Tokens, tree: &ast.Ast) {
    let n = ds.decls();
    // each impl's self type as written in its messages
    let mut texts = vec.Vec::<u8>.new();
    let mut one = vec.Vec::<u8>.new();
    let mut t_lo = col.filled(n + 1, 0u32);
    for x in 0..n {
        t_lo.as_mut_slice()[x] = texts.len() as% u32;
        if ds.kind.as_slice()[x] != decls.DK_IMPL || ds.item.as_slice()[x] == NONE { continue; }
        let lo = sg.cx.gens.lo.as_slice()[x];
        let hi = sg.cx.gens.lo.as_slice()[x + 1];
        let sc = [0u32, 0u32, lo, hi];
        // the spelling is cut by its own length: one buffer per type
        one.clear();
        diag_sigs.display(&mut one, sg, ds, nm, &sc, sg.cx.ty.as_slice()[x]);
        texts.extend_from_slice(one.as_slice());
    }
    t_lo.as_mut_slice()[n] = texts.len() as% u32;
    let mut tab = mem.replace(&mut sg.cx.tab, types.Table.new());
    let mut ok = vec.Vec::<u32>.new();
    check(d, &mut tab, sg, ds, md, nm, fl, lx, set, t, tree, texts.as_slice(), t_lo.as_slice(), &mut ok);
    sg.cx.tab = tab;
    copy_checks(d, sg, ds, md, nm, fl, lx, set, t, tree, texts.as_slice(), t_lo.as_slice(), ok.as_slice());
}

// E0415 and E0422 for the impls of list ok (they passed the checks that skip an impl), as stage0
// raises them: Copy is asked of each field type of a Copy impl's struct or enum (substituted by
// its self type's arguments; an erroneous one is skipped) and of an operator impl's self type,
// in the environment of the impl's own generics; the questions are solved in one round.
fn copy_checks(d: &mut diag.Diags, sg: &mut sigs.Sigs, ds: &decls.Decls, md: &modules.Modules, nm: &intern.Interned, fl: &files.FileList, lx: &lex.Lexer, set: &source.SourceSet, t: &lex.Tokens, tree: &ast.Ast, texts: &[u8], t_lo: &[u32], ok: &[u32]) {
    let mut tq = tc_traits.new(sg, ds, fl, md, nm);
    let cp = tq.tr.lang.copy_tr;
    if cp == NONE { return; }
    // per question: impl, goal, field decl (NONE: the self type; a tuple payload: its variant),
    // its index in its variant, the type asked
    let mut q_imp = vec.Vec::<u32>.new();
    let mut q_goal = vec.Vec::<u32>.new();
    let mut q_f = vec.Vec::<u32>.new();
    let mut q_k = vec.Vec::<u32>.new();
    let mut q_ty = vec.Vec::<u32>.new();
    let mut args = vec.Vec::<u32>.new();
    let none = vec.Vec::<u32>.new();
    let n = ds.decls();
    for j in 0..ok.len() {
        let i = ok[j] as usize;
        let tr = tq.tr.im.trait_of.as_slice()[i];
        let st = sg.cx.ty.as_slice()[i];
        if st == ERR || st == NONE { continue; }
        let lo = sg.cx.gens.lo.as_slice()[i];
        let hi = sg.cx.gens.lo.as_slice()[i + 1];
        let e = tq.tr.env_of(sg, lo, lo, lo, hi);
        if tr == cp && sg.cx.tab.tag_of(st) == types.TK_ADT {
            let def = sg.cx.tab.a_of(st);
            args.clear();
            args.extend_from_slice(sg.cx.tab.x(st));
            // the struct's fields, or each variant's in order
            for v in 0..n {
                let p = ds.parent.as_slice()[v];
                let vk = ds.kind.as_slice()[v];
                let own = p == def && (vk == decls.DK_FIELD || vk == decls.DK_VARIANT);
                if !own { continue; }
                let fl_v = ds.flags.as_slice()[v];
                if vk == decls.DK_VARIANT && fl_v & decls.F_TUPLE != 0 {
                    let ps = sg.params.row(v);
                    for k in 0..ps.len() {
                        let ft = sg.cx.tab.subst(ps[k], args.as_slice());
                        if ft == ERR || ft == NONE { continue; }
                        q_imp.push(i as% u32);
                        q_goal.push(tq.tr.goal_env(&sg.cx.tab, e, ft, cp, none.as_slice()));
                        q_f.push(v as% u32);
                        q_k.push(k as% u32);
                        q_ty.push(ft);
                    }
                    continue;
                }
                // a struct's field, or the fields of a record variant (in its item, after it)
                let it = ds.item.as_slice()[v];
                let mut f = v;
                while f < n && ds.item.as_slice()[f] == it {
                    let fd = f;
                    f = f + 1;
                    let leaf = if vk == decls.DK_FIELD then fd == v else ds.parent.as_slice()[fd] == v as% u32 && ds.kind.as_slice()[fd] == decls.DK_FIELD;
                    if !leaf { continue; }
                    let ft = sg.cx.tab.subst(sg.cx.ty.as_slice()[fd], args.as_slice());
                    if ft == ERR || ft == NONE { continue; }
                    q_imp.push(i as% u32);
                    q_goal.push(tq.tr.goal_env(&sg.cx.tab, e, ft, cp, none.as_slice()));
                    q_f.push(fd as% u32);
                    q_k.push(NONE);
                    q_ty.push(ft);
                    if vk == decls.DK_FIELD { break; }
                }
            }
        }
        for k in 0..tq.tr.lang.ops.len() {
            if tq.tr.lang.ops.as_slice()[k] != tr { continue; }
            q_imp.push(i as% u32);
            q_goal.push(tq.tr.goal_env(&sg.cx.tab, e, st, cp, none.as_slice()));
            q_f.push(NONE);
            q_k.push(k as% u32);
            q_ty.push(st);
        }
    }
    if q_imp.len() == 0 { return; }
    tq.solve(sg);
    let mut buf = vec.Vec::<u8>.new();
    let mut done = NONE;
    for x in 0..q_imp.len() {
        let i = q_imp.as_slice()[x];
        let g = q_goal.as_slice()[x];
        if !tq.tr.decided(g) || tq.tr.is(g) { continue; }
        let f = q_f.as_slice()[x];
        let self_text = &texts[t_lo[i as usize] as usize..t_lo[i as usize + 1] as usize];
        let (sf, ss, sz) = span_of(ds, md, lx, set, t, i);
        if f == NONE {
            // E0422 with the borrowing method that stands in for the operator
            let k = q_k.as_slice()[x] as usize;
            let tr = tq.tr.lang.ops.as_slice()[k];
            d.begin(422, "");
            buf.clear();
            decl_path(&mut buf, ds, md, nm, tr);
            d.arg("trait", buf.as_slice());
            d.arg("type", self_text);
            let mut call = vec.Vec::<u8>.new();
            diag_tc.op_forms(sg, ds, nm, tr, k, false, &mut buf, &mut call);
            d.arg("sig", buf.as_slice());
            d.arg("call", call.as_slice());
            d.end(sf, ss, sz);
            continue;
        }
        // E0415 for the first field that is not Copy
        if done == i { continue; }
        done = i;
        let k = q_k.as_slice()[x];
        let lo = sg.cx.gens.lo.as_slice()[i as usize];
        let hi = sg.cx.gens.lo.as_slice()[i as usize + 1];
        let sc = [0u32, 0u32, lo, hi];
        d.begin(415, "");
        d.arg("type", self_text);
        buf.clear();
        if k == NONE {
            buf.extend_from_slice(name_of(nm, ds, f));
        } else {
            text.push_u32(&mut buf, k);
        }
        d.arg("field", buf.as_slice());
        buf.clear();
        diag_sigs.display(&mut buf, sg, ds, nm, &sc, q_ty.as_slice()[x]);
        d.arg("field_type", buf.as_slice());
        if k == NONE {
            let (ff, fs, fz) = span_of(ds, md, lx, set, t, f);
            d.role("field", ff, fs, fz);
        } else {
            let (pf, ps, pz) = diag_tc.node_span(tree, lx, set, t, payload_type(tree, ds, f, k as usize));
            d.role("field", pf, ps, pz);
        }
        d.end(sf, ss, sz);
    }
}

// The node row of the k-th payload type of tuple variant v.
fn payload_type(tree: &ast.Ast, ds: &decls.Decls, v: u32, k: usize) -> u32 {
    let base = tree.item_node.as_slice()[ds.item.as_slice()[v as usize] as usize] as usize;
    let g = base + ds.node.as_slice()[v as usize] as usize;
    let ks = tree.kids.row(g);
    let mut j: usize = 0;
    for x in 0..ks.len() {
        let c = base + ks[x] as usize;
        if tree.kind.as_slice()[c] != node_kinds.KIND_TYPE { continue; }
        if j == k { return c as% u32; }
        j = j + 1;
    }
    return g as% u32;
}

fn check(d: &mut diag.Diags, tab: &mut types.Table, sg: &sigs.Sigs, ds: &decls.Decls, md: &modules.Modules, nm: &intern.Interned, fl: &files.FileList, lx: &lex.Lexer, set: &source.SourceSet, t: &lex.Tokens, tree: &ast.Ast, texts: &[u8], t_lo: &[u32], ok: &mut vec.Vec<u32>) {
    let n = ds.decls();
    let lang = traits.lang_items(fl, md, ds, nm);
    let im = traits.impls(sg, tab, ds);
    let (mk, mi) = by_parent(ds);
    let copy_k = im.trait_pos(lang.copy_tr);
    let mut seen = vec.Vec::<u32>.new();
    let mut free = vec.Vec::<u32>.new();
    let mut ms = vec.Vec::<u32>.new();
    let mut tms = vec.Vec::<u32>.new();
    let mut buf = vec.Vec::<u8>.new();
    for x in 0..n {
        if ds.kind.as_slice()[x] != decls.DK_IMPL || ds.item.as_slice()[x] == NONE { continue; }
        let i = x as% u32;
        let it = ds.item.as_slice()[x];
        let st = sg.cx.ty.as_slice()[x];
        let lo = sg.cx.gens.lo.as_slice()[x] as usize;
        let hi = sg.cx.gens.lo.as_slice()[x + 1] as usize;
        let self_text = &texts[t_lo[x] as usize..t_lo[x + 1] as usize];
        let (f, s, z) = span_of(ds, md, lx, set, t, i);
        // E0421: a use of the impl binds its params from the self type alone
        unbound_params(tab, st, hi - lo, &mut free);
        if free.len() > 0 {
            for k in 0..free.len() {
                let r = lo + free.as_slice()[k] as usize;
                d.begin(421, "");
                d.arg("param", nm.tab.text(sg.cx.gens.name.as_slice()[r] as usize));
                d.arg("type", self_text);
                let (pf, ps, pz) = diag_tc.gparam_span(sg, tree, lx, set, t, it, r);
                d.role("param", pf, ps, pz);
                d.end(f, s, z);
            }
            continue;
        }
        let tr = im.trait_of.as_slice()[x];
        if tr == NONE {
            if incoherent(tab, sg, ds, md, &lang, i, NONE) {
                d.begin(420, "inherent");
                d.arg("type", self_text);
                d.end(f, s, z);
            }
            continue;
        }
        // E1408: Flat and Frozen come from the type's structure only
        if tr == lang.flat || tr == lang.frozen {
            d.begin(1408, "");
            d.arg("trait", mem.str_bytes(if tr == lang.flat then "Flat" else "Frozen"));
            d.arg("type", self_text);
            d.end(f, s, z);
            continue;
        }
        if ds.kind.as_slice()[tr as usize] != decls.DK_TRAIT { continue; }
        buf.clear();
        decl_path(&mut buf, ds, md, nm, tr);
        let tpath = buf.as_slice();
        if tr != lang.drop && incoherent(tab, sg, ds, md, &lang, i, tr) {
            d.begin(420, "");
            d.arg("trait", tpath);
            d.arg("type", self_text);
            d.end(f, s, z);
            continue;
        }
        // E0810: an unsafe trait is implemented only by an `unsafe("..") impl`
        if ds.flags.as_slice()[tr as usize] & decls.F_UNSAFE != 0 && ds.flags.as_slice()[x] & decls.F_UNSAFE == 0 {
            d.begin(810, "");
            d.arg("trait", tpath);
            let (rf, rs, rz) = span_of(ds, md, lx, set, t, tr);
            d.role("trait", rf, rs, rz);
            d.end(f, s, z);
        }
        ok.push(i);
        members_of(mk.as_slice(), mi.as_slice(), i, decls.DK_METHOD, ds, &mut ms);
        members_of(mk.as_slice(), mi.as_slice(), tr, decls.DK_TRAIT_METHOD, ds, &mut tms);
        // E0907: `pub` on a trait impl method
        for j in 0..ms.len() {
            let m = ms.as_slice()[j];
            if ds.flags.as_slice()[m as usize] & decls.F_PUB == 0 { continue; }
            let p = pub_token(tree, t, ds, m);
            if p == NONE { continue; }
            let (af, as_, az) = modules.tok_span(lx, set, t, p);
            let next = t.start.as_slice()[p as usize + 1];
            let cut = if next > as_ && next - as_ > az then next - as_ else az;
            d.begin(907, "");
            d.arg("name", name_of(nm, ds, m));
            d.role("cut", af, as_, cut);
            d.end(af, as_, az);
        }
        // E0906: a trait method the impl lacks, a method the trait lacks; E0905: a method whose
        // signature differs from the trait method's
        for j in 0..tms.len() {
            let tm = tms.as_slice()[j];
            let mut found = NONE;
            for q in 0..ms.len() {
                if found == NONE && ds.name.as_slice()[ms.as_slice()[q] as usize] == ds.name.as_slice()[tm as usize] { found = ms.as_slice()[q]; }
            }
            if found != NONE {
                if !sig_matches(tab, sg, i, tm, found) {
                    d.begin(905, "");
                    d.arg("name", name_of(nm, ds, found));
                    d.arg("signature", trait_sig_text(tree, lx, set, t, ds, tm));
                    let (rf, rs, rz) = span_of(ds, md, lx, set, t, tm);
                    d.role("trait", rf, rs, rz);
                    let (mf, mst, mz) = span_of(ds, md, lx, set, t, found);
                    d.end(mf, mst, mz);
                }
                continue;
            }
            d.begin(906, "");
            d.arg("name", name_of(nm, ds, tm));
            d.arg("trait", tpath);
            let (rf, rs, rz) = span_of(ds, md, lx, set, t, tm);
            d.role("trait", rf, rs, rz);
            d.end(f, s, z);
        }
        for j in 0..ms.len() {
            let m = ms.as_slice()[j];
            let mut found = false;
            for q in 0..tms.len() {
                if ds.name.as_slice()[tms.as_slice()[q] as usize] == ds.name.as_slice()[m as usize] { found = true; }
            }
            if found { continue; }
            d.begin(906, "extra");
            d.arg("name", name_of(nm, ds, m));
            d.arg("trait", tpath);
            let (mf, mst, mz) = span_of(ds, md, lx, set, t, m);
            d.end(mf, mst, mz);
        }
        // E0419: a `Drop` impl's self type is a struct or enum of its package; E0416: no
        // instance of its head may be Copy (a Copy impl whose head unifies with it)
        if tr == lang.drop && lang.drop != NONE && st != ERR {
            let own = tab.tag_of(st) == types.TK_ADT && pkg_of(ds, md, tab.a_of(st)) == pkg_of(ds, md, i);
            if !own {
                d.begin(419, "");
                d.arg("type", self_text);
                d.end(f, s, z);
                continue;
            }
            if copy_k != NONE {
                let mut cs = vec.Vec::<u32>.new();
                cs.extend_from_slice(im.of(copy_k));
                for j in 0..cs.len() {
                    let ci = cs.as_slice()[j];
                    if sg.cx.ty.as_slice()[ci as usize] == ERR || !heads_unify(tab, sg, i, ci, false) { continue; }
                    d.begin(416, "");
                    d.arg("type", self_text);
                    let (cf, cst, cz) = span_of(ds, md, lx, set, t, ci);
                    d.role("copy", cf, cst, cz);
                    d.end(f, s, z);
                    break;
                }
            }
        }
        // E0414 case `drop`: the impl takes a view wherever its ADT does
        if tr == lang.drop && lang.drop != NONE && st != ERR && tab.tag_of(st) == types.TK_ADT {
            drop_views(d, tab, sg, ds, md, nm, lx, set, t, tree, i, self_text, f, s, z);
        }
        // E0903: an operator impl beside the built-in one, or two impls whose heads unify
        let mut op = false;
        for k in 0..lang.ops.len() {
            if lang.ops.as_slice()[k] == tr && st != ERR && traits.builtin_op(tab, k, st) { op = true; }
        }
        if op {
            d.begin(903, "");
            d.arg("trait", tpath);
            d.arg("type", self_text);
            d.end(f, s, z);
            continue;
        }
        let h = im.head_of.as_slice()[x];
        for j in 0..seen.len() {
            let o = seen.as_slice()[j];
            if im.trait_of.as_slice()[o as usize] != tr { continue; }
            let oh = im.head_of.as_slice()[o as usize];
            if h != traits.H_NONE && oh != traits.H_NONE && oh != h { continue; }
            if sg.cx.ty.as_slice()[o as usize] == ERR || st == ERR { continue; }
            if !heads_unify(tab, sg, o, i, true) { continue; }
            d.begin(903, "");
            d.arg("trait", tpath);
            d.arg("type", self_text);
            let (of, ost, oz) = span_of(ds, md, lx, set, t, o);
            d.role("other", of, ost, oz);
            d.end(f, s, z);
            break;
        }
        seen.push(i);
    }
}

// E0414 case `drop` for Drop impl i of an ADT instance: each param of the impl without `view`
// that occurs in a type argument the ADT's own param with `view` takes, in param order.
fn drop_views(d: &mut diag.Diags, tab: &types.Table, sg: &sigs.Sigs, ds: &decls.Decls, md: &modules.Modules, nm: &intern.Interned, lx: &lex.Lexer, set: &source.SourceSet, t: &lex.Tokens, tree: &ast.Ast, i: u32, self_text: &[u8], f: u32, s: u32, z: u32) {
    let st = sg.cx.ty.as_slice()[i as usize];
    let def = tab.a_of(st);
    let alo = sg.cx.gens.lo.as_slice()[def as usize] as usize;
    let ahi = sg.cx.gens.lo.as_slice()[def as usize + 1] as usize;
    let ilo = sg.cx.gens.lo.as_slice()[i as usize] as usize;
    let ihi = sg.cx.gens.lo.as_slice()[i as usize + 1] as usize;
    let mut named = col.filled(ihi - ilo, false);
    let xs = tab.x(st);
    let mut stack = vec.Vec::<u32>.new();
    let mut kids = vec.Vec::<u32>.new();
    let mut k: usize = 0;
    while k + 2 < xs.len() {
        let ai = k / 3;
        if xs[k] == types.GA_TYPE && ai < ahi - alo && sg.cx.gens.is_view.as_slice()[alo + ai] {
            stack.push(xs[k + 1]);
            while stack.len() > 0 {
                let y = stack.as_slice()[stack.len() - 1];
                stack.truncate(stack.len() - 1);
                if tab.tag_of(y) == types.TK_PARAM {
                    let p = tab.a_of(y) as usize;
                    if p < ihi - ilo && !sg.cx.gens.is_view.as_slice()[ilo + p] { named.as_mut_slice()[p] = true; }
                    continue;
                }
                tab.kids(y, &mut kids);
                stack.extend_from_slice(kids.as_slice());
            }
        }
        k = k + 3;
    }
    let it = ds.item.as_slice()[i as usize];
    let mut path = vec.Vec::<u8>.new();
    decl_path(&mut path, ds, md, nm, def);
    for p in 0..named.len() {
        if !named.as_slice()[p] { continue; }
        d.begin(414, "drop");
        d.arg("param", nm.tab.text(sg.cx.gens.name.as_slice()[ilo + p] as usize));
        d.arg("type", self_text);
        d.arg("generic", path.as_slice());
        let (pf, ps, pz) = diag_tc.gparam_span(sg, tree, lx, set, t, it, ilo + p);
        d.role("param", pf, ps, pz);
        d.end(f, s, z);
    }
}

// E0413 case `drop`: a `const` whose type has drop glue (the kinds' `drop` flag) and holds no
// reference or view, of a checked item (a const is a new copy at each use, so a destructor
// would run at each use). `order` is the printed types the kinds are of.
pub fn const_drops(d: &mut diag.Diags, kd: &kinds.Kinds, order: &[u32], sg: &sigs.Sigs, ds: &decls.Decls, nm: &intern.Interned, lx: &lex.Lexer, set: &source.SourceSet, t: &lex.Tokens, tree: &ast.Ast) {
    let mut keys = vec.Vec::<u64>.new();
    for k in 0..order.len() {
        keys.push(search.pair(order[k], k as% u32));
    }
    let perm = sort.sort_perm(keys.as_slice());
    let mut sk = vec.Vec::<u64>.new();
    for j in 0..perm.len() {
        sk.push(keys.as_slice()[perm.as_slice()[j] as usize]);
    }
    let mut buf = vec.Vec::<u8>.new();
    for c in 0..ds.decls() {
        if ds.kind.as_slice()[c] != decls.DK_CONST { continue; }
        let it = ds.item.as_slice()[c];
        let n = ds.node.as_slice()[c];
        if it == NONE || n == NONE || !tree.ok(it as usize) { continue; }
        let ty = sg.cx.ty.as_slice()[c];
        if ty == ERR || sigs.is_view_in(&sg.cx, ds, ty, consteval.no_scope()) { continue; }
        let x = search.lower_bound(sk.as_slice(), search.pair(ty, 0));
        if x == sk.len() || (sk.as_slice()[x] >> 32) as% u32 != ty { continue; }
        let k = (sk.as_slice()[x] & 0xffff_ffff) as usize;
        if kd.bits.as_slice()[k] & kinds.K_DROP == 0 { continue; }
        let base = tree.item_node.as_slice()[it as usize] as usize;
        let tn = consteval.child(tree, base, base + n as usize, node_kinds.KIND_TYPE);
        if tn == NONE { continue; }
        d.begin(413, "drop");
        d.arg("name", nm.tab.text(ds.name.as_slice()[c] as usize));
        buf.clear();
        let ns = consteval.no_scope();
        diag_sigs.display(&mut buf, sg, ds, nm, &[ns.par_lo, ns.par_hi, ns.own_lo, ns.own_hi], ty);
        d.arg("type", buf.as_slice());
        let a = tree.tok.as_slice()[tn as usize];
        let e = tree.tok_end.as_slice()[tn as usize];
        let (f, s, _) = modules.tok_span(lx, set, t, a);
        let (_, s2, z2) = modules.tok_span(lx, set, t, if e > a then e - 1 else a);
        d.end(f, s, s2 + z2 - s);
    }
}

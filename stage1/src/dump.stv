// Stage dumps (contracts/stage-gates.md), stage0's bytes.
//
// `tokens`: one line `F O KIND` per token, by (F, O); KIND is the terminal's name or spelling,
// `ERROR` for an error token. `EOF` has no line.
//
// `items`: one line `I F O_start O_end ok|dropped` per item, by I; `ok` is the parser's verdict.
//
// `ast`: one line `I N KIND a b` per node of every item not dropped, by (I, N): KIND is the rule
// name, `a` the node's first token as an index into its file's tokens, `b` its subtree size.
//
// `names`: one line `I N -> decl D` or `I N -> local I N2` per resolving identifier use, by
// (I, N), then by the identifier's byte offset.
//
// `strings`: one line `S hash32 "escaped-bytes"` per interned string, by S: the hash as 8
// lowercase hex digits, the bytes 0x20..0x7E as themselves except `\` and `"` (backslash
// escaped), `\n`, `\t`, and `\xHH` for every other byte.
//
// `diags`: one JSON line per diagnostic, in canonical order.
//
// `sigs`: the signature type table, then one line per decl (`sigs_txt`).
import ast;
import files;
import generated.ll1_table;
import diag;
import decls;
import diag_out;
import intern;
import items;
import lex;
import modules;
import resolve;
import sigs;
import source;
import text;
import types;
import std.mem;
import std.vec;

pub fn tokens(lx: &lex.Lexer, t: &lex.Tokens) -> vec.Vec<u8> {
    let mut buf = vec.Vec::<u8>.with_capacity(t.kind.len() * 12);
    let kind = t.kind.as_slice();
    let start = t.start.as_slice();
    let ft = t.file_tok.as_slice();
    for f in 0..t.files() {
        let lo = ft[f] as usize;
        let hi = ft[f + 1] as usize;
        for i in lo..hi {
            if kind[i] == lex.T_EOF { continue; }
            text.push_u32(&mut buf, f as% u32);
            buf.push(32);
            text.push_u32(&mut buf, start[i]);
            buf.push(32);
            buf.extend_from_slice(lx.kind_name(kind[i]));
            buf.push(10);
        }
    }
    return buf;
}

pub fn items_txt(it: &items.Items, tree: &ast.Ast) -> vec.Vec<u8> {
    let n = it.len();
    let mut buf = vec.Vec::<u8>.with_capacity(n * 24);
    let file = it.file.as_slice();
    let off_start = it.off_start.as_slice();
    let off_end = it.off_end.as_slice();
    for i in 0..n {
        text.push_u32(&mut buf, i as% u32);
        buf.push(32);
        text.push_u32(&mut buf, file[i]);
        buf.push(32);
        text.push_u32(&mut buf, off_start[i]);
        buf.push(32);
        text.push_u32(&mut buf, off_end[i]);
        buf.extend_from_slice(if tree.ok(i) then mem.str_bytes(" ok\n") else mem.str_bytes(" dropped\n"));
    }
    return buf;
}

pub fn ast_txt(it: &items.Items, tree: &ast.Ast, t: &lex.Tokens) -> vec.Vec<u8> {
    let mut name_off = vec.Vec::<u32>.new();
    name_off.extend_from_slice(&ll1_table.NT_NAME_OFF);
    let mut names = vec.Vec::<u8>.new();
    names.extend_from_slice(&ll1_table.NT_NAME);
    let no = name_off.as_slice();
    let nm = names.as_slice();
    let mut buf = vec.Vec::<u8>.with_capacity(tree.nodes() * 24);
    let file = it.file.as_slice();
    let ft = t.file_tok.as_slice();
    let inode = tree.item_node.as_slice();
    let kind = tree.kind.as_slice();
    let tok = tree.tok.as_slice();
    let size = tree.size.as_slice();
    for i in 0..tree.items() {
        let lo = inode[i] as usize;
        let hi = inode[i + 1] as usize;
        let f0 = ft[file[i] as usize];
        for g in lo..hi {
            let k = kind[g] as usize;
            text.push_u32(&mut buf, i as% u32);
            buf.push(32);
            text.push_u32(&mut buf, (g - lo) as% u32);
            buf.push(32);
            buf.extend_from_slice(&nm[no[k] as usize..no[k + 1] as usize]);
            buf.push(32);
            text.push_u32(&mut buf, tok[g] - f0);
            buf.push(32);
            text.push_u32(&mut buf, size[g]);
            buf.push(10);
        }
    }
    return buf;
}

fn push_escaped(buf: &mut vec.Vec<u8>, b: &[u8]) {
    let hex = mem.str_bytes("0123456789abcdef");
    for i in 0..b.len() {
        let c = b[i];
        if c == 92 || c == 34 {
            buf.push(92);
            buf.push(c);
        } else if c == 10 {
            buf.push(92);
            buf.push(110);
        } else if c == 9 {
            buf.push(92);
            buf.push(116);
        } else if c >= 32 && c <= 126 {
            buf.push(c);
        } else {
            buf.push(92);
            buf.push(120);
            buf.push(hex[(c >> 4) as usize]);
            buf.push(hex[(c & 15) as usize]);
        }
    }
}

pub fn strings_txt(tab: &intern.Table) -> vec.Vec<u8> {
    let n = tab.len();
    let mut buf = vec.Vec::<u8>.with_capacity(tab.str_bytes.len() + n * 20);
    let hex = mem.str_bytes("0123456789abcdef");
    for s in 0..n {
        text.push_u32(&mut buf, s as% u32);
        buf.push(32);
        let h = tab.str_hash.as_slice()[s];
        for k in 0..8u32 {
            buf.push(hex[((h >> ((7 - k) * 4)) & 15) as usize]);
        }
        buf.push(32);
        buf.push(34);
        push_escaped(&mut buf, tab.text(s));
        buf.push(34);
        buf.push(10);
    }
    return buf;
}

pub fn names_txt(r: &resolve.Names) -> vec.Vec<u8> {
    let n = r.len();
    let mut buf = vec.Vec::<u8>.with_capacity(n * 20);
    for k in 0..n {
        let i = r.item.as_slice()[k];
        text.push_u32(&mut buf, i);
        buf.push(32);
        text.push_u32(&mut buf, r.node.as_slice()[k]);
        if r.tag.as_slice()[k] == resolve.TAG_LOCAL {
            buf.extend_from_slice(mem.str_bytes(" -> local "));
            text.push_u32(&mut buf, i);
            buf.push(32);
        } else {
            buf.extend_from_slice(mem.str_bytes(" -> decl "));
        }
        text.push_u32(&mut buf, r.target.as_slice()[k]);
        buf.push(10);
    }
    return buf;
}

pub fn diags(d: &diag.Diags, rows: &[u32], ft: &diag_out.FileTable, set: &source.SourceSet) -> vec.Vec<u8> {
    return diag_out.render(d, rows, ft, set, true);
}

// `sigs`: the type table of the types the decl lines name (and their components), `t<T> key`
// by T, T the canonical rank among them; then one line per decl, by D (contracts/stage-gates.md).
pub fn sigs_txt(sg: &sigs.Sigs, ds: &decls.Decls, md: &modules.Modules) -> vec.Vec<u8> {
    let n = ds.decls();
    let mut roots = vec.Vec::<u32>.new();
    for d in 0..n {
        sig_roots(sg, ds, d, &mut roots);
    }
    let (num, order) = sg.cx.tab.rank(roots.as_slice());
    let mut buf = vec.Vec::<u8>.with_capacity(n * 80 + order.len() * 24);
    let nt = order.len() as% u32;
    for k in 0..order.len() {
        buf.push(116);
        text.push_u32(&mut buf, k as% u32);
        buf.push(32);
        key_text(&mut buf, &sg.cx.tab, order.as_slice()[k], num.as_slice(), nt);
        buf.push(10);
    }
    for d in 0..n {
        decl_line(&mut buf, sg, ds, md, d, num.as_slice(), nt);
    }
    return buf;
}

fn push_ty(buf: &mut vec.Vec<u8>, t: u32, num: &[u32], nt: u32) {
    if t == types.ERR || t == types.NONE {
        buf.push(45);
        return;
    }
    buf.push(116);
    let v = num[t as usize];
    text.push_u32(buf, if v == types.NONE then nt else v);
}

fn push_str(buf: &mut vec.Vec<u8>, s: &str) {
    buf.extend_from_slice(mem.str_bytes(s));
}

// A const argument (3 words): the value, `constparam i`, or `_`.
fn push_carg(buf: &mut vec.Vec<u8>, k: u32, x: u32, y: u32) {
    if k == types.GA_VALUE {
        text.push_u64(buf, ((x as u64) << 32) | (y as u64));
    } else if k == types.GA_PARAM {
        push_str(buf, "constparam ");
        text.push_u32(buf, x);
    } else {
        buf.push(95);
    }
}

fn push_gargs(buf: &mut vec.Vec<u8>, xs: &[u32], num: &[u32], nt: u32) {
    let mut k: usize = 0;
    while k + 2 < xs.len() {
        buf.push(32);
        if xs[k] == types.GA_TYPE {
            push_ty(buf, xs[k + 1], num, nt);
        } else {
            push_carg(buf, xs[k], xs[k + 1], xs[k + 2]);
        }
        k = k + 3;
    }
}

fn push_lanes(buf: &mut vec.Vec<u8>, l: u32) {
    if l == types.LANES_N {
        buf.push(110);
    } else {
        text.push_u32(buf, l);
    }
}

// The checked-IR `TypeKey` text of type t, components numbered by `num`.
fn key_text(buf: &mut vec.Vec<u8>, tab: &types.Table, t: u32, num: &[u32], nt: u32) {
    let tag = tab.tag_of(t);
    let a = tab.a_of(t);
    let b = tab.b_of(t);
    let xs = tab.x(t);
    if tag == types.TK_INT {
        push_str(buf, if a == 1 then "int s " else "int u ");
        push_str(buf, if b == types.W_8 then "8" else if b == types.W_16 then "16" else if b == types.W_32 then "32" else if b == types.W_64 then "64" else "size");
    } else if tag == types.TK_FLOAT {
        push_str(buf, if a == 0 then "float 16" else if a == 1 then "float 32" else if a == 2 then "float 64" else "float b16");
    } else if tag == types.TK_BOOL {
        push_str(buf, "bool");
    } else if tag == types.TK_CHAR {
        push_str(buf, "char");
    } else if tag == types.TK_STR {
        push_str(buf, "str");
    } else if tag == types.TK_REF {
        push_str(buf, if a == 1 then "ref mut " else "ref ");
        push_ty(buf, b, num, nt);
    } else if tag == types.TK_PTR {
        push_str(buf, if a == 1 then "ptr mut " else "ptr const ");
        push_ty(buf, b, num, nt);
    } else if tag == types.TK_ARRAY {
        push_str(buf, "array ");
        push_ty(buf, a, num, nt);
        buf.push(32);
        push_carg(buf, xs[0], xs[1], xs[2]);
    } else if tag == types.TK_SLICE {
        push_str(buf, "slice ");
        push_ty(buf, a, num, nt);
        if b != 0 {
            push_str(buf, " align ");
            text.push_u32(buf, b);
        }
    } else if tag == types.TK_TUPLE {
        push_str(buf, "tuple");
        for k in 0..xs.len() {
            buf.push(32);
            push_ty(buf, xs[k], num, nt);
        }
    } else if tag == types.TK_ADT {
        push_str(buf, "adt d");
        text.push_u32(buf, a);
        push_gargs(buf, xs, num, nt);
    } else if tag == types.TK_FN {
        push_str(buf, "fntype");
        let np = a as usize;
        for k in 0..np {
            buf.push(32);
            push_ty(buf, xs[k], num, nt);
        }
        push_str(buf, " -> ");
        push_ty(buf, xs[np], num, nt);
        let feats = sigs.feature_maximal(((xs[np + 1] as u64) << 32) | (xs[np + 2] as u64));
        for f in 0..24usize {
            if (feats >> f as u64) & 1 == 1 {
                buf.push(32);
                sigs.push_feature(buf, f);
            }
        }
    } else if tag == types.TK_VECTOR {
        push_str(buf, "vec ");
        push_ty(buf, a, num, nt);
        buf.push(32);
        push_lanes(buf, b);
    } else if tag == types.TK_MASK {
        push_str(buf, "mask ");
        text.push_u32(buf, a);
        buf.push(32);
        push_lanes(buf, b);
    } else if tag == types.TK_PARAM {
        push_str(buf, "param ");
        text.push_u32(buf, a);
    } else if tag == types.TK_CONSTPARAM {
        push_str(buf, "constparam ");
        text.push_u32(buf, a);
    } else if tag == types.TK_NEVER {
        push_str(buf, "never");
    } else if tag == types.TK_RANGE {
        push_str(buf, if b == 1 then "range incl " else "range ");
        push_ty(buf, a, num, nt);
    } else if tag == types.TK_SELF {
        push_str(buf, "self");
    }
}

// The types decl d's line names.
fn sig_roots(sg: &sigs.Sigs, ds: &decls.Decls, d: usize, out: &mut vec.Vec<u32>) {
    let k = ds.kind.as_slice()[d];
    let built = sg.sflags.as_slice()[d] & sigs.SF_BUILT != 0;
    if has_gen(k) { gen_roots(sg, d, out); }
    if is_fn(k) && built {
        out.extend_from_slice(sg.params.row(d));
        out.push(sg.cx.ty.as_slice()[d]);
    } else if k == decls.DK_IMPL {
        out.push(sg.cx.ty.as_slice()[d]);
        let r = sg.trait_ref.as_slice()[d];
        if r != types.NONE { arg_roots(sg.b_args.row(r as usize), out); }
    } else if k == decls.DK_CONST || k == decls.DK_STATIC || k == decls.DK_TYPE_ALIAS || (k == decls.DK_FIELD && built) {
        out.push(sg.cx.ty.as_slice()[d]);
    } else if k == decls.DK_VARIANT && built {
        out.extend_from_slice(sg.params.row(d));
    }
}

fn arg_roots(xs: &[u32], out: &mut vec.Vec<u32>) {
    let mut k: usize = 0;
    while k + 2 < xs.len() {
        if xs[k] == types.GA_TYPE { out.push(xs[k + 1]); }
        k = k + 3;
    }
}

fn gen_roots(sg: &sigs.Sigs, d: usize, out: &mut vec.Vec<u32>) {
    let g = &sg.cx.gens;
    for r in g.lo.as_slice()[d] as usize..g.lo.as_slice()[d + 1] as usize {
        if g.is_const.as_slice()[r] { out.push(g.cty.as_slice()[r]); }
        let bs = sg.gp_bounds.row(r);
        for j in 0..bs.len() {
            arg_roots(sg.b_args.row(bs[j] as usize), out);
        }
    }
}

fn is_fn(k: u8) -> bool {
    return k == decls.DK_FN || k == decls.DK_METHOD || k == decls.DK_TRAIT_METHOD;
}

fn has_gen(k: u8) -> bool {
    return is_fn(k) || k == decls.DK_STRUCT || k == decls.DK_ENUM || k == decls.DK_TRAIT || k == decls.DK_IMPL || k == decls.DK_TYPE_ALIAS;
}

const DECL_KINDS: &str = "module fn struct enum trait const static alias impl field variant method trait-method error";
const FLAG_NAMES: &str = "pub unsafe view test kernel dispatch extern-import extern-export trait-impl tuple record has-self mut rec";

fn push_word(buf: &mut vec.Vec<u8>, words: &str, k: usize) {
    let (a, b) = sigs.word(words, k);
    buf.extend_from_slice(&mem.str_bytes(words)[a..b]);
}

fn push_opt(buf: &mut vec.Vec<u8>, v: u32) {
    buf.push(32);
    if v == types.NONE {
        buf.push(45);
    } else {
        text.push_u32(buf, v);
    }
}

fn push_trait_ref(buf: &mut vec.Vec<u8>, sg: &sigs.Sigs, r: u32, num: &[u32], nt: u32) {
    buf.push(100);
    text.push_u32(buf, sg.b_trait.as_slice()[r as usize]);
    push_gargs(buf, sg.b_args.row(r as usize), num, nt);
}

fn push_gen(buf: &mut vec.Vec<u8>, sg: &sigs.Sigs, d: usize, num: &[u32], nt: u32) {
    let g = &sg.cx.gens;
    push_str(buf, " gen[");
    let lo = g.lo.as_slice()[d] as usize;
    for r in lo..g.lo.as_slice()[d + 1] as usize {
        if r > lo { push_str(buf, ", "); }
        text.push_u32(buf, g.name.as_slice()[r]);
        buf.push(32);
        text.push_u32(buf, g.node.as_slice()[r]);
        if g.is_const.as_slice()[r] {
            push_str(buf, " const ");
            push_ty(buf, g.cty.as_slice()[r], num, nt);
        }
        if g.is_view.as_slice()[r] { push_str(buf, " view"); }
        let bs = sg.gp_bounds.row(r);
        for j in 0..bs.len() {
            push_str(buf, " bound ");
            push_trait_ref(buf, sg, bs[j], num, nt);
        }
    }
    buf.push(93);
}

fn push_tys(buf: &mut vec.Vec<u8>, ts: &[u32], num: &[u32], nt: u32) {
    buf.push(91);
    for k in 0..ts.len() {
        if k > 0 { buf.push(32); }
        push_ty(buf, ts[k], num, nt);
    }
    buf.push(93);
}

fn decl_line(buf: &mut vec.Vec<u8>, sg: &sigs.Sigs, ds: &decls.Decls, md: &modules.Modules, d: usize, num: &[u32], nt: u32) {
    let k = ds.kind.as_slice()[d];
    buf.push(100);
    text.push_u32(buf, d as% u32);
    buf.push(32);
    push_word(buf, DECL_KINDS, k as usize);
    let m = ds.module.as_slice()[d];
    push_str(buf, " ");
    let md_d = if m == types.NONE then types.NONE else ds.mod_decl.as_slice()[m as usize];
    if md_d == types.NONE {
        buf.push(45);
    } else {
        buf.push(100);
        text.push_u32(buf, md_d);
    }
    buf.push(32);
    let p = ds.parent.as_slice()[d];
    if p == types.NONE {
        buf.push(45);
    } else {
        buf.push(100);
        text.push_u32(buf, p);
    }
    push_opt(buf, ds.name.as_slice()[d]);
    push_opt(buf, ds.item.as_slice()[d]);
    push_opt(buf, ds.node.as_slice()[d]);
    buf.push(32);
    text.push_u32(buf, ds.index.as_slice()[d]);
    buf.push(32);
    let fl = ds.flags.as_slice()[d];
    let mut any = false;
    for b in 0..14usize {
        if (fl >> b as% u16) & 1 == 1 {
            if any { buf.push(44); }
            push_word(buf, FLAG_NAMES, b);
            any = true;
        }
    }
    if !any { buf.push(45); }
    let built = sg.sflags.as_slice()[d] & sigs.SF_BUILT != 0;
    if is_fn(k) {
        if built {
            let sf = sg.sflags.as_slice()[d];
            push_gen(buf, sg, d, num, nt);
            push_str(buf, " params");
            push_tys(buf, sg.params.row(d), num, nt);
            push_str(buf, " ret ");
            push_ty(buf, sg.cx.ty.as_slice()[d], num, nt);
            let sk = sf & sigs.SF_SELF_MASK;
            push_str(buf, if sk == 0 then " self -" else if sk == sigs.SF_SELF_VALUE then " self value" else if sk == sigs.SF_SELF_REF then " self ref" else " self ref-mut");
            push_str(buf, if sf & sigs.SF_ABI_INTRINSIC != 0 then " abi intrinsic" else if sf & sigs.SF_ABI_C != 0 then " abi c" else " abi stave");
            if sf & sigs.SF_UNSAFE != 0 { push_str(buf, " unsafe"); }
            if sf & sigs.SF_VARIADIC != 0 { push_str(buf, " variadic"); }
            push_str(buf, " needs[");
            let feats = sigs.feature_maximal(sg.feats.as_slice()[d]);
            let mut first = true;
            for f in 0..24usize {
                if (feats >> f as u64) & 1 == 1 {
                    if !first { buf.push(32); }
                    sigs.push_feature(buf, f);
                    first = false;
                }
            }
            push_str(buf, "] deny[");
            let dn = sg.deny.as_slice()[d];
            first = true;
            for e in 0..8usize {
                if (dn >> e as% u8) & 1 == 1 {
                    if !first { buf.push(32); }
                    sigs.push_effect(buf, e);
                    first = false;
                }
            }
            push_str(buf, "] from[");
            let ro = sg.rfrom.row(d);
            for j in 0..ro.len() {
                if j > 0 { push_str(buf, ", "); }
                if ro[j] >> 8 == 1 { push_str(buf, "copy "); }
                text.push_u32(buf, ro[j] & 255);
            }
            push_str(buf, "] pfrom[");
            let po = sg.pfrom.row(d);
            for j in 0..po.len() {
                if j > 0 { push_str(buf, ", "); }
                text.push_u32(buf, po[j] >> 16);
                buf.push(60);
                if po[j] & 1 == 1 { push_str(buf, "copy "); }
                text.push_u32(buf, (po[j] >> 8) & 255);
            }
            buf.push(93);
        }
    } else if k == decls.DK_STRUCT || k == decls.DK_ENUM || k == decls.DK_TRAIT {
        push_gen(buf, sg, d, num, nt);
    } else if k == decls.DK_IMPL {
        push_gen(buf, sg, d, num, nt);
        push_str(buf, " self ");
        push_ty(buf, sg.cx.ty.as_slice()[d], num, nt);
        push_str(buf, " trait ");
        let r = sg.trait_ref.as_slice()[d];
        if r == types.NONE {
            buf.push(45);
        } else {
            push_trait_ref(buf, sg, r, num, nt);
        }
    } else if k == decls.DK_CONST || k == decls.DK_STATIC {
        push_str(buf, " ty ");
        push_ty(buf, sg.cx.ty.as_slice()[d], num, nt);
    } else if k == decls.DK_TYPE_ALIAS {
        push_gen(buf, sg, d, num, nt);
        push_str(buf, " target ");
        push_ty(buf, sg.cx.ty.as_slice()[d], num, nt);
    } else if k == decls.DK_FIELD {
        if built {
            push_str(buf, " ty ");
            push_ty(buf, sg.cx.ty.as_slice()[d], num, nt);
        }
    } else if k == decls.DK_VARIANT {
        if built {
            push_str(buf, " payload");
            push_tys(buf, sg.params.row(d), num, nt);
        }
    } else if k == decls.DK_MODULE {
        if m != types.NONE {
            push_str(buf, " file ");
            text.push_u32(buf, md.mod_file.as_slice()[m as usize]);
            push_str(buf, " path[");
            let ps = md.path(m as usize);
            for j in 0..ps.len() {
                if j > 0 { buf.push(32); }
                text.push_u32(buf, ps[j]);
            }
            buf.push(93);
        }
    }
    buf.push(10);
}

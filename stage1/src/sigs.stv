const T_L_PAREN: u8 = terminals.T_L_PAREN as% u8;
const T_L_BRACKET: u8 = terminals.T_L_BRACKET as% u8;
const T_COMMA: u8 = terminals.T_COMMA as% u8;
const T_DOT: u8 = terminals.T_DOT as% u8;
const T_DOT_DOT_DOT: u8 = terminals.T_DOT_DOT_DOT as% u8;
const T_MINUS_GT: u8 = terminals.T_MINUS_GT as% u8;
const T_KW_MUT: u8 = terminals.T_KW_MUT as% u8;
const T_KW_FN: u8 = terminals.T_KW_FN as% u8;
const T_KW_SELF_TYPE: u8 = terminals.T_KW_SELF_TYPE as% u8;
const T_KW_ALIGN: u8 = terminals.T_KW_ALIGN as% u8;
const T_KW_COPY: u8 = terminals.T_KW_COPY as% u8;
const T_KW_CONST: u8 = terminals.T_KW_CONST as% u8;
const T_KW_VIEW: u8 = terminals.T_KW_VIEW as% u8;
const T_KW_SELF: u8 = terminals.T_KW_SELF as% u8;
const T_KW_PUB: u8 = terminals.T_KW_PUB as% u8;
const T_LT: u8 = terminals.T_LT as% u8;
const T_GT: u8 = terminals.T_GT as% u8;
const T_GT_EQ: u8 = terminals.T_GT_EQ as% u8;
const T_GT_GT: u8 = terminals.T_GT_GT as% u8;
const T_GT_GT_EQ: u8 = terminals.T_GT_GT_EQ as% u8;
const T_EOF: u8 = terminals.T_EOF as% u8;
const T_R_PAREN: u8 = terminals.T_R_PAREN as% u8;
const T_R_BRACKET: u8 = terminals.T_R_BRACKET as% u8;
const T_L_BRACE: u8 = terminals.T_L_BRACE as% u8;
const T_R_BRACE: u8 = terminals.T_R_BRACE as% u8;
const T_DOT_L_BRACE: u8 = terminals.T_DOT_L_BRACE as% u8;

const K_TYPE: u8 = node_kinds.KIND_TYPE;
const K_TYPE_BASE: u8 = node_kinds.KIND_TYPE_BASE;
const K_GENERIC_ARGS: u8 = node_kinds.KIND_GENERIC_ARGS;
const K_GENERIC_ARG: u8 = node_kinds.KIND_GENERIC_ARG;
const K_GENERIC_PARAM: u8 = node_kinds.KIND_GENERIC_PARAM;
const K_GENERICS: u8 = node_kinds.KIND_GENERICS;
const K_ARR_OR_IDX: u8 = node_kinds.KIND_ARR_OR_IDX;
const K_NEEDS: u8 = node_kinds.KIND_NEEDS;
const K_WITHOUT: u8 = node_kinds.KIND_WITHOUT;
const K_BOUND: u8 = node_kinds.KIND_BOUND;
const K_PARAMS: u8 = node_kinds.KIND_PARAMS;
const K_PARAM: u8 = node_kinds.KIND_PARAM;
const K_X_PARAMS: u8 = node_kinds.KIND_X_PARAMS;
const K_SELF_PARAM: u8 = node_kinds.KIND_SELF_PARAM;
const K_RET_CLAUSE: u8 = node_kinds.KIND_RET_CLAUSE;

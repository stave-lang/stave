// Signatures (types/sigs): every declaration's signature facts, built from the syntax and the
// resolutions alone, before any body: generic params with their const types and bounds, fn
// signatures (params, return, `self`, ABI, needs, deny clause, `from` origins), field and payload
// types, impl headers, alias targets, const and static types. The types are rows of the type
// table (`types`); const values come from `consteval`.
//
// Passes, each over whole columns (the order is the dependency order of the facts):
// 1. generic params: one row per `GenericParam` of each decl's own list, by D;
// 2. the declared type of each const param;
// 3. aliases, consts, and statics in dependency rounds (an alias target or a const's type may
//    name another alias or const; a const's value may use other consts); what a cycle leaves
//    has no value (consts) or the error type (aliases);
// 4. impl self types and traits;
// 5. bounds of every generic param (`Self` is the impl's self type, or a trait's `Self`);
// 6. fn signatures, field types, and variant payloads, by D.
// A written type is lowered with an explicit stack over its nodes (`lower`): a frame per node
// to visit and one per node to finish from its components' results.
import ast;
import consteval;
import decls;
import files;
import generated.node_kinds;
import generated.terminals;
import intern;
import items;
import lex;
import modules;
import resolve;
import source;
import types;
import prims.col;
import prims.ragged;
import prims.search;
import std.mem;
import std.vec;

pub const NONE: u32 = 4294967295;
const ERR: u32 = types.ERR;

// Fn signature flags.
pub const SF_SELF_MASK: u16 = 3;
pub const SF_SELF_VALUE: u16 = 1;
pub const SF_SELF_REF: u16 = 2;
pub const SF_SELF_MUT: u16 = 3;
pub const SF_ABI_C: u16 = 4;
pub const SF_ABI_INTRINSIC: u16 = 8;
pub const SF_UNSAFE: u16 = 16;
pub const SF_VARIADIC: u16 = 32;
pub const SF_BUILT: u16 = 64;

const T_IDENT: u8 = terminals.T_IDENT as% u8;
const T_INT_LIT: u8 = terminals.T_INT_LIT as% u8;
const T_STR_LIT: u8 = terminals.T_STR_LIT as% u8;
const T_AMP: u8 = terminals.T_AMP as% u8;
const T_AMP_AMP: u8 = terminals.T_AMP_AMP as% u8;

// diag: the canonical order, duplicate removal, and template expansion.
import diag;
import diag_reg;
import text;
import std.debug;
import std.idx;
import std.mem;
import std.vec;

fn bad_char(d: &mut diag.Diags, f: u32, at: u32) {
    d.begin(18, "");
    d.end(f, at, 1);
}

fn bad_hole(d: &mut diag.Diags, f: u32, at: u32, size: u32, hole: &str) {
    d.begin(6, "");
    d.arg("hole", mem.str_bytes(hole));
    d.end(f, at, size);
}

fn same(rows: &[u32], want: &[u32], what: &str) {
    debug.assert(rows.eq(want), what);
}

test fn order_by_file_offset_code() {
    let mut d = diag.Diags.new();
    bad_char(&mut d, 1, 5);
    bad_char(&mut d, 0, 9);
    d.begin(17, "");
    d.end(0, 9, 3);
    bad_char(&mut d, 0, 2);
    let rank = [0u32, 1];
    same(d.order(&rank[0..2]).as_slice(), &[3u32, 2, 1, 0], "files in rank order, then offset, then code");
    let swapped = [1u32, 0];
    same(d.order(&swapped[0..2]).as_slice(), &[0u32, 3, 2, 1], "the file key is the rank, not the file number");
}

test fn no_location_first() {
    let mut d = diag.Diags.new();
    bad_char(&mut d, 0, 0);
    d.begin(1001, "");
    d.arg("target", mem.str_bytes("aarch64-linux"));
    d.end(idx.NONE, 0, 0);
    let rank = [0u32];
    same(d.order(&rank[0..1]).as_slice(), &[1u32, 0], "a location-less diagnostic sorts first");
}

test fn empty() {
    let d = diag.Diags.new();
    let rank = [0u32];
    debug.assert(d.order(&rank[0..1]).len() == 0, "no rows, no order");
}

test fn ties_compare_messages_and_drop_duplicates() {
    let mut d = diag.Diags.new();
    bad_hole(&mut d, 0, 4, 5, "b");
    bad_hole(&mut d, 0, 4, 5, "a");
    bad_hole(&mut d, 0, 4, 5, "b");
    bad_hole(&mut d, 0, 4, 9, "a");
    bad_hole(&mut d, 0, 4, 5, "ab");
    let rank = [0u32];
    // by message "{ab}" < "{a}" < "{b}" (a byte past the end is below any byte, `}` is above
    // `b`); of the equal messages the shorter span is kept (row 1, not row 3)
    same(d.order(&rank[0..1]).as_slice(), &[4u32, 1, 0], "ties: message order, duplicates dropped");
}

test fn message_collapses_source_whitespace() {
    let mut d = diag.Diags.new();
    bad_hole(&mut d, 0, 0, 3, "  a \n\t b  ");
    let mut m = vec.Vec::<u8>.new();
    d.message(0, &mut m);
    debug.assert(text.eq_str(m.as_slice(), "f-string hole `{a b}` is not a name or field path"), "the hole is on one line");
}

test fn ranks_are_byte_order_with_ties_by_position() {
    let mut s = diag_reg.Strs.new();
    s.push(mem.str_bytes("b"));
    s.push(mem.str_bytes("a"));
    s.push(mem.str_bytes("ab"));
    s.push(mem.str_bytes("a"));
    s.push(mem.str_bytes(""));
    same(diag.ranks(&s).as_slice(), &[4u32, 1, 3, 2, 0], "a prefix first, equal strings by position");
}

// A misused builder never traps: it marks the diagnostics unusable.
test fn builder_misuse_is_flagged() {
    let mut d = diag.Diags.new();
    bad_char(&mut d, 0, 0);
    debug.assert(!d.bad.get(), "a well-formed diagnostic is no misuse");
    d.begin(9999, "");
    d.end(0, 0, 1);
    debug.assert(d.bad.get(), "a code the registry lacks");
    let mut d = diag.Diags.new();
    d.begin(18, "no-such-case");
    debug.assert(d.bad.get(), "a case the code lacks");
    let mut d = diag.Diags.new();
    d.begin(18, "");
    d.arg("no-such-hole", mem.str_bytes("x"));
    debug.assert(d.bad.get(), "a hole the code lacks");
    let mut d = diag.Diags.new();
    d.begin(18, "");
    d.end(idx.NONE, 0, 0);
    debug.assert(d.bad.get(), "a located code with no span");
    let mut d = diag.Diags.new();
    d.begin(4, "");
    d.arg("found", mem.str_bytes("a\nb"));
    d.arg("expected", mem.str_bytes("x"));
    d.end(0, 0, 1);
    let mut m = vec.Vec::<u8>.new();
    d.message(0, &mut m);
    debug.assert(d.bad.get(), "a newline in one-line text");
    let mut d = diag.Diags.new();
    d.begin(4, "");
    d.arg("found", mem.str_bytes("a"));
    d.end(0, 0, 1);
    d.message(0, &mut m);
    debug.assert(d.bad.get(), "a hole the template needs and nobody gave");
}

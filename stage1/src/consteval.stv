// Const evaluation (types/consteval): the value of a const-expr in its decided type, as
// signature building needs it (an array length, a const generic argument, the value of a const
// item they name). One evaluator: later stages extend this module, never add a second one.
//
// An evaluation runs in two passes over the expression's nodes, as stage0's does. `decide`
// gives every node its type top-down with an explicit stack: an unsuffixed literal joins a group
// that takes the type of the other operand of its operator, of the expected type, or of the
// chain it is in (`200 + 100 - 100u8` is `u8` throughout); the expected type fixes a group when
// the literal is made. Then the literals are checked against their types and `value` evaluates
// the decided nodes bottom-up (node ids are postorder, so a node's operands come first and the
// first failing node is the one a left-to-right evaluation fails at), each in its decided type,
// lazily where the run time is (an `if` arm not taken, the operands of `&&` / `||` past the one
// that decides it): overflow, division by zero, `MIN / -1`, an index past the end, and a shift
// amount outside the width fail.
//
// What fails an operation is reported where the evaluation runs (stage0's E0203 at the
// operation, `Cx.rep`); any other failure that stage0 reports in its words is kept as the
// evaluation's one deferred diagnostic (`Cx.dfr`: a mismatch, E0201; a literal out of range,
// E0203; a literal without a type, E0202), reported by an owner that does not type the
// expression itself (`eval_u64`). An expression nested past `MAX_DEPTH` levels has no value.
//
// Const items are evaluated in dependency rounds (`round_consts`): a const whose initializer
// and type name only consts of earlier rounds is in the next round; the consts left over are on
// a cycle or depend on one, and have no value (stage0: E0904 case `cycle`).
//
// The forms evaluated: int literals, `true` and `false`, a const item by path, a bare const
// generic parameter as a whole length or argument, parentheses, the operators `+ - * / %` (and
// their `%` and `|` forms), `& | ^ << >> <<%` (`& | ^` on `bool`s too), unary `-`, `~`, `!`,
// comparisons, `&&`, `||`, `if then else`, `as` / `as%` / `as|` between int types (one step or a
// chain of them), and aggregates of ints and `bool`s: arrays (`[a, b]`, `[e; n]`, `[]`), tuples,
// and structs without generic params (`S.{ f: e }`), read by index, tuple element, and field
// after a const path or another value. An aggregate value is its leaves in order in the one pool
// of `Consts` (a repeat keeps one element's): a const's value and its parts are read in place,
// never copied; an evaluation keeps only its result's leaves there. The steps of an access
// chain are applied in order, each index evaluated at its step. A form outside these makes the evaluation `UNSUP` (stage1 does
// not decide it: the caller writes no dump).
//
// `size_of::<T>()` / `align_of::<T>()` of a type without parameters is a layout request (`Lay`,
// keyed by the call's node row): decided, it is T's size or alignment (or a failure: T has no
// layout); pending, the evaluation is `LAYOUT` and counts in `Cx.hits`, and signature building
// decides the requests between rounds (`sigs.build`).
import ast;
import decls;
import generated.node_kinds;
import generated.terminals;
import intern;
import items;
import lex;
import resolve;
import source;
import ir.types;
import prims.col;
import prims.search;
import prims.sort;
import std.idx;
import std.mem;
import std.vec;

pub const NONE: u32 = idx.NONE;

// Outcome of an evaluation, and the state of a const item's value.
pub const CV_NONE: u8 = 0;
pub const CV_OK: u8 = 1;
pub const CV_FAIL: u8 = 2;
pub const CV_UNSUP: u8 = 3;
pub const CV_LAYOUT: u8 = 4;

const K_ADD: u8 = node_kinds.KIND_ADD;
const K_MUL: u8 = node_kinds.KIND_MUL;
const K_SHIFT: u8 = node_kinds.KIND_SHIFT;
const K_BIT_AND: u8 = node_kinds.KIND_BIT_AND;
const K_BIT_OR: u8 = node_kinds.KIND_BIT_OR;
const K_BIT_XOR: u8 = node_kinds.KIND_BIT_XOR;
const K_UNARY: u8 = node_kinds.KIND_UNARY;
const K_PRIMARY: u8 = node_kinds.KIND_PRIMARY;
const K_POSTFIX: u8 = node_kinds.KIND_POSTFIX;
const K_CAST: u8 = node_kinds.KIND_CAST;
const K_TYPE: u8 = node_kinds.KIND_TYPE;
const K_TYPE_BASE: u8 = node_kinds.KIND_TYPE_BASE;
const K_GENERIC_ARGS: u8 = node_kinds.KIND_GENERIC_ARGS;
const K_GENERIC_PARAM: u8 = node_kinds.KIND_GENERIC_PARAM;
const K_GENERICS: u8 = node_kinds.KIND_GENERICS;
const K_IMPL_DECL: u8 = node_kinds.KIND_IMPL_DECL;
const K_TRAIT_DECL: u8 = node_kinds.KIND_TRAIT_DECL;
const K_MATCH: u8 = node_kinds.KIND_MATCH_EXPR;
const K_RANGE: u8 = node_kinds.KIND_RANGE_EXPR;
const K_AND: u8 = node_kinds.KIND_AND_EXPR;
const K_OR: u8 = node_kinds.KIND_OR_EXPR;
const K_CMP: u8 = node_kinds.KIND_CMP_EXPR;
const K_IF: u8 = node_kinds.KIND_IF_EXPR;
const K_STRUCT_LIT: u8 = node_kinds.KIND_STRUCT_LIT;

// The resolutions of every use, by (item, key node), then offset: `resolve`'s rows with a
// search key.
pub struct Uses {
    pub key: vec.Vec<u64>,
    pub off: vec.Vec<u32>,
    pub tag: vec.Vec<u8>,
    pub target: vec.Vec<u32>,
    // the (item, key node) pairs of the chains that end unresolved (`resolve.Names.unres`)
    pub unres: vec.Vec<u64>,
}

impl Uses {
    pub fn new(r: &resolve.Names) -> Uses {
        let n = r.len();
        let mut key = vec.Vec::<u64>.with_capacity(n);
        for k in 0..n {
            key.push(search.pair(r.item.as_slice()[k], r.node.as_slice()[k]));
        }
        let mut off = vec.Vec::<u32>.new();
        off.extend_from_slice(r.off.as_slice());
        let mut tag = vec.Vec::<u8>.new();
        tag.extend_from_slice(r.tag.as_slice());
        let mut target = vec.Vec::<u32>.new();
        target.extend_from_slice(r.target.as_slice());
        let mut unres = vec.Vec::<u64>.new();
        unres.extend_from_slice(r.unres.as_slice());
        return Uses.{ key: key, off: off, tag: tag, target: target, unres: unres };
    }

    // The rows keyed at node n of item i: `lo..hi`.
    pub fn range(&self, i: u32, n: u32) -> (usize, usize) {
        let k = search.pair(i, n);
        let lo = search.lower_bound(self.key.as_slice(), k);
        let hi = search.upper_bound(self.key.as_slice(), k);
        return (lo, hi);
    }

    // The row of the last segment of the path keyed at node n of item i, that segment starting
    // at byte offset off: the last row keyed there when it is that segment's, else NONE (only a
    // segment that resolves has a row, so the last row may be an earlier segment's).
    pub fn at_end(&self, i: u32, n: u32, off: u32) -> u32 {
        let (lo, hi) = self.range(i, n);
        if lo == hi || self.off.as_slice()[hi - 1] != off { return NONE; }
        return (hi - 1) as% u32;
    }

    // stage0's last use of the chain keyed at node n of item i: its last row, or NONE when it has
    // none or its walk ended at a segment recorded as unresolved (a walk that stops where the
    // resolver records nothing keeps its last resolved segment's).
    pub fn last(&self, i: u32, n: u32) -> u32 {
        let (lo, hi) = self.range(i, n);
        if lo == hi || search.contains(self.unres.as_slice(), search.pair(i, n)) { return NONE; }
        return (hi - 1) as% u32;
    }
}

// Generic parameters, one row per `GenericParam` of a decl's own list (`Gens.lo[d]..lo[d + 1]`):
// name S, node N, const or not, the declared type of a const one (`ERR` until lowered, and for
// a const param of no unsigned int type).
pub struct Gens {
    pub lo: vec.Vec<u32>,
    pub name: vec.Vec<u32>,
    pub node: vec.Vec<u32>,
    pub is_const: vec.Vec<bool>,
    pub cty: vec.Vec<u32>,
    pub is_view: vec.Vec<bool>,
}

// The generics in scope of a lowering: the flat list is the rows `par_lo..par_hi` then
// `own_lo..own_hi` (a method: its impl's or trait's, then its own; anything else: its own); the
// decl whose own list is `own_lo..own_hi` is `own` (NONE: none); `self_ty` is `Self` (NONE: none).
pub struct Scope {
    pub par_lo: u32,
    pub par_hi: u32,
    pub own_lo: u32,
    pub own_hi: u32,
    pub own: u32,
    pub self_ty: u32,
}

impl Copy for Scope {}

impl Scope {
    pub fn n_parent(&self) -> u32 {
        return self.par_hi - self.par_lo;
    }

    // The GP row of flat index i, or NONE.
    pub fn row(&self, i: u32) -> u32 {
        let np = self.par_hi - self.par_lo;
        if i < np { return self.par_lo + i; }
        if i - np < self.own_hi - self.own_lo { return self.own_lo + i - np; }
        return NONE;
    }
}

pub fn no_scope() -> Scope {
    return Scope.{ par_lo: 0, par_hi: 0, own_lo: 0, own_hi: 0, own: NONE, self_ty: NONE };
}

// The values of const items, per decl D: state, declared type, scalar value (sign, magnitude; a
// `bool` is 0 or 1), and for an aggregate its leaves in the pool (`alo`, NONE: none; `an` of
// them, or when `arep` the leaves of one element of an array that repeats it). `at_*`: the
// aggregate the last evaluation gave (`at_lo` NONE: a scalar), its leaves pushed onto the pool.
pub struct Consts {
    pub state: vec.Vec<u8>,
    pub ty: vec.Vec<u32>,
    pub neg: vec.Vec<bool>,
    pub mag: vec.Vec<u64>,
    pub alo: vec.Vec<u32>,
    pub an: vec.Vec<u32>,
    pub arep: vec.Vec<bool>,
    pub pneg: vec.Vec<bool>,
    pub pmag: vec.Vec<u64>,
    pub at_lo: u32,
    pub at_n: u32,
    pub at_rep: bool,
}

impl Consts {
    pub fn new(n: usize) -> Consts {
        return Consts.{ state: col.filled(n, CV_NONE), ty: col.filled(n, types.ERR), neg: col.filled(n, false), mag: col.filled(n, 0u64), alo: col.filled(n, NONE), an: col.filled(n, 0u32), arep: col.filled(n, false), pneg: vec.Vec::<bool>.new(), pmag: vec.Vec::<u64>.new(), at_lo: NONE, at_n: 0, at_rep: false };
    }
}

// Whether the evaluator gives a const of type t its value: an int, a `bool`, an array of them,
// and arrays, tuples, and structs without generic params of such values within `MAX_LEAVES`.
pub fn evaluable(cx: &mut Cx, ds: &decls.Decls, t: u32) -> bool {
    if t == NONE || t == types.ERR { return false; }
    let tag = cx.tab.tag_of(t);
    if tag == types.TK_ARRAY && scalar_elem(&cx.tab, cx.tab.a_of(t)) { return arr_len(&cx.tab, t) != NO_TY; }
    return value_ty(cx, ds, t);
}

// The diagnostics of const evaluation, one row each (stage0 reports them where the evaluation
// runs; one met twice is one diagnostic): code (`EV_*`), item, the first and last global token
// of the primary span, a type and a value by code:
// - `EV_RANGE` (E0203): the span's text is out of range for int type `ty`: a literal, or an
//   operation that overflows, divides by zero, or is `MIN / -1` or `MIN % -1`;
// - `EV_INDEX` (E0203 cases `index`, `index-empty`): the index at the span is past the end of a
//   const array of type `ty`, x its length;
// - `EV_MISMATCH` (E0201 case `no-cast`): the span has type x (`LIT_INT`: an int literal
//   without a type) where type `ty` is required;
// - `EV_NO_TYPE` (E0202): nothing gives the literal at the span a type;
// - `EV_INFER` (E0202 case `infer`): nothing gives the array literal `[]` at the span its type;
// - `EV_LOSSY` (E0204): the `as` at the span (the operator through the type) can lose
//   information: from type `ty` to type x.
pub struct Reports {
    pub code: vec.Vec<u8>,
    pub item: vec.Vec<u32>,
    pub lo: vec.Vec<u32>,
    pub hi: vec.Vec<u32>,
    pub ty: vec.Vec<u32>,
    pub x: vec.Vec<u32>,
}

impl Reports {
    pub fn new() -> Reports {
        return Reports.{ code: vec.Vec::<u8>.new(), item: vec.Vec::<u32>.new(), lo: vec.Vec::<u32>.new(), hi: vec.Vec::<u32>.new(), ty: vec.Vec::<u32>.new(), x: vec.Vec::<u32>.new() };
    }

    pub fn len(&self) -> usize {
        return self.code.len();
    }

    pub fn add(&mut self, code: u8, it: u32, lo: u32, hi: u32, ty: u32, x: u32) {
        self.code.push(code);
        self.item.push(it);
        self.lo.push(lo);
        self.hi.push(hi);
        self.ty.push(ty);
        self.x.push(x);
    }
}

pub const EV_RANGE: u8 = 1;
pub const EV_INDEX: u8 = 2;
pub const EV_MISMATCH: u8 = 3;
pub const EV_NO_TYPE: u8 = 4;
pub const EV_INFER: u8 = 5;
pub const EV_LOSSY: u8 = 6;
pub const LIT_INT: u32 = 0xffff_fff0;

// The first failure of an evaluation that reports nothing, as a `Reports` row (`code` 0: none).
pub struct Defer {
    pub code: u8,
    pub it: u32,
    pub lo: u32,
    pub hi: u32,
    pub ty: u32,
    pub x: u32,
}

impl Copy for Defer {}

pub fn no_defer() -> Defer {
    return Defer.{ code: 0, it: NONE, lo: NONE, hi: NONE, ty: NONE, x: NONE };
}

// The most bytes of compile-time data a value of a const-expr may have (stage0's
// `MAX_DATA_BYTES`; past it, E0904 case `size`).
const MAX_DATA_BYTES: u64 = 1u64 << 26;

// The most nested levels a const-expr is decided to (stage0's `MAX_DEPTH`).
const MAX_DEPTH: usize = 2000;

// The status of one integer operation (`arith`): done, its value outside the type (or a division
// by zero), a shift amount outside the width, no rule.
const A_OK: u8 = 0;
const A_OVER: u8 = 1;
const A_SHIFT: u8 = 2;
const A_NONE: u8 = 3;

// The layout requests of `size_of` / `align_of` calls, by the call's node row: the state
// (`CV_OK`, `CV_FAIL`, or pending `CV_LAYOUT`), size and alignment once decided, and the item and
// scope the type argument is lowered in, as of the round that last met the request (`met`: this
// round did; the scope's types are this round's).
pub struct Lay {
    pub row: vec.Vec<u32>,
    pub st: vec.Vec<u8>,
    pub size: vec.Vec<u64>,
    pub aln: vec.Vec<u64>,
    pub it: vec.Vec<u32>,
    pub sc: vec.Vec<Scope>,
    pub met: vec.Vec<bool>,
}

impl Lay {
    pub fn new() -> Lay {
        return Lay.{ row: vec.Vec::<u32>.new(), st: vec.Vec::<u8>.new(), size: vec.Vec::<u64>.new(), aln: vec.Vec::<u64>.new(), it: vec.Vec::<u32>.new(), sc: vec.Vec::<Scope>.new(), met: vec.Vec::<bool>.new() };
    }

    pub fn len(&self) -> usize {
        return self.row.len();
    }

    // The request of node row g, or NONE.
    pub fn find(&self, g: u32) -> u32 {
        for k in 0..self.row.len() {
            if self.row.as_slice()[k] == g { return k as% u32; }
        }
        return NONE;
    }

    pub fn add(&mut self, g: u32, it: u32, sc: Scope) {
        self.row.push(g);
        self.st.push(CV_LAYOUT);
        self.size.push(0);
        self.aln.push(0);
        self.it.push(it);
        self.sc.push(sc);
        self.met.push(true);
    }

    pub fn pending(&self) -> usize {
        let mut n: usize = 0;
        for k in 0..self.st.len() {
            if self.st.as_slice()[k] == CV_LAYOUT { n = n + 1; }
        }
        return n;
    }

    // Starts a round: no request met yet.
    pub fn new_round(&mut self) {
        for k in 0..self.met.len() {
            self.met.as_mut_slice()[k] = false;
        }
    }

    // Decides every pending request as failed (what waits on itself).
    pub fn fail_pending(&mut self) {
        for k in 0..self.st.len() {
            if self.st.as_slice()[k] == CV_LAYOUT { self.st.as_mut_slice()[k] = CV_FAIL; }
        }
    }
}

// The shared state of signature building: the type table, the uses, the node parents, the
// generic params, the const values, the layout requests, and the first reason a needed fact is
// not decided here.
pub struct Cx {
    pub tab: types.Table,
    pub uses: Uses,
    // per global node row: its parent row (NONE for an item root)
    pub parent: vec.Vec<u32>,
    pub gens: Gens,
    pub consts: Consts,
    // per decl D: its type (const, static, field), alias target, impl self type, or fn return;
    // whether an alias target is ready (not on or behind an alias cycle)
    pub ty: vec.Vec<u32>,
    pub ready: vec.Vec<bool>,
    pub skip: u8,
    pub lay: Lay,
    // the scope of the evaluation running (a request's type argument is lowered in it)
    pub sc: Scope,
    // evaluations so far that wait for a layout; per decl D: whether its signature waited
    pub hits: u32,
    pub wait: vec.Vec<bool>,
    // what const evaluations reported, and the running one's failure that reports nothing
    pub rep: Reports,
    pub dfr: Defer,
    // per type T (grown on demand): the leaves of a value of T once decided (`NO_TY`: not yet)
    pub leaf_memo: vec.Vec<u64>,
    // per decl D (grown on demand): a struct's fields in declaration order, rows
    // `sf_lo[D]..sf_lo[D] + sf_n[D]` of `sf_pool` (`sf_lo` NONE: not listed yet), and a listed
    // field's position among them
    pub sf_lo: vec.Vec<u32>,
    pub sf_n: vec.Vec<u32>,
    pub sf_pool: vec.Vec<u32>,
    pub fpos: vec.Vec<u32>,
}

impl Cx {
    pub fn note_skip(&mut self, why: u8) {
        if self.skip == CV_NONE { self.skip = why; }
    }
}

// The parent row of every node row.
pub fn parents(tree: &ast.Ast) -> vec.Vec<u32> {
    let mut p = col.filled(tree.nodes(), NONE);
    let inode = tree.item_node.as_slice();
    for i in 0..tree.items() {
        let base = inode[i] as usize;
        for g in base..inode[i + 1] as usize {
            let ks = tree.kids.row(g);
            for k in 0..ks.len() {
                p.as_mut_slice()[base + ks[k] as usize] = g as% u32;
            }
        }
    }
    return p;
}

pub fn kind(tree: &ast.Ast, g: usize) -> u8 {
    return tree.kind.as_slice()[g];
}

pub fn tk(t: &lex.Tokens, tok: u32) -> u8 {
    if tok as usize >= t.kind.len() { return 0xffu8; }
    return t.kind.as_slice()[tok as usize];
}

// The first child row of row g of kind k (item base `base`), or NONE.
pub fn child(tree: &ast.Ast, base: usize, g: usize, k: u8) -> u32 {
    let ks = tree.kids.row(g);
    for j in 0..ks.len() {
        let c = base + ks[j] as usize;
        if tree.kind.as_slice()[c] == k { return c as% u32; }
    }
    return NONE;
}

pub fn is_expr_kind(k: u8) -> bool {
    return k == node_kinds.KIND_IF_EXPR || k == K_MATCH || k == K_RANGE || k == node_kinds.KIND_OR_EXPR || k == node_kinds.KIND_AND_EXPR || k == node_kinds.KIND_CMP_EXPR || k == K_BIT_OR || k == K_BIT_XOR || k == K_BIT_AND || k == K_SHIFT || k == K_ADD || k == K_MUL || k == K_CAST || k == K_UNARY || k == K_POSTFIX || k == K_PRIMARY;
}

// The flat index and constness of the generic param whose node is row gp, seen from scope sc:
// a method's own params follow its container's.
pub fn generic_index(cx: &Cx, tree: &ast.Ast, t: &lex.Tokens, ds: &decls.Decls, it: u32, gp: usize, sc: Scope) -> (u32, bool, bool) {
    let p = cx.parent.as_slice()[gp];
    if p == NONE || kind(tree, p as usize) != K_GENERICS { return (NONE, false, false); }
    let base = tree.item_node.as_slice()[it as usize] as usize;
    let ks = tree.kids.row(p as usize);
    let mut idx: u32 = 0;
    for j in 0..ks.len() {
        let c = base + ks[j] as usize;
        if c == gp { break; }
        if kind(tree, c) == K_GENERIC_PARAM { idx = idx + 1; }
    }
    let owner = cx.parent.as_slice()[p as usize];
    let ok = if owner == NONE then 0xffu8 else kind(tree, owner as usize);
    let d = ds.item_decl.as_slice()[it as usize];
    let container = d != NONE && (ds.kind.as_slice()[d as usize] == decls.DK_IMPL || ds.kind.as_slice()[d as usize] == decls.DK_TRAIT);
    let level1 = container && ok != K_IMPL_DECL && ok != K_TRAIT_DECL;
    let is_const = tk(t, tree.tok.as_slice()[gp]) == terminals.T_KW_CONST;
    return (if level1 then sc.n_parent() + idx else idx, is_const, true);
}

// The bytes of the int literal at global token tok of item it: the alphanumeric run.
fn lit_text(t: &lex.Tokens, set: &source.SourceSet, cut: &items.Items, it: u32, tok: u32) -> (usize, usize) {
    let f = cut.file.as_slice()[it as usize] as usize;
    let src = set.file(f);
    let s = t.start.as_slice()[tok as usize] as usize;
    let mut e = s;
    while e < src.len() {
        let c = src[e];
        let ok = (c >= 48 && c <= 57) || (c >= 65 && c <= 90) || (c >= 97 && c <= 122) || c == 95;
        if !ok { break; }
        e = e + 1;
    }
    return (s, e);
}

// An int literal: (magnitude, too big for u64, suffix type code: 0 none, 1.. int types as
// `suffix_ty`, 100 a float suffix, 255 malformed).
pub fn parse_int(b: &[u8]) -> (u64, bool, u8) {
    let mut radix: u64 = 10;
    let mut i: usize = 0;
    if b.len() >= 2 && b[0] == 48 && (b[1] == 120 || b[1] == 98 || b[1] == 111) {
        radix = if b[1] == 120 then 16u64 else if b[1] == 98 then 2u64 else 8u64;
        i = 2;
    }
    let mut v: u64 = 0;
    let mut big = false;
    let mut any = false;
    while i < b.len() {
        let c = b[i];
        if c == 95 {
            i = i + 1;
            continue;
        }
        let d: u64 = if c >= 48 && c <= 57 then (c - 48) as u64 else if c >= 97 && c <= 102 then (c - 87) as u64 else if c >= 65 && c <= 70 then (c - 55) as u64 else 99u64;
        if d >= radix { break; }
        any = true;
        let hi = v.mul_hi(radix);
        let lo = v *% radix;
        if hi != 0 { big = true; }
        let s = lo +% d;
        if s < lo { big = true; }
        v = s;
        i = i + 1;
    }
    if !any { return (0, false, 0xffu8); }
    let suf = &b[i..b.len()];
    if suf.len() == 0 { return (v, big, 0u8); }
    let k = int_suffix(suf);
    if k != 0 { return (v, big, k); }
    if radix == 10 && (suf.eq(std_bytes("f32")) || suf.eq(std_bytes("f64")) || suf.eq(std_bytes("f16")) || suf.eq(std_bytes("bf16"))) { return (v, big, 100u8); }
    return (v, big, 0xffu8);
}

// The suffix code of an int type name (1 ..= 10, as `suffix_ty`), 0 for none.
fn int_suffix(b: &[u8]) -> u8 {
    if b.len() < 2 || (b[0] != 105 && b[0] != 117) { return 0u8; }
    let r = &b[1..b.len()];
    let w: u8 = if r.eq(std_bytes("8")) then 1u8 else if r.eq(std_bytes("16")) then 2u8 else if r.eq(std_bytes("32")) then 3u8 else if r.eq(std_bytes("64")) then 4u8 else if r.eq(std_bytes("size")) then 5u8 else 0u8;
    if w == 0 { return 0u8; }
    return if b[0] == 105 then w else w + 5;
}

fn std_bytes(s: &str) -> &[u8] from s {
    return mem.str_bytes(s);
}

// The int type of suffix code k (1 ..= 10: i8 i16 i32 i64 isize u8 u16 u32 u64 usize).
pub fn suffix_ty(tab: &mut types.Table, k: u8) -> u32 {
    let signed = k <= 5;
    let w = ((k - 1) % 5) as% u32;
    return tab.int(signed, w);
}

// The range of int type t: (lo negative, lo magnitude, hi).
fn range_of(tab: &types.Table, t: u32) -> (bool, u64, u64) {
    let bits = tab.int_bits(t);
    if tab.is_signed(t) {
        let half: u64 = 1u64 << (bits - 1) as u64;
        return (true, half, half - 1);
    }
    let hi: u64 = if bits == 64 then 0xffff_ffff_ffff_ffffu64 else (1u64 << bits as u64) - 1;
    return (false, 0, hi);
}

fn in_range(tab: &types.Table, t: u32, neg: bool, mag: u64) -> bool {
    let (_, lo, hi) = range_of(tab, t);
    if neg { return mag == 0 || (tab.is_signed(t) && mag <= lo); }
    return mag <= hi;
}

// Two's complement word of (neg, mag).
fn word(neg: bool, mag: u64) -> u64 {
    return if neg then 0u64 -% mag else mag;
}

// The value of the low `bits` of word w in a signed or unsigned type: (neg, mag).
fn wrap(w: u64, signed: bool, bits: u32) -> (bool, u64) {
    let mut v = w;
    if bits < 64 {
        let m: u64 = (1u64 << bits as u64) - 1;
        v = v & m;
        if signed && (v >> (bits - 1) as u64) & 1 == 1 {
            return (true, (m - v) + 1);
        }
        return (false, v);
    }
    if signed && (v >> 63) == 1 { return (true, 0u64 -% v); }
    return (false, v);
}

// Exact sum of two signed magnitudes: (neg, mag, overflow past 64 bits).
fn add_exact(an: bool, am: u64, bn: bool, bm: u64) -> (bool, u64, bool) {
    if an == bn {
        let s = am +% bm;
        return (an && s != 0, s, s < am);
    }
    if am >= bm { return (an && am != bm, am - bm, false); }
    return (bn, bm - am, false);
}

// One evaluation's state: per node of the expression's subtree (offset from `lo`), the decided
// type (a T, or a literal group `LIT | g`), for a literal its sign and magnitude, and the value:
// a scalar (sign, magnitude; a `bool` is 0 or 1), or an array of scalars (`vlo` its first
// element in the pool `pneg` / `pmag`, NONE for a scalar; `vn` elements, or one repeated `vn`
// times when `vrep`). `aux`: a comparison's operand type, an index's array type. `gfirst`: per
// literal group the row of the literal that made it.
struct Ev {
    it: u32,
    base: usize,
    lo: usize,
    nty: vec.Vec<u64>,
    lit: vec.Vec<u8>,
    lneg: vec.Vec<bool>,
    lmag: vec.Vec<u64>,
    lbig: vec.Vec<bool>,
    vneg: vec.Vec<bool>,
    vmag: vec.Vec<u64>,
    vlo: vec.Vec<u32>,
    vn: vec.Vec<u32>,
    vrep: vec.Vec<bool>,
    cast_to: vec.Vec<u32>,
    aux: vec.Vec<u64>,
    gpar: vec.Vec<u32>,
    gfix: vec.Vec<u32>,
    gfirst: vec.Vec<u32>,
    // per node: settled and evaluated already (a repeat count, inline)
    done: vec.Vec<bool>,
    // per node: an aggregate form (`F_*`); a struct literal's field expression: its field's
    // position
    form: vec.Vec<u8>,
    part: vec.Vec<u32>,
    // the steps of access chains (`F_CHAIN`: `aux` holds start and count): an index child's row
    // offset, or `STEP_PART | k` for part k; the type each step applies to
    sp: vec.Vec<u32>,
    sty: vec.Vec<u32>,
    // per node: the access chain whose index step evaluates it (NONE: the evaluation in node
    // order does)
    own: vec.Vec<u32>,
    out: u8,
}

// Aggregate forms: an access chain (parts, fields, and indexes after a head), a tuple literal, a
// struct literal (its `StructLit` row; the `Postfix` row takes its value).
const F_CHAIN: u8 = 1;
const F_TUPLE: u8 = 2;
const F_STRUCT: u8 = 3;
const F_SCOPY: u8 = 4;
const STEP_PART: u32 = 0x8000_0000;

// Decide frames of aggregate forms, in `Frames.acc`: none of them is a type or a group.
const ACC_CHAIN: u64 = 0xfffe_0000_0000_0001;
const ACC_TUPLE: u64 = 0xfffe_0000_0000_0002;
const ACC_STRUCT: u64 = 0xfffe_0000_0000_0003;

const NO_TY: u64 = 0xffff_ffff_ffff_ffff;
const LIT: u64 = 0x1_0000_0000;

impl Ev {
    fn at(&self, g: usize) -> usize {
        return g - self.lo;
    }

    fn find(&mut self, g: u32) -> u32 {
        let mut r = g;
        while self.gpar.as_slice()[r as usize] != r {
            r = self.gpar.as_slice()[r as usize];
        }
        return r;
    }

    fn resolve(&mut self, t: u64) -> u64 {
        if t & LIT == 0 { return t; }
        let r = self.find((t & 0xffff_ffff) as% u32);
        let f = self.gfix.as_slice()[r as usize];
        if f != NONE { return f as u64; }
        return LIT | (r as u64);
    }

    fn fix(&mut self, tab: &types.Table, g: u32, t: u32) -> bool {
        let r = self.find(g);
        let f = self.gfix.as_slice()[r as usize];
        if f != NONE { return f == t; }
        if tab.tag_of(t) != types.TK_INT { return false; }
        self.gfix.as_mut_slice()[r as usize] = t;
        return true;
    }

    fn fail(&mut self, why: u8) {
        if self.out == CV_OK || (why != CV_FAIL && self.out == CV_FAIL) { self.out = why; }
    }

    // The evaluation fails with diagnostic code (`EV_*`) at node row n (type ty, value x), which
    // an owner that does not type the expression itself reports (`eval_u64`): the first one.
    fn defer(&mut self, cx: &mut Cx, tree: &ast.Ast, code: u8, n: usize, ty: u32, x: u32) {
        if cx.dfr.code == 0 {
            let a = tree.tok.as_slice()[n];
            cx.dfr = Defer.{ code: code, it: self.it, lo: a, hi: tree.tok_end.as_slice()[n] - 1, ty: ty, x: x };
        }
        self.fail(CV_FAIL);
    }

    // The value at node row n (a type or a group) where `want` is required: a mismatch is
    // E0201 at n, unless one of the types is the error type (reported where it was made).
    fn coerce(&mut self, cx: &mut Cx, tree: &ast.Ast, n: usize, t: u64, want: u32) -> bool {
        let r = self.resolve(t);
        if r & LIT == 0 {
            if r as% u32 == want { return true; }
            if cx.tab.is_err(r as% u32) || cx.tab.is_err(want) {
                self.fail(CV_FAIL);
                return false;
            }
            self.defer(cx, tree, EV_MISMATCH, n, want, r as% u32);
            return false;
        }
        if self.fix(&cx.tab, (r & 0xffff_ffff) as% u32, want) { return true; }
        if cx.tab.is_err(want) {
            self.fail(CV_FAIL);
            return false;
        }
        self.defer(cx, tree, EV_MISMATCH, n, want, LIT_INT);
        return false;
    }

    // The type of the operands a and b of one operator, rn the right operand's row: a mismatch
    // is E0201 at rn, the left operand's type expected.
    fn unify(&mut self, cx: &mut Cx, tree: &ast.Ast, rn: usize, a: u64, b: u64) -> u64 {
        let x = self.resolve(a);
        let y = self.resolve(b);
        if x & LIT == 0 && y & LIT == 0 {
            if x == y { return x; }
            if cx.tab.is_err(x as% u32) || cx.tab.is_err(y as% u32) {
                self.fail(CV_FAIL);
            } else {
                self.defer(cx, tree, EV_MISMATCH, rn, x as% u32, y as% u32);
            }
            return NO_TY;
        }
        if x & LIT != 0 && y & LIT != 0 {
            let g1 = (x & 0xffff_ffff) as% u32;
            let g2 = (y & 0xffff_ffff) as% u32;
            let (l, h) = if g1 < g2 then (g1, g2) else (g2, g1);
            self.gpar.as_mut_slice()[h as usize] = l;
            return LIT | (l as u64);
        }
        let (g, t) = if x & LIT != 0 then ((x & 0xffff_ffff) as% u32, y as% u32) else ((y & 0xffff_ffff) as% u32, x as% u32);
        if self.fix(&cx.tab, g, t) { return t as u64; }
        if cx.tab.is_err(t) {
            self.fail(CV_FAIL);
        } else {
            self.defer(cx, tree, EV_MISMATCH, rn, t, LIT_INT);
        }
        return NO_TY;
    }

    // Group value v has no type (stage0's E0202 at the literal that made its root group).
    fn no_type(&mut self, cx: &mut Cx, tree: &ast.Ast, v: u64) {
        let r = self.find((v & 0xffff_ffff) as% u32);
        let n = self.gfirst.as_slice()[r as usize] as usize;
        self.defer(cx, tree, EV_NO_TYPE, n, NONE, NONE);
    }

    fn hint_of(&mut self, t: u64, outer: u32) -> u32 {
        let r = self.resolve(t);
        if r & LIT == 0 { return r as% u32; }
        return outer;
    }

    // Node x takes the value of node c (a scalar or an array).
    fn copy_val(&mut self, x: usize, c: usize) {
        let neg = self.vneg.as_slice()[c];
        let mag = self.vmag.as_slice()[c];
        let lo = self.vlo.as_slice()[c];
        let n = self.vn.as_slice()[c];
        let rep = self.vrep.as_slice()[c];
        self.vneg.as_mut_slice()[x] = neg;
        self.vmag.as_mut_slice()[x] = mag;
        self.set_arr(x, lo as usize, n, rep);
    }

    // Node x is an aggregate of n leaves from the pool on (`rep`: an array's one element, the
    // leaves of each).
    fn set_arr(&mut self, x: usize, lo: usize, n: u32, rep: bool) {
        self.vlo.as_mut_slice()[x] = lo as% u32;
        self.vn.as_mut_slice()[x] = n;
        self.vrep.as_mut_slice()[x] = rep;
    }
}

// Decide frames: node row, hint, next child index, the chain's type so far (an array literal:
// its element type so far; a repeat: the mark of the groups its count makes).
struct Frames {
    node: vec.Vec<u32>,
    hint: vec.Vec<u32>,
    k: vec.Vec<u32>,
    acc: vec.Vec<u64>,
}

impl Frames {
    fn push(&mut self, node: usize, hint: u32, acc: u64) {
        self.node.push(node as% u32);
        self.hint.push(hint);
        self.k.push(1);
        self.acc.push(acc);
    }
}

// The value of the const item d: (state, type, neg, mag).
fn const_value(cx: &Cx, d: u32) -> (u8, u32, bool, u64) {
    let c = &cx.consts;
    return (c.state.as_slice()[d as usize], c.ty.as_slice()[d as usize], c.neg.as_slice()[d as usize], c.mag.as_slice()[d as usize]);
}

// Node x (an offset) takes the value of const d, decided: false when d has none (the evaluation
// fails as stage0's: a const without a value has its own error, one not evaluated here is
// not decided either).
fn const_into(cx: &Cx, ev: &mut Ev, x: usize, d: u32) -> bool {
    let (st, ty, neg, mag) = const_value(cx, d);
    if st != CV_OK {
        ev.fail(if st == CV_UNSUP || st == CV_LAYOUT then st else CV_FAIL);
        return false;
    }
    let tag = cx.tab.tag_of(ty);
    let al = cx.consts.alo.as_slice()[d as usize];
    if tag == types.TK_INT || tag == types.TK_BOOL {
        ev.vneg.as_mut_slice()[x] = neg;
        ev.vmag.as_mut_slice()[x] = mag;
    } else if al != NONE {
        // an aggregate: its leaves where the const keeps them (the pool is shared, values in it
        // are never changed)
        let an = cx.consts.an.as_slice()[d as usize];
        let rep = cx.consts.arep.as_slice()[d as usize];
        ev.set_arr(x, al as usize, an, rep);
    } else {
        ev.fail(CV_UNSUP);
        return false;
    }
    ev.lit.as_mut_slice()[x] = 2;
    ev.nty.as_mut_slice()[x] = ty as u64;
    return true;
}

// The type of access chain g (`F_CHAIN`, its steps from the token in `aux` on), its head
// decided: each step is typed in order and recorded (`Ev.sp`, `Ev.sty`). A step its type does
// not have fails as stage0's (no value, nothing reported); one the evaluator holds no value for
// is not decided here.
fn chain_ty(cx: &mut Cx, tree: &ast.Ast, t: &lex.Tokens, set: &source.SourceSet, cut: &items.Items, nm: &intern.Interned, ds: &decls.Decls, ev: &mut Ev, g: usize) -> u64 {
    let base = ev.base;
    let x = g - ev.lo;
    let ks = tree.kids.row(g);
    let end = tree.tok_end.as_slice()[g];
    let h0 = ev.nty.as_slice()[base + ks[0] as usize - ev.lo];
    let r0 = ev.resolve(h0);
    let mut cur = r0 as% u32;
    let mut p = ev.aux.as_slice()[x] as% u32;
    let start = ev.sp.len();
    let mut kid: usize = 1;
    while p < end {
        let tag = cx.tab.tag_of(cur);
        if tk(t, p) == terminals.T_L_BRACKET {
            let ie = base + ks[kid] as usize;
            if tag != types.TK_ARRAY {
                ev.fail(CV_FAIL);
                return NO_TY;
            }
            let el = cx.tab.a_of(cur);
            if arr_len(&cx.tab, cur) == NO_TY || !value_ty(cx, ds, el) {
                ev.fail(CV_UNSUP);
                return NO_TY;
            }
            ev.sp.push((ie - ev.lo) as% u32);
            ev.sty.push(cur);
            cur = cx.tab.a_of(cur);
            p = tree.tok_end.as_slice()[ie] + 1;
            kid = kid + 1;
            continue;
        }
        let mut k: usize = 0;
        let mut pt = NONE;
        if tk(t, p + 1) == terminals.T_INT_LIT {
            // a tuple element
            let (s, e) = lit_text(t, set, cut, ev.it, p + 1);
            let f = cut.file.as_slice()[ev.it as usize] as usize;
            let (v, big, suf) = parse_int(&set.file(f)[s..e]);
            if tag != types.TK_TUPLE || big || suf != 0 || v >= cx.tab.x(cur).len() as u64 {
                ev.fail(CV_FAIL);
                return NO_TY;
            }
            k = v as usize;
            pt = cx.tab.x(cur)[k];
        } else {
            // a field of a struct value
            if tag != types.TK_ADT || ds.kind.as_slice()[cx.tab.a_of(cur) as usize] != decls.DK_STRUCT {
                ev.fail(CV_FAIL);
                return NO_TY;
            }
            if !plain_struct(cx, ds, cur) {
                ev.fail(CV_UNSUP);
                return NO_TY;
            }
            let sd = cx.tab.a_of(cur);
            let (f, fk) = field_named(cx, ds, sd, name_of(nm, p + 1));
            if f == NONE {
                ev.fail(CV_FAIL);
                return NO_TY;
            }
            k = fk as usize;
            pt = cx.ty.as_slice()[f as usize];
        }
        if !value_ty(cx, ds, pt) {
            ev.fail(CV_UNSUP);
            return NO_TY;
        }
        ev.sp.push(STEP_PART | k as% u32);
        ev.sty.push(cur);
        cur = pt;
        p = p + 2;
    }
    ev.aux.as_mut_slice()[x] = ((start as u64) << 32) | (ev.sp.len() - start) as u64;
    return cur as u64;
}

// The type of field k of struct d.
fn field_ty(cx: &mut Cx, ds: &decls.Decls, d: u32, k: u32) -> u32 {
    let (lo, _) = fields_of(cx, ds, d);
    let f = cx.sf_pool.as_slice()[lo + k as usize];
    return cx.ty.as_slice()[f as usize];
}

// Element k of a tuple hint of n elements (NONE: none).
fn tuple_hint(tab: &types.Table, h: u32, n: usize, k: usize) -> u32 {
    if h == NONE || h == types.ERR || tab.tag_of(h) != types.TK_TUPLE || tab.x(h).len() != n { return NONE; }
    return tab.x(h)[k];
}

// Pushes the leaves of node x's value (of type ty) onto the pool, a repeat as every element:
// false past `MAX_LEAVES`.
fn expand(cx: &mut Cx, ev: &Ev, x: usize, ty: u32) -> bool {
    let vl = ev.vlo.as_slice()[x];
    let c = &mut cx.consts;
    if vl == NONE {
        c.pneg.push(ev.vneg.as_slice()[x]);
        c.pmag.push(ev.vmag.as_slice()[x]);
        return true;
    }
    let n = ev.vn.as_slice()[x] as u64;
    let reps = if ev.vrep.as_slice()[x] then arr_len(&cx.tab, ty) else 1u64;
    if n != 0 && reps > MAX_LEAVES / n { return false; }
    for _ in 0..reps {
        for j in 0..n as usize {
            let neg = c.pneg.as_slice()[vl as usize + j];
            let mag = c.pmag.as_slice()[vl as usize + j];
            c.pneg.push(neg);
            c.pmag.push(mag);
        }
    }
    return true;
}

// The decl a path at row g (a `Primary` head, a `Postfix` of path steps only, or a `TypeBase`)
// names: (decl, 0) when every identifier of the path resolved and the last names a decl; (NONE,
// 1) a failed path; (NONE, 2) a form that is no plain path.
fn path_decl(cx: &Cx, tree: &ast.Ast, t: &lex.Tokens, it: u32, base: usize, g: usize) -> (u32, u8) {
    let mut head = g;
    if kind(tree, g) == K_POSTFIX {
        let ks = tree.kids.row(g);
        if ks.len() != 1 { return (NONE, 2u8); }
        head = base + ks[0] as usize;
        if kind(tree, head) != K_PRIMARY { return (NONE, 2u8); }
    }
    let a = tree.tok.as_slice()[head];
    if tk(t, a) != terminals.T_IDENT { return (NONE, 2u8); }
    let end = tree.tok_end.as_slice()[g];
    if kind(tree, head) == K_PRIMARY && tree.kids.row(head).len() > 0 { return (NONE, 2u8); }
    // identifiers `a . b . c` up to the node's end
    let mut last = a;
    let mut p = a + 1;
    while p + 1 < end && tk(t, p) == terminals.T_DOT && tk(t, p + 1) == terminals.T_IDENT {
        last = p + 1;
        p = p + 2;
    }
    if kind(tree, g) != K_TYPE_BASE && p != end { return (NONE, 2u8); }
    let u = cx.uses.at_end(it, (head - base) as% u32, t.start.as_slice()[last as usize]);
    if u == NONE || cx.uses.tag.as_slice()[u as usize] != resolve.TAG_DECL { return (NONE, 1u8); }
    return (cx.uses.target.as_slice()[u as usize], 0u8);
}

// The last identifier of the dotted path starting at token a.
pub fn path_end(t: &lex.Tokens, a: u32) -> u32 {
    let mut e = a;
    while tk(t, e + 1) == terminals.T_DOT && tk(t, e + 2) == terminals.T_IDENT {
        e = e + 2;
    }
    return e;
}

// The outcome of a postfix chain at row g whose head path names a const: a head const without
// a value fails, any other is a form not evaluated here.
fn head_state(cx: &Cx, tree: &ast.Ast, ds: &decls.Decls, it: u32, base: usize, g: usize) -> u8 {
    if kind(tree, g) != K_POSTFIX { return CV_UNSUP; }
    let head = base + tree.kids.row(g)[0] as usize;
    let (lo, hi) = cx.uses.range(it, (head - base) as% u32);
    if lo == hi || cx.uses.tag.as_slice()[hi - 1] != resolve.TAG_DECL { return CV_UNSUP; }
    let d = cx.uses.target.as_slice()[hi - 1] as usize;
    if ds.kind.as_slice()[d] != decls.DK_CONST { return CV_UNSUP; }
    let st = cx.consts.state.as_slice()[d];
    return if st == CV_FAIL || st == CV_LAYOUT then st else CV_UNSUP;
}

// The int type a cast's target `Type` row names (a built-in int name), else NONE.
fn cast_target(cx: &mut Cx, tree: &ast.Ast, t: &lex.Tokens, nm: &intern.Interned, base: usize, g: usize) -> u32 {
    let mut x = g;
    if kind(tree, x) == K_TYPE {
        let ks = tree.kids.row(x);
        if ks.len() != 1 { return NONE; }
        x = base + ks[0] as usize;
    }
    if kind(tree, x) != K_TYPE_BASE || tree.kids.row(x).len() != 0 { return NONE; }
    let a = tree.tok.as_slice()[x];
    if tk(t, a) != terminals.T_IDENT || tree.tok_end.as_slice()[x] != a + 1 { return NONE; }
    let s = nm.tok_str.as_slice()[a as usize];
    if s == NONE { return NONE; }
    let k = int_suffix(nm.tab.text(s as usize));
    if k == 0 { return NONE; }
    return suffix_ty(&mut cx.tab, k);
}

fn is_chain(k: u8) -> bool {
    return k == K_ADD || k == K_MUL || k == K_SHIFT || k == K_BIT_AND || k == K_BIT_OR || k == K_BIT_XOR;
}

// Whether the subtree of row g holds a use of a generic param (a `size_of` argument that names
// one has no layout yet: E0904 case `generic`).
fn names_generic(cx: &Cx, tree: &ast.Ast, it: u32, base: usize, g: usize) -> bool {
    let lo = g - tree.size.as_slice()[g] as usize;
    for x in lo..g + 1 {
        let (a, b) = cx.uses.range(it, (x - base) as% u32);
        for k in a..b {
            if cx.uses.tag.as_slice()[k] == resolve.TAG_LOCAL { return true; }
        }
    }
    return false;
}

// Evaluates the expression at row g (item it, item base `base`) expecting type `want` (NONE:
// none): (outcome, type, neg, mag); an array value is left in the const pool (`Consts.at_lo`).
// A fail of a const it names without a value is `CV_FAIL`, of one stage1 cannot evaluate its
// outcome. What fails an operation it evaluates (overflow, an index past the end) is reported
// (`Cx.rep`); the first failure that reports nothing is kept (`Cx.dfr`).
pub fn eval(cx: &mut Cx, tree: &ast.Ast, t: &lex.Tokens, nm: &intern.Interned, set: &source.SourceSet, cut: &items.Items, ds: &decls.Decls, it: u32, g: usize, want: u32) -> (u8, u32, bool, u64) {
    // the leaves this evaluation adds to the shared pool past p0: only its result's stay
    let p0 = cx.consts.pmag.len();
    cx.dfr = no_defer();
    cx.consts.at_lo = NONE;
    let r = eval_in(cx, tree, t, nm, set, cut, ds, it, g, want);
    let c = &mut cx.consts;
    let vl = c.at_lo;
    if vl != NONE && vl as usize >= p0 {
        for k in 0..c.at_n as usize {
            let neg = c.pneg.as_slice()[vl as usize + k];
            let mag = c.pmag.as_slice()[vl as usize + k];
            c.pneg.as_mut_slice()[p0 + k] = neg;
            c.pmag.as_mut_slice()[p0 + k] = mag;
        }
        c.at_lo = p0 as% u32;
        c.pneg.truncate(p0 + c.at_n as usize);
        c.pmag.truncate(p0 + c.at_n as usize);
    } else {
        // a scalar, a failure, or a part of an earlier const's value (shared)
        c.pneg.truncate(p0);
        c.pmag.truncate(p0);
    }
    return r;
}

fn eval_in(cx: &mut Cx, tree: &ast.Ast, t: &lex.Tokens, nm: &intern.Interned, set: &source.SourceSet, cut: &items.Items, ds: &decls.Decls, it: u32, g: usize, want: u32) -> (u8, u32, bool, u64) {
    let base = tree.item_node.as_slice()[it as usize] as usize;
    let a = tree.tok.as_slice()[g];
    if kind(tree, g) == K_PRIMARY && tk(t, a) == terminals.T_INT_LIT && tree.tok_end.as_slice()[g] == a + 1 {
        return lone_literal(cx, tree, t, set, cut, it, g, want);
    }
    let lo = g - tree.size.as_slice()[g] as usize;
    let n = g - lo + 1;
    let mut ev = Ev.{
        it: it,
        base: base,
        lo: lo,
        nty: col.filled(n, NO_TY),
        lit: col.filled(n, 0u8),
        lneg: col.filled(n, false),
        lmag: col.filled(n, 0u64),
        lbig: col.filled(n, false),
        vneg: col.filled(n, false),
        vmag: col.filled(n, 0u64),
        vlo: col.filled(n, NONE),
        vn: col.filled(n, 0u32),
        vrep: col.filled(n, false),
        cast_to: col.filled(n, NONE),
        aux: col.filled(n, NO_TY),
        gpar: vec.Vec::<u32>.new(),
        gfix: vec.Vec::<u32>.new(),
        gfirst: vec.Vec::<u32>.new(),
        done: col.filled(n, false),
        form: col.filled(n, 0u8),
        part: col.filled(n, NONE),
        sp: vec.Vec::<u32>.new(),
        sty: vec.Vec::<u32>.new(),
        own: col.filled(n, NONE),
        out: CV_OK,
    };
    let top = decide(cx, tree, t, nm, set, cut, ds, &mut ev, g, want);
    if ev.out != CV_OK { return (ev.out, types.ERR, false, 0); }
    if want != NONE {
        if !ev.coerce(cx, tree, g, top, want) { return (ev.out, types.ERR, false, 0); }
    } else if ev.resolve(top) & LIT != 0 {
        ev.no_type(cx, tree, top);
        return (CV_FAIL, types.ERR, false, 0);
    }
    if !settle(cx, tree, t, &mut ev, lo, g, 0) { return (ev.out, types.ERR, false, 0); }
    let r = value(cx, tree, t, ds, &mut ev, lo, g, NONE);
    if r != CV_OK { return (r, types.ERR, false, 0); }
    let x = g - lo;
    let vl = ev.vlo.as_slice()[x];
    if vl != NONE {
        let c = &mut cx.consts;
        c.at_lo = vl;
        c.at_n = ev.vn.as_slice()[x];
        c.at_rep = ev.vrep.as_slice()[x];
    }
    return (CV_OK, ev.nty.as_slice()[x] as% u32, ev.vneg.as_slice()[x], ev.vmag.as_slice()[x]);
}

// Keeps diagnostic code (`EV_*`) at node row n of item it (type ty, value x) as the evaluation's
// failure that reports nothing, unless one is kept already.
fn note(cx: &mut Cx, tree: &ast.Ast, it: u32, code: u8, n: usize, ty: u32, x: u32) {
    if cx.dfr.code != 0 { return; }
    let a = tree.tok.as_slice()[n];
    cx.dfr = Defer.{ code: code, it: it, lo: a, hi: tree.tok_end.as_slice()[n] - 1, ty: ty, x: x };
}

// An expression that is one int literal (node row g), expected type `want` (NONE: none): the
// two passes collapse to this (a suffix gives its type, else the expected type does).
fn lone_literal(cx: &mut Cx, tree: &ast.Ast, t: &lex.Tokens, set: &source.SourceSet, cut: &items.Items, it: u32, g: usize, want: u32) -> (u8, u32, bool, u64) {
    let f = cut.file.as_slice()[it as usize] as usize;
    let (s, e) = lit_text(t, set, cut, it, tree.tok.as_slice()[g]);
    let (mag, big, suf) = parse_int(&set.file(f)[s..e]);
    if suf == 0xff || (suf == 100 && want != NONE) { return (CV_FAIL, types.ERR, false, 0); }
    if suf == 100 { return (CV_UNSUP, types.ERR, false, 0); }
    let ty = if suf != 0 then suffix_ty(&mut cx.tab, suf) else want;
    if ty == NONE || cx.tab.is_err(ty) { return (CV_FAIL, types.ERR, false, 0); }
    if want != NONE && (ty != want || cx.tab.tag_of(ty) != types.TK_INT) {
        if !cx.tab.is_err(want) { note(cx, tree, it, EV_MISMATCH, g, want, if suf != 0 then ty else LIT_INT); }
        return (CV_FAIL, types.ERR, false, 0);
    }
    if big || !in_range(&cx.tab, ty, false, mag) {
        note(cx, tree, it, EV_RANGE, g, ty, NONE);
        return (CV_FAIL, types.ERR, false, 0);
    }
    return (CV_OK, ty, false, mag);
}

// The element type an array hint gives (NONE: none).
fn elem_hint(tab: &types.Table, h: u32) -> u32 {
    if h == NONE || h == types.ERR || tab.tag_of(h) != types.TK_ARRAY { return NONE; }
    return tab.a_of(h);
}

// Whether the evaluator holds arrays of type t's elements: ints and `bool`s.
fn scalar_elem(tab: &types.Table, t: u32) -> bool {
    if t == NONE || t == types.ERR { return false; }
    let tag = tab.tag_of(t);
    return tag == types.TK_INT || tag == types.TK_BOOL;
}

// The length of array type t, if it is a value (else NONE as u64).
fn arr_len(tab: &types.Table, t: u32) -> u64 {
    let xs = tab.x(t);
    if xs.len() < 3 || xs[0] != types.GA_VALUE { return NO_TY; }
    return ((xs[1] as u64) << 32) | xs[2] as u64;
}

// The array type of elem and length n (an evaluated array of ints or `bool`s), or the error type
// when its bytes pass the compile-time data limit (stage0: E0904 case `size`).
fn array_ty(tab: &mut types.Table, elem: u32, n: u64) -> u32 {
    let bytes: u64 = if tab.tag_of(elem) == types.TK_BOOL then 1u64 else if tab.int_bits(elem) == 0 then 8u64 else (tab.int_bits(elem) / 8) as u64;
    if n > MAX_DATA_BYTES / bytes { return types.ERR; }
    tab.begin();
    tab.push_garg(types.GA_VALUE, (n >> 32) as% u32, n as% u32);
    return tab.intern(types.TK_ARRAY, elem, 0);
}

// The most leaves a value holds expanded (a repeat keeps one element): past it, or past the
// bytes the compile-time data limit surely admits (a leaf takes at most 8 bytes with its
// padding), an aggregate is a form not evaluated here.
const MAX_LEAVES: u64 = 1u64 << 22;

// The deepest type an aggregate value is decided for (deeper: not evaluated here).
const MAX_AGG_DEPTH: u32 = 200;

// The fields of struct d in declaration order: rows `lo..hi` of `Cx.sf_pool`, listed once.
pub fn fields_of(cx: &mut Cx, ds: &decls.Decls, d: u32) -> (usize, usize) {
    while cx.sf_lo.len() < ds.decls() {
        cx.sf_lo.push(NONE);
        cx.sf_n.push(0);
        cx.fpos.push(NONE);
    }
    let lo0 = cx.sf_lo.as_slice()[d as usize];
    if lo0 != NONE { return (lo0 as usize, lo0 as usize + cx.sf_n.as_slice()[d as usize] as usize); }
    let mut fs = vec.Vec::<u32>.new();
    let mut ix = vec.Vec::<u32>.new();
    let mk = ds.mem_key.as_slice();
    let mut k = search.lower_bound(mk, search.pair(d, 0));
    while k < mk.len() && (mk[k] >> 32) as% u32 == d {
        let f = ds.mem_decl.as_slice()[k];
        if ds.kind.as_slice()[f as usize] == decls.DK_FIELD {
            fs.push(f);
            ix.push(ds.index.as_slice()[f as usize]);
        }
        k = k + 1;
    }
    let perm = sort.sort_perm(ix.as_slice());
    let lo = cx.sf_pool.len();
    for j in 0..perm.len() {
        let f = fs.as_slice()[perm.as_slice()[j] as usize];
        cx.sf_pool.push(f);
        cx.fpos.as_mut_slice()[f as usize] = j as% u32;
    }
    cx.sf_lo.as_mut_slice()[d as usize] = lo as% u32;
    cx.sf_n.as_mut_slice()[d as usize] = fs.len() as% u32;
    return (lo, lo + fs.len());
}

// The field of struct d named S and its position, or (NONE, NONE).
fn field_named(cx: &mut Cx, ds: &decls.Decls, d: u32, s: u32) -> (u32, u32) {
    let _ = fields_of(cx, ds, d);
    let mk = ds.mem_key.as_slice();
    let k = search.lower_bound(mk, search.pair(d, s));
    if s == NONE || k == mk.len() || mk[k] != search.pair(d, s) { return (NONE, NONE); }
    let f = ds.mem_decl.as_slice()[k];
    if ds.kind.as_slice()[f as usize] != decls.DK_FIELD { return (NONE, NONE); }
    return (f, cx.fpos.as_slice()[f as usize]);
}

// Whether t is a struct whose values the evaluator holds: one without generic params, every
// field type lowered.
fn plain_struct(cx: &Cx, ds: &decls.Decls, t: u32) -> bool {
    if cx.tab.tag_of(t) != types.TK_ADT || cx.tab.x(t).len() != 0 { return false; }
    let d = cx.tab.a_of(t);
    if ds.kind.as_slice()[d as usize] != decls.DK_STRUCT { return false; }
    return cx.gens.lo.as_slice()[d as usize] == cx.gens.lo.as_slice()[d as usize + 1];
}

// The leaves of a value of type t (ints and `bool`s, in order: array elements, tuple elements,
// struct fields by declaration), saturated past `MAX_LEAVES`; `NO_TY` when the evaluator holds
// no value of t. A count once decided is kept per type (a field type, once lowered, is final;
// `NO_TY` is not kept: a field may be lowered later).
rec fn leaves(cx: &mut Cx, ds: &decls.Decls, t: u32, depth: u32) -> u64 {
    if t == NONE || t == types.ERR || depth > MAX_AGG_DEPTH { return NO_TY; }
    if (t as usize) < cx.leaf_memo.len() && cx.leaf_memo.as_slice()[t as usize] != NO_TY { return cx.leaf_memo.as_slice()[t as usize]; }
    let tag = cx.tab.tag_of(t);
    if tag == types.TK_INT || tag == types.TK_BOOL { return 1; }
    let mut r: u64 = NO_TY;
    if tag == types.TK_ARRAY {
        let n = arr_len(&cx.tab, t);
        if n == NO_TY { return NO_TY; }
        let el = cx.tab.a_of(t);
        let e = leaves(cx, ds, el, depth + 1);
        if e == NO_TY { return NO_TY; }
        r = if e != 0 && n > MAX_LEAVES / e then MAX_LEAVES + 1 else n * e;
    } else {
        let mut parts = vec.Vec::<u32>.new();
        if tag == types.TK_TUPLE {
            parts.extend_from_slice(cx.tab.x(t));
        } else if plain_struct(cx, ds, t) {
            let sd = cx.tab.a_of(t);
            let (lo, hi) = fields_of(cx, ds, sd);
            for k in lo..hi {
                let f = cx.sf_pool.as_slice()[k];
                parts.push(cx.ty.as_slice()[f as usize]);
            }
        } else {
            return NO_TY;
        }
        let mut sum: u64 = 0;
        for k in 0..parts.len() {
            let e = leaves(cx, ds, parts.as_slice()[k], depth + 1);
            if e == NO_TY { return NO_TY; }
            sum = sum + e;
            if sum > MAX_LEAVES {
                sum = MAX_LEAVES + 1;
                break;
            }
        }
        r = sum;
    }
    while cx.leaf_memo.len() <= t as usize {
        cx.leaf_memo.push(NO_TY);
    }
    cx.leaf_memo.as_mut_slice()[t as usize] = r;
    return r;
}

// Whether the evaluator holds a value of type t within its limits.
fn value_ty(cx: &mut Cx, ds: &decls.Decls, t: u32) -> bool {
    if scalar_elem(&cx.tab, t) { return true; }
    let n = leaves(cx, ds, t, 0);
    return n != NO_TY && n <= MAX_LEAVES;
}

// Part k of tuple or struct type t: (its type, its first leaf among t's).
fn part_of(cx: &mut Cx, ds: &decls.Decls, t: u32, k: usize) -> (u32, u64) {
    let mut parts = vec.Vec::<u32>.new();
    if cx.tab.tag_of(t) == types.TK_TUPLE {
        parts.extend_from_slice(&cx.tab.x(t)[0..k + 1]);
    } else {
        let sd = cx.tab.a_of(t);
        let (lo, _) = fields_of(cx, ds, sd);
        for j in 0..k + 1 {
            let f = cx.sf_pool.as_slice()[lo + j];
            parts.push(cx.ty.as_slice()[f as usize]);
        }
    }
    let mut off: u64 = 0;
    for j in 0..k {
        off = off + leaves(cx, ds, parts.as_slice()[j], 0);
    }
    return (parts.as_slice()[k], off);
}

// The array of n elements of type elem, decided at a literal: the error type when its bytes
// pass the compile-time data limit (stage0: E0904 case `size`), NONE when the evaluator holds no
// such value.
fn array_of(cx: &mut Cx, ds: &decls.Decls, elem: u32, n: u64) -> u32 {
    if scalar_elem(&cx.tab, elem) { return array_ty(&mut cx.tab, elem, n); }
    let e = leaves(cx, ds, elem, 0);
    if e == NO_TY || (e != 0 && n > MAX_LEAVES / e) { return NONE; }
    cx.tab.begin();
    cx.tab.push_garg(types.GA_VALUE, (n >> 32) as% u32, n as% u32);
    return cx.tab.intern(types.TK_ARRAY, elem, 0);
}

// The decl a const path heads Postfix row g with (NONE: none) and the token after that path: the
// head identifier and the `. name` segments after it that resolve.
fn const_head(cx: &Cx, tree: &ast.Ast, t: &lex.Tokens, ds: &decls.Decls, it: u32, base: usize, g: usize) -> (u32, u32) {
    let head = base + tree.kids.row(g)[0] as usize;
    let a = tree.tok.as_slice()[head];
    if kind(tree, head) != K_PRIMARY || tk(t, a) != terminals.T_IDENT || tree.kids.row(head).len() != 0 { return (NONE, tree.tok_end.as_slice()[head]); }
    let hn = (head - base) as% u32;
    let mut u = use_at(cx, it, hn, t.start.as_slice()[a as usize]);
    if u == NONE { return (NONE, a + 1); }
    let mut p = a + 1;
    while tk(t, p) == terminals.T_DOT && tk(t, p + 1) == terminals.T_IDENT {
        let v = use_at(cx, it, hn, t.start.as_slice()[p as usize + 1]);
        if v == NONE { break; }
        u = v;
        p = p + 2;
    }
    if cx.uses.tag.as_slice()[u as usize] != resolve.TAG_DECL { return (NONE, p); }
    let d = cx.uses.target.as_slice()[u as usize];
    if ds.kind.as_slice()[d as usize] != decls.DK_CONST { return (NONE, p); }
    return (d, p);
}

// The row of the use keyed at node n of item it whose segment starts at byte offset off, or
// NONE.
fn use_at(cx: &Cx, it: u32, n: u32, off: u32) -> u32 {
    let (lo, hi) = cx.uses.range(it, n);
    for k in lo..hi {
        if cx.uses.off.as_slice()[k] == off { return k as% u32; }
    }
    return NONE;
}

// Whether the steps of Postfix row g from token p on are all a part (`.0`), a field (`. name`
// not followed by a call or generic arguments), or an index (`[e]`, an expression child), and
// there is at least one.
fn access_steps(tree: &ast.Ast, t: &lex.Tokens, base: usize, g: usize, p0: u32) -> bool {
    let end = tree.tok_end.as_slice()[g];
    let ks = tree.kids.row(g);
    let mut kid: usize = 1;
    let mut p = p0;
    if p >= end { return false; }
    while p < end {
        let a = tk(t, p);
        if a == terminals.T_DOT && tk(t, p + 1) == terminals.T_INT_LIT {
            p = p + 2;
        } else if a == terminals.T_DOT && tk(t, p + 1) == terminals.T_IDENT {
            let n = tk(t, p + 2);
            if p + 2 < end && (n == terminals.T_L_PAREN || n == terminals.T_COLON_COLON) { return false; }
            p = p + 2;
        } else if a == terminals.T_L_BRACKET {
            if kid >= ks.len() { return false; }
            let ie = base + ks[kid] as usize;
            if !is_expr_kind(kind(tree, ie)) || tree.tok.as_slice()[ie] != p + 1 { return false; }
            p = tree.tok_end.as_slice()[ie] + 1;
            kid = kid + 1;
        } else {
            return false;
        }
    }
    return p == end && kid == ks.len();
}

// The struct literal form at Postfix row g: a path of identifiers resolving to a struct the
// evaluator holds values of, then `.{ .. }` naming each of its fields once; the struct, else
// NONE, or `BAD_LIT` for a literal of such a struct that names a field it lacks or leaves one
// out (stage0: no value, nothing reported). Each field expression's field position goes into
// `Ev.part`.
fn struct_lit(cx: &mut Cx, tree: &ast.Ast, t: &lex.Tokens, nm: &intern.Interned, ds: &decls.Decls, ev: &mut Ev, base: usize, g: usize) -> u32 {
    let ks = tree.kids.row(g);
    if ks.len() != 2 { return NONE; }
    let head = base + ks[0] as usize;
    let sl = base + ks[1] as usize;
    if kind(tree, head) != K_PRIMARY || kind(tree, sl) != K_STRUCT_LIT || tree.kids.row(head).len() != 0 { return NONE; }
    let a = tree.tok.as_slice()[head];
    if tk(t, a) != terminals.T_IDENT { return NONE; }
    let open = tree.tok.as_slice()[sl];
    if tk(t, open) != terminals.T_DOT_L_BRACE || tree.tok_end.as_slice()[sl] != tree.tok_end.as_slice()[g] { return NONE; }
    // identifiers `a . b . c` up to the literal, the last one resolved to a struct
    let mut last = a;
    let mut p = a + 1;
    while p + 1 < open && tk(t, p) == terminals.T_DOT && tk(t, p + 1) == terminals.T_IDENT {
        last = p + 1;
        p = p + 2;
    }
    if p != open { return NONE; }
    let u = cx.uses.at_end(ev.it, (head - base) as% u32, t.start.as_slice()[last as usize]);
    if u == NONE || cx.uses.tag.as_slice()[u as usize] != resolve.TAG_DECL { return NONE; }
    let d = cx.uses.target.as_slice()[u as usize];
    if ds.kind.as_slice()[d as usize] != decls.DK_STRUCT || cx.gens.lo.as_slice()[d as usize] != cx.gens.lo.as_slice()[d as usize + 1] { return NONE; }
    let (flo, fhi) = fields_of(cx, ds, d);
    let es = tree.kids.row(sl);
    let mut seen = col.filled(fhi - flo, false);
    for j in 0..es.len() {
        let e = base + es[j] as usize;
        let s = name_of(nm, tree.tok.as_slice()[e] - 2);
        let (f, k) = field_named(cx, ds, d, s);
        if f == NONE { return BAD_LIT; }
        if seen.as_slice()[k as usize] { return NONE; }
        let ft = cx.ty.as_slice()[f as usize];
        if !value_ty(cx, ds, ft) { return NONE; }
        seen.as_mut_slice()[k as usize] = true;
        ev.part.as_mut_slice()[e - ev.lo] = k;
    }
    if es.len() != fhi - flo { return BAD_LIT; }
    return d;
}

const BAD_LIT: u32 = 0xffff_fffe;

// The decide pass from row g with hint `want`: the type of g (a T or a group).
fn decide(cx: &mut Cx, tree: &ast.Ast, t: &lex.Tokens, nm: &intern.Interned, set: &source.SourceSet, cut: &items.Items, ds: &decls.Decls, ev: &mut Ev, g: usize, want: u32) -> u64 {
    let base = ev.base;
    let it = ev.it;
    let bool_t = cx.tab.key(types.TK_BOOL, 0, 0);
    let mut fr = Frames.{ node: vec.Vec::<u32>.new(), hint: vec.Vec::<u32>.new(), k: vec.Vec::<u32>.new(), acc: vec.Vec::<u64>.new() };
    let mut cur = g;
    let mut hint = want;
    let mut ret: u64 = NO_TY;
    // `entering`: cur/hint is a node to decide; else `ret` returns to the top frame
    let mut entering = true;
    loop {
        if ev.out != CV_OK { return NO_TY; }
        if entering {
            let k = kind(tree, cur);
            let ks = tree.kids.row(cur);
            let a = tree.tok.as_slice()[cur];
            // stage0 decides a node at the depth of its frames plus one, the head path of an
            // index without deciding it; past `MAX_DEPTH` it reports E0904 case `depth` (not a
            // code here) and there is no value
            let top = fr.node.len();
            let pf = if top > 0 then fr.node.as_slice()[top - 1] as usize else 0usize;
            let path_head = top > 0 && kind(tree, pf) == K_POSTFIX && cur == base + tree.kids.row(pf)[0] as usize && k == K_PRIMARY && tk(t, a) == terminals.T_IDENT;
            if top + 1 > MAX_DEPTH && !path_head {
                ev.fail(CV_FAIL);
                continue;
            }
            if is_chain(k) && ks.len() > 1 {
                fr.push(cur, hint, NO_TY);
                cur = base + ks[0] as usize;
                continue;
            }
            if (is_chain(k) || k == K_CAST || k == K_AND || k == K_OR || k == K_CMP) && ks.len() == 1 {
                fr.push(cur, hint, NO_TY);
                cur = base + ks[0] as usize;
                continue;
            }
            if k == K_AND || k == K_OR || k == K_IF {
                if k == K_IF && ks.len() != 3 {
                    ev.fail(CV_UNSUP);
                    continue;
                }
                // a condition and every `&&` / `||` operand is a `bool`
                fr.push(cur, hint, NO_TY);
                cur = base + ks[0] as usize;
                hint = bool_t;
                continue;
            }
            if k == K_CMP {
                if ks.len() != 3 {
                    ev.fail(CV_UNSUP);
                    continue;
                }
                fr.push(cur, hint, NO_TY);
                cur = base + ks[0] as usize;
                hint = NONE;
                continue;
            }
            if k == K_UNARY {
                let c = base + ks[0] as usize;
                let op = tk(t, a);
                if op == terminals.T_MINUS {
                    let p = down_to_primary(tree, t, base, c);
                    if p != NONE && tree.tok.as_slice()[p as usize] == a + 1 && tk(t, a + 1) == terminals.T_INT_LIT {
                        let r = literal(cx, t, set, cut, ev, cur, a + 1, true, hint);
                        let mut x = c;
                        while x != p as usize {
                            ev.nty.as_mut_slice()[x - ev.lo] = r;
                            x = base + tree.kids.row(x)[0] as usize;
                        }
                        ev.nty.as_mut_slice()[x - ev.lo] = r;
                        ret = r;
                        entering = false;
                        continue;
                    }
                    if p != NONE && tree.tok.as_slice()[p as usize] == a + 1 && tk(t, a + 1) == terminals.T_FLOAT_LIT {
                        ev.fail(CV_UNSUP);
                        continue;
                    }
                }
                if op != terminals.T_MINUS && op != terminals.T_TILDE && op != terminals.T_BANG {
                    ev.fail(CV_UNSUP);
                    continue;
                }
                // the operand has the node's type; `!`'s is a `bool`
                fr.push(cur, hint, NO_TY);
                cur = c;
                if op == terminals.T_BANG { hint = bool_t; }
                continue;
            }
            if k == K_CAST {
                fr.push(cur, hint, NO_TY);
                cur = base + ks[0] as usize;
                hint = NONE;
                continue;
            }
            if k == K_POSTFIX {
                // an access chain: a const path, or a head decided without an expected type,
                // then parts, fields, and indexes (each a `usize`), typed in order at the end
                let head = base + ks[0] as usize;
                let ha = tree.tok.as_slice()[head];
                let (cd, p0) = const_head(cx, tree, t, ds, it, base, cur);
                let single = cd == NONE && (tk(t, ha) != terminals.T_IDENT || p0 == ha + 1);
                let p1 = if cd != NONE then p0 else tree.tok_end.as_slice()[head];
                if (cd != NONE || single) && access_steps(tree, t, base, cur, p1) {
                    let x = cur - ev.lo;
                    ev.form.as_mut_slice()[x] = F_CHAIN;
                    ev.aux.as_mut_slice()[x] = p1 as u64;
                    // its index expressions are evaluated by its steps, in order
                    for j in 1..ks.len() {
                        let ie = base + ks[j] as usize;
                        for y in ie - tree.size.as_slice()[ie] as usize..ie + 1 {
                            ev.own.as_mut_slice()[y - ev.lo] = cur as% u32;
                        }
                    }
                    if cd == NONE {
                        fr.push(cur, hint, ACC_CHAIN);
                        cur = head;
                        hint = NONE;
                        continue;
                    }
                    let hx = head - ev.lo;
                    if !const_into(cx, ev, hx, cd) { continue; }
                    if ks.len() == 1 {
                        ret = chain_ty(cx, tree, t, set, cut, nm, ds, ev, cur);
                        if ev.out != CV_OK { continue; }
                        ev.nty.as_mut_slice()[x] = ret;
                        entering = false;
                        continue;
                    }
                    fr.push(cur, hint, ACC_CHAIN);
                    let fk1 = fr.k.len() - 1;
                    fr.k.as_mut_slice()[fk1] = 2;
                    cur = base + ks[1] as usize;
                    hint = cx.tab.usize_t();
                    continue;
                }
                // a struct literal: its fields decided under their types, in the written order
                let sd = struct_lit(cx, tree, t, nm, ds, ev, base, cur);
                if sd == BAD_LIT {
                    ev.fail(CV_FAIL);
                    continue;
                }
                if sd != NONE {
                    let sl = base + ks[1] as usize;
                    ev.form.as_mut_slice()[cur - ev.lo] = F_SCOPY;
                    ev.form.as_mut_slice()[sl - ev.lo] = F_STRUCT;
                    ev.aux.as_mut_slice()[sl - ev.lo] = sd as u64;
                    let es = tree.kids.row(sl);
                    if es.len() == 0 {
                        cx.tab.begin();
                        ret = cx.tab.intern(types.TK_ADT, sd, 0) as u64;
                        ev.nty.as_mut_slice()[sl - ev.lo] = ret;
                        ev.nty.as_mut_slice()[cur - ev.lo] = ret;
                        entering = false;
                        continue;
                    }
                    fr.push(sl, hint, ACC_STRUCT);
                    cur = base + es[0] as usize;
                    hint = field_ty(cx, ds, sd, ev.part.as_slice()[cur - ev.lo]);
                    continue;
                }
            }
            if k == K_PRIMARY {
                let op = tk(t, a);
                if op == terminals.T_INT_LIT {
                    ret = literal(cx, t, set, cut, ev, cur, a, false, hint);
                    entering = false;
                    continue;
                }
                if op == terminals.T_KW_TRUE || op == terminals.T_KW_FALSE {
                    let x = cur - ev.lo;
                    ev.lit.as_mut_slice()[x] = 2;
                    ev.vmag.as_mut_slice()[x] = if op == terminals.T_KW_TRUE then 1u64 else 0u64;
                    ret = bool_t as u64;
                    ev.nty.as_mut_slice()[x] = ret;
                    entering = false;
                    continue;
                }
                if op == terminals.T_L_PAREN {
                    let close = tree.tok_end.as_slice()[cur] - 1;
                    if ks.len() == 1 && tk(t, close - 1) != terminals.T_COMMA {
                        fr.push(cur, hint, NO_TY);
                        cur = base + ks[0] as usize;
                        continue;
                    }
                    if ks.len() == 0 {
                        ev.fail(CV_UNSUP);
                        continue;
                    }
                    // a tuple: each element under the expected tuple's element, else forced
                    fr.push(cur, hint, ACC_TUPLE);
                    cur = base + ks[0] as usize;
                    hint = tuple_hint(&cx.tab, hint, ks.len(), 0);
                    continue;
                }
                if op == terminals.T_L_BRACKET {
                    let eh = elem_hint(&cx.tab, hint);
                    if ks.len() == 0 {
                        // `[]` has the expected type, an array of length 0 (none: E0202 `infer`)
                        if eh == NONE || arr_len(&cx.tab, hint) != 0 {
                            ev.defer(cx, tree, EV_INFER, cur, NONE, NONE);
                            continue;
                        }
                        if !value_ty(cx, ds, eh) {
                            ev.fail(CV_UNSUP);
                            continue;
                        }
                        let x = cur - ev.lo;
                        ev.lit.as_mut_slice()[x] = 2;
                        let pl = cx.consts.pmag.len();
                        ev.set_arr(x, pl, 0, false);
                        ret = hint as u64;
                        ev.nty.as_mut_slice()[x] = ret;
                        entering = false;
                        continue;
                    }
                    // `[e; n]`, `[a, b, ..]`: the first element under the element hint
                    fr.push(cur, hint, if eh == NONE then NO_TY else eh as u64);
                    cur = base + ks[0] as usize;
                    hint = eh;
                    continue;
                }
                if op != terminals.T_IDENT {
                    ev.fail(CV_UNSUP);
                    continue;
                }
            }
            if k == K_PRIMARY || k == K_POSTFIX || k == K_TYPE_BASE {
                // `size_of::<T>()` / `align_of::<T>()`
                if k == K_POSTFIX {
                    let head = base + ks[0] as usize;
                    let ha = tree.tok.as_slice()[head];
                    if kind(tree, head) == K_PRIMARY && tk(t, ha) == terminals.T_IDENT && is_layout_fn(nm, name_of(nm, ha)) {
                        let (ulo, uhi) = cx.uses.range(it, (head - base) as% u32);
                        if ulo == uhi {
                            let ga = child(tree, base, head, K_GENERIC_ARGS);
                            if ga == NONE || names_generic(cx, tree, it, base, ga as usize) {
                                ev.fail(CV_FAIL);
                                continue;
                            }
                            let r = cx.lay.find(cur as% u32);
                            if r == NONE {
                                cx.lay.add(cur as% u32, it, cx.sc);
                                ev.fail(CV_LAYOUT);
                                continue;
                            }
                            let st = cx.lay.st.as_slice()[r as usize];
                            if st == CV_LAYOUT {
                                cx.lay.it.as_mut_slice()[r as usize] = it;
                                cx.lay.sc.as_mut_slice()[r as usize] = cx.sc;
                                cx.lay.met.as_mut_slice()[r as usize] = true;
                            }
                            if st != CV_OK {
                                ev.fail(st);
                                continue;
                            }
                            let is_size = nm.tab.text(name_of(nm, ha) as usize).eq(std_bytes("size_of"));
                            let x = cur - ev.lo;
                            ev.lit.as_mut_slice()[x] = 2;
                            ev.vneg.as_mut_slice()[x] = false;
                            ev.vmag.as_mut_slice()[x] = if is_size then cx.lay.size.as_slice()[r as usize] else cx.lay.aln.as_slice()[r as usize];
                            ret = cx.tab.usize_t() as u64;
                            ev.nty.as_mut_slice()[x] = ret;
                            entering = false;
                            continue;
                        }
                    }
                }
                let (d, how) = path_decl(cx, tree, t, it, base, cur);
                if how == 2 {
                    // steps past a path (an index, a call): the head is evaluated first, so a
                    // head const without a value fails the whole
                    ev.fail(head_state(cx, tree, ds, it, base, cur));
                    continue;
                }
                if how == 1 || d == NONE {
                    ev.fail(CV_FAIL);
                    continue;
                }
                let dk = ds.kind.as_slice()[d as usize];
                if dk == decls.DK_CONST {
                    let cx0 = cur - ev.lo;
                    if !const_into(cx, ev, cx0, d) { continue; }
                    ret = ev.nty.as_slice()[cur - ev.lo];
                    entering = false;
                    continue;
                }
                if dk == decls.DK_VARIANT {
                    ev.fail(CV_UNSUP);
                    continue;
                }
                ev.fail(CV_FAIL);
                continue;
            }
            if k == K_MATCH {
                ev.fail(CV_FAIL);
                continue;
            }
            ev.fail(CV_UNSUP);
            continue;
        }
        // return `ret` to the top frame
        let top = fr.node.len();
        if top == 0 { return ret; }
        let f = top - 1;
        let fnode = fr.node.as_slice()[f] as usize;
        let fk = kind(tree, fnode);
        let fks = tree.kids.row(fnode);
        let fh = fr.hint.as_slice()[f];
        let kk = fr.k.as_slice()[f] as usize;
        let ftok = tree.tok.as_slice()[fnode];
        // the next child of the frame: `nk` with hint `nh`
        let mut nk: usize = 0;
        let mut nh = NONE;
        let facc = fr.acc.as_slice()[f];
        if facc == ACC_TUPLE {
            let c = base + fks[kk - 1] as usize;
            let w = tuple_hint(&cx.tab, fh, fks.len(), kk - 1);
            if w != NONE {
                if !ev.coerce(cx, tree, c, ret, w) { return NO_TY; }
            } else {
                let r = ev.resolve(ret);
                if r & LIT != 0 {
                    ev.no_type(cx, tree, r);
                    return NO_TY;
                }
            }
            if kk < fks.len() {
                nk = kk;
                nh = tuple_hint(&cx.tab, fh, fks.len(), kk);
            } else {
                let mut es = vec.Vec::<u32>.new();
                for j in 0..fks.len() {
                    let v = ev.nty.as_slice()[base + fks[j] as usize - ev.lo];
                    let r = ev.resolve(v);
                    if r & LIT != 0 || !value_ty(cx, ds, r as% u32) {
                        ev.fail(CV_UNSUP);
                        return NO_TY;
                    }
                    es.push(r as% u32);
                }
                cx.tab.begin();
                for j in 0..es.len() {
                    cx.tab.push(es.as_slice()[j]);
                }
                let tt = cx.tab.intern(types.TK_TUPLE, 0, 0);
                if !value_ty(cx, ds, tt) {
                    ev.fail(CV_UNSUP);
                    return NO_TY;
                }
                ret = tt as u64;
                ev.nty.as_mut_slice()[fnode - ev.lo] = ret;
                ev.form.as_mut_slice()[fnode - ev.lo] = F_TUPLE;
            }
        } else if facc == ACC_CHAIN {
            let c = base + fks[kk - 1] as usize;
            if kk == 1 {
                // the head decided: a value of a type
                let r = ev.resolve(ret);
                if r & LIT != 0 {
                    ev.no_type(cx, tree, r);
                    return NO_TY;
                }
            } else {
                let us = cx.tab.usize_t();
                if !ev.coerce(cx, tree, c, ret, us) { return NO_TY; }
            }
            if kk < fks.len() {
                nk = kk;
                nh = cx.tab.usize_t();
            } else {
                ret = chain_ty(cx, tree, t, set, cut, nm, ds, ev, fnode);
                if ev.out != CV_OK { return NO_TY; }
                ev.nty.as_mut_slice()[fnode - ev.lo] = ret;
            }
        } else if facc == ACC_STRUCT {
            // fnode: the `StructLit` row; its struct in `aux`
            let sd = ev.aux.as_slice()[fnode - ev.lo] as% u32;
            let c = base + fks[kk - 1] as usize;
            let ft = field_ty(cx, ds, sd, ev.part.as_slice()[c - ev.lo]);
            if !ev.coerce(cx, tree, c, ret, ft) { return NO_TY; }
            if kk < fks.len() {
                nk = kk;
                nh = field_ty(cx, ds, sd, ev.part.as_slice()[base + fks[kk] as usize - ev.lo]);
            } else {
                cx.tab.begin();
                ret = cx.tab.intern(types.TK_ADT, sd, 0) as u64;
                ev.nty.as_mut_slice()[fnode - ev.lo] = ret;
                let pf = cx.parent.as_slice()[fnode] as usize;
                ev.nty.as_mut_slice()[pf - ev.lo] = ret;
            }
        } else if (is_chain(fk) || fk == K_CAST || fk == K_AND || fk == K_OR || fk == K_CMP) && fks.len() == 1 {
            ev.nty.as_mut_slice()[fnode - ev.lo] = ret;
        } else if is_chain(fk) {
            let acc = if kk == 1 then ret else ev.unify(cx, tree, base + fks[kk - 1] as usize, fr.acc.as_slice()[f], ret);
            if ev.out != CV_OK { return NO_TY; }
            if kk < fks.len() {
                fr.acc.as_mut_slice()[f] = acc;
                nk = kk;
                nh = ev.hint_of(acc, fh);
            } else {
                ev.nty.as_mut_slice()[fnode - ev.lo] = acc;
                ret = acc;
            }
        } else if fk == K_AND || fk == K_OR {
            if !ev.coerce(cx, tree, base + fks[kk - 1] as usize, ret, bool_t) { return NO_TY; }
            if kk < fks.len() {
                nk = kk;
                nh = bool_t;
            } else {
                ret = bool_t as u64;
                ev.nty.as_mut_slice()[fnode - ev.lo] = ret;
            }
        } else if fk == K_IF {
            if kk == 1 {
                if !ev.coerce(cx, tree, base + fks[0] as usize, ret, bool_t) { return NO_TY; }
                nk = 1;
                nh = fh;
            } else if kk == 2 {
                fr.acc.as_mut_slice()[f] = ret;
                nk = 2;
                nh = ev.hint_of(ret, fh);
            } else {
                ret = ev.unify(cx, tree, base + fks[2] as usize, fr.acc.as_slice()[f], ret);
                if ev.out != CV_OK { return NO_TY; }
                ev.nty.as_mut_slice()[fnode - ev.lo] = ret;
            }
        } else if fk == K_CMP {
            if kk == 1 {
                fr.acc.as_mut_slice()[f] = ret;
                nk = 2;
                nh = ev.hint_of(ret, NONE);
            } else {
                let u = ev.unify(cx, tree, base + fks[2] as usize, fr.acc.as_slice()[f], ret);
                if ev.out != CV_OK { return NO_TY; }
                ev.aux.as_mut_slice()[fnode - ev.lo] = u;
                ret = bool_t as u64;
                ev.nty.as_mut_slice()[fnode - ev.lo] = ret;
            }
        } else if fk == K_UNARY {
            if tk(t, ftok) == terminals.T_BANG {
                if !ev.coerce(cx, tree, base + fks[0] as usize, ret, bool_t) { return NO_TY; }
                ret = bool_t as u64;
            }
            ev.nty.as_mut_slice()[fnode - ev.lo] = ret;
        } else if fk == K_PRIMARY && tk(t, ftok) == terminals.T_L_BRACKET {
            let eh = elem_hint(&cx.tab, fh);
            let rep = fks.len() == 2 && tk(t, tree.tok_end.as_slice()[base + fks[0] as usize]) == terminals.T_SEMI;
            if rep && kk == 1 {
                // the element: a literal takes the element hint (none: E0202); then the count,
                // a `usize` evaluated on its own (its groups from the mark in `acc`)
                let r = ev.resolve(ret);
                let mut elem = r as% u32;
                if r & LIT != 0 {
                    if eh == NONE {
                        ev.no_type(cx, tree, r);
                        return NO_TY;
                    }
                    if !ev.coerce(cx, tree, base + fks[0] as usize, ret, eh) { return NO_TY; }
                    elem = eh;
                }
                if !value_ty(cx, ds, elem) {
                    ev.fail(CV_UNSUP);
                    return NO_TY;
                }
                fr.acc.as_mut_slice()[f] = ((elem as u64) << 32) | ev.gpar.len() as u64;
                nk = 1;
                nh = cx.tab.usize_t();
            } else if rep {
                let c = base + fks[1] as usize;
                let us = cx.tab.usize_t();
                if !ev.coerce(cx, tree, c, ret, us) { return NO_TY; }
                let mark = fr.acc.as_slice()[f];
                let clo = c - tree.size.as_slice()[c] as usize;
                if !settle(cx, tree, t, ev, clo, c, (mark & 0xffff_ffff) as usize) { return NO_TY; }
                let ow = ev.own.as_slice()[c - ev.lo];
                let r = value(cx, tree, t, ds, ev, clo, c, ow);
                if r != CV_OK {
                    ev.fail(r);
                    return NO_TY;
                }
                for x in clo..c + 1 {
                    ev.done.as_mut_slice()[x - ev.lo] = true;
                }
                let at = array_of(cx, ds, (mark >> 32) as% u32, ev.vmag.as_slice()[c - ev.lo]);
                if at == types.ERR || at == NONE {
                    ev.fail(if at == NONE then CV_UNSUP else CV_FAIL);
                    return NO_TY;
                }
                ret = at as u64;
                ev.nty.as_mut_slice()[fnode - ev.lo] = ret;
            } else {
                // the element type: the hint's, else the first element's that has one
                let mut et = fr.acc.as_slice()[f];
                if et == NO_TY {
                    let r = ev.resolve(ret);
                    if r & LIT == 0 { et = r; }
                }
                fr.acc.as_mut_slice()[f] = et;
                if kk < fks.len() {
                    nk = kk;
                    nh = if et == NO_TY then NONE else et as% u32;
                } else {
                    if et == NO_TY {
                        // every element a literal: one group, then no context (E0202)
                        let mut u = ev.nty.as_slice()[base + fks[0] as usize - ev.lo];
                        for j in 1..fks.len() {
                            let v = ev.nty.as_slice()[base + fks[j] as usize - ev.lo];
                            u = ev.unify(cx, tree, base + fks[j] as usize, u, v);
                            if ev.out != CV_OK { return NO_TY; }
                        }
                        ev.no_type(cx, tree, u);
                        return NO_TY;
                    }
                    let elem = et as% u32;
                    for j in 0..fks.len() {
                        let c = base + fks[j] as usize;
                        let v = ev.nty.as_slice()[c - ev.lo];
                        if !ev.coerce(cx, tree, c, v, elem) { return NO_TY; }
                    }
                    if !value_ty(cx, ds, elem) {
                        ev.fail(CV_UNSUP);
                        return NO_TY;
                    }
                    let at = array_of(cx, ds, elem, fks.len() as u64);
                    if at == types.ERR || at == NONE {
                        ev.fail(if at == NONE then CV_UNSUP else CV_FAIL);
                        return NO_TY;
                    }
                    ret = at as u64;
                    ev.nty.as_mut_slice()[fnode - ev.lo] = ret;
                }
            }
        } else if fk == K_PRIMARY {
            ev.nty.as_mut_slice()[fnode - ev.lo] = ret;
        } else if fk == K_CAST {
            // the operand has no expected type; each step names an int type
            let r = ev.resolve(ret);
            if r & LIT != 0 {
                ev.no_type(cx, tree, r);
                return NO_TY;
            }
            let mut src = r as% u32;
            for j in 1..fks.len() {
                let c = base + fks[j] as usize;
                let op = tk(t, tree.tok.as_slice()[c] - 1);
                let to = cast_target(cx, tree, t, nm, base, c);
                if to == NONE || cx.tab.tag_of(src) != types.TK_INT || (op != terminals.T_KW_AS && op != terminals.T_AS_PERCENT && op != terminals.T_AS_PIPE) {
                    ev.fail(CV_UNSUP);
                    return NO_TY;
                }
                if op == terminals.T_KW_AS && src != to {
                    let fs = cx.tab.is_signed(src);
                    let ts = cx.tab.is_signed(to);
                    let fb = cx.tab.int_bits(src);
                    let tb = cx.tab.int_bits(to);
                    if !((fs == ts && tb >= fb) || (!fs && ts && tb > fb)) {
                        let optok = tree.tok.as_slice()[c] - 1;
                        if cx.dfr.code == 0 { cx.dfr = Defer.{ code: EV_LOSSY, it: ev.it, lo: optok, hi: tree.tok_end.as_slice()[c] - 1, ty: src, x: to }; }
                        ev.fail(CV_FAIL);
                        return NO_TY;
                    }
                }
                ev.cast_to.as_mut_slice()[c - ev.lo] = to;
                src = to;
            }
            ret = src as u64;
            ev.nty.as_mut_slice()[fnode - ev.lo] = ret;
        }
        if nk != 0 {
            fr.k.as_mut_slice()[f] = (nk + 1) as% u32;
            cur = base + fks[nk] as usize;
            hint = nh;
            entering = true;
            continue;
        }
        fr.node.truncate(f);
        fr.hint.truncate(f);
        fr.k.truncate(f);
        fr.acc.truncate(f);
    }
}

// Whether name S is `size_of` or `align_of`.
fn is_layout_fn(nm: &intern.Interned, s: u32) -> bool {
    if s == NONE || s as usize >= nm.tab.len() { return false; }
    let b = nm.tab.text(s as usize);
    return b.eq(std_bytes("size_of")) || b.eq(std_bytes("align_of"));
}

fn name_of(nm: &intern.Interned, tok: u32) -> u32 {
    return nm.tok_str.as_slice()[tok as usize];
}

// The `Primary` under row c through parentheses, or NONE.
fn down_to_primary(tree: &ast.Ast, t: &lex.Tokens, base: usize, c: usize) -> u32 {
    let mut cur = c;
    loop {
        if kind(tree, cur) != K_PRIMARY { return NONE; }
        let a = tree.tok.as_slice()[cur];
        if tk(t, a) != terminals.T_L_PAREN { return cur as% u32; }
        let ks = tree.kids.row(cur);
        let close = tree.tok_end.as_slice()[cur] - 1;
        if ks.len() != 1 || tk(t, close - 1) == terminals.T_COMMA { return NONE; }
        cur = base + ks[0] as usize;
    }
}

// A literal at token tok (node row g; `neg`: a folded unary minus).
fn literal(cx: &mut Cx, t: &lex.Tokens, set: &source.SourceSet, cut: &items.Items, ev: &mut Ev, g: usize, tok: u32, neg: bool, hint: u32) -> u64 {
    let f = cut.file.as_slice()[ev.it as usize] as usize;
    let (s, e) = lit_text(t, set, cut, ev.it, tok);
    let (mag, big, suf) = parse_int(&set.file(f)[s..e]);
    if suf == 0xff {
        ev.fail(CV_FAIL);
        return NO_TY;
    }
    if suf == 100 {
        ev.fail(CV_UNSUP);
        return NO_TY;
    }
    let x = g - ev.lo;
    ev.lit.as_mut_slice()[x] = 1;
    ev.lneg.as_mut_slice()[x] = neg && mag != 0;
    ev.lmag.as_mut_slice()[x] = mag;
    ev.lbig.as_mut_slice()[x] = big;
    let mut r: u64 = 0;
    if suf != 0 {
        r = suffix_ty(&mut cx.tab, suf) as u64;
    } else {
        let gid = ev.gpar.len() as% u32;
        ev.gpar.push(gid);
        ev.gfix.push(NONE);
        ev.gfirst.push(g as% u32);
        if hint != NONE { let _ = ev.fix(&cx.tab, gid, hint); }
        r = LIT | (gid as u64);
    }
    ev.nty.as_mut_slice()[x] = r;
    return r;
}

// The checks of rows first..=last once decided, as stage0's `settle`: every group made since mark
// g0 has a type (else E0202), then every literal fits its type (else E0203 at it), then every
// operator is defined on its type (else E0206, or E0904 for a user type). False: the evaluation
// failed.
fn settle(cx: &mut Cx, tree: &ast.Ast, t: &lex.Tokens, ev: &mut Ev, first: usize, last: usize, g0: usize) -> bool {
    for k in g0..ev.gpar.len() {
        let r = ev.find(k as% u32);
        if ev.gfix.as_slice()[r as usize] == NONE {
            ev.no_type(cx, tree, LIT | r as u64);
            return false;
        }
    }
    for row in first..last + 1 {
        let x = row - ev.lo;
        let ty = ev.nty.as_slice()[x];
        if ty == NO_TY || ev.done.as_slice()[x] { continue; }
        let rt = ev.resolve(ty);
        ev.nty.as_mut_slice()[x] = rt;
        if ev.lit.as_slice()[x] == 1 && (ev.lbig.as_slice()[x] || !in_range(&cx.tab, rt as% u32, ev.lneg.as_slice()[x], ev.lmag.as_slice()[x])) {
            ev.defer(cx, tree, EV_RANGE, row, rt as% u32, NONE);
            return false;
        }
    }
    for row in first..last + 1 {
        let x = row - ev.lo;
        let rt = ev.nty.as_slice()[x];
        if rt == NO_TY || ev.lit.as_slice()[x] != 0 || ev.done.as_slice()[x] { continue; }
        let k = kind(tree, row);
        let n = tree.kids.row(row).len();
        let tag = cx.tab.tag_of(rt as% u32);
        let mut ok = true;
        if is_chain(k) && n > 1 {
            ok = tag == types.TK_INT || (tag == types.TK_BOOL && (k == K_BIT_AND || k == K_BIT_OR || k == K_BIT_XOR));
        } else if k == K_UNARY {
            let op = tk(t, tree.tok.as_slice()[row]);
            if op == terminals.T_MINUS { ok = tag == types.TK_INT && cx.tab.is_signed(rt as% u32); }
            if op == terminals.T_TILDE { ok = tag == types.TK_INT; }
        } else if k == K_CMP && n > 1 {
            let a0 = ev.aux.as_slice()[x];
            let ot = ev.resolve(a0);
            ev.aux.as_mut_slice()[x] = ot;
            let otag = cx.tab.tag_of(ot as% u32);
            ok = ot & LIT == 0 && (otag == types.TK_INT || otag == types.TK_BOOL);
        }
        if !ok {
            ev.fail(CV_FAIL);
            return false;
        }
    }
    return true;
}

// The value pass over rows first..=last in node order (node ids are postorder: a node's operands
// come first), lazy where the run time is: the arm of an `if` not taken and the operands of a
// `&&` / `||` past the one that decides it are skipped. An operation that would trap at run time
// (overflow, division by zero, `MIN / -1`, an index past the end) is reported here, stage0's
// E0203 at it.
rec fn value(cx: &mut Cx, tree: &ast.Ast, t: &lex.Tokens, ds: &decls.Decls, ev: &mut Ev, first: usize, last: usize, owner: u32) -> u8 {
    let base = ev.base;
    // rows below `skip` are not evaluated
    let mut skip = first;
    for row in first..last + 1 {
        if row < skip { continue; }
        let x = row - ev.lo;
        let ty = ev.nty.as_slice()[x];
        if ty == NO_TY || ev.done.as_slice()[x] || ev.own.as_slice()[x] != owner { continue; }
        let l = ev.lit.as_slice()[x];
        let k = kind(tree, row);
        let ks = tree.kids.row(row);
        let tt = ty as% u32;
        let fm = ev.form.as_slice()[x];
        if l == 1 {
            ev.vneg.as_mut_slice()[x] = ev.lneg.as_slice()[x];
            ev.vmag.as_mut_slice()[x] = ev.lmag.as_slice()[x];
        } else if l == 2 {} else if k == K_PRIMARY && tk(t, tree.tok.as_slice()[row]) == terminals.T_L_BRACKET {
            // the elements' leaves; a repeat keeps its one element's
            let pl = cx.consts.pmag.len();
            let rep = ks.len() == 2 && tk(t, tree.tok_end.as_slice()[base + ks[0] as usize]) == terminals.T_SEMI;
            let cnt = if rep then 1usize else ks.len();
            for j in 0..cnt {
                let c = base + ks[j] as usize - ev.lo;
                let ct = ev.nty.as_slice()[c] as% u32;
                if !expand(cx, ev, c, ct) { return CV_UNSUP; }
            }
            let n = (cx.consts.pmag.len() - pl) as% u32;
            ev.set_arr(x, pl, n, rep);
        } else if fm == F_TUPLE || fm == F_STRUCT {
            // the parts' leaves in order: tuple elements, struct fields by declaration
            let pl = cx.consts.pmag.len();
            let mut at = vec.Vec::<u32>.new();
            for j in 0..ks.len() {
                at.push((base + ks[j] as usize - ev.lo) as% u32);
            }
            if fm == F_STRUCT {
                for j in 0..ks.len() {
                    let c = base + ks[j] as usize - ev.lo;
                    at.as_mut_slice()[ev.part.as_slice()[c] as usize] = c as% u32;
                }
            }
            for j in 0..at.len() {
                let c = at.as_slice()[j] as usize;
                let ct = ev.nty.as_slice()[c] as% u32;
                if !expand(cx, ev, c, ct) { return CV_UNSUP; }
            }
            let n = (cx.consts.pmag.len() - pl) as% u32;
            ev.set_arr(x, pl, n, false);
        } else if fm == F_SCOPY {
            ev.copy_val(x, base + ks[1] as usize - ev.lo);
        } else if fm == F_CHAIN {
            // from the head's value, each step in turn: an index past the end traps `Bounds` at
            // run time
            let h = base + ks[0] as usize - ev.lo;
            let mut neg = ev.vneg.as_slice()[h];
            let mut mag = ev.vmag.as_slice()[h];
            let mut vl = ev.vlo.as_slice()[h];
            let mut vn = ev.vn.as_slice()[h];
            let mut rep = ev.vrep.as_slice()[h];
            let a = ev.aux.as_slice()[x];
            let st = (a >> 32) as usize;
            for s in st..st + (a & 0xffff_ffff) as usize {
                let e = ev.sp.as_slice()[s];
                let bt = ev.sty.as_slice()[s];
                let mut pt = NONE;
                let mut p: u64 = 0;
                if e & STEP_PART != 0 {
                    let (q, off) = part_of(cx, ds, bt, (e & ~STEP_PART) as usize);
                    pt = q;
                    p = vl as u64 + off;
                } else {
                    // the index evaluated here, after the steps before it
                    let ie = e as usize + ev.lo;
                    let r = value(cx, tree, t, ds, ev, ie - tree.size.as_slice()[ie] as usize, ie, row as% u32);
                    if r != CV_OK { return r; }
                    let i = ev.vmag.as_slice()[e as usize];
                    let n = arr_len(&cx.tab, bt);
                    if i >= n {
                        cx.rep.add(EV_INDEX, ev.it, tree.tok.as_slice()[ie], tree.tok_end.as_slice()[ie] - 1, bt, n as% u32);
                        return CV_FAIL;
                    }
                    pt = cx.tab.a_of(bt);
                    p = vl as u64 + (if rep then 0u64 else i * leaves(cx, ds, pt, 0));
                }
                if scalar_elem(&cx.tab, pt) {
                    neg = cx.consts.pneg.as_slice()[p as usize];
                    mag = cx.consts.pmag.as_slice()[p as usize];
                    vl = NONE;
                } else {
                    vl = p as% u32;
                    vn = leaves(cx, ds, pt, 0) as% u32;
                }
                rep = false;
            }
            ev.vneg.as_mut_slice()[x] = neg;
            ev.vmag.as_mut_slice()[x] = mag;
            ev.set_arr(x, vl as usize, vn, rep);
        } else if k == K_IF {
            let c = base + ks[0] as usize - ev.lo;
            let arm = if ev.vmag.as_slice()[c] == 1 then ks[1] else ks[2];
            ev.copy_val(x, base + arm as usize - ev.lo);
        } else if (k == K_AND || k == K_OR) && ks.len() > 1 {
            // the first operand that decides it, else the last
            let is_or = k == K_OR;
            let mut v = !is_or;
            for j in 0..ks.len() {
                if (ev.vmag.as_slice()[base + ks[j] as usize - ev.lo] == 1) == is_or {
                    v = is_or;
                    break;
                }
            }
            ev.vmag.as_mut_slice()[x] = if v then 1u64 else 0u64;
        } else if k == K_CMP && ks.len() > 1 {
            let a = base + ks[0] as usize - ev.lo;
            let b = base + ks[2] as usize - ev.lo;
            let c = cmp_vals(ev.vneg.as_slice()[a], ev.vmag.as_slice()[a], ev.vneg.as_slice()[b], ev.vmag.as_slice()[b]);
            let op = tk(t, tree.tok.as_slice()[base + ks[1] as usize]);
            let v = if op == terminals.T_EQ_EQ then c == 0 else if op == terminals.T_BANG_EQ then c != 0 else if op == terminals.T_LT then c < 0 else if op == terminals.T_LT_EQ then c <= 0 else if op == terminals.T_GT then c > 0 else c >= 0;
            ev.vmag.as_mut_slice()[x] = if v then 1u64 else 0u64;
        } else if k == K_PRIMARY || ((is_chain(k) || k == K_CAST || k == K_AND || k == K_OR || k == K_CMP) && ks.len() == 1) {
            if ks.len() > 0 { ev.copy_val(x, base + ks[0] as usize - ev.lo); }
        } else if k == K_UNARY {
            let c = base + ks[0] as usize - ev.lo;
            let cn = ev.vneg.as_slice()[c];
            let cm = ev.vmag.as_slice()[c];
            let op = tk(t, tree.tok.as_slice()[row]);
            if op == terminals.T_BANG {
                ev.vmag.as_mut_slice()[x] = 1 - cm;
            } else if op == terminals.T_MINUS {
                let (_, lo, _) = range_of(&cx.tab, tt);
                if cn && cm == lo {
                    cx.rep.add(EV_RANGE, ev.it, tree.tok.as_slice()[row], tree.tok_end.as_slice()[row] - 1, tt, NONE);
                    return CV_FAIL;
                }
                ev.vneg.as_mut_slice()[x] = !cn && cm != 0;
                ev.vmag.as_mut_slice()[x] = cm;
            } else {
                let (rn, rm) = wrap(~word(cn, cm), cx.tab.is_signed(tt), cx.tab.int_bits(tt));
                ev.vneg.as_mut_slice()[x] = rn;
                ev.vmag.as_mut_slice()[x] = rm;
            }
        } else if k == K_CAST {
            // each step in turn, its target type kept at its `Type` row
            let c = base + ks[0] as usize - ev.lo;
            let mut rn = ev.vneg.as_slice()[c];
            let mut rm = ev.vmag.as_slice()[c];
            for j in 1..ks.len() {
                let tn = base + ks[j] as usize;
                let to = ev.cast_to.as_slice()[tn - ev.lo];
                let op = tk(t, tree.tok.as_slice()[tn] - 1);
                let (sn, sm) = if op == terminals.T_AS_PERCENT then wrap(word(rn, rm), cx.tab.is_signed(to), cx.tab.int_bits(to)) else clamp(&cx.tab, to, rn, rm, false);
                rn = sn;
                rm = sm;
            }
            ev.vneg.as_mut_slice()[x] = rn;
            ev.vmag.as_mut_slice()[x] = rm;
        } else if is_chain(k) {
            let c0 = base + ks[0] as usize;
            let mut an = ev.vneg.as_slice()[c0 - ev.lo];
            let mut am = ev.vmag.as_slice()[c0 - ev.lo];
            let bit = cx.tab.tag_of(tt) == types.TK_BOOL;
            for j in 1..ks.len() {
                let cr = base + ks[j] as usize;
                let c = cr - ev.lo;
                let op = tk(t, tree.tok.as_slice()[cr] - 1);
                let (st, rn, rm) = if bit then (A_OK, false, bool_op(op, am, ev.vmag.as_slice()[c])) else arith(&cx.tab, tt, op, an, am, ev.vneg.as_slice()[c], ev.vmag.as_slice()[c]);
                if st == A_OVER {
                    // the operation from the chain's first operand through this one
                    cx.rep.add(EV_RANGE, ev.it, tree.tok.as_slice()[c0], tree.tok_end.as_slice()[cr] - 1, tt, NONE);
                    return CV_FAIL;
                }
                if st != A_OK { return CV_FAIL; }
                an = rn;
                am = rm;
            }
            ev.vneg.as_mut_slice()[x] = an;
            ev.vmag.as_mut_slice()[x] = am;
        }
        // laziness: what the value of row decides of its parent's other operands
        let p = cx.parent.as_slice()[row];
        if p == NONE || p as usize > last { continue; }
        let pk = kind(tree, p as usize);
        let pks = tree.kids.row(p as usize);
        if pk == K_IF && pks.len() == 3 {
            if row == base + pks[0] as usize && ev.vmag.as_slice()[x] == 0 { skip = base + pks[1] as usize + 1; }
            if row == base + pks[1] as usize { skip = base + pks[2] as usize + 1; }
        }
        if (pk == K_AND || pk == K_OR) && pks.len() > 1 && (ev.vmag.as_slice()[x] == 1) == (pk == K_OR) {
            skip = base + pks[pks.len() - 1] as usize + 1;
        }
    }
    return CV_OK;
}

// The order of two values (neg, mag): -1, 0, 1.
fn cmp_vals(an: bool, am: u64, bn: bool, bm: u64) -> i32 {
    if an != bn { return if an then -1i32 else 1i32; }
    if am == bm { return 0i32; }
    let less = if an then am > bm else am < bm;
    return if less then -1i32 else 1i32;
}

// `&`, `|`, `^` on `bool`s (0 or 1).
fn bool_op(op: u8, a: u64, b: u64) -> u64 {
    if op == terminals.T_AMP { return a & b; }
    if op == terminals.T_PIPE { return a | b; }
    return a ^ b;
}

// (neg, mag) saturated into type t; `exact_over`: the exact value overflowed 64 bits.
fn clamp(tab: &types.Table, t: u32, neg: bool, mag: u64, exact_over: bool) -> (bool, u64) {
    let (_, lo, hi) = range_of(tab, t);
    if neg {
        if !tab.is_signed(t) { return (false, 0); }
        if exact_over || mag > lo { return (true, lo); }
        return (true, mag);
    }
    if exact_over || mag > hi { return (false, hi); }
    return (false, mag);
}

// One integer operation in type t: (status `A_*`, neg, mag).
fn arith(tab: &types.Table, t: u32, op: u8, an: bool, am: u64, bn: bool, bm: u64) -> (u8, bool, u64) {
    let signed = tab.is_signed(t);
    let bits = tab.int_bits(t);
    if op == terminals.T_PLUS || op == terminals.T_MINUS || op == terminals.T_PLUS_PIPE || op == terminals.T_MINUS_PIPE {
        let sub = op == terminals.T_MINUS || op == terminals.T_MINUS_PIPE;
        let (rn, rm, over) = add_exact(an, am, if sub then !bn && bm != 0 else bn, bm);
        if op == terminals.T_PLUS_PIPE || op == terminals.T_MINUS_PIPE {
            let (cn, cm) = clamp(tab, t, rn, rm, over);
            return (A_OK, cn, cm);
        }
        if over || !in_range(tab, t, rn, rm) { return (A_OVER, false, 0); }
        return (A_OK, rn, rm);
    }
    if op == terminals.T_STAR || op == terminals.T_STAR_PIPE {
        let over = am.mul_hi(bm) != 0;
        let rm = am *% bm;
        let rn = (an != bn) && rm != 0;
        if op == terminals.T_STAR_PIPE {
            let (cn, cm) = clamp(tab, t, an != bn, rm, over);
            return (A_OK, cn, cm);
        }
        if over || !in_range(tab, t, rn, rm) { return (A_OVER, false, 0); }
        return (A_OK, rn, rm);
    }
    if op == terminals.T_SLASH || op == terminals.T_PERCENT {
        let (_, lo, _) = range_of(tab, t);
        if bm == 0 || (signed && an && am == lo && bn && bm == 1) { return (A_OVER, false, 0); }
        if op == terminals.T_SLASH {
            let q = am / bm;
            return (A_OK, (an != bn) && q != 0, q);
        }
        let r = am % bm;
        return (A_OK, an && r != 0, r);
    }
    if op == terminals.T_PLUS_PERCENT || op == terminals.T_MINUS_PERCENT || op == terminals.T_STAR_PERCENT {
        let x = word(an, am);
        let y = word(bn, bm);
        let w = if op == terminals.T_PLUS_PERCENT then x +% y else if op == terminals.T_MINUS_PERCENT then x -% y else x *% y;
        let (rn, rm) = wrap(w, signed, bits);
        return (A_OK, rn, rm);
    }
    if op == terminals.T_AMP || op == terminals.T_PIPE || op == terminals.T_CARET {
        let x = word(an, am);
        let y = word(bn, bm);
        let w = if op == terminals.T_AMP then x & y else if op == terminals.T_PIPE then x | y else x ^ y;
        let (rn, rm) = wrap(w, signed, bits);
        return (A_OK, rn, rm);
    }
    if op == terminals.T_LT_LT || op == terminals.T_LT_LT_PERCENT || op == terminals.T_GT_GT {
        let mut amt_neg = bn && bm != 0;
        let mut amt = bm;
        if op == terminals.T_LT_LT_PERCENT {
            amt = word(bn, bm) & (bits as u64 - 1);
            amt_neg = false;
        }
        if amt_neg || amt >= bits as u64 { return (A_SHIFT, false, 0); }
        let x = word(an, am);
        if op == terminals.T_GT_GT {
            if signed {
                let (vn, vm) = wrap(x, true, bits);
                if vn {
                    // arithmetic shift of a negative value: -((m - 1) >> amt) - 1
                    let q = (vm - 1) >> amt;
                    return (A_OK, true, q + 1);
                }
                return (A_OK, false, vm >> amt);
            }
            let (_, vm) = wrap(x, false, bits);
            return (A_OK, false, vm >> amt);
        }
        let (rn, rm) = wrap(x << amt, signed, bits);
        return (A_OK, rn, rm);
    }
    return (A_NONE, false, 0);
}

// An array length or const generic argument: the const parameter it names, or its value as a
// `u64`, as generic-argument words (kind, x, y). A bare const generic param names itself; any
// other expression is evaluated as type `want`. `typed`: the caller types the expression itself
// (a repeat count of a body), so only what fails an operation is reported here; else the
// evaluation's first failure that reports nothing is reported too (stage0: no other checker
// types these expressions).
pub fn eval_u64(cx: &mut Cx, tree: &ast.Ast, t: &lex.Tokens, nm: &intern.Interned, set: &source.SourceSet, cut: &items.Items, ds: &decls.Decls, it: u32, g: usize, want: u32, sc: Scope, typed: bool) -> (u32, u32, u32) {
    let base = tree.item_node.as_slice()[it as usize] as usize;
    if kind(tree, g) == K_PRIMARY && tk(t, tree.tok.as_slice()[g]) == terminals.T_IDENT && tree.tok_end.as_slice()[g] == tree.tok.as_slice()[g] + 1 {
        let (lo, hi) = cx.uses.range(it, (g - base) as% u32);
        if lo < hi && cx.uses.tag.as_slice()[lo] == resolve.TAG_LOCAL {
            let gp = base + cx.uses.target.as_slice()[lo] as usize;
            if kind(tree, gp) == K_GENERIC_PARAM && tk(t, tree.tok.as_slice()[gp]) == terminals.T_KW_CONST {
                let (idx, _, _) = generic_index(cx, tree, t, ds, it, gp, sc);
                return const_param_arg(cx, tree, it, g, idx, want, sc, !typed);
            }
        }
    }
    cx.sc = sc;
    let (st, _, neg, mag) = eval(cx, tree, t, nm, set, cut, ds, it, g, want);
    if st == CV_OK {
        if neg { return (types.GA_ERROR, 0, 0); }
        return (types.GA_VALUE, (mag >> 32) as% u32, mag as% u32);
    }
    if st == CV_FAIL && !typed && cx.dfr.code != 0 {
        let d = cx.dfr;
        cx.rep.add(d.code, d.it, d.lo, d.hi, d.ty, d.x);
    }
    if st == CV_UNSUP { cx.note_skip(st); }
    if st == CV_LAYOUT { cx.hits = cx.hits + 1; }
    return (types.GA_ERROR, 0, 0);
}

// Const param idx given at node row g of item it where a const of type `want` is required:
// itself, or an error when its declared type differs (E0201 at g when `report`).
pub fn const_param_arg(cx: &mut Cx, tree: &ast.Ast, it: u32, g: usize, idx: u32, want: u32, sc: Scope, report: bool) -> (u32, u32, u32) {
    let r = sc.row(idx);
    if r == NONE || want == NONE { return (types.GA_PARAM, idx, 0); }
    if !cx.gens.is_const.as_slice()[r as usize] { return (types.GA_PARAM, idx, 0); }
    let ct = cx.gens.cty.as_slice()[r as usize];
    if ct == want || ct == types.ERR || want == types.ERR { return (types.GA_PARAM, idx, 0); }
    if report { cx.rep.add(EV_MISMATCH, it, tree.tok.as_slice()[g], tree.tok_end.as_slice()[g] - 1, want, ct); }
    return (types.GA_ERROR, 0, 0);
}

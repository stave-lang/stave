    99, 97, 108, 108, 32, 111, 110, 32, 116, 104, 101, 32, 119, 97, 121,
    // 496 E1406: "drop on the way"
    100, 114, 111, 112, 32, 111, 110, 32, 116, 104, 101, 32, 119, 97, 121,
    // 497 E1407: "`Flat` required here"
    96, 70, 108, 97, 116, 96, 32, 114, 101, 113, 117, 105, 114, 101, 100, 32,
    104, 101, 114, 101,
    // 498 E1407: "the `Flat` bound is on this parameter"
    116, 104, 101, 32, 96, 70, 108, 97, 116, 96, 32, 98, 111, 117, 110, 100,
    32, 105, 115, 32, 111, 110, 32, 116, 104, 105, 115, 32, 112, 97, 114, 97,
    109, 101, 116, 101, 114,
    // 499 E1407 depth: "`Flat` required here"
    96, 70, 108, 97, 116, 96, 32, 114, 101, 113, 117, 105, 114, 101, 100, 32,
    104, 101, 114, 101,
    // 500 E1407 depth: "the `Flat` bound is on this parameter"
    116, 104, 101, 32, 96, 70, 108, 97, 116, 96, 32, 98, 111, 117, 110, 100,
    32, 105, 115, 32, 111, 110, 32, 116, 104, 105, 115, 32, 112, 97, 114, 97,
    109, 101, 116, 101, 114,
    // 501 E1407 self: "`Flat` required here"
    96, 70, 108, 97, 116, 96, 32, 114, 101, 113, 117, 105, 114, 101, 100, 32,
    104, 101, 114, 101,
    // 502 E1407 self: "the `Flat` bound is on this parameter"
    116, 104, 101, 32, 96, 70, 108, 97, 116, 96, 32, 98, 111, 117, 110, 100,
    32, 105, 115, 32, 111, 110, 32, 116, 104, 105, 115, 32, 112, 97, 114, 97,
    109, 101, 116, 101, 114,
    // 503 E1408: "remove this impl"
    114, 101, 109, 111, 118, 101, 32, 116, 104, 105, 115, 32, 105, 109, 112, 108,
    // 504 E1409: "this closure literal is part of the cycle"
    116, 104, 105, 115, 32, 99, 108, 111, 115, 117, 114, 101, 32, 108, 105, 116,
    101, 114, 97, 108, 32, 105, 115, 32, 112, 97, 114, 116, 32, 111, 102, 32,
    116, 104, 101, 32, 99, 121, 99, 108, 101,
    // 505 E1409: "next call of the cycle"
    110, 101, 120, 116, 32, 99, 97, 108, 108, 32, 111, 102, 32, 116, 104, 101,
    32, 99, 121, 99, 108, 101,
    // 506 E1410: "`Frozen` required here"
    96, 70, 114, 111, 122, 101, 110, 96, 32, 114, 101, 113, 117, 105, 114, 101,
    100, 32, 104, 101, 114, 101,
    // 507 E1410: "the `Frozen` bound is on this parameter"
    116, 104, 101, 32, 96, 70, 114, 111, 122, 101, 110, 96, 32, 98, 111, 117,
    110, 100, 32, 105, 115, 32, 111, 110, 32, 116, 104, 105, 115, 32, 112, 97,
    114, 97, 109, 101, 116, 101, 114,
    // 508 E1410 depth: "`Frozen` required here"
    96, 70, 114, 111, 122, 101, 110, 96, 32, 114, 101, 113, 117, 105, 114, 101,
    100, 32, 104, 101, 114, 101,
    // 509 E1410 depth: "the `Frozen` bound is on this parameter"
    116, 104, 101, 32, 96, 70, 114, 111, 122, 101, 110, 96, 32, 98, 111, 117,
    110, 100, 32, 105, 115, 32, 111, 110, 32, 116, 104, 105, 115, 32, 112, 97,
    114, 97, 109, 101, 116, 101, 114,
    // 510 E1410 self: "`Frozen` required here"
    96, 70, 114, 111, 122, 101, 110, 96, 32, 114, 101, 113, 117, 105, 114, 101,
    100, 32, 104, 101, 114, 101,
    // 511 E1410 self: "the `Frozen` bound is on this parameter"
    116, 104, 101, 32, 96, 70, 114, 111, 122, 101, 110, 96, 32, 98, 111, 117,
    110, 100, 32, 105, 115, 32, 111, 110, 32, 116, 104, 105, 115, 32, 112, 97,
    114, 97, 109, 101, 116, 101, 114,
    // 512 E1411: "no instance of this fn recurses"
    110, 111, 32, 105, 110, 115, 116, 97, 110, 99, 101, 32, 111, 102, 32, 116,
    104, 105, 115, 32, 102, 110, 32, 114, 101, 99, 117, 114, 115, 101, 115,
];


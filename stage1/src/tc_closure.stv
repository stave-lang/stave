// Closure literals and fn-type coercions of the body checker (types/check, see `typeck`).
//
// A closure literal, as stage0's `closure`: the params take their written types, the body is
// checked with the written return type (none: `()`) for its `return`s, and the value is the fn
// type of those params and that return, with the enclosing fn's features and no deny clause.
// What a closure captures does not change its type. A param or return type that does not lower
// is a type error.
//
// The coercions `coerce` cannot decide from the two types alone (`node_coercions`), as stage0's
// `coerce`: to a fn type, a value `if` / `match` or parentheses convert each arm instead, and a
// fn value made right there (a closure literal or a fn item, through wrappers) also converts to
// a type that denies more effects (it is made with them); an f-string (through parentheses)
// converts to `&str`; any other is a type error.
import ast;
import consteval;
import decls;
import generated.node_kinds;
import generated.terminals;
import intern;
import items;
import lex;
import sigs;
import source;
import tc_rows;
import ir.types;
import std.vec;

const NONE: u32 = tc_rows.NONE;
const ERR: u32 = types.ERR;
const UNK: u32 = tc_rows.UNK;

const K_BLOCK: u8 = node_kinds.KIND_BLOCK;
const K_PARAM: u8 = node_kinds.KIND_PARAM;
const K_PARAMS: u8 = node_kinds.KIND_PARAMS;
const K_TYPE: u8 = node_kinds.KIND_TYPE;
const K_IF_EXPR: u8 = node_kinds.KIND_IF_EXPR;
const K_MATCH: u8 = node_kinds.KIND_MATCH_EXPR;
const K_PRIMARY: u8 = node_kinds.KIND_PRIMARY;
const K_POSTFIX: u8 = node_kinds.KIND_POSTFIX;
const K_UNARY: u8 = node_kinds.KIND_UNARY;

impl tc_rows.Typeck {
    // Before child c of closure Primary r: the params' bindings take their types, the return
    // type is lowered (into `acc` of r; NONE: none written), the body is entered with it.
    pub fn enter_closure(&mut self, sg: &mut sigs.Sigs, ds: &decls.Decls, nm: &intern.Interned, set: &source.SourceSet, t: &lex.Tokens, cut: &items.Items, tree: &ast.Ast, r: usize, c: usize) -> bool {
        let ck = tree.kind.as_slice()[c];
        if ck == K_PARAMS {
            let n = tree.kids.row(c).len();
            for j in 0..n {
                let p = self.base + tree.kids.row(c)[j] as usize;
                if tree.kind.as_slice()[p] != K_PARAM { continue; }
                let tn = consteval.child(tree, self.base, p, K_TYPE);
                let ty = if tn == NONE then ERR else sigs.lower(&mut sg.cx, &mut self.lw, tree, t, nm, set, cut, ds, self.it, tn as usize, false, self.sc);
                self.loc.as_mut_slice()[p] = if ty == ERR || ty == NONE then UNK else ty;
            }
            return false;
        }
        if ck == K_TYPE {
            let ty = sigs.lower(&mut sg.cx, &mut self.lw, tree, t, nm, set, cut, ds, self.it, c, true, self.sc);
            self.acc.as_mut_slice()[r] = if ty == ERR || ty == NONE then UNK else ty;
            return false;
        }
        if ck == K_BLOCK {
            let a = self.acc.as_slice()[r];
            self.rets.push(if a == NONE then self.t_unit else a);
            self.ret_why.push(consteval.child(tree, self.base, r, K_TYPE));
            self.set_hint(c, UNK);
            return true;
        }
        return false;
    }

    // The value of closure Primary r, its body checked: its fn type.
    pub fn closure_value(&mut self, sg: &mut sigs.Sigs, tree: &ast.Ast, r: usize) -> u32 {
        self.rets.truncate(self.rets.len() - 1);
        self.ret_why.truncate(self.ret_why.len() - 1);
        let a = self.acc.as_slice()[r];
        let ret = if a == NONE then self.t_unit else a;
        if ret == UNK { return self.err(); }
        let mut ps = vec.Vec::<u32>.new();
        let ks = tree.kids.row(r);
        for j in 0..ks.len() {
            let c = self.base + ks[j] as usize;
            if tree.kind.as_slice()[c] != K_PARAMS { continue; }
            let n = tree.kids.row(c).len();
            for i in 0..n {
                let p = self.base + tree.kids.row(c)[i] as usize;
                if tree.kind.as_slice()[p] != K_PARAM { continue; }
                let pt = self.loc.as_slice()[p];
                if pt == UNK { return self.err(); }
                ps.push(pt);
            }
        }
        let own = self.sc.own;
        let feats: u64 = if own == NONE then 0 else sg.feats.as_slice()[own as usize];
        let tab = &mut sg.cx.tab;
        tab.begin();
        for i in 0..ps.len() {
            tab.push(ps.as_slice()[i]);
        }
        tab.push(ret);
        tab.push((feats >> 32) as% u32);
        tab.push(feats as% u32);
        tab.push(0);
        let ft = tab.intern(types.TK_FN, ps.len() as% u32, 0);
        return self.known(ft);
    }

    // Decides the coercions `coerce` left (`fc_node`, `fc_want`).
    pub fn node_coercions(&mut self, tab: &types.Table, t: &lex.Tokens, tree: &ast.Ast) {
        let mut arms = vec.Vec::<u32>.new();
        for i in 0..self.fc_node.len() {
            let e = self.fc_node.as_slice()[i] as usize;
            let want = self.fc_want.as_slice()[i];
            let why = self.fc_why.as_slice()[i];
            if tab.tag_of(want) != types.TK_FN {
                if !fstring_node(t, tree, self.base, e) {
                    let v = self.resolve_at(e);
                    self.mismatch(e, v, want, why);
                }
                continue;
            }
            value_arms(t, tree, self.base, e, &mut arms);
            for j in 0..arms.len() {
                let a = arms.as_slice()[j] as usize;
                let v = self.resolve_at(a);
                if v == NONE || v == UNK || v == want || v == self.t_never { continue; }
                if self.coercible(tab, v, want) { continue; }
                if !is_lit(v) && tab.tag_of(v) == types.TK_FN && tc_rows.fn_same(tab, v, want) {
                    // the same params and return: E0707 or E1403 unless a fn value made here
                    // gains the clauses
                    let (shape, widened) = tc_rows.fn_conv(tab, v, want, self.proven);
                    if shape && widened != 0 && self.made_fn_value(t, tree, a) { continue; }
                    self.bad = true;
                    continue;
                }
                self.mismatch(a, v, want, why);
            }
        }
        self.fc_node.clear();
        self.fc_want.clear();
        self.fc_why.clear();
    }

    // Whether node n's value is a fn value made right there: n or a node it wraps (stage0
    // `wrapper_chain`) is a closure literal or made a fn item a value.
    fn made_fn_value(&self, t: &lex.Tokens, tree: &ast.Ast, n: usize) -> bool {
        let mut c = n;
        while c != NONE as usize {
            let k = tree.kind.as_slice()[c];
            if k == K_PRIMARY && t.kind.as_slice()[tree.tok.as_slice()[c] as usize] == terminals.T_KW_FN { return true; }
            if self.fn_item.as_slice()[c] { return true; }
            c = wrapped(tree, self.base, c);
        }
        return false;
    }
}

// The nodes whose value node n's value is, unchanged (stage0 `value_arms`): the arms of a value
// `if` / `match` and the inside of parentheses (through wrappers), recursively; else n itself.
fn value_arms(t: &lex.Tokens, tree: &ast.Ast, base: usize, n: usize, out: &mut vec.Vec<u32>) {
    out.clear();
    let mut todo = vec.Vec::<u32>.new();
    todo.push(n as% u32);
    while todo.len() > 0 {
        let x = todo.as_slice()[todo.len() - 1] as usize;
        todo.truncate(todo.len() - 1);
        let k = tree.kind.as_slice()[x];
        let ks = tree.kids.row(x);
        if k == K_IF_EXPR && ks.len() == 3 {
            todo.push((base + ks[2] as usize) as% u32);
            todo.push((base + ks[1] as usize) as% u32);
            continue;
        }
        if k == K_MATCH {
            for j in 1..ks.len() {
                let ak = tree.kids.row(base + ks[j] as usize);
                if ak.len() >= 2 { todo.push((base + ak[ak.len() - 1] as usize) as% u32); }
            }
            continue;
        }
        let mut core = x;
        let mut w = wrapped(tree, base, x);
        while w != NONE as usize {
            core = w;
            w = wrapped(tree, base, w);
        }
        let cs = tree.kids.row(core);
        let a = tree.tok.as_slice()[core] as usize;
        let end = tree.tok_end.as_slice()[core] as usize;
        if tree.kind.as_slice()[core] == K_PRIMARY && t.kind.as_slice()[a] == terminals.T_L_PAREN && cs.len() == 1 && end >= 2 && t.kind.as_slice()[end - 2] != terminals.T_COMMA {
            todo.push((base + cs[0] as usize) as% u32);
            continue;
        }
        out.push(x as% u32);
    }
}

// Whether row n is an f-string through parentheses (stage0 `fstring_node`).
fn fstring_node(t: &lex.Tokens, tree: &ast.Ast, base: usize, n: usize) -> bool {
    let mut c = n;
    while tree.kind.as_slice()[c] == K_PRIMARY {
        let a = tree.tok.as_slice()[c] as usize;
        let k = t.kind.as_slice()[a];
        if k == terminals.T_FMT_LIT { return true; }
        let cs = tree.kids.row(c);
        let end = tree.tok_end.as_slice()[c] as usize;
        if k != terminals.T_L_PAREN || cs.len() != 1 || end < 2 || t.kind.as_slice()[end - 2] == terminals.T_COMMA { return false; }
        c = base + cs[0] as usize;
    }
    return false;
}

// The node a `Unary` or `Postfix` row c only wraps (one child, starting where c starts), else
// NONE.
fn wrapped(tree: &ast.Ast, base: usize, c: usize) -> usize {
    let k = tree.kind.as_slice()[c];
    let cs = tree.kids.row(c);
    if k != K_UNARY && k != K_POSTFIX || cs.len() != 1 { return NONE as usize; }
    let kid = base + cs[0] as usize;
    return if tree.tok.as_slice()[kid] == tree.tok.as_slice()[c] then kid else NONE as usize;
}

fn is_lit(v: u32) -> bool {
    return tc_rows.is_lit(v);
}

// Closure literals of the body checker (types/check, see `typeck`), as stage0's `closure`: the
// params take their written types, the body is checked with the written return type (none:
// `()`) for its `return`s, and the value is the fn type of those params and that return, with
// the enclosing fn's features and no deny clause. What a closure captures does not change its
// type. A param or return type that does not lower is a type error.
import ast;
import consteval;
import decls;
import generated.node_kinds;
import intern;
import items;
import lex;
import sigs;
import source;
import tc_rows;
import types;
import std.vec;

const NONE: u32 = tc_rows.NONE;
const ERR: u32 = types.ERR;
const UNK: u32 = tc_rows.UNK;

const K_BLOCK: u8 = node_kinds.KIND_BLOCK;
const K_PARAM: u8 = node_kinds.KIND_PARAM;
const K_PARAMS: u8 = node_kinds.KIND_PARAMS;
const K_TYPE: u8 = node_kinds.KIND_TYPE;

impl tc_rows.Typeck {
    // Before child c of closure Primary r: the params' bindings take their types, the return
    // type is lowered (into `acc` of r; NONE: none written), the body is entered with it.
    pub fn enter_closure(&mut self, sg: &mut sigs.Sigs, ds: &decls.Decls, nm: &intern.Interned, set: &source.SourceSet, t: &lex.Tokens, cut: &items.Items, tree: &ast.Ast, r: usize, c: usize) -> bool {
        let ck = tree.kind.as_slice()[c];
        if ck == K_PARAMS {
            let n = tree.kids.row(c).len();
            for j in 0..n {
                let p = self.base + tree.kids.row(c)[j] as usize;
                if tree.kind.as_slice()[p] != K_PARAM { continue; }
                let tn = consteval.child(tree, self.base, p, K_TYPE);
                let ty = if tn == NONE then ERR else sigs.lower(&mut sg.cx, &mut self.lw, tree, t, nm, set, cut, ds, self.it, tn as usize, false, self.sc);
                self.loc.as_mut_slice()[p] = if ty == ERR || ty == NONE then UNK else ty;
            }
            return false;
        }
        if ck == K_TYPE {
            let ty = sigs.lower(&mut sg.cx, &mut self.lw, tree, t, nm, set, cut, ds, self.it, c, true, self.sc);
            self.acc.as_mut_slice()[r] = if ty == ERR || ty == NONE then UNK else ty;
            return false;
        }
        if ck == K_BLOCK {
            let a = self.acc.as_slice()[r];
            self.rets.push(if a == NONE then self.t_unit else a);
            self.set_hint(c, UNK);
            return true;
        }
        return false;
    }

    // The value of closure Primary r, its body checked: its fn type.
    pub fn closure_value(&mut self, sg: &mut sigs.Sigs, tree: &ast.Ast, r: usize) -> u32 {
        self.rets.truncate(self.rets.len() - 1);
        let a = self.acc.as_slice()[r];
        let ret = if a == NONE then self.t_unit else a;
        if ret == UNK { return self.err(); }
        let mut ps = vec.Vec::<u32>.new();
        let ks = tree.kids.row(r);
        for j in 0..ks.len() {
            let c = self.base + ks[j] as usize;
            if tree.kind.as_slice()[c] != K_PARAMS { continue; }
            let n = tree.kids.row(c).len();
            for i in 0..n {
                let p = self.base + tree.kids.row(c)[i] as usize;
                if tree.kind.as_slice()[p] != K_PARAM { continue; }
                let pt = self.loc.as_slice()[p];
                if pt == UNK { return self.err(); }
                ps.push(pt);
            }
        }
        let own = self.sc.own;
        let feats: u64 = if own == NONE then 0 else sg.feats.as_slice()[own as usize];
        let tab = &mut sg.cx.tab;
        tab.begin();
        for i in 0..ps.len() {
            tab.push(ps.as_slice()[i]);
        }
        tab.push(ret);
        tab.push((feats >> 32) as% u32);
        tab.push(feats as% u32);
        tab.push(0);
        let ft = tab.intern(types.TK_FN, ps.len() as% u32, 0);
        return self.known(ft);
    }
}

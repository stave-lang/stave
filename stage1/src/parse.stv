// The parser: the table-driven LL(1) machine over `generated/ll1_table`, run once per item, and
// the item's AST in postorder (stage0's parser, step for step).
//
// - Start: the stack `[EOF, Item]` (`[EOF, Import]` for an import item). The item's tokens are
//   followed by a virtual EOF, so the item must end exactly at its cut.
// - Split tokens (`>>` `>=` `>>=` `&&`): a row with no entry for one uses the entry of its first
//   terminal; a terminal on top that is that first part consumes it and leaves the rest as the
//   lookahead.
// - Nodes: a named rule's expansion opens a node at the current token and closes it when its
//   right-hand side is done (a CLOSE entry under the pushed symbols), which gives postorder. A
//   pass-through rule's node that closes with exactly one child node and no terminal of its own
//   is not emitted: its child already sits where it would be.
// - Macros: everything the machine does from popping nonterminal X with lookahead t until a
//   terminal matching t is on top (or X derived nothing) depends on (X, t) alone. It is run once
//   per table cell when the tables are built and replayed as one step: the nodes it opens, the
//   nodes it opens and closes (they match no token), and the entries it leaves on the stack.
//   Cells that reach an error, or take part in the cast tracking, run step by step.
// - Cast tracking, for the diagnostic of a failing item: the `Type` of a cast is flagged, the
//   flag follows the type's right edge (past rules that may derive nothing), and a flagged
//   `GenericArgs` records its `<` until its `>` is consumed.
// - The first error stops the item: it has no nodes, and the state is kept (`ast.Fail`).
//
// Items are independent of each other: the tables are read-only, the machine's state is per
// item, and an item's nodes are appended after those of the items before it.
import ast;
import generated.ll1_table;
import generated.node_kinds;
import generated.terminals;
import items;
import lex;
import source;
import std.vec;

const W: usize = terminals.NTERM;
const EOF: u32 = terminals.T_EOF as u32;
const NT_BIT: u32 = 0x8000;
const NT_MASK: u32 = 0x7fff;
const NONE16: u32 = 0xffff;

// Stack entries: the symbol (a terminal id, `NT_BIT | nonterminal`, or `CLOSE`) in bits 0..16,
// the nonterminal whose production pushed it in bits 16..28, and the cast-tracking flags.
const SYM_MASK: u32 = 0xFFFF;
const CLOSE: u32 = 0xFFFF;
const PROD_SHIFT: u32 = 16;
const PROD_MASK: u32 = 0xFFF;
// The entry is on the right edge of a cast's type.
const F_CAST: u32 = 0x1000_0000;
// The `>` that closes a flagged `GenericArgs`.
const F_D2: u32 = 0x2000_0000;

// Macro cells: an index into the macros, or one of these.
const SLOW: u32 = 0xFFFF_FFFF;
// The cell only pops its nonterminal (it derives nothing and opens no node).
const EPS: u32 = 0xFFFF_FFFE;
// A macro that leaves no terminal on top.
const NO_TERM: u32 = 0xFFFF_FFFF;
// Macro op: a node opened and closed inside the macro, `EMIT | size << 8 | kind`; any other op
// is the kind of a node it leaves open.
const EMIT: u32 = 0x8000_0000;
// A simulated open whose node closed inside the macro (dropped from the ops).
const GONE: u32 = 0x4000_0000;

// Open-node entries, 4 words: kind (and `OWN`), first token, nodes of the item before it opened,
// terminals consumed before it opened.
const OWN: u32 = 256;
const KIND_MASK: u32 = 255;

pub struct Tables {
    table: vec.Vec<i16>,
    rhs: vec.Vec<u32>,
    off: vec.Vec<u32>,
    named: vec.Vec<bool>,
    pass: vec.Vec<bool>,
    nullable: vec.Vec<bool>,
    // Per production: 1 + the position (in the pushed right-hand side) of a cast's `Type`, or 0.
    cast_seed: vec.Vec<u32>,
    // Per lookahead: the first terminal and the rest of a split token, or `NONE16`.
    split_first: vec.Vec<u32>,
    split_rest: vec.Vec<u32>,
    // Per cell `nt * W + t`: a macro index, `SLOW`, or `EPS`.
    mcell: vec.Vec<u32>,
    // Macro k: ops `mops[mops_off[k]..mops_off[k + 1]]`, entries left on the stack (bottom
    // first) `mpush[mpush_off[k]..mpush_off[k + 1]]`, the terminal entry on top or `NO_TERM`.
    mops_off: vec.Vec<u32>,
    mops: vec.Vec<u32>,
    mpush_off: vec.Vec<u32>,
    mpush: vec.Vec<u32>,
    mterm: vec.Vec<u32>,
}

// The production of nonterminal nt on lookahead c (a split token falls back to its first
// terminal), or -1.
fn cell_prod(table: &[i16], split_first: &[u32], nt: usize, c: u32) -> i32 {
    let p = table[nt * W + (c as usize)];
    if p >= 0 { return p as i32; }
    let f = split_first[c as usize];
    if f == NONE16 { return -1; }
    return table[nt * W + (f as usize)] as i32;
}

// The scratch of the macro simulation.
struct Sim {
    ev: vec.Vec<u32>,
    stack: vec.Vec<u32>,
    open: vec.Vec<u32>,
}

// Runs the steps of cell (nt, c) symbolically into m.ev (ops, with `GONE` holes) and m.stack
// (what is left); returns the terminal entry on top, `NO_TERM` when nt derived nothing, or None
// when the cell must run step by step.
fn simulate(t: &Tables, m: &mut Sim, nt: u32, c: u32) -> Option<u32> {
    let table = t.table.as_slice();
    let rhs = t.rhs.as_slice();
    let off = t.off.as_slice();
    let sf = t.split_first.as_slice();
    m.ev.clear();
    m.stack.clear();
    m.open.clear();
    m.stack.push(NT_BIT | nt);
    let mut emitted: u32 = 0;
    for _ in 0usize..1024 {
        let n = m.stack.len();
        if n == 0 { return Option.Some(NO_TERM); }
        let e = m.stack.as_slice()[n - 1];
        m.stack.truncate(n - 1);
        let sym = e & SYM_MASK;
        if sym == CLOSE {
            let k = m.open.len();
            let o = m.open.as_slice();
            let kind = o[k - 3];
            let at = o[k - 2];
            let evi = o[k - 1] as usize;
            m.open.truncate(k - 3);
            if t.pass.as_slice()[kind as usize] { return Option.None; }
            let b = emitted - at;
            if b >= 0x80_0000 { return Option.None; }
            m.ev.as_mut_slice()[evi] = GONE;
            m.ev.push(EMIT | (b << 8) | kind);
            emitted = emitted + 1;
            continue;
        }
        if sym & NT_BIT == 0 {
            if sym == c || sf[c as usize] == sym { return Option.Some(e); }
            return Option.None;
        }
        let y = sym & NT_MASK;
        let p = cell_prod(table, sf, y as usize, c);
        if p < 0 { return Option.None; }
        let pu = p as% usize;
        if t.cast_seed.as_slice()[pu] != 0 { return Option.None; }
        if t.named.as_slice()[y as usize] {
            m.open.push(y);
            m.open.push(emitted);
            m.open.push(m.ev.len() as% u32);
            m.ev.push(y);
            m.stack.push(CLOSE);
        }
        m.stack.extend_from_slice(&rhs[off[pu] as usize..off[pu + 1] as usize]);
    }
    return Option.None;
}

fn copy_bools(xs: &[bool]) -> vec.Vec<bool> {
    let mut v = vec.Vec::<bool>.with_capacity(xs.len());
    v.extend_from_slice(xs);
    return v;
}

pub fn tables() -> Tables {
    let nnt = ll1_table.NNT;
    let nprod = ll1_table.NPROD;
    let mut table = vec.Vec::<i16>.with_capacity(nnt * W);
    table.extend_from_slice(&ll1_table.TABLE);
    let mut lhs_of = vec.Vec::<u16>.with_capacity(nprod);
    lhs_of.extend_from_slice(&ll1_table.PROD_LHS);
    let mut poff = vec.Vec::<u16>.with_capacity(nprod + 1);
    poff.extend_from_slice(&ll1_table.PROD_OFF);
    let mut prhs = vec.Vec::<u16>.with_capacity(ll1_table.NRHS);
    prhs.extend_from_slice(&ll1_table.PROD_RHS);
    let mut origin = vec.Vec::<u16>.with_capacity(nnt);
    origin.extend_from_slice(&ll1_table.NT_ORIGIN);
    let mut rhs = vec.Vec::<u32>.with_capacity(ll1_table.NRHS);
    let mut off = vec.Vec::<u32>.with_capacity(nprod + 1);
    let mut cast_seed = vec.Vec::<u32>.with_capacity(nprod);
    let cast = node_kinds.KIND_CAST as u16;
    let ty = NT_BIT | (node_kinds.KIND_TYPE as u32);
    for p in 0..nprod {
        off.push(rhs.len() as% u32);
        let lhs = lhs_of.as_slice()[p] as u32;
        let a = poff.as_slice()[p] as usize;
        let b = poff.as_slice()[p + 1] as usize;
        let mut seed: u32 = 0;
        for k in a..b {
            let s = prhs.as_slice()[k] as u32;
            rhs.push(s | ((lhs & PROD_MASK) << PROD_SHIFT));
            if origin.as_slice()[lhs as usize] == cast && s == ty && k - a < 255 { seed = (k - a + 1) as% u32; }
        }
        cast_seed.push(seed);
    }
    off.push(rhs.len() as% u32);
    let mut nullable = vec.Vec::<bool>.with_capacity(nnt);
    for _ in 0..nnt {
        nullable.push(false);
    }
    loop {
        let mut changed = false;
        for p in 0..nprod {
            let lhs = lhs_of.as_slice()[p] as usize;
            if nullable.as_slice()[lhs] { continue; }
            let a = poff.as_slice()[p] as usize;
            let b = poff.as_slice()[p + 1] as usize;
            let mut all = true;
            for k in a..b {
                let s = prhs.as_slice()[k] as u32;
                if s & NT_BIT == 0 || !nullable.as_slice()[(s & NT_MASK) as usize] {
                    all = false;
                    break;
                }
            }
            if all {
                nullable.as_mut_slice()[lhs] = true;
                changed = true;
            }
        }
        if !changed { break; }
    }
    let mut sfirst = vec.Vec::<i16>.with_capacity(W);
    sfirst.extend_from_slice(&terminals.SPLIT_FIRST);
    let mut srest = vec.Vec::<i16>.with_capacity(W);
    srest.extend_from_slice(&terminals.SPLIT_REST);
    let mut split_first = vec.Vec::<u32>.with_capacity(W);
    let mut split_rest = vec.Vec::<u32>.with_capacity(W);
    for c in 0..W {
        let f = sfirst.as_slice()[c];
        let r = srest.as_slice()[c];
        if f >= 0 && r >= 0 {
            split_first.push(f as% u32);
            split_rest.push(r as% u32);
        } else {
            split_first.push(NONE16);
            split_rest.push(NONE16);
        }
    }
    let mut t = Tables.{
        table: table,
        rhs: rhs,
        off: off,
        named: copy_bools(&ll1_table.NT_NAMED),
        pass: copy_bools(&ll1_table.NT_PASS),
        nullable: nullable,
        cast_seed: cast_seed,
        split_first: split_first,
        split_rest: split_rest,
        mcell: vec.Vec::<u32>.new(),
        mops_off: vec.Vec::<u32>.new(),
        mops: vec.Vec::<u32>.new(),
        mpush_off: vec.Vec::<u32>.new(),
        mpush: vec.Vec::<u32>.new(),
        mterm: vec.Vec::<u32>.new(),
    };
    let Macros.{ mcell, mops_off, mops, mpush_off, mpush, mterm } = build_macros(&t);
    t.mcell = mcell;
    t.mops_off = mops_off;
    t.mops = mops;
    t.mpush_off = mpush_off;
    t.mpush = mpush;
    t.mterm = mterm;
    return t;
}

struct Macros {
    mcell: vec.Vec<u32>,
    mops_off: vec.Vec<u32>,
    mops: vec.Vec<u32>,
    mpush_off: vec.Vec<u32>,
    mpush: vec.Vec<u32>,
    mterm: vec.Vec<u32>,
}

fn build_macros(t: &Tables) -> Macros {
    let mut m = Sim.{ ev: vec.Vec::<u32>.new(), stack: vec.Vec::<u32>.new(), open: vec.Vec::<u32>.new() };
    let mut mcell = vec.Vec::<u32>.with_capacity(ll1_table.NNT * W);
    let mut mops_off = vec.Vec::<u32>.new();
    let mut mops = vec.Vec::<u32>.new();
    let mut mpush_off = vec.Vec::<u32>.new();
    let mut mpush = vec.Vec::<u32>.new();
    let mut mterm = vec.Vec::<u32>.new();
    mops_off.push(0);
    mpush_off.push(0);
    for nt in 0..ll1_table.NNT {
        for c in 0..W {
            match simulate(t, &mut m, nt as% u32, c as% u32) {
                Option.None => { mcell.push(SLOW); }
                Option.Some(term) => {
                    let mut nops: usize = 0;
                    let ev = m.ev.as_slice();
                    for k in 0..ev.len() {
                        if ev[k] != GONE { nops = nops + 1; }
                    }
                    if nops == 0 && m.stack.len() == 0 && term == NO_TERM {
                        mcell.push(EPS);
                    } else {
                        mcell.push(mterm.len() as% u32);
                        for k in 0..ev.len() {
                            if ev[k] != GONE { mops.push(ev[k]); }
                        }
                        mops_off.push(mops.len() as% u32);
                        mpush.extend_from_slice(m.stack.as_slice());
                        mpush_off.push(mpush.len() as% u32);
                        mterm.push(term);
                    }
                }
            }
        }
    }
    return Macros.{ mcell: mcell, mops_off: mops_off, mops: mops, mpush_off: mpush_off, mpush: mpush, mterm: mterm };
}

// The machine's state, reused across items. `stack` and `open` are used up to a mark and
// lengthened on demand.
pub struct Scratch {
    stack: vec.Vec<u32>,
    open: vec.Vec<u32>,
    d2: vec.Vec<u32>,
    kids: vec.Vec<u32>,
    fail: ast.Fail,
}

pub fn scratch() -> Scratch {
    let mut s = Scratch.{ stack: vec.Vec::<u32>.new(), open: vec.Vec::<u32>.new(), d2: vec.Vec::<u32>.new(), kids: vec.Vec::<u32>.new(), fail: ast.no_fail() };
    grow(&mut s.stack, 64);
    grow(&mut s.open, 64);
    return s;
}

// Lengthens v (zero-filled) to at least `need` entries, at least doubling it.
fn grow(v: &mut vec.Vec<u32>, need: usize) {
    let mut n = v.len() * 2;
    if n < 64 { n = 64; }
    while n < need {
        n = n * 2;
    }
    while v.len() < n {
        v.push(0);
    }
}

// Lengthens the node columns of out to at least `need` rows; `run` cuts the rows it did not use.
// The rows added are twice the shortfall plus a constant, so an item adds O(its nodes) rows over
// all its calls (the columns are cut back to the rows in use after every item).
fn grow_nodes(out: &mut ast.Ast, need: usize) {
    let n = need + (need - out.kind.len()) + 64;
    while out.kind.len() < n {
        out.kind.push(0);
        out.tok.push(0);
        out.tok_end.push(0);
        out.size.push(0);
    }
}

// Runs the machine over kinds[begin..end] (global token indices) from `[EOF, start]` and appends
// the nodes to out. Returns false at the first error, its state in s.fail (the caller drops the
// rows from its start on).
fn run(t: &Tables, s: &mut Scratch, kinds: &[u8], begin: usize, end: usize, start: u32, out: &mut ast.Ast) -> bool {
    let table = t.table.as_slice();
    let rhs = t.rhs.as_slice();
    let off = t.off.as_slice();
    let named = t.named.as_slice();
    let pass = t.pass.as_slice();
    let nullable = t.nullable.as_slice();
    let cast_seed = t.cast_seed.as_slice();
    let sf = t.split_first.as_slice();
    let sr = t.split_rest.as_slice();
    let mcell = t.mcell.as_slice();
    let mops_off = t.mops_off.as_slice();
    let mops = t.mops.as_slice();
    let mpush_off = t.mpush_off.as_slice();
    let mpush = t.mpush.as_slice();
    let mterm = t.mterm.as_slice();
    let generic_args = node_kinds.KIND_GENERIC_ARGS as usize;
    s.d2.clear();
    let mut st = s.stack.as_mut_slice();
    let mut op = s.open.as_mut_slice();
    st[0] = EOF;
    st[1] = NT_BIT | start;
    let mut sp: usize = 2;
    let mut osp: usize = 0;
    let base = out.kind.len();
    // the node rows in use, and the columns written through
    let mut nn = base;
    let mut nk = out.kind.as_mut_slice();
    let mut ntok = out.tok.as_mut_slice();
    let mut nend = out.tok_end.as_mut_slice();
    let mut nsize = out.size.as_mut_slice();
    let mut i = begin;
    let mut cur: u32 = if i < end then kinds[i] as u32 else EOF;
    let mut shift: u32 = 0;
    // terminals consumed, and the token index past the last one
    let mut nterm: u32 = 0;
    let mut last_end: u32 = begin as% u32;
    while sp > 0 {
        sp = sp - 1;
        let mut e = st[sp];
        let sym = e & SYM_MASK;
        if sym == CLOSE {
            if osp > 0 {
                osp = osp - 4;
                let kw = op[osp];
                let kind = kw & KIND_MASK;
                let tok = op[osp + 1];
                let b = (nn - base) as% u32 - op[osp + 2];
                // a pass-through node over exactly one child (its last node, of size b - 1)
                // and no terminal of its own is left out
                let bare = pass[kind as usize] && kw & OWN == 0 && b > 0 && nsize[nn - 1] + 1 == b;
                if !bare {
                    if nn == nk.len() {
                        grow_nodes(out, nn + 1);
                        nk = out.kind.as_mut_slice();
                        ntok = out.tok.as_mut_slice();
                        nend = out.tok_end.as_mut_slice();
                        nsize = out.size.as_mut_slice();
                    }
                    nk[nn] = kind as% u8;
                    ntok[nn] = tok;
                    nend[nn] = if op[osp + 3] != nterm then last_end else tok;
                    nsize[nn] = b;
                    nn = nn + 1;
                }
            }
            continue;
        }
        if sym & NT_BIT != 0 {
            let nt = (sym & NT_MASK) as usize;
            let mi = if e & (F_CAST | F_D2) != 0 then SLOW else mcell[nt * W + (cur as usize)];
            if mi == EPS { continue; }
            if mi != SLOW {
                let mk = mi as usize;
                let count = (nn - base) as% u32;
                let mut emitted: u32 = 0;
                let ia = i as% u32;
                let oa = mops_off[mk] as usize;
                let ob = mops_off[mk + 1] as usize;
                if nn + (ob - oa) > nk.len() {
                    grow_nodes(out, nn + (ob - oa));
                    nk = out.kind.as_mut_slice();
                    ntok = out.tok.as_mut_slice();
                    nend = out.tok_end.as_mut_slice();
                    nsize = out.size.as_mut_slice();
                }
                for k in oa..ob {
                    let x = mops[k];
                    if x & EMIT != 0 {
                        nk[nn] = (x & KIND_MASK) as% u8;
                        ntok[nn] = ia;
                        nend[nn] = ia;
                        nsize[nn] = (x & 0x7FFF_FFFF) >> 8;
                        nn = nn + 1;
                        emitted = emitted + 1;
                    } else {
                        if osp + 4 > op.len() {
                            grow(&mut s.open, osp + 4);
                            op = s.open.as_mut_slice();
                        }
                        op[osp] = x;
                        op[osp + 1] = ia;
                        op[osp + 2] = count + emitted;
                        op[osp + 3] = nterm;
                        osp = osp + 4;
                    }
                }
                let pa = mpush_off[mk] as usize;
                let pb = mpush_off[mk + 1] as usize;
                if sp + (pb - pa) > st.len() {
                    grow(&mut s.stack, sp + (pb - pa));
                    st = s.stack.as_mut_slice();
                }
                for k in pa..pb {
                    st[sp] = mpush[k];
                    sp = sp + 1;
                }
                let term = mterm[mk];
                if term == NO_TERM { continue; }
                // the matching terminal: consumed below
                e = term;
            } else {
                let p = cell_prod(table, sf, nt, cur);
                if p < 0 {
                    s.fail = fail_at(&s.d2, e, i, cur, shift, op, osp);
                    return false;
                }
                let pu = p as% usize;
                let ra = off[pu] as usize;
                let rb = off[pu + 1] as usize;
                if sp + (rb - ra) + 1 > st.len() {
                    grow(&mut s.stack, sp + (rb - ra) + 1);
                    st = s.stack.as_mut_slice();
                }
                if named[nt] {
                    if osp + 4 > op.len() {
                        grow(&mut s.open, osp + 4);
                        op = s.open.as_mut_slice();
                    }
                    op[osp] = nt as% u32;
                    op[osp + 1] = i as% u32;
                    op[osp + 2] = (nn - base) as% u32;
                    op[osp + 3] = nterm;
                    osp = osp + 4;
                    st[sp] = CLOSE;
                    sp = sp + 1;
                }
                let s0 = sp;
                for k in ra..rb {
                    st[sp] = rhs[k];
                    sp = sp + 1;
                }
                if e & F_CAST != 0 || cast_seed[pu] != 0 {
                    // the cast tracking
                    let seed = cast_seed[pu] as usize;
                    if seed > 0 { st[s0 + seed - 1] = st[s0 + seed - 1] | F_CAST; }
                    if e & F_CAST != 0 {
                        for k in ra..rb {
                            let y = rhs[k] & SYM_MASK;
                            if y & NT_BIT == 0 { break; }
                            st[s0 + (k - ra)] = st[s0 + (k - ra)] | F_CAST;
                            if !nullable[(y & NT_MASK) as usize] { break; }
                        }
                        if nt == generic_args && rb > ra {
                            s.d2.push(i as% u32);
                            st[s0] = st[s0] | F_D2;
                        }
                    }
                }
                continue;
            }
        }
        // a terminal on top
        let ts = e & SYM_MASK;
        if osp > 0 { op[osp - 4] = op[osp - 4] | OWN; }
        if ts == cur {
            if e & F_D2 != 0 { let _ = s.d2.pop(); }
            nterm = nterm + 1;
            i = i + 1;
            last_end = i as% u32;
            cur = if i < end then kinds[i] as u32 else EOF;
            shift = 0;
            continue;
        }
        if sf[cur as usize] == ts {
            if e & F_D2 != 0 { let _ = s.d2.pop(); }
            nterm = nterm + 1;
            last_end = (i + 1) as% u32;
            cur = sr[cur as usize];
            shift = shift + 1;
            continue;
        }
        s.fail = fail_at(&s.d2, e, i, cur, shift, op, osp);
        return false;
    }
    out.truncate(nn);
    return true;
}

fn fail_at(d2: &vec.Vec<u32>, top: u32, la: usize, la_kind: u32, shift: u32, open: &[u32], osp: usize) -> ast.Fail {
    let mut f = ast.no_fail();
    f.tok = la as% u32;
    f.expected = top & SYM_MASK;
    f.top = top;
    f.la_kind = la_kind;
    f.shift = shift;
    let nd = d2.len();
    if nd > 0 { f.d2_lt = d2.as_slice()[nd - 1]; }
    if osp > 0 {
        f.open_kind = open[osp - 4] & KIND_MASK;
        f.open_tok = open[osp - 3];
    }
    return f;
}

// The first `unsafe` of kinds[lo..hi] followed by `(` and the empty string `""`, or `ast.NONE`.
fn empty_obligation(kinds: &[u8], start: &[u32], src: &[u8], lo: usize, hi: usize) -> u32 {
    if hi < lo + 3 { return ast.NONE; }
    for i in lo..hi - 2 {
        if kinds[i] == T_KW_UNSAFE && kinds[i + 1] == T_L_PAREN && kinds[i + 2] == T_STR_LIT {
            let s = start[i + 2] as usize;
            if src[s] == 34 && src[s + 1] == 34 { return i as% u32; }
        }
    }
    return ast.NONE;
}

const T_KW_UNSAFE: u8 = terminals.T_KW_UNSAFE as% u8;
const T_L_PAREN: u8 = terminals.T_L_PAREN as% u8;
const T_STR_LIT: u8 = terminals.T_STR_LIT as% u8;

// Parses item r of the cut and appends its nodes (none when it is dropped) and verdict to out.
fn parse_item(t: &Tables, s: &mut Scratch, set: &source.SourceSet, toks: &lex.Tokens, cut: &items.Items, r: usize, out: &mut ast.Ast) {
    let kinds = toks.kind.as_slice();
    let lo = cut.tok_lo.as_slice()[r] as usize;
    let hi = cut.tok_hi.as_slice()[r] as usize;
    let kd = cut.kind.as_slice()[r];
    let mut f = ast.no_fail();
    if lo >= hi {
        out.end_item(ast.DROP_EMPTY, f);
        return;
    }
    for i in lo..hi {
        if kinds[i] >= lex.KIND_ERROR {
            out.end_item(ast.DROP_ERROR_TOKEN, f);
            return;
        }
    }
    if kd == items.ITEM_PRE || kd == items.ITEM_LATE_IMPORT {
        f.tok = lo as% u32;
        f.expected = NT_BIT | (node_kinds.KIND_FILE as u32);
        f.la_kind = kinds[lo] as u32;
        out.end_item(if kd == items.ITEM_PRE then ast.DROP_PRE_ITEM else ast.DROP_LATE_IMPORT, f);
        return;
    }
    let root = if kd == items.ITEM_IMPORT then node_kinds.KIND_IMPORT else node_kinds.KIND_ITEM;
    let base = out.kind.len();
    if !run(t, s, kinds, lo, hi, root as u32, out) {
        out.truncate(base);
        out.end_item(ast.DROP_SYNTAX, s.fail);
        return;
    }
    let src = set.file(cut.file.as_slice()[r] as usize);
    let at = empty_obligation(kinds, toks.start.as_slice(), src, lo, hi);
    if at != ast.NONE {
        out.truncate(base);
        f.tok = at;
        out.end_item(ast.DROP_EMPTY_OBLIGATION, f);
        return;
    }
    out.add_kids(base, &mut s.kids);
    out.end_item(ast.ITEM_OK, f);
}

// The AST of every item of the cut, item after item.
pub fn build(set: &source.SourceSet, toks: &lex.Tokens, cut: &items.Items) -> ast.Ast {
    let t = tables();
    let mut s = scratch();
    let mut out = ast.Ast.new();
    for r in 0..cut.len() {
        parse_item(&t, &mut s, set, toks, cut, r, &mut out);
    }
    return out;
}

// The fixes the body checker's E0201 rows name (types/check, see `typeck`), as stage0's
// `mismatch_fix`: decided when the body's walk is done, from the expected and the found type of
// each row, with the conversions the checker itself allows (`coercible`, the cast table
// `tc_rows.cast_ok`) and the one trait solver (`Copy`).
import ast;
import generated.node_kinds;
import lex;
import sigs;
import tc_rows;
import tc_traits;
import generated.terminals;
import ir.types;

const NONE: u32 = tc_rows.NONE;

impl tc_rows.Typeck {
    // The fix of every E0201 row the current check of the body made.
    pub fn fixes(&mut self, sg: &sigs.Sigs) {
        for k in 0..self.dg.len() {
            if self.dg.pass.as_slice()[k] != self.pass || self.dg.case.as_slice()[k] != tc_rows.C_PENDING { continue; }
            let want = self.dg.a.as_slice()[k];
            let found = self.dg.b.as_slice()[k];
            let c = self.fix_of(sg, want, found);
            self.dg.case.as_mut_slice()[k] = c;
        }
    }

    // The literal of every E0202 row of the current check (its group in `a`): the group's first
    // number literal by position, or a `-` folded into one.
    pub fn lit_sites(&mut self, tree: &ast.Ast, t: &lex.Tokens, lo: usize, hi: usize) {
        for k in 0..self.dg.len() {
            if self.dg.pass.as_slice()[k] != self.pass || self.dg.code.as_slice()[k] != 202 || self.dg.case.as_slice()[k] == tc_rows.C_INFER { continue; }
            let r = self.dg.a.as_slice()[k];
            let mut best = NONE;
            let mut best_tok = NONE;
            for n in lo..hi + 1 {
                let x = self.nty.as_slice()[n];
                if !tc_rows.is_lit(x) || self.lit_root(x) != r { continue; }
                let a = tree.tok.as_slice()[n];
                let kd = tree.kind.as_slice()[n];
                let lt = t.kind.as_slice()[a as usize];
                let next = t.kind.as_slice()[a as usize + 1];
                let num = kd == node_kinds.KIND_PRIMARY && (lt == terminals.T_INT_LIT || lt == terminals.T_FLOAT_LIT);
                let folded = kd == node_kinds.KIND_UNARY && lt == terminals.T_MINUS && (next == terminals.T_INT_LIT || next == terminals.T_FLOAT_LIT);
                if (num || folded) && (best == NONE || a < best_tok) {
                    best = n as% u32;
                    best_tok = a;
                }
            }
            self.dg.n.as_mut_slice()[k] = best;
        }
    }

    // The first form that turns a value of type found into one of type want: wrap it in
    // `Option.Some` or `Result.Ok`, take the value out of an `Option` or `Result`, borrow it,
    // copy it out of a reference, cast it (plain `as` where that gives want, else the first
    // marked cast that does); none of them: `C_NO_CAST`. A literal group fits a payload of its
    // own kind only.
    fn fix_of(&mut self, sg: &sigs.Sigs, want: u32, found: u32) -> u8 {
        let tab = &sg.cx.tab;
        let want_opt = payload(tab, want, self.opt);
        let want_res = payload(tab, want, self.res);
        if found == tc_rows.LIT_INT || found == tc_rows.LIT_FLOAT {
            let tag = if found == tc_rows.LIT_FLOAT then types.TK_FLOAT else types.TK_INT;
            if want_opt != NONE && tab.tag_of(want_opt) == tag { return tc_rows.C_SOME; }
            if want_res != NONE && tab.tag_of(want_res) == tag { return tc_rows.C_OK; }
            return tc_rows.C_NO_CAST;
        }
        let t = found;
        if want_opt != NONE && self.fits(tab, t, want_opt) { return tc_rows.C_SOME; }
        if want_res != NONE && self.fits(tab, t, want_res) { return tc_rows.C_OK; }
        let got_opt = payload(tab, t, self.opt);
        if got_opt != NONE && self.fits(tab, got_opt, want) { return tc_rows.C_UNWRAP_OPTION; }
        let got_res = payload(tab, t, self.res);
        if got_res != NONE && self.fits(tab, got_res, want) { return tc_rows.C_UNWRAP_RESULT; }
        if tab.tag_of(want) == types.TK_REF {
            let m = tab.a_of(want) == 1;
            if tab.b_of(want) == t || self.ref_coercible(tab, m, t, want) {
                return if m then tc_rows.C_BORROW_MUT else tc_rows.C_BORROW;
            }
        }
        if tab.tag_of(t) == types.TK_REF && tab.b_of(t) == want {
            let cp = self.tq.tr.lang.copy_tr;
            if cp != NONE {
                let e = self.tq.env_of(sg, self.sc);
                if self.tq.holds(sg, e, want, cp) == tc_traits.A_YES { return tc_rows.C_DEREF; }
            }
        }
        let tab = &sg.cx.tab;
        if tc_rows.cast_ok(tab, terminals.T_KW_AS, t, want) { return tc_rows.C_CAST; }
        if tc_rows.cast_ok(tab, terminals.T_AS_PERCENT, t, want) { return tc_rows.C_AS_PERCENT; }
        if tc_rows.cast_ok(tab, terminals.T_AS_PIPE, t, want) { return tc_rows.C_AS_PIPE; }
        if tc_rows.cast_ok(tab, terminals.T_AS_TILDE, t, want) { return tc_rows.C_AS_TILDE; }
        return tc_rows.C_NO_CAST;
    }

    // A value of type src is usable as one of type dst.
    fn fits(&self, tab: &types.Table, src: u32, dst: u32) -> bool {
        return src == dst || self.coercible(tab, src, dst);
    }
}

// The first type argument of ty, an instance of ADT d; NONE if ty is none.
fn payload(tab: &types.Table, ty: u32, d: u32) -> u32 {
    if d == NONE || tab.tag_of(ty) != types.TK_ADT || tab.a_of(ty) != d { return NONE; }
    let xs = tab.x(ty);
    if xs.len() < 3 || xs[0] != types.GA_TYPE { return NONE; }
    return xs[1];
}

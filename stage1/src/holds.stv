// Types that hold themselves by value (E0423), from the signatures alone.
//
// Struct and enum cycles. The parts held by value (struct fields and enum payloads after
// substitution; array, range, vector, and tuple elements) form a graph over the types the
// declarations write: per declaration of an item that parsed, in source order, a fn's params and
// return, a struct's or enum's own type (its params as args, used or not) and field types, an
// alias target, an impl self type, a const's or static's type; closed over components and
// fields. Its strongly connected components with a cycle are found by Tarjan's algorithm on
// explicit stacks, in the order of stage0's depth walk: per root, a depth-first walk over parts,
// the components of each type it leaves queued last in, first out (none below a type deeper than
// the limit that reaches no cycle: nothing is measured there). That order only decides between
// components reported at one declaration.
//
// A component is reported at the first declaration (by name span) of an instance in it with a
// field that writes a type of it (the field type as written, through tuple, array, and range
// elements and type arguments), else at the first with an instance in it; the label at that
// field (the first that writes, else the first whose type is in the component). Components are
// taken in that order, each re-split on its own members with the fields cut that earlier reports
// put on their cycles (every field of the reported declaration whose type is in the reported
// sub-component, at each of its instances there): one with no cycle left is the same cycle at
// other args and is not reported, one with a cycle left is reported on what is left. Each
// component is handled once: the cost is linear in the parts graph, plus, per member, the
// written parts of its declaration's fields.
//
// Alias cycles (case `alias`). Aliases, consts, and statics form a graph by what an alias target,
// or a const's or static's type and initializer, names among them, in source order. A
// depth-first walk from each in decl order, as signatures are built, meets an alias on its stack:
// a cycle, unless that alias is on one reported before; it is reported once, at the first of the
// stacked aliases from that one on, by name span.
import ast;
import decls;
import diag;
import diag_kinds;
import diag_tc;
import generated.node_kinds;
import generated.terminals;
import intern;
import layout;
import lex;
import modules;
import resolve;
import sigs;
import source;
import ir.types;
import prims.col;
import prims.ragged;
import prims.search;
import prims.sort;
import std.idx;
import std.mem;
import std.vec;

const NONE: u32 = idx.NONE;
const ERR: u32 = types.ERR;
const TALL: u32 = layout.TALL;
const MAX_DEPTH: u32 = layout.MAX_DEPTH;

// The depth walk: per type its state, the open types, and a frame per type being measured.
struct Walk {
    seen: vec.Vec<bool>,
    // per type: its depth once measured (NONE before), whether it reaches a by-value cycle
    dep: vec.Vec<u32>,
    cyc: vec.Vec<bool>,
    active: vec.Vec<bool>,
    open: vec.Vec<bool>,
    index: vec.Vec<u32>,
    next_index: u32,
    // the measure running met a type in progress or one that reaches a cycle
    met: bool,
    queue: vec.Vec<u32>,
    // the open types, in preorder
    stack: vec.Vec<u32>,
    // per frame: the type, its depth so far, the outer `met`, its parts `parts[lo..hi]` and the
    // next one, its preorder number and low link, whether one of its parts is itself
    f_t: vec.Vec<u32>,
    f_d: vec.Vec<u32>,
    f_outer: vec.Vec<bool>,
    f_lo: vec.Vec<u32>,
    f_hi: vec.Vec<u32>,
    f_next: vec.Vec<u32>,
    f_index: vec.Vec<u32>,
    f_low: vec.Vec<u32>,
    f_self: vec.Vec<bool>,
    parts: vec.Vec<u32>,
    kids: vec.Vec<u32>,
    // the components with a cycle as they close, members in preorder
    comps: ragged.Ragged<u32>,
}

fn new_walk() -> Walk {
    return Walk.{
        seen: vec.Vec::<bool>.new(),
        dep: vec.Vec::<u32>.new(),
        cyc: vec.Vec::<bool>.new(),
        active: vec.Vec::<bool>.new(),
        open: vec.Vec::<bool>.new(),
        index: vec.Vec::<u32>.new(),
        next_index: 0,
        met: false,
        queue: vec.Vec::<u32>.new(),
        stack: vec.Vec::<u32>.new(),
        f_t: vec.Vec::<u32>.new(),
        f_d: vec.Vec::<u32>.new(),
        f_outer: vec.Vec::<bool>.new(),
        f_lo: vec.Vec::<u32>.new(),
        f_hi: vec.Vec::<u32>.new(),
        f_next: vec.Vec::<u32>.new(),
        f_index: vec.Vec::<u32>.new(),
        f_low: vec.Vec::<u32>.new(),
        f_self: vec.Vec::<bool>.new(),
        parts: vec.Vec::<u32>.new(),
        kids: vec.Vec::<u32>.new(),
        comps: ragged.Ragged::<u32>.new(),
    };
}

impl Walk {
    fn grow(&mut self, n: usize) {
        while self.seen.len() < n {
            self.seen.push(false);
            self.dep.push(NONE);
            self.cyc.push(false);
            self.active.push(false);
            self.open.push(false);
            self.index.push(NONE);
        }
    }

    // The top frame's type holds a part of depth pd.
    fn add_part(&mut self, pd: u32) {
        let top = self.f_t.len() - 1;
        let up = if pd >= NONE - 1 then pd else pd + 1;
        if up > self.f_d.as_slice()[top] { self.f_d.as_mut_slice()[top] = up; }
    }

    fn pop_frame(&mut self) {
        let n = self.f_t.len() - 1;
        self.f_t.truncate(n);
        self.f_d.truncate(n);
        self.f_outer.truncate(n);
        self.f_lo.truncate(n);
        self.f_hi.truncate(n);
        self.f_next.truncate(n);
        self.f_index.truncate(n);
        self.f_low.truncate(n);
        self.f_self.truncate(n);
    }
}

// Starts measuring t: its depth when known without its parts, else NONE and a frame that
// measures them (t's fields made).
fn enter(w: &mut Walk, tab: &mut types.Table, sh: &layout.Shapes, pa: &mut layout.Parts, t: u32) -> u32 {
    w.grow(tab.len());
    let i = t as usize;
    let known = w.dep.as_slice()[i];
    if known != NONE {
        if w.cyc.as_slice()[i] { w.met = true; }
        return known;
    }
    let h = tab.height.as_slice()[i];
    if w.active.as_slice()[i] {
        w.met = true;
        return h;
    }
    w.active.as_mut_slice()[i] = true;
    let outer = w.met;
    w.met = false;
    let mut d = h;
    let lo = w.parts.len();
    let tag = tab.tag_of(t);
    if tag == types.TK_ARRAY || tag == types.TK_RANGE || tag == types.TK_VECTOR {
        w.parts.push(tab.a_of(t));
    } else if tag == types.TK_TUPLE {
        w.parts.extend_from_slice(tab.x(t));
    } else if tag == types.TK_ADT && sh.kind_of(tab.a_of(t)) != layout.SK_NONE {
        pa.make(tab, sh, t);
        let fs = pa.fields(t);
        for k in 0..fs.len() {
            // a field taller than the table holds makes its holder too deep
            if fs[k] == TALL {
                d = MAX_DEPTH + 1;
            } else {
                w.parts.push(fs[k]);
            }
        }
        w.grow(tab.len());
    }
    let ix = w.next_index;
    w.next_index = ix + 1;
    w.index.as_mut_slice()[i] = ix;
    w.open.as_mut_slice()[i] = true;
    w.stack.push(t);
    w.f_t.push(t);
    w.f_d.push(d);
    w.f_outer.push(outer);
    w.f_lo.push(lo as% u32);
    w.f_hi.push(w.parts.len() as% u32);
    w.f_next.push(lo as% u32);
    w.f_index.push(ix);
    w.f_low.push(ix);
    w.f_self.push(false);
    return NONE;
}

// Ends the measure of t once its parts are measured: closes its component if it roots one,
// records its depth and whether it reaches a cycle, and queues its components unless it is too
// deep without reaching a cycle.
fn leave(w: &mut Walk, tab: &types.Table, t: u32, d: u32, outer: bool, ix: u32, low: u32, self_part: bool) {
    let i = t as usize;
    w.active.as_mut_slice()[i] = false;
    if low == ix {
        let mut at = w.stack.len();
        while at > 0 {
            at = at - 1;
            if w.stack.as_slice()[at] == t { break; }
        }
        let n = w.stack.len() - at;
        for k in at..w.stack.len() {
            let m = w.stack.as_slice()[k] as usize;
            w.open.as_mut_slice()[m] = false;
        }
        if self_part || n > 1 {
            for k in at..w.stack.len() {
                let m = w.stack.as_slice()[k];
                w.comps.push(m);
            }
            w.comps.end_row();
        }
        w.stack.truncate(at);
    }
    w.dep.as_mut_slice()[i] = d;
    let c = w.met;
    if c { w.cyc.as_mut_slice()[i] = true; }
    w.met = c || outer;
    if d > MAX_DEPTH && !c { return; }
    tab.kids(t, &mut w.kids);
    for k in 0..w.kids.len() {
        let x = w.kids.as_slice()[k];
        if !w.seen.as_slice()[x as usize] { w.queue.push(x); }
    }
}

// The depth-first walk over parts from u.
fn measure(w: &mut Walk, tab: &mut types.Table, sh: &layout.Shapes, pa: &mut layout.Parts, u: u32) {
    if enter(w, tab, sh, pa, u) != NONE { return; }
    loop {
        let top = w.f_t.len() - 1;
        let nx = w.f_next.as_slice()[top];
        if nx < w.f_hi.as_slice()[top] {
            w.f_next.as_mut_slice()[top] = nx + 1;
            let p = w.parts.as_slice()[nx as usize];
            // a field of the error type is one level deep
            if p == ERR {
                w.add_part(1);
                continue;
            }
            if w.open.as_slice()[p as usize] {
                let x = w.index.as_slice()[p as usize];
                if x < w.f_low.as_slice()[top] { w.f_low.as_mut_slice()[top] = x; }
                if p == w.f_t.as_slice()[top] { w.f_self.as_mut_slice()[top] = true; }
            }
            let pd = enter(w, tab, sh, pa, p);
            if pd != NONE { w.add_part(pd); }
            continue;
        }
        let t = w.f_t.as_slice()[top];
        let d = w.f_d.as_slice()[top];
        let outer = w.f_outer.as_slice()[top];
        let ix = w.f_index.as_slice()[top];
        let low = w.f_low.as_slice()[top];
        let self_part = w.f_self.as_slice()[top];
        let lo = w.f_lo.as_slice()[top] as usize;
        w.pop_frame();
        w.parts.truncate(lo);
        leave(w, tab, t, d, outer, ix, low, self_part);
        if w.f_t.len() == 0 { return; }
        let up = w.f_t.len() - 1;
        if low < w.f_low.as_slice()[up] { w.f_low.as_mut_slice()[up] = low; }
        w.add_part(d);
    }
}

// Measures root r and everything it reaches.
fn check_root(w: &mut Walk, tab: &mut types.Table, sh: &layout.Shapes, pa: &mut layout.Parts, r: u32) {
    w.queue.push(r);
    while w.queue.len() > 0 {
        let u = w.queue.as_slice()[w.queue.len() - 1];
        w.queue.truncate(w.queue.len() - 1);
        w.grow(tab.len());
        if w.seen.as_slice()[u as usize] { continue; }
        w.seen.as_mut_slice()[u as usize] = true;
        measure(w, tab, sh, pa, u);
    }
}

fn is_fn(k: u8) -> bool {
    return k == decls.DK_FN || k == decls.DK_METHOD || k == decls.DK_TRAIT_METHOD;
}

// The type of struct or enum d with its own params as args.
fn own_type(tab: &mut types.Table, sg: &sigs.Sigs, d: u32, args: &mut vec.Vec<u32>) -> u32 {
    let lo = sg.cx.gens.lo.as_slice()[d as usize] as usize;
    let hi = sg.cx.gens.lo.as_slice()[d as usize + 1] as usize;
    args.clear();
    for r in lo..hi {
        args.push(if sg.cx.gens.is_const.as_slice()[r] then NONE else tab.key(types.TK_PARAM, (r - lo) as% u32, 0));
    }
    tab.begin();
    for k in 0..args.len() {
        let pt = args.as_slice()[k];
        if pt == NONE {
            tab.push_garg(types.GA_PARAM, k as% u32, 0);
        } else {
            tab.push_garg(types.GA_TYPE, pt, 0);
        }
    }
    return tab.intern(types.TK_ADT, d, 0);
}

// Whether decl d is a declaration of an item that parsed.
fn parsed(ds: &decls.Decls, tree: &ast.Ast, d: usize) -> bool {
    let it = ds.item.as_slice()[d];
    return it != NONE && ds.module.as_slice()[d] != NONE && tree.ok(it as usize);
}

// The roots of the walk, in the order of their spans (module docs).
fn roots(tab: &mut types.Table, sg: &sigs.Sigs, sh: &layout.Shapes, ds: &decls.Decls, md: &modules.Modules, tree: &ast.Ast) -> vec.Vec<u32> {
    let mut keys = vec.Vec::<u64>.new();
    let mut ids = vec.Vec::<u32>.new();
    for d in 0..ds.decls() {
        let k = ds.kind.as_slice()[d];
        let root = is_fn(k) || k == decls.DK_STRUCT || k == decls.DK_ENUM || k == decls.DK_TYPE_ALIAS || k == decls.DK_IMPL || k == decls.DK_CONST || k == decls.DK_STATIC;
        if !root || !parsed(ds, tree, d) { continue; }
        let f = md.mod_file.as_slice()[ds.module.as_slice()[d] as usize];
        keys.push(search.pair(f, ds.off.as_slice()[d]));
        ids.push(d as% u32);
    }
    let perm = sort.sort_perm(keys.as_slice());
    let mut out = vec.Vec::<u32>.new();
    let mut args = vec.Vec::<u32>.new();
    for j in 0..perm.len() {
        let d = ids.as_slice()[perm.as_slice()[j] as usize];
        let du = d as usize;
        let k = ds.kind.as_slice()[du];
        if is_fn(k) {
            if du < sg.params.rows() { out.extend_from_slice(sg.params.row(du)); }
            out.push(sg.cx.ty.as_slice()[du]);
        } else if k == decls.DK_STRUCT || k == decls.DK_ENUM {
            out.push(own_type(tab, sg, d, &mut args));
            let vlo = sh.v_lo.as_slice()[du] as usize;
            let vhi = sh.v_lo.as_slice()[du + 1] as usize;
            for v in vlo..vhi {
                out.extend_from_slice(sh.fields.row(v));
            }
        } else {
            out.push(sg.cx.ty.as_slice()[du]);
        }
    }
    return out;
}

// Visit stamps over the types, for the written parts of one field at a time.
struct Marks {
    stamp: vec.Vec<u32>,
    epoch: u32,
    stack: vec.Vec<u32>,
    kids: vec.Vec<u32>,
}

// Whether the field type ft as written names a type of sub-component s: the field type, then
// through tuple, array, and range elements and type arguments (not behind a pointer, reference,
// slice, or fn type).
fn names(tab: &types.Table, ft: u32, sub: &[u32], s: u32, mk: &mut Marks) -> bool {
    if ft == ERR || ft == NONE { return false; }
    mk.epoch = mk.epoch + 1;
    mk.stack.clear();
    mk.stack.push(ft);
    while mk.stack.len() > 0 {
        let x = mk.stack.as_slice()[mk.stack.len() - 1];
        mk.stack.truncate(mk.stack.len() - 1);
        let xi = x as usize;
        if mk.stamp.as_slice()[xi] == mk.epoch { continue; }
        mk.stamp.as_mut_slice()[xi] = mk.epoch;
        if sub[xi] == s { return true; }
        let tag = tab.tag_of(x);
        if tag == types.TK_ARRAY || tag == types.TK_RANGE {
            mk.stack.push(tab.a_of(x));
        } else if tag == types.TK_TUPLE || tag == types.TK_ADT {
            tab.kids(x, &mut mk.kids);
            mk.stack.extend_from_slice(mk.kids.as_slice());
        }
    }
    return false;
}

// The position of decl d's first field in the flat field columns of `sh`.
fn field_base(sh: &layout.Shapes, d: u32) -> usize {
    return sh.fields.start(sh.v_lo.as_slice()[d as usize] as usize);
}

fn real(t: u32) -> bool {
    return t != ERR && t != TALL && t != NONE;
}

// A report place: (writes, file, start, size, decl) ordered with a writing field first.
fn before(a: (bool, u32, u32, u32, u32), b: (bool, u32, u32, u32, u32)) -> bool {
    let (aw, af, as_, az, ad) = a;
    let (bw, bf, bs, bz, bd) = b;
    if aw != bw { return aw; }
    if af != bf { return af < bf; }
    if as_ != bs { return as_ < bs; }
    if az != bz { return az < bz; }
    return ad < bd;
}

// The declaration to report a component at (module docs) among its members: (decl or NONE, the
// field's flat index or NONE, whether that field writes a type of the component, the
// sub-component). `sub` numbers the sub-components of the members (NONE: on no cycle); a field
// counts if it is not cut and its type is in its holder's sub-component.
fn pick(tab: &types.Table, sh: &layout.Shapes, pa: &layout.Parts, ds: &decls.Decls, md: &modules.Modules, lx: &lex.Lexer, set: &source.SourceSet, t: &lex.Tokens, members: &[u32], sub: &[u32], cut: &[bool], mk: &mut Marks) -> (u32, u32, bool, u32) {
    let mut best = (false, 0u32, 0u32, 0u32, NONE);
    let mut b_field = NONE;
    let mut b_sub = NONE;
    for j in 0..members.len() {
        let m = members[j];
        let s = sub[m as usize];
        if s == NONE || tab.tag_of(m) != types.TK_ADT { continue; }
        let def = tab.a_of(m);
        if sh.kind_of(def) == layout.SK_NONE { continue; }
        let fs = pa.fields(m);
        let mut writes = false;
        let mut field = NONE;
        if fs.len() > 0 {
            let base = field_base(sh, def);
            for k in 0..fs.len() {
                let st = fs[k];
                if cut[base + k] || !real(st) || sub[st as usize] != s { continue; }
                let named = names(tab, sh.fields.data()[base + k], sub, s, mk);
                if field == NONE || (named && !writes) {
                    field = k as% u32;
                    writes = writes || named;
                }
                if writes { break; }
            }
        }
        let (nf, ns, nz) = decls.span(ds, md, lx, set, t, def);
        let here = (writes, nf, ns, nz, def);
        let (_, _, _, _, bd) = best;
        if bd == NONE || before(here, best) {
            best = here;
            b_field = field;
            b_sub = s;
        }
    }
    let (bw, _, _, _, bd) = best;
    return (bd, b_field, bw, b_sub);
}

// The cyclic strongly connected components of a graph on 0..n (edges of v:
// `dst[lo[v]..lo[v + 1]]`): per node the number of its component if that has a cycle (two nodes
// or more, or an edge to itself), else NONE. Tarjan's algorithm on explicit stacks.
fn cyclic_sccs(n: usize, lo: &[u32], dst: &[u32]) -> vec.Vec<u32> {
    let mut index = col.filled(n, NONE);
    let mut low = col.filled(n, 0u32);
    let mut on = col.filled(n, false);
    let mut out = col.filled(n, NONE);
    let mut open = vec.Vec::<u32>.new();
    let mut fv = vec.Vec::<u32>.new();
    let mut fe = vec.Vec::<u32>.new();
    let mut next: u32 = 0;
    let mut comps: u32 = 0;
    for s in 0..n {
        if index.as_slice()[s] != NONE { continue; }
        index.as_mut_slice()[s] = next;
        low.as_mut_slice()[s] = next;
        next = next + 1;
        open.push(s as% u32);
        on.as_mut_slice()[s] = true;
        fv.push(s as% u32);
        fe.push(lo[s]);
        while fv.len() > 0 {
            let top = fv.len() - 1;
            let v = fv.as_slice()[top] as usize;
            let e = fe.as_slice()[top];
            if e < lo[v + 1] {
                fe.as_mut_slice()[top] = e + 1;
                let u = dst[e as usize] as usize;
                if index.as_slice()[u] == NONE {
                    index.as_mut_slice()[u] = next;
                    low.as_mut_slice()[u] = next;
                    next = next + 1;
                    open.push(u as% u32);
                    on.as_mut_slice()[u] = true;
                    fv.push(u as% u32);
                    fe.push(lo[u]);
                } else if on.as_slice()[u] && index.as_slice()[u] < low.as_slice()[v] {
                    low.as_mut_slice()[v] = index.as_slice()[u];
                }
                continue;
            }
            fv.truncate(top);
            fe.truncate(top);
            if top > 0 {
                let p = fv.as_slice()[top - 1] as usize;
                let lv = low.as_slice()[v];
                if lv < low.as_slice()[p] { low.as_mut_slice()[p] = lv; }
            }
            if low.as_slice()[v] != index.as_slice()[v] { continue; }
            let mut at = open.len();
            while at > 0 {
                at = at - 1;
                if open.as_slice()[at] as usize == v { break; }
            }
            let mut cycle = open.len() - at > 1;
            for x in lo[v] as usize..lo[v + 1] as usize {
                if dst[x] as usize == v { cycle = true; }
            }
            for k in at..open.len() {
                let x = open.as_slice()[k] as usize;
                on.as_mut_slice()[x] = false;
                if cycle { out.as_mut_slice()[x] = comps; }
            }
            if cycle { comps = comps + 1; }
            open.truncate(at);
        }
    }
    return out;
}

// perm reordered stably by keys[perm[j]].
fn then_by(perm: &[u32], keys: &[u64]) -> vec.Vec<u32> {
    let mut ks = vec.Vec::<u64>.with_capacity(perm.len());
    for j in 0..perm.len() {
        ks.push(keys[perm[j] as usize]);
    }
    let p = sort.sort_perm(ks.as_slice());
    let mut out = vec.Vec::<u32>.with_capacity(perm.len());
    for j in 0..p.len() {
        out.push(perm[p.as_slice()[j] as usize]);
    }
    return out;
}

// The span of flat field k of struct or enum def: a record field's name, a payload's type.
fn field_span(ds: &decls.Decls, md: &modules.Modules, lx: &lex.Lexer, set: &source.SourceSet, t: &lex.Tokens, tree: &ast.Ast, params: &ragged.Ragged<u32>, keys: &[u64], ids: &[u32], def: u32, k: u32) -> (u32, u32, u32) {
    let (lo, hi) = layout.run_of(keys, def);
    let mut at: u32 = 0;
    for j in lo..hi {
        let e = ids[j];
        let ek = ds.kind.as_slice()[e as usize];
        if ek == decls.DK_FIELD {
            if at == k { return decls.span(ds, md, lx, set, t, e); }
            at = at + 1;
        } else if ek == decls.DK_VARIANT && ds.flags.as_slice()[e as usize] & decls.F_TUPLE != 0 {
            let n = if (e as usize) < params.rows() then params.row(e as usize).len() as% u32 else 0u32;
            if k < at + n { return diag_tc.node_span(tree, lx, set, t, diag_kinds.payload_type(tree, ds, e, (k - at) as usize)); }
            at = at + n;
        } else if ek == decls.DK_VARIANT {
            let (a, b) = layout.run_of(keys, e);
            for x in a..b {
                let f = ids[x];
                if ds.kind.as_slice()[f as usize] != decls.DK_FIELD { continue; }
                if at == k { return decls.span(ds, md, lx, set, t, f); }
                at = at + 1;
            }
        }
    }
    return decls.span(ds, md, lx, set, t, def);
}

// E0423 for every struct or enum cycle (module docs). The type table grows (own types, fields
// after substitution) and is put back.
pub fn holds_itself(d: &mut diag.Diags, sg: &mut sigs.Sigs, ds: &decls.Decls, md: &modules.Modules, nm: &intern.Interned, lx: &lex.Lexer, set: &source.SourceSet, t: &lex.Tokens, tree: &ast.Ast) {
    let mut tab = mem.replace(&mut sg.cx.tab, types.Table.new());
    holds_in(d, &mut tab, sg, ds, md, nm, lx, set, t, tree);
    sg.cx.tab = tab;
}

fn holds_in(d: &mut diag.Diags, tab: &mut types.Table, sg: &sigs.Sigs, ds: &decls.Decls, md: &modules.Modules, nm: &intern.Interned, lx: &lex.Lexer, set: &source.SourceSet, t: &lex.Tokens, tree: &ast.Ast) {
    let nopend = col.filled(ds.decls(), false);
    let sh = layout.shapes(ds, sg.cx.ty.as_slice(), &sg.params, nopend.as_slice());
    let mut pa = layout.Parts.new();
    let rs = roots(tab, sg, &sh, ds, md, tree);
    let mut w = new_walk();
    for j in 0..rs.len() {
        let r = rs.as_slice()[j];
        if real(r) { check_root(&mut w, tab, &sh, &mut pa, r); }
    }
    let nc = w.comps.rows();
    if nc == 0 { return; }
    let n = tab.len();
    let mut sub = col.filled(n, NONE);
    let mut pos = col.filled(n, NONE);
    let mut cut = col.filled(sh.fields.data().len(), false);
    let mut mk = Marks.{ stamp: col.filled(n, 0u32), epoch: 0, stack: vec.Vec::<u32>.new(), kids: vec.Vec::<u32>.new() };
    // the place of each whole component; components without a struct or enum first (E0005, a
    // later stage's)
    let mut k_flag = vec.Vec::<u64>.with_capacity(nc);
    let mut k_at = vec.Vec::<u64>.with_capacity(nc);
    let mut k_size = vec.Vec::<u64>.with_capacity(nc);
    let mut k_decl = vec.Vec::<u64>.with_capacity(nc);
    for c in 0..nc {
        let ms = w.comps.row(c);
        for j in 0..ms.len() {
            sub.as_mut_slice()[ms[j] as usize] = 0;
        }
        let (def, _, writes, _) = pick(tab, &sh, &pa, ds, md, lx, set, t, ms, sub.as_slice(), cut.as_slice(), &mut mk);
        for j in 0..ms.len() {
            sub.as_mut_slice()[ms[j] as usize] = NONE;
        }
        if def == NONE {
            k_flag.push(0);
            k_at.push(0);
            k_size.push(0);
            k_decl.push(0);
            continue;
        }
        let (f, s, z) = decls.span(ds, md, lx, set, t, def);
        k_flag.push(if writes then 1u64 else 2u64);
        k_at.push(search.pair(f, s));
        k_size.push(z as u64);
        k_decl.push(def as u64);
    }
    let mut order = col.iota(nc);
    order = then_by(order.as_slice(), k_decl.as_slice());
    order = then_by(order.as_slice(), k_size.as_slice());
    order = then_by(order.as_slice(), k_at.as_slice());
    order = then_by(order.as_slice(), k_flag.as_slice());
    let (mkeys, mids) = layout.members(ds);
    let mut e_lo = vec.Vec::<u32>.new();
    let mut e_dst = vec.Vec::<u32>.new();
    let mut path = vec.Vec::<u8>.new();
    for j in 0..nc {
        let c = order.as_slice()[j] as usize;
        if k_flag.as_slice()[c] == 0 { continue; }
        let ms = w.comps.row(c);
        for k in 0..ms.len() {
            pos.as_mut_slice()[ms[k] as usize] = k as% u32;
        }
        // the parts graph on the members, without the fields cut
        e_lo.clear();
        e_dst.clear();
        for k in 0..ms.len() {
            e_lo.push(e_dst.len() as% u32);
            let m = ms[k];
            let tag = tab.tag_of(m);
            if tag == types.TK_ADT {
                let def = tab.a_of(m);
                if sh.kind_of(def) == layout.SK_NONE { continue; }
                let fs = pa.fields(m);
                if fs.len() == 0 { continue; }
                let base = field_base(&sh, def);
                for x in 0..fs.len() {
                    if cut.as_slice()[base + x] || !real(fs[x]) { continue; }
                    let p = pos.as_slice()[fs[x] as usize];
                    if p != NONE { e_dst.push(p); }
                }
            } else if tag == types.TK_ARRAY || tag == types.TK_RANGE || tag == types.TK_VECTOR {
                let p = pos.as_slice()[tab.a_of(m) as usize];
                if p != NONE { e_dst.push(p); }
            } else if tag == types.TK_TUPLE {
                let xs = tab.x(m);
                for x in 0..xs.len() {
                    let p = pos.as_slice()[xs[x] as usize];
                    if p != NONE { e_dst.push(p); }
                }
            }
        }
        e_lo.push(e_dst.len() as% u32);
        let subs = cyclic_sccs(ms.len(), e_lo.as_slice(), e_dst.as_slice());
        for k in 0..ms.len() {
            sub.as_mut_slice()[ms[k] as usize] = subs.as_slice()[k];
        }
        let (def, field, _, s) = pick(tab, &sh, &pa, ds, md, lx, set, t, ms, sub.as_slice(), cut.as_slice(), &mut mk);
        if def != NONE {
            // a fix at the reported declaration fixes every instance of this cycle
            for k in 0..ms.len() {
                let m = ms[k];
                if tab.tag_of(m) != types.TK_ADT || tab.a_of(m) != def || sub.as_slice()[m as usize] != s { continue; }
                let fs = pa.fields(m);
                if fs.len() == 0 { continue; }
                let base = field_base(&sh, def);
                for x in 0..fs.len() {
                    if real(fs[x]) && sub.as_slice()[fs[x] as usize] == s { cut.as_mut_slice()[base + x] = true; }
                }
            }
            let (nf, ns, nz) = decls.span(ds, md, lx, set, t, def);
            path.clear();
            diag_kinds.decl_path(&mut path, ds, md, nm, def);
            d.begin(423, "");
            d.arg("name", path.as_slice());
            if field != NONE {
                let (ff, fs2, fz) = field_span(ds, md, lx, set, t, tree, &sg.params, mkeys.as_slice(), mids.as_slice(), def, field);
                d.role("field", ff, fs2, fz);
            }
            d.end(nf, ns, nz);
        }
        for k in 0..ms.len() {
            sub.as_mut_slice()[ms[k] as usize] = NONE;
            pos.as_mut_slice()[ms[k] as usize] = NONE;
        }
    }
}

fn is_node(ds: &decls.Decls, tree: &ast.Ast, x: usize) -> bool {
    let k = ds.kind.as_slice()[x];
    return (k == decls.DK_TYPE_ALIAS || k == decls.DK_CONST || k == decls.DK_STATIC) && ds.node.as_slice()[x] != NONE && parsed(ds, tree, x);
}

// The aliases, consts, and statics that x's target (an alias) or its type and initializer name,
// appended to out in the order signature building lowers them: a node before its children, the
// children in source order, except a fn type's return before its params.
fn named(sg: &sigs.Sigs, ds: &decls.Decls, tree: &ast.Ast, t: &lex.Tokens, x: usize, stack: &mut vec.Vec<u32>, kids: &mut vec.Vec<u32>, out: &mut vec.Vec<u32>) {
    let it = ds.item.as_slice()[x];
    let base = tree.item_node.as_slice()[it as usize] as usize;
    let g = base + ds.node.as_slice()[x] as usize;
    let mut top = g;
    if ds.kind.as_slice()[x] == decls.DK_TYPE_ALIAS {
        top = NONE as usize;
        let ks = tree.kids.row(g);
        for j in 0..ks.len() {
            let c = base + ks[j] as usize;
            if tree.kind.as_slice()[c] == node_kinds.KIND_TYPE { top = c; }
        }
        if top == NONE as usize { return; }
    }
    let u = &sg.cx.uses;
    stack.clear();
    stack.push(top as% u32);
    while stack.len() > 0 {
        let n = stack.as_slice()[stack.len() - 1] as usize;
        stack.truncate(stack.len() - 1);
        let rel = (n - base) as% u32;
        let lo = search.lower_bound(u.key.as_slice(), search.pair(it, rel));
        let mut k = lo;
        while k < u.key.len() && u.key.as_slice()[k] == search.pair(it, rel) {
            let y = u.target.as_slice()[k];
            if u.tag.as_slice()[k] == resolve.TAG_DECL && is_node(ds, tree, y as usize) { out.push(y); }
            k = k + 1;
        }
        kids.clear();
        let ks = tree.kids.row(n);
        for j in 0..ks.len() {
            kids.push((base + ks[j] as usize) as% u32);
        }
        // `fn(..) -> R`: its last `Type` child, after `->`, is the return
        if tree.kind.as_slice()[n] == node_kinds.KIND_TYPE_BASE && t.kind.as_slice()[tree.tok.as_slice()[n] as usize] as% u8 == terminals.T_KW_FN {
            let mut r = kids.len();
            while r > 0 && tree.kind.as_slice()[kids.as_slice()[r - 1] as usize] != node_kinds.KIND_TYPE {
                r = r - 1;
            }
            if r > 0 {
                let ret = kids.as_slice()[r - 1];
                let a = tree.tok.as_slice()[ret as usize];
                if a > 0 && t.kind.as_slice()[(a - 1) as usize] as% u8 == terminals.T_MINUS_GT {
                    let mut j = r - 1;
                    while j > 0 {
                        let prev = kids.as_slice()[j - 1];
                        kids.as_mut_slice()[j] = prev;
                        j = j - 1;
                    }
                    kids.as_mut_slice()[0] = ret;
                }
            }
        }
        let mut j = kids.len();
        while j > 0 {
            j = j - 1;
            stack.push(kids.as_slice()[j]);
        }
    }
}

// E0423 case `alias` (module docs).
pub fn alias_cycles(d: &mut diag.Diags, sg: &sigs.Sigs, ds: &decls.Decls, md: &modules.Modules, nm: &intern.Interned, lx: &lex.Lexer, set: &source.SourceSet, t: &lex.Tokens, tree: &ast.Ast) {
    let n = ds.decls();
    // 0: not reached, 1: on the walk's stack, 2: done
    let mut state = col.filled(n, 0u8);
    let mut on_cycle = col.filled(n, false);
    let mut aliases = vec.Vec::<u32>.new();
    let mut fx = vec.Vec::<u32>.new();
    let mut f_lo = vec.Vec::<u32>.new();
    let mut f_next = vec.Vec::<u32>.new();
    let mut edges = vec.Vec::<u32>.new();
    let mut stack = vec.Vec::<u32>.new();
    let mut kids = vec.Vec::<u32>.new();
    let mut path = vec.Vec::<u8>.new();
    for s in 0..n {
        if state.as_slice()[s] != 0 || !is_node(ds, tree, s) { continue; }
        let mut y = s as% u32;
        loop {
            if y != NONE {
                // enter y
                state.as_mut_slice()[y as usize] = 1;
                if ds.kind.as_slice()[y as usize] == decls.DK_TYPE_ALIAS { aliases.push(y); }
                fx.push(y);
                f_lo.push(edges.len() as% u32);
                f_next.push(edges.len() as% u32);
                named(sg, ds, tree, t, y as usize, &mut stack, &mut kids, &mut edges);
                y = NONE;
            }
            if fx.len() == 0 { break; }
            let top = fx.len() - 1;
            let e = f_next.as_slice()[top];
            if (e as usize) < edges.len() {
                f_next.as_mut_slice()[top] = e + 1;
                let z = edges.as_slice()[e as usize];
                let st = state.as_slice()[z as usize];
                if st == 0 {
                    y = z;
                } else if st == 1 && ds.kind.as_slice()[z as usize] == decls.DK_TYPE_ALIAS && !on_cycle.as_slice()[z as usize] {
                    let mut at = 0usize;
                    while aliases.as_slice()[at] != z {
                        at = at + 1;
                    }
                    let mut first = NONE;
                    let mut fs = (0u32, 0u32, 0u32);
                    for k in at..aliases.len() {
                        let a = aliases.as_slice()[k];
                        on_cycle.as_mut_slice()[a as usize] = true;
                        let (f, st2, sz) = decls.span(ds, md, lx, set, t, a);
                        let (bf, bs, bz) = fs;
                        if first == NONE || f < bf || (f == bf && (st2 < bs || (st2 == bs && (sz < bz || (sz == bz && a < first))))) {
                            first = a;
                            fs = (f, st2, sz);
                        }
                    }
                    let (f, st2, sz) = fs;
                    path.clear();
                    diag_kinds.decl_path(&mut path, ds, md, nm, first);
                    d.begin(423, "alias");
                    d.arg("name", path.as_slice());
                    d.end(f, st2, sz);
                }
                continue;
            }
            // leave the top
            let x = fx.as_slice()[top];
            state.as_mut_slice()[x as usize] = 2;
            if ds.kind.as_slice()[x as usize] == decls.DK_TYPE_ALIAS { aliases.truncate(aliases.len() - 1); }
            edges.truncate(f_lo.as_slice()[top] as usize);
            fx.truncate(top);
            f_lo.truncate(top);
            f_next.truncate(top);
        }
    }
}

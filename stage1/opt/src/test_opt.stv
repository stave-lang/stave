// The decision's facts and verdicts, the expansion, and the clean-up, on hand-written
// `release` texts; the expected tables and texts follow contracts/opt-passes.md sections 2, 3,
// 4, 5, and 8.
import clean;
import decide;
import expand;
import facts;
import ir.bytes;
import ir.canon;
import ir.features;
import ir.load;
import ir.model;
import ir.print;
import ir.read;
import prims.ragged;
import std.debug;
import std.mem;
import std.vec;

// The lines, each ended by a newline.
fn joined(lines: &[&str]) -> vec.Vec<u8> {
    let mut o = vec.Vec::<u8>.new();
    for i in 0..lines.len() {
        bytes.push_str(&mut o, lines[i]);
        o.push(10);
    }
    return o;
}

// The loaded module of the text whose lines are `lines`; it must load.
fn loaded(lines: &[&str]) -> read.Loaded {
    let ld = load.load(joined(lines).as_slice());
    debug.assert(ld.ok(), "the test module loads");
    return ld;
}

// Whether the `inline` dump of the module of `lines` under `lim` is the lines `want`.
fn dumps(lines: &[&str], lim: &decide.Limits, want: &[&str]) -> bool {
    let ld = loaded(lines);
    let got = decide.inline_dump(&ld.m, lim);
    return got.as_slice().eq(joined(want).as_slice());
}

// A leaf, a fn with a `switch`, a loop that never returns, and a trap block; levels 0 to 2.
fn chain() -> [&str; 32] {
    return ["stave.ir 4 \"x86_64-linux-v2\" release checked", "type t0 int u 64", "type t1 bool", "fn @0 m.leaf(t0) -> t0 {", "b0(%0: t0):", "  %1 = add.wrap t0 %0 1", "  ret %1", "}", "fn @1 m.mid(t0) -> t0 {", "b0(%0: t0):", "  switch %0 0:b1() _:b2()", "b1():", "  %1 = call t0 @0 %0", "  br b3(%1)", "b2():", "  %2 = call t0 @0 %0", "  br b4()", "b3(%3: t0):", "  ret %3", "b4():", "  br b2()", "}", "fn @2 m.top(t0) -> t0 {", "b0(%0: t0):", "  %1 = call t0 @1 %0", "  %2 = call t0 @0 %1", "  %3 = eq t1 %2 0", "  cbr %3 b1() b2()", "b1():", "  %4 = call t0 @0 %2", "  panic.assert ()", "  unreachable"];
}

fn chain_text() -> vec.Vec<u8> {
    let c = chain();
    let mut src = vec.Vec::<u8>.new();
    for i in 0..c.len() {
        bytes.push_str(&mut src, c[i]);
        src.push(10);
    }
    bytes.push_str(&mut src, "b2():\n  ret %2\n}\n");
    return src;
}

test fn sizes_ret_cold_and_levels() {
    let ld = load.load(chain_text().as_slice());
    debug.assert(ld.ok(), "loads");
    let fx = facts.build(&ld.m);
    debug.assert(fx.size0.as_slice().eq(&[1u64, 8, 12]), "size0: add 1, switch 2, call 3, cbr 1, panic 1, the rest 0");
    debug.assert(fx.level.as_slice().eq(&[0u32, 1, 2]), "levels");
    let ret = [true, true, true, false, true, false, true, false, true];
    debug.assert(fx.ret.as_slice().eq(&ret), "ret: a loop without an exit and a trap block reach no ret");
    debug.assert(fx.site_g.as_slice().eq(&[0u32, 0, 1, 0, 0]), "site rows in (f, b, k) order");
    debug.assert(fx.g_to.as_slice().eq(&[0u32, 0, 1]) && fx.g_off.as_slice().eq(&[0u32, 0, 1, 3]), "G: distinct pairs");
    let lim = decide.Limits.table();
    let out = decide.inline_dump(&ld.m, &lim);
    let want = "round 1\nfn @0 size 1 closed 1 slots 0 level 0\nfn @1 size 8 closed 6 slots 0 level 1\nsite @1 b1 0 @0 1 inline\nsite @1 b2 0 @0 1 cold\nfn @2 size 12 closed 13 slots 0 level 2\nsite @2 b0 0 @1 6 inline\nsite @2 b0 1 @0 1 inline\nsite @2 b1 0 @0 1 cold\n";
    debug.assert(out.as_slice().eq(mem.str_bytes(want)), "the dump");
}

test fn the_dump_of_the_printed_text_is_the_same() {
    let ld = load.load(chain_text().as_slice());
    let lim = decide.Limits.table();
    let a = decide.inline_dump(&ld.m, &lim);
    let lines = ["stave.ir 4 \"x86_64-linux-v2\" release checked", "type t0 int u 64", "type t1 bool", "fn @0 m.leaf(t0) -> t0 {", "b0(%7: t0):", "  %3 = add.wrap t0 %7 1", "  ret %3", "}", "fn @2 m.top(t0) -> t0 {", "b0(%9: t0):", "  %1 = call t0 @1 %9", "  %2 = call t0 @0 %1", "  %3 = eq t1 %2 0", "  cbr %3 b8() b5()", "b8():", "  %4 = call t0 @0 %2", "  panic.assert ()", "  unreachable", "b5():", "  ret %2", "}", "fn @1 m.mid(t0) -> t0 {", "b0(%0: t0):", "  switch %0 0:b9() _:b2()", "b9():", "  %1 = call t0 @0 %0", "  br b3(%1)", "b2():", "  %2 = call t0 @0 %0", "  br b4()", "b3(%3: t0):", "  ret %3", "b4():", "  br b2()", "}"];
    let lb = loaded(&lines);
    let b = decide.inline_dump(&lb.m, &lim);
    debug.assert(a.as_slice().eq(b.as_slice()), "numbering and fn order of the text change nothing");
    let p = print.print(&lb.m);
    let lc = load.load(p.as_slice());
    let c = decide.inline_dump(&lc.m, &lim);
    debug.assert(a.as_slice().eq(c.as_slice()), "the dump of fmt(t) is the dump of t");
}

test fn cycles_and_their_levels() {
    let lines = ["stave.ir 4 \"x86_64-linux-v2\" release checked", "type t0 int u 64", "fn @0 m.leaf(t0) -> t0 {", "b0(%0: t0):", "  ret %0", "}", "fn @1 m.a(t0) -> t0 {", "b0(%0: t0):", "  %1 = call t0 @2 %0", "  %2 = call t0 @0 %1", "  ret %2", "}", "fn @2 m.b(t0) -> t0 {", "b0(%0: t0):", "  %1 = call t0 @1 %0", "  ret %1", "}", "fn @3 m.me(t0) -> t0 {", "b0(%0: t0):", "  %1 = call t0 @3 %0", "  ret %1", "}", "fn @4 m.top(t0) -> t0 {", "b0(%0: t0):", "  %1 = call t0 @1 %0", "  %2 = call t0 @3 %1", "  ret %2", "}"];
    let ld = loaded(&lines);
    let fx = facts.build(&ld.m);
    debug.assert(fx.cyc.as_slice().eq(&[false, true, true, true, false]), "cyc: a two-fn component and a self edge");
    debug.assert(fx.level.as_slice().eq(&[0u32, 1, 1, 0, 2]), "levels on the condensation");
    let want = ["round 1", "fn @0 size 0 closed 0 slots 0 level 0", "fn @1 size 6 closed 3 slots 0 level 1 cyclic", "site @1 b0 0 @2 3 cyclic", "site @1 b0 1 @0 0 inline", "fn @2 size 3 closed 3 slots 0 level 1 cyclic", "site @2 b0 0 @1 3 cyclic", "fn @3 size 3 closed 3 slots 0 level 0 cyclic", "site @3 b0 0 @3 3 cyclic", "fn @4 size 6 closed 6 slots 0 level 2", "site @4 b0 0 @1 3 cyclic", "site @4 b0 1 @3 3 cyclic"];
    debug.assert(dumps(&lines, &decide.Limits.table(), &want), "the dump");
}

test fn slots_are_pointee_layout_sizes() {
    let lines = ["stave.ir 4 \"x86_64-linux-v2\" release checked", "type t0 int u 64", "type t1 int u 8", "type t2 ref mut t0", "type t3 tuple t1 t0", "type t4 ref mut t3", "type t5 array t0 9", "type t6 ref mut t5", "fn @0 m.a(t0) -> t0 {", "b0(%0: t0):", "  %1 = slot t2", "  %2 = slot t4", "  ret %0", "}", "fn @1 m.big(t0) -> t0 {", "b0(%0: t0):", "  %1 = slot t6", "  ret %0", "}", "fn @2 m.top(t0) -> t0 {", "b0(%0: t0):", "  %1 = slot t2", "  %2 = call t0 @0 %0", "  %3 = call t0 @1 %2", "  ret %3", "}"];
    let ld = loaded(&lines);
    let fx = facts.build(&ld.m);
    debug.assert(fx.slot0.as_slice().eq(&[24u64, 72, 8]), "slot0: u64 8, (u8, u64) 16, [u64; 9] 72");
    let want = ["round 1", "fn @0 size 0 closed 0 slots 24 level 0", "fn @1 size 0 closed 0 slots 72 level 0", "fn @2 size 6 closed 3 slots 32 level 1", "site @2 b0 1 @0 0 inline", "site @2 b0 2 @1 0 slots"];
    debug.assert(dumps(&lines, &decide.Limits.table(), &want), "the dump");
}

fn verdict_module(target: &str) -> vec.Vec<u8> {
    let lines = ["type t0 int u 32", "type t1 int u 64", "type t2 int u size", "type t3 int s size", "type t4 fntype t1 -> t1", "type t5 int u 8", "type t6 ref t7", "type t7 slice t5", "fn @0 m.leaf(t1) -> t1 {", "b0(%0: t1):", "  ret %0", "}", "fn @1 m.stop(t1) -> t1 {", "b0(%0: t1):", "  panic.assert ()", "  unreachable", "}", "fn @2 m.ext(t1) -> t1 symbol \"ext\"", "fn @3 runtime.panic.set_user_site(t0) known {", "b0(%0: t0):", "  ret", "}", "fn @4 runtime.panic.test_skip() -> t0 known {", "b0():", "  ret 0", "}", "fn @5 m.ind(t4) -> t1 {", "b0(%0: t4):", "  %1 = call.ind t1 %0 5", "  ret %1", "}", "fn @6 m.sys(t2) -> t3 {", "b0(%0: t2):", "  %1 = intrinsic.syscall0 t3 %0", "  ret %1", "}", "fn @7 m.wide(t1) -> t1 needs(avx2) {", "b0(%0: t1):", "  ret %0", "}", "fn @8 m.v3(t1) -> t1 needs(avx2) {", "b0(%0: t1):", "  %1 = call t1 @7 %0", "  ret %1", "}", "fn @9 m.main(t1) -> t1 {", "b0(%0: t1):", "  call () @3 3", "  %1 = call t1 @0 %0", "  %2 = call t1 @1 %1", "  %3 = call t1 @2 %2", "  %4 = call t0 @4", "  %5 = call t1 @5 @0", "  %6 = call t3 @6 8", "  %7 = call t1 @7 %3", "  ret %7", "}", "fn @10 runtime.panic.abort(t6) known altstack {", "b0(%0: t6):", "  %1 = call t1 @0 7", "  panic.assert ()", "  unreachable", "}"];
    let mut src = vec.Vec::<u8>.new();
    bytes.push_str(&mut src, "stave.ir 4 \"");
    bytes.push_str(&mut src, target);
    bytes.push_str(&mut src, "\" release checked\n");
    for i in 0..lines.len() {
        bytes.push_str(&mut src, lines[i]);
        src.push(10);
    }
    return src;
}

test fn every_callee_and_caller_verdict() {
    let ld = load.load(verdict_module("x86_64-linux-v2").as_slice());
    debug.assert(ld.ok(), "loads");
    let out = decide.inline_dump(&ld.m, &decide.Limits.table());
    let want = "round 1\nfn @0 size 0 closed 0 slots 0 level 0\nfn @1 size 1 closed 1 slots 0 level 0\nfn @3 size 0 closed 0 slots 0 level 0\nfn @4 size 0 closed 0 slots 0 level 0\nfn @5 size 3 closed 3 slots 0 level 0\nfn @6 size 2 closed 2 slots 0 level 0\nfn @7 size 0 closed 0 slots 0 level 0\nfn @8 size 3 closed 0 slots 0 level 1\nsite @8 b0 0 @7 0 inline\nfn @9 size 24 closed 17 slots 0 level 1\nsite @9 b0 0 @3 0 inline\nsite @9 b0 1 @0 0 inline\nsite @9 b0 2 @1 1 noret\nsite @9 b0 3 @2 - nobody\nsite @9 b0 4 @4 0 known\nsite @9 b0 5 @5 3 indirect\nsite @9 b0 6 @6 2 inline\nsite @9 b0 7 @7 0 features\nfn @10 size 4 closed 4 slots 0 level 1\nsite @10 b0 0 @0 0 altstack\n";
    debug.assert(out.as_slice().eq(mem.str_bytes(want)), "the dump");
    let l3 = load.load(verdict_module("x86_64-linux-v3").as_slice());
    debug.assert(l3.ok(), "loads on v3");
    let f3 = facts.build(&l3.m);
    debug.assert(f3.caller.as_slice()[8] == facts.V_INLINE, "avx2 is in the v3 baseline");
    debug.assert(features.baseline(1) & features.closure(1u64 << 1) != 0, "the v3 baseline holds avx");
}

test fn an_intrinsic_outside_the_cpu_table_is_gpu() {
    let mut ld = load.load(verdict_module("x86_64-linux-v2").as_slice());
    let fx = facts.build(&ld.m);
    debug.assert(fx.callee.as_slice()[6] == facts.V_INLINE, "syscall0 is a CPU intrinsic");
    let mut names = ragged.Ragged::<u8>.new();
    names.push_row(mem.str_bytes("sreg.tid.x"));
    ld.m.intr = names;
    let fg = facts.build(&ld.m);
    debug.assert(fg.callee.as_slice()[6] == facts.V_GPU, "a PTX intrinsic fails gpu");
}

test fn an_unbuilt_callee_with_a_returning_body_is_noret() {
    let mut ld = load.load(verdict_module("x86_64-linux-v2").as_slice());
    let f0 = ld.m.fn_flags.as_slice()[0];
    ld.m.fn_flags.as_mut_slice()[0] = f0 | model.F_UNBUILT;
    let f2 = ld.m.fn_flags.as_slice()[2];
    ld.m.fn_flags.as_mut_slice()[2] = f2 | model.F_UNBUILT;
    let fx = facts.build(&ld.m);
    debug.assert(fx.callee.as_slice()[0] == facts.V_NORET, "the unbuilt mark fails noret whatever the body ends in");
    debug.assert(fx.callee.as_slice()[2] == facts.V_NOBODY, "without a body: nobody first");
    let d = decide.decide(&ld.m, &fx, &decide.Limits.table());
    debug.assert(d.verdict.as_slice()[2] == facts.V_NORET, "the row of @9 that calls it");
}

fn five_adds() -> [&str; 18] {
    return ["stave.ir 4 \"x86_64-linux-v2\" release checked", "type t0 int u 64", "fn @0 m.leaf(t0) -> t0 {", "b0(%0: t0):", "  %1 = add.wrap t0 %0 1", "  %2 = add.wrap t0 %1 1", "  %3 = add.wrap t0 %2 1", "  %4 = add.wrap t0 %3 1", "  %5 = add.wrap t0 %4 1", "  ret %5", "}", "fn @1 m.top(t0) -> t0 {", "b0(%0: t0):", "  %1 = call t0 @0 %0", "  %2 = call t0 @0 %1", "  %3 = call t0 @0 %2", "  ret %3", "}"];
}

test fn size_and_the_budget_cut_follow_the_limits() {
    let lines = five_adds();
    let mut lim = decide.Limits.table();
    let all = ["round 1", "fn @0 size 5 closed 5 slots 0 level 0", "fn @1 size 9 closed 15 slots 0 level 1", "site @1 b0 0 @0 5 inline", "site @1 b0 1 @0 5 inline", "site @1 b0 2 @0 5 inline"];
    debug.assert(dumps(&lines, &lim, &all), "all inline");
    debug.assert(lim.set(mem.str_bytes("cap"), 13), "cap");
    let cut = ["round 1", "fn @0 size 5 closed 5 slots 0 level 0", "fn @1 size 9 closed 13 slots 0 level 1", "site @1 b0 0 @0 5 inline", "site @1 b0 1 @0 5 inline", "site @1 b0 2 @0 5 budget"];
    debug.assert(dumps(&lines, &lim, &cut), "CAP - size0 = 4 takes two rows of a = 2, in (b, k) order");
    let mut lt = decide.Limits.table();
    debug.assert(lt.set(mem.str_bytes("threshold"), 4), "threshold");
    let big = ["round 1", "fn @0 size 5 closed 5 slots 0 level 0", "fn @1 size 9 closed 9 slots 0 level 1", "site @1 b0 0 @0 5 size", "site @1 b0 1 @0 5 size", "site @1 b0 2 @0 5 size"];
    debug.assert(dumps(&lines, &lt, &big), "S(g) > T");
    let mut ls = decide.Limits.table();
    debug.assert(ls.set(mem.str_bytes("cap"), 0), "cap 0");
    let none = ["round 1", "fn @0 size 5 closed 5 slots 0 level 0", "fn @1 size 9 closed 9 slots 0 level 1", "site @1 b0 0 @0 5 budget", "site @1 b0 1 @0 5 budget", "site @1 b0 2 @0 5 budget"];
    debug.assert(dumps(&lines, &ls, &none), "a caller above CAP grows by nothing");
}

test fn limits_refuse_what_k3_refuses() {
    let mut lim = decide.Limits.table();
    debug.assert(lim.set(mem.str_bytes("call_saved"), 3) && lim.call_saved == 3, "W_CALL = w(call)");
    debug.assert(!lim.set(mem.str_bytes("call_saved"), 4), "W_CALL above w(call)");
    debug.assert(!lim.set(mem.str_bytes("rounds"), 0), "no rounds");
    debug.assert(!lim.set(mem.str_bytes("T"), 1), "an unknown name");
    debug.assert(lim.set(mem.str_bytes("slot_callee"), 8) && lim.slot_callee == 8, "slot_callee");
    debug.assert(facts.op_weight(mem.str_bytes("slot")) == 0 && facts.op_weight(mem.str_bytes("intrinsic.syscall0")) == 2 && facts.op_weight(mem.str_bytes("vec.add")) == 1, "op rows: exact, then the longest `*` prefix");
    debug.assert(facts.op_weight(mem.str_bytes("nosuchop")) == facts.NONE, "no row");
}

// The module of `lines` after `canon`, D under `lim`, X, and `canon` (rule P1), printed.
fn after_x(lines: &[&str], lim: &decide.Limits) -> vec.Vec<u8> {
    let mut ld = loaded(lines);
    canon.canon(&mut ld.m);
    let fx = facts.build(&ld.m);
    let d = decide.decide(&ld.m, &fx, lim);
    expand.run(&mut ld.m, &fx, &d);
    canon.canon(&mut ld.m);
    return print.print(&ld.m);
}

// Whether X prints the module of `lines` as: its header at level `opt`, its lines 1..keep
// unchanged, then `want`; and the printed text loads.
fn expands(lines: &[&str], keep: usize, want: &[&str]) -> bool {
    let got = after_x(lines, &decide.Limits.table());
    let mut w = vec.Vec::<u8>.new();
    bytes.push_str(&mut w, "stave.ir 4 \"x86_64-linux-v2\" release opt\n");
    for i in 1..keep {
        bytes.push_str(&mut w, lines[i]);
        w.push(10);
    }
    for i in 0..want.len() {
        bytes.push_str(&mut w, want[i]);
        w.push(10);
    }
    let again = load.load(got.as_slice());
    return again.ok() && got.as_slice().eq(w.as_slice());
}

test fn x2_x3_every_argument_kind_binds_its_param() {
    let lines = ["stave.ir 4 \"x86_64-linux-v2\" release checked", "type t0 int u 64", "type t1 int u size", "type t2 bool", "type t3 str", "type t4 ref t3", "type t5 fntype t0 -> t0", "str s0 \"ab\"", "fn @0 m.inc(t0) -> t0 {", "b0(%0: t0):", "  %1 = add.wrap t0 %0 1", "  ret %1", "}", "fn @1 m.pick(t2, t5, t4, t0) -> t5 {", "b0(%0: t2, %1: t5, %2: t4, %3: t0):", "  %4 = slice.len t1 %2", "  %5 = select t5 %0 %1 @0", "  ret %5", "}", "fn @2 m.top(t0) -> t0 {", "b0(%0: t0):", "  %1 = mul.wrap t0 %0 3", "  %2 = call t5 @1 1 @0 s0 %1", "  %3 = call.ind t0 %2 %1", "  ret %3", "}"];
    let want = ["fn @2 m.top(t0) -> t0 {", "b0(%0: t0):", "  %1 = mul.wrap t0 %0 3", "  %2 = slice.len t1 s0", "  %3 = select t5 1 @0 @0", "  br b1(%3)", "b1(%4: t5):", "  %5 = call.ind t0 %4 %1", "  ret %5", "}"];
    debug.assert(expands(&lines, 19, &want), "a constant, an @fn, a string, and a value for the params; the code after the call in the continuation");
}

test fn x4_x5_callee_blocks_rets_and_a_unit_call() {
    let lines = ["stave.ir 4 \"x86_64-linux-v2\" release checked", "type t0 int u 64", "type t1 bool", "type t2 ref mut t0", "fn @0 m.clamp(t0) -> t0 {", "b0(%0: t0):", "  %1 = lt t1 %0 10", "  cbr %1 b1() b2()", "b1():", "  ret %0", "b2():", "  ret 10", "}", "fn @1 m.put(t2, t0) {", "b0(%0: t2, %1: t0):", "  switch %1 0:b1() _:b2()", "b1():", "  ret", "b2():", "  store () %0 %1", "  ret", "}", "fn @2 m.top(t2, t0) -> t0 {", "b0(%0: t2, %1: t0):", "  br b1(%1)", "b1(%2: t0):", "  %3 = call t0 @0 %2", "  call () @1 %0 %3", "  %4 = eq t1 %3 0", "  cbr %4 b1(%3) b2()", "b2():", "  ret %2", "}"];
    let want = ["fn @2 m.top(t2, t0) -> t0 {", "b0(%0: t2, %1: t0):", "  br b1(%1)", "b1(%2: t0):", "  %3 = lt t1 %2 10", "  cbr %3 b2() b3()", "b2():", "  br b4(%2)", "b3():", "  br b4(10)", "b4(%4: t0):", "  switch %4 0:b5() _:b6()", "b5():", "  br b7()", "b6():", "  store () %0 %4", "  br b7()", "b7():", "  %5 = eq t1 %4 0", "  cbr %5 b1(%4) b8()", "b8():", "  ret %2", "}"];
    debug.assert(expands(&lines, 22, &want), "each ret a br to the continuation, with the value only when the call has a result; the caller's targets past the copies");
}

test fn x6_rows_of_one_block_left_to_right_and_their_sites() {
    let lines = ["stave.ir 4 \"x86_64-linux-v2\" release checked", "type t0 int u 64", "site 0 \"a.stv\" 1 1 m.f", "site 1 \"a.stv\" 2 1 m.top", "site 2 \"a.stv\" 3 1 m.top", "site 3 \"a.stv\" 4 1 m.top", "fn @0 m.f(t0) -> t0 {", "b0(%0: t0):", "  %1 = add t0 %0 1 !0", "  ret %1", "}", "fn @1 m.ext(t0) -> t0 symbol \"ext\"", "fn @2 m.top(t0) -> t0 {", "b0(%0: t0):", "  %1 = call t0 @0 %0 !1", "  %2 = call t0 @1 %1 !2", "  %3 = call t0 @0 %2 !3", "  ret %3", "}"];
    let want = ["fn @2 m.top(t0) -> t0 {", "b0(%0: t0):", "  %1 = add t0 %0 1 !0", "  br b1(%1)", "b1(%2: t0):", "  %3 = call t0 @1 %2 !2", "  %4 = add t0 %3 1 !0", "  br b2(%4)", "b2(%5: t0):", "  ret %5", "}"];
    debug.assert(expands(&lines, 12, &want), "the second row splits the first one's continuation; copies keep their rows, the inlined calls' rows go");
}

test fn x7_x1_slots_of_nested_copies_go_to_b0_in_preorder() {
    let lines = ["stave.ir 4 \"x86_64-linux-v2\" release checked", "type t0 int u 64", "type t1 ref mut t0", "fn @0 m.h(t0) -> t0 {", "b0(%0: t0):", "  %1 = slot t1", "  store () %1 %0", "  %2 = load t0 %1", "  ret %2", "}", "fn @1 m.g(t0) -> t0 {", "b0(%0: t0):", "  %1 = slot t1", "  store () %1 7", "  %2 = call t0 @0 %0", "  %3 = load t0 %1", "  %4 = add.wrap t0 %2 %3", "  ret %4", "}", "fn @2 m.top(t0) -> t0 {", "b0(%0: t0):", "  %1 = slot t1", "  %2 = call t0 @0 %0", "  %3 = call t0 @1 %2", "  store () %1 %3", "  ret %3", "}"];
    let want = ["fn @1 m.g(t0) -> t0 {", "b0(%0: t0):", "  %1 = slot t1", "  %2 = slot t1", "  store () %1 7", "  store () %2 %0", "  %3 = load t0 %2", "  br b1(%3)", "b1(%4: t0):", "  %5 = load t0 %1", "  %6 = add.wrap t0 %4 %5", "  ret %6", "}", "fn @2 m.top(t0) -> t0 {", "b0(%0: t0):", "  %1 = slot t1", "  %2 = slot t1", "  %3 = slot t1", "  %4 = slot t1", "  store () %2 %0", "  %5 = load t0 %2", "  br b1(%5)", "b1(%6: t0):", "  store () %3 7", "  store () %4 %6", "  %7 = load t0 %4", "  br b2(%7)", "b2(%8: t0):", "  %9 = load t0 %3", "  %10 = add.wrap t0 %8 %9", "  br b3(%10)", "b3(%11: t0):", "  store () %1 %11", "  ret %11", "}"];
    debug.assert(expands(&lines, 10, &want), "the fn's own slots, then per row in (b, k) order F(g)'s slots; F(g) is g expanded");
}

test fn x4_x6_a_loop_callee_twice_in_one_block() {
    let lines = ["stave.ir 4 \"x86_64-linux-v2\" release checked", "type t0 int u 64", "type t1 bool", "fn @0 m.sum(t0) -> t0 {", "b0(%0: t0):", "  br b1(0, 0)", "b1(%1: t0, %2: t0):", "  %3 = lt t1 %1 %0", "  cbr %3 b2() b3()", "b2():", "  %4 = add.wrap t0 %2 %1", "  %5 = add.wrap t0 %1 1", "  br b1(%5, %4)", "b3():", "  ret %2", "}", "fn @1 m.top(t0) -> t0 {", "b0(%0: t0):", "  %1 = call t0 @0 %0", "  %2 = call t0 @0 5", "  %3 = add.wrap t0 %1 %2", "  ret %3", "}"];
    let want = ["fn @1 m.top(t0) -> t0 {", "b0(%0: t0):", "  br b1(0, 0)", "b1(%1: t0, %2: t0):", "  %3 = lt t1 %1 %0", "  cbr %3 b2() b3()", "b2():", "  %4 = add.wrap t0 %2 %1", "  %5 = add.wrap t0 %1 1", "  br b1(%5, %4)", "b3():", "  br b4(%2)", "b4(%6: t0):", "  br b5(0, 0)", "b5(%7: t0, %8: t0):", "  %9 = lt t1 %7 5", "  cbr %9 b6() b7()", "b6():", "  %10 = add.wrap t0 %8 %7", "  %11 = add.wrap t0 %7 1", "  br b5(%11, %10)", "b7():", "  br b8(%8)", "b8(%12: t0):", "  %13 = add.wrap t0 %6 %12", "  ret %13", "}"];
    debug.assert(expands(&lines, 16, &want), "fresh blocks and values per copy, loop params and back edges mapped, a constant argument in the copy");
}

test fn x_without_accepted_rows_changes_only_the_level() {
    let lines = five_adds();
    let mut lim = decide.Limits.table();
    debug.assert(lim.set(mem.str_bytes("cap"), 0), "cap 0");
    let got = after_x(&lines, &lim);
    let mut w = vec.Vec::<u8>.new();
    bytes.push_str(&mut w, "stave.ir 4 \"x86_64-linux-v2\" release opt\n");
    for i in 1..lines.len() {
        bytes.push_str(&mut w, lines[i]);
        w.push(10);
    }
    debug.assert(got.as_slice().eq(w.as_slice()), "every row refused on budget: the bodies stay as they are");
}

// `canon(C*(m))` of the module of `lines` as text, and the most rounds that changed a body. The
// text loads (the verifier) and is a fixpoint: `C*` changes nothing on it.
fn cleaned(lines: &[&str]) -> (vec.Vec<u8>, u32) {
    let mut ld = loaded(lines);
    let r = clean.run(&mut ld.m);
    canon.canon(&mut ld.m);
    let out = print.print(&ld.m);
    let mut again = load.load(out.as_slice());
    debug.assert(again.ok(), "the cleaned text loads");
    debug.assert(clean.run(&mut again.m) == 0, "C* changes nothing on its own output");
    return (out, r);
}

// Whether `C*` makes the module of `lines` the text `want` in `rounds` rounds that change it.
fn cleans_to(lines: &[&str], want: &[&str], rounds: u32) -> bool {
    let (out, r) = cleaned(lines);
    return r == rounds && out.as_slice().eq(joined(want).as_slice());
}

test fn c1_substitutes_single_edge_params_through_chains() {
    let lines = ["stave.ir 4 \"x86_64-linux-v2\" release opt", "type t0 int u 64", "type t1 bool", "fn @0 m.f(t1, t0) -> t0 {", "b0(%0: t1, %1: t0):", "  cbr %0 b1(%1) b2()", "b1(%2: t0):", "  ret %2", "b2():", "  ret 0", "}", "fn @1 m.g(t1, t0) -> t0 {", "b0(%0: t1, %1: t0):", "  cbr %0 b1(%1) b3()", "b1(%2: t0):", "  cbr %0 b2(%2) b3()", "b2(%3: t0):", "  ret %3", "b3():", "  ret 0", "}"];
    let want = ["stave.ir 4 \"x86_64-linux-v2\" release opt", "type t0 int u 64", "type t1 bool", "fn @0 m.f(t1, t0) -> t0 {", "b0(%0: t1, %1: t0):", "  cbr %0 b1() b2()", "b1():", "  ret %1", "b2():", "  ret 0", "}", "fn @1 m.g(t1, t0) -> t0 {", "b0(%0: t1, %1: t0):", "  cbr %0 b1() b3()", "b1():", "  cbr %0 b2() b3()", "b2():", "  ret %1", "b3():", "  ret 0", "}"];
    debug.assert(cleans_to(&lines, &want, 1), "C1: %2 and %3 become %1, the chain followed to its end");
}

test fn c2_folds_chains_and_keeps_what_would_trap() {
    let lines = ["stave.ir 4 \"x86_64-linux-v2\" release opt", "type t0 int u 8", "type t1 int u 64", "type t2 int s 8", "type t3 bool", "fn @0 m.f(t3) -> t1 {", "b0(%0: t3):", "  %1 = add t1 2 3", "  %2 = mul t1 %1 4", "  %3 = add t0 250 9", "  %4 = div t1 1 0", "  %5 = shl t1 1 64", "  %6 = select t1 1 %2 7", "  %7 = select t1 %0 %6 1", "  %8 = shr t2 -128 7", "  %9 = cast.wrap t1 %8", "  %10 = add.wrap t1 %7 %9", "  ret %10", "}"];
    let want = ["stave.ir 4 \"x86_64-linux-v2\" release opt", "type t0 int u 8", "type t1 int u 64", "type t2 bool", "fn @0 m.f(t2) -> t1 {", "b0(%0: t2):", "  %1 = add t0 250 9", "  %2 = div t1 1 0", "  %3 = shl t1 1 64", "  %4 = select t1 %0 20 1", "  %5 = add.wrap t1 %4 18446744073709551615", "  ret %5", "}"];
    debug.assert(cleans_to(&lines, &want, 1), "C2: 5, 20, the select, -1 as u64; the add, div, and shl that would trap stay");
}

test fn c2_repeats_until_no_instruction_folds() {
    let lines = ["stave.ir 4 \"x86_64-linux-v2\" release opt", "type t0 int u 64", "type t1 bool", "fn @0 m.f(t1) -> t0 {", "b0(%0: t1):", "  br b2()", "b1():", "  %2 = mul t0 %1 4", "  ret %2", "b2():", "  %1 = add t0 2 3", "  cbr %0 b1() b3()", "b3():", "  ret 0", "}"];
    let want = ["stave.ir 4 \"x86_64-linux-v2\" release opt", "type t0 int u 64", "type t1 bool", "fn @0 m.f(t1) -> t0 {", "b0(%0: t1):", "  cbr %0 b1() b2()", "b1():", "  ret 20", "b2():", "  ret 0", "}"];
    debug.assert(cleans_to(&lines, &want, 1), "C2: the mul printed before the add it reads folds in the same round");
}

test fn c3_switch_and_cbr_on_constants_become_br() {
    let lines = ["stave.ir 4 \"x86_64-linux-v2\" release opt", "type t0 int u 64", "fn @0 m.case() -> t0 {", "b0():", "  switch 1 0:b1() 1:b2() _:b3()", "b1():", "  ret 10", "b2():", "  ret 20", "b3():", "  ret 30", "}", "fn @1 m.dflt() -> t0 {", "b0():", "  switch 9 0:b1() 1:b2() _:b3()", "b1():", "  ret 10", "b2():", "  ret 20", "b3():", "  ret 30", "}", "fn @2 m.no() -> t0 {", "b0():", "  cbr 0 b1() b2()", "b1():", "  ret 1", "b2():", "  ret 2", "}"];
    let want = ["stave.ir 4 \"x86_64-linux-v2\" release opt", "type t0 int u 64", "fn @0 m.case() -> t0 {", "b0():", "  ret 20", "}", "fn @1 m.dflt() -> t0 {", "b0():", "  ret 30", "}", "fn @2 m.no() -> t0 {", "b0():", "  ret 2", "}"];
    debug.assert(cleans_to(&lines, &want, 1), "C3: the case of the value, else the default; cbr 0 takes else");
}

test fn c3_equal_targets_then_a_second_round() {
    let lines = ["stave.ir 4 \"x86_64-linux-v2\" release opt", "type t0 int u 64", "type t1 bool", "fn @0 m.same(t1, t0) -> t0 {", "b0(%0: t1, %1: t0):", "  cbr %0 b1(%1) b1(%1)", "b1(%2: t0):", "  ret %2", "}", "fn @1 m.differ(t1, t0) -> t0 {", "b0(%0: t1, %1: t0):", "  cbr %0 b1(%1) b1(5)", "b1(%2: t0):", "  ret %2", "}"];
    let want = ["stave.ir 4 \"x86_64-linux-v2\" release opt", "type t0 int u 64", "type t1 bool", "fn @0 m.same(t1, t0) -> t0 {", "b0(%0: t1, %1: t0):", "  ret %1", "}", "fn @1 m.differ(t1, t0) -> t0 {", "b0(%0: t1, %1: t0):", "  cbr %0 b1(%1) b1(5)", "b1(%2: t0):", "  ret %2", "}"];
    debug.assert(cleans_to(&lines, &want, 2), "two edges: C1 waits for C3's br; different operands stay");
}

test fn c4_dead_blocks_go_with_their_edges() {
    let lines = ["stave.ir 4 \"x86_64-linux-v2\" release opt", "type t0 int u 64", "fn @0 m.f(t0) -> t0 {", "b0(%0: t0):", "  cbr 1 b1() b2()", "b1():", "  br b3(%0)", "b2():", "  %1 = add t0 %0 1", "  br b3(%1)", "b3(%2: t0):", "  ret %2", "}"];
    let want = ["stave.ir 4 \"x86_64-linux-v2\" release opt", "type t0 int u 64", "fn @0 m.f(t0) -> t0 {", "b0(%0: t0):", "  ret %0", "}"];
    debug.assert(cleans_to(&lines, &want, 2), "C4 takes b2 with its add; round 2 substitutes b3's param and merges");
}

test fn edges_count_with_multiplicity() {
    let lines = ["stave.ir 4 \"x86_64-linux-v2\" release opt", "type t0 int u 64", "type t1 bool", "fn @0 m.f(t0) -> t0 {", "b0(%0: t0):", "  switch %0 0:b1(%0) _:b1(5)", "b1(%1: t0):", "  ret %1", "}", "fn @1 m.g(t1) -> t0 {", "b0(%0: t1):", "  cbr %0 b1() b1()", "b1():", "  ret 7", "}"];
    let want = ["stave.ir 4 \"x86_64-linux-v2\" release opt", "type t0 int u 64", "type t1 bool", "fn @0 m.f(t0) -> t0 {", "b0(%0: t0):", "  switch %0 0:b1(%0) _:b1(5)", "b1(%1: t0):", "  ret %1", "}", "fn @1 m.g(t1) -> t0 {", "b0(%0: t1):", "  ret 7", "}"];
    debug.assert(cleans_to(&lines, &want, 1), "a case and the default into one block are two edges; cbr X() X() is a br");
}

test fn c5_merges_chains_where_the_first_stands() {
    let lines = ["stave.ir 4 \"x86_64-linux-v2\" release opt", "type t0 int u 64", "type t1 bool", "fn @0 m.f(t1, t0) -> t0 {", "b0(%0: t1, %1: t0):", "  cbr %0 b2() b1()", "b1():", "  ret %1", "b2():", "  %2 = mul t0 %1 3", "  br b3()", "b3():", "  %3 = add t0 %2 1", "  br b4()", "b4():", "  ret %3", "}", "fn @1 m.g(t1, t0) -> t0 {", "b0(%0: t1, %1: t0):", "  cbr %0 b3() b1()", "b1():", "  ret %1", "b2():", "  %3 = add t0 %2 1", "  ret %3", "b3():", "  %2 = mul t0 %1 3", "  br b2()", "}"];
    let want = ["stave.ir 4 \"x86_64-linux-v2\" release opt", "type t0 int u 64", "type t1 bool", "fn @0 m.f(t1, t0) -> t0 {", "b0(%0: t1, %1: t0):", "  cbr %0 b2() b1()", "b1():", "  ret %1", "b2():", "  %2 = mul t0 %1 3", "  %3 = add t0 %2 1", "  ret %3", "}", "fn @1 m.g(t1, t0) -> t0 {", "b0(%0: t1, %1: t0):", "  cbr %0 b2() b1()", "b1():", "  ret %1", "b2():", "  %2 = mul t0 %1 3", "  %3 = add t0 %2 1", "  ret %3", "}"];
    debug.assert(cleans_to(&lines, &want, 1), "C5: a chain joins its first block, also one stored after the block it joins");
}

test fn c6_drops_dead_values_and_params() {
    let lines = ["stave.ir 4 \"x86_64-linux-v2\" release opt", "type t0 int u 64", "type t1 bool", "fn @0 m.f(t0, t0) -> t0 {", "b0(%0: t0, %1: t0):", "  br b1(0, 0)", "b1(%2: t0, %3: t0):", "  %4 = lt t1 %2 %0", "  cbr %4 b2() b3()", "b2():", "  %5 = add.wrap t0 %3 %2", "  %6 = add.wrap t0 %2 1", "  br b1(%6, %5)", "b3():", "  %7 = xor t0 %2 %0", "  %8 = and t0 %7 3", "  ret %2", "}"];
    let want = ["stave.ir 4 \"x86_64-linux-v2\" release opt", "type t0 int u 64", "type t1 bool", "fn @0 m.f(t0, t0) -> t0 {", "b0(%0: t0, %1: t0):", "  br b1(0)", "b1(%2: t0):", "  %3 = lt t1 %2 %0", "  cbr %3 b2() b3()", "b2():", "  %4 = add.wrap t0 %2 1", "  br b1(%4)", "b3():", "  ret %2", "}"];
    debug.assert(cleans_to(&lines, &want, 1), "C6: the loop-carried %3 read only by its own update goes with its arguments; b0's %1 stays");
}

test fn the_worked_example_needs_two_rounds() {
    let lines = ["stave.ir 4 \"x86_64-linux-v2\" release opt", "type t0 int u 64", "type t1 int s 32", "fn @0 main.main() -> t1 {", "b0():", "  cbr 1 b1() b2()", "b1():", "  %0 = mul t0 5 3", "  br b3(%0)", "b2():", "  %1 = add t0 5 1", "  br b3(%1)", "b3(%2: t0):", "  cbr 0 b4() b5()", "b4():", "  %3 = mul t0 %2 3", "  br b6(%3)", "b5():", "  %4 = add t0 %2 1", "  br b6(%4)", "b6(%5: t0):", "  cbr 0 b7() b8()", "b7():", "  %6 = mul t0 7 3", "  br b9(%6)", "b8():", "  %7 = add t0 7 1", "  br b9(%7)", "b9(%8: t0):", "  %9 = cast.wrap t1 %5", "  ret %9", "}"];
    let want = ["stave.ir 4 \"x86_64-linux-v2\" release opt", "type t0 int s 32", "fn @0 main.main() -> t0 {", "b0():", "  ret 16", "}"];
    debug.assert(cleans_to(&lines, &want, 2), "opt-passes.md 10.2: round 2 substitutes 15 and %4, folds 16, merges");
}

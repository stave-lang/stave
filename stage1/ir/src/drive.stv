// The LL(1) table driver of one IR text line: `Line` is the start rule and the end of the line
// is `EOF`; an expected `AnyWord` matches any Word-shaped token. Named rules open nodes, which
// only the syntax errors read: the op node of an instruction gives the arity message.
import bytes;
import grammar;
import lexer;
import generated.ir_text_ll1_table;
import generated.ir_text_node_kinds;
import generated.ir_text_terminals;
import std.idx;
import std.vec;

const NT_BIT: u32 = 0x8000;
const END: u32 = 0xffff_ffff;
const NONE: u32 = idx.NONE;

pub struct Driver {
    stack: vec.Vec<u32>,
    open: vec.Vec<u32>,
    node_kind: vec.Vec<u32>,
    node_prod: vec.Vec<u32>,
    node_tok: vec.Vec<u32>,
    pub col: u32,
    pub msg: vec.Vec<u8>,
}

impl Driver {
    pub fn new() -> Driver {
        return Driver.{
            stack: vec.Vec::<u32>.new(),
            open: vec.Vec::<u32>.new(),
            node_kind: vec.Vec::<u32>.new(),
            node_prod: vec.Vec::<u32>.new(),
            node_tok: vec.Vec::<u32>.new(),
            col: 0,
            msg: vec.Vec::<u8>.new(),
        };
    }

    // Runs the table over the tokens of line src; false: a syntax error in `col`, `msg`.
    pub fn drive(&mut self, g: &grammar.Grammar, src: &[u8], lx: &lexer.Lexed) -> bool {
        self.stack.clear();
        self.open.clear();
        self.node_kind.clear();
        self.node_prod.clear();
        self.node_tok.clear();
        self.stack.push(NT_BIT | (ir_text_ll1_table.IR_START as u32));
        let n = lx.len();
        let eof = ir_text_terminals.IR_T_EOF as u32;
        let mut i: usize = 0;
        while self.stack.len() > 0 {
            let top = self.stack.as_slice()[self.stack.len() - 1];
            self.stack.truncate(self.stack.len() - 1);
            let tok = if i < n then lx.term.as_slice()[i] as u32 else eof;
            if top == END {
                self.open.truncate(self.open.len() - 1);
            } else if top & NT_BIT == 0 {
                let any = top == (ir_text_terminals.IR_T_ANY_WORD as u32) && g.is_word.as_slice()[tok as usize];
                if top != tok && !any {
                    self.error(g, src, lx, i, top, false);
                    return false;
                }
                i = i + 1;
            } else {
                let nt = top & 0x7fff;
                let p = g.action(nt, tok);
                if p < 0 {
                    self.error(g, src, lx, i, nt, true);
                    return false;
                }
                if g.named.as_slice()[nt as usize] {
                    let id = self.node_kind.len() as% u32;
                    self.node_kind.push(nt);
                    self.node_prod.push(p as% u32);
                    self.node_tok.push(i as% u32);
                    self.open.push(id);
                    self.stack.push(END);
                }
                let rhs = g.rhs_rev(p as% u32);
                for k in 0..rhs.len() {
                    self.stack.push(rhs[k] as u32);
                }
            }
        }
        if i < n {
            self.col = lx.start.as_slice()[i] + 1;
            self.msg.clear();
            bytes.push_str(&mut self.msg, "unexpected `");
            let s = lx.start.as_slice()[i] as usize;
            let e = lx.end.as_slice()[i] as usize;
            bytes.push_show(&mut self.msg, &src[s..e]);
            bytes.push_str(&mut self.msg, "` after a complete line");
            return false;
        }
        return true;
    }

    // The message of a failure at token i: terminal `want` expected, or no entry in row `want`.
    fn error(&mut self, g: &grammar.Grammar, src: &[u8], lx: &lexer.Lexed, i: usize, want: u32, row: bool) {
        let n = lx.len();
        let tok = if i < n then lx.term.as_slice()[i] as u32 else ir_text_terminals.IR_T_EOF as u32;
        self.col = if i < n then lx.start.as_slice()[i] + 1 else src.len() as% u32 + 1;
        let mut found = vec.Vec::<u8>.new();
        if i < n {
            found.push(96);
            bytes.push_show(&mut found, &src[lx.start.as_slice()[i] as usize..lx.end.as_slice()[i] as usize]);
            found.push(96);
        } else {
            bytes.push_str(&mut found, "the end of the line");
        }
        self.msg.clear();
        if row && want == (ir_text_ll1_table.IR_START as u32) {
            bytes.push_str(&mut self.msg, "unknown line kind ");
            self.msg.extend_from_slice(found.as_slice());
            return;
        }
        if row && want == (ir_text_node_kinds.IR_KIND_VALUE_OP as u32) {
            bytes.push_str(&mut self.msg, "unknown op ");
            self.msg.extend_from_slice(found.as_slice());
            return;
        }
        // an instruction with the wrong number of operands: too few when its op node is still open
        // at the end of the operands, too many when an operand follows the closed node
        let mut op = NONE;
        for k in 0..self.node_kind.len() {
            let kd = self.node_kind.as_slice()[k];
            if kd == (ir_text_node_kinds.IR_KIND_VALUE_OP as u32) || kd == (ir_text_node_kinds.IR_KIND_EFFECT_OP as u32) { op = k as% u32; }
        }
        if op != NONE {
            let mut inside = false;
            for k in 0..self.open.len() {
                if self.open.as_slice()[k] == op { inside = true; }
            }
            let ends = tok == (ir_text_terminals.IR_T_EOF as u32) || tok == (ir_text_terminals.IR_T_BANG as u32);
            let (fixed, count) = self.arity(g, op);
            if fixed && ((inside && ends) || (!inside && starts_operand(tok))) {
                let t0 = self.node_tok.as_slice()[op as usize] as usize;
                bytes.push_str(&mut self.msg, "wrong arity: `");
                if t0 < n { bytes.push_show(&mut self.msg, &src[lx.start.as_slice()[t0] as usize..lx.end.as_slice()[t0] as usize]); }
                bytes.push_str(&mut self.msg, "` takes ");
                bytes.push_u64(&mut self.msg, count as u64);
                bytes.push_str(&mut self.msg, if count == 1 then " operand, found " else " operands, found ");
                self.msg.extend_from_slice(found.as_slice());
                return;
            }
        }
        bytes.push_str(&mut self.msg, "expected ");
        if row {
            row_expected(g, want, &mut self.msg);
        } else {
            describe(g, want, &mut self.msg);
        }
        bytes.push_str(&mut self.msg, ", found ");
        self.msg.extend_from_slice(found.as_slice());
    }

    // Whether op node `op` has a fixed operand count, and the count.
    fn arity(&self, g: &grammar.Grammar, op: u32) -> (bool, usize) {
        let kind = self.node_kind.as_slice()[op as usize];
        let rhs = g.rhs_rev(self.node_prod.as_slice()[op as usize]);
        let skip: usize = if kind == (ir_text_node_kinds.IR_KIND_VALUE_OP as u32) then 2 else 3;
        let take = if rhs.len() > skip then rhs.len() - skip else 0;
        let mut count: usize = 0;
        for k in 0..take {
            let s = rhs[k] as u32;
            if s & NT_BIT != 0 {
                if g.named.as_slice()[(s & 0x7fff) as usize] {
                    count = count + 1;
                } else {
                    return (false, 0);
                }
            } else {
                count = count + 1;
            }
        }
        return (true, count);
    }
}

// Tokens that begin an operand.
fn starts_operand(t: u32) -> bool {
    return t == (ir_text_terminals.IR_T_VAL as u32) || t == (ir_text_terminals.IR_T_INT as u32) || t == (ir_text_terminals.IR_T_HEX as u32) || t == (ir_text_terminals.IR_T_KW_BF16 as u32) || t == (ir_text_terminals.IR_T_S_ID as u32) || t == (ir_text_terminals.IR_T_FN_REF as u32) || t == (ir_text_terminals.IR_T_T_ID as u32);
}

pub fn describe(g: &grammar.Grammar, t: u32, out: &mut vec.Vec<u8>) {
    let s = if t == (ir_text_terminals.IR_T_VAL as u32) then "a value `%N`" else if t == (ir_text_terminals.IR_T_BLK as u32) then "a block label `bN`" else if t == (ir_text_terminals.IR_T_T_ID as u32) then "a type `tN`" else if t == (ir_text_terminals.IR_T_S_ID as u32) then "a string id `sN`" else if t == (ir_text_terminals.IR_T_D_ID as u32) then "a decl id `dN`" else if t == (ir_text_terminals.IR_T_FN_REF as u32) then "a fn `@N`" else if t == (ir_text_terminals.IR_T_INTR as u32) then "an intrinsic op" else if t == (ir_text_terminals.IR_T_INT as u32) then "an integer" else if t == (ir_text_terminals.IR_T_HEX as u32) then "a float constant" else if t == (ir_text_terminals.IR_T_BYTES as u32) then "bytes `x..`" else if t == (ir_text_terminals.IR_T_STRING as u32) then "a quoted string" else if t == (ir_text_terminals.IR_T_EOF as u32) then "the end of the line" else if t == (ir_text_terminals.IR_T_ANY_WORD as u32) then "a path" else "";
    if s.len() > 0 {
        bytes.push_str(out, s);
        return;
    }
    out.push(96);
    out.extend_from_slice(g.spell(t));
    out.push(96);
}

// What row nt of the table accepts.
fn row_expected(g: &grammar.Grammar, nt: u32, out: &mut vec.Vec<u8>) {
    if g.named.as_slice()[nt as usize] {
        if nt == (ir_text_node_kinds.IR_KIND_OPND as u32) {
            bytes.push_str(out, "an operand");
            return;
        }
        if nt == (ir_text_node_kinds.IR_KIND_FEATURE as u32) {
            bytes.push_str(out, "a feature name");
            return;
        }
        if nt == (ir_text_node_kinds.IR_KIND_KEY as u32) {
            bytes.push_str(out, "a type key");
            return;
        }
        if nt == (ir_text_node_kinds.IR_KIND_PATH as u32) {
            bytes.push_str(out, "a path");
            return;
        }
    }
    let nterm = g.nterm();
    let any = g.action(nt, ir_text_terminals.IR_T_ANY_WORD as u32) >= 0;
    let mut terms = vec.Vec::<u32>.new();
    for t in 0..nterm {
        let tt = t as% u32;
        if g.action(nt, tt) < 0 { continue; }
        if any && tt != (ir_text_terminals.IR_T_ANY_WORD as u32) && g.is_word.as_slice()[t] { continue; }
        terms.push(tt);
    }
    let shown = if terms.len() > 10 then 10usize else terms.len();
    let parts = shown + (if terms.len() > 10 then 1usize else 0usize);
    if parts == 0 {
        bytes.push_str(out, "nothing");
        return;
    }
    for k in 0..parts {
        if k > 0 { bytes.push_str(out, if k + 1 == parts then " or " else ", "); }
        if k < shown {
            describe(g, terms.as_slice()[k], out);
        } else {
            bytes.push_str(out, "...");
        }
    }
}

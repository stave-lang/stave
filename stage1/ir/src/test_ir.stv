// The IR text library: loading (lines, structure, verification), printing, and the faults of
// untrusted input.
import bytes;
import canon;
import errs;
import generated.known_items;
import generated.opt_table;
import load;
import model;
import print;
import read;
import test_scramble;
import verify;
import std.debug;
import std.mem;
import std.vec;

// The lines joined, each with its `\n`.
fn text(lines: &[&str]) -> vec.Vec<u8> {
    let mut v = vec.Vec::<u8>.new();
    for i in 0..lines.len() {
        v.extend_from_slice(mem.str_bytes(lines[i]));
        v.push(10);
    }
    return v;
}

// Whether the first fault's message contains s.
fn first_has(ld: &read.Loaded, s: &str) -> bool {
    if ld.errs.len() == 0 { return false; }
    let m = ld.errs.msg.row(0);
    let p = mem.str_bytes(s);
    if p.len() > m.len() { return false; }
    for i in 0..m.len() - p.len() + 1 {
        if m[i..i + p.len()].eq(p) { return true; }
    }
    return false;
}

fn example() -> vec.Vec<u8> {
    let lines = ["stave.ir 4 \"x86_64-linux-v2\" debug checked", "type t0 int s 32", "type t1 bool", "site 0 \"src/app.stv\" 1 4 app.max", "fn @0 app.max(t0, t0) -> t0 site 0 {", "b0(%0: t0, %1: t0):", "  %2 = gt t1 %0 %1", "  cbr %2 b1() b2()", "b1():", "  ret %0", "b2():", "  ret %1", "}"];
    return text(&lines);
}

test fn the_contract_example_loads_and_prints_back() {
    let src = example();
    let ld = load.load(src.as_slice());
    debug.assert(ld.ok(), "loads");
    debug.assert(ld.m.fns() == 1 && ld.m.types.len() == 2, "one fn, two types");
    let out = print.print(&ld.m);
    debug.assert(out.as_slice().eq(src.as_slice()), "prints the same bytes");
}

test fn spacing_comments_and_numbering_are_free() {
    let lines = ["stave.ir 4 \"x86_64-linux-v2\" debug checked  # header", "", "type t0 int s 32", "type\tt1 bool", "site 0 \"src/app.stv\" 1 4 app.max", "fn @0 app.max(t0, t0) -> t0 site 0 {", "b7(%5: t0, %9: t0):", "  %3 = gt t1 %5 %9", "  cbr %3 b4() b2()", "b4():", "  ret %5", "b2():", "  ret %9", "}"];
    let ld = load.load(text(&lines).as_slice());
    debug.assert(!ld.ok() && first_has(&ld, "begins with block b0"), "the entry block is b0");
    let lines2 = ["stave.ir 4 \"x86_64-linux-v2\" debug checked  # header", "", "type t0 int s 32", "type\tt1 bool", "site 0 \"src/app.stv\" 1 4 app.max", "fn @0 app.max(t0, t0) -> t0 site 0 {", "b0(%5: t0, %9: t0):", "  %3 = gt t1 %5 %9", "  cbr %3 b4() b2()", "b4():", "  ret %5", "b2():", "  ret %9", "}"];
    let ld2 = load.load(text(&lines2).as_slice());
    debug.assert(ld2.ok(), "any value and block numbers");
    let out = print.print(&ld2.m);
    debug.assert(out.as_slice().eq(example().as_slice()), "printed canonical");
}

test fn fns_are_ranked_by_instance_id() {
    let lines = ["stave.ir 4 \"x86_64-linux-v2\" debug checked", "type t0 int s 32", "fn @0.u a.f(t0)", "fn @1 a.g(t0)", "fn @0.0 a.f(t0)", "fn @0 a.f(t0)"];
    let ld = load.load(text(&lines).as_slice());
    debug.assert(ld.ok(), "loads");
    let out = print.print(&ld.m);
    let want = ["stave.ir 4 \"x86_64-linux-v2\" debug checked", "type t0 int s 32", "fn @0 a.f(t0)", "fn @0.0 a.f(t0)", "fn @0.u a.f(t0)", "fn @1 a.g(t0)"];
    debug.assert(out.as_slice().eq(text(&want).as_slice()), "@0, @0.0, @0.u, @1");
}

test fn faults_of_lines() {
    let cases = ["stave.ir 3 \"x86_64-linux-v2\" debug checked", "stave.ir 4 \"x86_64-linux\" debug checked", "stave.ir 4 \"x86_64-linux-v2\" debug opt", "nope 1 2", "stave.ir 4 \"x86_64-linux-v2\" debug checked extra", "type t0 int s 7", "str s0 \"\\x41\"", "str s0 \"abc", "type t0 int s -0"];
    let words = ["version 3", "canonical name", "only with mode", "unknown line kind", "after a complete line", "int width", "shorter form", "unterminated", "`-0`"];
    for k in 0..cases.len() {
        let one = [cases[k]];
        let ld = load.load(text(&one).as_slice());
        debug.assert(!ld.ok() && ld.errs.kind.as_slice()[0] == errs.K_SYNTAX, "a syntax fault");
        debug.assert(first_has(&ld, words[k]), "the fault's words");
    }
}

test fn faults_of_structure() {
    let hdr = "stave.ir 4 \"x86_64-linux-v2\" debug checked";
    let a = [hdr, "type t1 bool"];
    debug.assert(first_has(&load.load(text(&a).as_slice()), "out of order"), "types are dense");
    let b = [hdr, "type t0 bool", "type t1 bool"];
    debug.assert(first_has(&load.load(text(&b).as_slice()), "has the key of t0"), "no equal keys");
    let c = [hdr, "type t0 ref t5"];
    debug.assert(first_has(&load.load(text(&c).as_slice()), "t5 names no type line"), "ids name lines");
    let d = [hdr, "type t0 bool", "fn @0 a.f() {", "b0():", "  ret %4", "}"];
    debug.assert(first_has(&load.load(text(&d).as_slice()), "is not a value"), "values are defined");
    let e = [hdr, "type t0 bool", "fn @0 a.f() {", "b0():", "  ret", "b1():", "  ret", "}"];
    debug.assert(first_has(&load.load(text(&e).as_slice()), "unreachable from b0"), "every block is reachable");
    let f = [hdr, "type t0 bool", "fn @0 a.f() known"];
    debug.assert(first_has(&load.load(text(&f).as_slice()), "no compiler-known item"), "known names a known path");
    let g = ["type t0 bool", hdr];
    debug.assert(first_has(&load.load(text(&g).as_slice()), "begins with the `stave.ir` header"), "header first");
    let h = [hdr, "type t0 bool", "fn @0 a.f() {", "b0():", "  ret", "}", "claim @0 post zero <= result 0", "fn @0 a.f()"];
    debug.assert(first_has(&load.load(text(&h).as_slice()), "defined twice"), "one fn per instance");
}

test fn faults_of_verification() {
    let hdr = "stave.ir 4 \"x86_64-linux-v2\" debug checked";
    let a = [hdr, "type t0 int s 32", "type t1 bool", "fn @0 a.f(t0) -> t0 {", "b0(%0: t0):", "  %1 = add t1 %0 %0", "  ret %0", "}"];
    let la = load.load(text(&a).as_slice());
    debug.assert(!la.ok() && la.errs.kind.as_slice()[0] == errs.K_VERIFY && la.errs.line.as_slice()[0] == 6, "arithmetic on bool, at its line");
    let b = [hdr, "type t0 bool", "fn @0 a.f(t0) {", "b0(%0: t0):", "  br b0(%0)", "}"];
    debug.assert(first_has(&load.load(text(&b).as_slice()), "b0 (entry) cannot be a branch target"), "no branch to b0");
    let c = [hdr, "type t0 int s 32", "type t1 bool", "fn @0 a.f(t1, t0) -> t0 {", "b0(%0: t1, %1: t0):", "  cbr %0 b1() b2()", "b1():", "  %2 = add t0 %1 1", "  br b3()", "b2():", "  br b3()", "b3():", "  ret %2", "}"];
    debug.assert(first_has(&load.load(text(&c).as_slice()), "not dominated"), "uses are dominated");
    let d = [hdr, "type t0 int u size", "fn @0 a.f() -> t0 {", "b0():", "  %0 = intrinsic.nope t0", "  ret %0", "}"];
    debug.assert(first_has(&load.load(text(&d).as_slice()), "unknown intrinsic"), "intrinsics from the table");
    let e = [hdr, "type t0 int u size", "fn @0 a.f() -> t0 {", "b0():", "  %0 = intrinsic.main_addr t0", "  ret %0", "}"];
    debug.assert(load.load(text(&e).as_slice()).ok(), "a table intrinsic with its signature");
    let f = [hdr, "type t0 ref t0"];
    debug.assert(first_has(&load.load(text(&f).as_slice()), "component of itself"), "no type cycle");
    let g = [hdr, "type t0 int u 8", "static 0 t0 a.S", "data 0 3 x01"];
    debug.assert(first_has(&load.load(text(&g).as_slice()), "lie past its size"), "data inside its static");
}

test fn a_write_needs_a_mutable_pointer() {
    let hdr = "stave.ir 4 \"x86_64-linux-v2\" release lowered";
    let a = [hdr, "type t0 int u 32", "type t1 ref t0", "fn @0 a.f(t1) {", "b0(%0: t1):", "  store () %0 7", "  ret", "}"];
    let la = load.load(text(&a).as_slice());
    debug.assert(!la.ok() && la.errs.line.as_slice()[0] == 6 && first_has(&la, "store through a shared pointer"), "a store through a ref");
    let b = [hdr, "type t0 int u 32", "type t1 array t0 4", "type t2 ref t1", "type t3 ref mut t0", "fn @0 a.f(t2) {", "b0(%0: t2):", "  %1 = addr.elem t3 %0 1", "  store () %1 9", "  ret", "}"];
    let lb = load.load(text(&b).as_slice());
    debug.assert(!lb.ok() && lb.errs.line.as_slice()[0] == 8 && first_has(&lb, "mutable pointer from a shared pointer operand"), "a ref mut element of a ref array");
    let c = [hdr, "type t0 int u 32", "type t1 slice t0", "type t2 ref t1", "type t3 ptr mut t0", "fn @0 a.f(t2) -> t3 {", "b0(%0: t2):", "  %1 = slice.ptr t3 %0", "  ret %1", "}"];
    debug.assert(first_has(&load.load(text(&c).as_slice()), "mutable pointer from a shared pointer operand"), "a mutable element pointer of a shared slice");
    let d = [hdr, "type t0 int u 8", "type t1 str", "type t2 ref mut t1", "str s0 \"abc\"", "fn @1 a.g(t2)", "fn @0 a.f() {", "b0():", "  call () @1 s0", "  ret", "}"];
    debug.assert(first_has(&load.load(text(&d).as_slice()), "string operand cannot have type"), "a string is shared");
    let e = [hdr, "type t0 int u 32", "type t1 ref t0", "type t2 ptr const t0", "type t3 ptr mut t0", "fn @0 a.f(t1) {", "b0(%0: t1):", "  %1 = cast t2 %0", "  %2 = cast t3 %1", "  store () %2 7", "  ret", "}"];
    debug.assert(load.load(text(&e).as_slice()).ok(), "a cast to a raw pointer is trusted");
    let f = [hdr, "type t0 int u 32", "type t1 ref t0", "type t2 ref mut t0", "fn @0 a.f(t1) {", "b0(%0: t1):", "  %1 = cast t2 %0", "  store () %1 7", "  ret", "}"];
    debug.assert(first_has(&load.load(text(&f).as_slice()), "mutable pointer from a shared pointer operand"), "no ref mut cast of a ref");
    let g = [hdr, "type t0 int u 32", "type t1 ref mut t0", "fn @0 a.f() {", "b0():", "  %0 = slot t1", "  store () %0 7", "  ret", "}"];
    debug.assert(load.load(text(&g).as_slice()).ok(), "a store to a slot");
    // a field read of another variant than the value's is not seen by the rule (a stated residual)
    let h = [hdr, "decl d0 enum app.E", "type t0 int u 32", "type t1 ref t0", "type t2 ref mut t0", "type t3 adt d0", "shape t3 enum | t1 | t2", "fn @0 app.f(t1) {", "b0(%0: t1):", "  %1 = enum.make t3 0 %0", "  %2 = enum.get t2 %1 1 0", "  store () %2 7", "  ret", "}"];
    debug.assert(load.load(text(&h).as_slice()).ok(), "a variant pun by value");
    let k = [hdr, "decl d0 enum app.E", "type t0 int u 32", "type t1 ref t0", "type t2 ref mut t0", "type t3 adt d0", "type t4 ref mut t3", "type t5 ref mut t2", "shape t3 enum | t1 | t2", "fn @0 app.f(t1) {", "b0(%0: t1):", "  %1 = slot t4", "  %2 = enum.make t3 0 %0", "  store () %1 %2", "  %3 = addr.enum_field t5 %1 1 0", "  %4 = load t2 %3", "  store () %4 7", "  ret", "}"];
    debug.assert(load.load(text(&k).as_slice()).ok(), "a variant pun through memory");
}

test fn slots_are_a_prefix_of_b0() {
    let hdr = "stave.ir 4 \"x86_64-linux-v2\" debug checked";
    let a = [hdr, "type t0 int s 32", "type t1 ref mut t0", "fn @0 a.f(t0) {", "b0(%0: t0):", "  %1 = slot t1", "  %2 = slot t1", "  store () %1 %0", "  ret", "}"];
    debug.assert(load.load(text(&a).as_slice()).ok(), "slots first");
    let b = [hdr, "type t0 int s 32", "type t1 ref mut t0", "fn @0 a.f(t0) {", "b0(%0: t0):", "  %1 = slot t1", "  store () %1 %0", "  %2 = slot t1", "  ret", "}"];
    let lb = load.load(text(&b).as_slice());
    debug.assert(!lb.ok() && lb.errs.line.as_slice()[0] == 8 && first_has(&lb, "slots are a prefix of b0"), "a slot after a store, at its line");
}

test fn a_constant_switch_scrutinee_only_at_level_opt() {
    let body = ["type t0 int s 32", "fn @0 a.f() -> t0 {", "b0():", "  switch 5 5:b1() 18446744073709551621:b2() _:b2()", "b1():", "  ret 1", "b2():", "  ret 2", "}"];
    let ho = ["stave.ir 4 \"x86_64-linux-v2\" release opt"];
    let mut at_opt = text(&ho);
    at_opt.extend_from_slice(text(&body).as_slice());
    debug.assert(load.load(at_opt.as_slice()).ok(), "an int constant at opt, cases of any value");
    let hc = ["stave.ir 4 \"x86_64-linux-v2\" release checked"];
    let mut at_checked = text(&hc);
    at_checked.extend_from_slice(text(&body).as_slice());
    debug.assert(first_has(&load.load(at_checked.as_slice()), "scrutinee must be a value"), "a value below opt");
    let dup = ["stave.ir 4 \"x86_64-linux-v2\" release opt", "type t0 int s 32", "fn @0 a.f() -> t0 {", "b0():", "  switch 5 5:b1() 5:b2() _:b2()", "b1():", "  ret 1", "b2():", "  ret 2", "}"];
    debug.assert(first_has(&load.load(text(&dup).as_slice()), "duplicate switch case"), "duplicates refused");
}

test fn an_unchecked_entry_is_not_held_at_level_lowered() {
    let body = ["type t0 bool", "fn @0 a.f() {", "b0():", "  ret", "}", "fn @0.u a.f() {", "b0():", "  ret", "}"];
    let hl = ["stave.ir 4 \"x86_64-linux-v2\" debug lowered"];
    let mut at_lowered = text(&hl);
    at_lowered.extend_from_slice(text(&body).as_slice());
    let ll = load.load(at_lowered.as_slice());
    debug.assert(!ll.ok() && ll.errs.line.as_slice()[0] == 7 && first_has(&ll, "is an unchecked entry"), "an entry at lowered, at its fn line");
    let hc = ["stave.ir 4 \"x86_64-linux-v2\" debug checked"];
    let mut at_checked = text(&hc);
    at_checked.extend_from_slice(text(&body).as_slice());
    debug.assert(load.load(at_checked.as_slice()).ok(), "an entry at checked");
    let claim = ["type t0 bool", "fn @0 a.f() {", "b0():", "  ret", "}", "claim @0 post zero <= zero 0"];
    let mut with_claim = text(&hl);
    with_claim.extend_from_slice(text(&claim).as_slice());
    debug.assert(first_has(&load.load(with_claim.as_slice()), "no `claim` line at level `lowered`"), "no claim at lowered");
}

test fn a_claim_names_a_param_of_its_fn() {
    let ok = ["stave.ir 4 \"x86_64-linux-v2\" debug checked", "type t0 int u size", "fn @0 a(t0) -> t0 {", "b0(%0: t0):", "  ret %0", "}", "claim @0 pre zero <= p 0 3", "claim @0 post result <= p 0 0"];
    debug.assert(load.load(text(&ok).as_slice()).ok(), "rows on param 0");
    let bad = ["stave.ir 4 \"x86_64-linux-v2\" debug checked", "type t0 int u size", "fn @0 a(t0) -> t0 {", "b0(%0: t0):", "  ret %0", "}", "claim @0 pre zero <= lenp 7 0"];
    let lb = load.load(text(&bad).as_slice());
    debug.assert(!lb.ok() && lb.errs.kind.as_slice()[0] == errs.K_VERIFY && lb.errs.line.as_slice()[0] == 3 && first_has(&lb, "claim names param 7"), "a row on a param the fn lacks, at the fn line");
}

test fn the_opt_table_keeps_the_closed_size_rules() {
    debug.assert(opt_table.OPT_TERM_BR == opt_table.OPT_TERM_RET, "br weighs what ret weighs");
    debug.assert(opt_table.OPT_ROUNDS >= 1, "at least one round");
    let off = opt_table.OPT_OP_NAME_OFF;
    let names = opt_table.OPT_OP_NAME;
    let mut call = false;
    for i in 0..opt_table.OPT_OP_N {
        if names[off[i] as usize..off[i + 1] as usize].eq(mem.str_bytes("call")) {
            call = true;
            debug.assert(opt_table.OPT_CALL_SAVED <= opt_table.OPT_OP_WEIGHT[i], "call_saved within the weight of call");
        }
    }
    debug.assert(call, "a row for call");
    let mut inlined: u32 = 0;
    for k in 0..known_items.KNOWN_N {
        if known_items.KNOWN_INLINE[k] {
            inlined += 1;
            debug.assert(!known_items.KNOWN_REPORT[k] && known_items.KNOWN_ABI_RET[k] == known_items.ITY_NONE, "an inlined known item has no report and no ABI");
        }
    }
    debug.assert(inlined >= 1, "set_user_site is inlined");
}

test fn an_intrinsic_is_built_for_the_header_target() {
    let x86 = ["stave.ir 4 \"x86_64-linux-v2\" debug checked", "type t0 int u 64", "type t1 int u 32", "fn @0 a.f(t1) -> t0 {", "b0(%0: t1):", "  %1 = intrinsic.xgetbv t0 %0", "  ret %1", "}"];
    debug.assert(load.load(text(&x86).as_slice()).ok(), "xgetbv on x86-64");
    let a64 = ["stave.ir 4 \"aarch64-linux\" debug checked", "type t0 int u 64", "type t1 int u 32", "fn @0 a.f(t1) -> t0 {", "b0(%0: t1):", "  %1 = intrinsic.xgetbv t0 %0", "  ret %1", "}"];
    let ld = load.load(text(&a64).as_slice());
    debug.assert(!ld.ok() && first_has(&ld, "not built for the target arch AArch64") && ld.errs.line.as_slice()[0] == 6, "xgetbv on AArch64, at its line");
}

test fn a_deep_type_chain_is_a_fault_not_a_deep_stack() {
    let mut v = vec.Vec::<u8>.new();
    bytes.push_str(&mut v, "stave.ir 4 \"x86_64-linux-v2\" debug checked\ntype t0 bool\n");
    for k in 1..1500u32 {
        bytes.push_str(&mut v, "type t");
        bytes.push_u32(&mut v, k);
        bytes.push_str(&mut v, " ref t");
        bytes.push_u32(&mut v, k - 1);
        v.push(10);
    }
    let ld = load.load(v.as_slice());
    debug.assert(!ld.ok() && first_has(&ld, "nested deeper than 1000"), "too deep");
}

test fn any_bytes_load_or_fault() {
    let mut x: u64 = 0x139_408d_cbbf_7a44;
    let base = example();
    for _ in 0..300u32 {
        let mut v = vec.Vec::<u8>.new();
        v.extend_from_slice(base.as_slice());
        for _ in 0..3u32 {
            x = x ^ (x << 13);
            x = x ^ (x >> 7);
            x = x ^ (x << 17);
            let at = (x % (v.len() as u64)) as usize;
            v.as_mut_slice()[at] = (x >> 32) as% u8;
        }
        let ld = load.load(v.as_slice());
        if ld.ok() {
            let out = print.print(&ld.m);
            let again = load.load(out.as_slice());
            debug.assert(again.ok(), "an accepted text prints a loadable one");
        } else {
            debug.assert(ld.errs.len() <= errs.MAX, "at most 100 faults");
        }
    }
}

test fn i128_text() {
    let mut v = vec.Vec::<u8>.new();
    bytes.push_i128(&mut v, 0x8000_0000_0000_0000, 0);
    debug.assert(v.as_slice().eq(mem.str_bytes("-170141183460469231731687303715884105728")), "i128 min");
    v.clear();
    bytes.push_i128(&mut v, 0x7fff_ffff_ffff_ffff, 0xffff_ffff_ffff_ffff);
    debug.assert(v.as_slice().eq(mem.str_bytes("170141183460469231731687303715884105727")), "i128 max");
    v.clear();
    bytes.push_i128(&mut v, 0xffff_ffff_ffff_ffff, 0xffff_ffff_ffff_ffff);
    debug.assert(v.as_slice().eq(mem.str_bytes("-1")), "-1");
    v.clear();
    bytes.quote(&mut v, mem.str_bytes("a\"\\\n\t"));
    debug.assert(v.as_slice().eq(mem.str_bytes("\"a\\\"\\\\\\n\\t\"")), "the escape rule");
}

// Loads src (it must load), canonicalizes it, and checks that it prints want, and prints want
// again after a second canonicalization.
fn canon_prints(src: &[u8], want: &[u8], what: &str) {
    let mut ld = load.load(src);
    debug.assert(ld.ok(), what);
    canon.canon(&mut ld.m);
    debug.assert(print.print(&ld.m).as_slice().eq(want), what);
    canon.canon(&mut ld.m);
    debug.assert(print.print(&ld.m).as_slice().eq(want), "canon is idempotent");
}

fn types_text() -> vec.Vec<u8> {
    let lines = ["stave.ir 4 \"x86_64-linux-v2\" debug checked", "decl d0 struct a.S", "decl d1 struct a.Unused", "type t0 slice t2 align 0", "type t1 adt d0 5", "type t2 int u 8", "type t3 adt d0 -3", "type t4 slice t2", "type t5 adt d1", "type t6 ref t3", "type t7 ref t1", "type t8 ref t0", "type t9 ref t4", "shape t1 struct t2", "shape t3 struct t2", "fn @0 a.f(t7, t6) {", "b0(%0: t7, %1: t6):", "  ret", "}", "fn @1 a.g(t8, t9)"];
    return text(&lines);
}

test fn types_are_p_then_s_in_canonical_order_and_unused_ones_go() {
    let want = ["stave.ir 4 \"x86_64-linux-v2\" debug checked", "decl d0 struct a.S", "type t0 ref t2", "type t1 ref t3", "type t2 adt d0 -3", "type t3 adt d0 5", "type t4 int u 8", "type t5 ref t7", "type t6 ref t8", "type t7 slice t4", "type t8 slice t4 align 0", "shape t2 struct t4", "shape t3 struct t4", "fn @0 a.f(t1, t0) {", "b0(%0: t1, %1: t0):", "  ret", "}", "fn @1 a.g(t6, t5)"];
    canon_prints(types_text().as_slice(), text(&want).as_slice(), "P (the body's), then S (shapes, bodiless fns); -3 before 5; no alignment before `align 0`");
}

test fn a_canonical_text_is_unchanged() {
    let src = example();
    canon_prints(src.as_slice(), src.as_slice(), "the contract example");
}

fn values_and_pool() -> vec.Vec<u8> {
    let lines = ["stave.ir 4 \"x86_64-linux-v2\" debug checked", "type t0 int u 64", "type t1 bool", "fn @0 a.g(t0, t0) -> t0 {", "b0(%0: t0, %1: t0):", "  %2 = add.wrap t0 %0 7", "  %3 = lt t1 %2 9", "  cbr %3 b1(%2) b2()", "b1(%4: t0):", "  %5 = add.wrap t0 %4 9", "  ret %5", "b2():", "  ret 7", "}"];
    return text(&lines);
}

test fn values_and_the_pool_are_renumbered_in_print_order() {
    let src = values_and_pool();
    let mut ld = load.load(src.as_slice());
    debug.assert(ld.ok() && ld.m.fn_val_n.as_slice()[0] == 6 && ld.m.fn_const_n.as_slice()[0] == 2, "loads: six values, two constants");
    // values: old v becomes sigma[v], each block's params still a run
    let sigma = [4u32, 5, 1, 0, 3, 2];
    {
        let m = &mut ld.m;
        let old_ty = [m.val_ty.as_slice()[0], m.val_ty.as_slice()[1], m.val_ty.as_slice()[2], m.val_ty.as_slice()[3], m.val_ty.as_slice()[4], m.val_ty.as_slice()[5]];
        for v in 0..6usize {
            m.val_ty.as_mut_slice()[sigma[v] as usize] = old_ty[v];
        }
        m.blk_val_lo.as_mut_slice()[0] = sigma[0];
        m.blk_val_lo.as_mut_slice()[1] = sigma[4];
        m.blk_val_lo.as_mut_slice()[2] = 0;
        for i in 0..m.ins_res.len() {
            let r = m.ins_res.as_slice()[i];
            m.ins_res.as_mut_slice()[i] = sigma[r as usize];
        }
        // the pool: entries swapped, and a second entry for 7 that only `ret 7` names
        let k0 = m.const_kind.as_slice()[0];
        let b0 = m.const_bits.as_slice()[0];
        let k1 = m.const_kind.as_slice()[1];
        let b1 = m.const_bits.as_slice()[1];
        m.const_kind.as_mut_slice()[0] = k1;
        m.const_bits.as_mut_slice()[0] = b1;
        m.const_kind.as_mut_slice()[1] = k0;
        m.const_bits.as_mut_slice()[1] = b0;
        m.const_kind.push(k0);
        m.const_bits.push(b0);
        m.fn_const_n.as_mut_slice()[0] = 3;
        let last = m.opnd_kind.len() - 1;
        for x in 0..m.opnd_kind.len() {
            let id = m.opnd_id.as_slice()[x];
            if m.opnd_kind.as_slice()[x] == model.O_VALUE {
                m.opnd_id.as_mut_slice()[x] = sigma[id as usize];
            } else if m.opnd_kind.as_slice()[x] == model.O_CONST {
                m.opnd_id.as_mut_slice()[x] = if x == last then 2u32 else 1 - id;
            }
        }
    }
    debug.assert(!print.print(&ld.m).as_slice().eq(src.as_slice()), "the edit shows in the text");
    canon.canon(&mut ld.m);
    debug.assert(print.print(&ld.m).as_slice().eq(src.as_slice()), "renumbered as read");
    let last = ld.m.opnd_kind.len() - 1;
    debug.assert(ld.m.fn_const_n.as_slice()[0] == 2 && ld.m.opnd_id.as_slice()[last] == 0, "one entry per constant, by first use");
    let (_, seven) = ld.m.wide.as_u64(ld.m.const_bits.as_slice()[0] as% u32);
    debug.assert(seven == 7, "7 is used first");
}

fn intrinsic_text() -> vec.Vec<u8> {
    let lines = ["stave.ir 4 \"x86_64-linux-v2\" debug checked", "type t0 int u 64", "type t1 int u size", "type t2 bool", "fn @0 a.f(t0) -> t0 {", "b0(%0: t0):", "  %1 = lt t2 %0 3", "  cbr %1 b1() b2()", "b1():", "  ret 3", "b2():", "  %2 = intrinsic.thread_start_addr t1", "  ret %0", "}"];
    return text(&lines);
}

test fn an_unreachable_block_goes_with_its_names_and_types() {
    let mut ld = load.load(intrinsic_text().as_slice());
    debug.assert(ld.ok() && ld.m.intr.rows() == 1, "loads, one intrinsic name");
    // b0 now branches to b1 only: b2 is no longer reachable
    ld.m.blk_tkind.as_mut_slice()[0] = model.TM_BR;
    ld.m.blk_topnd.as_mut_slice()[0] = model.NONE;
    ld.m.blk_tgt_n.as_mut_slice()[0] = 1;
    canon.canon(&mut ld.m);
    let want = ["stave.ir 4 \"x86_64-linux-v2\" debug checked", "type t0 int u 64", "type t1 bool", "fn @0 a.f(t0) -> t0 {", "b0(%0: t0):", "  %1 = lt t1 %0 3", "  br b1()", "b1():", "  ret 3", "}"];
    debug.assert(print.print(&ld.m).as_slice().eq(text(&want).as_slice()), "b2, its intrinsic name, and `int u size` dropped");
    debug.assert(ld.m.intr.rows() == 0 && ld.m.fn_blk_n.as_slice()[0] == 2 && ld.m.fn_val_n.as_slice()[0] == 2 && ld.m.fn_const_n.as_slice()[0] == 1, "tables shrunk");
}

fn loop_text() -> vec.Vec<u8> {
    let lines = ["stave.ir 4 \"x86_64-linux-v2\" debug checked", "type t0 int u 64", "type t1 bool", "fn @2 app.sum(t0) -> t0 {", "b0(%0: t0):", "  br b1(0, 0)", "b1(%1: t0, %2: t0):", "  %3 = eq t1 %1 %0", "  cbr %3 b3() b4()", "b2(%4: t0):", "  ret %4", "b3():", "  br b2(%2)", "b4():", "  %5 = add t0 %2 %1", "  %6 = add t0 %1 1", "  br b1(%6, %5)", "}"];
    return text(&lines);
}

fn switch_text() -> vec.Vec<u8> {
    let lines = ["stave.ir 4 \"x86_64-linux-v2\" release checked", "type t0 int u 8", "type t1 int u 64", "type t2 int u size", "type t3 int s 32", "type t4 bool", "type t5 str", "type t6 ref t5", "str s0 \"hi\"", "fn @0 main.sel(t1) -> t1 {", "b0(%0: t1):", "  switch %0 0:b1() 1:b2() _:b3()", "b1():", "  ret 10", "b2():", "  ret 20", "b3():", "  ret 30", "}", "fn @1 main.note(t6) {", "b0(%0: t6):", "  %1 = slice.len t2 %0", "  ret", "}", "fn @2 main.ovf(t0) -> t0 {", "b0(%0: t0):", "  %1 = add t0 %0 9", "  ret %1", "}", "fn @3 main.main() -> t3 {", "b0():", "  %0 = call t1 @0 1", "  call () @1 s0", "  %1 = call t0 @2 250", "  %2 = eq t4 %1 0", "  %3 = select t1 1 %0 7", "  cbr %2 b1(%3) b1(%3)", "b1(%4: t1):", "  %5 = cast.wrap t3 %4", "  ret %5", "}"];
    return text(&lines);
}

fn slots_text() -> vec.Vec<u8> {
    let lines = ["stave.ir 4 \"x86_64-linux-v2\" release checked", "type t0 int u 64", "type t1 int s 32", "type t2 ref mut t0", "type t3 ref mut t4", "type t4 tuple t0 t0", "site 0 \"src/main.stv\" 1 4 main.h", "site 1 \"src/main.stv\" 6 4 main.g", "site 2 \"src/main.stv\" 8 12 main.g", "site 3 \"src/main.stv\" 11 4 main.main", "site 4 \"src/main.stv\" 13 13 main.main", "site 5 \"src/main.stv\" 14 13 main.main", "main @2", "fn @0 main.h(t0) -> t0 site 0 {", "b0(%0: t0):", "  %1 = slot t2", "  store () %1 %0", "  %2 = load t0 %1", "  %3 = add.wrap t0 %2 1", "  ret %3", "}", "fn @1 main.g(t0) -> t0 site 1 {", "b0(%0: t0):", "  %1 = slot t3", "  %2 = make t4 %0 %0", "  store () %1 %2", "  %3 = addr.field t2 %1 0", "  %4 = load t0 %3", "  %5 = call t0 @0 %4 !2", "  ret %5", "}", "fn @2 main.main() -> t1 site 3 {", "b0():", "  %0 = slot t2", "  store () %0 3", "  %1 = load t0 %0", "  %2 = call t0 @1 %1 !4", "  %3 = call t0 @0 %2 !5", "  %4 = cast.wrap t1 %3", "  ret %4", "}"];
    return text(&lines);
}

fn statics_text() -> vec.Vec<u8> {
    let lines = ["stave.ir 4 \"x86_64-linux-v2\" debug checked", "type t0 int u 32", "type t1 int u size", "type t2 bool", "type t3 str", "type t4 ref t3", "type t5 ptr const t0", "str s0 \"hi\"", "str s1 \"there\"", "site 0 \"src/app.stv\" 1 4 app.get", "site 1 \"src/app.stv\" 4 4 app.note", "site 2 \"src/app.stv\" 8 4 app.main", "site 3 \"src/app.stv\" 9 9 app.main", "site 4 \"src/app.stv\" 11 13 app.main", "static 0 t0 app.COUNT", "data 0 0 x2a", "fn @0 app.get() -> t0 site 0 {", "b0():", "  %0 = intrinsic.static_addr t5 0", "  %1 = load t0 %0", "  ret %1", "}", "fn @1 app.note(t4) -> t1 site 1 {", "b0(%0: t4):", "  %1 = slice.len t1 %0", "  ret %1", "}", "fn @2 app.main(t0) -> t0 site 2 {", "b0(%0: t0):", "  %1 = call t1 @1 s0 !3", "  %2 = call t1 @1 s1 !3", "  br b1(0, %0)", "b1(%3: t0, %4: t0):", "  %5 = call t0 @0 !4", "  %6 = add.wrap t0 %3 %5", "  %7 = sub.wrap t0 %4 1", "  %8 = eq t2 %7 0", "  cbr %8 b2() b1(%6, %7)", "b2():", "  switch %6 0:b3() 7:b3() _:b4()", "b3():", "  ret 0", "b4():", "  ret %6", "}"];
    return text(&lines);
}

fn floats_text() -> vec.Vec<u8> {
    let lines = ["stave.ir 4 \"x86_64-linux-v2\" debug checked", "type t0 int u 64", "type t1 float 32", "type t2 float 64", "fn @0 app.f(t0, t1, t2) -> t1 {", "b0(%0: t0, %1: t1, %2: t2):", "  %3 = add.wrap t0 %0 0", "  %4 = add t1 %1 0x00000000", "  %5 = add t2 %2 0x0000000000000000", "  %6 = add t1 %4 0x80000000", "  ret %6", "}", "fn @1 app.g(t0) -> t0 {", "b0(%0: t0):", "  %1 = add.wrap t0 %0 1", "  %2 = add.wrap t0 %1 0", "  ret %2", "}"];
    return text(&lines);
}

// Whether a and b have equal body columns and intrinsic tables.
fn same_bodies(a: &model.Module, b: &model.Module) -> bool {
    let fns = a.fn_blk_lo.as_slice().eq(b.fn_blk_lo.as_slice()) && a.fn_blk_n.as_slice().eq(b.fn_blk_n.as_slice()) && a.fn_val_lo.as_slice().eq(b.fn_val_lo.as_slice()) && a.fn_val_n.as_slice().eq(b.fn_val_n.as_slice()) && a.fn_const_lo.as_slice().eq(b.fn_const_lo.as_slice()) && a.fn_const_n.as_slice().eq(b.fn_const_n.as_slice());
    let blks = a.blk_val_lo.as_slice().eq(b.blk_val_lo.as_slice()) && a.blk_param_n.as_slice().eq(b.blk_param_n.as_slice()) && a.blk_ins_lo.as_slice().eq(b.blk_ins_lo.as_slice()) && a.blk_ins_n.as_slice().eq(b.blk_ins_n.as_slice()) && a.blk_tkind.as_slice().eq(b.blk_tkind.as_slice()) && a.blk_topnd.as_slice().eq(b.blk_topnd.as_slice()) && a.blk_tgt_lo.as_slice().eq(b.blk_tgt_lo.as_slice()) && a.blk_tgt_n.as_slice().eq(b.blk_tgt_n.as_slice());
    let ins = a.val_ty.as_slice().eq(b.val_ty.as_slice()) && a.ins_op.as_slice().eq(b.ins_op.as_slice()) && a.ins_intr.as_slice().eq(b.ins_intr.as_slice()) && a.ins_ty.as_slice().eq(b.ins_ty.as_slice()) && a.ins_res.as_slice().eq(b.ins_res.as_slice()) && a.ins_opnd_lo.as_slice().eq(b.ins_opnd_lo.as_slice()) && a.ins_opnd_n.as_slice().eq(b.ins_opnd_n.as_slice()) && a.ins_site.as_slice().eq(b.ins_site.as_slice());
    let rows = a.opnd_kind.as_slice().eq(b.opnd_kind.as_slice()) && a.opnd_id.as_slice().eq(b.opnd_id.as_slice()) && a.tgt_blk.as_slice().eq(b.tgt_blk.as_slice()) && a.tgt_opnd_lo.as_slice().eq(b.tgt_opnd_lo.as_slice()) && a.tgt_opnd_n.as_slice().eq(b.tgt_opnd_n.as_slice()) && a.tgt_case.as_slice().eq(b.tgt_case.as_slice()) && a.const_kind.as_slice().eq(b.const_kind.as_slice()) && a.const_bits.as_slice().eq(b.const_bits.as_slice());
    return fns && blks && ins && rows && a.intr.data().eq(b.intr.data()) && a.intr.offsets().eq(b.intr.offsets());
}

// Every embedded text, scrambled with several seeds, canonicalizes to what it canonicalizes to
// unscrambled, and the result passes the verifier. Canon keeps a canonical text, and its body
// columns are then the reader's (it lays a body out in print order); for another text they are
// those of the unscrambled text canonicalized.
test fn canon_undoes_every_scramble() {
    let texts = [example(), values_and_pool(), types_text(), intrinsic_text(), loop_text(), switch_text(), slots_text(), statics_text(), floats_text()];
    // all but the type table text are canonical (stage0's `ir fmt` prints them back)
    let is_canonical = [true, true, false, true, true, true, true, true, true];
    for k in 0..texts.len() {
        let src = texts[k].as_slice();
        let mut base = load.load(src);
        debug.assert(base.ok(), "the text loads");
        let read_as = print.print(&base.m);
        canon.canon(&mut base.m);
        let want = print.print(&base.m);
        let canonical = is_canonical[k];
        debug.assert(!canonical || (read_as.as_slice().eq(src) && want.as_slice().eq(src)), "canon keeps a canonical text");
        let reference = if canonical then load.load(src) else base;
        for s in 0..12u64 {
            let mut ld = load.load(src);
            test_scramble.scramble(&mut ld.m, (k as u64) * 1000 + s);
            debug.assert(!print.print(&ld.m).as_slice().eq(want.as_slice()), "the scramble shows in the text");
            canon.canon(&mut ld.m);
            debug.assert(print.print(&ld.m).as_slice().eq(want.as_slice()), "canon undoes the scramble");
            debug.assert(same_bodies(&ld.m, &reference.m), "the body rows of the canonical module");
            verify.verify(&mut ld);
            debug.assert(ld.ok(), "the verifier accepts the canonical module");
        }
    }
}

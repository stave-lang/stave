// The target features (contracts/simd-ops.md §Features), in their listing order (= bit), each
// with the features it implies directly. The front end's `needs` sets and the IR's `needs(..)`
// and `fntype` lists read this one table.
import std.mem;
import std.vec;

pub const COUNT: usize = 24;
pub const NAMES: &str = "sse42 avx avx2 fma bmi2 f16c avx512f avx512bw avx512vl avx512dq avx512cd avx512vbmi avx512vbmi2 avx512vpopcntdq avx512bitalg avx512fp16 avx512bf16 neon fp16 dotprod bf16 sve sve2 cuda";
pub const IMPLIES: [u32; 24] = [0, 1, 2, 2, 0, 2, 44, 64, 64, 64, 64, 128, 128, 64, 128, 896, 128, 0, 131072, 131072, 131072, 262144, 2097152, 0];

const NONE: u32 = 4294967295;

// The closure of feature set `bits` under implication.
pub fn closure(bits: u64) -> u64 {
    let imp = IMPLIES;
    let mut s = bits;
    loop {
        let mut next = s;
        for f in 0..COUNT {
            if (s >> f as u64) & 1 == 1 { next = next | (imp[f] as u64); }
        }
        if next == s { return s; }
        s = next;
    }
}

// The features of set `bits` no other one of the set implies directly: on a closed set, the
// generators a `needs(..)` or `fntype` list prints.
pub fn maximal(bits: u64) -> u64 {
    let imp = IMPLIES;
    let mut out: u64 = 0;
    for f in 0..COUNT {
        if (bits >> f as u64) & 1 == 0 { continue; }
        let mut implied = false;
        for g in 0..COUNT {
            if g != f && (bits >> g as u64) & 1 == 1 && (imp[g] >> f as% u32) & 1 == 1 { implied = true; }
        }
        if !implied { out = out | (1u64 << f as u64); }
    }
    return out;
}

// The byte range of feature f's name in `NAMES`.
pub fn name(f: usize) -> (usize, usize) {
    let b = mem.str_bytes(NAMES);
    let mut at: usize = 0;
    let mut seen: usize = 0;
    for i in 0..b.len() + 1 {
        if i == b.len() || b[i] == 32 {
            if seen == f { return (at, i); }
            seen = seen + 1;
            at = i + 1;
        }
    }
    return (0, 0);
}

// Appends feature f's name.
pub fn push_name(buf: &mut vec.Vec<u8>, f: usize) {
    let (a, b) = name(f);
    buf.extend_from_slice(&mem.str_bytes(NAMES)[a..b]);
}

// The bit of the feature named b, or NONE.
pub fn index(b: &[u8]) -> u32 {
    let w = mem.str_bytes(NAMES);
    let mut at: usize = 0;
    let mut seen: u32 = 0;
    for i in 0..w.len() + 1 {
        if i == w.len() || w[i] == 32 {
            if w[at..i].eq(b) { return seen; }
            seen = seen + 1;
            at = i + 1;
        }
    }
    return NONE;
}

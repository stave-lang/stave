// The integer evaluator against the Rust one of stage0 (crates/stave-ir/src/arith.rs): every
// digest and spot row below was printed by it.
//
// A case is (op, type, a, b). Per (op, type) the digest folds the outcome (status, value) of, in order:
//   - all 2^n x 2^n pairs of raw patterns for n <= 8 (one operand: all 2^n), read through `norm`;
//   - the grid: every pair of 16 boundary patterns (0 1 2 3 7, n - 1 n n + 1, the signed min with
//     its neighbours, the unsigned max with its neighbours, 0101.. and 1010..) of width n;
//   - 1000 seeded pairs: `a` a xorshift word, `b` alternately a word and a word modulo 2n (shift
//     amounts and small divisors).
// A shift's amount is the value of `b` read in the type. Types: s8 u8 s16 u16 s32 u32 s64 u64 bool.
// Casts: per kind, every (from, to) of the classes s8 u8 s16 u16 s32 u32 s64 u64 bool char ptr, over
// all 2^n values for n <= 8, the grid (for char also the edges of the scalar value range and of the
// surrogates), and 64 seeded values; an outcome that is not a value is status 3.
import arith;
import generated.ir_text_terminals as ops;
import std.debug;
import std.io;
import std.vec;

const NOPS: usize = 28;
const NTYPES: usize = 9;
const NCLS: usize = 11;

// Op codes: 0..=22 two operands, 23..=27 one, 28..=30 casts.
const TERMS: [u16; 31] = [
    ops.IR_T_KW_ADD, ops.IR_T_KW_SUB, ops.IR_T_KW_MUL, ops.IR_T_KW_DIV, ops.IR_T_KW_REM,
    ops.IR_T_ADD_DOT_WRAP, ops.IR_T_SUB_DOT_WRAP, ops.IR_T_MUL_DOT_WRAP,
    ops.IR_T_ADD_DOT_SAT, ops.IR_T_SUB_DOT_SAT, ops.IR_T_MUL_DOT_SAT,
    ops.IR_T_KW_AND, ops.IR_T_KW_OR, ops.IR_T_KW_XOR, ops.IR_T_KW_SHL, ops.IR_T_KW_SHR, ops.IR_T_SHL_DOT_WRAP,
    ops.IR_T_KW_EQ, ops.IR_T_KW_NE, ops.IR_T_KW_LT, ops.IR_T_KW_LE, ops.IR_T_KW_GT, ops.IR_T_KW_GE,
    ops.IR_T_KW_NEG, ops.IR_T_KW_NOT, ops.IR_T_KW_POPCOUNT, ops.IR_T_KW_CLZ, ops.IR_T_KW_CTZ,
    ops.IR_T_KW_CAST, ops.IR_T_CAST_DOT_WRAP, ops.IR_T_CAST_DOT_SAT,
];
const BITS: [u8; NTYPES] = [8, 8, 16, 16, 32, 32, 64, 64, 1];
const SIGNED: [bool; NTYPES] = [true, false, true, false, true, false, true, false, false];

fn ty(i: usize) -> arith.IntTy {
    return arith.IntTy.new(BITS[i], SIGNED[i]);
}

// The cast class i: 0..=7 the int types, 8 bool, 9 char, 10 ptr.
fn cls(i: usize) -> arith.CastTy {
    if i < 8 { return arith.CastTy.int(ty(i)); }
    return arith.CastTy.of_class(if i == 8 then arith.CT_BOOL else if i == 9 then arith.CT_CHAR else arith.CT_PTR);
}

fn cls_ty(i: usize) -> arith.IntTy {
    return cls(i).ty;
}

fn outcome(r: Result<u64, u8>) -> (u64, u64) {
    return match r {
        Result.Ok(v) => (0, v),
        Result.Err(e) => (e as u64, 0),
    };
}

// The outcome of op `code` < 28 on a and b (bits), `amount` the value of b.
fn eval(code: usize, t: arith.IntTy, a: u64, amount: arith.I128) -> (u64, u64) {
    if code < 23 { return outcome(arith.fold_binary(TERMS[code], t, a, amount)); }
    return outcome(arith.fold_unary(TERMS[code], t, a));
}

fn is_err(r: Result<u64, u8>, e: u8) -> bool {
    return match r {
        Result.Ok(_) => false,
        Result.Err(x) => x == e,
    };
}

fn upd(h: u64, w: u64) -> u64 {
    let x = (h ^ w) *% 0x100000001b3;
    return x ^ (x >> 29);
}

fn grid(n: u64) -> [u64; 16] {
    let m = if n >= 64 then 0xffff_ffff_ffff_ffff else (1u64 << n) - 1;
    let h = (m >> 1) +% 1;
    return [0, 1, 2, 3, 7, n - 1, n, n + 1, h -% 1, h, h +% 1, m -% 2, m -% 1, m, 0x5555_5555_5555_5555 & m, 0xaaaa_aaaa_aaaa_aaaa & m];
}

fn next(x: &mut u64) -> u64 {
    *x = *x ^ (*x << 13);
    *x = *x ^ (*x >> 7);
    *x = *x ^ (*x << 17);
    return *x;
}

fn seed(code: usize, ti: usize) -> u64 {
    return 0x9e37_79b9_7f4a_7c15 ^ (((code as u64) * 64 + (ti as u64) + 1) *% 0x100000001b3);
}

const OFFSET: u64 = 0xcbf2_9ce4_8422_2325;
const RANDOM: usize = 1000;
const RANDOM_CAST: usize = 64;

// The digest of op `code` < 28 on type `ti`, and the number of cases it covers.
fn digest(code: usize, ti: usize) -> (u64, u64) {
    let t = ty(ti);
    let n = BITS[ti] as u64;
    let binary = code < 23;
    let mut h = OFFSET;
    let mut cases: u64 = 0;
    let g = grid(n);
    let mut pairs = vec.Vec::<(u64, u64)>.new();
    if n <= 8 {
        for a in 0..(1u64 << n) {
            if binary {
                for b in 0..(1u64 << n) {
                    let (s, v) = eval(code, t, t.norm(a), t.value(t.norm(b)));
                    h = upd(upd(h, s), v);
                    cases = cases + 1;
                }
            } else {
                let (s, v) = eval(code, t, t.norm(a), t.value(0));
                h = upd(upd(h, s), v);
                cases = cases + 1;
            }
        }
    }
    for i in 0..16usize {
        for j in 0..(if binary then 16usize else 1usize) {
            let b = if binary then t.norm(g[j]) else 0;
            let (s, v) = eval(code, t, t.norm(g[i]), t.value(b));
            h = upd(upd(h, s), v);
            cases = cases + 1;
        }
    }
    let mut x = seed(code, ti);
    for k in 0..RANDOM {
        let a = t.norm(next(&mut x));
        let mut b: u64 = 0;
        if binary {
            let r = next(&mut x);
            b = t.norm(if k % 2 == 0 then r else r % (2 * n));
        }
        let (s, v) = eval(code, t, a, t.value(b));
        h = upd(upd(h, s), v);
        cases = cases + 1;
    }
    return (h, cases);
}

fn cast_digest(k: usize) -> (u64, u64) {
    let mut h = OFFSET;
    let mut cases: u64 = 0;
    for f in 0..NCLS {
        for to in 0..NCLS {
            let ft = cls_ty(f);
            let n = ft.bits as u64;
            let mut vals = vec.Vec::<u64>.new();
            if n <= 8 {
                for a in 0..(1u64 << n) { vals.push(ft.norm(a)); }
            }
            let g = grid(n);
            for i in 0..16usize { vals.push(ft.norm(g[i])); }
            if f == 9 {
                vals.push(0xd7ff);
                vals.push(0xd800);
                vals.push(0xdfff);
                vals.push(0xe000);
                vals.push(0x10ffff);
                vals.push(0x110000);
            }
            let mut x = seed(28 + k, f * NCLS + to);
            for _ in 0..RANDOM_CAST { vals.push(ft.norm(next(&mut x))); }
            for i in 0..vals.len() {
                let (s, v) = outcome(arith.int_cast(TERMS[28 + k], cls(f), cls(to), vals.as_slice()[i]));
                h = upd(upd(h, s), v);
                cases = cases + 1;
            }
        }
    }
    return (h, cases);
}


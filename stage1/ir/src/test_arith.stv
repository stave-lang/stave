test fn every_int_op_matches_the_reference() {
    let mut cases: u64 = 0;
    for code in 0..NOPS {
        for ti in 0..NTYPES {
            let (h, c) = digest(code, ti);
            cases = cases + c;
            if h != DIGEST[code * NTYPES + ti] {
                io.print(f"digest mismatch: op code {code}, type {ti}\n");
            }
            debug.assert(h == DIGEST[code * NTYPES + ti], "the outcomes of an op on a type");
        }
    }
    debug.assert(cases == INT_CASES, "the number of cases");
}

test fn every_int_cast_matches_the_reference() {
    let mut cases: u64 = 0;
    for k in 0..3usize {
        let (h, c) = cast_digest(k);
        cases = cases + c;
        if h != CAST_DIGEST[k] { io.print(f"cast digest mismatch: kind {k}\n"); }
        debug.assert(h == CAST_DIGEST[k], "the outcomes of a cast kind");
    }
    debug.assert(cases == CAST_CASES, "the number of cases");
}

test fn the_spot_cases_match_the_reference() {
    for i in 0..SPOTS.len() {
        let r = SPOTS[i];
        let code = r[0] as usize;
        let got = if code >= 28 then outcome(arith.int_cast(TERMS[code], cls(r[1] as usize), cls(r[2] as usize), r[3])) else eval(code, ty(r[1] as usize), r[3], arith.I128.{ hi: r[5], lo: r[4] });
        if got.0 != r[6] || got.1 != r[7] { io.print(f"spot row {i} differs\n"); }
        debug.assert(got.0 == r[6] && got.1 == r[7], "a spot row");
    }
}

test fn what_is_no_int_fold_is_refused() {
    let t = arith.IntTy.new(32, true);
    let one = t.value(1);
    let refused = [ops.IR_T_KW_CALL, ops.IR_T_MUL_DOT_WIDE, ops.IR_T_CAST_DOT_TRY, ops.IR_T_CAST_DOT_ROUND, ops.IR_T_KW_NEG, ops.IR_T_KW_POPCOUNT];
    for i in 0..4usize {
        debug.assert(is_err(arith.fold_binary(refused[i], t, 1, one), arith.E_OP), "an op of no fold is E_OP");
    }
    debug.assert(is_err(arith.fold_unary(refused[0], t, 1), arith.E_OP), "a unary op of no fold");
    let fl = arith.CastTy.of_class(arith.CT_FLOAT);
    let i32 = arith.CastTy.int(t);
    debug.assert(is_err(arith.int_cast(ops.IR_T_KW_CAST, fl, i32, 0), arith.E_OP), "a float source");
    debug.assert(is_err(arith.int_cast(ops.IR_T_KW_CAST, i32, fl, 0), arith.E_OP), "a float target");
    debug.assert(is_err(arith.int_cast(refused[2], i32, i32, 0), arith.E_OP), "cast.try does not fold");
    debug.assert(is_err(arith.int_cast(refused[3], i32, i32, 0), arith.E_OP), "cast.round does not fold");
}

// Columns: construction and the length rule shared by the other modules.
import std.debug;
import std.vec;

// A column of n copies of x, appended a block at a time (a call per element costs more than the
// copy).
pub fn filled<T: Copy>(n: usize, x: T) -> vec.Vec<T> {
    let mut v = vec.Vec::<T>.with_capacity(n);
    let blk = [x; 64];
    let mut k = n;
    while k >= 64 {
        v.extend_from_slice(&blk);
        k = k - 64;
    }
    v.extend_from_slice(&blk[0..k]);
    return v;
}

// The ids 0..n in order.
pub fn iota(n: usize) -> vec.Vec<u32> {
    let _ = ids(n);
    let mut v = filled(n, 0u32);
    let s = v.as_mut_slice();
    for i in 0..s.len() {
        s[i] = i as% u32;
    }
    return v;
}

// n as an id or offset: traps `Assert` unless n <= u32::MAX.
pub fn ids(n: usize) -> u32 {
    debug.assert(n <= 4294967295, "length does not fit a u32 id");
    return n as% u32;
}

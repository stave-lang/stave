// xxHash32 (Yann Collet's reference algorithm, little-endian reads): the same 32 bits as
// `XXH32(data, len, seed)` for every input. Names and literals are interned by this hash.

const P1: u32 = 0x9e37_79b1;
const P2: u32 = 0x85eb_ca77;
const P3: u32 = 0xc2b2_ae3d;
const P4: u32 = 0x27d4_eb2f;
const P5: u32 = 0x1656_67b1;

// Rotate left by r, 0 < r < 32.
fn rotl(x: u32, r: u32) -> u32 {
    return (x <<% r) | (x >> (32 - r));
}

fn read32(b: &[u8], i: usize) -> u32 {
    return (b[i] as u32) | ((b[i + 1] as u32) << 8) | ((b[i + 2] as u32) << 16) | ((b[i + 3] as u32) << 24);
}

fn round(acc: u32, w: u32) -> u32 {
    return rotl(acc +% (w *% P2), 13) *% P1;
}

// The hash of all bytes of `b` under `seed`. The length enters as its low 32 bits.
pub fn hash32(b: &[u8], seed: u32) -> u32 {
    let n = b.len();
    let mut i: usize = 0;
    let mut h: u32 = seed +% P5;
    if n >= 16 {
        let mut v1 = (seed +% P1) +% P2;
        let mut v2 = seed +% P2;
        let mut v3 = seed;
        let mut v4 = seed -% P1;
        while i + 16 <= n {
            v1 = round(v1, read32(b, i));
            v2 = round(v2, read32(b, i + 4));
            v3 = round(v3, read32(b, i + 8));
            v4 = round(v4, read32(b, i + 12));
            i = i + 16;
        }
        h = ((rotl(v1, 1) +% rotl(v2, 7)) +% rotl(v3, 12)) +% rotl(v4, 18);
    }
    h = h +% (n as% u32);
    while i + 4 <= n {
        h = rotl(h +% (read32(b, i) *% P3), 17) *% P4;
        i = i + 4;
    }
    while i < n {
        h = rotl(h +% ((b[i] as u32) *% P5), 11) *% P1;
        i = i + 1;
    }
    h = h ^ (h >> 15);
    h = h *% P2;
    h = h ^ (h >> 13);
    h = h *% P3;
    return h ^ (h >> 16);
}

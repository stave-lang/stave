// xxHash32 against the published vectors: the xxHash sanity buffer (its generator below) at
// lengths 1, 14, and 222 for seeds 0 and PRIME32, the empty input, and the strings of the
// reference's documentation; the other lengths are the reference algorithm's values.
import xxhash;
import std.debug;
import std.mem;
import std.vec;

const PRIME32: u32 = 0x9e37_79b1;
const PRIME64: u64 = 0x9e37_79b1_85eb_ca8d;

const LENS: [usize; 11] = [0, 1, 3, 4, 15, 16, 17, 32, 33, 222, 4099];
const SEED0: [u32; 11] = [0x02cc_5d05, 0xcf65_b03e, 0xc238_84f5, 0xa9de_7ce9, 0x6b85_9e14, 0x93ba_3759, 0x89fd_c23e, 0xd898_29ec, 0x31a4_27e5, 0x5bd1_1dbd, 0x64e5_81b2];
const SEEDP: [u32; 11] = [0x36b7_8ae7, 0xb454_5aa4, 0x1a26_9947, 0x2baa_fe83, 0xad53_090d, 0xa94f_c1e1, 0xc991_0739, 0xa5c4_4467, 0x0de5_b1f9, 0x5880_3c5f, 0x9d96_1e05];

fn sanity_buffer(n: usize) -> vec.Vec<u8> {
    let mut v = vec.Vec::<u8>.with_capacity(n);
    let mut g: u64 = PRIME32 as u64;
    for _ in 0..n {
        v.push((g >> 56) as% u8);
        g = g *% PRIME64;
    }
    return v;
}

test fn published_vectors() {
    let v = sanity_buffer(222);
    let b = v.as_slice();
    debug.assert(xxhash.hash32(&b[0..0], 0) == 0x02CC5D05, "empty, seed 0");
    debug.assert(xxhash.hash32(&b[0..0], PRIME32) == 0x36B78AE7, "empty, seed PRIME32");
    debug.assert(xxhash.hash32(&b[0..1], 0) == 0xCF65B03E, "1 byte");
    debug.assert(xxhash.hash32(&b[0..1], PRIME32) == 0xB4545AA4, "1 byte, PRIME32");
    debug.assert(xxhash.hash32(&b[0..14], 0) == 0x1208E7E2, "14 bytes");
    debug.assert(xxhash.hash32(&b[0..14], PRIME32) == 0x6AF1D1FE, "14 bytes, PRIME32");
    debug.assert(xxhash.hash32(&b[0..222], 0) == 0x5BD11DBD, "222 bytes");
    debug.assert(xxhash.hash32(&b[0..222], PRIME32) == 0x58803C5F, "222 bytes, PRIME32");
}

test fn published_strings() {
    debug.assert(xxhash.hash32(mem.str_bytes("a"), 0) == 0x550D7456, "a");
    debug.assert(xxhash.hash32(mem.str_bytes("abc"), 0) == 0x32D153FF, "abc");
    let s = mem.str_bytes("Nobody inspects the spammish repetition");
    debug.assert(xxhash.hash32(s, 0) == 0xE2293B2F, "spammish");
}

test fn lengths_around_the_stripe() {
    let v = sanity_buffer(4099);
    let b = v.as_slice();
    for k in 0..LENS.len() {
        let n = LENS[k];
        debug.assert(xxhash.hash32(&b[0..n], 0) == SEED0[k], f"seed 0, length {n}");
        debug.assert(xxhash.hash32(&b[0..n], PRIME32) == SEEDP[k], f"seed PRIME32, length {n}");
    }
}

// The hash reads only the bytes it is given: an unaligned window equals a copy of it.
test fn unaligned_window() {
    let v = sanity_buffer(100);
    let b = v.as_slice();
    for off in 0..8usize {
        let w = &b[off..off + 40];
        let mut c = vec.Vec::<u8>.new();
        c.extend_from_slice(w);
        debug.assert(xxhash.hash32(w, 7) == xxhash.hash32(c.as_slice(), 7), "window equals copy");
    }
}

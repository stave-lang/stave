// Bit rows against a bool-per-bit model. Widths straddle the word (64) and the 128-bit chunk, so
// rows of 1, 2, 3, and 5 words run the vector loop and the scalar tail in every combination.
import bits;
import test_util;
import std.debug;
import std.vec;

const NO_BIT: usize = 4294967295;
const WIDTHS: [usize; 10] = [1, 63, 64, 65, 127, 128, 129, 191, 320, 321];

// The next member at or after `at`, NO_BIT if none.
fn nx(s: &bits.BitRows, r: usize, at: usize) -> usize {
    return match s.next_set(r, at) {
        Option.Some(b) => b,
        Option.None => NO_BIT,
    };
}

// rows x width of random membership, in the structure and in a model.
struct Pair {
    rows: bits.BitRows,
    model: vec.Vec<bool>,
}

fn random_pair(r: &mut test_util.Rng, rows: usize, width: usize, per_mille: u64) -> Pair {
    let mut s = bits.BitRows.new(rows, width);
    let mut m = vec.Vec::<bool>.new();
    for row in 0..rows {
        for b in 0..width {
            let on = r.below(1000) < per_mille;
            m.push(on);
            if on { s.set(row, b); }
        }
    }
    return Pair.{ rows: s, model: m };
}

fn agrees(p: &Pair, width: usize, what: &str) {
    let rows = p.rows.rows();
    for row in 0..rows {
        let mut n: usize = 0;
        let mut first: usize = width;
        for b in 0..width {
            let on = p.model.as_slice()[row * width + b];
            debug.assert(p.rows.has(row, b) == on, what);
            if on {
                n = n + 1;
                if first == width { first = b; }
            }
        }
        debug.assert(p.rows.count(row) == n, what);
        debug.assert(p.rows.any(row) == (n != 0), what);
        let m = p.rows.members(row);
        debug.assert(m.len() == n, what);
        let mut k: usize = 0;
        for b in 0..width {
            if p.model.as_slice()[row * width + b] {
                debug.assert(m.as_slice()[k] as usize == b, what);
                k = k + 1;
            }
        }
        // iterating through next_set visits the same members
        let mut at: usize = 0;
        let mut seen: usize = 0;
        loop {
            match p.rows.next_set(row, at) {
                Option.Some(b) => {
                    debug.assert((b as% u32) == m.as_slice()[seen], what);
                    seen = seen + 1;
                    at = b + 1;
                }
                Option.None => { break; }
            }
        }
        debug.assert(seen == n, what);
    }
}

// dst row <- dst op src on the model; whether it changed.
fn model_op(p: &mut Pair, width: usize, dst: usize, src: usize, op: u32) -> bool {
    let mut changed = false;
    for b in 0..width {
        let a = p.model.as_slice()[dst * width + b];
        let s = p.model.as_slice()[src * width + b];
        let r = if op == 0 then (a || s) else if op == 1 then (a && s) else (a && !s);
        if r != a { changed = true; }
        p.model.as_mut_slice()[dst * width + b] = r;
    }
    return changed;
}

test fn set_clear_has() {
    for k in 0..WIDTHS.len() {
        let w = WIDTHS[k];
        let mut s = bits.BitRows.new(3, w);
        debug.assert(s.rows() == 3 && s.bits() == w, "dimensions");
        debug.assert(!s.any(0) && !s.any(2) && s.count(1) == 0, "new rows are empty");
        s.set(1, 0);
        s.set(1, w - 1);
        s.set(1, w - 1);
        debug.assert(s.has(1, 0) && s.has(1, w - 1), "set");
        debug.assert(!s.any(0) && !s.any(2), "other rows untouched");
        debug.assert(s.count(1) == (if w == 1 then 1 else 2), "set twice counts once");
        s.clear(1, 0);
        debug.assert(!s.has(1, 0), "clear");
        debug.assert(s.has(1, w - 1) == (w != 1), "clear leaves the other bit (the same bit at width 1)");
        s.clear(1, 0);
        s.clear(1, w - 1);
        debug.assert(!s.any(1), "cleared");
    }
}

test fn fill_and_clear_row() {
    for k in 0..WIDTHS.len() {
        let w = WIDTHS[k];
        let mut s = bits.BitRows.new(2, w);
        s.fill_row(0);
        debug.assert(s.count(0) == w && !s.any(1), "fill_row is the whole universe, no more");
        debug.assert(s.has(0, 0) && s.has(0, w - 1), "ends");
        s.copy_row(1, 0);
        debug.assert(s.same_rows(0, 1) && s.count(1) == w, "copy_row");
        s.clear_row(0);
        debug.assert(!s.any(0) && s.count(1) == w && !s.same_rows(0, 1), "clear_row");
    }
}

test fn zero_width_and_zero_rows() {
    let mut s = bits.BitRows.new(2, 0);
    debug.assert(!s.any(0) && s.count(1) == 0, "no bits");
    debug.assert(!s.or_row(0, 1) && !s.and_row(0, 1) && !s.andnot_row(0, 1), "nothing changes");
    s.fill_row(0);
    debug.assert(nx(&s, 0, 0) == NO_BIT, "nothing to find");
    let t = bits.BitRows.new(0, 100);
    debug.assert(t.rows() == 0, "no rows");
}

test fn row_operations_match_the_model() {
    let mut r = test_util.Rng.new(321);
    for k in 0..WIDTHS.len() {
        let w = WIDTHS[k];
        for round in 0..8usize {
            let mut p = random_pair(&mut r, 4, w, 100 + 120 * (round as u64));
            agrees(&p, w, "built");
            for _ in 0..12usize {
                let dst = r.below(4) as usize;
                let src = r.below(4) as usize;
                let op = r.below(3) as% u32;
                let want = model_op(&mut p, w, dst, src, op);
                let got = if op == 0 then p.rows.or_row(dst, src) else if op == 1 then p.rows.and_row(dst, src) else p.rows.andnot_row(dst, src);
                debug.assert(got == want, "changed flag");
                agrees(&p, w, "after an operation");
            }
        }
    }
}

test fn row_with_itself() {
    let mut s = bits.BitRows.new(1, 130);
    s.set(0, 3);
    s.set(0, 129);
    debug.assert(!s.or_row(0, 0) && !s.and_row(0, 0), "x | x and x & x are x");
    debug.assert(s.andnot_row(0, 0) && !s.any(0), "x & ~x is empty");
    debug.assert(!s.andnot_row(0, 0), "and stays empty");
}

test fn next_set_boundaries() {
    let mut s = bits.BitRows.new(1, 200);
    s.set(0, 0);
    s.set(0, 63);
    s.set(0, 64);
    s.set(0, 199);
    debug.assert(nx(&s, 0, 0) == 0, "from 0");
    debug.assert(nx(&s, 0, 1) == 63, "to the word end");
    debug.assert(nx(&s, 0, 64) == 64, "word start");
    debug.assert(nx(&s, 0, 65) == 199, "across words");
    debug.assert(nx(&s, 0, 199) == 199, "last bit");
    debug.assert(nx(&s, 0, 200) == NO_BIT, "past the universe");
}

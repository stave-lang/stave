// Test stand-in for std/core.stv: the prelude names conformance tests use.
pub enum Option<T> { None, Some(T) }

pub enum Result<T, E> { Ok(T), Err(E) }

pub trait Copy {}

pub unsafe("implementers guarantee values may move between threads") trait Send {}

pub unsafe("implementers guarantee shared references may cross threads") trait Sync {}

pub trait Display {
    fn fmt(&self) -> u32;
}

pub trait Drop {
    fn drop(&mut self);
}

pub trait Add { fn add(self, rhs: Self) -> Self; }

// Display for the built-in scalars (the real std has them in std.fmt).
impl Display for u8 { fn fmt(&self) -> u32 { return 0; } }
impl Display for u16 { fn fmt(&self) -> u32 { return 0; } }
impl Display for u32 { fn fmt(&self) -> u32 { return 0; } }
impl Display for u64 { fn fmt(&self) -> u32 { return 0; } }
impl Display for usize { fn fmt(&self) -> u32 { return 0; } }
impl Display for i8 { fn fmt(&self) -> u32 { return 0; } }
impl Display for i16 { fn fmt(&self) -> u32 { return 0; } }
impl Display for i32 { fn fmt(&self) -> u32 { return 0; } }
impl Display for i64 { fn fmt(&self) -> u32 { return 0; } }
impl Display for isize { fn fmt(&self) -> u32 { return 0; } }
impl Display for f32 { fn fmt(&self) -> u32 { return 0; } }
impl Display for f64 { fn fmt(&self) -> u32 { return 0; } }
impl Display for bool { fn fmt(&self) -> u32 { return 0; } }
impl Display for char { fn fmt(&self) -> u32 { return 0; } }
impl Display for str { fn fmt(&self) -> u32 { return 0; } }

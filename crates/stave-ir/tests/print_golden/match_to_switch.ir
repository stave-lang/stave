stave.ir 4 "x86_64-linux-v2" debug checked
decl d5 enum app.Shape
type t0 int u 32
type t1 float 64
type t2 adt d5
shape t2 enum | t1 | t1 t1
fn @4 app.area(t2) -> t1 {
b0(%0: t2):
  %1 = enum.tag t0 %0
  switch %1 0:b1() _:b3()
b1():
  %2 = enum.get t1 %0 0 0
  br b2()
b2():
  %3 = mul t1 %2 %2
  br b5(%3)
b3():
  %4 = enum.get t1 %0 1 0
  %5 = enum.get t1 %0 1 1
  br b4()
b4():
  %6 = mul t1 %4 %5
  br b5(%6)
b5(%7: t1):
  ret %7
}

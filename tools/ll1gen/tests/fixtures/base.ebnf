(* Fixture for tools/ll1gen/tests/conflicts.rs: a small grammar with exactly the three listed
   conflicts (Stmt,"unsafe"), (TypeBase,"<"), (TypeBase,"needs") and the rules that
   contracts/parse-errors.md names. *)

(* ---------- items ---------- *)
File        = Stmt* EOF ;
Stmt        = Unsafe Block | Block | ExprStmt ;
Unsafe      = "unsafe" "(" StrLit ")" ;
Block       = "{" Stmt* "}" ;
ExprStmt    = AndExpr ";" ;
AndExpr     = CmpExpr ("&&" CmpExpr)* ;
CmpExpr     = Cast (CmpOp Cast)? ;
CmpOp       = "<" | ">" ;
Cast        = Unary ("as" Type)* ;
Unary       = Unsafe Unary | Ident | IntLit ;
Type        = TypeBase ;
TypeBase    = Ident GenericArgs? | "fn" "(" ")" ("->" Type)? Needs? ;
GenericArgs = "<" Type ("," Type)* ">" ;
Needs       = "needs" "(" Ident ")" ;

(* The origin rules that rules 5-13 of contracts/parse-errors.md name (not reachable from File). *)
FnDecl       = "fn" Ident "(" Params ")" RetClause Block ;
TraitFn      = "fn" Ident "(" Params ")" ";" ;
KernelDecl   = "kernel" "fn" Ident "(" Params ")" Block ;
DispatchDecl = "dispatch" "fn" Ident "(" Params ")" ";" ;
ExternItem   = "extern" "{" ExternFn "}" ;
ExternFn     = "fn" Ident "(" XParams ")" ";" ;
XParams      = "..." | Param ;
Params       = Param ("," Param)* ;
Param        = Primary ":" Type ;
Primary      = Ident ;
RetClause    = "->" Type ;
AdtDecl      = "struct" Ident "{" "}" ;

(* Stave surface grammar, v0.7, contract for the stage0 parser and the stage1 GPU parser.
   Struct literals and patterns use `.{`, so a `{` after a name always starts a block.

   Notation: X? optional, X* zero or more, X+ one or more, "t" terminal, A | B alternatives.

   LL(1) claim: every alternative is chosen by the next token, never by backtracking or a
   symbol-table lookup. The generated table has exactly four conflicts, each resolved by a fixed
   greedy choice (the first listed alternative): D2, D5 (`needs` and `without`), and
   statement-start `unsafe`. D3 and unary `&&` are not table conflicts but PDA split actions
   (below). D4 is a name-resolution rule, not a parser rule. Each rule has a conformance test
   (tests/conformance/syntax/ll1_D*.stv):

   D2 (cast type): after `as`/`as%`/`as|`/`as?`/`as~`, a `<` following the type name is always
      TypeArgs. `x as usize < y` is a parse error (E0011). Write `(x as usize) < y`.
   D3 (closing angle): inside TypeArgs/GenericArgs, the lexer token `>>` (or `>>=`, `>=`) is split
      and its first `>` closes the list (a parser action: expected ">" consumes one ">" of the token).
   D4 (dotted chains): `a.b.c` is parsed as Primary(Ident) plus postfix `.Ident` steps. Name
      resolution, not the parser, decides whether a step is a module, type, variant, or field.
   D5 (fn-type needs, without): `needs(..)` and `without(..)` directly after a fn type bind to that
      (innermost) fn type: `fn f() -> fn() needs(avx2) { }` gives the RETURNED fn type the
      feature, `fn f() -> fn() without(alloc) { }` the deny clause. For f itself write
      `fn f() -> (fn()) needs(avx2) { }`.
   Statement `unsafe`: at statement start `unsafe` always opens `Unsafe Block` (see ExprStmt).

   Split actions (generated by `tools/ll1gen` as SPLIT_FIRST / SPLIT_REST into both tables): a
   split token is read as its first terminal followed by the rest. A nonterminal whose row has no
   action on the split token uses the action of the first terminal, and an expected first terminal
   consumes that part of the token, leaving the rest as the lookahead:
     `>>` = `>` `>`,  `>=` = `>` `=`,  `>>=` = `>` `>=`   (D3; only where the row lacks the token,
                                                            i.e. closing TypeArgs/GenericArgs)
     `&&` = `&` `&`                                      (unary: `&&x` = `& &x`, `&&T` = `& &T`;
                                                            `a && b` keeps the operator)

   Pass-through rules (generated by `tools/ll1gen` as NT_PASS into both tables): the expression
   levels Expr, RangeExpr, OrExpr, AndExpr, CmpExpr, BitOr, BitXor, BitAnd, Shift, Add, Mul, Cast,
   Unary and Postfix. Such a node that holds exactly one child node and matched no terminal itself
   is left out of the AST: its child takes its place. So `x` is one Primary node, `-x` a Unary
   over a Primary, `a + b * c` an Add over a Primary and a Mul. Parsing, error reporting and the
   accepted language are unaffected; only the emitted nodes change.

   Tokens the lexer MUST produce as single tokens:
   `as%` `as|` `as?` `as~` (no space) and `...` (variadic extern). *)

(* ---------- lexical ---------- *)
Ident        = [A-Za-z_] [A-Za-z0-9_]* ;              (* ASCII only; not a keyword; "_" alone is the wildcard token.
                                                         Any other byte outside literals and comments (`@ $ \ #`,
                                                         backtick, control bytes, DEL, every byte >= 0x80) starts
                                                         no token: E0018, one per run of such bytes *)
IntLit       = (Dec | "0x" Hex+ | "0b" Bin+ | "0o" Oct+) IntSuffix? ;   (* '_' separators; suffix: 5u8 *)
FloatLit     = Dec "." Dec Exp? FSuffix? | Dec Exp FSuffix? ;
               (* a digit must follow ".", so `0..n` is Int ".." Ident. After a "." token the lexer
                  produces IntLit only, so `t.0.1` is two tuple-field steps *)
StrLit       = '"' StrChar* '"' ;                     (* StrChar excludes a raw newline: write \n (E0015). Every newline
                                                         is a resynchronisation point for the parallel lexer *)
FmtLit       = 'f"' (StrChar | "{" (Ident | "self") ("." Ident)* "}")* '"' ;
               (* names/fields only, no exprs. The head may be `self`: f"{self.x}". Tuple
                  steps (`.0`) are excluded: bind to a local first *)
CharLit      = "'" Char "'" ;
LineComment  = "//" ~"\n"* ;                           (* no block comments: no nesting state. `/*` is an error
                                                         token through the first `*/` on its line, else the
                                                         end of the line (E0029) *)
Shebang      = "#!" ~"\n"* ;                           (* a comment, only at byte offset 0 of a file (`#!/usr/bin/env -S
                                                         stave run`). `#!` anywhere else, also after a byte-order
                                                         mark, is E0018 *)
               (* `'` Ident with no `'` directly after it (a Rust lifetime) is an error token (E0024) *)
               (* a UTF-8 byte-order mark at file start is E0017 *)
Keywords     = "fn" "let" "mut" "const" "struct" "enum" "trait" "impl" "for" "in" "while" "loop"
               "if" "then" "else" "match" "return" "break" "continue" "pub" "import" "as" "from"
               "needs" "dispatch" "unsafe" "extern" "self" "Self" "true" "false" "tail" "masked"
               "scalar" "exact" "align" "copy" "type" "view" "scope" "spawn" "strict" "emulate"
               "test" "allocator" "kernel" "static" "requires" "ensures" "rec" "without"
               "invariant" "decreases" "ghost" "pure" "spec" "forall" "exists" ;
               (* invariant .. exists: reserved only, see rule Reserved *)

(* Operator tokens (maximal munch, then D3 splitting):
   +  -  *  /  %       trapping on scalar ints, IEEE on floats, E0604 on int vectors
   +% -% *% <<%        wrapping           +| -| *|      saturating
   << >>               trap if the shift amount >= bit width; <<% masks the amount
   as as% as| as? as~  lossless / wrapping / saturating / checked->Option / round-nearest
   .. ..=              ranges    .{  struct literal/pattern opener (one token, no space)    && || !  & | ^ ~  == != < <= > >=  ? -> => = op=  *)

(* ---------- items ---------- *)
File         = Import* Item* EOF ;                     (* imports precede items: a later `import` is E0004 *)
Import       = "import" Ident ("." Ident)* ("as" Ident)? ";" ;
Item         = "pub"? ItemBody | "test" FnDecl ;      (* FIRST sets: pub/unsafe/fn/... vs "test" *)      (* test fns: run by `stave test` *)
ItemBody     = Unsafe? (FnDecl | TraitDecl | ImplDecl)      (* left-factored: one `unsafe` prefix *)
             | AdtDecl | ConstDecl | StaticDecl | DispatchDecl | ExternItem | TypeAlias
             | AllocatorDecl | KernelDecl ;
KernelDecl   = "kernel" "fn" Ident "(" Params? ")" Block ;   (* GPU kernel, rules in contracts/gpu-lang.md *)
Unsafe       = "unsafe" "(" StrLit ")" ;              (* the stated obligation, mandatory:
                                                         unsafe fn = caller obligation; unsafe trait/impl = implementer obligation *)

FnDecl       = "rec"? "fn" Ident Generics? "(" Params? ")" RetClause? Needs? Without? Requires* Ensures* Block ;
               (* `rec`: the fn may be part of a call cycle; trait signatures, closures, dispatch,
                  kernel and extern fns take none *)
Requires     = "requires" "(" Expr ")" ;               (* checked at entry, panic Contract at the caller *)
Ensures      = "ensures" "(" Expr ")" ;                (* checked at each return; inside it the identifier `result` names the returned value
                                                         and a call `old(e)` the value of `e` at entry (both contextual, not keywords) *)
Params       = Param ("," Param)* ","? ;
Param        = (SelfParam | Ident ":" Type) ParamFrom? ;
ParamFrom    = From ;                                 (* only on a `&mut V` param of a fn item or method (E0514): what the
                                                         callee may store into *p; not naming the param itself (E0515) *)
SelfParam    = "self" | "&" "mut"? "self" ;
RetClause    = "->" Type From? ;
From         = "from" Origin ("+" Origin)* ;          (* `+` joins origins. Missing = empty set *)
Origin       = "copy"? (Ident | "self") ;             (* meaning: the origin table of LANG.md §3 *)
Needs        = "needs" "(" Feature ("," Feature)* ")" ;
Feature      = Ident ;                                (* closed set per arch: contracts/simd-ops.md §Features *)
Without      = "without" "(" Effect ("," Effect)* ")" ;   (* deny clause: effects the fn and all it calls must not have *)
Effect       = Ident | "unsafe" ;                     (* closed set: alloc trap recursive lock unsafe io block; the
                                                         parser takes any Ident, name checking is semantic (E1404) *)
Generics     = "<" GenericParam ("," GenericParam)* ">" ;   (* bounds only inline: no `where` *)
GenericParam = Ident (":" Bound)? | "const" Ident ":" Type ;
Bound        = BoundItem ("+" BoundItem)* ;
BoundItem    = Ident ("." Ident)* GenericArgs? | "view" ;    (* `T: view` admits views *)

AdtDecl      = "view"? ( "struct" Ident Generics? "{" Fields? "}"
                       | "enum" Ident Generics? "{" Variant ("," Variant)* ","? "}" ) ;
Fields       = Field ("," Field)* ","? ;
Field        = "pub"? Ident ":" Type ;               (* ref/view-typed fields only in view ADTs (E0410) *)
Variant      = Ident ( "(" Type ("," Type)* ","? ")" | "{" Fields "}" )? ;
TraitDecl    = "trait" Ident Generics? "{" TraitFn* "}" ;
TraitFn      = Unsafe? "fn" Ident Generics? "(" Params? ")" RetClause? Needs? ";" ;
ImplDecl     = "impl" Generics? Type ("for" Type)? "{" ("pub"? Unsafe? FnDecl)* "}" ;   (* unsafe methods allowed *)
ConstDecl    = "const" Ident ":" Type "=" Expr ";" ;  (* const-expr subset only *)
StaticDecl   = "static" "mut"? Ident ":" Type "=" Expr ";" ;   (* global, const-expr initializer.
                                                         `static`: immutable, T must be Sync (E0417), safe.
                                                         `static mut`: std/runtime packages only (E0809),
                                                         every read, write, or borrow is unsafe (E0803) *)
TypeAlias    = "type" Ident Generics? "=" Type ";" ;
AllocatorDecl = "allocator" Ident ("." Ident)* ";" ;  (* replaces the global allocator; at most one per binary *)

(* C ABI. After `extern "C"`: "{" means imports and "fn" means a C-ABI export
   definition. Calls to imports are unsafe. Vectors are not allowed in C signatures. *)
ExternItem   = "extern" StrLit ( "{" ExternFn* "}" | "fn" Ident "(" Params? ")" ("->" Type)? Block ) ;
ExternFn     = "fn" Ident "(" XParams? ")" ("->" Type)? ";" ;
XParams      = "..." | Param ("," XParams?)? ;   (* "..." only last; LL(1) form of Params ("," "...")? *)

(* Runtime CPU dispatch. Arms are tried top to bottom. `_` is required and last.
   Each arm target has the dispatch's signature with needs = the dispatch's needs plus the arm's
   features. On a target whose arch does not own an arm's features, that arm is dropped. *)
DispatchDecl = "dispatch" "fn" Ident "(" Params? ")" RetClause? Needs? "{" DispArm* "_" "=>" Name ","? "}" ;
DispArm      = Feature ("+" Feature)* "=>" Name "," ;
Name         = Ident ("." Ident)* ;

(* ---------- types ---------- *)
Type         = "[" Type ( ";" Expr | "align" IntLit )? "]"   (* [T; N] / [T] / [T align A]; N is a const-expr *)
             | TypeBase ;
TypeBase     = "&" "mut"? Type                         (* placement rules: LANG.md §3 *)
             | "*" ("const" | "mut") Type              (* raw pointer; deref is unsafe *)
             | "(" ( Type ( "," (Type ("," Type)* ","?)? )? )? ")"   (* () unit, (T) = T, (T,) 1-tuple *)
             | "fn" "(" (Type ("," Type)*)? ")" ("->" Type)? Needs? Without?   (* fn value; features and deny clause are part of the type (D5). No `from`: a call borrows from all ref/view args *)
             | Ident ("." Ident)* GenericArgs?         (* f32x8, mask32x8, f32xn, vec<T, N> (generic only) *)
             | "Self" ;
GenericArgs  = "<" GenericArg ("," GenericArg)* ">" ;   (* D3 *)
GenericArg   = TypeBase | IntLit | "{" Expr "}" | "[" ArrOrIdx "]" ;
ArrOrIdx     = (IntLit ("," IntLit)*)? | Type ( ";" Expr | "align" IntLit )? ;   (* left-factored "[": index list vs array type *)
               (* const args: literal, braced const-expr, or an index list (permute) *)

(* ---------- statements ---------- *)
Block        = "{" Stmt* "}" ;
Stmt         = "let" Pattern (":" Type)? "=" Expr ";"          (* `let mut x` is Pattern "mut" Ident *)
             | IfStmt
             | "while" Expr Block
             | "loop" Block
             | ForStmt
             | "match" Expr "{" StmtArm* "}"
             | "return" Expr? ";"
             | "break" ";" | "continue" ";"
             | Unsafe Block                            (* obligation text is mandatory *)
             | "strict" Block                          (* rejects lowering classes M and U inside (E0701) *)
             | "emulate" Block                         (* the only opt-in allowing class-U ops *)
             | "scope" Block                           (* structured threads; spawns join at "}" *)
             | "spawn" Block                           (* only directly inside a scope block (E0801) *)
             | Block
             | ExprStmt ;
ExprStmt     = OrExpr (AssignOp Expr)? ";" ;
               (* An ExprStmt never begins with "if", "match" (excluded by starting at OrExpr) or
                  "unsafe": at statement start, "unsafe" always selects the Unsafe Block form, and
                  unary `unsafe(..) e` is for value positions only. That keeps Stmt LL(1). *)
IfStmt       = "if" Expr Block ("else" (IfStmt | Block))? ;
StmtArm      = ArmPattern ("if" Expr)? "=>" Block ;
ArmPattern   = Pattern ("|" Pattern)* ;               (* or-patterns, match arms only (not let/for): every alternative
                                                         binds the same names with the same types and modes (E0302) *)
AssignOp     = "=" | "+=" | "-=" | "*=" | "/=" | "%=" | "+%=" | "-%=" | "*%=" | "+|=" | "-|=" | "*|="
             | "&=" | "|=" | "^=" | "<<=" | ">>=" | "<<%=" ;

(* Element loop and SIMD chunk loop. A chunk loop (the binding type is a vector) needs a
   TailClause, unless the iterable is an array whose length is a multiple of the lane count.
     tail masked (v, m) { }  remaining lanes under mask m. Inactive lanes read as zero. A `&mut`
                             chunk binding writes back only active lanes.
     tail scalar (x) { }     remaining elements one by one
     tail exact;             runtime check len % lanes == 0, trapping otherwise; elided when proved *)
ForStmt      = "for" Pattern (":" Type)? "in" Expr Block TailClause? ;
TailClause   = "tail" ( "masked" "(" TailBind "," TailBind ")" Block
                      | "scalar" "(" TailBind ")" Block
                      | "exact" ";" ) ;
TailBind     = Ident ;                                (* one node per bound name (names dump) *)

(* ---------- expressions (precedence climbing, lowest first) ---------- *)
Expr         = IfExpr | MatchExpr | RangeExpr ;
IfExpr       = "if" Expr "then" Expr "else" Expr ;   (* the value-producing form *)
MatchExpr    = "match" Expr "{" ExprArm ("," ExprArm)* ","? "}" ;
ExprArm      = ArmPattern ("if" Expr)? "=>" Expr ;
RangeExpr    = OrExpr ((".." | "..=") OrExpr)? ;      (* non-associative; both ends required *)
OrExpr       = AndExpr ("||" AndExpr)* ;
AndExpr      = CmpExpr ("&&" CmpExpr)* ;
CmpExpr      = BitOr (CmpOp BitOr)? ;                  (* non-associative: a < b < c is E0012 *)
CmpOp        = "==" | "!=" | "<" | "<=" | ">" | ">=" ;
BitOr        = BitXor ("|" BitXor)* ;
BitXor       = BitAnd ("^" BitAnd)* ;
BitAnd       = Shift ("&" Shift)* ;
Shift        = Add (("<<" | ">>" | "<<%") Add)* ;
Add          = Mul (("+" | "-" | "+%" | "-%" | "+|" | "-|") Mul)* ;
Mul          = Cast (("*" | "/" | "%" | "*%" | "*|") Cast)* ;
Cast         = Unary (("as" | "as%" | "as|" | "as?" | "as~") Type)* ;   (* D2 *)
Unary        = ("-" | "!" | "~" | "*") Unary
             | "&" "mut"? Unary                        (* the token `&&` in unary position = two `&` (split action) *)
             | Unsafe Unary                            (* a single unsafe operation as a value, e.g. *raw *)
             | Postfix ;
Postfix      = Primary ( "." (Ident ("::" GenericArgs)? | IntLit) | StructLit | "(" Args? ")" | "[" Expr "]" | "?" )* ;
               (* StructLit is valid only after a type path: a chain of Ident / "." Ident steps whose last
                  step may carry "::" GenericArgs (`Cell::<u32>.{ v: 1u32 }`), or `Self` inside an impl
                  (`Self.{ v: v }`). Checked by name resolution (D4), not by the parser *)
Args         = Expr ("," Expr)* ","? ;
Primary      = IntLit | FloatLit | StrLit | FmtLit | CharLit | "true" | "false" | "self" | "Self"
             | Ident ("::" GenericArgs)?
             | "(" (Expr ("," (Expr ("," Expr)* ","?)?)?)? ")"     (* (e) grouping, (e,) 1-tuple *)
             | "[" (Expr (";" Expr | ("," (Expr ("," Expr)* ","?)?)?))? "]"
             | "fn" "(" Params? ")" ("->" Type)? Block ;           (* non-escaping closure *)
StructLit    = ".{" (Ident ":" Expr ("," Ident ":" Expr)* ","?)? "}" ;

(* ---------- patterns ---------- *)
Pattern      = "_"
             | Literal (( ".." | "..=" ) Literal)?
             | "mut" Ident
             | Ident ("." Ident)* ( "(" Pattern ("," Pattern)* ","? ")" | ".{" FieldPat ("," FieldPat)* ","? "}" )?
               (* a single bare Ident with no suffix is always a binding. Variants are always
                  qualified: Shape.Circle(r) *)
             | "(" (Pattern ("," (Pattern ("," Pattern)* ","?)?)?)? ")" ;
FieldPat     = Ident (":" Pattern)? ;
Literal      = "-"? (IntLit | FloatLit) | StrLit | CharLit | "true" | "false" ;

(* ---------- reserved ---------- *)
(* Keywords without a meaning: no rule reaches Reserved, so each is a syntax error wherever it
   appears (a keyword is never an Ident). The rule only makes them terminals. *)
Reserved     = "invariant" | "decreases" | "ghost" | "pure" | "spec" | "forall" | "exists" ;

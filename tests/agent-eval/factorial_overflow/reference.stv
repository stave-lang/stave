import std.io;

fn main() -> i32 {
    let mut f: u64 = 1;
    let mut n: u64 = 1;
    let mut last_u32_n: u64 = 0;
    let mut last_u32: u32 = 0;
    loop {
        let (hi, lo) = f.mul_wide(n);
        if hi != 0 {
            break;
        }
        f = lo;
        match f as? u32 {
            Option.Some(v) => {
                last_u32 = v;
                last_u32_n = n;
            }
            Option.None => {}
        }
        n = n + 1;
    }
    let top = n - 1;
    io.print(f"{top}! = {f}\n");
    io.print(f"{n}! overflows u64\n");
    io.print(f"largest u32 factorial: {last_u32_n}! = {last_u32}\n");
    return 0;
}

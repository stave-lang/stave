import std.io;

enum Op { Add, Sub, Mul, Div, Rem }

impl Copy for Op {}

fn apply(op: Op, a: i64, b: i64) -> i64 {
    return match op {
        Op.Add => a + b,
        Op.Sub => a - b,
        Op.Mul => a * b,
        Op.Div => a / b,
        Op.Rem => a % b,
    };
}

fn name(op: Op) -> &str {
    return match op {
        Op.Add => "add",
        Op.Sub => "sub",
        Op.Mul => "mul",
        Op.Div => "div",
        Op.Rem => "rem",
    };
}

fn main() -> i32 {
    let ops: [Op; 5] = [Op.Add, Op.Sub, Op.Mul, Op.Div, Op.Rem];
    let a: i64 = 20;
    let b: i64 = 6;
    for i in 0..ops.len() {
        let n = name(ops[i]);
        let r = apply(ops[i], a, b);
        io.print(f"{n} {r}\n");
    }
    return 0;
}

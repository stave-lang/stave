import std.io;

enum Shape { Circle { r: u32 }, Rect { w: u32, h: u32 }, Tri { a: u32, b: u32, c: u32 }, Dot }

fn describe(s: &Shape) {
    match *s {
        Shape.Circle.{ r } if r == 0 => { io.print("degenerate circle\n"); }
        Shape.Circle.{ r } => { io.print(f"circle r={r}\n"); }
        Shape.Rect.{ w, h } if w == h => { io.print(f"square {w}\n"); }
        Shape.Rect.{ w, h } => { io.print(f"rect {w}x{h}\n"); }
        Shape.Tri.{ a, b, c } if a == b && b == c => { io.print(f"equilateral {a}\n"); }
        Shape.Tri.{ a, b, c } if a == b || b == c || a == c => { io.print("isosceles\n"); }
        Shape.Tri.{ a: _, b: _, c: _ } => { io.print("scalene\n"); }
        Shape.Dot => { io.print("dot\n"); }
    }
}

fn main() -> i32 {
    let shapes: [Shape; 8] = [
        Shape.Circle.{ r: 5 },
        Shape.Circle.{ r: 0 },
        Shape.Rect.{ w: 4, h: 4 },
        Shape.Rect.{ w: 3, h: 8 },
        Shape.Tri.{ a: 6, b: 6, c: 6 },
        Shape.Tri.{ a: 5, b: 5, c: 8 },
        Shape.Tri.{ a: 3, b: 4, c: 5 },
        Shape.Dot,
    ];
    for s in &shapes {
        describe(s);
    }
    return 0;
}

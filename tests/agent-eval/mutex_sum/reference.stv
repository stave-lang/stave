import std.io;
import std.sync;
import std.thread;

static TOTAL: sync.Mutex<u64, 1> = sync.Mutex::<u64, 1>.new(0);

fn main() -> i32 {
    thread.par_for(0, 1000, fn(i: usize) {
        TOTAL.with_lock(fn(t: &mut u64) { *t = *t + (i as u64); });
    });
    let total = TOTAL.with_lock(fn(t: &mut u64) -> u64 { return *t; });
    io.print(f"par_for total {total}\n");
    let m = sync.Mutex::<u64, 1>.new(0);
    scope {
        spawn {
            for k in 1u64..=10 {
                m.with_lock(fn(t: &mut u64) { *t = *t + k; });
            }
        }
        spawn {
            for k in 11u64..=20 {
                m.with_lock(fn(t: &mut u64) { *t = *t + k; });
            }
        }
    }
    let local = m.into_inner();
    io.print(f"scope total {local}\n");
    return 0;
}

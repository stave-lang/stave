import std.io;

struct Rect { w: u32, h: u32 }

impl Rect {
    fn area(&self) -> u32 {
        return self.w * self.h;
    }

    fn perimeter(&self) -> u32 {
        return 2 * (self.w + self.h);
    }

    fn is_square(&self) -> bool {
        return self.w == self.h;
    }
}

fn main() -> i32 {
    let rs: [Rect; 3] = [Rect.{ w: 3, h: 4 }, Rect.{ w: 5, h: 5 }, Rect.{ w: 2, h: 7 }];
    for r in &rs {
        let a = r.area();
        let p = r.perimeter();
        let s = r.is_square();
        io.print(f"{r.w}x{r.h} area {a} perimeter {p} square {s}\n");
    }
    return 0;
}

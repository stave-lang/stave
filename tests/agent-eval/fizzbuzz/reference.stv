import std.io;

fn main() -> i32 {
    for i in 1u32..=15 {
        if i % 15 == 0 {
            io.print("FizzBuzz\n");
        } else if i % 3 == 0 {
            io.print("Fizz\n");
        } else if i % 5 == 0 {
            io.print("Buzz\n");
        } else {
            io.print(f"{i}\n");
        }
    }
    return 0;
}

import std.io;

struct Rec { id: u32, age: u32 }

impl Copy for Rec {}

fn sort(xs: &mut [Rec], less: fn(&Rec, &Rec) -> bool) {
    for i in 1..xs.len() {
        let mut j = i;
        while j > 0 && less(&xs[j], &xs[j - 1]) {
            let t = xs[j];
            xs[j] = xs[j - 1];
            xs[j - 1] = t;
            j = j - 1;
        }
    }
}

fn show(label: &str, xs: &[Rec]) {
    io.print(label);
    for i in 0..xs.len() {
        let id = xs[i].id;
        io.print(f" {id}");
    }
    io.print("\n");
}

fn main() -> i32 {
    let mut rs: [Rec; 6] = [
        Rec.{ id: 1, age: 30 },
        Rec.{ id: 2, age: 25 },
        Rec.{ id: 3, age: 30 },
        Rec.{ id: 4, age: 20 },
        Rec.{ id: 5, age: 25 },
        Rec.{ id: 6, age: 35 },
    ];
    sort(&mut rs[0..6], fn(a: &Rec, b: &Rec) -> bool {
        return a.age < b.age || (a.age == b.age && a.id < b.id);
    });
    show("by age:", &rs[0..6]);
    sort(&mut rs[0..6], fn(a: &Rec, b: &Rec) -> bool {
        return a.age > b.age || (a.age == b.age && a.id < b.id);
    });
    show("by age desc:", &rs[0..6]);
    return 0;
}

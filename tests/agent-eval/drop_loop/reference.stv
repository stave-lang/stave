import std.io;

struct Noisy { id: u32 }

impl Drop for Noisy {
    fn drop(&mut self) {
        io.print(f"drop {self.id}\n");
    }
}

fn make(id: u32) -> Noisy {
    io.print(f"made {id}\n");
    return Noisy.{ id: id };
}

fn main() -> i32 {
    for i in 1u32..=5 {
        let n = Noisy.{ id: i };
        if i == 2 {
            continue;
        }
        if i == 4 {
            break;
        }
        io.print(f"body {n.id}\n");
    }
    io.print("after\n");
    let k = make(9);
    io.print("end\n");
    return 0;
}

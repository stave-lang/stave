//~ BORROWCHECK write-under-shared 12 10
// A `&mut` word read through a `&` as an integer keeps the new `&` tag the read gives it (an
// integer made from a word keeps its tag): the pointer cast back from it is read-only.
view struct S { m: &mut u32 }
fn main() -> i32 {
    let mut a: u32 = 1u32;
    let s = S.{ m: &mut a };
    let r: &S = &s;
    let q = &r.m as *const &mut u32 as *const usize;
    let w: usize = unsafe("deliberate") *q;
    let p = w as *mut u32;
    unsafe("deliberate") { *p = 5u32; }
    if a == 5u32 { return 0; }
    return 1;
}

//~ BORROWCHECK ok
// Moves, drops, temporaries, and loop locals of an accepted program: a value moved out of a
// local, a field, an `Option`, a raw pointer, and a container; a place written again after a
// move; a temporary with drop glue; a local borrowed anew in every round of a loop.
import std.mem;
import std.vec;

struct Pair { a: vec.Vec<u32>, b: u32 }
view struct Slot { r: &mut u32 }

fn total(v: vec.Vec<u32>) -> u32 { return v.as_slice().sum(); }

fn bump(s: Slot) -> u32 {
    *s.r = *s.r + 1u32;
    return *s.r;
}

fn pick(o: Option<&mut u32>) -> u32 {
    return match o {
        Option.Some(r) => *r,
        Option.None => 0u32,
    };
}

fn make(n: u32) -> vec.Vec<u32> {
    let mut v = vec.Vec::<u32>.new();
    v.push(n);
    return v;
}

fn main() -> i32 {
    let mut sum: u32 = 0u32;
    let mut p = Pair.{ a: make(1u32), b: 2u32 };
    let a = p.a;
    p.a = make(3u32);
    sum = sum + total(a) + total(p.a) + p.b;
    let mut x: u32 = 4u32;
    let m: &mut u32 = &mut x;
    let n = m;
    sum = sum + bump(Slot.{ r: n });
    sum = sum + pick(Option.Some(&mut x));
    let mut held = make(6u32);
    let old = mem.replace(&mut held, make(7u32));
    sum = sum + total(old) + total(held);
    let mut q: u32 = 8u32;
    let mut pm: &mut u32 = &mut q;
    let raw = &mut pm as *mut &mut u32;
    let back: &mut u32 = unsafe("the one read of the pointee, written again below") raw.read();
    *back = 9u32;
    unsafe("the pointee was moved out: it is written, not assigned") { raw.write(&mut x); }
    sum = sum + *pm;
    sum = sum + make(10u32).as_slice()[0];
    let mut i: u32 = 0u32;
    while i < 3u32 {
        let y: u32 = i;
        let r: &u32 = &y;
        sum = sum + *r + make(i).as_slice()[0];
        i = i + 1u32;
    }
    for k in 0u32..2u32 {
        let z = make(k);
        let w: &vec.Vec<u32> = &z;
        if w.len() == 2 { continue; }
        if k == 5u32 { break; }
        sum = sum + w.as_slice()[0];
    }
    if sum == 51u32 { return 0; }
    return 1;
}

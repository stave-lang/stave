//~ BORROWCHECK use-after-referent 11 6
// A pointer made from a `&` of a local, read after the frame of the local returned.
fn addr_of_local() -> *const u32 {
    let x: u32 = 5u32;
    let r: &u32 = &x;
    return r as *const u32;
}

fn main() -> i32 {
    let p = addr_of_local();
    let y: u32 = unsafe("deliberate: the frame of x has returned") *p;
    if y == 5u32 { return 1; }
    return 0;
}

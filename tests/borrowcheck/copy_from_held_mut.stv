//~ BORROWCHECK two-exclusive 12 0
// A byte copy is a read of its source's bytes through the source's tag: `copy_from` through a
// `&` of bytes that a `&mut` (made through a raw pointer, written before) holds freezes that
// `&mut`, and its next write reports (the cause is the copy, inside std).
fn main() -> i32 {
    let mut ys: [u32; 4] = [5u32; 4];
    let mut xs: [u32; 4] = [0u32; 4];
    let p = &mut ys as *mut [u32; 4];
    let m: &mut [u32] = unsafe("deliberate: m holds the bytes the copy reads") &mut (*p)[0..4];
    m[0] = 6u32;
    xs[0..4].copy_from(&ys[0..4]);
    m[0] = 7u32;
    if xs[0] == 6u32 { return 1; }
    return 0;
}

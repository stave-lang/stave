//~ BORROWCHECK second-owner 9 8
// A `&mut` read twice out of its place through a raw pointer: the first `read` moves it out,
// the second reads a moved-out place.
fn main() -> i32 {
    let mut x: u32 = 1u32;
    let mut m: &mut u32 = &mut x;
    let pm = &mut m as *mut &mut u32;
    let a: &mut u32 = unsafe("deliberate: a copy of m") pm.read();
    let b: &mut u32 = unsafe("deliberate: a second copy of m") pm.read();
    *a = 2u32;
    *b = 3u32;
    if x == 3u32 { return 1; }
    return 0;
}

//~ BORROWCHECK two-exclusive 19 14
// The next evaluation of a constant temporary writes its `Cell` bytes again, through the
// root: a `&mut` into them, made from the cell's raw pointer in the round before, is Dead
// after it, and so is a raw pointer made from that `&mut`.
import std.cell;

const C: cell.UnsafeCell<u32> = cell.UnsafeCell::<u32>.new(0);

fn main() -> i32 {
    let mut dummy: u32 = 0;
    let mut keep: *mut u32 = &mut dummy as *mut u32;
    let mut i: u32 = 0;
    while i < 2 {
        let c: &cell.UnsafeCell<u32> = &C;
        if i == 0 {
            let m: &mut u32 = unsafe("deliberate: the content of a constant cell") &mut *c.get();
            keep = m as *mut u32;
        } else {
            unsafe("deliberate: keep was made in the round before") { keep.write(5); }
        }
        i = i + 1;
    }
    return 0;
}

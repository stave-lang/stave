//~ BORROWCHECK write-under-shared 6 14
// A write under a `&` param while its call runs: the param is protected until the return,
// whether it is used again or not.
fn bump(r: &u32, p: *mut u32) -> u32 {
    let a: u32 = *r;
    unsafe("deliberate: p points to the referent of r") { *p = a + 1u32; }
    return a;
}

fn main() -> i32 {
    let mut x: u32 = 1u32;
    let p = &mut x as *mut u32;
    let r: &u32 = &x;
    if bump(r, p) == 1u32 { return 1; }
    return 0;
}

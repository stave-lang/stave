//~ BORROWCHECK use-after-referent 13 0
// A pointer into a Vec buffer, read after pushes moved the buffer: the realloc is in std.
import std.mem;
import std.vec;

fn main() -> i32 {
    let mut v = vec.Vec::<u32>.with_capacity(1);
    v.push(7u32);
    let p: *const u32 = mem.slice_ptr(v.as_slice());
    for i in 0u32..100u32 {
        v.push(i);
    }
    let x: u32 = unsafe("deliberate: the buffer was reallocated") *p;
    if x == 7u32 { return 1; }
    return 0;
}

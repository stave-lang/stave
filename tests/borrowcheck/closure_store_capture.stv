//~ BORROWCHECK signature 13 15
// A closure body stores its param into a view it captures: a capture is a param for the
// stores, and a closure body has no clause. The report names the closure, not the fn that
// holds its literal.
view struct Pick { best: &u32, count: usize }

fn main() -> i32 {
    let zero: u32 = 0;
    let y: u32 = 7;
    let mut p = Pick.{ best: &zero, count: 0 };
    let put = fn(x: &u32) {
        let slot = &mut p.best as *mut &u32;
        unsafe("deliberate: a store into a captured view") { slot.write(x); }
    };
    put(&y);
    if *p.best == 7 { return 0; }
    return 1;
}

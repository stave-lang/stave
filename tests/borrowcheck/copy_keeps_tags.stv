//~ BORROWCHECK write-under-shared 17 16
// A byte copy moves the tag of each reference word it copies whole: `extend_from_slice` copies
// `&x` with its tag, so a write to x through a raw pointer makes the copy Dead like the
// original, and the read through the copy reports. A copy that lost the tag would read through
// the root of x and report nothing.
import std.vec;

fn main() -> i32 {
    let mut x: u32 = 1u32;
    let p = &mut x as *mut u32;
    let r: &u32 = &x;
    let mut w = vec.Vec::<&u32>.new();
    w.push(r);
    let mut v = vec.Vec::<&u32>.new();
    v.extend_from_slice(w.as_slice());
    unsafe("deliberate: p points to x, which the copied reference borrows") { *p = 2u32; }
    if **v.get_ref(0) == 2u32 { return 1; }
    return 0;
}

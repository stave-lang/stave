//~ BORROWCHECK use-after-referent 18 16
// A `const` with `Cell` bytes is a value like any other: `&C` borrows a temporary that ends
// with its statement, and a call through the reference after it uses an ended allocation.
import std.atomic;

const C: atomic.U32 = atomic.U32.new(0);

fn main() -> i32 {
    let z = atomic.U32.new(0);
    let mut r: &atomic.U32 = &z;
    let mut total: u32 = 0;
    let mut seen: u32 = 0;
    let mut i: u32 = 0;
    while i < 3 {
        let before: &atomic.U32 = r;
        r = &C;
        seen = seen + before.load();
        let _ = r.fetch_add(1);
        total = total + r.load();
        i = i + 1;
    }
    if total == 3 && seen == 0 { return 0; }
    return 1;
}

//~ BORROWCHECK two-exclusive 9 8
// A closure that returns `&mut` of its capture, called twice: both results written through.
fn main() -> i32 {
    let mut n: u32 = 1u32;
    let f = fn() -> &mut u32 { return &mut n; };
    let a: &mut u32 = f();
    let b: &mut u32 = f();
    *a = 1u32;
    *b = 2u32;
    if *a == 2u32 { return 1; }
    return 0;
}

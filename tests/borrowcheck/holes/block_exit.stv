//~ BORROWCHECK use-after-referent 10 8
// A `&` of a local read after the local's block was left: the local ended with the block.
fn main() -> i32 {
    let zero: u32 = 0u32;
    let mut r: &u32 = &zero;
    {
        let x: u32 = 7u32;
        r = &x;
    }
    if *r == 7u32 { return 1; }
    return 0;
}

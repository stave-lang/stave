//~ BORROWCHECK write-under-shared 6 7
// A closure literal borrows the local it captures: a write of the local makes the capture
// reference Dead, and the body reads through it.
fn main() -> i32 {
    let mut n: u32 = 1u32;
    let f = fn() -> u32 { return n; };
    n = 2u32;
    if f() == 2u32 { return 1; }
    return 0;
}

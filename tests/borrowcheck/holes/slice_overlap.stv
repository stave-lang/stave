//~ BORROWCHECK two-exclusive 8 7
// Two `&mut` sub-slices that share an element, both used.
fn main() -> i32 {
    let mut arr: [u32; 4] = [1u32, 2u32, 3u32, 4u32];
    let a: &mut [u32] = &mut arr[0..2];
    let b: &mut [u32] = &mut arr[1..3];
    b[0] = 7u32;
    if a[1] == 7u32 { return 1; }
    return 0;
}

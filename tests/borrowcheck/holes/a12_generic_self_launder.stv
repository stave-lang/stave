//~ BORROWCHECK write-under-shared 32 31
import std.io;

view struct Cur { cur: &u32, n: u32 }
view struct Two { slot: &mut &u32, n: &u32 }
view struct Slot<T: view> { v: T, k: usize }

trait Splits {
    fn split(self) -> Two from self;
}

impl Splits for &mut Cur {
    fn split(self) -> Two from self {
        return Two.{ slot: &mut self.cur, n: &self.n };
    }
}

// the store goes through the by-value `x`, covered by the clause of `k`
fn g<T: view + Splits>(k: &mut Slot<u32> from x, x: T) {
    let two = x.split();
    *two.slot = two.n;
}

fn main() -> i32 {
    let zero: u32 = 0;
    let mut s = Slot::<u32>.{ v: 0, k: 0 };
    let mut b = Cur.{ cur: &zero, n: 1 };
    g(&mut s, &mut b);
    let r: &u32 = b.cur;
    let before: u32 = *r;
    b.n = 2;
    let after: u32 = *r;
    io.print(f"{before} {after}\n");
    return 0;
}

//~ BORROWCHECK write-under-shared 17 16
import std.io;

view struct Pick { best: &u32, count: usize }

fn two(a: &mut Pick from x, b: &mut Pick from copy a, x: &u32) {
    a.best = x;
    b.best = a.best;
}

fn main() -> i32 {
    let zero: u32 = 0;
    let mut pb = Pick.{ best: &zero, count: 0 };
    let mut i: u32 = 0;
    while i < 3 {
        let x: u32 = 10 + i;
        let seen: u32 = *pb.best;
        io.print(f"round {i}: x = {x}, pb.best reads {seen}\n");
        let mut pa = Pick.{ best: &zero, count: 0 };
        two(&mut pa, &mut pb, &x);
        i = i + 1;
    }
    return 0;
}

//~ BORROWCHECK two-exclusive 13 12
// The binding of a `for` over a `&mut` slice borrows its element through the slice's
// reference: a write through that reference makes a kept binding Dead.
fn first_of(xs: &mut [u32]) -> u32 {
    let mut zero: u32 = 0u32;
    let mut first: &mut u32 = &mut zero;
    let mut k: u32 = 0u32;
    for x in xs {
        if k == 0u32 { first = x; }
        k = k + 1u32;
    }
    xs[0] = 7u32;
    *first = 8u32;
    return xs[0];
}

fn main() -> i32 {
    let mut a: [u32; 3] = [1u32, 2u32, 3u32];
    if first_of(&mut a) == 8u32 { return 1; }
    return 0;
}

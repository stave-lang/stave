//~ BORROWCHECK write-under-shared 22 21
import std.io;

view struct Cur { cur: &u32, n: u32 }

fn link(dst: &mut Cur from src, src: &mut Cur) {
    match src {
        Cur.{ cur, n } => {
            *cur = n;
        }
    }
}

fn main() -> i32 {
    let zero: u32 = 0;
    let mut a = Cur.{ cur: &zero, n: 5 };
    let mut b = Cur.{ cur: &zero, n: 1 };
    link(&mut a, &mut b);
    let r: &u32 = b.cur;
    let before: u32 = *r;
    b.n = 2;
    let after: u32 = *r;
    io.print(f"{before} {after}\n");
    return 0;
}

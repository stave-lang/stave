//~ BORROWCHECK use-after-referent 11 10
// `&(2 + 2)` kept for the next round: the temporary ended with its statement.
fn main() -> i32 {
    let zero: u32 = 0u32;
    let mut lit: &u32 = &zero;
    let mut sum: u32 = 0u32;
    let mut i: u32 = 0u32;
    while i < 2u32 {
        let old: &u32 = lit;
        lit = &(2u32 + 2u32);
        sum = sum + *old;
        i = i + 1u32;
    }
    if sum == 4u32 { return 1; }
    return 0;
}

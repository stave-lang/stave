//~ BORROWCHECK write-under-shared 19 18
import std.io;

view struct Pick { best: &u32, count: usize }

impl Pick {
    fn swap_in(&mut self from x, x: &u32) -> &u32 from copy self {
        self.best = x;
        return self.best;
    }
}

fn main() -> i32 {
    let zero: u32 = 0;
    let mut r: &u32 = &zero;
    let mut i: u32 = 0;
    while i < 3 {
        let x: u32 = 10 + i;
        let seen: u32 = *r;
        io.print(f"round {i}: x = {x}, r reads {seen}\n");
        let mut p = Pick.{ best: &zero, count: 0 };
        r = p.swap_in(&x);
        i = i + 1;
    }
    return 0;
}

//~ BORROWCHECK two-exclusive 7 6
// A reborrow used after a write through its parent.
fn child(p: &mut u32) -> u32 {
    let c: &mut u32 = &mut *p;
    *c = 1u32;
    *p = 2u32;
    *c = 3u32;
    return *p;
}

fn main() -> i32 {
    let mut x: u32 = 0u32;
    if child(&mut x) == 3u32 { return 1; }
    return 0;
}

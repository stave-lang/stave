//~ BORROWCHECK write-under-shared 18 17
import std.io;

view struct Pick { best: &u32, count: usize }

impl Pick {
    fn take(&mut self from x, x: &u32) {
        self.best = x;
    }
}

fn main() -> i32 {
    let zero: u32 = 0;
    let mut t: (u32, Pick) = (1, Pick.{ best: &zero, count: 0 });
    t.1.take(&t.0);
    let a: u32 = *t.1.best;
    t.0 = 2;
    let b: u32 = *t.1.best;
    io.print(f"{a} {b}\n");
    return 0;
}

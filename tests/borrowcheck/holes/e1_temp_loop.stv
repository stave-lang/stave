//~ BORROWCHECK use-after-referent 16 15
import std.io;

fn next(i: u32) -> u32 {
    return i + 1;
}

fn main() -> i32 {
    let zero: u32 = 0;
    let mut r: &u32 = &zero;
    let mut i: u32 = 0;
    while i < 3 {
        let before: &u32 = r;
        let old: u32 = *before;
        r = &next(i);
        let now: u32 = *before;
        io.print(f"round {i}: before read {old}, after the store reads {now}\n");
        i = i + 1;
    }
    return 0;
}

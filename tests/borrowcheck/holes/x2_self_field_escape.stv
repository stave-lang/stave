//~ BORROWCHECK use-after-referent 22 16
import std.io;

view struct Pick { best: &u32, count: usize }
view struct Outer { n: u32, inner: Pick }

impl Pick {
    fn take(&mut self from x, x: &u32) {
        self.best = x;
    }
}

fn leak(seed: &u32, v: u32) -> &u32 from seed {
    let mut o = Outer.{ n: v, inner: Pick.{ best: seed, count: 0 } };
    o.inner.take(&o.n);
    return o.inner.best;
}

fn main() -> i32 {
    let zero: u32 = 0;
    let r: &u32 = leak(&zero, 7);
    let before: u32 = *r;
    let other: &u32 = leak(&zero, 9);
    let s: u32 = *other;
    let after: u32 = *r;
    io.print(f"{before} {after} {s}\n");
    return 0;
}

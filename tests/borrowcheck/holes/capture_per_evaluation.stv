//~ BORROWCHECK write-under-shared 11 10
// Each evaluation of a closure literal makes capture references of its own: the fn value of
// the first round keeps the one a later write made Dead, whatever the second round borrows.
fn main() -> i32 {
    let mut n: u32 = 1u32;
    let zero: u32 = 0u32;
    let mut keep: fn() -> u32 = fn() -> u32 { return zero; };
    let mut sum: u32 = 0u32;
    for i in 0u32..2u32 {
        if i == 1u32 { n = 5u32; }
        let g: fn() -> u32 = fn() -> u32 { return n; };
        if i == 0u32 { keep = g; }
        sum = sum + keep();
    }
    if sum == 6u32 { return 1; }
    return 0;
}

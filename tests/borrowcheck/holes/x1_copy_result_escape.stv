//~ BORROWCHECK use-after-referent 22 16
import std.io;

view struct Pick { best: &u32, count: usize }

impl Pick {
    fn swap_in(&mut self from x, x: &u32) -> &u32 from copy self {
        self.best = x;
        return self.best;
    }
}

fn leak(seed: &u32, v: u32) -> &u32 from seed {
    let x: u32 = v;
    let mut p = Pick.{ best: seed, count: 0 };
    return p.swap_in(&x);
}

fn main() -> i32 {
    let zero: u32 = 0;
    let r: &u32 = leak(&zero, 7);
    let before: u32 = *r;
    let other: &u32 = leak(&zero, 9);
    let s: u32 = *other;
    let after: u32 = *r;
    io.print(f"{before} {after} {s}\n");
    return 0;
}

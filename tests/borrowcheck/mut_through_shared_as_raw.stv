//~ BORROWCHECK write-under-shared 11 10
// A `&mut` word read through a `&` is read-only whatever type it is loaded as: read as a
// `*mut u32`, it carries a new `&` tag, and a write through it is a write under a `&`.
view struct S { m: &mut u32 }
fn main() -> i32 {
    let mut a: u32 = 1u32;
    let s = S.{ m: &mut a };
    let r: &S = &s;
    let q = &r.m as *const &mut u32 as *const *mut u32;
    let p: *mut u32 = unsafe("deliberate") *q;
    unsafe("deliberate") { *p = 5u32; }
    if a == 5u32 { return 0; }
    return 1;
}

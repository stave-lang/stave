//~ BORROWCHECK write-under-shared 13 7
// A `*mut` read from a `&mut` word through a `&` in a callee and returned keeps the `&` tag
// of the read: a write through it in the caller is a write under a `&`.
view struct S { m: &mut u32 }
fn ptr_of(s: &S) -> *mut u32 {
    let q = &s.m as *const &mut u32 as *const *mut u32;
    return unsafe("deliberate") *q;
}
fn main() -> i32 {
    let mut a: u32 = 1u32;
    let s = S.{ m: &mut a };
    let p = ptr_of(&s);
    unsafe("deliberate") { *p = 5u32; }
    if a == 5u32 { return 0; }
    return 1;
}

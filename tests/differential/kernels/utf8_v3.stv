// The validator of utf8.stv with 256-bit vectors (x86_64-linux-v3), against the same reference.
import base;
import diff;

struct Tables32 {
    b1_high: u8x32,
    b1_low: u8x32,
    b2_high: u8x32,
}

// The 16-entry tables of utf8.stv, each twice: lookup indices stay below 16.
fn tables32() -> Tables32 {
    let t = base.tables();
    return Tables32.{
        b1_high: u8x32.join(t.b1_high, t.b1_high),
        b1_low: u8x32.join(t.b1_low, t.b1_low),
        b2_high: u8x32.join(t.b2_high, t.b2_high),
    };
}

// Bytes i - back .. i - back + 32 of xs, 0 outside it: one load when the block is inside.
fn block(xs: &[u8], i: usize, back: usize) -> u8x32 {
    let n = xs.len();
    if i >= back && i - back + 32 <= n { return u8x32.load(xs, i - back); }
    let mut b: [u8; 32] = [0; 32];
    for k in 0usize..32 {
        if i + k >= back && i + k - back < n { b[k] = xs[i + k - back]; }
    }
    return u8x32.load(&b[0..32], 0);
}

fn valid_u8x32(xs: &[u8]) -> bool {
    let t = tables32();
    let low = u8x32.splat(15);
    let mut err = u8x32.splat(0);
    let mut i: usize = 0;
    while i < xs.len() + 3 {
        let cur = block(xs, i, 0);
        let p1 = block(xs, i, 1);
        let p2 = block(xs, i, 2);
        let p3 = block(xs, i, 3);
        let special = t.b1_high.lookup(p1 >> 4) & t.b1_low.lookup(p1 & low) & t.b2_high.lookup(cur >> 4);
        let third = p2 -| u8x32.splat(0x60);
        let fourth = p3 -| u8x32.splat(0x70);
        let must = ((third | fourth) >= u8x32.splat(0x80)).select(u8x32.splat(0x80), u8x32.splat(0));
        err = err | (special ^ must);
        i = i + 32;
    }
    return err.reduce_or() == 0;
}

fn code_points_u8x32(xs: &[u8]) -> usize {
    let top = u8x32.splat(0xc0);
    let cont = u8x32.splat(0x80);
    let mut c: usize = 0;
    for v: u8x32 in xs {
        c = c + (((v & top) != cont).to_bits().popcount() as usize);
    } tail scalar (x) {
        if (x & 0xc0) != 0x80 { c = c + 1; }
    }
    return c;
}

fn main() -> i32 {
    let mut c = diff.open();
    let mut o = diff.out();
    let n = c.count();
    for k in 0..n {
        let h = c.head();
        let b = c.u8s(h);
        let xs = b.get();
        o.flag(valid_u8x32(xs));
        o.u(code_points_u8x32(xs) as u64);
        o.sep();
        o.flag(base.valid_ref(xs));
        o.u(base.code_points_ref(xs) as u64);
        o.end();
    }
    o.flush();
    return 0;
}

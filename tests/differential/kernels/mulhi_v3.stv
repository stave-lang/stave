// The kernels of mulhi.stv with 256-bit vectors (x86_64-linux-v3), against the same references.
import base;
import diff;

fn run(a: &[i32], b: &[i32], r: &mut [i32], f: fn(i32x8, i32x8) -> i32x8) {
    let n = a.len();
    let mut i: usize = 0;
    while i + 8 <= n {
        f(i32x8.load(a, i), i32x8.load(b, i)).store(r, i);
        i = i + 8;
    }
    if i < n {
        let m = mask32x8.first_n(n - i);
        f(i32x8.load_masked(a, i, m), i32x8.load_masked(b, i, m)).store_masked(r, i, m);
    }
}

fn hi_i8(x: i32x8, y: i32x8) -> i32x8 {
    return x.bitcast::<i8x32>().mul_hi(y.bitcast::<i8x32>()).bitcast::<i32x8>();
}

fn hi_u8(x: i32x8, y: i32x8) -> i32x8 {
    return x.bitcast::<u8x32>().mul_hi(y.bitcast::<u8x32>()).bitcast::<i32x8>();
}

fn hi_i16(x: i32x8, y: i32x8) -> i32x8 {
    return x.bitcast::<i16x16>().mul_hi(y.bitcast::<i16x16>()).bitcast::<i32x8>();
}

fn hi_u16(x: i32x8, y: i32x8) -> i32x8 {
    return x.bitcast::<u16x16>().mul_hi(y.bitcast::<u16x16>()).bitcast::<i32x8>();
}

fn hi_i32(x: i32x8, y: i32x8) -> i32x8 {
    return x.mul_hi(y);
}

fn hi_u32(x: i32x8, y: i32x8) -> i32x8 {
    return x.bitcast::<u32x8>().mul_hi(y.bitcast::<u32x8>()).bitcast::<i32x8>();
}

fn hi_i64(x: i32x8, y: i32x8) -> i32x8 {
    return x.bitcast::<i64x4>().mul_hi(y.bitcast::<i64x4>()).bitcast::<i32x8>();
}

fn hi_u64(x: i32x8, y: i32x8) -> i32x8 {
    return x.bitcast::<u64x4>().mul_hi(y.bitcast::<u64x4>()).bitcast::<i32x8>();
}

const FNV_START: u64 = 14695981039346656037;
const FNV_PRIME: u64 = 1099511628211;

fn all_u8() -> u64 {
    let mut h = FNV_START;
    let mut out: [u8; 32] = [0; 32];
    let mut idx: [u8; 32] = [0; 32];
    for j in 0usize..32 {
        idx[j] = j as% u8;
    }
    let iota = u8x32.load(&idx, 0);
    for y in 0usize..256 {
        let mut c: usize = 0;
        while c < 256 {
            (iota +% u8x32.splat(c as% u8)).mul_hi(u8x32.splat(y as% u8)).store(&mut out, 0);
            for j in 0usize..32 {
                h = (h ^ (out[j] as u64)) *% FNV_PRIME;
            }
            c = c + 32;
        }
    }
    return h;
}

fn all_i8() -> u64 {
    let mut h = FNV_START;
    let mut out: [u8; 32] = [0; 32];
    let mut idx: [u8; 32] = [0; 32];
    for j in 0usize..32 {
        idx[j] = j as% u8;
    }
    let iota = u8x32.load(&idx, 0);
    for y in 0usize..256 {
        let yy = u8x32.splat(y as% u8).bitcast::<i8x32>();
        let mut c: usize = 0;
        while c < 256 {
            let x = (iota +% u8x32.splat(c as% u8)).bitcast::<i8x32>();
            x.mul_hi(yy).bitcast::<u8x32>().store(&mut out, 0);
            for j in 0usize..32 {
                h = (h ^ (out[j] as u64)) *% FNV_PRIME;
            }
            c = c + 32;
        }
    }
    return h;
}

fn vec_side(o: &mut diff.Out, a: &[i32], b: &[i32], h: diff.Head) {
    let fs: [fn(i32x8, i32x8) -> i32x8; 8] = [hi_i8, hi_u8, hi_i16, hi_u16, hi_i32, hi_u32, hi_i64, hi_u64];
    for k in 0usize..8 {
        let mut r = diff.Buf::<i32>.new(h.len, h.mis, 0);
        run(a, b, r.get_mut(), fs[k]);
        o.i32s(r.get());
        o.flag(diff.guards_i32(&r));
    }
}

fn ref_side(o: &mut diff.Out, a: &[i32], b: &[i32], h: diff.Head) {
    let fs: [fn(&[i32], &[i32], &mut [i32]) -> bool; 8] =
        [base.ref_i8, base.ref_u8, base.ref_i16, base.ref_u16, base.ref_i32, base.ref_u32, base.ref_i64, base.ref_u64];
    let mut same = true;
    for k in 0usize..8 {
        let mut r = diff.Buf::<i32>.new(h.len, h.mis, 0);
        if !fs[k](a, b, r.get_mut()) {
            same = false;
        }
        o.i32s(r.get());
        o.flag(true);
    }
    o.flag(same);
}

fn main() -> i32 {
    let mut c = diff.open();
    let mut o = diff.out();
    let n = c.count();
    for k in 0..n {
        let h = c.head();
        let ba = c.i32s(h);
        let bb = c.i32s(h);
        vec_side(&mut o, ba.get(), bb.get(), h);
        o.flag(true);
        if k == 0 {
            o.u(all_i8());
            o.u(all_u8());
        }
        o.sep();
        ref_side(&mut o, ba.get(), bb.get(), h);
        if k == 0 {
            o.u(base.all_i8_ref());
            o.u(base.all_u8_ref());
        }
        o.end();
    }
    o.flush();
    return 0;
}

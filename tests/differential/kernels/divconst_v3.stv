// The kernels of divconst.stv with 256-bit vectors (x86_64-linux-v3), against the same
// references with twice the lanes.
import base;
import diff;

fn run(a: &[i32], r: &mut [i32], f: fn(i32x8) -> i32x8) {
    let n = a.len();
    let mut i: usize = 0;
    while i + 8 <= n {
        f(i32x8.load(a, i)).store(r, i);
        i = i + 8;
    }
    if i < n {
        let m = mask32x8.first_n(n - i);
        f(i32x8.load_masked(a, i, m)).store_masked(r, i, m);
    }
}

// Every i8 lane value through f, 32 at a time, folded per lane.
fn all_i8(f: fn(i8x32) -> i8x32) -> u64 {
    let mut idx: [i8; 32] = [0; 32];
    for j in 0usize..32 {
        idx[j] = ((j as% u8) as% i8);
    }
    let iota = i8x32.load(&idx, 0);
    let mut acc = i8x32.splat(0);
    let p = i8x32.splat((157u8 as% i8));
    let mut c: usize = 0;
    while c < 256 {
        let x = iota +% i8x32.splat(((c as% u8) as% i8));
        acc = (acc ^ f(x)) *% p;
        c = c + 32;
    }
    let mut out: [i8; 32] = [0; 32];
    acc.store(&mut out, 0);
    let mut h: u64 = 14695981039346656037;
    for j in 0usize..32 {
        h = (h ^ ((out[j] as% u8) as u64)) *% 1099511628211;
    }
    return h;
}

// Every u8 lane value through f, 32 at a time, folded per lane.
fn all_u8(f: fn(u8x32) -> u8x32) -> u64 {
    let mut idx: [u8; 32] = [0; 32];
    for j in 0usize..32 {
        idx[j] = (j as% u8);
    }
    let iota = u8x32.load(&idx, 0);
    let mut acc = u8x32.splat(0);
    let p = u8x32.splat(157u8);
    let mut c: usize = 0;
    while c < 256 {
        let x = iota +% u8x32.splat((c as% u8));
        acc = (acc ^ f(x)) *% p;
        c = c + 32;
    }
    let mut out: [u8; 32] = [0; 32];
    acc.store(&mut out, 0);
    let mut h: u64 = 14695981039346656037;
    for j in 0usize..32 {
        h = (h ^ ((out[j] as% u8) as u64)) *% 1099511628211;
    }
    return h;
}

// Every i16 lane value through f, 16 at a time, folded per lane.
fn all_i16(f: fn(i16x16) -> i16x16) -> u64 {
    let mut idx: [i16; 16] = [0; 16];
    for j in 0usize..16 {
        idx[j] = ((j as% u16) as% i16);
    }
    let iota = i16x16.load(&idx, 0);
    let mut acc = i16x16.splat(0);
    let p = i16x16.splat((40503u16 as% i16));
    let mut c: usize = 0;
    while c < 65536 {
        let x = iota +% i16x16.splat(((c as% u16) as% i16));
        acc = (acc ^ f(x)) *% p;
        c = c + 16;
    }
    let mut out: [i16; 16] = [0; 16];
    acc.store(&mut out, 0);
    let mut h: u64 = 14695981039346656037;
    for j in 0usize..16 {
        h = (h ^ ((out[j] as% u16) as u64)) *% 1099511628211;
    }
    return h;
}

// Every u16 lane value through f, 16 at a time, folded per lane.
fn all_u16(f: fn(u16x16) -> u16x16) -> u64 {
    let mut idx: [u16; 16] = [0; 16];
    for j in 0usize..16 {
        idx[j] = (j as% u16);
    }
    let iota = u16x16.load(&idx, 0);
    let mut acc = u16x16.splat(0);
    let p = u16x16.splat(40503u16);
    let mut c: usize = 0;
    while c < 65536 {
        let x = iota +% u16x16.splat((c as% u16));
        acc = (acc ^ f(x)) *% p;
        c = c + 16;
    }
    let mut out: [u16; 16] = [0; 16];
    acc.store(&mut out, 0);
    let mut h: u64 = 14695981039346656037;
    for j in 0usize..16 {
        h = (h ^ ((out[j] as% u16) as u64)) *% 1099511628211;
    }
    return h;
}


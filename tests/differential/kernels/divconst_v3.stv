fn main() -> i32 {
    let mut c = diff.open();
    let mut o = diff.out();
    let n = c.count();
    for k in 0..n {
        let h = c.head();
        let ba = c.i32s(h);
        let a = ba.get();
        let mut r = diff.Buf::<i32>.new(h.len, h.mis, 0);
        run(a, r.get_mut(), q_i32_m1);
        o.i32s(r.get());
        let mut r = diff.Buf::<i32>.new(h.len, h.mis, 0);
        run(a, r.get_mut(), q_i32_2);
        o.i32s(r.get());
        let mut r = diff.Buf::<i32>.new(h.len, h.mis, 0);
        run(a, r.get_mut(), q_i32_m3);
        o.i32s(r.get());
        let mut r = diff.Buf::<i32>.new(h.len, h.mis, 0);
        run(a, r.get_mut(), q_i32_7);
        o.i32s(r.get());
        let mut r = diff.Buf::<i32>.new(h.len, h.mis, 0);
        run(a, r.get_mut(), q_i32_m7);
        o.i32s(r.get());
        let mut r = diff.Buf::<i32>.new(h.len, h.mis, 0);
        run(a, r.get_mut(), q_i32_1048576);
        o.i32s(r.get());
        let mut r = diff.Buf::<i32>.new(h.len, h.mis, 0);
        run(a, r.get_mut(), q_i32_2147483647);
        o.i32s(r.get());
        let mut r = diff.Buf::<i32>.new(h.len, h.mis, 0);
        run(a, r.get_mut(), q_i32_m2147483648);
        o.i32s(r.get());
        let mut r = diff.Buf::<i32>.new(h.len, h.mis, 0);
        run(a, r.get_mut(), q_u32_1);
        o.i32s(r.get());
        let mut r = diff.Buf::<i32>.new(h.len, h.mis, 0);
        run(a, r.get_mut(), q_u32_3);
        o.i32s(r.get());
        let mut r = diff.Buf::<i32>.new(h.len, h.mis, 0);
        run(a, r.get_mut(), q_u32_7);
        o.i32s(r.get());
        let mut r = diff.Buf::<i32>.new(h.len, h.mis, 0);
        run(a, r.get_mut(), q_u32_65536);
        o.i32s(r.get());
        let mut r = diff.Buf::<i32>.new(h.len, h.mis, 0);
        run(a, r.get_mut(), q_u32_2147483649);
        o.i32s(r.get());
        let mut r = diff.Buf::<i32>.new(h.len, h.mis, 0);
        run(a, r.get_mut(), q_u32_4294967295);
        o.i32s(r.get());
        let mut r = diff.Buf::<i32>.new(h.len, h.mis, 0);
        run(a, r.get_mut(), q_i64_m1);
        o.i32s(r.get());
        let mut r = diff.Buf::<i32>.new(h.len, h.mis, 0);
        run(a, r.get_mut(), q_i64_7);
        o.i32s(r.get());
        let mut r = diff.Buf::<i32>.new(h.len, h.mis, 0);
        run(a, r.get_mut(), q_i64_m641);
        o.i32s(r.get());
        let mut r = diff.Buf::<i32>.new(h.len, h.mis, 0);
        run(a, r.get_mut(), q_i64_m9223372036854775808);
        o.i32s(r.get());
        let mut r = diff.Buf::<i32>.new(h.len, h.mis, 0);
        run(a, r.get_mut(), q_u64_1);
        o.i32s(r.get());
        let mut r = diff.Buf::<i32>.new(h.len, h.mis, 0);
        run(a, r.get_mut(), q_u64_7);
        o.i32s(r.get());
        let mut r = diff.Buf::<i32>.new(h.len, h.mis, 0);
        run(a, r.get_mut(), q_u64_641);
        o.i32s(r.get());
        let mut r = diff.Buf::<i32>.new(h.len, h.mis, 0);
        run(a, r.get_mut(), q_u64_18446744073709551615);
        o.i32s(r.get());
        if k == 0 {
            o.u(all_i8(q_i8_1));
            o.u(all_i8(q_i8_m1));
            o.u(all_i8(q_i8_2));
            o.u(all_i8(q_i8_m2));
            o.u(all_i8(q_i8_3));
            o.u(all_i8(q_i8_m3));
            o.u(all_i8(q_i8_5));
            o.u(all_i8(q_i8_m5));
            o.u(all_i8(q_i8_6));
            o.u(all_i8(q_i8_7));
            o.u(all_i8(q_i8_m7));
            o.u(all_i8(q_i8_10));
            o.u(all_i8(q_i8_m10));
            o.u(all_i8(q_i8_11));
            o.u(all_i8(q_i8_25));
            o.u(all_i8(q_i8_m25));
            o.u(all_i8(q_i8_37));
            o.u(all_i8(q_i8_64));
            o.u(all_i8(q_i8_m64));
            o.u(all_i8(q_i8_100));
            o.u(all_i8(q_i8_m100));
            o.u(all_i8(q_i8_126));
            o.u(all_i8(q_i8_127));
            o.u(all_i8(q_i8_m127));
            o.u(all_i8(q_i8_m128));
            o.u(all_u8(q_u8_1));
            o.u(all_u8(q_u8_2));
            o.u(all_u8(q_u8_3));
            o.u(all_u8(q_u8_5));
            o.u(all_u8(q_u8_6));
            o.u(all_u8(q_u8_7));
            o.u(all_u8(q_u8_10));
            o.u(all_u8(q_u8_11));
            o.u(all_u8(q_u8_13));
            o.u(all_u8(q_u8_25));
            o.u(all_u8(q_u8_37));
            o.u(all_u8(q_u8_64));
            o.u(all_u8(q_u8_100));
            o.u(all_u8(q_u8_127));
            o.u(all_u8(q_u8_128));
            o.u(all_u8(q_u8_129));
            o.u(all_u8(q_u8_200));
            o.u(all_u8(q_u8_254));
            o.u(all_u8(q_u8_255));
            o.u(all_i16(q_i16_m1));
            o.u(all_i16(q_i16_m2));
            o.u(all_i16(q_i16_7));
            o.u(all_i16(q_i16_m7));
            o.u(all_i16(q_i16_15));
            o.u(all_i16(q_i16_m15));
            o.u(all_i16(q_i16_32767));
            o.u(all_i16(q_i16_m32768));
            o.u(all_u16(q_u16_1));
            o.u(all_u16(q_u16_3));
            o.u(all_u16(q_u16_7));
            o.u(all_u16(q_u16_16));
            o.u(all_u16(q_u16_65535));
        }
        o.sep();
        let mut r = diff.Buf::<i32>.new(h.len, h.mis, 0);
        base.ref_i32(a, r.get_mut(), -1);
        o.i32s(r.get());
        let mut r = diff.Buf::<i32>.new(h.len, h.mis, 0);
        base.ref_i32(a, r.get_mut(), 2);
        o.i32s(r.get());
        let mut r = diff.Buf::<i32>.new(h.len, h.mis, 0);
        base.ref_i32(a, r.get_mut(), -3);
        o.i32s(r.get());
        let mut r = diff.Buf::<i32>.new(h.len, h.mis, 0);
        base.ref_i32(a, r.get_mut(), 7);
        o.i32s(r.get());
        let mut r = diff.Buf::<i32>.new(h.len, h.mis, 0);
        base.ref_i32(a, r.get_mut(), -7);
        o.i32s(r.get());
        let mut r = diff.Buf::<i32>.new(h.len, h.mis, 0);
        base.ref_i32(a, r.get_mut(), 1048576);
        o.i32s(r.get());
        let mut r = diff.Buf::<i32>.new(h.len, h.mis, 0);
        base.ref_i32(a, r.get_mut(), 2147483647);
        o.i32s(r.get());
        let mut r = diff.Buf::<i32>.new(h.len, h.mis, 0);

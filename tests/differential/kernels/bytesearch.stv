// Byte search: the first and the last index of a byte (the length when it is absent), and its
// count. Compares give a mask, `to_bits` a u16 with bit i for lane i; `ctz` / `clz` of it find the
// lane. The last-index search walks backwards with full loads ending at the slice end, then one
// masked load for the head.
import diff;

pub fn find_first(xs: &[u8], b: u8) -> usize {
    let key = u8x16.splat(b);
    let n = xs.len();
    let mut i: usize = 0;
    while i + 16 <= n {
        let bits = (u8x16.load(xs, i) == key).to_bits();
        if bits != 0 { return i + (bits.ctz() as usize); }
        i = i + 16;
    }
    if i < n {
        let m = mask8x16.first_n(n - i);
        let bits = ((u8x16.load_masked(xs, i, m) == key) & m).to_bits();
        if bits != 0 { return i + (bits.ctz() as usize); }
    }
    return n;
}

pub fn find_last(xs: &[u8], b: u8) -> usize {
    let key = u8x16.splat(b);
    let n = xs.len();
    let mut j = n;
    while j >= 16 {
        let bits = (u8x16.load(xs, j - 16) == key).to_bits();
        if bits != 0 { return j - 1 - (bits.clz() as usize); }
        j = j - 16;
    }
    if j > 0 {
        let m = mask8x16.first_n(j);
        let bits = ((u8x16.load_masked(xs, 0, m) == key) & m).to_bits();
        if bits != 0 { return 15 - (bits.clz() as usize); }
    }
    return n;
}

pub fn count(xs: &[u8], b: u8) -> usize {
    let key = u8x16.splat(b);
    let mut c: usize = 0;
    for v: u8x16 in xs {
        c = c + ((v == key).to_bits().popcount() as usize);
    } tail scalar (x) {
        if x == b { c = c + 1; }
    }
    return c;
}

pub fn find_first_ref(xs: &[u8], b: u8) -> usize {
    for i in 0..xs.len() {
        if xs[i] == b { return i; }
    }
    return xs.len();
}

pub fn find_last_ref(xs: &[u8], b: u8) -> usize {
    let mut i = xs.len();
    while i > 0 {
        i = i - 1;
        if xs[i] == b { return i; }
    }
    return xs.len();
}

pub fn count_ref(xs: &[u8], b: u8) -> usize {
    let mut c: usize = 0;
    for i in 0..xs.len() {
        if xs[i] == b { c = c + 1; }
    }
    return c;
}

fn main() -> i32 {
    let mut c = diff.open();
    let mut o = diff.out();
    let n = c.count();
    for k in 0..n {
        let h = c.head();
        let b = c.u8s(h);
        let xs = b.get();
        let key = h.param as% u8;
        o.u(find_first(xs, key) as u64);
        o.u(find_last(xs, key) as u64);
        o.u(count(xs, key) as u64);
        o.sep();
        o.u(find_first_ref(xs, key) as u64);
        o.u(find_last_ref(xs, key) as u64);
        o.u(count_ref(xs, key) as u64);
        o.end();
    }
    o.flush();
    return 0;
}

// High halves of lane products, `a.mul_hi(b)`, on the eight int lane types, against the scalar
// `x.mul_hi(y)` (8- and 16-bit lanes) and the high half of `x.mul_wide(y)` (32- and 64-bit
// lanes). The inputs are two i32 arrays read as lanes of every type: a chunk of four i32 is one
// 128-bit vector of each lane type (`bitcast`, little endian); a partial last chunk reads zeros
// past the end, as the references do. Results go back as i32 bits: one array hash per lane type
// and side. Case 0 also multiplies every pair of 8-bit values: a hash of the products per 8-bit
// type, x ascending within y ascending.
import diff;

fn run(a: &[i32], b: &[i32], r: &mut [i32], f: fn(i32x4, i32x4) -> i32x4) {
    let n = a.len();
    let mut i: usize = 0;
    while i + 4 <= n {
        f(i32x4.load(a, i), i32x4.load(b, i)).store(r, i);
        i = i + 4;
    }
    if i < n {
        let m = mask32x4.first_n(n - i);
        f(i32x4.load_masked(a, i, m), i32x4.load_masked(b, i, m)).store_masked(r, i, m);
    }
}

fn hi_i8(x: i32x4, y: i32x4) -> i32x4 {
    return x.bitcast::<i8x16>().mul_hi(y.bitcast::<i8x16>()).bitcast::<i32x4>();
}

fn hi_u8(x: i32x4, y: i32x4) -> i32x4 {
    return x.bitcast::<u8x16>().mul_hi(y.bitcast::<u8x16>()).bitcast::<i32x4>();
}

fn hi_i16(x: i32x4, y: i32x4) -> i32x4 {
    return x.bitcast::<i16x8>().mul_hi(y.bitcast::<i16x8>()).bitcast::<i32x4>();
}

fn hi_u16(x: i32x4, y: i32x4) -> i32x4 {
    return x.bitcast::<u16x8>().mul_hi(y.bitcast::<u16x8>()).bitcast::<i32x4>();
}

fn hi_i32(x: i32x4, y: i32x4) -> i32x4 {
    return x.mul_hi(y);
}

fn hi_u32(x: i32x4, y: i32x4) -> i32x4 {
    return x.bitcast::<u32x4>().mul_hi(y.bitcast::<u32x4>()).bitcast::<i32x4>();
}

fn hi_i64(x: i32x4, y: i32x4) -> i32x4 {
    return x.bitcast::<i64x2>().mul_hi(y.bitcast::<i64x2>()).bitcast::<i32x4>();
}

fn hi_u64(x: i32x4, y: i32x4) -> i32x4 {
    return x.bitcast::<u64x2>().mul_hi(y.bitcast::<u64x2>()).bitcast::<i32x4>();
}

// Element k of xs, 0 past the end.
fn el(xs: &[i32], k: usize) -> u32 {
    return if k < xs.len() then xs[k] as% u32 else 0;
}

// Lane j of `bits` bits of xs's little-endian bytes, zero-extended.
pub fn lane(xs: &[i32], j: usize, bits: usize) -> u64 {
    if bits == 64 {
        return (el(xs, 2 * j) as u64) | ((el(xs, 2 * j + 1) as u64) << 32);
    }
    let per = 32 / bits;
    let sh = ((j % per) * bits) as% u32;
    let w = el(xs, j / per) >> sh;
    if bits == 32 {
        return w as u64;
    }
    return (w & ((1u32 << (bits as% u32)) - 1)) as u64;
}

// Writes the low `bits` bits of v as lane j of r's little-endian bytes; bytes past the end are
// dropped.
pub fn set_lane(r: &mut [i32], j: usize, bits: usize, v: u64) {
    if bits == 64 {
        if 2 * j < r.len() {
            r[2 * j] = (v as% u32) as% i32;
        }
        if 2 * j + 1 < r.len() {
            r[2 * j + 1] = ((v >> 32) as% u32) as% i32;
        }
        return;
    }
    let per = 32 / bits;
    let k = j / per;
    if k >= r.len() {
        return;
    }
    let sh = ((j % per) * bits) as% u32;
    let ones: u32 = if bits == 32 then 4294967295 else (1u32 << (bits as% u32)) - 1;
    let keep = (r[k] as% u32) & ~(ones << sh);
    r[k] = (keep | (((v as% u32) & ones) << sh)) as% i32;
}

// Lanes of `bits` bits in n i32.
pub fn lanes(n: usize, bits: usize) -> usize {
    return (n * 32 + bits - 1) / bits;
}

pub fn ref_i8(a: &[i32], b: &[i32], r: &mut [i32]) -> bool {
    for j in 0..lanes(a.len(), 8) {
        let x = (lane(a, j, 8) as% u8) as% i8;
        let y = (lane(b, j, 8) as% u8) as% i8;
        set_lane(r, j, 8, (x.mul_hi(y) as% u8) as u64);
    }
    return true;
}

pub fn ref_u8(a: &[i32], b: &[i32], r: &mut [i32]) -> bool {
    for j in 0..lanes(a.len(), 8) {
        let x = lane(a, j, 8) as% u8;
        let y = lane(b, j, 8) as% u8;
        set_lane(r, j, 8, x.mul_hi(y) as u64);
    }
    return true;
}

pub fn ref_i16(a: &[i32], b: &[i32], r: &mut [i32]) -> bool {
    for j in 0..lanes(a.len(), 16) {
        let x = (lane(a, j, 16) as% u16) as% i16;
        let y = (lane(b, j, 16) as% u16) as% i16;
        set_lane(r, j, 16, (x.mul_hi(y) as% u16) as u64);
    }
    return true;
}

pub fn ref_u16(a: &[i32], b: &[i32], r: &mut [i32]) -> bool {
    for j in 0..lanes(a.len(), 16) {
        let x = lane(a, j, 16) as% u16;
        let y = lane(b, j, 16) as% u16;
        set_lane(r, j, 16, x.mul_hi(y) as u64);
    }
    return true;
}

// The 32- and 64-bit references also return whether `mul_hi` is `mul_wide`'s high half and the
// low half is `*%`.
pub fn ref_i32(a: &[i32], b: &[i32], r: &mut [i32]) -> bool {
    let mut same = true;
    for j in 0..lanes(a.len(), 32) {
        let x = (lane(a, j, 32) as% u32) as% i32;
        let y = (lane(b, j, 32) as% u32) as% i32;
        let (h, l) = x.mul_wide(y);
        if h != x.mul_hi(y) || l != x *% y {
            same = false;
        }
        set_lane(r, j, 32, (h as% u32) as u64);
    }
    return same;
}

pub fn ref_u32(a: &[i32], b: &[i32], r: &mut [i32]) -> bool {
    let mut same = true;
    for j in 0..lanes(a.len(), 32) {
        let x = lane(a, j, 32) as% u32;
        let y = lane(b, j, 32) as% u32;
        let (h, l) = x.mul_wide(y);
        if h != x.mul_hi(y) || l != x *% y {
            same = false;
        }
        set_lane(r, j, 32, h as u64);
    }
    return same;
}

pub fn ref_i64(a: &[i32], b: &[i32], r: &mut [i32]) -> bool {
    let mut same = true;
    for j in 0..lanes(a.len(), 64) {
        let x = lane(a, j, 64) as% i64;
        let y = lane(b, j, 64) as% i64;
        let (h, l) = x.mul_wide(y);
        if h != x.mul_hi(y) || l != x *% y {
            same = false;
        }
        set_lane(r, j, 64, h as% u64);
    }
    return same;
}

pub fn ref_u64(a: &[i32], b: &[i32], r: &mut [i32]) -> bool {
    let mut same = true;
    for j in 0..lanes(a.len(), 64) {
        let x = lane(a, j, 64);
        let y = lane(b, j, 64);
        let (h, l) = x.mul_wide(y);
        if h != x.mul_hi(y) || l != x *% y {
            same = false;
        }
        set_lane(r, j, 64, h);
    }
    return same;
}

const FNV_START: u64 = 14695981039346656037;
const FNV_PRIME: u64 = 1099511628211;

pub fn all_u8_ref() -> u64 {
    let mut h = FNV_START;
    for y in 0usize..256 {
        for x in 0usize..256 {
            h = (h ^ ((x as% u8).mul_hi(y as% u8) as u64)) *% FNV_PRIME;
        }
    }
    return h;
}

pub fn all_i8_ref() -> u64 {
    let mut h = FNV_START;
    for y in 0usize..256 {
        for x in 0usize..256 {
            let p = ((x as% u8) as% i8).mul_hi((y as% u8) as% i8);
            h = (h ^ ((p as% u8) as u64)) *% FNV_PRIME;
        }
    }
    return h;
}

fn all_u8() -> u64 {
    let mut h = FNV_START;
    let mut out: [u8; 16] = [0; 16];
    let mut idx: [u8; 16] = [0; 16];
    for j in 0usize..16 {
        idx[j] = j as% u8;
    }
    let iota = u8x16.load(&idx, 0);
    for y in 0usize..256 {
        let mut c: usize = 0;
        while c < 256 {
            (iota +% u8x16.splat(c as% u8)).mul_hi(u8x16.splat(y as% u8)).store(&mut out, 0);
            for j in 0usize..16 {
                h = (h ^ (out[j] as u64)) *% FNV_PRIME;
            }
            c = c + 16;
        }
    }
    return h;
}

fn all_i8() -> u64 {
    let mut h = FNV_START;
    let mut out: [u8; 16] = [0; 16];
    let mut idx: [u8; 16] = [0; 16];
    for j in 0usize..16 {
        idx[j] = j as% u8;
    }
    let iota = u8x16.load(&idx, 0);
    for y in 0usize..256 {
        let yy = u8x16.splat(y as% u8).bitcast::<i8x16>();
        let mut c: usize = 0;
        while c < 256 {
            let x = (iota +% u8x16.splat(c as% u8)).bitcast::<i8x16>();
            x.mul_hi(yy).bitcast::<u8x16>().store(&mut out, 0);
            for j in 0usize..16 {
                h = (h ^ (out[j] as u64)) *% FNV_PRIME;
            }
            c = c + 16;
        }
    }
    return h;
}

fn vec_side(o: &mut diff.Out, a: &[i32], b: &[i32], h: diff.Head) {
    let fs: [fn(i32x4, i32x4) -> i32x4; 8] = [hi_i8, hi_u8, hi_i16, hi_u16, hi_i32, hi_u32, hi_i64, hi_u64];
    for k in 0usize..8 {
        let mut r = diff.Buf::<i32>.new(h.len, h.mis, 0);
        run(a, b, r.get_mut(), fs[k]);
        o.i32s(r.get());
        o.flag(diff.guards_i32(&r));
    }
}

fn ref_side(o: &mut diff.Out, a: &[i32], b: &[i32], h: diff.Head) {
    let fs: [fn(&[i32], &[i32], &mut [i32]) -> bool; 8] =
        [ref_i8, ref_u8, ref_i16, ref_u16, ref_i32, ref_u32, ref_i64, ref_u64];
    let mut same = true;
    for k in 0usize..8 {
        let mut r = diff.Buf::<i32>.new(h.len, h.mis, 0);
        if !fs[k](a, b, r.get_mut()) {
            same = false;
        }
        o.i32s(r.get());
        o.flag(true);
    }
    o.flag(same);
}

fn main() -> i32 {
    let mut c = diff.open();
    let mut o = diff.out();
    let n = c.count();
    for k in 0..n {
        let h = c.head();
        let ba = c.i32s(h);
        let bb = c.i32s(h);
        vec_side(&mut o, ba.get(), bb.get(), h);
        o.flag(true);
        if k == 0 {
            o.u(all_i8());
            o.u(all_u8());
        }
        o.sep();
        ref_side(&mut o, ba.get(), bb.get(), h);
        if k == 0 {
            o.u(all_i8_ref());
            o.u(all_u8_ref());
        }
        o.end();
    }
    o.flush();
    return 0;
}

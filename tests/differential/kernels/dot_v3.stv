// The dot products of dot.stv with 256-bit vectors (x86_64-linux-v3), against the same
// references with twice the lanes.
import base;
import diff;

fn dot_f32x8(a: &[f32], b: &[f32]) -> f32 {
    let n = a.len();
    let mut acc = f32x8.splat(0.0);
    let mut i: usize = 0;
    while i + 8 <= n {
        acc = acc + f32x8.load(a, i) * f32x8.load(b, i);
        i = i + 8;
    }
    if i < n {
        let m = mask32x8.first_n(n - i);
        acc = acc + f32x8.load_masked(a, i, m) * f32x8.load_masked(b, i, m);
    }
    return acc.reduce_add();
}

fn dot_f64x4(a: &[f64], b: &[f64]) -> f64 {
    let n = a.len();
    let mut acc = f64x4.splat(0.0);
    let mut i: usize = 0;
    while i + 4 <= n {
        acc = acc + f64x4.load(a, i) * f64x4.load(b, i);
        i = i + 4;
    }
    if i < n {
        let m = mask64x4.first_n(n - i);
        acc = acc + f64x4.load_masked(a, i, m) * f64x4.load_masked(b, i, m);
    }
    return acc.reduce_add();
}

fn dot_i32x8(a: &[i32], b: &[i32]) -> i32 {
    let n = a.len();
    let mut acc = i32x8.splat(0);
    let mut i: usize = 0;
    while i + 8 <= n {
        acc = acc +% (i32x8.load(a, i) *% i32x8.load(b, i));
        i = i + 8;
    }
    if i < n {
        let m = mask32x8.first_n(n - i);
        acc = acc +% (i32x8.load_masked(a, i, m) *% i32x8.load_masked(b, i, m));
    }
    return acc.reduce_add_wrap();
}

// Bytes widened to u16 before the multiply, products widened to u32 before the add.
fn dot_u8x32(a: &[u8], b: &[u8]) -> u32 {
    let n = a.len();
    let mut acc = u32x8.splat(0);
    let mut i: usize = 0;
    while i + 32 <= n {
        acc = acc +% widen_dot(u8x32.load(a, i), u8x32.load(b, i));
        i = i + 32;
    }
    if i < n {
        let m = mask8x32.first_n(n - i);
        acc = acc +% widen_dot(u8x32.load_masked(a, i, m), u8x32.load_masked(b, i, m));
    }
    return acc.reduce_add_wrap();
}

fn widen_dot(x: u8x32, y: u8x32) -> u32x8 {
    let xl: u16x16 = x.widen_lo();
    let xh: u16x16 = x.widen_hi();
    let yl: u16x16 = y.widen_lo();
    let yh: u16x16 = y.widen_hi();
    let pl = xl *% yl;
    let ph = xh *% yh;
    let a: u32x8 = pl.widen_lo();
    let b: u32x8 = pl.widen_hi();
    let c: u32x8 = ph.widen_lo();
    let d: u32x8 = ph.widen_hi();
    return (a +% b) +% (c +% d);
}

fn main() -> i32 {
    let mut c = diff.open();
    let mut o = diff.out();
    let n = c.count();
    for k in 0..n {
        let h = c.head();
        if h.kind == 0 {
            let ba = c.f32s(h);
            let bb = c.f32s(h);
            o.f32(dot_f32x8(ba.get(), bb.get()));
            o.sep();
            o.f32(base.dot_f32_ref(ba.get(), bb.get(), 8));
        } else if h.kind == 1 {
            let ba = c.f64s(h);
            let bb = c.f64s(h);
            o.f64(dot_f64x4(ba.get(), bb.get()));
            o.sep();
            o.f64(base.dot_f64_ref(ba.get(), bb.get(), 4));
        } else if h.kind == 2 {
            let ba = c.i32s(h);
            let bb = c.i32s(h);
            o.i(dot_i32x8(ba.get(), bb.get()) as i64);
            o.sep();
            o.i(base.dot_i32_ref(ba.get(), bb.get()) as i64);
        } else {
            let ba = c.u8s(h);
            let bb = c.u8s(h);
            o.u(dot_u8x32(ba.get(), bb.get()) as u64);
            o.sep();
            o.u(base.dot_u8_ref(ba.get(), bb.get()) as u64);
        }
        o.end();
    }
    o.flush();
    return 0;
}

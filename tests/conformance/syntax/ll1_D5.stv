//~ CHECK-ONLY
// D5: `needs(..)` directly after a fn type binds to that (innermost) fn type.
fn fast() needs(avx2) { }

fn plain() { }

// the returned fn type needs avx2; `pick` itself needs nothing
fn pick() -> fn() needs(avx2) {
    return fast;
}

// parenthesized: `pick_needs` itself needs avx2
fn pick_needs() -> (fn()) needs(avx2) {
    return plain;
}

//~ CHECK-ONLY
// ExternItem: an import block behind its obligation (XParams with `...` last, `without` on an
// import) and export definitions (with `unsafe("..")` and the clause tail of a fn item).
unsafe("puts, printf, and abort as declared in stdio.h and stdlib.h") extern "C" {
    fn puts(s: *const u8) -> i32 without(lock);
    fn printf(f: *const u8, ...) -> i32;
    fn abort() -> never without(alloc, lock, block);
}

extern "C" fn add(a: i32, b: i32) -> i32 {
    return a + b;
}

extern "C" fn add_pos(a: i32, b: i32) -> i32 without(alloc) requires(a >= 0) ensures(result >= b) {
    return a + b;
}

unsafe("p is valid for reads") extern "C" fn peek(p: *const u8) -> u8 {
    return unsafe("the caller guarantees p is valid") *p;
}

unsafe("an empty block declares nothing") extern "C" { }

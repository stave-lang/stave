//~ CHECK-ONLY
//~ TARGET x86_64-linux-v3
// The target baseline counts for E0703 and for the values a body holds: `x86_64-linux-v3` has
// AVX2, so a 256-bit vector fits a signature and a body of any features there.
fn f(v: f32x8) -> f32x8 needs(f16c) {
    return v;
}

fn g() needs(bmi2) {
    let h: fn(f32x8) -> f32x8 = fn(v: f32x8) -> f32x8 { return v; };
}

fn h(xs: &[f32]) -> f32 needs(fma) {
    return f32x8.load(xs, 0).reduce_add();
}

fn main() -> i32 {
    return 0;
}

//~ STDOUT fntype_run_v3.stdout
//~ TARGET x86_64-linux-v3
// The target baseline proves its features: on `x86_64-linux-v3` a fn needing `avx2` is usable
// as a `fn` value without them in any fn, and called through it. Inside it, a closure has its
// needs and drops them the same way.
import std.io;

fn twice(x: u32) -> u32 needs(avx2) {
    let f = fn(y: u32) -> u32 { return y * 2; };
    return apply(f, x);
}

fn apply(f: fn(u32) -> u32, x: u32) -> u32 {
    return f(x);
}

view struct Op {
    f: fn(u32) -> u32,
}

fn main() -> i32 {
    let op = Op.{ f: twice };
    let g: fn(u32) -> u32 = twice;
    let a = apply(twice, 5);
    let b = apply(op.f, 6);
    let c = g(7);
    io.print(f"{a} {b} {c}\n");
    return 0;
}

enum Shape { Circle(f64), Empty }

struct Point { pub x: i32, pub y: i32 }

fn take(p: Point) -> i32 {
    return p.x;
}

fn wrong_param<T>(v: U) -> u8 { //~ ERROR E0101
    return 0;
}

fn no_self() -> Self { //~ ERROR E0101

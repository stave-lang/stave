}

fn main() -> i32 {
    let a: i32 = missing; //~ ERROR E0101
    let b: Nope = 1i32; //~ ERROR E0101
    let c: i32 = undefined_fn(a); //~ ERROR E0101
    let s = Shape.Triangle; //~ ERROR E0101
    let e: i32 = Point.nothing(); //~ ERROR E0101
    let p = Point.{ x: a, y: c };
    let d: i32 = take(p);
    return d;
}

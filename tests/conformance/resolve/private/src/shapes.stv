// The items `main` uses; private ones are used here, so they are not dead.
pub fn area(s: i32) -> i32 {
    return s * s;
}

fn secret() -> i32 {
    return area(7);
}

struct Hidden { v: i32 }

pub struct Square { side: i32 }

impl Square {
    pub fn new(side: i32) -> Square { return Square.{ side: side }; }
    pub fn side(&self) -> i32 { return self.side; }
    fn hidden_new() -> i32 { return Hidden.{ v: secret() }.v; }
}

pub trait Size { fn size(&self) -> u32; }

pub struct Unit {}

impl Size for Unit {
    fn size(&self) -> u32 { return 1; }
}

//~ CHECK-ONLY
// ir golden: `&&` and `||`: right operand, join (value param first).
fn between(x: i32, lo: i32, hi: i32) -> bool {
    return x >= lo && x <= hi;
}

fn outside(x: i32, lo: i32, hi: i32) -> bool {
    return x < lo || x > hi;
}

fn main() -> i32 {
    return if between(3, 1, 5) && !outside(3, 1, 5) then 0 else 1;
}

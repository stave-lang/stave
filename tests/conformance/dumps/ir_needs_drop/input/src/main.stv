//~ CHECK-ONLY
// ir golden: `needs_drop::<T>()` is a constant of each instance, and an `if` on it (or on its
// negation, statement or expression) branches to the taken arm only: the instance for `u32`
// has no loop and no branch on it, in a debug lowering too.
struct Buf<T> {
    pub len: u32,
    pub last: T,
}

fn shrink<T>(b: &mut Buf<T>, n: u32) {
    if needs_drop::<T>() {
        while b.len > n {
            b.len = b.len - 1;
        }
    } else if b.len > n {
        b.len = n;
    }
}

fn plain<T>() -> u32 {
    if !needs_drop::<T>() {
        return 1;
    }
    return 2;
}

fn pick<T>() -> u32 {
    return if needs_drop::<T>() then 3 else 4;
}

fn main() -> i32 {
    let mut b = Buf::<u32>.{ len: 5, last: 0 };
    shrink(&mut b, 2);
    return (b.len + plain::<u32>() + pick::<u32>()) as% i32 - 7;
}

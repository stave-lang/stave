// Stand-in std for the `kinds_` dump goldens: `_lib` plus the marker traits, `std.cell`, and
// `std.sync`, so the kind flags Send, Sync, Flat, Frozen, Drop, and the lock guard have their
// compiler-known items. Small and pinned like `_lib`; `stave test` skips it (leading `_`).
pub enum Option<T> { None, Some(T) }

pub trait Copy {}

pub unsafe("an implementer guarantees that a value of the type may be moved to another thread") trait Send {}

pub unsafe("an implementer guarantees that &Self may be used from several threads at once") trait Sync {}

pub trait Flat {}

pub trait Frozen {}

pub trait Drop {
    fn drop(&mut self);
}

pub trait Write {
    fn write_str(&mut self, s: &str);
}

pub trait Display {
    fn fmt<W: Write>(&self, w: &mut W);
}

impl Display for i32 {
    fn fmt<W: Write>(&self, w: &mut W) {
    }
}

impl Display for str {
    fn fmt<W: Write>(&self, w: &mut W) {
        w.write_str(self);
    }
}

//~ CHECK-ONLY
// A borrow of a temporary with drop glue, stored by a call: the temporary is dropped at the
// end of the statement while the view is used later.
import std.string;

view struct Name { s: &string.String, count: usize }

impl Name {
    fn take(&mut self from x, x: &string.String) {
        self.s = x;
    }
}

fn make() -> string.String {
    return string.String.new();
}

fn main() -> i32 {
    let first: string.String = string.String.new();
    let mut p = Name.{ s: &first, count: 0 };
    p.take(&make()); //~ ERROR E0501
    let n: usize = p.s.len();
    return n as% i32;
}

//~ CHECK-ONLY
// Two pointers split from a `&mut` param through a struct literal hold a reborrow: not
// stored. The caller keeps the source view borrowed all the same.
import std.io;

view struct Cur { cur: &u32, n: u32 }
view struct Two { slot: &mut &u32, n: &u32 }
view struct Wrap { c: &mut Cur }

fn split(w: Wrap) -> Two from w {
    return Two.{ slot: &mut w.c.cur, n: &w.c.n };
}

fn link(dst: &mut Cur from src, src: &mut Cur) {
    let two = split(Wrap.{ c: src });
    *two.slot = two.n; //~ ERROR E0513
}

fn main() -> i32 {
    let zero: u32 = 0;
    let mut a = Cur.{ cur: &zero, n: 5 };
    let mut b = Cur.{ cur: &zero, n: 1 };
    link(&mut a, &mut b);
    let r: &u32 = b.cur; //~ ERROR E0501
    let before: u32 = *r;
    b.n = 2; //~ ERROR E0501
    let after: u32 = *r;
    io.print(f"{before} {after}\n");
    return 0;
}

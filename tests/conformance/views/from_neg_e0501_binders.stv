//~ CHECK-ONLY
// Binders with their own storage: a storing call borrows the binder, the view outlives it. A
// storing call takes its view by `&mut`, which a match guard may not (E0505): the `guard_*`
// fns check that form.
import std.io;

view struct Pick { best: &u32, count: usize }
view struct Pair { a: u32, b: u32 }
struct Own { a: u32, b: u32 }
enum E { A(u32), B(u32, u32) }

impl Pick {
    fn take(&mut self from x, x: &u32) -> bool {
        self.best = x;
        return true;
    }
}

fn next(i: u32) -> u32 {
    return i + 40;
}

fn mk(i: u32) -> Own {
    return Own.{ a: i + 40, b: i };
}

fn mke(i: u32) -> E {
    return E.B(i + 40, i);
}

fn pair(i: u32) -> (u32, u32) {
    return (i + 40, i);
}

fn arm_by_value(zero: &u32) -> u32 {
    let mut p = Pick.{ best: zero, count: 0 };
    let mut i: u32 = 0;
    while i < 2 {
        match next(i) {
            v => { //~ ERROR E0501
                if i == 0 {
                    let _ = p.take(&v);
                }
            }
        }
        i = i + 1;
    }
    return *p.best;
}

fn arm_struct_field(zero: &u32) -> u32 {
    let mut p = Pick.{ best: zero, count: 0 };
    let mut i: u32 = 0;
    while i < 2 {
        match mk(i) {
            Own.{ a, b } => { //~ ERROR E0501
                if i == 0 {
                    let _ = p.take(&a);
                }
            }
        }
        i = i + 1;
    }
    return *p.best;
}

fn arm_enum_field(zero: &u32) -> u32 {
    let mut p = Pick.{ best: zero, count: 0 };
    let mut i: u32 = 0;
    while i < 2 {
        match mke(i) {
            E.B(a, b) => { //~ ERROR E0501
                if i == 0 {
                    let _ = p.take(&a);
                }
            }
            E.A(a) => {}
        }
        i = i + 1;
    }
    return *p.best;
}

// by reference into a scrutinee temporary: the temporary is written again by the next iteration
fn arm_ref_of_temp(zero: &u32) -> u32 {
    let mut p = Pick.{ best: zero, count: 0 };
    let mut i: u32 = 0;
    while i < 2 {
        match &mk(i) { //~ ERROR E0501
            Own.{ a, b } => {
                if i == 0 {
                    let _ = p.take(a);
                }
            }
        }
        i = i + 1;
    }
    return *p.best;
}

fn arm_ref_of_temp_enum(zero: &u32) -> u32 {
    let mut p = Pick.{ best: zero, count: 0 };
    let mut i: u32 = 0;
    while i < 2 {
        match &mke(i) { //~ ERROR E0501
            E.B(a, b) => {
                if i == 0 {
                    let _ = p.take(a);
                }
            }
            E.A(a) => {}
        }
        i = i + 1;
    }
    return *p.best;
}

fn arm_ref_of_tuple_temp(zero: &u32) -> u32 {
    let mut p = Pick.{ best: zero, count: 0 };
    let mut i: u32 = 0;
    while i < 2 {
        match &pair(i) { //~ ERROR E0501
            (a, b) => {
                if i == 0 {
                    let _ = p.take(a);
                }
            }
        }
        i = i + 1;
    }
    return *p.best;
}

fn guard_struct_field(zero: &u32) -> u32 {
    let mut p = Pick.{ best: zero, count: 0 };
    let mut i: u32 = 0;
    while i < 2 {
        match mk(i) {
            Own.{ a, b } if i == 0 && p.take(&a) => {} //~ ERROR E0505
            _ => {}
        }
        i = i + 1;
    }
    return *p.best;
}

fn guard_enum_field(zero: &u32) -> u32 {
    let mut p = Pick.{ best: zero, count: 0 };
    let mut i: u32 = 0;
    while i < 2 {
        match mke(i) {
            E.B(a, b) if i == 0 && p.take(&a) => {} //~ ERROR E0505
            _ => {}
        }
        i = i + 1;
    }
    return *p.best;
}

fn guard_tuple(zero: &u32) -> u32 {
    let mut p = Pick.{ best: zero, count: 0 };
    let mut i: u32 = 0;
    while i < 2 {
        match pair(i) {
            (a, b) if i == 0 && p.take(&a) => {} //~ ERROR E0505
            _ => {}
        }
        i = i + 1;
    }
    return *p.best;
}

fn guard_or(zero: &u32) -> u32 {
    let mut p = Pick.{ best: zero, count: 0 };
    let mut i: u32 = 0;
    while i < 2 {
        match mke(i) {
            E.A(a) | E.B(a, _) if i == 0 && p.take(&a) => {} //~ ERROR E0505
            _ => {}
        }
        i = i + 1;
    }
    return *p.best;
}

fn guard_false_then_arm(zero: &u32) -> u32 {
    let mut p = Pick.{ best: zero, count: 0 };
    let mut i: u32 = 0;
    while i < 2 {
        match next(i) {
            v if p.take(&v) && i == 7 => {} //~ ERROR E0505
            w => {}
        }
        i = i + 1;
    }
    return *p.best;
}

fn guard_nested_match(zero: &u32) -> u32 {
    let mut p = Pick.{ best: zero, count: 0 };
    let mut i: u32 = 0;
    while i < 2 {
        match next(i) {
            v if (match next(v) { w if i == 0 && p.take(&w) => true, _ => false }) => {} //~ ERROR E0505
            _ => {}
        }
        i = i + 1;
    }
    return *p.best;
}

fn guard_nested_outer(zero: &u32) -> u32 {
    let mut p = Pick.{ best: zero, count: 0 };
    let mut i: u32 = 0;
    while i < 2 {
        match next(i) {
            v if (match i { w if w == 0 && p.take(&v) => true, _ => false }) => {} //~ ERROR E0505
            _ => {}
        }
        i = i + 1;
    }
    return *p.best;
}

fn for_range(zero: &u32) -> u32 {
    let mut p = Pick.{ best: zero, count: 0 };
    for i in 0u32..2u32 {
        if i == 0 {
            let _ = p.take(&i);
        }
    } //~ ERROR E0501
    return *p.best;
}

fn for_owned_array(zero: &u32) -> u32 {
    let mut p = Pick.{ best: zero, count: 0 };
    let xs: [u32; 2] = [40, 41];
    for x in xs {
        if x == 40 {
            let _ = p.take(&x);
        }
    } //~ ERROR E0501
    return *p.best;
}

fn for_owned_array_temp(zero: &u32) -> u32 {
    let mut p = Pick.{ best: zero, count: 0 };
    for x in [40u32, 41u32] {
        if x == 40 {
            let _ = p.take(&x);
        }
    } //~ ERROR E0501
    return *p.best;
}

fn for_owned_pairs(zero: &u32) -> u32 {
    let mut p = Pick.{ best: zero, count: 0 };
    let xs: [(u32, u32); 2] = [(40, 0), (41, 1)];
    for (x, k) in xs {
        if k == 0 {
            let _ = p.take(&x);
        }
    } //~ ERROR E0501
    return *p.best;
}

fn let_pattern(zero: &u32) -> u32 {
    let mut p = Pick.{ best: zero, count: 0 };
    let mut i: u32 = 0;
    while i < 2 {
        let (a, b) = pair(i);
        if i == 0 {
            let _ = p.take(&a);
        }
        i = i + 1;
    } //~ ERROR E0501
    return *p.best;
}

fn let_struct_pattern(zero: &u32) -> u32 {
    let mut p = Pick.{ best: zero, count: 0 };
    let mut i: u32 = 0;
    while i < 2 {
        let Own.{ a, b } = mk(i);
        if i == 0 {
            let _ = p.take(&a);
        }
        i = i + 1;
    } //~ ERROR E0501
    return *p.best;
}

fn while_cond_temp(zero: &u32) -> u32 {
    let mut p = Pick.{ best: zero, count: 0 };
    let mut i: u32 = 0;
    while i < 2 && p.take(&next(i)) { //~ ERROR E0501
        i = i + 1;
    }
    return *p.best;
}

fn while_cond_temp_once(zero: &u32) -> u32 {
    let mut p = Pick.{ best: zero, count: 0 };
    let mut i: u32 = 0;
    while (i == 0 && p.take(&next(i))) || i < 2 { //~ ERROR E0501
        i = i + 1;
    }
    return *p.best;
}

fn if_cond_temp(zero: &u32) -> u32 {
    let mut p = Pick.{ best: zero, count: 0 };
    let mut i: u32 = 0;
    while i < 2 {
        if i == 0 && p.take(&next(i)) { //~ ERROR E0501
            i = i + 0;
        }
        i = i + 1;
    }
    return *p.best;
}

fn arg_temp_field(zero: &u32) -> u32 {
    let mut p = Pick.{ best: zero, count: 0 };
    let mut i: u32 = 0;
    while i < 2 {
        if i == 0 {
            let _ = p.take(&mk(i).a); //~ ERROR E0501
        }
        i = i + 1;
    }
    return *p.best;
}

fn arg_temp_tuple_field(zero: &u32) -> u32 {
    let mut p = Pick.{ best: zero, count: 0 };
    let mut i: u32 = 0;
    while i < 2 {
        if i == 0 {
            let _ = p.take(&pair(i).0); //~ ERROR E0501
        }
        i = i + 1;
    }
    return *p.best;
}

fn arg_temp_arith(zero: &u32) -> u32 {
    let mut p = Pick.{ best: zero, count: 0 };
    let mut i: u32 = 0;
    while i < 2 {
        if i == 0 {
            let _ = p.take(&(i + 40)); //~ ERROR E0501
        }
        i = i + 1;
    }
    return *p.best;
}

fn arg_temp_value_if(zero: &u32) -> u32 {
    let mut p = Pick.{ best: zero, count: 0 };
    let mut i: u32 = 0;
    while i < 2 {
        if i == 0 {
            let _ = p.take(&(if i == 0 then 40u32 else 41u32)); //~ ERROR E0501
        }
        i = i + 1;
    }
    return *p.best;
}

fn arg_temp_index(zero: &u32) -> u32 {
    let mut p = Pick.{ best: zero, count: 0 };
    let mut i: u32 = 0;
    while i < 2 {
        if i == 0 {
            let _ = p.take(&[i + 40, i][0]); //~ ERROR E0501
        }
        i = i + 1;
    }
    return *p.best;
}

fn main() -> i32 {
    return 0;
}

//~ CHECK-ONLY
// A borrow of a temporary stored into a view by a call ends with the temporary's statement: the
// view used after it is E0501, whatever the temporary's value is (a call, a field of one, an
// operator, a constant). A value bound to a local first may be stored.
view struct Pick { best: &u32, count: usize }
struct Own { a: u32, b: u32 }

impl Pick {
    fn take(&mut self from x, x: &u32) -> bool {
        self.best = x;
        return true;
    }
}

fn next(i: u32) -> u32 {
    return i + 40;
}

fn mk(i: u32) -> Own {
    return Own.{ a: i + 40, b: i };
}

fn call(zero: &u32) -> u32 {
    let mut p = Pick.{ best: zero, count: 0 };
    let _ = p.take(&next(2)); //~ ERROR E0501
    return *p.best;
}

fn field(zero: &u32) -> u32 {
    let mut p = Pick.{ best: zero, count: 0 };
    let _ = p.take(&mk(3).a); //~ ERROR E0501
    return *p.best;
}

fn branches(zero: &u32, c: bool) -> u32 {
    let mut p = Pick.{ best: zero, count: 0 };
    if c {
        let _ = p.take(&(next(1) + 3)); //~ ERROR E0501
    } else {
        let _ = p.take(&next(9)); //~ ERROR E0501
    }
    return *p.best;
}

fn konst(zero: &u32) -> u32 {
    let mut p = Pick.{ best: zero, count: 0 };
    let mut i: u32 = 0;
    let mut n: u32 = 0;
    while i < 3 {
        let _ = p.take(&7u32); //~ ERROR E0501
        n = n + *p.best + next(i);
        i = i + 1;
    }
    return n;
}

fn bound_first(zero: &u32) -> u32 {
    let v = next(2);
    let mut p = Pick.{ best: zero, count: 0 };
    let _ = p.take(&v);
    return *p.best;
}

fn main() -> i32 {
    return 0;
}

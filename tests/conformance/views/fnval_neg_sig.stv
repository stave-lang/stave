//~ CHECK-ONLY
// Fn values are views: returning a fn-value param needs `from` (E0510; no `from`
// declares the empty origin set), and a by-value fn-value param is a view by value, so
// `from copy` on it is E0521 (origin table). A fn item holds no loan: no `from` needed.
fn noop() { }

fn mk(f: fn() -> u8) -> fn() -> u8 {
    return f; //~ ERROR E0510
}

fn fixed() -> fn() {
    return noop;
}

fn copy_of(f: fn() -> u8) -> fn() -> u8 from copy f { //~ ERROR E0521
    return f;
}

// fine: `from f`; `from copy` through a reference to a fn value; a call through a fn value
// whose result names both the argument and the fn value (a closure may return a borrow of a
// capture)
fn pass(f: fn() -> u8) -> fn() -> u8 from f {
    return f;
}

fn by_ref(f: &fn() -> u8) -> fn() -> u8 from copy f {
    return *f;
}

fn call_ref(f: fn(&u8) -> &u8, x: &u8) -> &u8 from f + x {
    return f(x);
}

// the result of the call also borrows from `f`, which `from x` does not name
fn call_ref_x(f: fn(&u8) -> &u8, x: &u8) -> &u8 from x {
    return f(x); //~ ERROR E0510
}

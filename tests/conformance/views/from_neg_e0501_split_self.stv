//~ CHECK-ONLY
// A `&mut` source moved into a by-value `self` method that splits it:
// the callee can split the pointer it is given and store one part through the other, so the
// view points into itself after the call and stays borrowed for as long as it is used.
import std.io;

view struct Cur { cur: &u32, n: u32 }
view struct Two { slot: &mut &u32, n: &u32 }

trait Splits {
    fn split(self) -> Two from self;
}

impl Splits for &mut Cur {
    fn split(self) -> Two from self {
        return Two.{ slot: &mut self.cur, n: &self.n };
    }
}

fn link(dst: &mut Cur from src, src: &mut Cur) {
    let two = src.split();
    *two.slot = two.n;
}

fn main() -> i32 {
    let zero: u32 = 0;
    let mut a = Cur.{ cur: &zero, n: 5 };
    let mut b = Cur.{ cur: &zero, n: 1 };
    link(&mut a, &mut b);
    let r: &u32 = b.cur; //~ ERROR E0501
    let before: u32 = *r;
    b.n = 2; //~ ERROR E0501
    let after: u32 = *r;
    io.print(f"{before} {after}\n");
    return 0;
}

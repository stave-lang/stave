//~ CHECK-ONLY
// A view that may point into itself after a storing call is not read again: a borrow of the
// local would leave the fn through `b.cur`.
import std.io;

view struct Cur { cur: &u32, n: u32 }
view struct Two { slot: &mut &u32, n: &u32 }

fn split(t: (&mut Cur, u32)) -> Two from t {
    return Two.{ slot: &mut t.0.cur, n: &t.0.n };
}

fn link(dst: &mut Cur from src, src: &mut Cur) {
    let two = split((src, 0u32));
    *two.slot = two.n;
}

fn leak(seed: &u32, v: u32) -> &u32 from seed {
    let mut a = Cur.{ cur: seed, n: 0 };
    let mut b = Cur.{ cur: seed, n: v };
    link(&mut a, &mut b);
    return b.cur; //~ ERROR E0501
//~^ ERROR E0512
}

fn main() -> i32 {
    let zero: u32 = 0;
    let r: &u32 = leak(&zero, 7);
    let before: u32 = *r;
    let other: &u32 = leak(&zero, 9);
    let s: u32 = *other;
    let after: u32 = *r;
    io.print(f"{before} {after} {s}\n");
    return 0;
}

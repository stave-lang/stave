//~ CHECK-ONLY
// Safe C++ catalogue, guards: a guard escaping its scope through a struct field,
// a heap container, a global, or a return without `from`. Stave: E0410, E0411, E0413, E0510.
import std.vec;

view struct Guard { cell: &mut u32 }

struct Pool { g: Guard } //~ ERROR E0410

fn many(gs: vec.Vec<Guard>) { } //~ ERROR E0411

static mut CURRENT: Option<Guard> = Option.None; //~ ERROR E0413

fn ret(c: &mut u32) -> Guard {
    return Guard.{ cell: c }; //~ ERROR E0510
}

// fine: an Option of a guard is a view, kept in a param or local
fn maybe(g: Option<Guard>) { }

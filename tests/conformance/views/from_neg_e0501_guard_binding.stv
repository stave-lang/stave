//~ CHECK-ONLY
// A storing call in a guard: it takes its view by `&mut`, which a guard may not (a guard only
// reads: E0505), so a guard can never store a borrow of its bindings. Reading the binding
// through a borrow is accepted.
view struct Pick { best: &u32, count: usize }
view struct Text { src: &str, n: usize }

impl Pick {
    fn take(&mut self from x, x: &u32) -> bool {
        self.best = x;
        return true;
    }
}

impl Text {
    fn set(&mut self from s, s: &str) -> bool {
        self.src = s;
        return true;
    }
}

fn next(i: u32) -> u32 {
    return i + 40;
}

fn small(x: &u32) -> bool {
    return *x < 100;
}

fn once(zero: &u32) -> u32 {
    let mut p = Pick.{ best: zero, count: 0 };
    match next(1) {
        v if p.take(&v) => {} //~ ERROR E0505
        _ => {}
    }
    return *p.best;
}

fn in_loop(zero: &u32) -> u32 {
    let mut p = Pick.{ best: zero, count: 0 };
    let mut i: u32 = 0;
    while i < 2 {
        match next(i) {
            v if i == 0 && p.take(&v) => {} //~ ERROR E0505
            _ => {}
        }
        i = i + 1;
    }
    return *p.best;
}

fn dead_view(zero: &u32) -> u32 {
    let mut i: u32 = 0;
    let mut n: u32 = 0;
    while i < 2 {
        let mut p = Pick.{ best: zero, count: 0 };
        match next(i) {
            v if p.take(&v) => { //~ ERROR E0505
                n = n + v;
            }
            _ => {}
        }
        i = i + 1;
    }
    return n;
}

fn read_only(zero: &u32) -> u32 {
    let mut i: u32 = 0;
    let mut n: u32 = 0;
    while i < 2 {
        match next(i) {
            v if small(&v) => {
                n = n + v;
            }
            _ => {}
        }
        i = i + 1;
    }
    return n + *zero;
}

fn by_reference(zero: &u32, xs: &[u32; 2]) -> u32 {
    let mut p = Pick.{ best: zero, count: 0 };
    match &xs[0] {
        r if p.take(r) => {} //~ ERROR E0505
        _ => {}
    }
    return *p.best;
}

fn main() -> i32 {
    return 0;
}

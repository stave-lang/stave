//~ CHECK-ONLY
// E0411: a view is never stored in a heap container of std (`Vec`), whether it is a
// reference, a view ADT, a fn value, or an Option or tuple holding one; nor is a `T: view`
// param, at its definition site.
import std.vec;

view struct Lexer { src: &str, pos: usize }

fn refs(v: vec.Vec<&u8>) { } //~ ERROR E0411
fn views(v: vec.Vec<Lexer>) { } //~ ERROR E0411
fn fns(v: vec.Vec<fn()>) { } //~ ERROR E0411
fn opts(v: vec.Vec<Option<&u8>>) { } //~ ERROR E0411
fn tuples(v: &vec.Vec<(u32, &u8)>) { } //~ ERROR E0411
fn generic<T: view>(v: vec.Vec<T>) { } //~ ERROR E0411

// fine: owned elements, and a reference to a Vec of owned elements
fn owned(v: vec.Vec<u8>, w: &vec.Vec<Option<u8>>) { }
fn generic_owned<T>(v: vec.Vec<T>) { }

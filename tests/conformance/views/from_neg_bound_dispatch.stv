//~ CHECK-ONLY
// A storing trait method called through a bound needs the caller's clause; the store reaches
// the caller through a generic fn and through a `dispatch fn`.
view struct Pick { best: &u32, count: usize }

trait Sink {
    fn put(&mut self from x, x: &u32);
}

impl Sink for Pick {
    fn put(&mut self from x, x: &u32) {
        self.best = x;
    }
}

fn feed<T: view + Sink>(t: &mut T from x, x: &u32) {
    t.put(x);
}

fn feed_bad<T: view + Sink>(t: &mut T, x: &u32) {
    t.put(x); //~ ERROR E0513
}

fn put_base(dst: &mut Pick from x, x: &u32) {
    dst.best = x;
}

dispatch fn put_any(dst: &mut Pick from x, x: &u32) { _ => put_base, }

fn bound_caller(zero: &u32) -> u32 {
    let mut p = Pick.{ best: zero, count: 0 };
    let mut i: u32 = 0;
    while i < 2 {
        let x: u32 = i;
        feed(&mut p, &x);
        i = i + 1;
    } //~ ERROR E0501
    return *p.best;
}

fn dispatch_caller(zero: &u32) -> u32 {
    let mut p = Pick.{ best: zero, count: 0 };
    let mut i: u32 = 0;
    while i < 2 {
        let x: u32 = i;
        put_any(&mut p, &x);
        i = i + 1;
    } //~ ERROR E0501
    return *p.best;
}

fn main() -> i32 {
    return 0;
}

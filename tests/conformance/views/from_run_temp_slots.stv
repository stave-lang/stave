//~ STDOUT from_run_temp_slots.stdout
// A borrow of a temporary stored into a view by a call outlives the statement.
import std.io;

view struct Pick { best: &u32, count: usize }
view struct Hold { p: &mut Pick }
struct Own { a: u32, b: u32 }

impl Pick {
    fn take(&mut self from x, x: &u32) -> bool {
        self.best = x;
        return true;
    }
}

fn next(i: u32) -> u32 {
    return i + 40;
}

fn mk(i: u32) -> Own {
    return Own.{ a: i + 40, b: i };
}

fn churn(i: u32) -> u32 {
    let a = next(i) + next(i + 1) * next(i + 2);
    let o = mk(a);
    let t = (next(a), mk(o.a).b, [next(1), next(2), next(3)][1]);
    return t.0 + t.1 + t.2 + o.b;
}

fn one(zero: &u32) -> u32 {
    let mut p = Pick.{ best: zero, count: 0 };
    let _ = p.take(&next(2));
    let x = next(5) + next(6) * next(7);
    let y = mk(x).a + mk(x + 1).b;
    let c = churn(x + y);
    let _ = (next(c), next(c + 1));
    return *p.best;
}

fn two(zero: &u32) -> u32 {
    let mut p = Pick.{ best: zero, count: 0 };
    let _ = p.take(&mk(3).a);
    let x = next(5) + next(6) * next(7);
    let y = mk(x).a + mk(x + 1).b;
    let _ = (next(y), next(y + 1));
    return *p.best;
}

fn three(zero: &u32, c: bool) -> u32 {
    let mut p = Pick.{ best: zero, count: 0 };
    if c {
        let _ = p.take(&(next(1) + 3));
    } else {
        let _ = p.take(&next(9));
    }
    let x = next(5) + next(6) * next(7);
    let y = mk(x).a + mk(x + 1).b;
    let _ = (next(y), next(y + 1));
    return *p.best;
}

fn konst(zero: &u32) -> u32 {
    let mut p = Pick.{ best: zero, count: 0 };
    let mut i: u32 = 0;
    let mut n: u32 = 0;
    while i < 3 {
        let _ = p.take(&7u32);
        n = n + *p.best + next(i);
        i = i + 1;
    }
    return *p.best + n;
}

fn main() -> i32 {
    let zero: u32 = 0;
    let a = one(&zero);
    let b = two(&zero);
    let c = three(&zero, true);
    let d = three(&zero, false);
    let e = konst(&zero);
    io.print(f"{a} {b} {c} {d} {e}\n");
    return 0;
}

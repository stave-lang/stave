//~ CHECK-ONLY
// A gather traps `Bounds` when any index is past the end. Run by the interpreter harness
// (crates/stave-driver/tests/interp_vs_native.rs): exit 101, run_gather_trap.stderr.
import std.io;

fn main() -> i32 {
    let xs: [u32; 6] = [1, 2, 3, 4, 5, 6];
    let ok: [u32; 4] = [5, 0, 5, 1];
    let g = u32x4.gather(&xs, u32x4.load(&ok, 0)).reduce_add_wrap();
    io.print(f"in range: {g}\n");
    let bad: [u32; 4] = [0, 1, 6, 2];
    let h = u32x4.gather(&xs, u32x4.load(&bad, 0)).reduce_add_wrap();
    io.print(f"not reached: {h}\n");
    return 0;
}

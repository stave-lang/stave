//~ CHECK-ONLY
// A turbofish on a built-in method or type-relative built-in that takes no generic arguments is
// E0201 case `type-args`, never ignored. `bitcast`, `to_vec`, `rewiden`, `permute`, `align_to`,
// `size_of`, and `align_of` take one.
fn f(a: i32x4, m: mask32x4, xs: &[f32], x: u32) -> usize {
    let q = a.div_const::<7>(3); //~ ERROR E0201
    let s = a.reduce_add_wrap::<4>(); //~ ERROR E0201
    let v = f32x4.splat::<f32>(1.0); //~ ERROR E0201
    let k = mask32x4.all::<4>(); //~ ERROR E0201
    let n = xs.len::<f32>(); //~ ERROR E0201
    let p = x.popcount::<u32>(); //~ ERROR E0201
    let b = a.bitcast::<u32x4>();
    let w = m.rewiden::<16>();
    let r = a.permute::<[3, 2, 1, 0]>();
    let o = xs.align_to::<16>();
    return size_of::<u64>() + align_of::<u32>();
}


//~ CHECK-ONLY
// A vector in a generic instance's signature needs features covering its width from the
// callee's own `needs` (plus the baseline), like a written one: an instance is compiled with its
// callee's features, whatever its caller has.
fn id<T>(x: T) -> T {
    return x;
}

fn id_wide<T>(x: T) -> T needs(avx2) {
    return x;
}

struct W<T> { v: T }

impl<T: Copy> W<T> {
    pub fn get(&self) -> T {
        return self.v;
    }
}

fn ap<T>(f: fn(T) -> T, x: T) -> T {
    return f(x);
}

fn twice(v: f32x8) -> f32x8 needs(avx2) {
    return v + v;
}

fn wide(v: f32x8) -> f32x8 needs(avx2) {
    let a = id::<f32x8>(v); //~ ERROR E0703
    let b = id_wide::<f32x8>(v);
    let w = W.{ v: v };
    let c = w.get(); //~ ERROR E0703
    let d = ap::<f32x8>(twice, v); //~ ERROR E0703
    let k: u32 = id::<u32>(1);
    return b;
}

fn main() -> i32 {
    return 0;
}

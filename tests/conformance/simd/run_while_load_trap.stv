//~ CHECK-ONLY
// `while i + 3 <= xs.len()` does not cover a 4-lane load at `i`: release builds keep its bounds
// check, and every build traps `Bounds` on the last load. Run by the interpreter harness
// (crates/stave-driver/tests/interp_vs_native.rs): exit 101, run_while_load_trap.stderr.
import std.io;

fn main() -> i32 {
    let xs: [u32; 7] = [1, 2, 3, 4, 5, 6, 7];
    let mut i: usize = 0;
    while i + 3 <= xs.len() {
        let s = u32x4.load(&xs, i).reduce_add_wrap();
        io.print(f"{i}: {s}\n");
        i = i + 4;
    }
    io.print("not reached\n");
    return 0;
}

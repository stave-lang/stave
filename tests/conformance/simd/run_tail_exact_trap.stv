//~ CHECK-ONLY
// `tail exact;` traps `Bounds` after the full chunks when the length is not a multiple of N.
// Run by the interpreter harness (crates/stave-driver/tests/interp_vs_native.rs): exit 101,
// run_tail_exact_trap.stderr.
import std.io;

fn total(xs: &[u32]) -> u32 {
    let mut acc = u32x4.splat(0);
    for v: u32x4 in xs {
        acc = acc +% v;
    } tail exact;
    return acc.reduce_add();
}

fn main() -> i32 {
    let ok: [u32; 8] = [1, 2, 3, 4, 5, 6, 7, 8];
    let a = total(&ok);
    io.print(f"8 lanes: {a}\n");
    let bad: [u32; 6] = [1, 2, 3, 4, 5, 6];
    let b = total(&bad);
    io.print(f"not reached: {b}\n");
    return 0;
}

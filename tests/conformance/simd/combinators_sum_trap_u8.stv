//~ CHECK-ONLY
// std.slice `sum` on u8 traps `Overflow` in a masked tail: 40 elements of 7 pass 255 at element
// 36. crates/stave-driver/tests/interp_vs_native.rs: exit 101, combinators_sum_trap_u8.stderr.
import std.io;

fn main() -> i32 {
    let a: [u8; 40] = [7; 40];
    let ok = (&a[0..36]).sum();
    io.print(f"{ok}\n");
    let s = (&a[0..40]).sum();
    io.print(f"not reached: {s}\n");
    return 0;
}

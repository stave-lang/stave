//~ EXIT 101
//~ STDOUT pos_hints_trap.stdout
//~ STDERR-CONTAINS "panic: Bounds at pos_hints_trap_scalar.stv:14:"
// `x.store_stream(s, i)` traps `Bounds` when `i >= len`; the store before it lands.
import std.io;

fn main() -> i32 {
    let mut xs: [f32; 3] = [1.0, 2.0, 0.0];
    let x: f32 = 3.0;
    x.store_stream(&mut xs, 2);
    let y = xs[2];
    io.print(f"stored {y}\n");
    let i: usize = 3;
    x.store_stream(&mut xs, i);
    io.print("not reached\n");
    return 0;
}

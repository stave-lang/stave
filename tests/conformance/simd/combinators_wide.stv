//~ CHECK-ONLY
// std.slice methods on slices long enough for the 256-bit loops of x86-64 (1 KiB and more: the
// lengths 1 KiB + 0, 1, 7, 8, 9, 15, 16, 17, 31, 32, 33 elements and 1 KiB - 1) and on short ones
// (0, 1, 7, 8, 9, 15, 16, 17, 31, 32, 33), each at start offsets 0..3 (unaligned), against
// element-by-element references: int sums (with lanes that overflow while the running sum does
// not), min, max, find, eq, fill, find_any_byte, copy_from; floats with -0.0 / +0.0 and quiet
// and signaling NaNs with payloads (min / max of a slice with a NaN: the canonical quiet NaN).
// crates/stave-driver/tests/interp_vs_native.rs runs it in the IR interpreter (the 128-bit
// loops), natively (the 256-bit loops where the CPU has AVX2) and under qemu `-cpu Nehalem`,
// against combinators_wide.stdout.
import std.io;
import std.mem;

// The tested lengths for a type whose long slices start at `long` elements.
fn lens(long: usize) -> [usize; 23] {
    let s: [usize; 11] = [0, 1, 7, 8, 9, 15, 16, 17, 31, 32, 33];
    let mut l: [usize; 23] = [0; 23];
    for i in 0usize..11 {
        l[i] = s[i];
        l[i + 11] = long + s[i];
    }
    l[22] = long - 1;
    return l;
}

fn mix(i: usize) -> usize {
    return (i *% 2654435761) % 1000003;
}

fn report(name: &str, cases: usize, bad: &str) {
    io.print(name);
    io.print(f" {cases} cases");
    if bad.len() == 0 { io.print(" ok\n"); } else { io.print(" BAD"); io.print(bad); io.print("\n"); }
}

fn test_u8() {
    let mut a: [u8; 1061] = [0; 1061];
    let mut s: [u8; 1061] = [0; 1061];
    for i in 0usize..1061 {
        a[i] = (mix(i) % 200) as% u8;
        s[i] = if i % 61 == 7 then 3 else 0;
    }
    let ls = lens(1024);
    let mut bad = "";
    let mut cases: usize = 0;
    for o in 0usize..4 {
        for k in 0usize..23 {
            let n = ls[k];
            cases = cases + 1;
            let xs = &a[o..o + n];
            let ss = &s[o..o + n];
            let mut sum: u8 = 0;
            for i in 0..n { sum = sum + ss[i]; }
            if ss.sum() != sum { bad = " sum"; }
            if n == 0 {
                if xs.min().is_some() || xs.max().is_some() { bad = " min/max of empty"; }
                if xs.find(0).is_some() { bad = " find in empty"; }
            } else {
                let mut lo = xs[0];
                let mut hi = xs[0];
                for i in 0..n {
                    if xs[i] < lo { lo = xs[i]; }
                    if xs[i] > hi { hi = xs[i]; }
                }
                if xs.min().unwrap() != lo { bad = " min"; }
                if xs.max().unwrap() != hi { bad = " max"; }
                for p in 0usize..2 {
                    let x = xs[if p == 0 then n / 2 else n - 1];
                    let mut j: usize = 0;
                    while xs[j] != x { j = j + 1; }
                    if xs.find(x).unwrap() != j { bad = " find"; }
                }
            }
            if xs.find(201).is_some() { bad = " find absent"; }
            let mut b = a;
            if !xs.eq(&b[o..o + n]) { bad = " eq"; }
            if n > 0 {
                b[o + n - 1] = b[o + n - 1] +% 1;
                if xs.eq(&b[o..o + n]) { bad = " eq differs"; }
                if xs.eq(&a[o..o + n - 1]) { bad = " eq length"; }
            }
            let mut c = a;
            (&mut c[o..o + n]).fill(5);
            for i in 0usize..1061 {
                let want = if i >= o && i < o + n then 5 else a[i];
                if c[i] != want { bad = " fill"; }
            }
        }
    }
    report("u8", cases, bad);
}

fn test_u16() {
    let mut a: [u16; 549] = [0; 549];
    let mut s: [u16; 549] = [0; 549];
    for i in 0usize..549 {
        a[i] = (mix(i) % 60000) as% u16;
        s[i] = if i % 61 == 7 then 3 else 0;
    }
    let ls = lens(512);
    let mut bad = "";
    let mut cases: usize = 0;
    for o in 0usize..4 {
        for k in 0usize..23 {
            let n = ls[k];
            cases = cases + 1;
            let xs = &a[o..o + n];
            let ss = &s[o..o + n];
            let mut sum: u16 = 0;
            for i in 0..n { sum = sum + ss[i]; }
            if ss.sum() != sum { bad = " sum"; }
            if n == 0 {
                if xs.min().is_some() || xs.max().is_some() { bad = " min/max of empty"; }
                if xs.find(0).is_some() { bad = " find in empty"; }
            } else {
                let mut lo = xs[0];
                let mut hi = xs[0];
                for i in 0..n {
                    if xs[i] < lo { lo = xs[i]; }
                    if xs[i] > hi { hi = xs[i]; }
                }
                if xs.min().unwrap() != lo { bad = " min"; }
                if xs.max().unwrap() != hi { bad = " max"; }
                for p in 0usize..2 {
                    let x = xs[if p == 0 then n / 2 else n - 1];
                    let mut j: usize = 0;
                    while xs[j] != x { j = j + 1; }
                    if xs.find(x).unwrap() != j { bad = " find"; }
                }
            }
            if xs.find(60001).is_some() { bad = " find absent"; }
            let mut b = a;
            if !xs.eq(&b[o..o + n]) { bad = " eq"; }
            if n > 0 {
                b[o + n - 1] = b[o + n - 1] +% 1;
                if xs.eq(&b[o..o + n]) { bad = " eq differs"; }
                if xs.eq(&a[o..o + n - 1]) { bad = " eq length"; }
            }
            let mut c = a;
            (&mut c[o..o + n]).fill(5);
            for i in 0usize..549 {
                let want = if i >= o && i < o + n then 5 else a[i];
                if c[i] != want { bad = " fill"; }
            }
        }
    }
    report("u16", cases, bad);
}

fn test_u32() {
    let mut a: [u32; 293] = [0; 293];
    let mut s: [u32; 293] = [0; 293];
    for i in 0usize..293 {
        a[i] = (mix(i) % 4000000000) as% u32;
        s[i] = if i % 61 == 7 then 3 else 0;
    }
    let ls = lens(256);
    let mut bad = "";
    let mut cases: usize = 0;
    for o in 0usize..4 {
        for k in 0usize..23 {
            let n = ls[k];
            cases = cases + 1;
            let xs = &a[o..o + n];
            let ss = &s[o..o + n];
            let mut sum: u32 = 0;
            for i in 0..n { sum = sum + ss[i]; }
            if ss.sum() != sum { bad = " sum"; }
            if n == 0 {
                if xs.min().is_some() || xs.max().is_some() { bad = " min/max of empty"; }
                if xs.find(0).is_some() { bad = " find in empty"; }
            } else {
                let mut lo = xs[0];
                let mut hi = xs[0];
                for i in 0..n {
                    if xs[i] < lo { lo = xs[i]; }
                    if xs[i] > hi { hi = xs[i]; }
                }
                if xs.min().unwrap() != lo { bad = " min"; }
                if xs.max().unwrap() != hi { bad = " max"; }
                for p in 0usize..2 {
                    let x = xs[if p == 0 then n / 2 else n - 1];
                    let mut j: usize = 0;
                    while xs[j] != x { j = j + 1; }
                    if xs.find(x).unwrap() != j { bad = " find"; }
                }
            }
            if xs.find(4000000001).is_some() { bad = " find absent"; }
            let mut b = a;
            if !xs.eq(&b[o..o + n]) { bad = " eq"; }
            if n > 0 {
                b[o + n - 1] = b[o + n - 1] +% 1;
                if xs.eq(&b[o..o + n]) { bad = " eq differs"; }
                if xs.eq(&a[o..o + n - 1]) { bad = " eq length"; }
            }
            let mut c = a;
            (&mut c[o..o + n]).fill(5);
            for i in 0usize..293 {
                let want = if i >= o && i < o + n then 5 else a[i];
                if c[i] != want { bad = " fill"; }
            }
        }
    }
    report("u32", cases, bad);
}


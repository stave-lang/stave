fn neg_f32(x: f32) -> bool {
    return mem.f32_bits(x) >> 31 == 1;
}

fn test_f32() {
    let z: f32 = 0.0;
    let nans: [u32; 4] = [0x7fc00001, 0xffc00002, 0x7f800001, 0xff800005];
    let mut a: [f32; 293] = [0.0; 293];
    for i in 0usize..293 {
        let m = mix(i) % 50;
        a[i] = if m == 0 then -z else if m == 1 then z else ((m as% u32) as~ f32) * 0.25 - 6.0;
    }
    let ls = lens(256);
    let mut bad = "";
    let mut cases: usize = 0;
    for o in 0usize..4 {
        for k in 0usize..23 {
            let n = ls[k];
            cases = cases + 1;
            let xs = &a[o..o + n];
            if n == 0 {
                if xs.min().is_some() || xs.max().is_some() { bad = " min/max of empty"; }
            } else {
                let mut lo = xs[0];
                let mut hi = xs[0];
                for i in 0..n {
                    let x = xs[i];
                    if x < lo || (x == lo && neg_f32(x)) { lo = x; }
                    if x > hi || (x == hi && !neg_f32(x)) { hi = x; }
                }
                if mem.f32_bits(xs.min().unwrap()) != mem.f32_bits(lo) { bad = " min"; }
                if mem.f32_bits(xs.max().unwrap()) != mem.f32_bits(hi) { bad = " max"; }
                for p in 0usize..2 {
                    let x = xs[if p == 0 then n / 2 else n - 1];
                    let mut j: usize = 0;
                    while xs[j] != x { j = j + 1; }
                    if xs.find(x).unwrap() != j { bad = " find"; }
                }
                // quiet and signaling NaNs of either sign with payloads, one or several, and a
                // slice of NaNs only: min and max give the canonical quiet NaN
                for w in 0usize..5 {
                    let mut q = a;
                    if w < 4 {
                        q[o + n / 2] = mem.f32_from_bits(nans[w]);
                    } else {
                        for i in 0..n { q[o + i] = mem.f32_from_bits(nans[i % 4]); }
                    }
                    if w == 3 {
                        q[o] = mem.f32_from_bits(nans[1]);
                        q[o + n - 1] = mem.f32_from_bits(nans[2]);
                    }
                    let qs = &q[o..o + n];
                    let qlo = mem.f32_bits(qs.min().unwrap());
                    let qhi = mem.f32_bits(qs.max().unwrap());
                    if qlo != 0x7fc00000 || qhi != 0x7fc00000 { bad = " NaN min/max bits"; }
                    if qs.find(mem.f32_from_bits(nans[w % 4])).is_some() { bad = " find NaN"; }
                    if qs.eq(qs) { bad = " eq NaN"; }
                }
                // zeros of both signs only: -0.0 < +0.0
                let mut zs = a;
                for i in 0..n { zs[o + i] = if (i + o) % 3 == 1 then -z else z; }
                let zlo = mem.f32_bits((&zs[o..o + n]).min().unwrap());
                let zhi = mem.f32_bits((&zs[o..o + n]).max().unwrap());
                let has_neg = n > 1 || o % 3 == 1;
                let has_pos = n > 1 || o % 3 != 1;
                if (zlo == mem.f32_bits(-z)) != has_neg || (zhi == mem.f32_bits(z)) != has_pos { bad = " min/max of zeros"; }
            }
            if xs.find(1000.5).is_some() { bad = " find absent"; }
            let mut b = a;
            if !xs.eq(&b[o..o + n]) { bad = " eq"; }
            if n > 0 {
                b[o + n - 1] = b[o + n - 1] + 1.0;
                if xs.eq(&b[o..o + n]) { bad = " eq differs"; }
            }
            let mut c = a;
            (&mut c[o..o + n]).fill(-z);
            for i in 0usize..293 {
                let want = if i >= o && i < o + n then -z else a[i];
                if mem.f32_bits(c[i]) != mem.f32_bits(want) { bad = " fill"; }
            }
        }
    }
    report("f32", cases, bad);
}

fn neg_f64(x: f64) -> bool {
    return mem.f64_bits(x) >> 63 == 1;
}

fn test_f64() {
    let z: f64 = 0.0;
    let nans: [u64; 4] = [0x7ff8000000000001, 0xfff8000000000002, 0x7ff0000000000001, 0xfff0000000000005];
    let mut a: [f64; 165] = [0.0; 165];
    for i in 0usize..165 {
        let m = mix(i) % 50;
        a[i] = if m == 0 then -z else if m == 1 then z else ((m as% u64) as~ f64) * 0.25 - 6.0;
    }
    let ls = lens(128);
    let mut bad = "";
    let mut cases: usize = 0;
    for o in 0usize..4 {
        for k in 0usize..23 {
            let n = ls[k];
            cases = cases + 1;
            let xs = &a[o..o + n];
            if n == 0 {
                if xs.min().is_some() || xs.max().is_some() { bad = " min/max of empty"; }
            } else {
                let mut lo = xs[0];
                let mut hi = xs[0];
                for i in 0..n {
                    let x = xs[i];
                    if x < lo || (x == lo && neg_f64(x)) { lo = x; }
                    if x > hi || (x == hi && !neg_f64(x)) { hi = x; }
                }
                if mem.f64_bits(xs.min().unwrap()) != mem.f64_bits(lo) { bad = " min"; }
                if mem.f64_bits(xs.max().unwrap()) != mem.f64_bits(hi) { bad = " max"; }
                for p in 0usize..2 {
                    let x = xs[if p == 0 then n / 2 else n - 1];
                    let mut j: usize = 0;
                    while xs[j] != x { j = j + 1; }
                    if xs.find(x).unwrap() != j { bad = " find"; }
                }
                // quiet and signaling NaNs of either sign with payloads, one or several, and a
                // slice of NaNs only: min and max give the canonical quiet NaN
                for w in 0usize..5 {
                    let mut q = a;
                    if w < 4 {
                        q[o + n / 2] = mem.f64_from_bits(nans[w]);
                    } else {
                        for i in 0..n { q[o + i] = mem.f64_from_bits(nans[i % 4]); }
                    }
                    if w == 3 {
                        q[o] = mem.f64_from_bits(nans[1]);
                        q[o + n - 1] = mem.f64_from_bits(nans[2]);
                    }
                    let qs = &q[o..o + n];
                    let qlo = mem.f64_bits(qs.min().unwrap());
                    let qhi = mem.f64_bits(qs.max().unwrap());
                    if qlo != 0x7ff8000000000000 || qhi != 0x7ff8000000000000 { bad = " NaN min/max bits"; }
                    if qs.find(mem.f64_from_bits(nans[w % 4])).is_some() { bad = " find NaN"; }
                    if qs.eq(qs) { bad = " eq NaN"; }
                }
                // zeros of both signs only: -0.0 < +0.0
                let mut zs = a;
                for i in 0..n { zs[o + i] = if (i + o) % 3 == 1 then -z else z; }
                let zlo = mem.f64_bits((&zs[o..o + n]).min().unwrap());
                let zhi = mem.f64_bits((&zs[o..o + n]).max().unwrap());
                let has_neg = n > 1 || o % 3 == 1;
                let has_pos = n > 1 || o % 3 != 1;
                if (zlo == mem.f64_bits(-z)) != has_neg || (zhi == mem.f64_bits(z)) != has_pos { bad = " min/max of zeros"; }
            }
            if xs.find(1000.5).is_some() { bad = " find absent"; }
            let mut b = a;
            if !xs.eq(&b[o..o + n]) { bad = " eq"; }
            if n > 0 {
                b[o + n - 1] = b[o + n - 1] + 1.0;
                if xs.eq(&b[o..o + n]) { bad = " eq differs"; }
            }
            let mut c = a;
            (&mut c[o..o + n]).fill(-z);
            for i in 0usize..165 {
                let want = if i >= o && i < o + n then -z else a[i];
                if mem.f64_bits(c[i]) != mem.f64_bits(want) { bad = " fill"; }
            }
        }
    }
    report("f64", cases, bad);
}

// find_any_byte and copy_from (u8, and u64: 8-byte elements copied as bytes).
fn test_bytes() {
    let mut a: [u8; 1064] = [0; 1064];
    let mut a64: [u64; 168] = [0; 168];
    for i in 0usize..1064 { a[i] = (mix(i) % 200) as% u8; }
    for i in 0usize..168 { a64[i] = mix(i) as u64 *% 1000003; }
    let ls = lens(1024);
    let ls64 = lens(128);
    let mut bad = "";
    let mut cases: usize = 0;
    for o in 0usize..4 {
        for k in 0usize..23 {
            let n = ls[k];
            cases = cases + 1;
            let xs = &a[o..o + n];
            let absent: [u8; 2] = [250, 251];
            if xs.find_any_byte(&absent).is_some() { bad = " find_any_byte absent"; }
            if n > 0 {
                let set: [u8; 3] = [251, xs[n - 1], xs[n / 2]];
                let mut j: usize = 0;
                while xs[j] != set[1] && xs[j] != set[2] { j = j + 1; }
                if xs.find_any_byte(&set).unwrap() != j { bad = " find_any_byte"; }
            }
            let mut c: [u8; 1064] = [7; 1064];
            (&mut c[o..o + n]).copy_from(&a[3 - o..3 - o + n]);
            for i in 0usize..1064 {
                let want = if i >= o && i < o + n then a[i + 3 - o - o] else 7;
                if c[i] != want { bad = " copy_from u8"; }
            }
            let m = ls64[k];
            let mut d: [u64; 168] = [9; 168];
            (&mut d[o..o + m]).copy_from(&a64[3 - o..3 - o + m]);
            for i in 0usize..168 {
                let want = if i >= o && i < o + m then a64[i + 3 - o - o] else 9;
                if d[i] != want { bad = " copy_from u64"; }
            }
        }
    }
    report("bytes", cases, bad);
}

fn main() -> i32 {
    test_u8();
    test_u16();
    test_u32();
    test_u64();
    test_i8();
    test_i16();
    test_i32();
    test_i64();
    test_f32();
    test_f64();
    test_bytes();
    return 0;
}

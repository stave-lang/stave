fn test_i8() {
    let mut a: [i8; 1061] = [0; 1061];
    let mut s: [i8; 1061] = [0; 1061];
    for i in 0usize..1061 {
        a[i] = ((mix(i) % 100) as% i8) - 50;
        s[i] = if i % 2 == 0 then 127 else -127;
    }
    let ls = lens(1024);
    let mut bad = "";
    let mut cases: usize = 0;
    for o in 0usize..4 {
        for k in 0usize..23 {
            let n = ls[k];

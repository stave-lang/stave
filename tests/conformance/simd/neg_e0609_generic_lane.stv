}

fn chunks<T: Copy>(xs: &[T]) -> u64 {
    let mut k: u64 = 0;
    for v: vec<T, 4> in xs { //~ ERROR E0609
        k = k + 1;
    } tail scalar (x) {
        k = k + 100;
    }
    return k;
}


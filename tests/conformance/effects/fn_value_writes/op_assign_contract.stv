// A clause callee reaches a static through a fn field a compound assignment changed.
import std.atomic;
import std.core;
import std.io;

static N: atomic.U64 = atomic.U64.new(0);

view struct H {
    f: fn(),
}

impl core.Add for H {
    fn add(self, rhs: Self) -> Self {
        return H.{ f: bump };
    }
}

fn nop() {}

fn bump() {
    let o = N.fetch_add(1);
}

fn sneaky() -> bool {
    let mut h = H.{ f: nop };
    h += H.{ f: nop };
    let k = h.f;
    k();
    return true;
}

fn g(x: u32) -> u32 requires(sneaky()) { //~ ERROR E0211
    return x;
}

fn main() {
    let a = g(1);
    let b = g(2);
    let n = N.load();
    io.print(f"N = {n}\n");
}

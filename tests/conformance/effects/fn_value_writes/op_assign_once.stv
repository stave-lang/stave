// A compound assignment in a `Once` init calls an impl whose fn field call runs the init again.
import std.core;
import std.io;
import std.sync;

static CFG: sync.Once<u32, 1> = sync.Once::<u32, 1>.new();

view struct H {
    f: fn() -> u32,
}

impl core.BitOr for H {
    fn bitor(self, rhs: Self) -> Self {
        let k = self.f;
        let r = k(); //~ ERROR E1402
        return H.{ f: zero };
    }
}

fn zero() -> u32 {
    return 0u32;
}

fn init() -> u32 {
    let mut h = H.{ f: zero };
    h |= H.{ f: zero };
    return 1u32;
}

fn main() -> i32 {
    let t = H.{ f: init };
    let v = *CFG.get_or_init(init);
    io.print(f"{v}\n");
    return 0;
}

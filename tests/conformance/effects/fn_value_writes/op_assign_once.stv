// A compound assignment in a `Once` init makes the fn field call the init again.
import std.core;
import std.io;
import std.sync;

static CFG: sync.Once<u32, 1> = sync.Once::<u32, 1>.new();

view struct H {
    f: fn() -> u32,
}

impl core.BitOr for H {
    fn bitor(self, rhs: Self) -> Self {
        return H.{ f: init };
    }
}

fn zero() -> u32 {
    return 0u32;
}

fn init() -> u32 {
    let mut h = H.{ f: zero };
    h |= H.{ f: zero };
    let k = h.f;
    return k() + 1; //~ ERROR E1402
}

fn main() -> i32 {
    let v = *CFG.get_or_init(init);
    io.print(f"{v}\n");
    return 0;
}

// A compound assignment calls the operator impl, whose call of its `rhs` fn field reaches the
// fn the right operand holds.
import std.core;
import std.io;

view struct H {
    f: fn(),
}

impl Copy for H {}

impl core.Add for H {
    fn add(self, rhs: Self) -> Self {
        let k = rhs.f;
        k();
        return H.{ f: nop };
    }
}

fn nop() {}

fn noisy() {
    io.print("noisy\n");
}

fn quiet() without(io) { //~ ERROR E1401
    let mut h = H.{ f: nop };
    h += H.{ f: noisy };
}

fn main() {
    quiet();
}

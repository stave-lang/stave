// `h += x` (a user `Add` on a struct holding a fn value) writes the fn field through the impl's
// result: calls of the field reach every fn any `H` literal puts there.
import std.core;
import std.io;

view struct H {
    f: fn(),
}

impl core.Add for H {
    fn add(self, rhs: Self) -> Self {
        return H.{ f: noisy };
    }
}

fn nop() {}

fn noisy() {
    io.print("noisy\n");
}

fn quiet() without(io) { //~ ERROR E1401
    let mut h = H.{ f: nop };
    h += H.{ f: nop };
    let g = h.f;
    g();
}

fn main() {
    quiet();
}

// `h += x` calls the operator impl, which calls the fn field of `self`: that reaches every fn
// any `H` literal puts there, so a `without(io)` fn using `+=` is denied.
import std.core;
import std.io;

view struct H {
    f: fn(),
}

impl Copy for H {}

impl core.Add for H {
    fn add(self, rhs: Self) -> Self {
        let k = self.f;
        k();
        return H.{ f: nop };
    }
}

fn nop() {}

fn noisy() {
    io.print("noisy\n");
}

fn quiet() without(io) { //~ ERROR E1401
    let mut h = H.{ f: nop };
    h += H.{ f: nop };
}

fn main() {
    let n = H.{ f: noisy };
    quiet();
}

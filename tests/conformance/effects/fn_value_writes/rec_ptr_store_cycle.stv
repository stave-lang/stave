// A call cycle through a fn value written by `*p`.
import std.io;

fn leaf(n: u64) -> u64 { return 0; }

fn down(n: u64) -> u64 {
    if n == 0 { return 0; }
    let mut f: fn(u64) -> u64 = leaf;
    let p = &mut f;
    *p = down;
    return f(n - 1) + 1; //~ ERROR E1402
}

fn main() -> i32 {
    let d = down(100000000);
    io.print(f"{d}\n");
    return 0;
}

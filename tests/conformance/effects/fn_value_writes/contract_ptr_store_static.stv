// A clause callee reaches a non-Frozen `static` through a fn value written by `*p`.
import std.atomic;
import std.io;

static N: atomic.U64 = atomic.U64.new(0);

fn nop() {}

fn bump() {
    let o = N.fetch_add(1);
}

fn sneaky() -> bool {
    let mut f: fn() = nop;
    let p = &mut f;
    *p = bump;
    f();
    return true;
}

fn g(x: u32) -> u32 requires(sneaky()) { //~ ERROR E0211
    return x;
}

fn main() {
    let a = g(1);
    let b = g(2);
    let n = N.load();
    io.print(f"N = {n}\n");
}

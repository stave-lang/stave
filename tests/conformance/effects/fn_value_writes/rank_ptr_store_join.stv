// Holding rank 1, the fn value written by `*p` joins a thread that takes rank 1.
import std.io;
import std.sync;

fn nop(m: &sync.Mutex<u32, 1>) {}

fn fan(m: &sync.Mutex<u32, 1>) {
    scope {
        spawn {
            let g = m.lock();
        }
    }
}

fn main() {
    let m = sync.Mutex::<u32, 1>.new(0);
    let g = m.lock();
    let mut f: fn(&sync.Mutex<u32, 1>) = nop;
    let p = &mut f;
    *p = fan;
    io.print("joining\n");
    f(&m); //~ ERROR E1405
    io.print("unreachable\n");
}

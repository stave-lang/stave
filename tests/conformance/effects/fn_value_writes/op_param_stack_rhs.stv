// The stack bound counts `big`, which an operator impl calls through its `rhs` fn field.
//~ STDOUT op_param_stack_rhs.stdout
import std.core;
import std.io;

view struct H {
    f: fn() -> u64,
}

fn small() -> u64 {
    return 1u64;
}

fn big() -> u64 {
    let mut buf: [u64; 131072] = [0u64; 131072];
    buf[131071] = 3;
    return buf[131071] + buf[7];
}

impl core.Add for H {
    fn add(self, rhs: Self) -> Self {
        let k = rhs.f;
        let r = k();
        io.print(f"{r}\n");
        return H.{ f: small };
    }
}

fn main() {
    let a = H.{ f: small };
    let b = H.{ f: big };
    let c = a + b;
}

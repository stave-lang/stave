// `h *= H.{ f: noisy }`: the `Mul` impl calls its `rhs` fn field.
import std.core;
import std.io;

view struct H {
    f: fn(),
}

fn nop() {}

fn noisy() {
    io.print("noisy\n");
}

impl core.Mul for H {
    fn mul(self, rhs: Self) -> Self {
        let k = rhs.f;
        k();
        return H.{ f: nop };
    }
}

fn quiet() without(io) { //~ ERROR E1401
    let mut h = H.{ f: nop };
    h *= H.{ f: noisy };
}

fn main() {
    quiet();
}

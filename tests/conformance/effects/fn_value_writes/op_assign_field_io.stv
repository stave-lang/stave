// `o.h += x` on a view field holding the fn wrapper: the impl behind it calls the fn field.
import std.core;
import std.io;

view struct H {
    f: fn(),
}

impl Copy for H {}

impl core.Add for H {
    fn add(self, rhs: Self) -> Self {
        let k = self.f;
        k();
        return H.{ f: nop };
    }
}

view struct O {
    h: H,
}

fn nop() {}

fn noisy() {
    io.print("noisy\n");
}

fn quiet() without(io) { //~ ERROR E1401
    let mut o = O.{ h: H.{ f: nop } };
    o.h += H.{ f: nop };
}

fn main() {
    let n = H.{ f: noisy };
    quiet();
}

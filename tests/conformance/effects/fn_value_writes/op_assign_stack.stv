// The stack bound counts `big`, which the operator impl behind a compound assignment calls
// through the fn field of `self`.
//~ STDOUT op_assign_stack.stdout
import std.core;
import std.io;

view struct H {
    f: fn() -> u64,
}

impl Copy for H {}

impl core.Add for H {
    fn add(self, rhs: Self) -> Self {
        let k = self.f;
        let r = k();
        io.print(f"{r}\n");
        return H.{ f: small };
    }
}

fn small() -> u64 {
    return 1u64;
}

fn big() -> u64 {
    let mut buf: [u64; 131072] = [0u64; 131072];
    buf[131071] = 3;
    return buf[131071] + buf[7];
}

fn main() {
    let mut h = H.{ f: big };
    h += H.{ f: small };
}

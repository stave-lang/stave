// The stack bound counts every fn a compound-assigned fn field can be.
//~ STDOUT op_assign_stack.stdout
import std.core;
import std.io;

view struct H {
    f: fn() -> u64,
}

impl core.Add for H {
    fn add(self, rhs: Self) -> Self {
        return H.{ f: big };
    }
}

fn small() -> u64 {
    return 1u64;
}

fn big() -> u64 {
    let mut buf: [u64; 131072] = [0u64; 131072];
    buf[131071] = 3;
    return buf[131071] + buf[7];
}

fn main() {
    let mut h = H.{ f: small };
    h += H.{ f: small };
    let k = h.f;
    let r = k();
    io.print(f"{r}\n");
}

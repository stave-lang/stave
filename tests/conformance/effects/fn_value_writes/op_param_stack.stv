// The stack bound counts what an operator impl's `rhs` fn field can be.
//~ STDOUT op_param_stack.stdout
import std.core;
import std.io;

view struct H {
    f: fn() -> u64,
}

impl Copy for H {}

impl core.Add for H {
    fn add(self, rhs: Self) -> Self {
        let k = rhs.f;
        let v = k();
        return H.{ f: small };
    }
}

fn small() -> u64 {
    return 1u64;
}

fn big() -> u64 {
    let mut buf: [u64; 131072] = [0u64; 131072];
    buf[131071] = 3;
    return buf[131071] + buf[7];
}

fn main() {
    let a = H.{ f: small };
    let b = H.{ f: big };
    let c = a + b;
    io.print("done\n");
}

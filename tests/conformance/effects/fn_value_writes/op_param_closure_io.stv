// A closure literal in the right operand's fn field; the impl calls it.
import std.core;
import std.io;

view struct H {
    f: fn(),
}

impl Copy for H {}

fn nop() {}

fn noisy() {
    io.print("noisy\n");
}

impl core.BitOr for H {
    fn bitor(self, rhs: Self) -> Self {
        let k = rhs.f;
        k();
        return H.{ f: nop };
    }
}

fn quiet() without(io) { //~ ERROR E1401
    let a = H.{ f: nop };
    let g = a | H.{ f: fn() { noisy(); } };
}

fn main() {
    quiet();
}

// Holding rank 1, an operator impl calls its `rhs` fn field, which takes a rank-1 lock.
import std.core;
import std.sync;

view struct H {
    f: fn(&sync.Mutex<u32, 1>),
}

fn nop(m: &sync.Mutex<u32, 1>) {}

fn take(m: &sync.Mutex<u32, 1>) {
    let g = m.lock();
}

impl core.Add for H {
    fn add(self, rhs: Self) -> Self {
        let m2 = sync.Mutex::<u32, 1>.new(0u32);
        let k = rhs.f;
        k(&m2);
        return H.{ f: nop };
    }
}

fn main() {
    let m = sync.Mutex::<u32, 1>.new(0u32);
    let a = H.{ f: nop };
    let b = H.{ f: take };
    let g = m.lock();
    let c = a + b; //~ ERROR E1405
}

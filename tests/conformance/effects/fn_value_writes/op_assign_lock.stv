// Holding rank 1, a fn field a compound assignment changed re-locks the mutex.
import std.core;
import std.io;
import std.sync;

view struct H {
    f: fn(&sync.Mutex<u32, 1>),
}

impl core.Mul for H {
    fn mul(self, rhs: Self) -> Self {
        return H.{ f: take };
    }
}

fn nop(m: &sync.Mutex<u32, 1>) {}

fn take(m: &sync.Mutex<u32, 1>) {
    let g = m.lock();
}

fn main() {
    let m = sync.Mutex::<u32, 1>.new(0);
    let g = m.lock();
    let mut h = H.{ f: nop };
    h *= H.{ f: nop };
    io.print("relocking\n");
    let k = h.f;
    k(&m); //~ ERROR E1405
    io.print("unreachable\n");
}

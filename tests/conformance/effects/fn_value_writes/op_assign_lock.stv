// Holding rank 1, a compound assignment calls an impl whose fn field call re-locks the mutex.
import std.core;
import std.io;
import std.sync;

static M: sync.Mutex<u32, 1> = sync.Mutex::<u32, 1>.new(0);

view struct H {
    f: fn(),
}

impl core.Mul for H {
    fn mul(self, rhs: Self) -> Self {
        let k = self.f;
        k();
        return H.{ f: nop };
    }
}

fn nop() {}

fn take() {
    let g = M.lock();
}

fn main() {
    let t = H.{ f: take };
    let g = M.lock();
    let mut h = H.{ f: nop };
    io.print("relocking\n");
    h *= H.{ f: nop }; //~ ERROR E1405
    io.print("unreachable\n");
}

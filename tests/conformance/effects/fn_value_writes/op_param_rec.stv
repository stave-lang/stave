// Recursion through an operator impl that calls its `rhs` fn field.
import std.core;
import std.io;

view struct H {
    f: fn(),
}

impl Copy for H {}

fn leaf() {}

fn again() {
    let a = H.{ f: leaf };
    let b = H.{ f: again };
    let c = a + b;
}

impl core.Add for H {
    fn add(self, rhs: Self) -> Self {
        let k = rhs.f;
        k(); //~ ERROR E1402
        return H.{ f: leaf };
    }
}

fn main() {
    again();
    io.print("done\n");
}

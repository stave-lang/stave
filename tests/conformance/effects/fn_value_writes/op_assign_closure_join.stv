// The compound assignment in a closure; the fn value joins a thread that takes rank 1.
import std.core;
import std.io;
import std.sync;

impl core.Add for fn(&sync.Mutex<u32, 1>) {
    fn add(self, rhs: Self) -> Self {
        return fan;
    }
}

fn nop(m: &sync.Mutex<u32, 1>) {}

fn fan(m: &sync.Mutex<u32, 1>) {
    scope {
        spawn {
            let g = m.lock();
        }
    }
}

fn main() {
    let m = sync.Mutex::<u32, 1>.new(0);
    let mut f: fn(&sync.Mutex<u32, 1>) = nop;
    let set = fn() { f += nop; };
    set();
    let g = m.lock();
    io.print("joining\n");
    f(&m); //~ ERROR E1405
    io.print("unreachable\n");
}

// The compound assignment in a closure; the fn field it changes joins a thread that takes rank 1.
import std.core;
import std.io;
import std.sync;

view struct H {
    f: fn(&sync.Mutex<u32, 1>),
}

impl Copy for H {}

impl core.Add for H {
    fn add(self, rhs: Self) -> Self {
        return H.{ f: fan };
    }
}

fn nop(m: &sync.Mutex<u32, 1>) {}

fn fan(m: &sync.Mutex<u32, 1>) {
    scope {
        spawn {
            let g = m.lock();
        }
    }
}

fn main() {
    let m = sync.Mutex::<u32, 1>.new(0);
    let mut h = H.{ f: nop };
    let set = fn() { h += H.{ f: nop }; };
    set();
    let g = m.lock();
    io.print("joining\n");
    let k = h.f;
    k(&m); //~ ERROR E1405
    io.print("unreachable\n");
}

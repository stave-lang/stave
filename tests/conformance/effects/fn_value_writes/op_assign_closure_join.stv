// The compound assignment in a closure; the impl it calls calls a fn field that joins a thread
// taking rank 1.
import std.core;
import std.io;
import std.sync;

static M: sync.Mutex<u32, 1> = sync.Mutex::<u32, 1>.new(0);

view struct H {
    f: fn(),
}

impl Copy for H {}

impl core.Add for H {
    fn add(self, rhs: Self) -> Self {
        let k = self.f;
        k();
        return H.{ f: nop };
    }
}

fn nop() {}

fn fan() {
    scope {
        spawn {
            let g = M.lock();
        }
    }
}

fn main() {
    let t = H.{ f: fan };
    let mut h = H.{ f: nop };
    let set = fn() { h += H.{ f: nop }; };
    let g = M.lock();
    io.print("joining\n");
    set(); //~ ERROR E1405
    io.print("unreachable\n");
}

// A `Once` init evaluates an operator whose impl calls its `rhs` fn field, which holds the init.
import std.core;
import std.io;
import std.sync;

static CFG: sync.Once<u32, 1> = sync.Once::<u32, 1>.new();

view struct H {
    f: fn() -> u32,
}

impl core.Add for H {
    fn add(self, rhs: Self) -> Self {
        let k = rhs.f;
        let v = k(); //~ ERROR E1402
        return H.{ f: zero };
    }
}

fn zero() -> u32 {
    return 0u32;
}

fn init() -> u32 {
    let a = H.{ f: zero };
    let b = H.{ f: init };
    let c = a + b;
    return 1u32;
}

fn main() -> i32 {
    let v = *CFG.get_or_init(init);
    io.print(f"{v}\n");
    return 0;
}

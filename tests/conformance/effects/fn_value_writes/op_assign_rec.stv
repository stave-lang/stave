// Recursion through the fn field the operator impl behind a compound assignment calls.
import std.core;
import std.io;

view struct H {
    f: fn(u64) -> u64,
}

impl core.Sub for H {
    fn sub(self, rhs: Self) -> Self {
        let k = self.f;
        let r = k(0u64); //~ ERROR E1402
        return H.{ f: stop };
    }
}

fn stop(n: u64) -> u64 {
    return n;
}

fn down(n: u64) -> u64 {
    let mut h = H.{ f: stop };
    if n > 0 {
        h -= H.{ f: stop };
    }
    return n;
}

fn main() {
    let t = H.{ f: down };
    let r = down(200000u64);
    io.print(f"{r}\n");
}

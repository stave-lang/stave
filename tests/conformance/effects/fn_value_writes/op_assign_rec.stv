// Recursion through a fn field a compound assignment changed.
import std.core;
import std.io;

view struct H {
    f: fn(u64) -> u64,
}

impl core.Sub for H {
    fn sub(self, rhs: Self) -> Self {
        return H.{ f: down };
    }
}

fn stop(n: u64) -> u64 {
    return n;
}

fn down(n: u64) -> u64 {
    let mut h = H.{ f: stop };
    if n > 0 {
        h -= H.{ f: stop };
    }
    let m = if n > 0 then n - 1 else 0u64;
    let k = h.f;
    return k(m) + 1; //~ ERROR E1402
}

fn main() {
    let r = down(200000u64);
    io.print(f"{r}\n");
}

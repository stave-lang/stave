// A generic `<T: view + core.Add>` adds two fn wrappers; the impl calls its `rhs` fn field.
import std.core;
import std.io;

view struct H {
    f: fn(),
}

fn nop() {}

fn noisy() {
    io.print("noisy\n");
}

impl core.Add for H {
    fn add(self, rhs: Self) -> Self {
        let k = rhs.f;
        k();
        return H.{ f: nop };
    }
}

fn plus<T: view + core.Add>(a: T, b: T) -> T {
    return a + b;
}

fn quiet() without(io) { //~ ERROR E1401
    let a = H.{ f: nop };
    let b = H.{ f: noisy };
    let c = plus(a, b);
}

fn main() {
    quiet();
}

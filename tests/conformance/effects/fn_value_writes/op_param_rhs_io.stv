// An operator call delivers no argument event: the impl's call of its `rhs` fn field reaches
// every fn any `H` literal puts there.
import std.core;
import std.io;

view struct H {
    f: fn(),
}

impl Copy for H {}

impl core.Add for H {
    fn add(self, rhs: Self) -> Self {
        let k = rhs.f;
        k();
        return H.{ f: nop };
    }
}

fn nop() {}

fn noisy() {
    io.print("noisy\n");
}

fn quiet() without(io) { //~ ERROR E1401
    let a = H.{ f: nop };
    let b = H.{ f: noisy };
    let g = a + b;
}

fn main() {
    quiet();
}

// A clause callee uses an operator whose impl calls a fn field holding a fn bumping a static.
import std.atomic;
import std.core;

static N: atomic.U64 = atomic.U64.new(0);

view struct H {
    f: fn(),
}

impl Copy for H {}

fn nop() {}

fn bump() {
    let o = N.fetch_add(1);
}

impl core.Add for H {
    fn add(self, rhs: Self) -> Self {
        let k = rhs.f;
        k();
        return H.{ f: nop };
    }
}

fn sneaky() -> bool {
    let a = H.{ f: nop };
    let b = H.{ f: bump };
    let c = a + b;
    return true;
}

fn g(x: u32) -> u32 requires(sneaky()) { //~ ERROR E0211
    return x;
}

fn main() {
    let r = g(1u32);
}

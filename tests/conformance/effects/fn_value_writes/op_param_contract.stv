// A clause callee uses an operator whose impl calls a fn bumping a static.
import std.atomic;
import std.core;

static N: atomic.U64 = atomic.U64.new(0);

fn nop() {}

fn bump() {
    let o = N.fetch_add(1);
}

impl core.Add for fn() {
    fn add(self, rhs: Self) -> Self {
        rhs();
        return nop;
    }
}

fn sneaky() -> bool {
    let a: fn() = nop;
    let b: fn() = bump;
    let c = a + b;
    return true;
}

fn g(x: u32) -> u32 requires(sneaky()) { //~ ERROR E0211
    return x;
}

fn main() {
    let r = g(1u32);
}

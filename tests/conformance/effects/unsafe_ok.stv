//~ CHECK-ONLY
// `without(unsafe)`: the `unsafe` blocks inside `std` do not count, so `g` may swap through
// `h` and `mem.swap`.
import std.mem;

fn h(a: &mut u32, b: &mut u32) {
    mem.swap(a, b);
}

fn g(a: &mut u32, b: &mut u32) without(unsafe) {
    h(a, b);
}

fn main() {
    let mut a = 1u32;
    let mut b = 2u32;
    g(&mut a, &mut b);
}

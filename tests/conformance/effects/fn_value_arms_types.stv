//~ CHECK-ONLY
// E0201 cases `fn-arms` / `fn-arms-wanted`: value `if` / `match` arms of fn types that differ
// only in `needs` or `without`. An arm keeps its own fn type; a fn item gains a deny clause only
// where it alone is converted. The forms the fixes name are accepted.
fn twice(x: u64) -> u64 {
    return x * 2u64;
}

fn stop(x: u64) -> u64 without(io) {
    return x;
}

fn wide(x: u64) -> u64 needs(avx2) {
    return x + 7u64;
}

fn apply(f: fn(u64) -> u64 without(io), x: u64) -> u64 without(io) {
    return f(x);
}

fn main() {
    let c = true;
    let k = 1u32;
    let a = if c then stop else twice; //~ ERROR E0201
    let b = if c then wide else twice; //~ ERROR E0201
    let r = apply(if c then twice else stop, 3u64); //~ ERROR E0201
    let s = apply(match k {
        0u32 => twice, //~ ERROR E0201
        _ => stop,
    }, 3u64);
    let fa: fn(u64) -> u64 = if c then stop else twice;
    let fb: fn(u64) -> u64 needs(avx2) = if c then wide else twice;
    let g: fn(u64) -> u64 without(io) = twice;
    let fr = apply(if c then g else stop, 3u64);
    let fs = apply(match k {
        0u32 => g,
        _ => stop,
    }, 3u64);
}

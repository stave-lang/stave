//~ CHECK-ONLY
// The mirror of `const_cond_bounds_ok.stv`: in the `String` instance the arm with the test is
// dead, so `xs[i]` keeps its check and can trap (E1401, at the call that instantiates it); with a
// condition that is no constant condition the test does not cover every path either.
import std.string;

const ON: bool = true;

fn g<T>(xs: &[u32], i: usize) -> u32 without(trap) {
    if !needs_drop::<T>() {
        if i >= xs.len() {
            return 0;
        }
    }
    return xs[i];
}

fn uses(xs: &[u32], i: usize) -> u32 {
    return g::<string.String>(xs, i); //~ ERROR E1401
}

fn by_const(xs: &[u32], i: usize) -> u32 without(trap) { //~ ERROR E1401
    if ON {
        if i >= xs.len() {
            return 0;
        }
    }
    return xs[i];
}

fn main() {}

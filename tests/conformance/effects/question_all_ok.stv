//~ EXIT 218
// A fn that denies every effect may create `Result.Err(..)` / `Option.None` and propagate
// them with `?` from callees that deny the same set. The Err and None paths are taken at run time.
enum E { Neg, Big(u32) }

fn check(x: u32) -> Result<u32, E> without(alloc, trap, recursive, lock, unsafe, io, block) {
    if x == 13 { return Result.Err(E.Neg); }
    if x > 100 { return Result.Err(E.Big(x)); }
    return Result.Ok(x);
}

fn twice(a: u32, b: u32) -> Result<u32, E> without(alloc, trap, recursive, lock, unsafe, io, block) {
    let p = check(a)?;
    let q = check(b)?;
    return Result.Ok(p +% q);
}

fn even(a: u32) -> Option<u32> without(alloc, trap, recursive, lock, unsafe, io, block) {
    if (a & 1) != 0 { return Option.None; }
    return Option.Some(a);
}

fn both(a: u32, b: u32) -> Option<u32> without(alloc, trap, recursive, lock, unsafe, io, block) {
    let x = even(a)?;
    let y = even(b)?;
    return Option.Some(x +% y);
}

fn main() -> i32 {
    let mut code: i32 = 0;
    match twice(3, 4) {
        Result.Ok(v) => { code = code + (v as% i32); }
        Result.Err(_) => { code = code + 1000; }
    }
    match twice(5, 200) {
        Result.Ok(_) => { code = code + 1000; }
        Result.Err(e) => {
            match e {
                E.Neg => { code = code + 1000; }
                E.Big(n) => { code = code + (n as% i32); }
            }
        }
    }
    match both(4, 6) {
        Option.Some(v) => { code = code + (v as% i32); }
        Option.None => { code = code + 1000; }
    }
    match both(4, 5) {
        Option.Some(_) => { code = code + 1000; }
        Option.None => { code = code + 1; }
    }
    return code;
}

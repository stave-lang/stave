//~ CHECK-ONLY
// A `requires` implied by the one before it only through the lower end of a type (`0 <= i` for
// a `usize`): `i < xs.len()` gives `xs.len() > 0`, warning E0216 on each fn. The extra params
// move `i` to other value numbers; every one of them gets the type fact.
fn f1(xs: &[u32], i: usize) -> u32 requires(i < xs.len()) requires(xs.len() > 0) { //~ WARNING E0216
    return xs[0];
}

fn f2(k: u8, xs: &[u32], i: usize) -> u32 requires(i < xs.len()) requires(xs.len() > 0) { //~ WARNING E0216
    return xs[0];
}

fn f3(k: u8, j: u8, xs: &[u32], i: usize) -> u32 requires(i < xs.len()) requires(xs.len() > 0) { //~ WARNING E0216
    return xs[0];
}

fn f4(k: u8, j: u8, l: u8, xs: &[u32], i: usize) -> u32 requires(i < xs.len()) requires(xs.len() > 0) { //~ WARNING E0216
    return xs[0];
}

fn main() -> i32 {
    let a: [u32; 4] = [1, 2, 3, 4];
    let xs = &a[0..4];
    let r = f1(xs, 1) + f2(0, xs, 1) + f3(0, 0, xs, 1) + f4(0, 0, 0, xs, 1);
    return if r == 4 then 0 else 1;
}

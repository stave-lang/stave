//~ CHECK-ONLY
// `stave check` lowers a fn with a contract check to decide its checks. A fn stage0 cannot lower
// yet (an `f16` vector literal) gets no contract diagnostics from `check`, and `check` passes
// as it does without the clause; a build reports the gap where it lowers the fn.
fn count(n: u32) -> u32 ensures(result >= 0) {
    let h = f16x8.splat(1.5);
    let _ = h;
    return n;
}

fn main() {
    let k = count(3);
}

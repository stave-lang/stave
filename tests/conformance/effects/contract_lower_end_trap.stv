//~ CHECK-ONLY
// A caller proves `g`'s `requires(xs.len() > 0)` from `i < xs.len()` and the lower end of `i`'s
// type (`0 <= i`), so the call goes to the unchecked entry and the `without(trap)` callers check
// cleanly, whatever value numbers `i` and `xs` get.
fn g(xs: &[u32]) -> u32 requires(xs.len() > 0) {
    return xs[0];
}

fn c1(xs: &[u32], i: usize) -> u32 without(trap) {
    if i < xs.len() { return g(xs); }
    return 0;
}

fn c2(k: u8, xs: &[u32], i: usize) -> u32 without(trap) {
    if i < xs.len() { return g(xs); }
    return 0;
}

fn c3(k: u8, j: u8, xs: &[u32], i: usize) -> u32 without(trap) {
    if i < xs.len() { return g(xs); }
    return 0;
}

fn main() -> i32 {
    let a: [u32; 4] = [1, 2, 3, 4];
    let xs = &a[0..4];
    let r = c1(xs, 1) + c2(0, xs, 1) + c3(0, 0, xs, 1);
    return if r == 3 then 0 else 1;
}

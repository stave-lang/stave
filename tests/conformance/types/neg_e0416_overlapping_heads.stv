//~ CHECK-ONLY
// Copy and Drop exclude each other on every instance: an `impl Drop` is E0416 when some instance
// of its head may be Copy, whichever impl comes first and whichever is the more general.
import std.vec;

struct A<T> { x: T }

impl<T: Copy> Copy for A<T> {}

impl<T> Drop for A<T> { //~ ERROR E0416
    fn drop(&mut self) { }
}

struct B<T> { x: T }

impl Copy for B<u32> {}

impl<T> Drop for B<T> { //~ ERROR E0416
    fn drop(&mut self) { }
}

struct C<T, U> { x: T, y: U }

impl<T: Copy> Copy for C<T, u8> {}

impl<U> Drop for C<u16, U> { //~ ERROR E0416
    fn drop(&mut self) { }
}

struct D<T> { x: T }

impl<T> Drop for D<T> { //~ ERROR E0416
    fn drop(&mut self) { }
}

impl Copy for D<u8> {}

struct G<const N: usize> { x: [u8; N] }

impl Copy for G<4> {}

impl<const N: usize> Drop for G<N> { //~ ERROR E0416
    fn drop(&mut self) { }
}

// No instance has both.
struct E<T> { x: T }

impl Copy for E<u32> {}

impl Drop for E<u64> {
    fn drop(&mut self) { }
}

struct F<T> { x: T }

impl<T: Copy> Copy for F<T> {}

impl Drop for F<vec.Vec<u8>> {
    fn drop(&mut self) { }
}

struct H<T, U> { x: T, y: U }

impl<T: Copy> Copy for H<T, T> {}

impl Drop for H<u8, u16> {
    fn drop(&mut self) { }
}

fn main() -> i32 {
    return 0;
}

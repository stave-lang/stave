//~ CHECK-ONLY
// All compile-time data of a program takes at most 2^30 bytes (contracts/lang-details.md "Size
// limits"): every `static` and `const` counts, file data and zero fill alike, each rounded up to
// its alignment. Fifteen zero statics of 2^26 bytes and one 8 MiB short of it stay under the
// bound (the built-in packages' own consts, about 2 MiB, fit in the rest); the next item passes it and is E0904
// case `total`, once, at that item. The per-item limit holds for each.
type A = [u8; 67108864];

static S0: A = [0; 67108864];
static S1: A = [0; 67108864];
static S2: A = [0; 67108864];
static S3: A = [0; 67108864];
static S4: A = [0; 67108864];
static S5: A = [0; 67108864];
static S6: A = [0; 67108864];
static S7: A = [0; 67108864];
static S8: A = [0; 67108864];
static S9: A = [0; 67108864];
static S10: A = [0; 67108864];
static S11: A = [0; 67108864];
static S12: A = [0; 67108864];
static S13: A = [0; 67108864];
static S14: A = [0; 67108864];
static NEAR: [u8; 58720256] = [0; 58720256];
static LAST: [u8; 16777216] = [1; 16777216]; //~ ERROR E0904
static AFTER: A = [0; 67108864];

fn main() -> i32 {
    return S0[0] as i32 + LAST[0] as i32 + AFTER[1] as i32;
}

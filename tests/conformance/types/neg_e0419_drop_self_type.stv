//~ CHECK-ONLY
// A `Drop` impl's self type is a struct or enum declared in the impl's package: drop glue runs
// the destructors of ADTs only, and a package adds none to another package's types.
import std.vec;

impl Drop for (vec.Vec<u8>, u8) { //~ ERROR E0419
    fn drop(&mut self) { }
}

impl Drop for [vec.Vec<u8>; 2] { //~ ERROR E0419
    fn drop(&mut self) { }
}

impl Drop for &mut u32 { //~ ERROR E0419
    fn drop(&mut self) { }
}

impl Drop for fn(u32) -> u32 { //~ ERROR E0419
    fn drop(&mut self) { }
}

impl Drop for vec.Vec<u16> { //~ ERROR E0419
    fn drop(&mut self) { }
}

impl<T> Drop for Option<T> { //~ ERROR E0419
    fn drop(&mut self) { }
}

impl<T> Drop for T { //~ ERROR E0419
    fn drop(&mut self) { }
}

impl Drop for u64 { //~ ERROR E0419
    fn drop(&mut self) { }
}

// A struct or enum of this package: accepted.
struct S { v: vec.Vec<u8> }

impl Drop for S {
    fn drop(&mut self) { }
}

enum E { A, B(u32) }

impl Drop for E {
    fn drop(&mut self) { }
}

fn main() -> i32 {
    return 0;
}

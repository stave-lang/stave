//~ CHECK-ONLY
// Or-patterns `P1 | P2 =>` in statement and value arms: enum variants, literals, ranges, tuples,
// and struct patterns as alternatives; a guard covers the whole arm; names bound by every
// alternative are usable in the guard and the body. `|` after `=>` or in a guard is the operator.
enum Tok { Plus, Minus, Num(u32), Pair { a: u32, b: u32 }, Eof }

struct Span { pub lo: u32, pub hi: u32 }

fn prec(t: Tok) -> u8 {
    return match t {
        Tok.Plus | Tok.Minus => 1u8,
        Tok.Num(n) | Tok.Pair.{ a: n, b: _ } if n | 1 == 3 => 2u8 | 4u8,
        _ => 0u8,
    };
}

fn class(c: u8) -> u8 {
    match c {
        0 | 1 | 2 => { return 0; }
        48..=57 | 65..=70 | 97..=102 => { return 1; }
        _ => { return 2; }
    }
}

fn letter(c: char, wide: bool) -> bool {
    return match c {
        'a'..='z' | 'A'..='Z' | '_' => true,
        '0'..='9' | '-' if wide => true,
        _ => false,
    };
}

fn sign(x: i64) -> i64 {
    return match x {
        -1 | 1 => x,
        0 => 0,
        _ => 2,
    };
}

fn truth(p: (bool, bool)) -> u32 {
    return match p {
        (true, true) | (false, false) => 0,
        (true, false) | (false, true) => 1,
    };
}

fn edge(s: Span) -> u32 {
    return match s {
        Span.{ lo: 0, hi: n } | Span.{ lo: n, hi: 0 } => n,
        Span.{ lo, hi } => hi - lo,
    };
}

fn by_ref(t: &Tok) -> u32 {
    return match t {
        Tok.Num(n) | Tok.Pair.{ a: _, b: n } => *n,
        Tok.Plus | Tok.Minus | Tok.Eof => 0,
    };
}

fn by_mut_ref(t: &mut Tok) {
    match t {
        Tok.Num(n) | Tok.Pair.{ a: n, b: _ } => { *n = 0; }
        Tok.Plus | Tok.Minus | Tok.Eof => {}
    }
}

fn rebound(t: Tok) -> u32 {
    match t {
        Tok.Num(mut n) | Tok.Pair.{ a: mut n, b: _ } => {
            n = n + 1;
            return n;
        }
        _ => { return 0; }
    }
}

fn nested(o: Option<Tok>) -> u32 {
    return match o {
        Option.Some(Tok.Num(n)) | Option.Some(Tok.Pair.{ a: n, b: 0 }) => match n {
            0 | 1 => 1,
            _ => n,
        },
        Option.Some(_) | Option.None => 0,
    };
}

fn main() -> i32 {
    return 0;
}

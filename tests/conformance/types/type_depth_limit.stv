// One level past the type depth limit (1,000) is E0005 case `type`, however the type gets deep:
// written, through references, by fields of a generic struct, by an alias, in a generic
// instance, and in a family of types a pointer field instantiates without end. Each too deep
// type is reported once, where it is first reached.
struct W<T> {
    pub v: T,
}

struct D0<T> {
    pub x: T,
}

struct D1<T> {
    pub x: D0<D0<T>>,
}

struct D2<T> {
    pub x: D1<D1<T>>,
}

struct D3<T> {
    pub x: D2<D2<T>>,
}

struct D4<T> {
    pub x: D3<D3<T>>,
}


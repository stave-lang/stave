//~ CHECK-ONLY
// Types that share components (`A40`: 41 distinct types, 2^40 leaves) are walked once per
// distinct type: a value of one is moved, taken apart, and matched (exhaustively, also inside
// `Option` and an enum) without reaching a search limit.
// A value of such a type with bytes in its leaves is too large to hold (E0911 `size`).
type A0 = ();
type A1 = (A0, A0);
type A2 = (A1, A1);
type A3 = (A2, A2);
type A4 = (A3, A3);
type A5 = (A4, A4);
type A6 = (A5, A5);
type A7 = (A6, A6);
type A8 = (A7, A7);
type A9 = (A8, A8);
type A10 = (A9, A9);
type A11 = (A10, A10);
type A12 = (A11, A11);
type A13 = (A12, A12);
type A14 = (A13, A13);
type A15 = (A14, A14);
type A16 = (A15, A15);
type A17 = (A16, A16);
type A18 = (A17, A17);
type A19 = (A18, A18);
type A20 = (A19, A19);
type A21 = (A20, A20);
type A22 = (A21, A21);
type A23 = (A22, A22);
type A24 = (A23, A23);
type A25 = (A24, A24);
type A26 = (A25, A25);
type A27 = (A26, A26);
type A28 = (A27, A27);
type A29 = (A28, A28);
type A30 = (A29, A29);
type A31 = (A30, A30);
type A32 = (A31, A31);
type A33 = (A32, A32);
type A34 = (A33, A33);
type A35 = (A34, A34);
type A36 = (A35, A35);
type A37 = (A36, A36);
type A38 = (A37, A37);
type A39 = (A38, A38);
type A40 = (A39, A39);
type B0 = u8;
type B1 = (B0, B0);
type B2 = (B1, B1);
type B3 = (B2, B2);
type B4 = (B3, B3);
type B5 = (B4, B4);
type B6 = (B5, B5);
type B7 = (B6, B6);
type B8 = (B7, B7);
type B9 = (B8, B8);
type B10 = (B9, B9);
type B11 = (B10, B10);
type B12 = (B11, B11);
type B13 = (B12, B12);
type B14 = (B13, B13);
type B15 = (B14, B14);
type B16 = (B15, B15);
type B17 = (B16, B16);
type B18 = (B17, B17);
type B19 = (B18, B18);
type B20 = (B19, B19);
type B21 = (B20, B20);
type B22 = (B21, B21);
type B23 = (B22, B22);
type B24 = (B23, B23);
type B25 = (B24, B24);
type B26 = (B25, B25);
type B27 = (B26, B26);
type B28 = (B27, B27);
type B29 = (B28, B28);
type B30 = (B29, B29);
type B31 = (B30, B30);
type B32 = (B31, B31);
type B33 = (B32, B32);
type B34 = (B33, B33);
type B35 = (B34, B34);
type B36 = (B35, B35);
type B37 = (B36, B36);
type B38 = (B37, B37);
type B39 = (B38, B38);
type B40 = (B39, B39);
enum E<X> {
    One(X),
    Two(X, X),
}

fn take(x: A40) -> u32 {
    let y = x;
    let (a, b) = y;
    match a {
        _ => {}
    }
    let _ = b;
    return 1;
}

fn opt(o: Option<A40>) -> u32 {
    match o {
        Option.Some(_) => {
            return 1;
        }
        Option.None => {
            return 0;
        }
    }
}

fn pick(e: E<A40>) -> u32 {
    match e {
        E.One(_) => {
            return 1;
        }
        E.Two(_, _) => {
            return 2;
        }
    }
}

fn big(x: B40) -> u32 { //~ ERROR E0911
    let _ = x;
    return 0;
}

fn main() -> i32 {
    return 0;
}

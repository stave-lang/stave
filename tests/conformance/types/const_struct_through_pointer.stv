//~ CHECK-ONLY
// A const's value needs the field types only of the structs it holds by value: a struct reached
// through a pointer, or named only for its layout, is no dependency, so a field length may name
// the const (no cycle).
struct Pool {
    nodes: *const Node,
}

struct Node {
    pool: *const Pool,
    data: [u8; PER],
}

const PER: usize = 4096 - size_of::<Pool>();

struct S {
    p: *const T,
    x: u8,
}

struct T {
    a: [u8; B],
}

const A: usize = size_of::<S>();

const B: usize = A;

struct K<const N: usize> {
    a: u8,
}

fn page(x: [u8; PER]) -> [u8; 4088] {
    return x;
}

fn link(x: [u8; B], y: [u8; A]) -> [u8; 16] {
    return x;
}

fn body() -> u32 {
    let a: [u8; PER] = [0; 4088];
    let b = [0u8; PER];
    let c: [u8; 4088] = b;
    let k: K<PER> = K::<4088>.{ a: 1 };
    return 0;
}

fn main() -> i32 {
    return 0;
}

//~ CHECK-ONLY
// `soa.Soa<T>`: T must be a struct (E0910, where the type is written and at calls) and Flat
// (E1407, the bound of its methods); a column is a field of T (E0208 case `column`, also for a
// generic T, which has no fields); the row built-ins are visible in `std.soa` only (E0101);
// `get` copies a row, so it exists only for a Copy row type (E0208 otherwise, as for any method
// of an impl whose bounds fail).
import std.soa;
import std.vec;

struct P {
    pub x: f32,
}

struct Owns {
    pub v: vec.Vec<u8>,
}

enum E { A, B }

fn takes(s: &soa.Soa<u32>) {} //~ ERROR E0910

fn generic<T: Flat>(s: &soa.Soa<T>) -> usize {
    let n = s.len();
    let k = s.x.len(); //~ ERROR E0208
    return n + k;
}

fn main() -> i32 {
    let a = soa.Soa::<u32>.new(); //~ ERROR E0910
    let b = soa.Soa::<E>.new(); //~ ERROR E0910
    let c = soa.Soa::<(u32, f32)>.with_capacity(4); //~ ERROR E0910
    let d = soa.Soa::<Owns>.new(); //~ ERROR E1407
    let mut ps = soa.Soa::<P>.new();
    ps.push(P.{ x: 1.0 });
    let y = ps.y[0]; //~ ERROR E0208
    let len = ps.len; //~ ERROR E0208
    let n = generic(&ps);
    let r = soa_row_size::<P>(); //~ ERROR E0101
    let p = ps.get(0); //~ ERROR E0208
    return 0;
}

//~ CHECK-ONLY
// The `for` source kinds are closed (contracts/lang-details.md §4 `for` sources): each kind with
// up to two reference levels, a generic source, and sources behind view fields. A reference to
// a reference is E0219 `ref-ref`; a type that is no source is E0219 `not-source`.
struct It {
    i: u32,
}

impl It {
    fn next(&mut self) -> Option<u32> {
        if self.i >= 3 {
            return Option.None;
        }
        self.i = self.i + 1;
        return Option.Some(self.i);
    }
}

trait Next {
    fn next(&mut self) -> Option<u32>;
}

view struct V {
    s: &mut [u32],
    it: &mut It,
    rr: &mut &mut It,
    sr: &[u32],
}


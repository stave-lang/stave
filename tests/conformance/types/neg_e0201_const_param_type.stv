//~ CHECK-ONLY
// A const generic param has an unsigned integer type: its args are `u64` values read back in
// that type.
fn b<const N: bool>() -> u32 { //~ ERROR E0201
    if N {
        return 1;
    }
    return 0;
}

fn s<const N: i8>() -> i8 { //~ ERROR E0201
    return N;
}

struct C<const K: char> { x: u8 } //~ ERROR E0201

fn ok<const N: u16>() -> u16 {
    return N;
}

fn main() -> i32 {
    let k: u32 = b::<7>();
    let j: i8 = s::<1>();
    let i: i8 = s::<{-1}>();
    let m: u16 = ok::<65535>();
    return 0;
}

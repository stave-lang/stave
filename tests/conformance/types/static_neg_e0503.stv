//~ CHECK-ONLY
// E0503: a `static` is immutable. Assigning to it or to a part of it, borrowing it with
// `&mut`, and calling a `&mut self` method on it are errors, inside `unsafe(..)` too.
import std.atomic;
import std.sync;

struct Pt { pub x: u32, pub y: u32 }

impl Pt {
    pub fn bump(&mut self) { self.x = self.x + 1; }
    pub fn sum(&self) -> u32 { return self.x + self.y; }
}

static N: u32 = 1;
static P: Pt = Pt.{ x: 1, y: 2 };
static T: [u8; 2] = [1, 2];
static M: sync.Mutex<u32, 1> = sync.Mutex::<u32, 1>.new(0);
static C: atomic.U32 = atomic.U32.new(0);

fn takes(r: &mut u32) { *r = 0; }

fn main() -> i32 {
    N = 2; //~ ERROR E0503
    N += 1; //~ ERROR E0503
    P.x = 3; //~ ERROR E0503
    T[0] = 9; //~ ERROR E0503
    (P).y = 4; //~ ERROR E0503
    let r: &mut u32 = &mut N; //~ ERROR E0503
    takes(&mut P.y); //~ ERROR E0503
    P.bump(); //~ ERROR E0503
    let g: &mut u32 = M.get_mut(); //~ ERROR E0503
    unsafe("no obligation makes a `static` writable") { N = 3; } //~ ERROR E0503
    // reads, `&`, and `&self` methods are fine
    let s = P.sum() + N;
    let q: &Pt = &P;
    let old = C.swap(s);
    M.with_lock(fn(v: &mut u32) { *v = 1; });
    return 0;
}

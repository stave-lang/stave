//~ CHECK-ONLY
// Shifts: the amount has the left operand's type; a constant amount >= the bit width is
// E0205; `<<%` masks the amount instead.
fn shifts(x: u32, y: u64, n: u32) -> u64 {
    let a: u32 = x << 3;
    let b: u64 = y >> 63;
    let c: u32 = x << 40; //~ ERROR E0205
    let d: u32 = x <<% 40;
    let e: u32 = x << n;
    let f: u64 = y << 64; //~ ERROR E0205
    let g: u8 = 1 << 8; //~ ERROR E0205
    let h: u8 = 1 << 7;
    let mut m: u16 = 1;
    m <<= 15;
    m <<= 16; //~ ERROR E0205
    let wrong: u64 = y << n; //~ ERROR E0201
    return b;
}

fn main() -> i32 {
    return 0;
}

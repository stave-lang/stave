//~ CHECK-ONLY
// Consts of nested arrays, tuples, and structs have values: an array length or another const
// reads their parts by index, tuple element, and field. An operation that overflows in one, or
// an index past the end of a part, is E0203 where the evaluation meets it.
struct P {
    b: usize,
    a: usize,
}

struct W {
    a: [u8; N],
    p: P,
}

const N: usize = 2;

const V: W = W.{ p: P.{ a: 7, b: 8 }, a: [1, 2] };

const B: [[u8; 3]; 2] = [[0u8; 3]; 2];

const C: [u8; 3] = B[1];

const D: ((u8, [usize; 2]), bool) = ((1, [5, 6]), true);

const Z: (u8, u8) = if D.1 then (1, 2) else (3, 4);

const R: [(u8, u16); 3] = [(1, 2); 3];

const F: [[u16; 2]; 2] = [[1, 2], [3, 4]];

const O: [[u8; 2]; 1] = [[200 + 100, 1]]; //~ ERROR E0203

const T: (u8, u8) = (255 + 1, 0); //~ ERROR E0203

const Q: P = P.{ a: 0 - 1, b: 0 }; //~ ERROR E0203

const Y: usize = D.0.1[2]; //~ ERROR E0203

// each step in order: the first index past the end stops it before the next index is evaluated
const Y2: u16 = F[2][0 - 1]; //~ ERROR E0203

fn fields(x: [u8; V.a[1] as usize], y: [u8; V.p.a], z: [u8; V.p.b]) -> [u8; 17] {
    return [0; V.p.a + V.p.b + V.a[1] as usize];
}

fn parts(x: [u8; C[2] as usize + 1], y: [u8; D.0.1[1]], z: [u8; Z.1 as usize]) -> [u8; 1] {
    return [0; R[2].1 as usize - F[0][1] as usize + 1];
}

fn literal(x: [u8; [[1usize, 2], [3, 4]][1][1]], y: [u8; (3usize, 4u8).0]) -> u32 {
    return 0;
}

fn past(x: [u8; F[2][0] as usize]) -> u32 { //~ ERROR E0203
    return 0;
}

fn main() -> i32 {
    return 0;
}

//~ CHECK-ONLY
// Compile-time data takes at most 2^26 bytes whatever its shape (contracts/lang-details.md
// "Size limits"): each tuple a const-expr builds is checked on its type before it is built,
// so doubling consts stop at the limit (C26: 2^26 bytes) with one E0904 `size` at the first
// literal past it, without building the value. A const used twice is one value.
type T0 = u8;
const C0: T0 = 1;
type T1 = (T0, T0);
const C1: T1 = (C0, C0);
type T2 = (T1, T1);
const C2: T2 = (C1, C1);
type T3 = (T2, T2);
const C3: T3 = (C2, C2);
type T4 = (T3, T3);
const C4: T4 = (C3, C3);
type T5 = (T4, T4);
const C5: T5 = (C4, C4);
type T6 = (T5, T5);
const C6: T6 = (C5, C5);
type T7 = (T6, T6);
const C7: T7 = (C6, C6);
type T8 = (T7, T7);
const C8: T8 = (C7, C7);
type T9 = (T8, T8);
const C9: T9 = (C8, C8);
type T10 = (T9, T9);
const C10: T10 = (C9, C9);
type T11 = (T10, T10);
const C11: T11 = (C10, C10);
type T12 = (T11, T11);
const C12: T12 = (C11, C11);
type T13 = (T12, T12);
const C13: T13 = (C12, C12);
type T14 = (T13, T13);
const C14: T14 = (C13, C13);
type T15 = (T14, T14);
const C15: T15 = (C14, C14);
type T16 = (T15, T15);
const C16: T16 = (C15, C15);
type T17 = (T16, T16);
const C17: T17 = (C16, C16);
type T18 = (T17, T17);
const C18: T18 = (C17, C17);
type T19 = (T18, T18);
const C19: T19 = (C18, C18);
type T20 = (T19, T19);
const C20: T20 = (C19, C19);
type T21 = (T20, T20);
const C21: T21 = (C20, C20);
type T22 = (T21, T21);
const C22: T22 = (C21, C21);
type T23 = (T22, T22);
const C23: T23 = (C22, C22);
type T24 = (T23, T23);
const C24: T24 = (C23, C23);
type T25 = (T24, T24);
const C25: T25 = (C24, C24);
type T26 = (T25, T25);
const C26: T26 = (C25, C25);
type T27 = (T26, T26);
const C27: T27 = (C26, C26); //~ ERROR E0904

// a static of tuples of 64 MiB arrays: 4 GiB, past the limit at the first pair
type A0 = [u8; 67108864];
const Z0: A0 = [0; 67108864];
type A1 = (A0, A0);
static Z1: A1 = (Z0, Z0); //~ ERROR E0904

// at the limit and one byte under it
static AT: (A0, ()) = (Z0, ());
static UNDER: ([u8; 67108862], u8) = ([0; 67108862], 1);

fn main() -> i32 {
    return 0;
}

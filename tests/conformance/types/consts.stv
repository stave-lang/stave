//~ CHECK-ONLY
// const-exprs: literals, consts, arithmetic, comparisons, `as`, `size_of`/`align_of`,
// `if then else`, aggregate literals. Calls, loops, and non-const items are E0904; a const that
// depends on itself is E0904 case `cycle`.
struct Pair { pub a: u8, pub b: u64 }

const N: usize = 4;
const M: usize = N * 2 + size_of::<Pair>();
const BIG: bool = M > 10;
const PICK: u32 = if BIG then 1 else 2;
const TABLE: [u16; 3] = [1, 2, 3];
const PAIR: Pair = Pair.{ a: 1, b: 2 };
const TUP: (u8, i64) = (1, -2);
const CAST: u8 = 300u32 as% u8;
const ARR: [u8; N] = [0u8; N];
const FIRST: u16 = TABLE[0];

fn f() -> u32 { return 1; }

const CALLS: u32 = f(); //~ ERROR E0904
const LOOPS: u32 = fn() -> u32 { loop { } }; //~ ERROR E0904
//~^ ERROR E0201
const A: u32 = B + 1; //~ ERROR E0904
const B: u32 = A + 1;
const OVER: u8 = 255 + 1; //~ ERROR E0203

fn main() -> i32 {
    let a: [u32; M] = [0u32; M];
    return 0;
}

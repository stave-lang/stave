//~ CHECK-ONLY
// The drop of `W<T>` drops a `W<Option<T>>`: drop glue instantiates without end. The type
// checker's instantiation chains follow calls only; the call graph stops at its limit and the
// program is rejected rather than checked on an incomplete graph.
struct W<T> {
    pub v: T,
}

impl<T> Drop for W<T> {
    fn drop(&mut self) {
        let w = W::<Option<T>>.{ v: Option.None }; //~ ERROR E0902
    }
}

fn main() -> i32 {
    let w = W::<u32>.{ v: 1u32 };
    return 0;
}

//~ CHECK-ONLY
// Accepted `extern` forms (E0811): a `"C"` import block with its obligation (one string covers
// every declaration in it), and exports with or without `unsafe("..")` (the caller's obligation).
unsafe("puts and abs as declared in stdio.h and stdlib.h") extern "C" {
    fn puts(s: *const u8) -> i32;
    fn abs(x: i32) -> i32 without(alloc, io, lock, block);
}

pub unsafe("p points to a readable byte") extern "C" fn first(p: *const u8) -> u8 {
    return unsafe("the caller guarantees a readable byte at p") *p;
}

extern "C" fn add(a: i32, b: i32) -> i32 without(alloc) requires(a >= 0) ensures(result >= b) {
    return a + b;
}

fn main() -> i32 {
    let x: u8 = 7;
    let a = unsafe("x is a readable byte") first(&x as *const u8);
    let b = add(1, 2);
    let c = unsafe("abs has no precondition") abs(-3);
    return 0;
}

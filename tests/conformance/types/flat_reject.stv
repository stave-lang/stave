//~ CHECK-ONLY
// E1407: a `Flat` bound given a type that is not Flat. Each disqualifier, at the type itself
// (case `self`) and behind a field chain, array element, tuple element, enum payload, or type
// argument. A view under a `Flat` bound is E1407, not the view diagnostics.
import std.atomic;
import std.cell;
import std.string;
import std.sync;
import std.vec;

struct Raw {
    pub p: *const u8,
}

struct Outer {
    pub n: u32,
    pub inner: Raw,
}

enum Msg {
    Quit,
    Data(u32, Raw),
    Named { len: u32, at: Outer },
}

struct Pair<A, B> {
    pub a: A,
    pub b: B,
}

struct Tag<T> {
    pub raw: u32,
}

struct Handle {
    pub id: u32,
}

impl Drop for Handle {
    fn drop(&mut self) {}
}

struct Holds {
    pub h: [Handle; 2],
}

view struct Cursor {
    pub at: &u32,
}

struct Buf<T: Flat> {
    pub v: T,
}

fn need<T: Flat>() {}

fn unbounded<T>() {
    need::<T>(); //~ ERROR E1407
}

fn copy_is_not_flat<T: Copy>() {
    need::<T>(); //~ ERROR E1407
}

fn main() -> i32 {
    need::<&u32>(); //~ ERROR E1407
    need::<&mut u32>(); //~ ERROR E1407
    need::<*const u8>(); //~ ERROR E1407
    need::<*mut u64>(); //~ ERROR E1407
    need::<fn(u32) -> u32>(); //~ ERROR E1407
    need::<Cursor>(); //~ ERROR E1407
    need::<Option<&u32>>(); //~ ERROR E1407
    need::<cell.UnsafeCell<u32>>(); //~ ERROR E1407
    need::<cell.Cell<u32>>(); //~ ERROR E1407
    need::<atomic.U32>(); //~ ERROR E1407
    need::<sync.Mutex<u32>>(); //~ ERROR E1407
    need::<Handle>(); //~ ERROR E1407
    need::<Holds>(); //~ ERROR E1407
    need::<vec.Vec<u32>>(); //~ ERROR E1407
    need::<string.String>(); //~ ERROR E1407
    need::<Raw>(); //~ ERROR E1407
    need::<Outer>(); //~ ERROR E1407
    need::<[[Outer; 2]; 3]>(); //~ ERROR E1407
    need::<(u32, Raw)>(); //~ ERROR E1407
    need::<Msg>(); //~ ERROR E1407
    need::<(u32, fn(u32) -> u32)>(); //~ ERROR E1407
    need::<Pair<u32, *const u8>>(); //~ ERROR E1407
    need::<Tag<*const u8>>(); //~ ERROR E1407
    need::<Option<Raw>>(); //~ ERROR E1407
    let x: u32 = 7;
    let b = Buf.{ v: &x as *const u32 }; //~ ERROR E1407
    return 0;
}

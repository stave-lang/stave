import std.atomic;
import std.io;
import std.mem;

static LIMIT: u32 = 100;
static CALLS: atomic.U64 = atomic.U64.new(0);

fn count() -> u64 {
    return CALLS.fetch_add(1) + 1;      // fetch_add returns the previous value
}

fn halt() -> never {
    loop { }
}

fn checked(x: u32) -> u32 {
    if x <= LIMIT { return x; }
    halt();
}


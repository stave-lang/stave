//~ STDOUT select_words.stdout
// `select` of aggregates is word by word: sizes with 4/2/1-byte tails, values longer than 16
// words (with and without a tail), one longer than 64 words (a counted loop over the words),
// string literals and fn values as operands, a constant condition, and selects inside a loop
// whose values cross blocks.
import std.io;

fn sum_u8<const N: usize>(xs: &[u8; N]) -> u32 {
    let mut s: u32 = 0;
    for i in 0..xs.len() {
        s = s +% (xs[i] as u32) *% ((i + 1) as% u32);
    }
    return s;
}

fn fill<const N: usize>(base: u8) -> [u8; N] {
    let mut xs: [u8; N] = [0; N];
    for i in 0..N {
        xs[i] = base +% (i as% u8);
    }
    return xs;
}

fn pick6(c: bool) -> u32 {
    let r = c.select(fill::<6>(1), fill::<6>(50));
    return sum_u8(&r);
}

fn pick7(c: bool) -> u32 {
    let r = c.select(fill::<7>(1), fill::<7>(50));
    return sum_u8(&r);
}

fn pick13(c: bool) -> u32 {
    let r = c.select(fill::<13>(1), fill::<13>(50));
    return sum_u8(&r);
}

fn pick136(c: bool) -> u32 {
    let r = c.select(fill::<136>(1), fill::<136>(50));
    return sum_u8(&r);
}

fn pick141(c: bool) -> u32 {
    let r = c.select(fill::<141>(1), fill::<141>(50));
    return sum_u8(&r);
}

fn pick_wide(c: bool) -> u32 {
    let r = c.select(fill::<563>(1), fill::<563>(50));
    return sum_u8(&r);
}

fn pick_u16s(c: bool) -> u16 {
    let a: [u16; 9] = [1, 2, 3, 4, 5, 6, 7, 8, 9];
    let b: [u16; 9] = [10, 20, 30, 40, 50, 60, 70, 80, 90];
    let r = c.select(a, b);
    return r[0] + r[8];
}

fn word(c: bool) -> &str {
    return c.select("yes", "no");
}

fn inc(x: u32) -> u32 {
    return x + 1;
}

fn dec(x: u32) -> u32 {
    return x - 1;
}

fn main() -> i32 {
    for k in 0u32..2 {
        let c = k == 1;
        let a = pick6(c);
        let b = pick7(c);
        let d = pick13(c);
        let e = pick136(c);
        let f = pick141(c);
        let g = pick_u16s(c);
        let w = pick_wide(c);
        io.print(f"{a} {b} {d} {e} {f} {g} {w}\n");
        io.print(word(c));
        io.print("\n");
        let fi: fn(u32) -> u32 = inc;
        let fd: fn(u32) -> u32 = dec;
        let h = c.select(fi, fd);
        let hv = h(10);
        let t = true.select(k, 7);
        let u = false.select(k, 7);
        io.print(f"{hv} {t} {u}\n");
    }
    let mut lo: u64 = 18446744073709551615;
    let mut hi: u64 = 0;
    let mut acc: f64 = 0.0;
    for i in 0u64..10 {
        let x = (i *% 7919) % 31;
        lo = (x < lo).select(x, lo);
        hi = (x > hi).select(x, hi);
        let fx = x as~ f64;
        acc = (fx > acc).select(fx, acc);
    }
    io.print(f"{lo} {hi} {acc}\n");
    return 0;
}

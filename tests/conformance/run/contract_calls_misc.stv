//~ STDOUT contract_calls_misc.stdout
// Calls of fns with a `requires` in other shapes: a method (the receiver is the first argument),
// an instance of a generic fn behind a compare of two constants (dead: no error, never run), and
// a clause with `+` on a `usize` under the same guard in the caller.
import std.io;

const K: usize = 0;

struct Grid {
    w: u32,
}

impl Grid {
    fn cell(&self, i: u32) -> u32 without(trap) requires(i < 8) {
        return i +% self.w;
    }
}

fn first<const N: usize>(xs: &[u32; N]) -> u32 requires(N > 0) {
    return xs[0];
}

fn method(g: &Grid) -> u32 without(trap) {
    return g.cell(3);
}

fn next(xs: &[u32], i: usize) -> u32 requires(i + 1 < xs.len()) {
    return xs[i + 1];
}

fn limit(xs: &[u32], i: usize) -> u32 {
    if i + 1 < xs.len() {
        return next(xs, i);
    }
    return 0;
}

fn main() -> i32 {
    let e: [u32; 0] = [];
    let v: [u32; 3] = [7, 8, 9];
    let g = Grid.{ w: 1 };
    let mut a: u32 = 0;
    if K > 0 {
        a = first::<0>(&e);
    }
    let b = method(&g) + limit(&v, 1) + limit(&v, 2);
    io.print(f"{a} {b}\n");
    return 0;
}

//~ STDOUT subslice.stdout
// `&xs[a..b]` and `&xs[a..=b]` borrow elements `a` up to `b` (exclusive / inclusive) of an
// array or slice; writes through `&mut xs[a..b]` change the parent.
import std.io;

fn sum(xs: &[u32]) -> u32 {
    let mut s: u32 = 0;
    for i in 0..xs.len() {
        s += xs[i];
    }
    return s;
}

fn fill(xs: &mut [u32], v: u32) {
    for i in 0..xs.len() {
        xs[i] = v;
    }
}

fn mid(xs: &[u32]) -> &[u32] from xs {
    return &xs[1..xs.len() - 1];
}

fn bump_tail(xs: &mut [u32], at: usize) -> u32 {
    let t = &mut xs[at..xs.len()];
    t[0] += 100;
    return sum(&xs[0..at]);
}

fn main() -> i32 {
    let mut a: [u32; 6] = [1, 2, 3, 4, 5, 6];
    let s = &a[1..4];
    let n = s.len();
    let first = s[0];
    let part = sum(&a[1..4]);
    io.print(f"len {n} first {first} sum {part}\n");
    let incl = sum(&a[1..=4]);
    let whole = sum(&a[0..6]);
    let tail_empty = a[6..6].len();
    let incl_empty = a[3..=2].len();
    let nested = a[1..5][1..3][1];
    io.print(f"incl {incl} whole {whole} empty {tail_empty} {incl_empty} nested {nested}\n");
    fill(&mut a[2..4], 9);
    a[4..6][1] = 7;
    for i in 0..a.len() {
        let x = a[i];
        io.print(f"{x};");
    }
    io.print("\n");
    let all: &mut [u32] = &mut a;
    let head = bump_tail(all, 5);
    let m = mid(all);
    let ml = m.len();
    let mf = m[0];
    let ms = sum(&m[0..=ml - 1]);
    io.print(f"mid {ml} {mf} {ms}\n");
    let last = a[5];
    io.print(f"head {head} last {last}\n");
    let mut c: [u32; 3] = [0, 0, 0];
    let set = fn(v: u32) { fill(&mut c[1..3], v); };
    set(4);
    let c0 = c[0];
    let c2 = c[2];
    io.print(f"closure {c0} {c2}\n");
    return 0;
}

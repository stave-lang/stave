// A call chain without recursion, eight frames of 32 KiB each, runs on main and on a spawned
// thread with the stack the compiler computed for each: the bound wins over `[run] stack`,
// which is 64 KiB here (stack_rec is the same chain with a `rec fn`, which keeps `[run] stack`
// and overflows).
import std.io;

fn f0(x: u64) -> u64 {
    let mut buf: [u64; 4096] = [0u64; 4096];
    let i = (x % 4096) as usize;
    buf[i] = x;
    return buf[i] + 1;
}

fn f1(x: u64) -> u64 {
    let mut buf: [u64; 4096] = [0u64; 4096];
    let i = (x % 4096) as usize;
    buf[i] = x;
    return f0(buf[i]) + 1;
}

fn f2(x: u64) -> u64 {
    let mut buf: [u64; 4096] = [0u64; 4096];
    let i = (x % 4096) as usize;
    buf[i] = x;
    return f1(buf[i]) + 1;
}

fn f3(x: u64) -> u64 {
    let mut buf: [u64; 4096] = [0u64; 4096];
    let i = (x % 4096) as usize;
    buf[i] = x;
    return f2(buf[i]) + 1;
}

fn f4(x: u64) -> u64 {
    let mut buf: [u64; 4096] = [0u64; 4096];
    let i = (x % 4096) as usize;
    buf[i] = x;
    return f3(buf[i]) + 1;
}

fn f5(x: u64) -> u64 {
    let mut buf: [u64; 4096] = [0u64; 4096];
    let i = (x % 4096) as usize;
    buf[i] = x;
    return f4(buf[i]) + 1;
}

fn f6(x: u64) -> u64 {
    let mut buf: [u64; 4096] = [0u64; 4096];
    let i = (x % 4096) as usize;
    buf[i] = x;
    return f5(buf[i]) + 1;
}

fn f7(x: u64) -> u64 {
    let mut buf: [u64; 4096] = [0u64; 4096];
    let i = (x % 4096) as usize;
    buf[i] = x;
    return f6(buf[i]) + 1;
}

fn main() {
    let a = f7(1u64);
    let mut b: u64 = 0;
    scope {
        spawn { b = f7(100u64); }
    }
    io.print(f"main {a}\nspawn {b}\n");
}

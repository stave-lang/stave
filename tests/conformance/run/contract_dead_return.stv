//~ STDOUT contract_dead_return.stdout
// A check the facts refute at a return no execution reaches is no error ("fails whenever
// reached" says nothing there): behind facts that contradict each other (`b1`, `d1`, `p2`; in
// `d2` the proof needs the contradiction many times and the check is removed), behind a call
// that cannot return (`asserted`, `stopped`), or behind a branch on two constants (`constant`).
import std.debug;
import std.io;

fn b1(x: u32) -> u32 requires(x < 10) ensures(result > 0) {
    if x >= 10 {
        return 0;
    }
    return x + 1;
}

fn d1(x: u32) -> u32 ensures(result > 0) {
    if x > 5 {
        if x < 3 {
            return 0;
        }
    }
    return 1;
}

fn p2(n: u32) -> u32 ensures(result > 0) {
    let mut i: u32 = 0;
    while i < n {
        if i >= n {
            return 0;
        }
        i += 1;
    }
    return 1;
}

fn d2(x: u32) -> u32 requires(x < 10) ensures(result > 20) {
    if x >= 10 {
        return x;
    }
    return 25;
}

fn asserted(x: u32) -> u32 ensures(result > 0) {
    if x == 0 {
        debug.assert(false, "x must not be 0");
        return 0;
    }
    return x;
}

fn stop() {
    loop {
    }
}

fn stopped(x: u32) -> u32 ensures(result > 0) {
    if x == 0 {
        stop();
        return 0;
    }
    return x;
}

fn constant(x: u32) -> u32 ensures(result > 0) {
    if 3u32 < 2u32 {
        return 0;
    }
    return x + 1;
}

fn main() -> i32 {
    let (a, b, c, d) = (b1(3), d1(4), p2(3), d2(4));
    let (e, f, g) = (asserted(3), stopped(3), constant(3));
    io.print(f"{a} {b} {c} {d} {e} {f} {g}\n");
    return 0;
}

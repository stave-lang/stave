//~ ARGS --release
//~ STDOUT opt_index_past_length_untaken.stdout
// A read past the end of an array value on a path that never runs: the program runs to its end.
import std.io;

fn at(a: [u32; 4], i: usize) -> u32 {
    return a[i];
}

fn main() -> i32 {
    let a: [u32; 4] = [1, 2, 3, 4];
    if a[0] == 7 {
        let v = at(a, 4);
        io.print(f"{v}\n");
    }
    io.print("ok\n");
    return 0;
}

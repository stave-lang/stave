//~ EXIT 101
//~ STDERR-CONTAINS "panic: Bounds at soa_get_bounds.stv:16:"
//~ STDERR-CONTAINS "in main.main (thread 0)"
// `Soa.get` past the length panics `Bounds` at the caller.
import std.soa;

struct P {
    pub v: u32,
}

impl Copy for P {}

fn main() -> i32 {
    let mut ps = soa.Soa::<P>.new();
    ps.push(P.{ v: 1 });
    let p = ps.get(1);
    return 0;
}

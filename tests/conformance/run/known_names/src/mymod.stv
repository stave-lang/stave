pub fn alloc(n: u32) -> u32 {
    return n * 10;
}

pub fn try_alloc(size: usize, al: usize) -> usize {
    return size + al;
}

pub fn free(p: usize, size: usize, al: usize) -> usize {
    return p - size - al;
}

pub fn copy_raw(dst: &mut [u8], src: &[u8], n: usize) {
    for i in 0..n {
        dst[i] = src[i];
    }
}

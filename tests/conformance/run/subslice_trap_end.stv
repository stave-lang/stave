//~ EXIT 101
//~ STDOUT subslice_trap_end.stdout
//~ STDERR-CONTAINS "panic: Bounds at subslice_trap_end.stv:10:16 in main.window (thread 0)"
// `xs[a..b]` with `b > len` traps `Bounds` before any element is read; `b == len` is the
// whole tail.
import std.io;
import std.vec;

fn window(xs: &[u64], a: usize, b: usize) -> u64 {
    let w = &xs[a..b];
    let mut s: u64 = 0;
    for i in 0..w.len() {
        s += w[i];
    }
    return s;
}

fn main() -> i32 {
    let mut v = vec.Vec::<u64>.new();
    v.push(10);
    v.push(20);
    v.push(30);
    let s = window(v.as_slice(), 1, 3);
    io.print(f"tail {s}\n");
    let t = window(v.as_slice(), 1, 4);
    io.print("not reached\n");
    return 0;
}

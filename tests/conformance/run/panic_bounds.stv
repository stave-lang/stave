//~ EXIT 101
//~ STDERR-CONTAINS "panic: Bounds at panic_bounds.stv:5:13 in main.pick (thread 0)"
// An array index out of range traps with Bounds at the `[`; the index counts past the end.
fn pick(a: [u32; 4], i: usize) -> u32 {
    return a[i];
}

fn main() -> i32 {
    let a: [u32; 4] = [10, 20, 30, 40];
    let mut sum: u32 = 0;
    for i in 0usize..8 {
        sum = sum + pick(a, i);
    }
    return 0;
}

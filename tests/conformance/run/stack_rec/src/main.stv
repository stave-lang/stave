// stack_bound's call chain with `f4` a `rec fn` that calls itself (never at run time): main
// reaches a call cycle, so its stack has no computed bound; it gets `[run] stack` (64 KiB) plus
// the bound of the chain with the cycle collapsed, and the chain (eight frames of 32 KiB) runs.
import std.io;

fn f0(x: u64) -> u64 {
    let mut buf: [u64; 4096] = [0u64; 4096];
    let i = (x % 4096) as usize;
    buf[i] = x;
    return buf[i] + 1;
}

fn f1(x: u64) -> u64 {
    let mut buf: [u64; 4096] = [0u64; 4096];
    let i = (x % 4096) as usize;
    buf[i] = x;
    return f0(buf[i]) + 1;
}

fn f2(x: u64) -> u64 {
    let mut buf: [u64; 4096] = [0u64; 4096];
    let i = (x % 4096) as usize;
    buf[i] = x;
    return f1(buf[i]) + 1;
}

fn f3(x: u64) -> u64 {
    let mut buf: [u64; 4096] = [0u64; 4096];
    let i = (x % 4096) as usize;
    buf[i] = x;
    return f2(buf[i]) + 1;
}

rec fn f4(x: u64) -> u64 {
    let mut buf: [u64; 4096] = [0u64; 4096];
    let i = (x % 4096) as usize;
    buf[i] = x;
    if x > 1000000000 {
        return f4(x - 1);
    }
    return f3(buf[i]) + 1;
}

fn f5(x: u64) -> u64 {
    let mut buf: [u64; 4096] = [0u64; 4096];
    let i = (x % 4096) as usize;
    buf[i] = x;
    return f4(buf[i]) + 1;
}

fn f6(x: u64) -> u64 {
    let mut buf: [u64; 4096] = [0u64; 4096];
    let i = (x % 4096) as usize;
    buf[i] = x;
    return f5(buf[i]) + 1;
}

fn f7(x: u64) -> u64 {
    let mut buf: [u64; 4096] = [0u64; 4096];
    let i = (x % 4096) as usize;
    buf[i] = x;
    return f6(buf[i]) + 1;
}

fn main() {
    let a = f7(1u64);
    io.print(f"main {a}\n");
}

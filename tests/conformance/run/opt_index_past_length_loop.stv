//~ STDERR-CONTAINS "panic: Bounds at opt_index_past_length_loop.stv:11:17 in main.f (thread 0)"
// The one value of the loop variable is 4, past the end of the `[u32; 4]`: once the loop's block
// param is that constant, the read still traps.
import std.io;

fn f(a: [u32; 4]) -> u32 {
    for i in 4..5usize {
        return a[i];
    }
    return 0;
}

fn main() -> i32 {
    let a: [u32; 4] = [1, 2, 3, 4];
    io.print("before\n");
    return f(a) as% i32;
}

//~ EXIT 101
//~ STDERR-CONTAINS "panic: Bounds at soa_col_bounds.stv:14:"
// A column holds `len` values, not `capacity`: an index at `len` panics `Bounds`.
import std.soa;

struct P {
    pub v: u32,
}

fn main() -> i32 {
    let mut ps = soa.Soa::<P>.with_capacity(8);
    ps.push(P.{ v: 1 });
    let a = ps.v[0];
    let b = ps.v[1];
    return 0;
}

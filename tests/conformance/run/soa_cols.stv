//~ STDOUT soa_cols.stdout
// std.soa: records stored as columns. push / set / get / pop / len, a loop over one column
// slice, and cols_mut to read one column while writing another.
import std.io;
import std.soa;

fn main() -> i32 {
    let mut ps = soa.Soa3::<f32, f32, u32>.new();
    for i in 0u32..10 {
        let x = i as~ f32;
        ps.push(x, x * 2.0, i);
    }
    let mut s0: f32 = 0.0;
    {
        let xs0 = ps.col0();
        for i in 0..xs0.len() { s0 = s0 + xs0[i]; }
    }
    {
        let (xs, ys, ids) = ps.cols_mut();
        for i in 0..ids.len() { ys[i] = xs[i] + 1.0; }
    }
    let (x1, y1, i1) = ps.get(1);
    ps.set(0, 100.0, 200.0, 7);
    let (a, b, c) = ps.get(0);
    let (pa, pb, pc) = ps.pop().unwrap();
    let n = ps.len();
    let (ra, rb, rc) = ps.get_ref(1);
    let r1 = *rc;
    io.print(f"{s0} {x1} {y1} {i1}\n");
    io.print(f"{a} {b} {c}\n");
    io.print(f"{pa} {pb} {pc} {n}\n");
    io.print(f"{r1}\n");
    return 0;
}

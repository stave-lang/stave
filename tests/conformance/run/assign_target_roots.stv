//~ STDOUT assign_target_roots.stdout
// An assignment target is a place rooted in a local, a `static`, or a dereference: a local and
// its parts, `*r`, a part reached through a `&mut` a call returned. A `&mut` of a temporary is a
// borrow, not a target: a `&mut self` call on a temporary, a `&mut` part passed to a fn, and a
// write through `*&mut` reach the temporary, which the statement then drops.
import std.io;

struct S {
    pub a: u32,
}

impl S {
    fn bump(&mut self) -> u32 {
        self.a += 1;
        return self.a;
    }
}

fn arr() -> [u32; 2] {
    return [1, 2];
}

fn set(p: &mut u32) {
    *p = 9;
}

fn field(s: &mut S) -> &mut S from s {
    return s;
}

fn main() -> i32 {
    let mut s = S.{ a: 1 };
    s.a = 2;
    s.a *= 3;
    let mut xs = [1u32, 2u32];
    xs[1] = 5;
    let r = &mut s;
    r.a += 1;
    *r = S.{ a: r.a + 1 };
    field(&mut s).a = 10;
    *&mut arr()[0] = 5;
    set(&mut arr()[1]);
    let x = S.{ a: 1 }.bump();
    let a = s.a;
    let b = xs[1];
    io.print(f"{a} {b} {x}\n");
    return 0;
}

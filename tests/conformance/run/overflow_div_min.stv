//~ EXIT 101
//~ STDERR-CONTAINS "panic: Overflow at overflow_div_min.stv:5:14 in main.quot (thread 0)"
// `MIN / -1` traps with Overflow (the quotient 2^31 is not an i32); the divisor counts up to -1.
fn quot(a: i32, b: i32) -> i32 {
    return a / b;
}

fn main() -> i32 {
    let m: i32 = -2147483648;
    let mut d: i32 = -3;
    for i in 0u32..5 {
        let q = quot(m, d);
        d = d + 1;
    }
    return 0;
}

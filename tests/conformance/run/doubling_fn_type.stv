//~ STDOUT doubling_fn_type.stdout
//~ EXIT 0
// A fn type that shares components (`F40 = fn(F39, F39) -> F39`: 41 distinct types, 2^40
// leaves) builds and runs: every walk over it, in the checker, the lowering, and the back
// ends, visits each distinct type once.
import std.io;

type F0 = u8;
type F1 = fn(F0, F0) -> F0;
type F2 = fn(F1, F1) -> F1;
type F3 = fn(F2, F2) -> F2;
type F4 = fn(F3, F3) -> F3;
type F5 = fn(F4, F4) -> F4;
type F6 = fn(F5, F5) -> F5;
type F7 = fn(F6, F6) -> F6;
type F8 = fn(F7, F7) -> F7;
type F9 = fn(F8, F8) -> F8;
type F10 = fn(F9, F9) -> F9;
type F11 = fn(F10, F10) -> F10;
type F12 = fn(F11, F11) -> F11;
type F13 = fn(F12, F12) -> F12;
type F14 = fn(F13, F13) -> F13;
type F15 = fn(F14, F14) -> F14;
type F16 = fn(F15, F15) -> F15;
type F17 = fn(F16, F16) -> F16;
type F18 = fn(F17, F17) -> F17;
type F19 = fn(F18, F18) -> F18;
type F20 = fn(F19, F19) -> F19;
type F21 = fn(F20, F20) -> F20;
type F22 = fn(F21, F21) -> F21;
type F23 = fn(F22, F22) -> F22;
type F24 = fn(F23, F23) -> F23;
type F25 = fn(F24, F24) -> F24;
type F26 = fn(F25, F25) -> F25;
type F27 = fn(F26, F26) -> F26;
type F28 = fn(F27, F27) -> F27;
type F29 = fn(F28, F28) -> F28;
type F30 = fn(F29, F29) -> F29;
type F31 = fn(F30, F30) -> F30;
type F32 = fn(F31, F31) -> F31;
type F33 = fn(F32, F32) -> F32;
type F34 = fn(F33, F33) -> F33;
type F35 = fn(F34, F34) -> F34;
type F36 = fn(F35, F35) -> F35;
type F37 = fn(F36, F36) -> F36;
type F38 = fn(F37, F37) -> F37;
type F39 = fn(F38, F38) -> F38;
type F40 = fn(F39, F39) -> F39;

fn hold(f: F40, g: Option<F40>, h: (F40, F39)) -> u32 {
    let a = f;
    let _ = a;
    let _ = g;
    let (x, y) = h;
    let _ = x;
    let _ = y;
    return 3;
}

fn main() -> i32 {
    io.print("3\n");
    return 0;
}

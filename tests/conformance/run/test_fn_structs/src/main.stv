// `test fn` parameters of struct type: each field is generated by the rules of its own type, edge
// values meet across the flattened fields, and a comparison of an int field with a constant in
// `requires` is a range. As a conformance run test, `main` runs.
import std.debug;
import std.io;
import geo;

struct Point {
    x: i32,
    y: i32,
}

struct Tag {
    id: u8,
    on: bool,
}

struct Rect {
    lo: Point,
    hi: Point,
    tag: Tag,
}

struct Empty {}

struct Pair<T> {
    a: T,
    b: T,
}

struct Buf {
    bytes: [u8; 4],
    n: u16,
}

fn width(r: &Rect) -> i64 {
    return (r.hi.x as i64) - (r.lo.x as i64);
}

fn main() -> i32 {
    let r = Rect.{ lo: Point.{ x: 1, y: 2 }, hi: Point.{ x: 4, y: 6 }, tag: Tag.{ id: 0, on: true } };
    let w = width(&r);
    let c = geo.Cell.{ row: 2, col: 3 };
    let s = c.row + c.col;
    io.print(f"width: {w}\ncell: {s}\n");
    return 0;
}

// Nested structs, and a struct without fields.
test fn nested(r: Rect, e: Empty) {
    let w = width(&r);
    debug.assert(w <= 4294967295 && w >= -4294967295, "an i32 difference fits");
    debug.assert((r.tag.id as u32) < 256, "u8 field");
}

// Comparisons of int fields with constants are ranges: no input is skipped.
test fn field_ranges(p: Point, t: Tag) requires(p.x >= -3 && p.x <= 3 && t.id < 10) requires(p.y == 7) {
    debug.assert(p.x >= -3 && p.x <= 3, "x in -3..=3");
    debug.assert(p.y == 7, "y is 7");
    debug.assert(t.id < 10, "id below 10");
}

// Any other clause on fields filters.
test fn field_filter(p: Point) requires(p.x != p.y) {
    debug.assert(p.x != p.y, "the filter holds");
}

// A generic struct and a struct of another module.
test fn generic_and_imported(q: Pair<u16>, c: geo.Cell) requires(c.row < 8 && q.a <= 300) {
    debug.assert(c.row < 8, "row bound");
    debug.assert(q.a <= 300, "a bound");
}

// Structs in arrays, slices, and tuples.
test fn containers(bs: [Buf; 2], ps: &[Point], t: (Tag, bool)) requires(ps.len() <= 3) {
    debug.assert(bs[0].bytes.len() == 4 && bs[1].n <= 65535, "an array of structs");
    debug.assert(ps.len() <= 3, "a slice of structs");
    debug.assert((t.0.id as u32) < 256, "a struct in a tuple");
}

//~ ARGS --release
//~ EXIT 101
//~ STDOUT opt_index_past_length.stdout
//~ STDERR-CONTAINS "panic: Bounds at opt_index_past_length.stv:11:13 in main.at (thread 0)"
// `at(a, 4)` reads past the end of a `[u32; 4]` value: the access traps where it stands, also
// once the call is inlined and the index is the constant 4, and also though nothing reads the
// element.
import std.io;

fn at(a: [u32; 4], i: usize) -> u32 {
    return a[i];
}

fn main() -> i32 {
    let a: [u32; 4] = [1, 2, 3, 4];
    let v = at(a, 3);
    io.print(f"{v}\n");
    let _ = at(a, 4);
    io.print("after\n");
    return 0;
}

//~ EXIT 0
// Every build, debug or release, removes a bounds check it has a proof for, and only then. No
// fn here keeps a check: an index from `0..xs.len()`, lengths tested equal on every path, and
// constant offsets from the loop bound.
fn sum(xs: &[u32]) -> u32 {
    let mut s: u32 = 0;
    for i in 0..xs.len() {
        s += xs[i];
    }
    return s;
}

fn dot(a: &[u32], b: &[u32]) -> u32 {
    if a.len() != b.len() {
        return 0;
    }
    let mut s: u32 = 0;
    for i in 0..a.len() {
        s += a[i] * b[i];
    }
    return s;
}

fn rises(xs: &[u32]) -> u32 {
    let mut s: u32 = 0;
    for i in 1..xs.len() {
        s += xs[i] -% xs[i - 1];
    }
    return s;
}

fn pair_sum(xs: &[u32]) -> u32 {
    let mut s: u32 = 0;
    let mut i: usize = 0;
    while i + 1 < xs.len() {
        s += xs[i] + xs[i + 1];
        i += 1;
    }
    return s;
}

fn main() -> i32 {
    let a: [u32; 4] = [1, 3, 6, 10];
    let b: [u32; 4] = [2, 2, 2, 2];
    let total = sum(&a) + dot(&a, &b) + rises(&a) + pair_sum(&a);
    return if total == 98 then 0 else 1;
}

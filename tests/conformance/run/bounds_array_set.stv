// A write into an array value (SSA `set`) with a dynamic index ≥ N traps.
fn fill(n: usize) -> u8 {
    let mut a: [u8; 3] = [0, 0, 0];
    for i in 0..n { a[i] = 1; }
    return a[0];
}

fn main() -> i32 {
    let x = fill(3);
    let y = fill(4);
    return 0;
}

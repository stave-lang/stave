//~ STDOUT temp_field_lock.stdout
// A guard moved out of a temporary struct of two guards stays held by its new owner; the other
// guard is dropped with the temporary.
import std.io;
import std.sync;
view struct Two { pub a: sync.MutexGuard<u32, 1>, pub b: sync.MutexGuard<u32, 2> }
fn main() -> i32 {
    let m1 = sync.Mutex::<u32, 1>.new(0);
    let m2 = sync.Mutex::<u32, 2>.new(0);
    let mut g = Two.{ a: m1.lock(), b: m2.lock() }.a;
    match m1.try_lock() {
        Option.Some(h) => { io.print("first lock free\n"); }
        Option.None => { io.print("first lock held\n"); }
    }
    match m2.try_lock() {
        Option.Some(h) => { io.print("second lock free\n"); }
        Option.None => { io.print("second lock held\n"); }
    }
    *g.get_mut() = 6;
    return 0;
}

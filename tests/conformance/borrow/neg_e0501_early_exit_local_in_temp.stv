//~ CHECK-ONLY
// An early exit (`return`, `?`, `break`) drops the locals of an arm or a `for` body before the
// temporaries of the `match` scrutinee or `for` header around it, as the arm's end does. A
// borrow of such a local stored into the temporary, which the temporary's drop reads, is E0501
// on every way out, also from an arm that never reaches its end. The fix: declare the local
// before the statement, so it outlives the temporary.
import std.io;

view struct G { r: &u32 }

impl Drop for G {
    fn drop(&mut self) {
        let n = *self.r;
        io.print(f" dropG{n}");
    }
}

static Z: u32 = 9;

fn mkg() -> G {
    return G.{ r: &Z };
}

fn fail() -> Result<u32, u32> {
    return Result.Err(7);
}

fn match_return() {
    match &mut mkg() {
        v => {
            let x: u32 = 5;
            v.r = &x;
            return; //~ ERROR E0501
        }
    }
}

fn match_try() -> Result<u32, u32> {
    match &mut mkg() {
        v => {
            let x: u32 = 5;
            v.r = &x;
            let _ = fail()?; //~ ERROR E0501
            return Result.Ok(0); //~ ERROR E0501
        }
    }
}

fn match_break() {
    loop {
        match &mut mkg() {
            v => {
                let x: u32 = 5;
                v.r = &x;
                break; //~ ERROR E0501
            }
        }
    }
}

fn for_return() {
    for x in &mut [mkg()] {
        let y: u32 = 5;
        x.r = &y;
        return; //~ ERROR E0501
    }
}

fn fixed_local_first() {
    let x: u32 = 5;
    match &mut mkg() {
        v => {
            v.r = &x;
            return;
        }
    }
}

fn main() {
    match_return();
    let _ = match_try();
    match_break();
    for_return();
    fixed_local_first();
    io.print("\n");
}

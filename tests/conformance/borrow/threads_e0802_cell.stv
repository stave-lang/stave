//~ CHECK-ONLY
// E0802: `std.cell.UnsafeCell` is never Sync, so neither is any type that
// contains it without an explicit `unsafe(..) impl Sync`: `Cell`, a user struct with a
// Cell field. A `&Cell<u32>` captured by a `join` closure or a `par_for` body is E0802.
import std.cell;
import std.thread;

struct Counter {
    hits: cell.Cell<u32>,
}

fn join_cell(c: &cell.Cell<u32>) -> u32 {
    let (a, b) = thread.join(fn() -> u32 { c.set(1); return 1; }, fn() -> u32 { return 2; }); //~ ERROR E0802
    return a + b;
}

fn par_for_cell(c: &cell.Cell<u32>, n: usize) {
    thread.par_for(0, n, fn(i: usize) { c.set(c.get() + 1); }); //~ ERROR E0802
}

fn par_for_struct(k: &Counter, n: usize) {
    thread.par_for(0, n, fn(i: usize) { k.hits.set(1); }); //~ ERROR E0802
}


//~ CHECK-ONLY
// A returned reference or view with an origin the `from` clause does not name.
view struct Pair { a: &u32, b: &u32 }

fn pick(a: &u32, b: &u32) -> &u32 from a {
    return b; //~ ERROR E0510
}

fn both(a: &u32, b: &u32, c: bool) -> &u32 from a {
    return if c then a else b; //~ ERROR E0510
}

fn pair(a: &u32, b: &u32) -> Pair from a {
    return Pair.{ a: a, b: b }; //~ ERROR E0510
}

fn ok(a: &u32, b: &u32, c: bool) -> &u32 from a + b {
    return if c then a else b;
}

fn lit(a: &u32) -> &str from a {
    return "static";
}

fn main() -> i32 {
    return 0;
}

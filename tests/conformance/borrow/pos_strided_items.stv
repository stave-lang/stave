//~ EXIT 32
// Iterators over disjoint parts, `next(&mut self) -> Option<..> from copy self` with `&mut`
// items made from raw pointers: several items from successive `next` calls are live together,
// and `for` drives such an iterator.
import std.debug;
import std.mem;

unsafe("p..p+len are valid u32 slots that owner keeps alive and lends exclusively while the result lives")
fn items_mut(owner: &[u32], p: *mut u32, len: usize) -> &mut [u32] from owner {
    let parts: [usize; 2] = [p as usize, len];
    let q = &parts as *const [usize; 2] as *const &mut [u32];
    return unsafe("a slice reference is (data pointer, length)") q.read();
}

unsafe("p is valid for one u32 that owner keeps alive and lends exclusively while the result lives")
fn item_mut(owner: &[u32], p: *mut u32) -> &mut u32 from owner {
    return unsafe("p is valid for one u32 and no other live reference reaches it") &mut *p;
}

view struct ViewMut { anchor: &[u32], p: *mut u32, len: usize, step: usize }

impl ViewMut {
    fn len(&self) -> usize {
        return self.len;
    }

    fn get_mut(&mut self, i: usize) -> &mut u32 from self {
        debug.assert(i < self.len, "index");
        let slot = mem.add_mut(self.p, i * self.step);
        return unsafe("i < len, so slot is inside the buffer the anchor lends exclusively") item_mut(self.anchor, slot);
    }

    fn set(&mut self, i: usize, x: u32) {
        *self.get_mut(i) = x;
    }
}

view struct GridMut { anchor: &[u32], p: *mut u32, rows: usize, cols: usize }

impl GridMut {
    fn new(xs: &mut [u32], cols: usize) -> GridMut from xs {
        debug.assert(cols != 0 && xs.len() % cols == 0, "shape");
        let rows = xs.len() / cols;
        let p = mem.slice_ptr(xs) as *mut u32;
        return GridMut.{ anchor: &xs[0..0], p: p, rows: rows, cols: cols };
    }

    fn cols_mut(self) -> ColsMut from self {
        return ColsMut.{ g: self, c: 0 };
    }

    fn rows_mut(self) -> RowsMut from self {
        return RowsMut.{ g: self, r: 0 };
    }
}

view struct ColsMut { g: GridMut, c: usize }

impl ColsMut {
    fn next(&mut self) -> Option<ViewMut> from copy self {
        if self.c >= self.g.cols { return Option.None; }
        let c = self.c;
        self.c = c + 1;
        return Option.Some(ViewMut.{ anchor: self.g.anchor, p: mem.add_mut(self.g.p, c), len: self.g.rows, step: self.g.cols });
    }
}

view struct RowsMut { g: GridMut, r: usize }

impl RowsMut {
    fn next(&mut self) -> Option<&mut [u32]> from copy self {
        if self.r >= self.g.rows { return Option.None; }
        let r = self.r;
        self.r = r + 1;
        return Option.Some(unsafe("row r is inside the buffer the anchor lends exclusively; each row is handed out once") items_mut(self.g.anchor, mem.add_mut(self.g.p, r * self.g.cols), self.g.cols));
    }
}

view struct PhasesMut { anchor: &[u32], p: *mut u32, n: usize, k: usize, i: usize }

fn phases_mut(xs: &mut [u32], k: usize) -> PhasesMut from xs {
    debug.assert(k != 0, "phases");
    let p = mem.slice_ptr(xs) as *mut u32;
    return PhasesMut.{ anchor: &xs[0..0], p: p, n: xs.len(), k: k, i: 0 };
}

impl PhasesMut {
    fn next(&mut self) -> Option<ViewMut> from copy self {
        if self.i >= self.k { return Option.None; }
        let i = self.i;
        self.i = i + 1;
        let len = if i >= self.n then 0 else (self.n - i - 1) / self.k + 1;
        return Option.Some(ViewMut.{ anchor: self.anchor, p: mem.add_mut(self.p, i), len: len, step: self.k });
    }
}

fn cols(xs: &mut [u32]) {
    let g = GridMut.new(xs, 3);
    let mut cs = g.cols_mut();
    let mut a = cs.next().unwrap();
    let mut b = cs.next().unwrap();
    a.set(0, 1);
    b.set(0, 2);
    let mut c = cs.next().unwrap();
    c.set(1, 3);
    match cs.next() {
        Option.None => { }
        Option.Some(_) => { debug.assert(false, "three columns"); }
    }
}

fn rows(xs: &mut [u32]) {
    let g = GridMut.new(xs, 3);
    let mut rs = g.rows_mut();
    let r0 = rs.next().unwrap();
    let r1 = rs.next().unwrap();
    r0[2] = 4;
    r1[0] = 5;
}

fn bump(xs: &mut [u32]) {
    let g = GridMut.new(xs, 3);
    for r in g.rows_mut() {
        r[1] = r[1] + 1;
    }
}

fn phases(xs: &mut [u32]) {
    let mut ph = phases_mut(xs, 2);
    let mut even = ph.next().unwrap();
    let mut odd = ph.next().unwrap();
    debug.assert(even.len() == 3 && odd.len() == 3, "len");
    even.set(0, 6);
    odd.set(2, 7);
}

fn total(xs: &[u32]) -> u32 {
    let mut s: u32 = 0;
    for i in 0..xs.len() {
        s = s + xs[i];
    }
    return s;
}

fn main() -> i32 {
    let mut xs: [u32; 12] = [0; 12];
    cols(&mut xs);
    rows(&mut xs);
    bump(&mut xs);
    let mut ys: [u32; 6] = [0; 6];
    phases(&mut ys);
    return (total(&xs) + total(&ys)) as% i32;
}

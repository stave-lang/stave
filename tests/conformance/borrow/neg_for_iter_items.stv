//~ CHECK-ONLY
// The items of a `for` over an iterator (owned or through `&mut`) are dropped at the end of
// their iteration, or on the exit that leaves it: a borrow of an item kept past that (after the
// loop, past a `break`, into the next iteration, in an outer view whose drop reads it) is E0501.
// A lending iterator's item (`next` returns it `from self`) borrows the iterator: keeping one
// across iterations or past the loop while the source is written, reading the source in the
// body, or a second loop or `next` call over the same iterator inside the body is E0501 too.
import std.io;

struct D { id: u32 }

impl Drop for D {
    fn drop(&mut self) {
        io.print(f" {self.id}");
    }
}

view struct G { r: &u32 }

impl Drop for G {
    fn drop(&mut self) {
        let n = *self.r;
        io.print(f" G{n}");
    }
}

struct It { n: u32 }

impl It {
    fn next(&mut self) -> Option<D> {
        if self.n == 0 {
            return Option.None;
        }
        self.n -= 1;
        return Option.Some(D.{ id: 10 + self.n });
    }
}

struct Lend { v: u32, n: u32 }

impl Lend {
    fn next(&mut self) -> Option<G> from self {
        if self.n == 0 {
            return Option.None;
        }
        self.n -= 1;
        self.v += 1;
        return Option.Some(G.{ r: &self.v });
    }
}

view struct VI { r: &u32, n: u32 }

impl VI {
    fn next(&mut self) -> Option<G> from copy self {
        if self.n == 0 {
            return Option.None;
        }
        self.n -= 1;
        return Option.Some(G.{ r: self.r });
    }
}

fn ref_past_loop() {
    let z = D.{ id: 5 };
    let mut r: &D = &z;
    let mut it = It.{ n: 2 };
    for x in &mut it {
        r = &x;
    } //~ ERROR E0501
    let k = r.id;
}

fn ref_past_break() {
    let z = D.{ id: 5 };
    let mut r: &D = &z;
    let mut it = It.{ n: 2 };
    for x in &mut it {
        r = &x;
        break; //~ ERROR E0501
    }
    let k = r.id;
}

fn ref_next_iteration() {
    let z = D.{ id: 5 };
    let mut r: &D = &z;
    let mut it = It.{ n: 2 };
    for x in &mut it {
        let k = r.id;
        r = &x;
    } //~ ERROR E0501
}

fn ref_next_iteration_owned() {
    let z = D.{ id: 5 };
    let mut r: &D = &z;
    for x in It.{ n: 2 } {
        let k = r.id;
        r = &x;
    } //~ ERROR E0501
}

fn outer_view_of_item() {
    let z: u32 = 5;
    let mut g = G.{ r: &z };
    let mut it = It.{ n: 2 };
    for x in &mut it {
        g = G.{ r: &x.id };
    } //~ ERROR E0501
}

fn outer_view_of_item_break() {
    let z: u32 = 5;
    let mut g = G.{ r: &z };
    let mut it = It.{ n: 2 };
    for x in &mut it {
        g = G.{ r: &x.id };
        break; //~ ERROR E0501
    }
}

fn nested_same_iterator() {
    let mut it = It.{ n: 2 };
    for x in &mut it {
        for y in &mut it { //~ ERROR E0501
        }
    }
}

fn next_in_body() {
    let mut it = It.{ n: 2 };
    for x in &mut it {
        let o = it.next(); //~ ERROR E0501
        //~^ ERROR E0501
    }
}

fn lending_item_kept() {
    let z: u32 = 0;
    let mut l = Lend.{ v: 0, n: 3 };
    let mut keep = G.{ r: &z };
    for g in &mut l { //~ ERROR E0501
        keep = g;
    }
}

fn lending_item_kept_past_break_then_write() {
    let z: u32 = 0;
    let mut l = Lend.{ v: 0, n: 3 };
    let mut keep = G.{ r: &z };
    for g in &mut l {
        keep = g;
        break;
    }
    l.v = 9; //~ ERROR E0501
}

fn lending_body_reads_source() {
    let mut l = Lend.{ v: 0, n: 3 };
    for g in &mut l {
        let o = l.v; //~ ERROR E0501
    }
}

fn view_iterator_item_kept_then_write() {
    let mut z: u32 = 4;
    let y: u32 = 1;
    let mut keep = G.{ r: &y };
    let mut vi = VI.{ r: &z, n: 2 };
    for g in &mut vi {
        keep = g;
        break;
    }
    z = 5; //~ ERROR E0501
}

fn main() {
    ref_past_loop();
    ref_past_break();
    ref_next_iteration();
    ref_next_iteration_owned();
    outer_view_of_item();
    outer_view_of_item_break();
    nested_same_iterator();
    next_in_body();
    lending_item_kept();
    lending_item_kept_past_break_then_write();
    lending_body_reads_source();
    view_iterator_item_kept_then_write();
}

//~ STDOUT threads_join_run.stdout
// LANG.md §5 threads block, run: thread.join runs both closures (one on a new thread)
// and returns both results; thread.par_for_mut doubles every element (each element is borrowed
// by one call). Deterministic output: the main thread prints after the joins.
import std.io;
import std.thread;

fn total(xs: &[u64]) -> u64 {
    let mut s: u64 = 0;
    for i in 0..xs.len() { s = s + xs[i]; }
    return s;
}

fn sum_halves(a: &[u64], b: &[u64]) -> u64 {
    let (x, y) = thread.join(fn() -> u64 { return total(a); }, fn() -> u64 { return total(b); });
    return x + y;
}

fn double_all(xs: &mut [u64]) {
    thread.par_for_mut(xs, fn(i: usize, x: &mut u64) { *x = *x * 2; });
}

fn main() -> i32 {
    let a: [u64; 5] = [1, 2, 3, 4, 5];
    let b: [u64; 3] = [10, 20, 30];
    let s = sum_halves(&a, &b);
    let mut c: [u64; 1000] = [3; 1000];
    double_all(&mut c);
    let t = total(&c);
    let first = c[0];
    let last = c[999];
    io.print(f"{s} {t} {first} {last}\n");
    return 0;
}

//~ CHECK-ONLY
// An annotated `for` binding takes its element as an unannotated one does: by value out of an
// array value it holds the element's loans; a `_` chunk binding over a `&mut` source still
// borrows the chunks.
fn typed_elem() -> u32 {
    let z: u32 = 0;
    let mut keep: &u32 = &z;
    {
        let a: u32 = 1;
        for r: &u32 in [&a, &a] { keep = r; }
    } //~ ERROR E0501
    return *keep;
}

fn wild_chunk(xs: &mut [f32]) -> f32 {
    let r: &f32 = &xs[0];
    let mut k: u32 = 0;
    for _: &mut f32x4 in xs { k = k + 1; } tail scalar (x) { k = k + 10; } //~ ERROR E0501
    return *r;
}

fn main() { }

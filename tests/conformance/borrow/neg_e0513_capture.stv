//~ CHECK-ONLY
// A closure that assigns a captured reference or view may store only what the capture already
// borrows from: the enclosing fn never learns of a new borrow made inside the closure.
view struct Holder { r: &u32 }

fn local_ref() -> u32 {
    let a: u32 = 1;
    let mut r: &u32 = &a;
    let f = fn() {
        let z: u32 = 2;
        r = &z; //~ ERROR E0513
    };
    f();
    return *r;
}

fn view_field() -> u32 {
    let a: u32 = 1;
    let mut h = Holder.{ r: &a };
    let f = fn() {
        let z: u32 = 3;
        h.r = &z; //~ ERROR E0513
    };
    f();
    return *h.r;
}

fn keep() -> u32 {
    let a: u32 = 1;
    let mut r: &u32 = &a;
    let f = fn() {
        let old: &u32 = r;
        r = old;
    };
    f();
    return *r;
}

fn main() -> i32 {
    return 0;
}

//~ CHECK-ONLY
// `p op= e` is `p = p op e`: with a user operator on a non-Copy type the left operand is a
// by-value use of `p`, evaluated before `e`. Out of a place that cannot be moved from (behind
// a reference, an index, a capture, a part of a `Drop` value) it is E0504, as the spelled-out
// form; on a local or a field of one it is a move that the write re-initializes, and `e` may
// not use `p` (E0502).
import std.vec;

struct D { pub id: u32 }
impl Drop for D { fn drop(&mut self) { } }
impl Add for D { fn add(self, rhs: Self) -> Self { return D.{ id: self.id + rhs.id }; } }

struct W { pub d: D }
impl Drop for W { fn drop(&mut self) { } }

struct P { pub d: D, pub n: u32 }

fn mk(k: u32) -> D { return D.{ id: k }; }
fn dup(d: &D) -> D { return D.{ id: d.id }; }

fn through_ref(r: &mut D) {
    *r += mk(1); //~ ERROR E0504
}

fn spelled_out(r: &mut D) {
    *r = *r + mk(1); //~ ERROR E0504
}

fn index(a: &mut [D; 2]) {
    a[0] += mk(2); //~ ERROR E0504
}

fn owned_index() {
    let mut a = [mk(1), mk(2)];
    a[1] += mk(3); //~ ERROR E0504
}

fn drop_part(w: W) {
    let mut v = w;
    v.d += mk(4); //~ ERROR E0504
}

fn capture() {
    let mut d = mk(1);
    let f = fn() { d += mk(5); }; //~ ERROR E0504
    f();
}

fn rhs_reads_old(r: &mut D) {
    *r += dup(r); //~ ERROR E0504
}

fn local_rhs_reads(d: D) {
    let mut x = d;
    x += dup(&x); //~ ERROR E0502
}

fn ok_local(d: D) -> u32 {
    let mut x = d;
    x += mk(2);
    return x.id;
}

fn ok_field(p: P) -> u32 {
    let mut q = p;
    q.d += mk(3);
    return q.d.id + q.n;
}

fn main() -> i32 {
    return 0;
}

//~ CHECK-ONLY
// `p op= e` is `p = p op e`: the left operand is a by-value use of `p`, evaluated before `e`.
// A user operator's self type is Copy (E0422), so it moves only an operand of a generic type
// without a `Copy` bound. Out of a place that cannot be moved from (behind a reference, an
// index, a capture, a part of a `Drop` value) it is E0504, as the spelled-out form, and so is a
// part of a local (a value moves whole); on a local it is a move that the write re-initializes,
// and `e` may not use `p` (E0502).
struct W<T> { pub d: T }
impl<T> Drop for W<T> { fn drop(&mut self) { } }

struct P<T> { pub d: T, pub n: u32 }

fn through_ref<T: Add>(r: &mut T, e: T) {
    *r += e; //~ ERROR E0504
}

fn spelled_out<T: Add>(r: &mut T, e: T) {
    *r = *r + e; //~ ERROR E0504
}

fn index<T: Add>(a: &mut [T; 2], e: T) {
    a[0] += e; //~ ERROR E0504
}

fn owned_index<T: Add>(x: T, y: T, e: T) {
    let mut a = [x, y];
    a[1] += e; //~ ERROR E0504
}

fn drop_part<T: Add>(w: W<T>, e: T) {
    let mut v = w;
    v.d += e; //~ ERROR E0504
}

fn capture<T: Add>(d: T) {
    let mut x = d;
    let f = fn(e: T) { x += e; }; //~ ERROR E0504
}

fn rhs_reads_old<T: Add>(r: &mut T, dup: fn(&T) -> T) {
    *r += dup(r); //~ ERROR E0504
}

fn local_rhs_reads<T: Add>(d: T, dup: fn(&T) -> T) {
    let mut x = d;
    x += dup(&x); //~ ERROR E0502
}

fn ok_local<T: Add>(d: T, e: T) -> T {
    let mut x = d;
    x += e;
    return x;
}

fn field<T: Add>(p: P<T>, e: T) {
    let mut q = p;
    q.d += e; //~ ERROR E0504
}

fn main() -> i32 {
    return 0;
}

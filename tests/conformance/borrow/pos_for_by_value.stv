//~ STDOUT pos_for_by_value.stdout
// An array or `[T]` place is no `for` source, so a by-value loop is written another way: a
// Copy element is read through the reference the loop binds; an array place becomes a
// temporary through a call, whose elements the loop moves out; a `vec.Vec` gives up its
// elements through `pop()`, last first.
import std.io;
import std.mem;
import std.string;
import std.vec;

fn main() -> i32 {
    let a: [u32; 3] = [1, 2, 3];
    let mut s: u32 = 0;
    for x in &a {
        let v = *x;
        s = s + v;
    }
    let mut names: [string.String; 2] = [f"a", f"b"];
    for n in mem.replace(&mut names, [f"c", f"d"]) {
        let owned: string.String = n;
        io.print(f"{owned}\n");
    }
    let mut v = vec.Vec::<string.String>.new();
    v.push(f"x");
    v.push(f"y");
    loop {
        match v.pop() {
            Option.Some(e) => {
                let owned: string.String = e;
                io.print(f"{owned}\n");
            }
            Option.None => {
                break;
            }
        }
    }
    io.print(f"{s}\n");
    return 0;
}

//~ MEMCHECK clean
// `copy_from` of Copy elements with padding bytes (a tuple, a struct, an array of them) copies
// the values and never reads the padding, which no typed store initializes. `Z` has padding
// although its size equals its alignment (8): its zero-sized field is 8-aligned.
struct P { a: u8, b: u32, c: u16 }

impl Copy for P {}

struct Z { a: u32, z: [u64; 0] }

impl Copy for Z {}

fn main() -> i32 {
    let x: u64 = 5;
    let mut long: [(u64, u32); 3] = [(x, 1), (x, 1), (x, 1)];
    let short: [(u64, u32); 2] = [(x +% 1, 2), (x +% 2, 3)];
    long[1..3].copy_from(&short[0..2]);
    let p = P.{ a: 1, b: 2, c: 3 };
    let mut ps: [P; 40] = [p; 40];
    let q: [P; 40] = [P.{ a: 4, b: 5, c: 6 }; 40];
    ps[0..40].copy_from(&q[0..40]);
    let mut ws: [[(u8, u16); 2]; 2] = [[(1, 2), (3, 4)], [(5, 6), (7, 8)]];
    let vs: [[(u8, u16); 2]; 2] = [[(9, 10), (11, 12)], [(13, 14), (15, 16)]];
    ws[0..2].copy_from(&vs[0..2]);
    let mut zs: [Z; 3] = [Z.{ a: 1, z: [0u64; 0] }; 3];
    let zt: [Z; 3] = [Z.{ a: 2, z: [0u64; 0] }; 3];
    zs[0..3].copy_from(&zt[0..3]);
    let mut bytes: [u8; 40] = [0; 40];
    let src: [u8; 40] = [7; 40];
    bytes[0..40].copy_from(&src[0..40]);
    if long[0].1 != 1 || long[1].0 != 6 || long[2].1 != 3 { return 1; }
    if ps[39].a != 4 || ps[0].c != 6 { return 2; }
    if ws[1][1].1 != 16 || bytes[39] != 7 || zs[2].a != 2 { return 3; }
    return 0;
}

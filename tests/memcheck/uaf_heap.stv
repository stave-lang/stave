//~ MEMCHECK use-after-free 11
// A pointer into a Vec's buffer read after the Vec is dropped.
import std.mem;
import std.vec;

fn main() -> i32 {
    let mut v = vec.Vec::<u32>.with_capacity(4);
    let p: *mut u32 = v.spare_ptr();
    v.push(7u32);
    mem.drop(v);
    let x: u32 = unsafe("deliberate: the buffer was freed") *p;
    if x == 7u32 { return 1; }
    return 0;
}

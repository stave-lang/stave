// std.soa: struct-of-arrays containers. No new syntax, no macros, no
// reflection: Stave has no variadic generics, so there is one type per column count,
// Soa2<A, B>, Soa3<A, B, C>, Soa4<A, B, C, D>. A record of k fields is k parallel columns.
//
// Invariant: every column has the same length. Each column is its own `vec.Vec`, so a
// column is one contiguous slice: a hot loop over one field reads only that field's bytes
// and runs as a chunk loop over the slice `colK()` / `colK_mut()`:
//
//     for v: f32x8 in ps.col0() { .. } tail masked (v, m) { .. }
//
// `cols()` / `cols_mut()` borrow every column at once (disjoint fields), so one loop can read
// some columns and write another. Name columns in user code with a wrapper struct whose
// methods forward to `colK` (`fn xs(&self) -> &[f32] from self { return self.s.col0(); }`).
// Out-of-range `get` / `set` panic `Bounds` at the caller (std.vec `get_ref` / `get_mut`).

import std.core;
import std.vec;

pub struct Soa2<A, B> {
    c0: vec.Vec<A>,
    c1: vec.Vec<B>,
}

impl<A, B> Soa2<A, B> {
    pub fn new() -> Soa2<A, B> {
        return Soa2.{ c0: vec.Vec::<A>.new(), c1: vec.Vec::<B>.new() };
    }

    pub fn with_capacity(n: usize) -> Soa2<A, B> {
        return Soa2.{ c0: vec.Vec::<A>.with_capacity(n), c1: vec.Vec::<B>.with_capacity(n) };
    }

    pub fn len(&self) -> usize {
        return self.c0.len();
    }

    pub fn is_empty(&self) -> bool {
        return self.c0.len() == 0;
    }

    pub fn reserve(&mut self, extra: usize) {
        self.c0.reserve(extra);
        self.c1.reserve(extra);
    }

    pub fn push(&mut self, a: A, b: B) {
        self.c0.push(a);
        self.c1.push(b);
    }

    pub fn pop(&mut self) -> Option<(A, B)> {
        if self.c0.len() == 0 { return Option.None; }
        let a = self.c0.pop().unwrap();
        let b = self.c1.pop().unwrap();
        return Option.Some((a, b));
    }

    pub fn clear(&mut self) {
        self.c0.clear();
        self.c1.clear();
    }

    pub fn col0(&self) -> &[A] from self {
        return self.c0.as_slice();
    }

    pub fn col1(&self) -> &[B] from self {
        return self.c1.as_slice();
    }

    pub fn col0_mut(&mut self) -> &mut [A] from self {
        return self.c0.as_mut_slice();
    }

    pub fn col1_mut(&mut self) -> &mut [B] from self {
        return self.c1.as_mut_slice();
    }

    pub fn cols(&self) -> (&[A], &[B]) from self {
        return (self.c0.as_slice(), self.c1.as_slice());
    }

    pub fn cols_mut(&mut self) -> (&mut [A], &mut [B]) from self {
        return (self.c0.as_mut_slice(), self.c1.as_mut_slice());
    }

    // Record i as references into each column; panics `Bounds` if i >= len.
    pub fn get_ref(&self, i: usize) -> (&A, &B) from self {
        return (self.c0.get_ref(i), self.c1.get_ref(i));
    }

    pub fn set(&mut self, i: usize, a: A, b: B) {
        *self.c0.get_mut(i) = a;
        *self.c1.get_mut(i) = b;
    }
}

impl<A: Copy, B: Copy> Soa2<A, B> {
    // Record i by value; panics `Bounds` if i >= len.
    pub fn get(&self, i: usize) -> (A, B) {
        return (*self.c0.get_ref(i), *self.c1.get_ref(i));
    }
}

pub struct Soa3<A, B, C> {
    c0: vec.Vec<A>,
    c1: vec.Vec<B>,
    c2: vec.Vec<C>,
}

impl<A, B, C> Soa3<A, B, C> {
    pub fn new() -> Soa3<A, B, C> {
        return Soa3.{ c0: vec.Vec::<A>.new(), c1: vec.Vec::<B>.new(), c2: vec.Vec::<C>.new() };
    }

    pub fn with_capacity(n: usize) -> Soa3<A, B, C> {
        return Soa3.{
            c0: vec.Vec::<A>.with_capacity(n),
            c1: vec.Vec::<B>.with_capacity(n),
            c2: vec.Vec::<C>.with_capacity(n),
        };
    }

    pub fn len(&self) -> usize {
        return self.c0.len();
    }

    pub fn is_empty(&self) -> bool {
        return self.c0.len() == 0;
    }

    pub fn reserve(&mut self, extra: usize) {
        self.c0.reserve(extra);
        self.c1.reserve(extra);
        self.c2.reserve(extra);
    }

    pub fn push(&mut self, a: A, b: B, c: C) {
        self.c0.push(a);
        self.c1.push(b);
        self.c2.push(c);
    }

    pub fn pop(&mut self) -> Option<(A, B, C)> {
        if self.c0.len() == 0 { return Option.None; }
        let a = self.c0.pop().unwrap();
        let b = self.c1.pop().unwrap();
        let c = self.c2.pop().unwrap();
        return Option.Some((a, b, c));
    }

    pub fn clear(&mut self) {
        self.c0.clear();
        self.c1.clear();
        self.c2.clear();
    }

    pub fn col0(&self) -> &[A] from self {
        return self.c0.as_slice();
    }

    pub fn col1(&self) -> &[B] from self {
        return self.c1.as_slice();
    }

    pub fn col2(&self) -> &[C] from self {
        return self.c2.as_slice();
    }

    pub fn col0_mut(&mut self) -> &mut [A] from self {
        return self.c0.as_mut_slice();
    }

    pub fn col1_mut(&mut self) -> &mut [B] from self {
        return self.c1.as_mut_slice();
    }

    pub fn col2_mut(&mut self) -> &mut [C] from self {
        return self.c2.as_mut_slice();
    }

    pub fn cols(&self) -> (&[A], &[B], &[C]) from self {
        return (self.c0.as_slice(), self.c1.as_slice(), self.c2.as_slice());
    }

    pub fn cols_mut(&mut self) -> (&mut [A], &mut [B], &mut [C]) from self {
        return (self.c0.as_mut_slice(), self.c1.as_mut_slice(), self.c2.as_mut_slice());
    }

    pub fn get_ref(&self, i: usize) -> (&A, &B, &C) from self {
        return (self.c0.get_ref(i), self.c1.get_ref(i), self.c2.get_ref(i));
    }

    pub fn set(&mut self, i: usize, a: A, b: B, c: C) {
        *self.c0.get_mut(i) = a;
        *self.c1.get_mut(i) = b;
        *self.c2.get_mut(i) = c;
    }
}

impl<A: Copy, B: Copy, C: Copy> Soa3<A, B, C> {
    pub fn get(&self, i: usize) -> (A, B, C) {
        return (*self.c0.get_ref(i), *self.c1.get_ref(i), *self.c2.get_ref(i));
    }
}

pub struct Soa4<A, B, C, D> {
    c0: vec.Vec<A>,
    c1: vec.Vec<B>,
    c2: vec.Vec<C>,
    c3: vec.Vec<D>,
}

impl<A, B, C, D> Soa4<A, B, C, D> {
    pub fn new() -> Soa4<A, B, C, D> {
        return Soa4.{
            c0: vec.Vec::<A>.new(),
            c1: vec.Vec::<B>.new(),
            c2: vec.Vec::<C>.new(),
            c3: vec.Vec::<D>.new(),
        };
    }

    pub fn with_capacity(n: usize) -> Soa4<A, B, C, D> {
        return Soa4.{
            c0: vec.Vec::<A>.with_capacity(n),
            c1: vec.Vec::<B>.with_capacity(n),
            c2: vec.Vec::<C>.with_capacity(n),
            c3: vec.Vec::<D>.with_capacity(n),
        };
    }

    pub fn len(&self) -> usize {
        return self.c0.len();
    }

    pub fn is_empty(&self) -> bool {
        return self.c0.len() == 0;
    }

    pub fn reserve(&mut self, extra: usize) {
        self.c0.reserve(extra);
        self.c1.reserve(extra);
        self.c2.reserve(extra);
        self.c3.reserve(extra);
    }

    pub fn push(&mut self, a: A, b: B, c: C, d: D) {
        self.c0.push(a);
        self.c1.push(b);
        self.c2.push(c);
        self.c3.push(d);
    }

    pub fn pop(&mut self) -> Option<(A, B, C, D)> {
        if self.c0.len() == 0 { return Option.None; }
        let a = self.c0.pop().unwrap();
        let b = self.c1.pop().unwrap();
        let c = self.c2.pop().unwrap();
        let d = self.c3.pop().unwrap();
        return Option.Some((a, b, c, d));
    }

    pub fn clear(&mut self) {
        self.c0.clear();
        self.c1.clear();
        self.c2.clear();
        self.c3.clear();
    }

    pub fn col0(&self) -> &[A] from self {
        return self.c0.as_slice();
    }

    pub fn col1(&self) -> &[B] from self {
        return self.c1.as_slice();
    }

    pub fn col2(&self) -> &[C] from self {
        return self.c2.as_slice();
    }

    pub fn col3(&self) -> &[D] from self {
        return self.c3.as_slice();
    }

    pub fn col0_mut(&mut self) -> &mut [A] from self {
        return self.c0.as_mut_slice();
    }

    pub fn col1_mut(&mut self) -> &mut [B] from self {
        return self.c1.as_mut_slice();
    }

    pub fn col2_mut(&mut self) -> &mut [C] from self {
        return self.c2.as_mut_slice();
    }

    pub fn col3_mut(&mut self) -> &mut [D] from self {
        return self.c3.as_mut_slice();
    }

    pub fn cols(&self) -> (&[A], &[B], &[C], &[D]) from self {
        return (self.c0.as_slice(), self.c1.as_slice(), self.c2.as_slice(), self.c3.as_slice());
    }

    pub fn cols_mut(&mut self) -> (&mut [A], &mut [B], &mut [C], &mut [D]) from self {
        return (
            self.c0.as_mut_slice(),
            self.c1.as_mut_slice(),
            self.c2.as_mut_slice(),
            self.c3.as_mut_slice(),
        );
    }

    pub fn get_ref(&self, i: usize) -> (&A, &B, &C, &D) from self {
        return (self.c0.get_ref(i), self.c1.get_ref(i), self.c2.get_ref(i), self.c3.get_ref(i));
    }

    pub fn set(&mut self, i: usize, a: A, b: B, c: C, d: D) {
        *self.c0.get_mut(i) = a;
        *self.c1.get_mut(i) = b;
        *self.c2.get_mut(i) = c;
        *self.c3.get_mut(i) = d;
    }
}

impl<A: Copy, B: Copy, C: Copy, D: Copy> Soa4<A, B, C, D> {
    pub fn get(&self, i: usize) -> (A, B, C, D) {
        return (*self.c0.get_ref(i), *self.c1.get_ref(i), *self.c2.get_ref(i), *self.c3.get_ref(i));
    }
}

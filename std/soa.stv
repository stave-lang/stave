// std.soa: Soa<T>, a growable struct-of-arrays container. T is a Flat struct; every field of T
// is one column, reached as a field of the Soa with the same name: `ps.x` is the `[F]` place of
// the `len` values of field `x` (`ps.x[i]`, `&ps.x`, `&mut ps.x`, `ps.x.len()`,
// `for v: f32x8 in ps.x`). A hot loop over one field reads only that field's bytes. Two columns
// borrow disjointly, like two fields of a struct. A private field of T gives a column usable
// only in T's module. A field of struct type is one column of that struct (no recursive split).
//
// Layout: one buffer `ptr` of `cap` rows. Column k (field k of T in declaration order) is `cap`
// values of that field's type starting at byte `cap * (sizes of fields 0..k)`. `cap` is a
// multiple of `align_of::<T>()`, at least every field's alignment, and the buffer has that
// alignment, so every column is aligned for its element type. The compiler reaches the columns
// with this rule through the fields `ptr`, `len`, `cap` (contracts/intrinsics.md). `cap == 0`
// means no buffer (ptr is mem.dangling); a row of size 0 never allocates (cap is usize max).
// The row built-ins `soa_read`, `soa_write`, and `soa_row_size` (this module only) move one row
// between a T and the columns and give the sum of T's field sizes.
// T is Flat, so a row owns nothing: rows are moved and copied bitwise and never dropped.
// Every method that moves rows (`swap swap_remove permute extend_from_slice`, the growth copy)
// moves whole rows through `soa_read` / `soa_write`, so all columns take the same path.
// Out-of-range `get` / `set` / `swap` / `swap_remove` and a `permute` by a slice that is not a
// permutation of `0..len` panic `Bounds` at the caller; allocation failure panics
// `OutOfMemory` there, except in the `try_` methods, which return `Result.Err` (`try_push` gives
// its value back) and leave the Soa as it was. Capacity arithmetic that overflows usize is an
// allocation failure. Send / Sync like `vec.Vec`: when T is.

import runtime.alloc;
import runtime.errtrace;
import runtime.panic;
import std.core;
import std.mem;
import std.vec;

pub struct Soa<T: core.Flat> {
    ptr: *mut u8,
    len: usize,
    cap: usize,
}

unsafe("a Soa uniquely owns its buffer and rows; moving it moves them") impl<T: core.Flat + core.Send> core.Send for Soa<T> {}
unsafe("&Soa<T> gives only &[F] columns and copies of rows; every mutation needs &mut Soa<T>") impl<T: core.Flat + core.Sync> core.Sync for Soa<T> {}

const USIZE_MAX: usize = 0xFFFF_FFFF_FFFF_FFFF;

fn oom() -> never {
    panic.trap(panic.KIND_OUT_OF_MEMORY, panic.user_site());
}

// The error of a failed `try_` method: the error trace restarts at the user site.
fn alloc_error() -> vec.AllocError {
    errtrace.restart(panic.user_site());
    return vec.AllocError.{};
}

impl<T: core.Flat> Soa<T> {
    pub fn new() -> Soa<T> {
        let cap: usize = if soa_row_size::<T>() == 0 then USIZE_MAX else 0;
        return Soa.{ ptr: mem.dangling::<T>() as *mut u8, len: 0, cap: cap };
    }

    pub fn with_capacity(n: usize) -> Soa<T> {
        let mut s: Soa<T> = Self.new();
        s.reserve(n);
        return s;
    }

    pub fn try_with_capacity(n: usize) -> Result<Soa<T>, vec.AllocError> {
        let mut s: Soa<T> = Self.new();
        s.try_reserve(n)?;
        return Result.Ok(s);
    }

    pub fn len(&self) -> usize {
        return self.len;
    }

    pub fn is_empty(&self) -> bool {
        return self.len == 0;
    }

    pub fn capacity(&self) -> usize {
        return self.cap;
    }

    // Ensures room for `extra` more rows.
    pub fn reserve(&mut self, extra: usize) {
        if self.try_reserve(extra).is_err() { oom(); }
    }

    pub fn try_reserve(&mut self, extra: usize) -> Result<(), vec.AllocError> {
        if extra > USIZE_MAX - self.len { return Result.Err(alloc_error()); }
        let need = self.len + extra;
        if need <= self.cap { return Result.Ok(()); }
        let mut c = if self.cap < 4 then 4 else self.cap *| 2;
        if c < need { c = need; }
        return unsafe("c >= need > cap >= len") self.try_grow_to(c);
    }

    // Moves the rows into a new buffer of at least `want` rows (columns start at offsets that
    // depend on the capacity, so the buffer is copied row by row, not reallocated).
    unsafe("want >= len") fn try_grow_to(&mut self, want: usize) -> Result<(), vec.AllocError> {
        let row = soa_row_size::<T>();
        let al = mem.type_align::<T>();
        let mask = al - 1;
        if want > USIZE_MAX - mask { return Result.Err(alloc_error()); }
        let new_cap = (want + mask) & ~mask;
        if new_cap > USIZE_MAX / row { return Result.Err(alloc_error()); }
        let p = alloc.try_alloc(new_cap * row, al);
        if (p as usize) == 0 { return Result.Err(alloc_error()); }
        let old = self.ptr as *const u8;
        for i in 0..self.len {
            unsafe("i < len <= cap: row i of the old buffer is initialized; the new one has new_cap >= want >= len > i rows (this fn's obligation)") {
                soa_write::<T>(p, new_cap, i, soa_read::<T>(old, self.cap, i));
            }
        }
        if self.cap != 0 {
            unsafe("ptr holds cap * row bytes from alloc with this alignment; its rows were copied") {
                alloc.free(self.ptr, self.cap * row, al);
            }
        }
        self.ptr = p;
        self.cap = new_cap;
        return Result.Ok(());
    }

    pub fn push(&mut self, x: T) {
        if self.len == self.cap { self.reserve(1); }
        unsafe("len < cap: row len is inside the buffer and unused") { soa_write::<T>(self.ptr, self.cap, self.len, x); }
        self.len = self.len + 1;
    }

    // On failure x comes back in the `Err`.
    pub fn try_push(&mut self, x: T) -> Result<(), T> {
        if self.len == self.cap && self.try_reserve(1).is_err() { return Result.Err(x); }
        unsafe("len < cap: row len is inside the buffer and unused") { soa_write::<T>(self.ptr, self.cap, self.len, x); }
        self.len = self.len + 1;
        return Result.Ok(());
    }

    pub fn pop(&mut self) -> Option<T> {
        if self.len == 0 { return Option.None; }
        self.len = self.len - 1;
        return Option.Some(unsafe("row len - 1 was initialized; len no longer covers it") soa_read::<T>(self.ptr as *const u8, self.cap, self.len));
    }

    // Overwrites row i; panics `Bounds` if i >= len.
    pub fn set(&mut self, i: usize, x: T) {
        if i >= self.len {
            panic.trap(panic.KIND_BOUNDS, panic.user_site());
        }
        unsafe("i < len: row i is inside the buffer; a Flat row needs no drop") { soa_write::<T>(self.ptr, self.cap, i, x); }
    }

    // Removes every row; keeps the buffer.
    pub fn clear(&mut self) {
        self.len = 0;
    }

    // Removes the rows from n on; nothing if n >= len. Keeps the buffer.
    pub fn truncate(&mut self, n: usize) {
        if n < self.len { self.len = n; }
    }

    // Removes row i and returns it; the last row takes its place. Panics `Bounds` if i >= len.
    pub fn swap_remove(&mut self, i: usize) -> T {
        if i >= self.len {
            panic.trap(panic.KIND_BOUNDS, panic.user_site());
        }
        let last = self.len - 1;
        let x = unsafe("i < len: an initialized row; it is refilled or len stops covering it") soa_read::<T>(self.ptr as *const u8, self.cap, i);
        if i != last {
            unsafe("last < len: an initialized row, moved into row i; len stops covering it") {
                soa_write::<T>(self.ptr, self.cap, i, soa_read::<T>(self.ptr as *const u8, self.cap, last));
            }
        }
        self.len = last;
        return x;
    }

    // Exchanges rows i and j in every column; panics `Bounds` if either is >= len.
    pub fn swap(&mut self, i: usize, j: usize) {
        if i >= self.len || j >= self.len {
            panic.trap(panic.KIND_BOUNDS, panic.user_site());
        }
        if i == j { return; }
        unsafe("i != j, both < len: two initialized rows, each moved out and refilled") {
            let x = soa_read::<T>(self.ptr as *const u8, self.cap, i);
            soa_write::<T>(self.ptr, self.cap, i, soa_read::<T>(self.ptr as *const u8, self.cap, j));
            soa_write::<T>(self.ptr, self.cap, j, x);
        }
    }

    // Reorders the rows of every column: row k becomes the one that was at perm[k]. Panics
    // `Bounds`, before it moves anything, unless perm has len entries and holds each of 0..len
    // once. Moves each row once, along the cycles of perm.
    pub fn permute(&mut self, perm: &[u32]) {
        let mut todo = vec.PermMarks.new(perm, self.len);
        for s in 0..self.len {
            if todo.take(s) {
                let first = unsafe("s < len: an initialized row; it is refilled when the cycle closes") soa_read::<T>(self.ptr as *const u8, self.cap, s);
                let mut j = s;
                loop {
                    let k = perm[j] as usize;
                    if k == s { break; }
                    let _ = todo.take(k);
                    unsafe("perm is a permutation of 0..len: row k is initialized and not yet moved; row j is empty, read into first (j == s) or moved out of by the step before") {
                        soa_write::<T>(self.ptr, self.cap, j, soa_read::<T>(self.ptr as *const u8, self.cap, k));
                    }
                    j = k;
                }
                unsafe("j is the last row of the cycle: emptied by the move out of it, or j == s, emptied by the read of first") {
                    soa_write::<T>(self.ptr, self.cap, j, first);
                }
            }
        }
    }
}

impl<T: core.Flat + core.Copy> Soa<T> {
    // Row i by value; panics `Bounds` if i >= len. Copy rows only: a non-Copy row leaves only by
    // `pop`, as an element of `Vec` moves out only by `pop`.
    pub fn get(&self, i: usize) -> T {
        if i >= self.len {
            panic.trap(panic.KIND_BOUNDS, panic.user_site());
        }
        return unsafe("i < len: an initialized row; T is Copy, so the copy leaves the row valid") soa_read::<T>(self.ptr as *const u8, self.cap, i);
    }

    // Appends the rows of xs in order.
    pub fn extend_from_slice(&mut self, xs: &[T]) {
        self.reserve(xs.len());
        unsafe("reserve made room for xs.len() more rows") { self.append(xs); }
    }

    pub fn try_extend_from_slice(&mut self, xs: &[T]) -> Result<(), vec.AllocError> {
        self.try_reserve(xs.len())?;
        unsafe("try_reserve returned Ok: room for xs.len() more rows") { self.append(xs); }
        return Result.Ok(());
    }

    unsafe("room for xs.len() more rows is reserved") fn append(&mut self, xs: &[T]) {
        for k in 0..xs.len() {
            unsafe("room is reserved (this fn's obligation): row len + k is inside the buffer and unused; T is Copy") {
                soa_write::<T>(self.ptr, self.cap, self.len + k, xs[k]);
            }
        }
        self.len = self.len + xs.len();
    }
}

impl<T: core.Flat> core.Drop for Soa<T> {
    fn drop(&mut self) {
        let row = soa_row_size::<T>();
        if self.cap != 0 && row != 0 {
            unsafe("ptr holds cap * row bytes from alloc with this alignment; rows own nothing") {
                alloc.free(self.ptr, self.cap * row, mem.type_align::<T>());
            }
        }
    }
}

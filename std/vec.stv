// std.vec: Vec<T>, a growable array on the global allocator (runtime.alloc).
//
// Layout: `ptr` to `cap` slots of T, the first `len` initialized. `cap == 0` means no
// allocation (ptr is mem.dangling). A zero-sized T never allocates (cap is usize max).
// Out-of-range `get_ref` / `get_mut` / `swap` / `swap_remove`, and a `permute` by a slice that is
// not a permutation of `0..len`, panic `Bounds` at the caller (user site, as for every std
// panic raised for its caller); allocation failure panics `OutOfMemory` there too.
// Slots are filled with `p.write(v)` (no drop of the uninitialized old content) and emptied
// with `p.read()` (moves out); `*p = v` would drop the old content.
// Send / Sync: the raw `ptr` field makes the structural rule give neither, so the explicit
// impls below state them: a Vec owns its elements, so it is Send when T is and Sync when T is.
// Types built on Vec (String) get both structurally from their Vec fields.
// Capacity arithmetic that overflows usize is an allocation failure (`OutOfMemory`), never an
// `Overflow` panic. The `try_` methods return `Result.Err` instead of panicking (`AllocError`;
// `try_push` gives its value back) and leave the Vec as it was; every other method that allocates panics `OutOfMemory`.

import runtime.alloc;
import runtime.errtrace;
import runtime.panic;
import std.core;
import std.mem;

extern "stave-intrinsic" {
    fn copy_bytes(dst: *mut u8, src: *const u8, n: usize);
}

// The memory a `try_` method asked for is not available (std.vec, std.string, std.arena).
pub struct AllocError {}

impl core.Copy for AllocError {}

impl core.Display for AllocError {
    fn fmt<W: core.Write>(&self, w: &mut W) {
        w.write_str("out of memory");
    }
}

pub struct Vec<T: view> {
    ptr: *mut T,
    len: usize,
    cap: usize,
}

unsafe("a Vec uniquely owns its buffer and elements; moving it moves them") impl<T: core.Send + view> core.Send for Vec<T> {}
unsafe("&Vec<T> gives only &T and &[T]; every mutation needs &mut Vec<T>") impl<T: core.Sync + view> core.Sync for Vec<T> {}

const USIZE_MAX: usize = 0xFFFF_FFFF_FFFF_FFFF;

fn oom() -> never {
    panic.trap(panic.KIND_OUT_OF_MEMORY, panic.user_site());
}

// The error of a failed `try_` method: the error trace restarts at the user site.
fn alloc_error() -> AllocError {
    errtrace.restart(panic.user_site());
    return AllocError.{};
}

// The indices of 0..n a permutation has not yet moved, one bit each: what `Vec.permute` and
// `soa.Soa.permute` walk. `new` panics `Bounds` at the user site, before anything moves, unless
// perm has n entries holding each of 0..n once.
pub struct PermMarks {
    words: Vec<u64>,
}

fn bit(i: usize) -> u64 {
    return 1u64 << ((i % 64) as u64);
}

impl PermMarks {
    pub fn new(perm: &[u32], n: usize) -> PermMarks {
        if perm.len() != n {
            panic.trap(panic.KIND_BOUNDS, panic.user_site());
        }
        let words = n / 64 + 1;
        let mut seen = Vec::<u64>.with_capacity(words);
        for w in 0..words { seen.push(0); }
        let s = seen.as_mut_slice();
        for k in 0..n {
            let p = perm[k] as usize;
            if p >= n || s[p / 64] & bit(p) != 0 {
                panic.trap(panic.KIND_BOUNDS, panic.user_site());
            }
            s[p / 64] = s[p / 64] | bit(p);
        }
        return PermMarks.{ words: seen };
    }

    // Whether index i (< n) was still unmoved; it is marked moved from now on.
    pub fn take(&mut self, i: usize) -> bool {
        let w = self.words.as_mut_slice();
        let was = w[i / 64] & bit(i) != 0;
        w[i / 64] = w[i / 64] & ~bit(i);
        return was;
    }
}

impl<T: view> Vec<T> {
    pub fn new() -> Vec<T> {
        let zst = mem.type_size::<T>() == 0;
        let cap: usize = if zst then USIZE_MAX else 0;
        return Vec.{ ptr: mem.dangling::<T>(), len: 0, cap: cap };
    }

    pub fn with_capacity(n: usize) -> Vec<T> {
        let mut v: Vec<T> = Self.new();
        v.reserve(n);
        return v;
    }

    pub fn try_with_capacity(n: usize) -> Result<Vec<T>, AllocError> {
        let mut v: Vec<T> = Self.new();
        v.try_reserve(n)?;
        return Result.Ok(v);
    }

    pub fn len(&self) -> usize {
        return self.len;
    }

    pub fn is_empty(&self) -> bool {
        return self.len == 0;
    }

    pub fn capacity(&self) -> usize {
        return self.cap;
    }

    // Ensures room for `extra` more elements.
    pub fn reserve(&mut self, extra: usize) {
        if self.try_reserve(extra).is_err() { oom(); }
    }

    pub fn try_reserve(&mut self, extra: usize) -> Result<(), AllocError> {
        if extra > USIZE_MAX - self.len { return Result.Err(alloc_error()); }
        let need = self.len + extra;
        if need <= self.cap { return Result.Ok(()); }
        let mut c = if self.cap < 4 then 4 else self.cap *| 2;
        if c < need { c = need; }
        return unsafe("c >= need > cap >= len") self.try_grow_to(c);
    }

    unsafe("new_cap >= len") fn try_grow_to(&mut self, new_cap: usize) -> Result<(), AllocError> {
        let size = mem.type_size::<T>();
        let al = mem.type_align::<T>();
        if size != 0 && new_cap > USIZE_MAX / size { return Result.Err(alloc_error()); }
        let bytes = new_cap * size;
        let p = if self.cap == 0 then alloc.try_alloc(bytes, al) else unsafe("ptr holds cap * size bytes from alloc with this alignment") alloc.try_realloc(self.ptr as *mut u8, self.cap * size, al, bytes);
        if (p as usize) == 0 { return Result.Err(alloc_error()); }
        self.ptr = p as *mut T;
        self.cap = new_cap;
        return Result.Ok(());
    }

    pub fn push(&mut self from x, x: T) {
        if self.len == self.cap { self.reserve(1); }
        let slot = mem.add_mut(self.ptr, self.len);
        unsafe("len < cap: slot is inside the buffer and uninitialized") { slot.write(x); }
        self.len = self.len + 1;
    }

    // On failure x comes back in the `Err`, so nothing is dropped behind the caller's back.
    pub fn try_push(&mut self from x, x: T) -> Result<(), T> from x {
        if self.len == self.cap && self.try_reserve(1).is_err() { return Result.Err(x); }
        let slot = mem.add_mut(self.ptr, self.len);
        unsafe("len < cap: slot is inside the buffer and uninitialized") { slot.write(x); }
        self.len = self.len + 1;
        return Result.Ok(());
    }

    pub fn pop(&mut self) -> Option<T> from copy self {
        if self.len == 0 { return Option.None; }
        self.len = self.len - 1;
        let slot = mem.add(self.ptr as *const T, self.len);
        return Option.Some(unsafe("slot was element len - 1, initialized; len no longer covers it") slot.read());
    }

    pub fn get(&self, i: usize) -> Option<&T> from self {
        if i >= self.len { return Option.None; }
        let slot = mem.add(self.ptr as *const T, i);
        return Option.Some(unsafe("i < len: an initialized element owned by self") &*slot);
    }

    // The element at i; panics `Bounds` if i >= len.
    pub fn get_ref(&self, i: usize) -> &T from self {
        if i >= self.len {
            panic.trap(panic.KIND_BOUNDS, panic.user_site());
        }
        let slot = mem.add(self.ptr as *const T, i);
        return unsafe("i < len: an initialized element owned by self") &*slot;
    }

    pub fn get_mut(&mut self, i: usize) -> &mut T from self {
        if i >= self.len {
            panic.trap(panic.KIND_BOUNDS, panic.user_site());
        }
        let slot = mem.add_mut(self.ptr, i);
        return unsafe("i < len: an initialized element owned exclusively through self") &mut *slot;
    }

    pub fn as_slice(&self) -> &[T] from self {
        return unsafe("ptr..ptr+len are the initialized elements owned by self") mem.slice(self, self.ptr as *const T, self.len);
    }

    pub fn as_mut_slice(&mut self) -> &mut [T] from self {
        let p = self.ptr;
        let n = self.len;
        return unsafe("ptr..ptr+len are the initialized elements owned exclusively through self") mem.slice_mut(self, p, n);
    }

    // Drops every element; keeps the buffer.
    pub fn clear(&mut self) {
        self.truncate(0);
    }

    // Drops the elements from n on, the last first; nothing if n >= len. Keeps the buffer.
    // An element type without drop glue only shortens len: O(1), no loop in any build (an `if`
    // on `needs_drop` compiles the taken arm only).
    pub fn truncate(&mut self, n: usize) {
        if needs_drop::<T>() {
            while self.len > n {
                self.len = self.len - 1;
                let slot = mem.add(self.ptr as *const T, self.len);
                let dead = unsafe("slot was initialized; len no longer covers it") slot.read();
            }
        } else if self.len > n {
            self.len = n;
        }
    }

    // Removes element i and returns it; the last element takes its place. Panics `Bounds` if
    // i >= len.
    pub fn swap_remove(&mut self, i: usize) -> T from copy self {
        if i >= self.len {
            panic.trap(panic.KIND_BOUNDS, panic.user_site());
        }
        let last = self.len - 1;
        let hole = mem.add_mut(self.ptr, i);
        let x = unsafe("i < len: an initialized element; it is refilled or len stops covering it") hole.read();
        if i != last {
            unsafe("last < len: an initialized element, moved into the hole; len stops covering it") {
                hole.write(mem.add(self.ptr as *const T, last).read());
            }
        }
        self.len = last;
        return x;
    }

    // Exchanges elements i and j; panics `Bounds` if either is >= len.
    pub fn swap(&mut self, i: usize, j: usize) {
        if i >= self.len || j >= self.len {
            panic.trap(panic.KIND_BOUNDS, panic.user_site());
        }
        if i == j { return; }
        let a = mem.add_mut(self.ptr, i);
        let b = mem.add_mut(self.ptr, j);
        unsafe("i != j, both < len: two initialized elements, each moved out and refilled") {
            let x = a.read();
            a.write(b.read());
            b.write(x);
        }
    }

    // Reorders the elements: element k becomes the one that was at perm[k]. Panics `Bounds`,
    // before it moves anything, unless perm has len entries and holds each of 0..len once.
    // Moves each element once, along the cycles of perm; drops nothing.
    pub fn permute(&mut self, perm: &[u32]) {
        let mut todo = PermMarks.new(perm, self.len);
        for s in 0..self.len {
            if todo.take(s) {
                let first = unsafe("s < len: an initialized element; its slot is refilled when the cycle closes") mem.add(self.ptr as *const T, s).read();
                let mut j = s;
                loop {
                    let k = perm[j] as usize;
                    if k == s { break; }
                    let _ = todo.take(k);
                    unsafe("perm is a permutation of 0..len: slot k is initialized and not yet moved; slot j is empty, read into first (j == s) or moved out of by the step before") {
                        mem.add_mut(self.ptr, j).write(mem.add(self.ptr as *const T, k).read());
                    }
                    j = k;
                }
                unsafe("j is the last slot of the cycle: emptied by the move out of it, or j == s, emptied by the read of first") {
                    mem.add_mut(self.ptr, j).write(first);
                }
            }
        }
    }

    // Spare capacity for writers that fill the buffer directly (std.io reads).
    pub fn spare_ptr(&mut self) -> *mut T {
        return mem.add_mut(self.ptr, self.len);
    }

    pub unsafe("the first n elements are initialized and n <= capacity")
    fn set_len(&mut self, n: usize) {
        self.len = n;
    }
}

// A Copy T is copied by its bytes (`copy_bytes`), padding included.
impl<T: Copy + view> Vec<T> {
    pub fn extend_from_slice(&mut self from copy xs, xs: &[T]) {
        self.reserve(xs.len());
        let n = xs.len();
        let d = mem.add_mut(self.ptr, self.len) as *mut u8;
        let s = mem.slice_ptr(xs) as *const u8;
        unsafe("room for n elements is reserved: d..d+n*size is spare capacity, which xs (a shared borrow while self is exclusive) does not reach; T is Copy") {
            copy_bytes(d, s, n * mem.type_size::<T>());
        }
        self.len = self.len + n;
    }

    pub fn try_extend_from_slice(&mut self from copy xs, xs: &[T]) -> Result<(), AllocError> {
        self.try_reserve(xs.len())?;
        let n = xs.len();
        let d = mem.add_mut(self.ptr, self.len) as *mut u8;
        let s = mem.slice_ptr(xs) as *const u8;
        unsafe("room for n elements is reserved: d..d+n*size is spare capacity, which xs (a shared borrow while self is exclusive) does not reach; T is Copy") {
            copy_bytes(d, s, n * mem.type_size::<T>());
        }
        self.len = self.len + n;
        return Result.Ok(());
    }
}

impl<T: view> core.Drop for Vec<T> {
    fn drop(&mut self) {
        self.clear();
        let size = mem.type_size::<T>();
        if self.cap != 0 && size != 0 {
            unsafe("ptr holds cap * size bytes from alloc with this alignment; no element is left") {
                alloc.free(self.ptr as *mut u8, self.cap * size, mem.type_align::<T>());
            }
        }
    }
}

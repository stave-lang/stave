// usize and isize are 64-bit on every target: the u64 / i64 code.
impl [usize] {
    pub fn sum(&self) -> usize {
        return cast::<usize, u64>(self).sum() as usize;
    }

    pub fn min(&self) -> Option<usize> {
        return match cast::<usize, u64>(self).min() {
            Option.Some(x) => Option.Some(x as usize),
            Option.None => Option.None,
        };
    }

    pub fn max(&self) -> Option<usize> {
        return match cast::<usize, u64>(self).max() {
            Option.Some(x) => Option.Some(x as usize),
            Option.None => Option.None,
        };
    }

    pub fn find(&self, x: usize) -> Option<usize> {
        return cast::<usize, u64>(self).find(x as u64);
    }

    pub fn eq(&self, other: &[usize]) -> bool {
        return bytes_eq_any(cast::<usize, u8>(self), cast::<usize, u8>(other));
    }

    pub fn fill(&mut self, x: usize) {
        cast_mut::<usize, u64>(self).fill(x as u64);
    }
}


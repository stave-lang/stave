dispatch fn fill_u16_cpu(xs: &mut [u16], x: u16) { avx2 => fill_u16_v3, _ => fill_u16, }

impl [u16] {
    pub fn sum(&self) -> u16 {
        if self.len() >= LONG_B16 {
            match sum_u16_cpu(self) {
                Option.Some(s) => { return s; }
                Option.None => {}
            }
        } else {
            let mut s = u16x8.splat(0);
            let mut bad = mask16x8.none();
            for v: u16x8 in self {
                let p = s +% v.scan_add_wrap();
                bad = bad | (p < (p -% v));
                s = p.permute::<[7, 7, 7, 7, 7, 7, 7, 7]>();
            } tail masked (v, m) {
                let p = s +% v.scan_add_wrap();
                bad = bad | (p < (p -% v));
                s = p.permute::<[7, 7, 7, 7, 7, 7, 7, 7]>();
            }
            if bad.to_bits() == 0 { return s.reduce_max(); }
        }
        let mut t: u16 = 0;
        for i in 0..self.len() { t = t + self[i]; }
        return t;
    }

    pub fn min(&self) -> Option<u16> {
        if self.len() == 0 { return Option.None; }
        if self.len() >= LONG_B16 { return Option.Some(min_u16_cpu(self)); }
        let mut a = u16x8.splat(self[0]);
        for v: u16x8 in self { a = a.min(v); } tail masked (v, m) { a = a.min(m.select(v, a)); }
        return Option.Some(a.reduce_min());
    }

    pub fn max(&self) -> Option<u16> {
        if self.len() == 0 { return Option.None; }
        if self.len() >= LONG_B16 { return Option.Some(max_u16_cpu(self)); }
        let mut a = u16x8.splat(self[0]);
        for v: u16x8 in self { a = a.max(v); } tail masked (v, m) { a = a.max(m.select(v, a)); }
        return Option.Some(a.reduce_max());
    }

    pub fn find(&self, x: u16) -> Option<usize> {
        if self.len() >= LONG_B16 { return find_u16_cpu(self, x); }
        let k = u16x8.splat(x);
        let mut i: usize = 0;
        for v: u16x8 in self {
            let b = (v == k).to_bits();
            if b != 0 { return some_at(i, b as u64); }
            i = i + 8;
        } tail masked (v, m) {
            let b = ((v == k) & m).to_bits();
            if b != 0 { return some_at(i, b as u64); }
        }
        return Option.None;
    }

    pub fn eq(&self, other: &[u16]) -> bool {
        return bytes_eq_any(cast::<u16, u8>(self), cast::<u16, u8>(other));
    }

    pub fn fill(&mut self, x: u16) {
        if self.len() >= LONG_B16 {
            fill_u16_cpu(self, x);
            return;
        }
        let k = u16x8.splat(x);
        for v: &mut u16x8 in self { *v = k; } tail masked (v, m) { *v = k; }
    }
}

fn sum_u32(xs: &[u32]) -> Option<u32> {
    let mut s = u32x4.splat(0);
    let mut bad = mask32x4.none();
    for v: u32x4 in xs {
        let p = s +% v.scan_add_wrap();
        bad = bad | (p < (p -% v));
        s = p.permute::<[3, 3, 3, 3]>();
    } tail masked (v, m) {
        let p = s +% v.scan_add_wrap();
        bad = bad | (p < (p -% v));
        s = p.permute::<[3, 3, 3, 3]>();
    }
    if bad.to_bits() != 0 { return Option.None; }
    return Option.Some(s.reduce_max());
}


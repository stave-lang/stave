        let mut s = u32x4.splat(0);
        let mut bad = mask32x4.none();
        for v: u32x4 in self {
            let p = s +% v.scan_add_wrap();
            bad = bad | (p < (p -% v));
            s = p.permute::<[3, 3, 3, 3]>();
        } tail masked (v, m) {
            let p = s +% v.scan_add_wrap();
            bad = bad | (p < (p -% v));
            s = p.permute::<[3, 3, 3, 3]>();
        }

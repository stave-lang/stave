    pub fn find(&self, x: u32) -> Option<usize> {
        let k = u32x4.splat(x);
        let mut i: usize = 0;
        for v: u32x4 in self {
            let b = (v == k).to_bits();
            if b != 0 { return some_at(i, b as u64); }
            i = i + 4;
        } tail masked (v, m) {
            let b = ((v == k) & m).to_bits();
            if b != 0 { return some_at(i, b as u64); }
        }
        return Option.None;
    }

    pub fn eq(&self, other: &[u32]) -> bool {
        return bytes_eq(cast::<u32, u8>(self), cast::<u32, u8>(other));
    }

    pub fn fill(&mut self, x: u32) {
        let k = u32x4.splat(x);
        for v: &mut u32x4 in self { *v = k; } tail masked (v, m) { *v = k; }
    }
}

impl [u64] {
    pub fn sum(&self) -> u64 {
        let mut s = u64x2.splat(0);
        let mut bad = mask64x2.none();
        for v: u64x2 in self {
            let p = s +% v.scan_add_wrap();
            bad = bad | (p < (p -% v));
            s = p.permute::<[1, 1]>();
        } tail masked (v, m) {
            let p = s +% v.scan_add_wrap();
            bad = bad | (p < (p -% v));
            s = p.permute::<[1, 1]>();
        }
        if bad.to_bits() != 0 {
            let mut t: u64 = 0;
            for i in 0..self.len() { t = t + self[i]; }
            return t;
        }
        return s.reduce_max();
    }

    pub fn min(&self) -> Option<u64> {
        if self.len() == 0 { return Option.None; }
        let mut a = u64x2.splat(self[0]);
        for v: u64x2 in self { a = a.min(v); } tail masked (v, m) { a = a.min(m.select(v, a)); }
        return Option.Some(a.reduce_min());
    }

    pub fn max(&self) -> Option<u64> {
        if self.len() == 0 { return Option.None; }
        let mut a = u64x2.splat(self[0]);
        for v: u64x2 in self { a = a.max(v); } tail masked (v, m) { a = a.max(m.select(v, a)); }
        return Option.Some(a.reduce_max());
    }

    pub fn find(&self, x: u64) -> Option<usize> {
        let k = u64x2.splat(x);
        let mut i: usize = 0;
        for v: u64x2 in self {
            let b = (v == k).to_bits();
            if b != 0 { return some_at(i, b as u64); }
            i = i + 2;
        } tail masked (v, m) {
            let b = ((v == k) & m).to_bits();
            if b != 0 { return some_at(i, b as u64); }
        }
        return Option.None;
    }

    pub fn eq(&self, other: &[u64]) -> bool {
        return bytes_eq(cast::<u64, u8>(self), cast::<u64, u8>(other));
    }

    pub fn fill(&mut self, x: u64) {
        let k = u64x2.splat(x);
        for v: &mut u64x2 in self { *v = k; } tail masked (v, m) { *v = k; }
    }
}

// Signed sums: p = prev + v overflowed iff prev and v have one sign and p the other.
impl [i8] {
    pub fn sum(&self) -> i8 {
        let mut s = i8x16.splat(0);
        let mut bad = mask8x16.none();
        let z = i8x16.splat(0);
        for v: i8x16 in self {
            let p = s +% v.scan_add_wrap();
            bad = bad | ((((p -% v) ^ p) & (v ^ p)) < z);
            s = p.permute::<[15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15]>();
        } tail masked (v, m) {
            let p = s +% v.scan_add_wrap();
            bad = bad | ((((p -% v) ^ p) & (v ^ p)) < z);
            s = p.permute::<[15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15]>();
        }
        if bad.to_bits() != 0 {
            let mut t: i8 = 0;
            for i in 0..self.len() { t = t + self[i]; }
            return t;
        }
        return s.reduce_max();
    }

    pub fn min(&self) -> Option<i8> {
        if self.len() == 0 { return Option.None; }
        let mut a = i8x16.splat(self[0]);
        for v: i8x16 in self { a = a.min(v); } tail masked (v, m) { a = a.min(m.select(v, a)); }
        return Option.Some(a.reduce_min());
    }

    pub fn max(&self) -> Option<i8> {
        if self.len() == 0 { return Option.None; }
        let mut a = i8x16.splat(self[0]);
        for v: i8x16 in self { a = a.max(v); } tail masked (v, m) { a = a.max(m.select(v, a)); }
        return Option.Some(a.reduce_max());
    }

    pub fn find(&self, x: i8) -> Option<usize> {
        return cast::<i8, u8>(self).find(x as% u8);
    }

    pub fn eq(&self, other: &[i8]) -> bool {
        return bytes_eq(cast::<i8, u8>(self), cast::<i8, u8>(other));
    }

    pub fn fill(&mut self, x: i8) {
        cast_mut::<i8, u8>(self).fill(x as% u8);
    }
}

impl [i16] {
    pub fn sum(&self) -> i16 {
        let mut s = i16x8.splat(0);
        let mut bad = mask16x8.none();
        let z = i16x8.splat(0);
        for v: i16x8 in self {
            let p = s +% v.scan_add_wrap();
            bad = bad | ((((p -% v) ^ p) & (v ^ p)) < z);
            s = p.permute::<[7, 7, 7, 7, 7, 7, 7, 7]>();
        } tail masked (v, m) {
            let p = s +% v.scan_add_wrap();
            bad = bad | ((((p -% v) ^ p) & (v ^ p)) < z);
            s = p.permute::<[7, 7, 7, 7, 7, 7, 7, 7]>();
        }
        if bad.to_bits() != 0 {
            let mut t: i16 = 0;
            for i in 0..self.len() { t = t + self[i]; }
            return t;
        }
        return s.reduce_max();
    }

    pub fn min(&self) -> Option<i16> {
        if self.len() == 0 { return Option.None; }
        let mut a = i16x8.splat(self[0]);
        for v: i16x8 in self { a = a.min(v); } tail masked (v, m) { a = a.min(m.select(v, a)); }
        return Option.Some(a.reduce_min());
    }

    pub fn max(&self) -> Option<i16> {
        if self.len() == 0 { return Option.None; }
        let mut a = i16x8.splat(self[0]);
        for v: i16x8 in self { a = a.max(v); } tail masked (v, m) { a = a.max(m.select(v, a)); }
        return Option.Some(a.reduce_max());
    }

    pub fn find(&self, x: i16) -> Option<usize> {
        return cast::<i16, u16>(self).find(x as% u16);
    }

    pub fn eq(&self, other: &[i16]) -> bool {
        return bytes_eq(cast::<i16, u8>(self), cast::<i16, u8>(other));
    }

    pub fn fill(&mut self, x: i16) {
        cast_mut::<i16, u16>(self).fill(x as% u16);
    }
}


dispatch fn max_u16_cpu(xs: &[u16]) -> u16 { avx2 => max_u16_v3, _ => max_u16, }

fn find_u16(xs: &[u16], x: u16) -> Option<usize> {
    let k = u16x8.splat(x);
    let mut i: usize = 0;
    for v: u16x8 in xs {
        let b = (v == k).to_bits();
        if b != 0 { return some_at(i, b as u64); }
        i = i + 8;
    } tail masked (v, m) {
        let b = ((v == k) & m).to_bits();
        if b != 0 { return some_at(i, b as u64); }
    }
    return Option.None;
}

fn find_u16_v3(xs: &[u16], x: u16) -> Option<usize> needs(avx2) {
    let k = u16x16.splat(x);
    let mut i: usize = 0;
    for v: u16x16 in xs {
        let b = (v == k).to_bits();
        if b != 0 { return some_at(i, b as u64); }
        i = i + 16;
    } tail masked (v, m) {
        let b = ((v == k) & m).to_bits();
        if b != 0 { return some_at(i, b as u64); }

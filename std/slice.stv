// std.slice: SIMD-backed methods on the built-in slice types. Methods of `impl [T]` blocks need no
// import: `xs.sum()` on any `&[f32]`.
//
//   sum()            ints: the sequential sum, trapping `Overflow` exactly where `for` + `+` would;
//                    floats: the fixed lane tree below (not the left-to-right sum)
//   min() max()      Option (None when empty); floats as the vector `min`/`max`: NaN propagates,
//                    -0.0 < +0.0
//   find(x)          first index i with xs[i] == x (floats: NaN is never found, -0.0 == +0.0)
//   eq(ys)           same length and xs[i] == ys[i] for every i (ints, bool: the same bits;
//                    floats: `==`, so a NaN element makes it false and -0.0 equals +0.0)
//   fill(x)          every element = x
//   [u8] find_byte(b), find_any_byte(set): first index of b / of any byte of set
//   any T: Copy      count(pred), any(pred), all(pred) (pred: fn(T) -> bool; it may be called
//                    on any elements, in any order, any number of times), copy_from(src)
//                    (lengths must match: `Assert` panic otherwise)
//
// Every method loops in 128-bit vectors (the portable baseline of every CPU target). On x86-64,
// sum (ints), min, max, find, find_any_byte, eq, fill and copy_from have a second loop in
// 256-bit vectors under `needs(avx2)`, which a slice of 1 KiB or more (`LONG_B*`) reaches
// through a `dispatch fn` when the CPU has AVX2 (always on x86_64-linux-v3; AArch64 builds only
// the 128-bit loop). Shorter slices stay in the method: the CPU test and the calls cost more
// than the wider vectors save there. The `_` arm of each dispatch repeats the method's 128-bit
// loop (a call from the method would cost the short slices). No signature names a vector width,
// and every loop gives the same results:
// - Int sums wrap lane-wise and keep the running prefix sum in every lane (`scan_add_wrap`); a
//   lane whose prefix overflowed sets a flag (the loops outside the method return None then). A
//   set flag only sends the sum to the method's sequential loop, which traps at the overflowing
//   element. Widths therefore never change a result.
// - A float sum adds element i into lane i % L of L zeroed accumulator lanes, L = 16 for f32
//   and 8 for f64 (512 bits, held as four 128-bit vectors), then reduces the L lanes by the
//   `reduce_add` tree: lane j with lane j + L/2, halving until one lane is left. Empty: +0.0.
//   Its four independent accumulators already hide the add latency, so it has no 256-bit loop.
// - min, max and the searches do not depend on the order.
// Branchless per element: sum, min, max, count, fill, copy_from (their loops branch only on the
// loop test, never on element data). The searches (find, find_byte, find_any_byte, eq, any,
// all) test once per vector or per block of 16 elements and may return after that test.

import std.debug;
import std.mem;

// 1 KiB in elements of 1, 2, 4 and 8 bytes.
const LONG_B8: usize = 1024;
const LONG_B16: usize = 512;
const LONG_B32: usize = 256;
const LONG_B64: usize = 128;

// xs as a slice of U: same address, xs.len() * size_of::<T>() / size_of::<U>() elements. Callers
// pass T and U of one size, or U = u8; every bit pattern of T is then a valid U (bool is 0 or 1).
fn cast<T, U>(xs: &[T]) -> &[U] from xs {
    let n = xs.len() * size_of::<T>() / size_of::<U>();
    let p = mem.slice_ptr(xs) as usize as *const U;
    return unsafe("xs covers n elements of U, and every bit pattern of T is a valid U") mem.slice(xs, p, n);
}

// The mutable view; callers write only values valid as T (bytes 0 and 1 into a bool slice).
fn cast_mut<T, U>(xs: &mut [T]) -> &mut [U] from xs {
    let n = xs.len() * size_of::<T>() / size_of::<U>();
    let p = mem.slice_ptr(xs) as usize as *mut U;
    return unsafe("xs covers n elements of U, borrowed exclusively; only values valid as T are written") mem.slice_mut(xs, p, n);
}

// Active lanes of the k-th n-lane vector of an r-element tail: clamp(r - k * n, 0, n).
fn tail_lanes(r: usize, k: usize, n: usize) -> usize {
    let left = r -| k * n;
    return (left < n).select(left, n);
}

fn some_at(i: usize, bits: u64) -> Option<usize> {
    return Option.Some(i + (bits.ctz() as usize));
}

fn bytes_eq(a: &[u8], b: &[u8]) -> bool {
    let n = a.len();
    let mut i: usize = 0;
    while i + 16 <= n {
        if (u8x16.load(a, i) != u8x16.load(b, i)).to_bits() != 0 { return false; }
        i = i + 16;
    }
    let m = mask8x16.first_n(n - i);
    return ((u8x16.load_masked(a, i, m) != u8x16.load_masked(b, i, m)) & m).to_bits() == 0;
}

fn bytes_eq_v3(a: &[u8], b: &[u8]) -> bool needs(avx2) {
    let n = a.len();
    let mut i: usize = 0;
    while i + 32 <= n {
        if (u8x32.load(a, i) != u8x32.load(b, i)).to_bits() != 0 { return false; }
        i = i + 32;
    }
    let m = mask8x32.first_n(n - i);
    return ((u8x32.load_masked(a, i, m) != u8x32.load_masked(b, i, m)) & m).to_bits() == 0;
}

// bytes_eq, bytes_eq_v3: a.len() == b.len().
dispatch fn bytes_eq_cpu(a: &[u8], b: &[u8]) -> bool { avx2 => bytes_eq_v3, _ => bytes_eq, }

// a == b as bytes, for every int and bool slice.
fn bytes_eq_any(a: &[u8], b: &[u8]) -> bool {
    if a.len() != b.len() { return false; }
    if a.len() >= LONG_B8 { return bytes_eq_cpu(a, b); }
    let n = a.len();
    let mut i: usize = 0;
    while i + 16 <= n {
        if (u8x16.load(a, i) != u8x16.load(b, i)).to_bits() != 0 { return false; }
        i = i + 16;
    }
    let m = mask8x16.first_n(n - i);
    return ((u8x16.load_masked(a, i, m) != u8x16.load_masked(b, i, m)) & m).to_bits() == 0;
}

fn copy_bytes(s: &[u8], d: &mut [u8]) {
    let n = d.len();
    let mut i: usize = 0;
    while i + 64 <= n {
        u8x16.load(s, i).store(d, i);
        u8x16.load(s, i + 16).store(d, i + 16);
        u8x16.load(s, i + 32).store(d, i + 32);
        u8x16.load(s, i + 48).store(d, i + 48);
        i = i + 64;
    }
    while i + 16 <= n {
        u8x16.load(s, i).store(d, i);
        i = i + 16;
    }
    let m = mask8x16.first_n(n - i);
    u8x16.load_masked(s, i, m).store_masked(d, i, m);
}

fn copy_bytes_v3(s: &[u8], d: &mut [u8]) needs(avx2) {
    let n = d.len();
    let mut i: usize = 0;
    while i + 128 <= n {
        u8x32.load(s, i).store(d, i);
        u8x32.load(s, i + 32).store(d, i + 32);
        u8x32.load(s, i + 64).store(d, i + 64);
        u8x32.load(s, i + 96).store(d, i + 96);
        i = i + 128;
    }
    while i + 32 <= n {
        u8x32.load(s, i).store(d, i);
        i = i + 32;
    }
    let m = mask8x32.first_n(n - i);
    u8x32.load_masked(s, i, m).store_masked(d, i, m);
}

dispatch fn copy_bytes_cpu(s: &[u8], d: &mut [u8]) { avx2 => copy_bytes_v3, _ => copy_bytes, }

fn find_any_byte(xs: &[u8], set: &[u8]) -> Option<usize> {
    let mut i: usize = 0;
    for v: u8x16 in xs {
        let mut hit = mask8x16.none();
        for j in 0..set.len() { hit = hit | (v == u8x16.splat(set[j])); }
        let b = hit.to_bits();
        if b != 0 { return some_at(i, b as u64); }
        i = i + 16;
    } tail masked (v, m) {
        let mut hit = mask8x16.none();
        for j in 0..set.len() { hit = hit | (v == u8x16.splat(set[j])); }
        let b = (hit & m).to_bits();
        if b != 0 { return some_at(i, b as u64); }
    }
    return Option.None;
}

fn find_any_byte_v3(xs: &[u8], set: &[u8]) -> Option<usize> needs(avx2) {
    let mut i: usize = 0;
    for v: u8x32 in xs {
        let mut hit = mask8x32.none();
        for j in 0..set.len() { hit = hit | (v == u8x32.splat(set[j])); }
        let b = hit.to_bits();
        if b != 0 { return some_at(i, b as u64); }
        i = i + 32;
    } tail masked (v, m) {
        let mut hit = mask8x32.none();
        for j in 0..set.len() { hit = hit | (v == u8x32.splat(set[j])); }
        let b = (hit & m).to_bits();
        if b != 0 { return some_at(i, b as u64); }
    }
    return Option.None;
}

dispatch fn find_any_byte_cpu(xs: &[u8], set: &[u8]) -> Option<usize> { avx2 => find_any_byte_v3, _ => find_any_byte, }

fn sum_u8(xs: &[u8]) -> Option<u8> {
    let mut s = u8x16.splat(0);
    let mut bad = mask8x16.none();
    for v: u8x16 in xs {
        let p = s +% v.scan_add_wrap();
        bad = bad | (p < (p -% v));
        s = p.permute::<[15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15]>();
    } tail masked (v, m) {
        let p = s +% v.scan_add_wrap();
        bad = bad | (p < (p -% v));
        s = p.permute::<[15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15]>();
    }
    if bad.to_bits() != 0 { return Option.None; }
    return Option.Some(s.reduce_max());
}

fn sum_u8_v3(xs: &[u8]) -> Option<u8> needs(avx2) {
    let mut s = u8x32.splat(0);
    let mut bad = mask8x32.none();
    for v: u8x32 in xs {
        let p = s +% v.scan_add_wrap();
        bad = bad | (p < (p -% v));
        s = p.permute::<[31, 31, 31, 31, 31, 31, 31, 31, 31, 31, 31, 31, 31, 31, 31, 31, 31, 31, 31, 31, 31, 31, 31, 31, 31, 31, 31, 31, 31, 31, 31, 31]>();
    } tail masked (v, m) {
        let p = s +% v.scan_add_wrap();
        bad = bad | (p < (p -% v));
        s = p.permute::<[31, 31, 31, 31, 31, 31, 31, 31, 31, 31, 31, 31, 31, 31, 31, 31, 31, 31, 31, 31, 31, 31, 31, 31, 31, 31, 31, 31, 31, 31, 31, 31]>();
    }
    if bad.to_bits() != 0 { return Option.None; }
    return Option.Some(s.reduce_max());
}

dispatch fn sum_u8_cpu(xs: &[u8]) -> Option<u8> { avx2 => sum_u8_v3, _ => sum_u8, }

fn min_u8(xs: &[u8]) -> u8 {
    let mut a = u8x16.splat(xs[0]);
    for v: u8x16 in xs { a = a.min(v); } tail masked (v, m) { a = a.min(m.select(v, a)); }
    return a.reduce_min();
}

fn min_u8_v3(xs: &[u8]) -> u8 needs(avx2) {
    let mut a = u8x32.splat(xs[0]);
    for v: u8x32 in xs { a = a.min(v); } tail masked (v, m) { a = a.min(m.select(v, a)); }
    return a.reduce_min();
}

dispatch fn min_u8_cpu(xs: &[u8]) -> u8 { avx2 => min_u8_v3, _ => min_u8, }

fn max_u8(xs: &[u8]) -> u8 {
    let mut a = u8x16.splat(xs[0]);
    for v: u8x16 in xs { a = a.max(v); } tail masked (v, m) { a = a.max(m.select(v, a)); }
    return a.reduce_max();
}

fn max_u8_v3(xs: &[u8]) -> u8 needs(avx2) {
    let mut a = u8x32.splat(xs[0]);
    for v: u8x32 in xs { a = a.max(v); } tail masked (v, m) { a = a.max(m.select(v, a)); }
    return a.reduce_max();
}

dispatch fn max_u8_cpu(xs: &[u8]) -> u8 { avx2 => max_u8_v3, _ => max_u8, }

fn find_u8(xs: &[u8], x: u8) -> Option<usize> {
    let k = u8x16.splat(x);
    let mut i: usize = 0;
    for v: u8x16 in xs {
        let b = (v == k).to_bits();
        if b != 0 { return some_at(i, b as u64); }
        i = i + 16;
    } tail masked (v, m) {
        let b = ((v == k) & m).to_bits();
        if b != 0 { return some_at(i, b as u64); }
    }
    return Option.None;
}

fn find_u8_v3(xs: &[u8], x: u8) -> Option<usize> needs(avx2) {
    let k = u8x32.splat(x);
    let mut i: usize = 0;
    for v: u8x32 in xs {
        let b = (v == k).to_bits();
        if b != 0 { return some_at(i, b as u64); }
        i = i + 32;
    } tail masked (v, m) {
        let b = ((v == k) & m).to_bits();
        if b != 0 { return some_at(i, b as u64); }
    }
    return Option.None;
}

dispatch fn find_u8_cpu(xs: &[u8], x: u8) -> Option<usize> { avx2 => find_u8_v3, _ => find_u8, }

fn fill_u8(xs: &mut [u8], x: u8) {
    let k = u8x16.splat(x);
    for v: &mut u8x16 in xs { *v = k; } tail masked (v, m) { *v = k; }
}

fn fill_u8_v3(xs: &mut [u8], x: u8) needs(avx2) {
    let k = u8x32.splat(x);
    for v: &mut u8x32 in xs { *v = k; } tail masked (v, m) { *v = k; }
}

dispatch fn fill_u8_cpu(xs: &mut [u8], x: u8) { avx2 => fill_u8_v3, _ => fill_u8, }

impl [u8] {
    pub fn sum(&self) -> u8 {
        if self.len() >= LONG_B8 {
            match sum_u8_cpu(self) {
                Option.Some(s) => { return s; }
                Option.None => {}
            }
        } else {
            let mut s = u8x16.splat(0);
            let mut bad = mask8x16.none();
            for v: u8x16 in self {
                let p = s +% v.scan_add_wrap();
                bad = bad | (p < (p -% v));
                s = p.permute::<[15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15]>();
            } tail masked (v, m) {
                let p = s +% v.scan_add_wrap();
                bad = bad | (p < (p -% v));
                s = p.permute::<[15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15]>();
            }
            if bad.to_bits() == 0 { return s.reduce_max(); }
        }
        let mut t: u8 = 0;
        for i in 0..self.len() { t = t + self[i]; }
        return t;
    }

    pub fn min(&self) -> Option<u8> {
        if self.len() == 0 { return Option.None; }
        if self.len() >= LONG_B8 { return Option.Some(min_u8_cpu(self)); }
        let mut a = u8x16.splat(self[0]);
        for v: u8x16 in self { a = a.min(v); } tail masked (v, m) { a = a.min(m.select(v, a)); }
        return Option.Some(a.reduce_min());
    }

    pub fn max(&self) -> Option<u8> {
        if self.len() == 0 { return Option.None; }
        if self.len() >= LONG_B8 { return Option.Some(max_u8_cpu(self)); }
        let mut a = u8x16.splat(self[0]);
        for v: u8x16 in self { a = a.max(v); } tail masked (v, m) { a = a.max(m.select(v, a)); }
        return Option.Some(a.reduce_max());
    }

    pub fn find(&self, x: u8) -> Option<usize> {
        if self.len() >= LONG_B8 { return find_u8_cpu(self, x); }
        let k = u8x16.splat(x);
        let mut i: usize = 0;
        for v: u8x16 in self {
            let b = (v == k).to_bits();
            if b != 0 { return some_at(i, b as u64); }
            i = i + 16;
        } tail masked (v, m) {
            let b = ((v == k) & m).to_bits();
            if b != 0 { return some_at(i, b as u64); }
        }
        return Option.None;
    }

    pub fn find_byte(&self, b: u8) -> Option<usize> {
        return self.find(b);
    }

    pub fn find_any_byte(&self, set: &[u8]) -> Option<usize> {
        if self.len() >= LONG_B8 { return find_any_byte_cpu(self, set); }
        let mut i: usize = 0;
        for v: u8x16 in self {
            let mut hit = mask8x16.none();
            for j in 0..set.len() { hit = hit | (v == u8x16.splat(set[j])); }
            let b = hit.to_bits();
            if b != 0 { return some_at(i, b as u64); }
            i = i + 16;
        } tail masked (v, m) {
            let mut hit = mask8x16.none();
            for j in 0..set.len() { hit = hit | (v == u8x16.splat(set[j])); }
            let b = (hit & m).to_bits();
            if b != 0 { return some_at(i, b as u64); }
        }
        return Option.None;
    }

    pub fn eq(&self, other: &[u8]) -> bool {
        return bytes_eq_any(self, other);
    }

    pub fn fill(&mut self, x: u8) {
        if self.len() >= LONG_B8 {
            fill_u8_cpu(self, x);
            return;
        }
        let k = u8x16.splat(x);
        for v: &mut u8x16 in self { *v = k; } tail masked (v, m) { *v = k; }
    }
}

fn sum_u16(xs: &[u16]) -> Option<u16> {
    let mut s = u16x8.splat(0);
    let mut bad = mask16x8.none();
    for v: u16x8 in xs {
        let p = s +% v.scan_add_wrap();
        bad = bad | (p < (p -% v));
        s = p.permute::<[7, 7, 7, 7, 7, 7, 7, 7]>();
    } tail masked (v, m) {
        let p = s +% v.scan_add_wrap();
        bad = bad | (p < (p -% v));
        s = p.permute::<[7, 7, 7, 7, 7, 7, 7, 7]>();
    }
    if bad.to_bits() != 0 { return Option.None; }
    return Option.Some(s.reduce_max());
}

fn sum_u16_v3(xs: &[u16]) -> Option<u16> needs(avx2) {
    let mut s = u16x16.splat(0);
    let mut bad = mask16x16.none();
    for v: u16x16 in xs {
        let p = s +% v.scan_add_wrap();
        bad = bad | (p < (p -% v));
        s = p.permute::<[15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15]>();
    } tail masked (v, m) {
        let p = s +% v.scan_add_wrap();
        bad = bad | (p < (p -% v));
        s = p.permute::<[15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15]>();
    }
    if bad.to_bits() != 0 { return Option.None; }
    return Option.Some(s.reduce_max());
}

dispatch fn sum_u16_cpu(xs: &[u16]) -> Option<u16> { avx2 => sum_u16_v3, _ => sum_u16, }

fn min_u16(xs: &[u16]) -> u16 {
    let mut a = u16x8.splat(xs[0]);
    for v: u16x8 in xs { a = a.min(v); } tail masked (v, m) { a = a.min(m.select(v, a)); }
    return a.reduce_min();
}


impl [u32] {
    pub fn sum(&self) -> u32 {
        if self.len() >= LONG_B32 {
            match sum_u32_cpu(self) {
                Option.Some(s) => { return s; }
                Option.None => {}
            }
        } else {
            let mut s = u32x4.splat(0);
            let mut bad = mask32x4.none();
            for v: u32x4 in self {
                let p = s +% v.scan_add_wrap();
                bad = bad | (p < (p -% v));
                s = p.permute::<[3, 3, 3, 3]>();
            } tail masked (v, m) {
                let p = s +% v.scan_add_wrap();
                bad = bad | (p < (p -% v));
                s = p.permute::<[3, 3, 3, 3]>();
            }
            if bad.to_bits() == 0 { return s.reduce_max(); }
        }
        let mut t: u32 = 0;
        for i in 0..self.len() { t = t + self[i]; }
        return t;
    }

    pub fn min(&self) -> Option<u32> {
        if self.len() == 0 { return Option.None; }
        if self.len() >= LONG_B32 { return Option.Some(min_u32_cpu(self)); }
        let mut a = u32x4.splat(self[0]);
        for v: u32x4 in self { a = a.min(v); } tail masked (v, m) { a = a.min(m.select(v, a)); }
        return Option.Some(a.reduce_min());
    }

    pub fn max(&self) -> Option<u32> {
        if self.len() == 0 { return Option.None; }
        if self.len() >= LONG_B32 { return Option.Some(max_u32_cpu(self)); }
        let mut a = u32x4.splat(self[0]);
        for v: u32x4 in self { a = a.max(v); } tail masked (v, m) { a = a.max(m.select(v, a)); }
        return Option.Some(a.reduce_max());
    }

    pub fn find(&self, x: u32) -> Option<usize> {
        if self.len() >= LONG_B32 { return find_u32_cpu(self, x); }
        let k = u32x4.splat(x);
        let mut i: usize = 0;
        for v: u32x4 in self {
            let b = (v == k).to_bits();
            if b != 0 { return some_at(i, b as u64); }
            i = i + 4;
        } tail masked (v, m) {
            let b = ((v == k) & m).to_bits();
            if b != 0 { return some_at(i, b as u64); }
        }
        return Option.None;
    }

    pub fn eq(&self, other: &[u32]) -> bool {
        return bytes_eq_any(cast::<u32, u8>(self), cast::<u32, u8>(other));
    }

    pub fn fill(&mut self, x: u32) {
        if self.len() >= LONG_B32 {
            fill_u32_cpu(self, x);
            return;
        }
        let k = u32x4.splat(x);
        for v: &mut u32x4 in self { *v = k; } tail masked (v, m) { *v = k; }
    }
}


dispatch fn min_u16_cpu(xs: &[u16]) -> u16 { avx2 => min_u16_v3, _ => min_u16, }

fn max_u16(xs: &[u16]) -> u16 {
    let mut a = u16x8.splat(xs[0]);
    for v: u16x8 in xs { a = a.max(v); } tail masked (v, m) { a = a.max(m.select(v, a)); }
    return a.reduce_max();
}


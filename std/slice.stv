// Signed sums: p = prev + v overflowed iff prev and v have one sign and p the other.

fn sum_i8(xs: &[i8]) -> Option<i8> {
    let mut s = i8x16.splat(0);
    let mut bad = mask8x16.none();
    let z = i8x16.splat(0);
    for v: i8x16 in xs {
        let p = s +% v.scan_add_wrap();
        bad = bad | ((((p -% v) ^ p) & (v ^ p)) < z);
        s = p.permute::<[15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15]>();
    } tail masked (v, m) {
        let p = s +% v.scan_add_wrap();
        bad = bad | ((((p -% v) ^ p) & (v ^ p)) < z);
        s = p.permute::<[15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15]>();
    }
    if bad.to_bits() != 0 { return Option.None; }
    return Option.Some(s.reduce_max());
}

fn sum_i8_v3(xs: &[i8]) -> Option<i8> needs(avx2) {
    let mut s = i8x32.splat(0);
    let mut bad = mask8x32.none();
    let z = i8x32.splat(0);
    for v: i8x32 in xs {
        let p = s +% v.scan_add_wrap();
        bad = bad | ((((p -% v) ^ p) & (v ^ p)) < z);
        s = p.permute::<[31, 31, 31, 31, 31, 31, 31, 31, 31, 31, 31, 31, 31, 31, 31, 31, 31, 31, 31, 31, 31, 31, 31, 31, 31, 31, 31, 31, 31, 31, 31, 31]>();
    } tail masked (v, m) {
        let p = s +% v.scan_add_wrap();
        bad = bad | ((((p -% v) ^ p) & (v ^ p)) < z);
        s = p.permute::<[31, 31, 31, 31, 31, 31, 31, 31, 31, 31, 31, 31, 31, 31, 31, 31, 31, 31, 31, 31, 31, 31, 31, 31, 31, 31, 31, 31, 31, 31, 31, 31]>();
    }
    if bad.to_bits() != 0 { return Option.None; }
    return Option.Some(s.reduce_max());
}

dispatch fn sum_i8_cpu(xs: &[i8]) -> Option<i8> { avx2 => sum_i8_v3, _ => sum_i8, }

fn min_i8(xs: &[i8]) -> i8 {
    let mut a = i8x16.splat(xs[0]);

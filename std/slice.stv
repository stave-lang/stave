        if self.len() >= LONG_B8 { return Option.Some(min_i8_cpu(self)); }
        let mut a = i8x16.splat(self[0]);
        for v: i8x16 in self { a = a.min(v); } tail masked (v, m) { a = a.min(m.select(v, a)); }
        return Option.Some(a.reduce_min());
    }

    pub fn max(&self) -> Option<i8> {
        if self.len() == 0 { return Option.None; }
        if self.len() >= LONG_B8 { return Option.Some(max_i8_cpu(self)); }
        let mut a = i8x16.splat(self[0]);
        for v: i8x16 in self { a = a.max(v); } tail masked (v, m) { a = a.max(m.select(v, a)); }
        return Option.Some(a.reduce_max());
    }

    pub fn find(&self, x: i8) -> Option<usize> {
        return cast::<i8, u8>(self).find(x as% u8);
    }

    pub fn eq(&self, other: &[i8]) -> bool {
        return bytes_eq_any(cast::<i8, u8>(self), cast::<i8, u8>(other));
    }

    pub fn fill(&mut self, x: i8) {
        cast_mut::<i8, u8>(self).fill(x as% u8);
    }
}

fn sum_i16(xs: &[i16]) -> Option<i16> {
    let mut s = i16x8.splat(0);
    let mut bad = mask16x8.none();
    let z = i16x8.splat(0);
    for v: i16x8 in xs {
        let p = s +% v.scan_add_wrap();
        bad = bad | ((((p -% v) ^ p) & (v ^ p)) < z);
        s = p.permute::<[7, 7, 7, 7, 7, 7, 7, 7]>();
    } tail masked (v, m) {
        let p = s +% v.scan_add_wrap();
        bad = bad | ((((p -% v) ^ p) & (v ^ p)) < z);
        s = p.permute::<[7, 7, 7, 7, 7, 7, 7, 7]>();
    }
    if bad.to_bits() != 0 { return Option.None; }
    return Option.Some(s.reduce_max());
}

fn sum_i16_v3(xs: &[i16]) -> Option<i16> needs(avx2) {
    let mut s = i16x16.splat(0);
    let mut bad = mask16x16.none();
    let z = i16x16.splat(0);
    for v: i16x16 in xs {
        let p = s +% v.scan_add_wrap();
        bad = bad | ((((p -% v) ^ p) & (v ^ p)) < z);
        s = p.permute::<[15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15]>();
    } tail masked (v, m) {
        let p = s +% v.scan_add_wrap();
        bad = bad | ((((p -% v) ^ p) & (v ^ p)) < z);
        s = p.permute::<[15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15]>();
    }
    if bad.to_bits() != 0 { return Option.None; }
    return Option.Some(s.reduce_max());
}

dispatch fn sum_i16_cpu(xs: &[i16]) -> Option<i16> { avx2 => sum_i16_v3, _ => sum_i16, }

fn min_i16(xs: &[i16]) -> i16 {
    let mut a = i16x8.splat(xs[0]);

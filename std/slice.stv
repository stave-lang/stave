            s = p.permute::<[3, 3, 3, 3]>();
        } tail masked (v, m) {
            let p = s +% v.scan_add_wrap();
            bad = bad | ((((p -% v) ^ p) & (v ^ p)) < z);
            s = p.permute::<[3, 3, 3, 3]>();

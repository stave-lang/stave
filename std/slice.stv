fn min_f32(xs: &[f32]) -> f32 {
    let mut a = f32x4.splat(xs[0]);
    for v: f32x4 in xs { a = a.min(v); } tail masked (v, m) { a = a.min(m.select(v, a)); }
    return a.reduce_min();
}

fn min_f32_v3(xs: &[f32]) -> f32 needs(avx2) {
    let mut a = f32x8.splat(xs[0]);
    for v: f32x8 in xs { a = a.min(v); } tail masked (v, m) { a = a.min(m.select(v, a)); }
    return a.reduce_min();
}

dispatch fn min_f32_cpu(xs: &[f32]) -> f32 { avx2 => min_f32_v3, _ => min_f32, }

fn max_f32(xs: &[f32]) -> f32 {
    let mut a = f32x4.splat(xs[0]);
    for v: f32x4 in xs { a = a.max(v); } tail masked (v, m) { a = a.max(m.select(v, a)); }
    return a.reduce_max();
}

fn max_f32_v3(xs: &[f32]) -> f32 needs(avx2) {
    let mut a = f32x8.splat(xs[0]);
    for v: f32x8 in xs { a = a.max(v); } tail masked (v, m) { a = a.max(m.select(v, a)); }
    return a.reduce_max();
}

dispatch fn max_f32_cpu(xs: &[f32]) -> f32 { avx2 => max_f32_v3, _ => max_f32, }

fn find_f32(xs: &[f32], x: f32) -> Option<usize> {
    let k = f32x4.splat(x);
    let mut i: usize = 0;
    for v: f32x4 in xs {
        let b = (v == k).to_bits();
        if b != 0 { return some_at(i, b as u64); }
        i = i + 4;
    } tail masked (v, m) {
        let b = ((v == k) & m).to_bits();
        if b != 0 { return some_at(i, b as u64); }
    }
    return Option.None;
}

fn find_f32_v3(xs: &[f32], x: f32) -> Option<usize> needs(avx2) {
    let k = f32x8.splat(x);
    let mut i: usize = 0;
    for v: f32x8 in xs {
        let b = (v == k).to_bits();
        if b != 0 { return some_at(i, b as u64); }
        i = i + 8;
    } tail masked (v, m) {
        let b = ((v == k) & m).to_bits();
        if b != 0 { return some_at(i, b as u64); }
    }
    return Option.None;
}

dispatch fn find_f32_cpu(xs: &[f32], x: f32) -> Option<usize> { avx2 => find_f32_v3, _ => find_f32, }

fn eq_f32(a: &[f32], b: &[f32]) -> bool {
    let n = a.len();
    let mut i: usize = 0;
    while i + 4 <= n {
        if (f32x4.load(a, i) != f32x4.load(b, i)).to_bits() != 0 { return false; }
        i = i + 4;
    }
    let m = mask32x4.first_n(n - i);
    return ((f32x4.load_masked(a, i, m) != f32x4.load_masked(b, i, m)) & m).to_bits() == 0;
}

fn eq_f32_v3(a: &[f32], b: &[f32]) -> bool needs(avx2) {
    let n = a.len();
    let mut i: usize = 0;
    while i + 8 <= n {
        if (f32x8.load(a, i) != f32x8.load(b, i)).to_bits() != 0 { return false; }
        i = i + 8;
    }
    let m = mask32x8.first_n(n - i);
    return ((f32x8.load_masked(a, i, m) != f32x8.load_masked(b, i, m)) & m).to_bits() == 0;
}

dispatch fn eq_f32_cpu(a: &[f32], b: &[f32]) -> bool { avx2 => eq_f32_v3, _ => eq_f32, }

// The 32 logical lanes of an f32 sum or dot (file head) as eight f32x4, four f32x8 or two
// f32x16: lane j of register k is logical lane k * N + j, so adding register k + K/2 to
// register k is one step of the lane tree, and every arm gives the same bits. The last
// n % 32 elements go in N-element chunks, chunk c into register c; lanes past the end add
// -0.0, the additive identity (a masked load's +0.0 would turn a -0.0 lane into +0.0). The
// 128-bit loop, which short slices take, writes the chunks out; the wider ones, whose tail
// runs once per long slice, add each chunk into a0 and rotate the registers down (a0 = a1,
// .., the last = the sum), so after all K chunks every register is back in its place.
fn sum_f32(xs: &[f32]) -> f32 {
    let n = xs.len();
    let z = f32x4.splat(-0.0);
    let mut a0 = z;
    let mut a1 = z;
    let mut a2 = z;
    let mut a3 = z;
    let mut a4 = z;
    let mut a5 = z;
    let mut a6 = z;
    let mut a7 = z;
    let mut i: usize = 0;
    while i + 32 <= n {
        a0 = a0 + f32x4.load(xs, i);
        a1 = a1 + f32x4.load(xs, i + 4);
        a2 = a2 + f32x4.load(xs, i + 8);
        a3 = a3 + f32x4.load(xs, i + 12);
        a4 = a4 + f32x4.load(xs, i + 16);
        a5 = a5 + f32x4.load(xs, i + 20);
        a6 = a6 + f32x4.load(xs, i + 24);
        a7 = a7 + f32x4.load(xs, i + 28);
        i = i + 32;
    }
    if i < n {
        let j0 = i;
        if j0 + 4 <= n {
            a0 = a0 + f32x4.load(xs, j0);
        } else if j0 < n {
            let m = mask32x4.first_n(n - j0);
            a0 = a0 + m.select(f32x4.load_masked(xs, j0, m), z);
        }
        let j1 = i + 4;
        if j1 + 4 <= n {
            a1 = a1 + f32x4.load(xs, j1);
        } else if j1 < n {
            let m = mask32x4.first_n(n - j1);
            a1 = a1 + m.select(f32x4.load_masked(xs, j1, m), z);
        }
        let j2 = i + 8;
        if j2 + 4 <= n {
            a2 = a2 + f32x4.load(xs, j2);
        } else if j2 < n {
            let m = mask32x4.first_n(n - j2);
            a2 = a2 + m.select(f32x4.load_masked(xs, j2, m), z);
        }
        let j3 = i + 12;
        if j3 + 4 <= n {
            a3 = a3 + f32x4.load(xs, j3);
        } else if j3 < n {
            let m = mask32x4.first_n(n - j3);
            a3 = a3 + m.select(f32x4.load_masked(xs, j3, m), z);
        }
        let j4 = i + 16;
        if j4 + 4 <= n {
            a4 = a4 + f32x4.load(xs, j4);
        } else if j4 < n {
            let m = mask32x4.first_n(n - j4);
            a4 = a4 + m.select(f32x4.load_masked(xs, j4, m), z);
        }
        let j5 = i + 20;
        if j5 + 4 <= n {
            a5 = a5 + f32x4.load(xs, j5);
        } else if j5 < n {
            let m = mask32x4.first_n(n - j5);
            a5 = a5 + m.select(f32x4.load_masked(xs, j5, m), z);
        }
        let j6 = i + 24;
        if j6 + 4 <= n {
            a6 = a6 + f32x4.load(xs, j6);
        } else if j6 < n {
            let m = mask32x4.first_n(n - j6);
            a6 = a6 + m.select(f32x4.load_masked(xs, j6, m), z);
        }
        let j7 = i + 28;
        if j7 + 4 <= n {
            a7 = a7 + f32x4.load(xs, j7);
        } else if j7 < n {
            let m = mask32x4.first_n(n - j7);
            a7 = a7 + m.select(f32x4.load_masked(xs, j7, m), z);
        }
    }
    return (((a0 + a4) + (a2 + a6)) + ((a1 + a5) + (a3 + a7))).reduce_add();
}

fn dot_f32(xs: &[f32], ys: &[f32]) -> f32 {
    let n = xs.len();
    let y = &ys[0..n];
    let z = f32x4.splat(-0.0);
    let mut a0 = z;
    let mut a1 = z;
    let mut a2 = z;
    let mut a3 = z;
    let mut a4 = z;
    let mut a5 = z;
    let mut a6 = z;
    let mut a7 = z;
    let mut i: usize = 0;
    while i + 32 <= n {
        a0 = a0 + f32x4.load(xs, i) * f32x4.load(y, i);
        a1 = a1 + f32x4.load(xs, i + 4) * f32x4.load(y, i + 4);
        a2 = a2 + f32x4.load(xs, i + 8) * f32x4.load(y, i + 8);
        a3 = a3 + f32x4.load(xs, i + 12) * f32x4.load(y, i + 12);
        a4 = a4 + f32x4.load(xs, i + 16) * f32x4.load(y, i + 16);
        a5 = a5 + f32x4.load(xs, i + 20) * f32x4.load(y, i + 20);
        a6 = a6 + f32x4.load(xs, i + 24) * f32x4.load(y, i + 24);
        a7 = a7 + f32x4.load(xs, i + 28) * f32x4.load(y, i + 28);
        i = i + 32;
    }
    if i < n {
        let j0 = i;
        if j0 + 4 <= n {
            a0 = a0 + f32x4.load(xs, j0) * f32x4.load(y, j0);
        } else if j0 < n {
            let m = mask32x4.first_n(n - j0);
            a0 = a0 + m.select(f32x4.load_masked(xs, j0, m) * f32x4.load_masked(y, j0, m), z);
        }
        let j1 = i + 4;
        if j1 + 4 <= n {
            a1 = a1 + f32x4.load(xs, j1) * f32x4.load(y, j1);
        } else if j1 < n {
            let m = mask32x4.first_n(n - j1);
            a1 = a1 + m.select(f32x4.load_masked(xs, j1, m) * f32x4.load_masked(y, j1, m), z);
        }
        let j2 = i + 8;
        if j2 + 4 <= n {
            a2 = a2 + f32x4.load(xs, j2) * f32x4.load(y, j2);
        } else if j2 < n {
            let m = mask32x4.first_n(n - j2);
            a2 = a2 + m.select(f32x4.load_masked(xs, j2, m) * f32x4.load_masked(y, j2, m), z);
        }
        let j3 = i + 12;
        if j3 + 4 <= n {
            a3 = a3 + f32x4.load(xs, j3) * f32x4.load(y, j3);
        } else if j3 < n {
            let m = mask32x4.first_n(n - j3);
            a3 = a3 + m.select(f32x4.load_masked(xs, j3, m) * f32x4.load_masked(y, j3, m), z);
        }
        let j4 = i + 16;
        if j4 + 4 <= n {
            a4 = a4 + f32x4.load(xs, j4) * f32x4.load(y, j4);
        } else if j4 < n {
            let m = mask32x4.first_n(n - j4);
            a4 = a4 + m.select(f32x4.load_masked(xs, j4, m) * f32x4.load_masked(y, j4, m), z);
        }
        let j5 = i + 20;
        if j5 + 4 <= n {
            a5 = a5 + f32x4.load(xs, j5) * f32x4.load(y, j5);
        } else if j5 < n {
            let m = mask32x4.first_n(n - j5);
            a5 = a5 + m.select(f32x4.load_masked(xs, j5, m) * f32x4.load_masked(y, j5, m), z);
        }
        let j6 = i + 24;
        if j6 + 4 <= n {
            a6 = a6 + f32x4.load(xs, j6) * f32x4.load(y, j6);
        } else if j6 < n {
            let m = mask32x4.first_n(n - j6);
            a6 = a6 + m.select(f32x4.load_masked(xs, j6, m) * f32x4.load_masked(y, j6, m), z);
        }
        let j7 = i + 28;
        if j7 + 4 <= n {
            a7 = a7 + f32x4.load(xs, j7) * f32x4.load(y, j7);
        } else if j7 < n {
            let m = mask32x4.first_n(n - j7);
            a7 = a7 + m.select(f32x4.load_masked(xs, j7, m) * f32x4.load_masked(y, j7, m), z);
        }
    }
    return (((a0 + a4) + (a2 + a6)) + ((a1 + a5) + (a3 + a7))).reduce_add();
}

fn sum_f32_v3(xs: &[f32]) -> f32 needs(avx2) {
    let n = xs.len();
    let z = f32x8.splat(-0.0);
    let mut a0 = z;
    let mut a1 = z;
    let mut a2 = z;
    let mut a3 = z;
    let mut i: usize = 0;
    while i + 32 <= n {
        a0 = a0 + f32x8.load(xs, i);
        a1 = a1 + f32x8.load(xs, i + 8);
        a2 = a2 + f32x8.load(xs, i + 16);
        a3 = a3 + f32x8.load(xs, i + 24);
        i = i + 32;
    }
    if i < n {
        for c in 0usize..4 {
            let j = i + c * 8;
            let mut v = z;
            if j + 8 <= n {
                v = f32x8.load(xs, j);
            } else if j < n {
                let m = mask32x8.first_n(n - j);
                v = m.select(f32x8.load_masked(xs, j, m), z);
            }
            let t = a0 + v;
            a0 = a1;
            a1 = a2;
            a2 = a3;
            a3 = t;
        }
    }
    return ((a0 + a2) + (a1 + a3)).reduce_add();
}

fn dot_f32_v3(xs: &[f32], ys: &[f32]) -> f32 needs(avx2) {
    let n = xs.len();
    let y = &ys[0..n];
    let z = f32x8.splat(-0.0);
    let mut a0 = z;
    let mut a1 = z;
    let mut a2 = z;
    let mut a3 = z;
    let mut i: usize = 0;
    while i + 32 <= n {
        a0 = a0 + f32x8.load(xs, i) * f32x8.load(y, i);
        a1 = a1 + f32x8.load(xs, i + 8) * f32x8.load(y, i + 8);
        a2 = a2 + f32x8.load(xs, i + 16) * f32x8.load(y, i + 16);
        a3 = a3 + f32x8.load(xs, i + 24) * f32x8.load(y, i + 24);
        i = i + 32;
    }
    if i < n {
        for c in 0usize..4 {
            let j = i + c * 8;
            let mut v = z;
            if j + 8 <= n {
                v = f32x8.load(xs, j) * f32x8.load(y, j);
            } else if j < n {
                let m = mask32x8.first_n(n - j);
                v = m.select(f32x8.load_masked(xs, j, m) * f32x8.load_masked(y, j, m), z);
            }
            let t = a0 + v;
            a0 = a1;
            a1 = a2;
            a2 = a3;
            a3 = t;
        }
    }
    return ((a0 + a2) + (a1 + a3)).reduce_add();
}

fn sum_f32_v4(xs: &[f32]) -> f32 needs(v4) {
    let n = xs.len();
    let z = f32x16.splat(-0.0);
    let mut a0 = z;
    let mut a1 = z;
    let mut i: usize = 0;
    while i + 32 <= n {
        a0 = a0 + f32x16.load(xs, i);
        a1 = a1 + f32x16.load(xs, i + 16);
        i = i + 32;
    }
    if i < n {
        for c in 0usize..2 {
            let j = i + c * 16;
            let mut v = z;
            if j + 16 <= n {
                v = f32x16.load(xs, j);
            } else if j < n {
                let m = mask32x16.first_n(n - j);
                v = m.select(f32x16.load_masked(xs, j, m), z);
            }
            let t = a0 + v;
            a0 = a1;
            a1 = t;
        }
    }
    return (a0 + a1).reduce_add();
}

fn dot_f32_v4(xs: &[f32], ys: &[f32]) -> f32 needs(v4) {
    let n = xs.len();
    let y = &ys[0..n];
    let z = f32x16.splat(-0.0);
    let mut a0 = z;
    let mut a1 = z;
    let mut i: usize = 0;
    while i + 32 <= n {
        a0 = a0 + f32x16.load(xs, i) * f32x16.load(y, i);
        a1 = a1 + f32x16.load(xs, i + 16) * f32x16.load(y, i + 16);
        i = i + 32;
    }
    if i < n {
        for c in 0usize..2 {
            let j = i + c * 16;
            let mut v = z;
            if j + 16 <= n {
                v = f32x16.load(xs, j) * f32x16.load(y, j);
            } else if j < n {
                let m = mask32x16.first_n(n - j);
                v = m.select(f32x16.load_masked(xs, j, m) * f32x16.load_masked(y, j, m), z);
            }
            let t = a0 + v;
            a0 = a1;
            a1 = t;
        }
    }
    return (a0 + a1).reduce_add();
}

dispatch fn sum_f32_cpu(xs: &[f32]) -> f32 { v4 => sum_f32_v4, avx2 => sum_f32_v3, _ => sum_f32, }

dispatch fn dot_f32_cpu(xs: &[f32], ys: &[f32]) -> f32 { v4 => dot_f32_v4, avx2 => dot_f32_v3, _ => dot_f32, }

// The block tree (file head) over the block sums of a f32 sum or dot, in one pass: the stack
// holds the sums of complete tree nodes, the earliest and largest at the bottom. Pushing block
// c adds the top entry before it (top + new) once per trailing 1 bit of c; `finish` adds the
// entries from the top down (entry + sum so far), which is the tree's right edge.
struct BlockTree32 {
    s: [f32; 64],
    top: usize,
    count: u64,
}

impl BlockTree32 {
    fn new() -> BlockTree32 {
        return BlockTree32.{ s: [-0.0; 64], top: 0, count: 0 };
    }

    fn push(&mut self, x: f32) {
        let mut v = x;
        let mut c = self.count;
        while (c & 1) == 1 {
            self.top = self.top - 1;
            v = self.s[self.top] + v;
            c = c >> 1;
        }
        self.s[self.top] = v;
        self.top = self.top + 1;
        self.count = self.count + 1;
    }

    fn finish(&self) -> f32 {
        if self.top == 0 { return -0.0; }
        let mut k = self.top - 1;
        let mut v = self.s[k];
        while k > 0 {
            k = k - 1;
            v = self.s[k] + v;
        }
        return v;
    }
}

fn sum2_f32(xs: &[f32]) -> f32 {
    let n = xs.len();
    let mut t = BlockTree32.new();
    let mut i: usize = 0;
    while i < n {
        let e = (n - i < SUM_BLOCK).select(n, i + SUM_BLOCK);
        t.push(sum_f32(&xs[i..e]));
        i = e;
    }
    return t.finish();
}

fn dot2_f32(xs: &[f32], ys: &[f32]) -> f32 {
    let n = xs.len();
    let y = &ys[0..n];
    let mut t = BlockTree32.new();
    let mut i: usize = 0;
    while i < n {
        let e = (n - i < SUM_BLOCK).select(n, i + SUM_BLOCK);
        t.push(dot_f32(&xs[i..e], &y[i..e]));
        i = e;
    }
    return t.finish();
}

fn sum2_f32_v3(xs: &[f32]) -> f32 needs(avx2) {
    let n = xs.len();
    let mut t = BlockTree32.new();
    let mut i: usize = 0;
    while i < n {
        let e = (n - i < SUM_BLOCK).select(n, i + SUM_BLOCK);
        t.push(sum_f32_v3(&xs[i..e]));
        i = e;
    }
    return t.finish();
}

fn dot2_f32_v3(xs: &[f32], ys: &[f32]) -> f32 needs(avx2) {
    let n = xs.len();
    let y = &ys[0..n];
    let mut t = BlockTree32.new();
    let mut i: usize = 0;
    while i < n {
        let e = (n - i < SUM_BLOCK).select(n, i + SUM_BLOCK);
        t.push(dot_f32_v3(&xs[i..e], &y[i..e]));
        i = e;
    }
    return t.finish();
}

fn sum2_f32_v4(xs: &[f32]) -> f32 needs(v4) {
    let n = xs.len();
    let mut t = BlockTree32.new();
    let mut i: usize = 0;
    while i < n {
        let e = (n - i < SUM_BLOCK).select(n, i + SUM_BLOCK);
        t.push(sum_f32_v4(&xs[i..e]));
        i = e;
    }
    return t.finish();
}

fn dot2_f32_v4(xs: &[f32], ys: &[f32]) -> f32 needs(v4) {
    let n = xs.len();
    let y = &ys[0..n];
    let mut t = BlockTree32.new();
    let mut i: usize = 0;
    while i < n {
        let e = (n - i < SUM_BLOCK).select(n, i + SUM_BLOCK);
        t.push(dot_f32_v4(&xs[i..e], &y[i..e]));
        i = e;
    }
    return t.finish();
}

dispatch fn sum2_f32_cpu(xs: &[f32]) -> f32 { v4 => sum2_f32_v4, avx2 => sum2_f32_v3, _ => sum2_f32, }

dispatch fn dot2_f32_cpu(xs: &[f32], ys: &[f32]) -> f32 { v4 => dot2_f32_v4, avx2 => dot2_f32_v3, _ => dot2_f32, }

impl [f32] {
    pub fn sum(&self) -> f32 {
        if self.len() < LONG_B32 { return sum_f32(self); }
        if self.len() <= SUM_BLOCK { return sum_f32_cpu(self); }
        return sum2_f32_cpu(self);
    }

    pub fn dot(&self, other: &[f32]) -> f32 {
        debug.assert(self.len() == other.len(), "dot: the slices differ in length");
        if self.len() < LONG_B32 { return dot_f32(self, other); }
        if self.len() <= SUM_BLOCK { return dot_f32_cpu(self, other); }
        return dot2_f32_cpu(self, other);
    }

    pub fn min(&self) -> Option<f32> {
        if self.len() == 0 { return Option.None; }
        let mut r: f32 = 0.0;
        if self.len() >= LONG_B32 {
            r = min_f32_cpu(self);
        } else {
            let mut a = f32x4.splat(self[0]);
            for v: f32x4 in self { a = a.min(v); } tail masked (v, m) { a = a.min(m.select(v, a)); }
            r = a.reduce_min();
        }
        return Option.Some(if r != r then mem.f32_from_bits(0x7fc00000) else r);
    }

    pub fn max(&self) -> Option<f32> {
        if self.len() == 0 { return Option.None; }
        let mut r: f32 = 0.0;
        if self.len() >= LONG_B32 {
            r = max_f32_cpu(self);
        } else {
            let mut a = f32x4.splat(self[0]);
            for v: f32x4 in self { a = a.max(v); } tail masked (v, m) { a = a.max(m.select(v, a)); }
            r = a.reduce_max();
        }
        return Option.Some(if r != r then mem.f32_from_bits(0x7fc00000) else r);
    }

    pub fn find(&self, x: f32) -> Option<usize> {
        if self.len() >= LONG_B32 { return find_f32_cpu(self, x); }
        let k = f32x4.splat(x);
        let mut i: usize = 0;
        for v: f32x4 in self {
            let b = (v == k).to_bits();
            if b != 0 { return some_at(i, b as u64); }
            i = i + 4;
        } tail masked (v, m) {
            let b = ((v == k) & m).to_bits();
            if b != 0 { return some_at(i, b as u64); }
        }
        return Option.None;
    }

    pub fn eq(&self, other: &[f32]) -> bool {
        if self.len() != other.len() { return false; }
        if self.len() >= LONG_B32 { return eq_f32_cpu(self, other); }
        let n = self.len();
        let mut i: usize = 0;
        while i + 4 <= n {
            if (f32x4.load(self, i) != f32x4.load(other, i)).to_bits() != 0 { return false; }
            i = i + 4;
        }
        let m = mask32x4.first_n(n - i);
        return ((f32x4.load_masked(self, i, m) != f32x4.load_masked(other, i, m)) & m).to_bits() == 0;
    }

    pub fn fill(&mut self, x: f32) {
        cast_mut::<f32, u32>(self).fill(mem.f32_bits(x));
    }
}

fn min_f64(xs: &[f64]) -> f64 {
    let mut a = f64x2.splat(xs[0]);
    for v: f64x2 in xs { a = a.min(v); } tail masked (v, m) { a = a.min(m.select(v, a)); }
    return a.reduce_min();
}

fn min_f64_v3(xs: &[f64]) -> f64 needs(avx2) {
    let mut a = f64x4.splat(xs[0]);
    for v: f64x4 in xs { a = a.min(v); } tail masked (v, m) { a = a.min(m.select(v, a)); }
    return a.reduce_min();
}

dispatch fn min_f64_cpu(xs: &[f64]) -> f64 { avx2 => min_f64_v3, _ => min_f64, }

fn max_f64(xs: &[f64]) -> f64 {
    let mut a = f64x2.splat(xs[0]);
    for v: f64x2 in xs { a = a.max(v); } tail masked (v, m) { a = a.max(m.select(v, a)); }
    return a.reduce_max();
}

fn max_f64_v3(xs: &[f64]) -> f64 needs(avx2) {
    let mut a = f64x4.splat(xs[0]);
    for v: f64x4 in xs { a = a.max(v); } tail masked (v, m) { a = a.max(m.select(v, a)); }
    return a.reduce_max();
}

dispatch fn max_f64_cpu(xs: &[f64]) -> f64 { avx2 => max_f64_v3, _ => max_f64, }

fn find_f64(xs: &[f64], x: f64) -> Option<usize> {
    let k = f64x2.splat(x);
    let mut i: usize = 0;
    for v: f64x2 in xs {
        let b = (v == k).to_bits();
        if b != 0 { return some_at(i, b as u64); }
        i = i + 2;
    } tail masked (v, m) {
        let b = ((v == k) & m).to_bits();
        if b != 0 { return some_at(i, b as u64); }
    }
    return Option.None;
}

fn find_f64_v3(xs: &[f64], x: f64) -> Option<usize> needs(avx2) {
    let k = f64x4.splat(x);
    let mut i: usize = 0;
    for v: f64x4 in xs {
        let b = (v == k).to_bits();
        if b != 0 { return some_at(i, b as u64); }
        i = i + 4;
    } tail masked (v, m) {
        let b = ((v == k) & m).to_bits();
        if b != 0 { return some_at(i, b as u64); }
    }
    return Option.None;
}

dispatch fn find_f64_cpu(xs: &[f64], x: f64) -> Option<usize> { avx2 => find_f64_v3, _ => find_f64, }

fn eq_f64(a: &[f64], b: &[f64]) -> bool {
    let n = a.len();
    let mut i: usize = 0;
    while i + 2 <= n {
        if (f64x2.load(a, i) != f64x2.load(b, i)).to_bits() != 0 { return false; }
        i = i + 2;
    }
    let m = mask64x2.first_n(n - i);
    return ((f64x2.load_masked(a, i, m) != f64x2.load_masked(b, i, m)) & m).to_bits() == 0;
}

fn eq_f64_v3(a: &[f64], b: &[f64]) -> bool needs(avx2) {
    let n = a.len();
    let mut i: usize = 0;
    while i + 4 <= n {
        if (f64x4.load(a, i) != f64x4.load(b, i)).to_bits() != 0 { return false; }
        i = i + 4;
    }
    let m = mask64x4.first_n(n - i);
    return ((f64x4.load_masked(a, i, m) != f64x4.load_masked(b, i, m)) & m).to_bits() == 0;
}

dispatch fn eq_f64_cpu(a: &[f64], b: &[f64]) -> bool { avx2 => eq_f64_v3, _ => eq_f64, }

// The 16 logical lanes of an f64 sum or dot (file head) as eight f64x2, four f64x4 or two
// f64x8, laid out as for f32.
fn sum_f64(xs: &[f64]) -> f64 {
    let n = xs.len();
    let z = f64x2.splat(-0.0);
    let mut a0 = z;
    let mut a1 = z;
    let mut a2 = z;
    let mut a3 = z;
    let mut a4 = z;
    let mut a5 = z;
    let mut a6 = z;
    let mut a7 = z;
    let mut i: usize = 0;
    while i + 16 <= n {
        a0 = a0 + f64x2.load(xs, i);
        a1 = a1 + f64x2.load(xs, i + 2);
        a2 = a2 + f64x2.load(xs, i + 4);
        a3 = a3 + f64x2.load(xs, i + 6);
        a4 = a4 + f64x2.load(xs, i + 8);
        a5 = a5 + f64x2.load(xs, i + 10);
        a6 = a6 + f64x2.load(xs, i + 12);
        a7 = a7 + f64x2.load(xs, i + 14);
        i = i + 16;
    }
    if i < n {
        let j0 = i;
        if j0 + 2 <= n {
            a0 = a0 + f64x2.load(xs, j0);
        } else if j0 < n {
            let m = mask64x2.first_n(n - j0);
            a0 = a0 + m.select(f64x2.load_masked(xs, j0, m), z);
        }
        let j1 = i + 2;
        if j1 + 2 <= n {
            a1 = a1 + f64x2.load(xs, j1);
        } else if j1 < n {
            let m = mask64x2.first_n(n - j1);
            a1 = a1 + m.select(f64x2.load_masked(xs, j1, m), z);
        }
        let j2 = i + 4;
        if j2 + 2 <= n {
            a2 = a2 + f64x2.load(xs, j2);
        } else if j2 < n {
            let m = mask64x2.first_n(n - j2);
            a2 = a2 + m.select(f64x2.load_masked(xs, j2, m), z);
        }
        let j3 = i + 6;
        if j3 + 2 <= n {
            a3 = a3 + f64x2.load(xs, j3);
        } else if j3 < n {
            let m = mask64x2.first_n(n - j3);
            a3 = a3 + m.select(f64x2.load_masked(xs, j3, m), z);
        }
        let j4 = i + 8;
        if j4 + 2 <= n {
            a4 = a4 + f64x2.load(xs, j4);
        } else if j4 < n {
            let m = mask64x2.first_n(n - j4);
            a4 = a4 + m.select(f64x2.load_masked(xs, j4, m), z);
        }
        let j5 = i + 10;
        if j5 + 2 <= n {
            a5 = a5 + f64x2.load(xs, j5);
        } else if j5 < n {
            let m = mask64x2.first_n(n - j5);
            a5 = a5 + m.select(f64x2.load_masked(xs, j5, m), z);
        }
        let j6 = i + 12;
        if j6 + 2 <= n {
            a6 = a6 + f64x2.load(xs, j6);
        } else if j6 < n {
            let m = mask64x2.first_n(n - j6);
            a6 = a6 + m.select(f64x2.load_masked(xs, j6, m), z);
        }
        let j7 = i + 14;
        if j7 + 2 <= n {
            a7 = a7 + f64x2.load(xs, j7);
        } else if j7 < n {
            let m = mask64x2.first_n(n - j7);
            a7 = a7 + m.select(f64x2.load_masked(xs, j7, m), z);
        }
    }
    return (((a0 + a4) + (a2 + a6)) + ((a1 + a5) + (a3 + a7))).reduce_add();
}

fn dot_f64(xs: &[f64], ys: &[f64]) -> f64 {
    let n = xs.len();
    let y = &ys[0..n];
    let z = f64x2.splat(-0.0);
    let mut a0 = z;
    let mut a1 = z;
    let mut a2 = z;
    let mut a3 = z;
    let mut a4 = z;
    let mut a5 = z;
    let mut a6 = z;
    let mut a7 = z;
    let mut i: usize = 0;
    while i + 16 <= n {
        a0 = a0 + f64x2.load(xs, i) * f64x2.load(y, i);
        a1 = a1 + f64x2.load(xs, i + 2) * f64x2.load(y, i + 2);
        a2 = a2 + f64x2.load(xs, i + 4) * f64x2.load(y, i + 4);
        a3 = a3 + f64x2.load(xs, i + 6) * f64x2.load(y, i + 6);
        a4 = a4 + f64x2.load(xs, i + 8) * f64x2.load(y, i + 8);
        a5 = a5 + f64x2.load(xs, i + 10) * f64x2.load(y, i + 10);
        a6 = a6 + f64x2.load(xs, i + 12) * f64x2.load(y, i + 12);
        a7 = a7 + f64x2.load(xs, i + 14) * f64x2.load(y, i + 14);
        i = i + 16;
    }
    if i < n {
        let j0 = i;
        if j0 + 2 <= n {
            a0 = a0 + f64x2.load(xs, j0) * f64x2.load(y, j0);
        } else if j0 < n {
            let m = mask64x2.first_n(n - j0);
            a0 = a0 + m.select(f64x2.load_masked(xs, j0, m) * f64x2.load_masked(y, j0, m), z);
        }
        let j1 = i + 2;
        if j1 + 2 <= n {
            a1 = a1 + f64x2.load(xs, j1) * f64x2.load(y, j1);
        } else if j1 < n {
            let m = mask64x2.first_n(n - j1);
            a1 = a1 + m.select(f64x2.load_masked(xs, j1, m) * f64x2.load_masked(y, j1, m), z);
        }
        let j2 = i + 4;
        if j2 + 2 <= n {
            a2 = a2 + f64x2.load(xs, j2) * f64x2.load(y, j2);
        } else if j2 < n {
            let m = mask64x2.first_n(n - j2);
            a2 = a2 + m.select(f64x2.load_masked(xs, j2, m) * f64x2.load_masked(y, j2, m), z);
        }
        let j3 = i + 6;
        if j3 + 2 <= n {
            a3 = a3 + f64x2.load(xs, j3) * f64x2.load(y, j3);
        } else if j3 < n {
            let m = mask64x2.first_n(n - j3);
            a3 = a3 + m.select(f64x2.load_masked(xs, j3, m) * f64x2.load_masked(y, j3, m), z);
        }
        let j4 = i + 8;
        if j4 + 2 <= n {
            a4 = a4 + f64x2.load(xs, j4) * f64x2.load(y, j4);
        } else if j4 < n {
            let m = mask64x2.first_n(n - j4);
            a4 = a4 + m.select(f64x2.load_masked(xs, j4, m) * f64x2.load_masked(y, j4, m), z);
        }
        let j5 = i + 10;
        if j5 + 2 <= n {
            a5 = a5 + f64x2.load(xs, j5) * f64x2.load(y, j5);
        } else if j5 < n {
            let m = mask64x2.first_n(n - j5);
            a5 = a5 + m.select(f64x2.load_masked(xs, j5, m) * f64x2.load_masked(y, j5, m), z);
        }
        let j6 = i + 12;
        if j6 + 2 <= n {
            a6 = a6 + f64x2.load(xs, j6) * f64x2.load(y, j6);
        } else if j6 < n {
            let m = mask64x2.first_n(n - j6);
            a6 = a6 + m.select(f64x2.load_masked(xs, j6, m) * f64x2.load_masked(y, j6, m), z);
        }
        let j7 = i + 14;
        if j7 + 2 <= n {
            a7 = a7 + f64x2.load(xs, j7) * f64x2.load(y, j7);
        } else if j7 < n {
            let m = mask64x2.first_n(n - j7);
            a7 = a7 + m.select(f64x2.load_masked(xs, j7, m) * f64x2.load_masked(y, j7, m), z);
        }
    }
    return (((a0 + a4) + (a2 + a6)) + ((a1 + a5) + (a3 + a7))).reduce_add();
}

fn sum_f64_v3(xs: &[f64]) -> f64 needs(avx2) {
    let n = xs.len();
    let z = f64x4.splat(-0.0);
    let mut a0 = z;
    let mut a1 = z;
    let mut a2 = z;
    let mut a3 = z;
    let mut i: usize = 0;
    while i + 16 <= n {
        a0 = a0 + f64x4.load(xs, i);
        a1 = a1 + f64x4.load(xs, i + 4);
        a2 = a2 + f64x4.load(xs, i + 8);
        a3 = a3 + f64x4.load(xs, i + 12);
        i = i + 16;
    }
    if i < n {
        for c in 0usize..4 {
            let j = i + c * 4;
            let mut v = z;
            if j + 4 <= n {
                v = f64x4.load(xs, j);
            } else if j < n {
                let m = mask64x4.first_n(n - j);
                v = m.select(f64x4.load_masked(xs, j, m), z);
            }
            let t = a0 + v;
            a0 = a1;
            a1 = a2;
            a2 = a3;
            a3 = t;
        }
    }
    return ((a0 + a2) + (a1 + a3)).reduce_add();
}

fn dot_f64_v3(xs: &[f64], ys: &[f64]) -> f64 needs(avx2) {
    let n = xs.len();
    let y = &ys[0..n];
    let z = f64x4.splat(-0.0);
    let mut a0 = z;
    let mut a1 = z;
    let mut a2 = z;
    let mut a3 = z;
    let mut i: usize = 0;
    while i + 16 <= n {
        a0 = a0 + f64x4.load(xs, i) * f64x4.load(y, i);
        a1 = a1 + f64x4.load(xs, i + 4) * f64x4.load(y, i + 4);
        a2 = a2 + f64x4.load(xs, i + 8) * f64x4.load(y, i + 8);
        a3 = a3 + f64x4.load(xs, i + 12) * f64x4.load(y, i + 12);
        i = i + 16;
    }
    if i < n {
        for c in 0usize..4 {
            let j = i + c * 4;
            let mut v = z;
            if j + 4 <= n {
                v = f64x4.load(xs, j) * f64x4.load(y, j);
            } else if j < n {
                let m = mask64x4.first_n(n - j);
                v = m.select(f64x4.load_masked(xs, j, m) * f64x4.load_masked(y, j, m), z);
            }
            let t = a0 + v;
            a0 = a1;
            a1 = a2;
            a2 = a3;
            a3 = t;
        }
    }
    return ((a0 + a2) + (a1 + a3)).reduce_add();
}

fn sum_f64_v4(xs: &[f64]) -> f64 needs(v4) {
    let n = xs.len();
    let z = f64x8.splat(-0.0);
    let mut a0 = z;
    let mut a1 = z;
    let mut i: usize = 0;
    while i + 16 <= n {
        a0 = a0 + f64x8.load(xs, i);
        a1 = a1 + f64x8.load(xs, i + 8);
        i = i + 16;
    }
    if i < n {
        for c in 0usize..2 {
            let j = i + c * 8;
            let mut v = z;
            if j + 8 <= n {
                v = f64x8.load(xs, j);
            } else if j < n {
                let m = mask64x8.first_n(n - j);
                v = m.select(f64x8.load_masked(xs, j, m), z);
            }
            let t = a0 + v;
            a0 = a1;
            a1 = t;
        }
    }
    return (a0 + a1).reduce_add();
}

fn dot_f64_v4(xs: &[f64], ys: &[f64]) -> f64 needs(v4) {
    let n = xs.len();
    let y = &ys[0..n];
    let z = f64x8.splat(-0.0);
    let mut a0 = z;
    let mut a1 = z;
    let mut i: usize = 0;
    while i + 16 <= n {
        a0 = a0 + f64x8.load(xs, i) * f64x8.load(y, i);
        a1 = a1 + f64x8.load(xs, i + 8) * f64x8.load(y, i + 8);
        i = i + 16;
    }
    if i < n {
        for c in 0usize..2 {
            let j = i + c * 8;
            let mut v = z;
            if j + 8 <= n {
                v = f64x8.load(xs, j) * f64x8.load(y, j);
            } else if j < n {
                let m = mask64x8.first_n(n - j);
                v = m.select(f64x8.load_masked(xs, j, m) * f64x8.load_masked(y, j, m), z);
            }
            let t = a0 + v;
            a0 = a1;
            a1 = t;
        }
    }
    return (a0 + a1).reduce_add();
}

dispatch fn sum_f64_cpu(xs: &[f64]) -> f64 { v4 => sum_f64_v4, avx2 => sum_f64_v3, _ => sum_f64, }

dispatch fn dot_f64_cpu(xs: &[f64], ys: &[f64]) -> f64 { v4 => dot_f64_v4, avx2 => dot_f64_v3, _ => dot_f64, }

// The block tree (file head) over the block sums of a f64 sum or dot, in one pass: the stack
// holds the sums of complete tree nodes, the earliest and largest at the bottom. Pushing block
// c adds the top entry before it (top + new) once per trailing 1 bit of c; `finish` adds the
// entries from the top down (entry + sum so far), which is the tree's right edge.
struct BlockTree64 {
    s: [f64; 64],
    top: usize,
    count: u64,
}

impl BlockTree64 {
    fn new() -> BlockTree64 {
        return BlockTree64.{ s: [-0.0; 64], top: 0, count: 0 };
    }

    fn push(&mut self, x: f64) {
        let mut v = x;
        let mut c = self.count;
        while (c & 1) == 1 {
            self.top = self.top - 1;
            v = self.s[self.top] + v;
            c = c >> 1;
        }
        self.s[self.top] = v;
        self.top = self.top + 1;
        self.count = self.count + 1;
    }

    fn finish(&self) -> f64 {
        if self.top == 0 { return -0.0; }
        let mut k = self.top - 1;
        let mut v = self.s[k];
        while k > 0 {
            k = k - 1;
            v = self.s[k] + v;
        }
        return v;
    }
}

fn sum2_f64(xs: &[f64]) -> f64 {
    let n = xs.len();
    let mut t = BlockTree64.new();
    let mut i: usize = 0;
    while i < n {
        let e = (n - i < SUM_BLOCK).select(n, i + SUM_BLOCK);
        t.push(sum_f64(&xs[i..e]));
        i = e;
    }
    return t.finish();
}

fn dot2_f64(xs: &[f64], ys: &[f64]) -> f64 {
    let n = xs.len();
    let y = &ys[0..n];
    let mut t = BlockTree64.new();
    let mut i: usize = 0;
    while i < n {
        let e = (n - i < SUM_BLOCK).select(n, i + SUM_BLOCK);
        t.push(dot_f64(&xs[i..e], &y[i..e]));
        i = e;
    }
    return t.finish();
}

fn sum2_f64_v3(xs: &[f64]) -> f64 needs(avx2) {
    let n = xs.len();
    let mut t = BlockTree64.new();
    let mut i: usize = 0;
    while i < n {
        let e = (n - i < SUM_BLOCK).select(n, i + SUM_BLOCK);
        t.push(sum_f64_v3(&xs[i..e]));
        i = e;
    }
    return t.finish();
}

fn dot2_f64_v3(xs: &[f64], ys: &[f64]) -> f64 needs(avx2) {
    let n = xs.len();
    let y = &ys[0..n];
    let mut t = BlockTree64.new();
    let mut i: usize = 0;
    while i < n {
        let e = (n - i < SUM_BLOCK).select(n, i + SUM_BLOCK);
        t.push(dot_f64_v3(&xs[i..e], &y[i..e]));
        i = e;
    }
    return t.finish();
}

fn sum2_f64_v4(xs: &[f64]) -> f64 needs(v4) {
    let n = xs.len();
    let mut t = BlockTree64.new();
    let mut i: usize = 0;
    while i < n {
        let e = (n - i < SUM_BLOCK).select(n, i + SUM_BLOCK);
        t.push(sum_f64_v4(&xs[i..e]));
        i = e;
    }
    return t.finish();
}

fn dot2_f64_v4(xs: &[f64], ys: &[f64]) -> f64 needs(v4) {
    let n = xs.len();
    let y = &ys[0..n];
    let mut t = BlockTree64.new();
    let mut i: usize = 0;
    while i < n {
        let e = (n - i < SUM_BLOCK).select(n, i + SUM_BLOCK);
        t.push(dot_f64_v4(&xs[i..e], &y[i..e]));
        i = e;
    }
    return t.finish();
}

dispatch fn sum2_f64_cpu(xs: &[f64]) -> f64 { v4 => sum2_f64_v4, avx2 => sum2_f64_v3, _ => sum2_f64, }

dispatch fn dot2_f64_cpu(xs: &[f64], ys: &[f64]) -> f64 { v4 => dot2_f64_v4, avx2 => dot2_f64_v3, _ => dot2_f64, }

impl [f64] {
    pub fn sum(&self) -> f64 {
        if self.len() < LONG_B64 { return sum_f64(self); }
        if self.len() <= SUM_BLOCK { return sum_f64_cpu(self); }
        return sum2_f64_cpu(self);
    }

    pub fn dot(&self, other: &[f64]) -> f64 {
        debug.assert(self.len() == other.len(), "dot: the slices differ in length");
        if self.len() < LONG_B64 { return dot_f64(self, other); }
        if self.len() <= SUM_BLOCK { return dot_f64_cpu(self, other); }
        return dot2_f64_cpu(self, other);
    }

    pub fn min(&self) -> Option<f64> {
        if self.len() == 0 { return Option.None; }
        let mut r: f64 = 0.0;
        if self.len() >= LONG_B64 {
            r = min_f64_cpu(self);
        } else {
            let mut a = f64x2.splat(self[0]);
            for v: f64x2 in self { a = a.min(v); } tail masked (v, m) { a = a.min(m.select(v, a)); }
            r = a.reduce_min();
        }
        return Option.Some(if r != r then mem.f64_from_bits(0x7ff8000000000000) else r);
    }

    pub fn max(&self) -> Option<f64> {
        if self.len() == 0 { return Option.None; }
        let mut r: f64 = 0.0;
        if self.len() >= LONG_B64 {
            r = max_f64_cpu(self);
        } else {
            let mut a = f64x2.splat(self[0]);
            for v: f64x2 in self { a = a.max(v); } tail masked (v, m) { a = a.max(m.select(v, a)); }
            r = a.reduce_max();
        }
        return Option.Some(if r != r then mem.f64_from_bits(0x7ff8000000000000) else r);
    }

    pub fn find(&self, x: f64) -> Option<usize> {
        if self.len() >= LONG_B64 { return find_f64_cpu(self, x); }
        let k = f64x2.splat(x);
        let mut i: usize = 0;
        for v: f64x2 in self {
            let b = (v == k).to_bits();
            if b != 0 { return some_at(i, b as u64); }
            i = i + 2;
        } tail masked (v, m) {
            let b = ((v == k) & m).to_bits();
            if b != 0 { return some_at(i, b as u64); }
        }
        return Option.None;
    }

    pub fn eq(&self, other: &[f64]) -> bool {
        if self.len() != other.len() { return false; }
        if self.len() >= LONG_B64 { return eq_f64_cpu(self, other); }
        let n = self.len();
        let mut i: usize = 0;
        while i + 2 <= n {
            if (f64x2.load(self, i) != f64x2.load(other, i)).to_bits() != 0 { return false; }
            i = i + 2;
        }
        let m = mask64x2.first_n(n - i);
        return ((f64x2.load_masked(self, i, m) != f64x2.load_masked(other, i, m)) & m).to_bits() == 0;
    }

    pub fn fill(&mut self, x: f64) {
        cast_mut::<f64, u64>(self).fill(mem.f64_bits(x));
    }
}

// A bool is one byte, 0 or 1.
impl [bool] {
    pub fn find(&self, x: bool) -> Option<usize> {
        return cast::<bool, u8>(self).find(x as u8);
    }

    pub fn eq(&self, other: &[bool]) -> bool {
        return bytes_eq_any(cast::<bool, u8>(self), cast::<bool, u8>(other));
    }

    pub fn fill(&mut self, x: bool) {
        cast_mut::<bool, u8>(self).fill(x as u8);
    }
}

// The predicate of count, any, and all may be called on any elements of the slice, in any order,
// any number of times: a predicate that can trap may trap even where a sequential loop would have
// stopped earlier.
impl<T: Copy> [T] {
    pub fn count(&self, pred: fn(T) -> bool) -> usize {
        let mut n: usize = 0;
        for i in 0..self.len() { n = n + (pred(self[i]) as usize); }
        return n;
    }

    pub fn any(&self, pred: fn(T) -> bool) -> bool {
        let n = self.len();
        let mut i: usize = 0;
        while i < n {
            let end = (n - i < 16).select(n, i + 16);
            let mut hit = false;
            for j in i..end { hit = hit | pred(self[j]); }
            if hit { return true; }
            i = end;
        }
        return false;
    }

    pub fn all(&self, pred: fn(T) -> bool) -> bool {
        let n = self.len();
        let mut i: usize = 0;
        while i < n {
            let end = (n - i < 16).select(n, i + 16);
            let mut ok = true;
            for j in i..end { ok = ok & pred(self[j]); }
            if !ok { return false; }
            i = end;
        }
        return true;
    }

    pub fn copy_from(&mut self, src: &[T]) {
        debug.assert(self.len() == src.len(), "copy_from: the slices differ in length");
        // The byte loops read every byte of an element, so they take only a T whose size equals
        // its alignment: one scalar-like value, with no padding and no unused enum payload,
        // whose bytes are all initialized. Any other T is copied element by element.
        if size_of::<T>() != align_of::<T>() {
            for i in 0..self.len() { self[i] = src[i]; }
            return;
        }
        let s = cast::<T, u8>(src);
        let d = cast_mut::<T, u8>(self);
        if d.len() >= LONG_B8 {
            copy_bytes_cpu(s, d);
            return;
        }
        let n = d.len();
        let mut i: usize = 0;
        while i + 64 <= n {
            u8x16.load(s, i).store(d, i);
            u8x16.load(s, i + 16).store(d, i + 16);
            u8x16.load(s, i + 32).store(d, i + 32);
            u8x16.load(s, i + 48).store(d, i + 48);
            i = i + 64;
        }
        while i + 16 <= n {
            u8x16.load(s, i).store(d, i);
            i = i + 16;
        }
        let m = mask8x16.first_n(n - i);
        u8x16.load_masked(s, i, m).store_masked(d, i, m);
    }
}

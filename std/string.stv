// std.string: String, an owned, growable UTF-8 string over Vec<u8>.
// Invariant: `buf` always holds valid UTF-8.
//
// Compiler rules tied to this type (path fixed in contracts/intrinsics.md):
// - an f-string `f"a{x}"` is an owned String: `String.new()`, then `push_str` for each literal
//   segment and `Display.fmt(&x, &mut s)` for each hole;
// - `String` derefs to `str`: where `&str` is expected, a `&String` converts to `&str` through
//   `as_str` (`&s` passes as `&str`), and an f-string argument is borrowed automatically, so
//   `io.print(f"n = {n}\n")` passes the temporary's `as_str()`; the temporary String lives to the
//   end of the enclosing statement.

import runtime.errtrace;
import runtime.panic;
import std.core;
import std.mem;
import std.vec;

pub struct String {
    buf: vec.Vec<u8>,
}

impl String {
    pub fn new() -> String {
        return String.{ buf: vec.Vec::<u8>.new() };
    }

    pub fn with_capacity(n: usize) -> String {
        return String.{ buf: vec.Vec::<u8>.with_capacity(n) };
    }

    // The `try_` methods return `Result.Err` instead of panicking `OutOfMemory`, with the String
    // unchanged.
    pub fn try_with_capacity(n: usize) -> Result<String, vec.AllocError> {
        let buf = vec.Vec::<u8>.try_with_capacity(n)?;
        return Result.Ok(String.{ buf: buf });
    }

    // Room for `extra` more bytes.
    pub fn try_reserve(&mut self, extra: usize) -> Result<(), vec.AllocError> {
        return self.buf.try_reserve(extra);
    }

    pub fn from_str(s: &str) -> String {
        let mut r = String.new();
        r.push_str(s);
        return r;
    }

    // Takes ownership of bytes if they are valid UTF-8, else gives them back (the error trace
    // restarts at the user site).
    pub fn from_utf8(bytes: vec.Vec<u8>) -> Result<String, vec.Vec<u8>> {
        if !valid_utf8(bytes.as_slice()) {
            errtrace.restart(panic.user_site());
            return Result.Err(bytes);
        }
        return Result.Ok(String.{ buf: bytes });
    }

    pub fn len(&self) -> usize {
        return self.buf.len();
    }

    pub fn is_empty(&self) -> bool {
        return self.buf.len() == 0;
    }

    pub fn clear(&mut self) {
        self.buf.clear();
    }

    pub fn push_str(&mut self, s: &str) {
        self.buf.extend_from_slice(mem.str_bytes(s));
    }

    pub fn try_push_str(&mut self, s: &str) -> Result<(), vec.AllocError> {
        return self.buf.try_extend_from_slice(mem.str_bytes(s));
    }

    pub fn try_push(&mut self, c: char) -> Result<(), vec.AllocError> {
        let u = c as u32;
        let n: usize = if u < 0x80 then 1 else if u < 0x800 then 2 else if u < 0x10000 then 3 else 4;
        self.buf.try_reserve(n)?;
        self.push(c);
        return Result.Ok(());
    }

    pub fn push(&mut self, c: char) {
        let u = c as u32;
        if u < 0x80 {
            self.buf.push(u as% u8);
        } else if u < 0x800 {
            self.buf.push((0xC0 | (u >> 6)) as% u8);
            self.buf.push((0x80 | (u & 0x3F)) as% u8);
        } else if u < 0x10000 {
            self.buf.push((0xE0 | (u >> 12)) as% u8);
            self.buf.push((0x80 | ((u >> 6) & 0x3F)) as% u8);
            self.buf.push((0x80 | (u & 0x3F)) as% u8);
        } else {
            self.buf.push((0xF0 | (u >> 18)) as% u8);
            self.buf.push((0x80 | ((u >> 12) & 0x3F)) as% u8);
            self.buf.push((0x80 | ((u >> 6) & 0x3F)) as% u8);
            self.buf.push((0x80 | (u & 0x3F)) as% u8);
        }
    }

    pub fn as_str(&self) -> &str from self {
        let b = self.buf.as_slice();
        return unsafe("buf is valid UTF-8 (String invariant) and owned by self") mem.str_from(self, mem.slice_ptr(b), b.len());
    }

    pub fn as_bytes(&self) -> &[u8] from self {
        return self.buf.as_slice();
    }

    pub fn into_bytes(self) -> vec.Vec<u8> {
        let String.{ buf } = self;
        return buf;
    }
}

impl core.Write for String {
    fn write_str(&mut self, s: &str) {
        self.push_str(s);
    }
}

impl core.Display for String {
    fn fmt<W: core.Write>(&self, w: &mut W) {
        w.write_str(self.as_str());
    }
}

// UTF-8 well-formedness (Unicode 15 table 3-7): no overlong forms, no surrogates, <= U+10FFFF.
pub fn valid_utf8(b: &[u8]) -> bool {
    let n = b.len();
    let mut i: usize = 0;
    while i < n {
        let c = b[i];
        if c < 0x80 {
            i = i + 1;
            continue;
        }
        let mut k: usize = 0;
        let mut lo: u8 = 0x80;
        let mut hi: u8 = 0xBF;
        if c >= 0xC2 && c <= 0xDF {
            k = 1;
        } else if c == 0xE0 {
            k = 2;
            lo = 0xA0;
        } else if c >= 0xE1 && c <= 0xEC {
            k = 2;
        } else if c == 0xED {
            k = 2;
            hi = 0x9F;
        } else if c >= 0xEE && c <= 0xEF {
            k = 2;
        } else if c == 0xF0 {
            k = 3;
            lo = 0x90;
        } else if c >= 0xF1 && c <= 0xF3 {
            k = 3;
        } else if c == 0xF4 {
            k = 3;
            hi = 0x8F;
        } else {
            return false;
        }
        if i + k >= n { return false; }
        let c1 = b[i + 1];
        if c1 < lo || c1 > hi { return false; }
        for j in 2..(k + 1) {
            let cj = b[i + j];
            if cj < 0x80 || cj > 0xBF { return false; }
        }
        i = i + k + 1;
    }
    return true;
}

// std.env: program arguments and environment variables.
//
// The kernel's argv strings stay mapped for the whole run (runtime.start keeps argc/argv in the
// state block). `arg(i)` copies argument i (0 = the program path) into an owned String; an
// argument that is not valid UTF-8 gives None, as does i >= `count()`. `var(name)` copies the value
// of the first environment entry `name=value` (the environment block stays mapped too); unset, or
// a value that is not valid UTF-8, gives None.

import runtime.start;
import std.core;
import std.mem;
import std.string;
import std.vec;

pub fn count() -> usize {
    return start.argc();
}

pub fn arg(i: usize) -> Option<string.String> {
    let p = start.arg(i);
    if p == 0 { return Option.None; }
    let mut bytes = vec.Vec::<u8>.new();
    let mut k: usize = 0;
    loop {
        let c = unsafe("argv[i] is a NUL-terminated string on the initial stack, mapped for the whole run") *((p + k) as *const u8);
        if c == 0 { break; }
        bytes.push(c);
        k = k + 1;
    }
    return string.String.from_utf8(bytes).ok();
}

pub fn var(name: &str) -> Option<string.String> {
    let x = mem.str_bytes(name);
    let mut i: usize = 0;
    loop {
        let e = start.env_at(i);
        if e == 0 { return Option.None; }
        i = i + 1;
        // a NUL byte of `name` matches no entry byte before the entry's NUL, so k stops there
        let mut k: usize = 0;
        while k < x.len() && x[k] != 0 && unsafe("bytes e..e+k matched non-NUL bytes of name, so e + k is at or before the entry's NUL") *((e + k) as *const u8) == x[k] { k = k + 1; }
        if k < x.len() { continue; }
        if unsafe("bytes e..e+k matched non-NUL bytes of name, so e + k is at or before the entry's NUL") *((e + k) as *const u8) != 61 { continue; }
        let mut bytes = vec.Vec::<u8>.new();
        let mut j = e + k + 1;
        loop {
            let c = unsafe("j is at or before the NUL of an environment entry on the initial stack, mapped for the whole run") *(j as *const u8);
            if c == 0 { break; }
            bytes.push(c);
            j = j + 1;
        }
        return string.String.from_utf8(bytes).ok();
    }
}
